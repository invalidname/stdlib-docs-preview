{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Distributed"]]},"sections":[],"seeAlsoSections":[{"title":"Distributed actors","generated":true,"anchor":"Distributed-actors","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/Resolvable()","doc:\/\/com.apple.Swift\/documentation\/Distributed\/buildDefaultDistributedRemoteActorExecutor(_:)"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/distributed\/distributedactor"]}],"topicSections":[{"title":"Associated Types","generated":true,"anchor":"Associated-Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/SerializationRequirement"]},{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/init(from:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/asLocalActor","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/unownedExecutor"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/assertIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/assumeIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/encode(to:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/preconditionIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/whenLocal(_:)"]},{"title":"Type Methods","generated":true,"anchor":"Type-Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/resolve(id:using:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"Distributed"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DistributedActor","kind":"identifier"}],"roleHeading":"Protocol","externalID":"s:11Distributed0A5ActorP","navigatorTitle":[{"text":"DistributedActor","kind":"identifier"}],"role":"symbol","title":"DistributedActor","symbolKind":"protocol","platforms":[{"deprecated":false,"introducedAt":"16.0","unavailable":false,"beta":false,"name":"iOS"},{"deprecated":false,"introducedAt":"16.0","unavailable":false,"beta":false,"name":"iPadOS"},{"deprecated":false,"introducedAt":"16.0","unavailable":false,"beta":false,"name":"Mac Catalyst"},{"deprecated":false,"introducedAt":"13.0","unavailable":false,"beta":false,"name":"macOS"},{"deprecated":false,"introducedAt":"16.0","unavailable":false,"beta":false,"name":"tvOS"},{"deprecated":false,"introducedAt":"9.0","unavailable":false,"beta":false,"name":"watchOS"}]},"abstract":[{"text":"Common protocol to which all distributed actors conform implicitly.","type":"text"}],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"title":"Inherits From","type":"inheritsFrom","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DistributedActor","kind":"identifier"},{"text":" : AnyObject, ","kind":"text"},{"preciseIdentifier":"s:SH","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","text":"Hashable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:s12IdentifiableP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable","text":"Identifiable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","text":"Sendable","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/com.apple.Swift\/documentation\/Swift\/implementing-a-custom-distributed-actor-system"],"kind":"mentions"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"DistributedActor","type":"codeVoice"},{"text":" protocol generalizes over all distributed actor types.","type":"text"},{"text":" ","type":"text"},{"text":"Distributed actor types implicitly conform to this protocol.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It is not possible to conform to this protocol by any other declaration other than a ","type":"text"},{"type":"codeVoice","code":"distributed actor"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"It is possible to require a type to conform to the","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor","isActive":true},{"text":" protocol by refining it with another protocol,","type":"text"},{"text":" ","type":"text"},{"text":"or by using a generic constraint.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Synthesized properties","level":2,"anchor":"Synthesized-properties"},{"inlineContent":[{"type":"text","text":"For every concrete distributed actor declaration, the compiler synthesizes two properties: "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" and "},{"code":"id","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"They witness the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true,"type":"reference"},{"text":" protocol requirements of the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor","isActive":true,"type":"reference"},{"text":" protocol.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It is not possible to implement these properties explicitly in user code.","type":"text"},{"text":" ","type":"text"},{"text":"These properties are ","type":"text"},{"code":"nonisolated","type":"codeVoice"},{"text":" and accessible even if the instance is ","type":"text"},{"inlineContent":[{"text":"remote","type":"text"}],"type":"emphasis"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"because ","type":"text"},{"inlineContent":[{"text":"all","type":"text"}],"type":"emphasis"},{"text":" distributed actor references must store the actor system remote calls","type":"text"},{"text":" ","type":"text"},{"text":"will be delivered through, as well as the id identifying the target of those calls.","type":"text"}],"type":"paragraph"},{"text":"The ActorSystem associated type","type":"heading","level":2,"anchor":"The-ActorSystem-associated-type"},{"inlineContent":[{"text":"Every distributed actor must declare what type of actor system","type":"text"},{"text":" ","type":"text"},{"text":"it is part of by implementing the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","type":"reference"},{"text":" associated type requirement.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This causes a number of other properties of the actor to be inferred:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/SerializationRequirement","isActive":true},{"type":"text","text":" that will be used at compile time to"},{"type":"text","text":" "},{"type":"text","text":"verify "},{"type":"codeVoice","code":"distributed"},{"type":"text","text":" target declarations are well formed,"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if the distributed actor is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", based on the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" being Codable or not,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the type of the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"type":"text","text":" accepted in the synthesized default initializer."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A distributed actor must declare what type of actor system it is ready to","type":"text"},{"text":" ","type":"text"},{"text":"work with by fulfilling the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"text":" type member requirement:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["distributed actor Greeter {","  typealias ActorSystem = GreetingSystem \/\/ which conforms to DistributedActorSystem","","  func greet() -> String { \"Hello!\" }","}"],"type":"codeListing"},{"level":3,"anchor":"The-DefaultDistributedActorSystem-type-alias","text":"The DefaultDistributedActorSystem type alias","type":"heading"},{"inlineContent":[{"text":"Since it is fairly common to only be using one specific type of actor system","type":"text"},{"text":" ","type":"text"},{"text":"within a module or entire codebase, it is possible to declare the default type","type":"text"},{"text":" ","type":"text"},{"text":"of actor system all distributed actors will be using in a module by declaring","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"type":"codeVoice","code":"DefaultDistributedActorSystem"},{"text":" module wide typealias:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Distributed","import AmazingActorSystemLibrary","","typealias DefaultDistributedActorSystem = AmazingActorSystem","","distributed actor Greeter {} \/\/ ActorSystem == AmazingActorSystem"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This declaration makes all "},{"type":"codeVoice","code":"distributed actor"},{"text":" declarations","type":"text"},{"text":" ","type":"text"},{"text":"that do not explicitly specify an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"type":"text","text":" type alias to assume the"},{"type":"text","text":" "},{"type":"codeVoice","code":"AmazingActorSystem"},{"type":"text","text":" as their "},{"type":"codeVoice","code":"ActorSystem"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is possible for a specific actor to override the system it is using,"},{"type":"text","text":" "},{"type":"text","text":"by declaring an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"type":"text","text":" type alias as usual:"}],"type":"paragraph"},{"syntax":"swift","code":["typealias DefaultDistributedActorSystem = AmazingActorSystem","","distributed actor Amazing {","  \/\/ ActorSystem == AmazingActorSystem","}","","distributed actor Superb {","  typealias ActorSystem = SuperbActorSystem","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"In general the "},{"type":"codeVoice","code":"DefaultDistributedActorSystem"},{"type":"text","text":" should not be declared public,"},{"type":"text","text":" "},{"type":"text","text":"as picking the default should be left up to each specific module of a project."}],"type":"paragraph"},{"level":2,"anchor":"Default-initializer","text":"Default initializer","type":"heading"},{"inlineContent":[{"type":"text","text":"While classes and actors receive a synthesized "},{"type":"emphasis","inlineContent":[{"text":"argument-free default","type":"text"},{"text":" ","type":"text"},{"text":"initializer","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"init()"},{"type":"text","text":"), distributed actors synthesize a default initializer"},{"type":"text","text":" "},{"type":"text","text":"that accepts a distributed actor system the actor is part of: "},{"type":"codeVoice","code":"init(actorSystem:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The accepted actor system must be of the "},{"type":"codeVoice","code":"Self.ActorSystem"},{"type":"text","text":" type, which"},{"type":"text","text":" "},{"type":"text","text":"must conform to the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem"},{"type":"text","text":" protocol. This is required"},{"type":"text","text":" "},{"type":"text","text":"because distributed actors are always managed by a concrete"},{"type":"text","text":" "},{"type":"text","text":"distributed actor system and cannot exist on their own without one."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is possible to explicitly declare a parameter-free initializer ("},{"type":"codeVoice","code":"init()"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"however the "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" property still must be assigned a concrete actor"},{"type":"text","text":" "},{"type":"text","text":"system instance the actor shall be part of."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In general it is recommended to always have an "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" parameter as"},{"type":"text","text":" "},{"type":"text","text":"the last non-defaulted non-closure parameter in every actor’s"},{"type":"text","text":" "},{"type":"text","text":"initializer parameter list. This way it is simple to swap in a “test actor"},{"type":"text","text":" "},{"type":"text","text":"system” instance in unit tests, and avoid relying on global state which could"},{"type":"text","text":" "},{"type":"text","text":"make testing more difficult."}],"type":"paragraph"},{"level":2,"anchor":"Implicit-properties","text":"Implicit properties","type":"heading"},{"inlineContent":[{"type":"text","text":"Every concrete "},{"type":"codeVoice","code":"distributed actor"},{"text":" type receives two synthesized properties,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"which implement the protocol requirements of this protocol: "},{"type":"codeVoice","code":"id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Property: Actor System","anchor":"Property-Actor-System"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property"},{"text":" property is an important part of every distributed actor’s lifecycle management.","type":"text"}]},{"inlineContent":[{"text":"Both initialization as well as de-initialization require interactions with the actor system,","type":"text"},{"type":"text","text":" "},{"text":"and it is the actor system that handles all remote interactions of an actor, by both sending","type":"text"},{"text":" ","type":"text"},{"text":"or receiving remote calls made on the actor.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property"},{"text":" property must be assigned in every designated initializer","type":"text"},{"text":" ","type":"text"},{"text":"of a distributed actor explicitly. It is highly recommended to make it a","type":"text"},{"text":" ","type":"text"},{"text":"parameter of every distributed actor initializer, and simply forward the","type":"text"},{"text":" ","type":"text"},{"text":"value to the stored property, like this:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["init(name: String, actorSystem: Self.ActorSystem) {","  self.name = name","  self.actorSystem = actorSystem","}"],"type":"codeListing"},{"inlineContent":[{"text":"Forgetting to initialize the actor system, will result in a compile time error:","type":"text"}],"type":"paragraph"},{"code":["\/\/ BAD","init(name: String, actorSystem: Self.ActorSystem) {","  self.name = name","  \/\/ BAD, will cause compile-time error; the `actorSystem` was not initialized.","}"],"syntax":"swift","type":"codeListing"},{"text":"Property: Distributed Actor Identity","type":"heading","level":3,"anchor":"Property-Distributed-Actor-Identity"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference"},{"text":" is assigned by the actor system during the distributed actor’s","type":"text"},{"text":" ","type":"text"},{"text":"initialization, and cannot be set or mutated by the actor itself.","type":"text"}]},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"text":" is the effective identity of the actor, and is used in equality checks,","type":"text"},{"text":" ","type":"text"},{"text":"as well as the actor’s synthesized ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance if the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"text":" type","type":"text"},{"text":" ","type":"text"},{"text":"conforms to ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Automatic-Conformances","text":"Automatic Conformances","type":"heading"},{"text":"Hashable and Identifiable conformance","type":"heading","level":3,"anchor":"Hashable-and-Identifiable-conformance"},{"type":"paragraph","inlineContent":[{"text":"Every distributed actor conforms to the ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" and ","type":"text"},{"code":"Identifiable","type":"codeVoice"},{"text":" protocols.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Its identity is strictly driven by its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"text":", and therefore hash and equality","type":"text"},{"type":"text","text":" "},{"text":"implementations directly delegate to the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference"},{"type":"text","text":" property."}]},{"inlineContent":[{"text":"Comparing a local distributed actor instance and a remote reference to it","type":"text"},{"text":" ","type":"text"},{"text":"(both using the same ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"text":") always returns true, as they both conceptually","type":"text"},{"text":" ","type":"text"},{"text":"point at the same distributed actor.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is not possible to implement these protocols relying on the actual actor’s"},{"text":" ","type":"text"},{"type":"text","text":"state, because it may be remote and the state may not be available. In other"},{"type":"text","text":" "},{"type":"text","text":"words, since these protocols must be implemented using "},{"code":"nonisolated","type":"codeVoice"},{"type":"text","text":" functions,"},{"text":" ","type":"text"},{"text":"only ","type":"text"},{"code":"nonisolated","type":"codeVoice"},{"text":" ","type":"text"},{"code":"id","type":"codeVoice"},{"type":"text","text":" and "},{"code":"actorSystem","type":"codeVoice"},{"type":"text","text":" properties are accessible for their"},{"text":" ","type":"text"},{"text":"implementations.","type":"text"}]},{"text":"Implicit Codable conformance","type":"heading","level":3,"anchor":"Implicit-Codable-conformance"},{"inlineContent":[{"type":"text","text":"If created with an actor system whose "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID"},{"text":" is ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"compiler will synthesize code for the concrete distributed actor to conform","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" as well.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is necessary to support distributed calls where the "},{"code":"SerializationRequirement","type":"codeVoice"},{"type":"text","text":" "},{"text":"is ","type":"text"},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" and thus users may want to pass actors as arguments to remote calls."}],"type":"paragraph"},{"inlineContent":[{"text":"The synthesized implementations use a single ","type":"text"},{"code":"SingleValueEncodingContainer","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"encode\/decode the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"type":"text","text":" property of the actor. The "},{"type":"codeVoice","code":"Decoder"},{"type":"text","text":" required"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Decoder.init(from:)"},{"type":"text","text":" is implemented by retrieving an actor system from the"},{"text":" ","type":"text"},{"type":"text","text":"decoders’ "},{"type":"codeVoice","code":"userInfo"},{"text":", effectively like as follows:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["decoder.userInfo[.actorSystemKey] as? ActorSystem","","The such obtained actor system is then used to ``resolve(id:using:)`` the decoded ``id``.","","Use the `CodingUserInfoKey.actorSystemKey` to provide the necessary","actor system for the decoding initializer when decoding a distributed actor.","","- SeeAlso: ``DistributedActorSystem``"]}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Distributed/DistributedActor/init(from:)":{"role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"ID"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Decodable"},{"type":"text","text":"."}]},"url":"\/documentation\/distributed\/distributedactor\/init(from:)","abstract":[{"text":"Initializes an instance of this distributed actor by decoding its ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true},{"type":"text","text":","},{"text":" ","type":"text"},{"text":"and passing it to the ","type":"text"},{"type":"codeVoice","code":"DistributedActorSystem"},{"text":" obtained from ","type":"text"},{"type":"codeVoice","code":"decoder.userInfo[actorSystemKey]"},{"text":".","type":"text"}],"title":"init(from:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/init(from:)","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s7DecoderP","text":"Decoder","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Distributed/DistributedActor/asLocalActor":{"abstract":[{"type":"text","text":"Produces an erased "},{"type":"codeVoice","code":"any Actor"},{"type":"text","text":" reference to this known to be local distributed actor."}],"kind":"symbol","role":"symbol","title":"asLocalActor","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"asLocalActor","kind":"identifier"},{"text":": ","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ScA","text":"Actor","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/asLocalActor","url":"\/documentation\/distributed\/distributedactor\/aslocalactor"},"doc://com.apple.Swift/documentation/Swift/Hashable":{"type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A type that can be hashed into a "},{"type":"codeVoice","code":"Hasher"},{"type":"text","text":" to produce an integer hash value."}],"fragments":[{"text":"protoc