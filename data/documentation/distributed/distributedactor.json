{"topicSections":[{"title":"Associated Types","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/SerializationRequirement"],"anchor":"Associated-Types"},{"title":"Initializers","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/init(from:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/asLocalActor","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/unownedExecutor"],"anchor":"Instance-Properties"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/assertIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/assumeIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/encode(to:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/preconditionIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/whenLocal(_:)"],"anchor":"Instance-Methods"},{"title":"Type Methods","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/resolve(id:using:)"],"anchor":"Type-Methods"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Common protocol to which all distributed actors conform implicitly.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DistributedActor"},{"kind":"text","text":" : AnyObject, "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","text":"Hashable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:s12IdentifiableP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable","text":"Identifiable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","text":"Sendable"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"DistributedActor","type":"codeVoice"},{"text":" protocol generalizes over all distributed actor types.","type":"text"},{"text":" ","type":"text"},{"text":"Distributed actor types implicitly conform to this protocol.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is not possible to conform to this protocol by any other declaration other than a "},{"code":"distributed actor","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to require a type to conform to the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor"},{"type":"text","text":" protocol by refining it with another protocol,"},{"type":"text","text":" "},{"type":"text","text":"or by using a generic constraint."}]},{"type":"heading","level":2,"text":"Synthesized properties","anchor":"Synthesized-properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For every concrete distributed actor declaration, the compiler synthesizes two properties: "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" and "},{"type":"codeVoice","code":"id"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"They witness the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" protocol requirements of the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor","isActive":true},{"type":"text","text":" protocol."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is not possible to implement these properties explicitly in user code."},{"type":"text","text":" "},{"type":"text","text":"These properties are "},{"code":"nonisolated","type":"codeVoice"},{"type":"text","text":" and accessible even if the instance is "},{"type":"emphasis","inlineContent":[{"text":"remote","type":"text"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"because "},{"type":"emphasis","inlineContent":[{"text":"all","type":"text"}]},{"type":"text","text":" distributed actor references must store the actor system remote calls"},{"type":"text","text":" "},{"type":"text","text":"will be delivered through, as well as the id identifying the target of those calls."}]},{"text":"The ActorSystem associated type","level":2,"type":"heading","anchor":"The-ActorSystem-associated-type"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every distributed actor must declare what type of actor system"},{"type":"text","text":" "},{"type":"text","text":"it is part of by implementing the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"type":"text","text":" associated type requirement."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This causes a number of other properties of the actor to be inferred:"}]},{"items":[{"content":[{"inlineContent":[{"text":"the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/SerializationRequirement","type":"reference","isActive":true},{"text":" that will be used at compile time to","type":"text"},{"text":" ","type":"text"},{"text":"verify ","type":"text"},{"code":"distributed","type":"codeVoice"},{"text":" target declarations are well formed,","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"if the distributed actor is ","type":"text"},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", based on the "},{"type":"codeVoice","code":"ID"},{"type":"text","text":" being Codable or not,"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"the type of the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"text":" accepted in the synthesized default initializer.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A distributed actor must declare what type of actor system it is ready to"},{"text":" ","type":"text"},{"text":"work with by fulfilling the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","type":"reference"},{"text":" type member requirement:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["distributed actor Greeter {","  typealias ActorSystem = GreetingSystem \/\/ which conforms to DistributedActorSystem","","  func greet() -> String { \"Hello!\" }","}"],"type":"codeListing"},{"anchor":"The-DefaultDistributedActorSystem-type-alias","text":"The DefaultDistributedActorSystem type alias","level":3,"type":"heading"},{"inlineContent":[{"text":"Since it is fairly common to only be using one specific type of actor system","type":"text"},{"text":" ","type":"text"},{"text":"within a module or entire codebase, it is possible to declare the default type","type":"text"},{"text":" ","type":"text"},{"text":"of actor system all distributed actors will be using in a module by declaring","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"type":"codeVoice","code":"DefaultDistributedActorSystem"},{"text":" module wide typealias:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Distributed","import AmazingActorSystemLibrary","","typealias DefaultDistributedActorSystem = AmazingActorSystem","","distributed actor Greeter {} \/\/ ActorSystem == AmazingActorSystem"]},{"inlineContent":[{"text":"This declaration makes all ","type":"text"},{"code":"distributed actor","type":"codeVoice"},{"type":"text","text":" declarations"},{"type":"text","text":" "},{"text":"that do not explicitly specify an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"text":" type alias to assume the","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"AmazingActorSystem"},{"type":"text","text":" as their "},{"type":"codeVoice","code":"ActorSystem"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is possible for a specific actor to override the system it is using,"},{"type":"text","text":" "},{"type":"text","text":"by declaring an "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","isActive":true,"type":"reference"},{"type":"text","text":" type alias as usual:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["typealias DefaultDistributedActorSystem = AmazingActorSystem","","distributed actor Amazing {","  \/\/ ActorSystem == AmazingActorSystem","}","","distributed actor Superb {","  typealias ActorSystem = SuperbActorSystem","}"]},{"inlineContent":[{"type":"text","text":"In general the "},{"type":"codeVoice","code":"DefaultDistributedActorSystem"},{"type":"text","text":" should not be declared public,"},{"type":"text","text":" "},{"type":"text","text":"as picking the default should be left up to each specific module of a project."}],"type":"paragraph"},{"text":"Default initializer","anchor":"Default-initializer","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"While classes and actors receive a synthesized "},{"type":"emphasis","inlineContent":[{"type":"text","text":"argument-free default"},{"type":"text","text":" "},{"type":"text","text":"initializer"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"init()"},{"text":"), distributed actors synthesize a default initializer","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that accepts a distributed actor system the actor is part of: "},{"type":"codeVoice","code":"init(actorSystem:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The accepted actor system must be of the ","type":"text"},{"type":"codeVoice","code":"Self.ActorSystem"},{"text":" type, which","type":"text"},{"text":" ","type":"text"},{"text":"must conform to the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem","type":"reference","isActive":true},{"type":"text","text":" protocol. This is required"},{"type":"text","text":" "},{"type":"text","text":"because distributed actors are always managed by a concrete"},{"type":"text","text":" "},{"type":"text","text":"distributed actor system and cannot exist on their own without one."}]},{"inlineContent":[{"text":"It is possible to explicitly declare a parameter-free initializer (","type":"text"},{"code":"init()","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"however the "},{"code":"actorSystem","type":"codeVoice"},{"text":" property still must be assigned a concrete actor","type":"text"},{"type":"text","text":" "},{"type":"text","text":"system instance the actor shall be part of."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"In general it is recommended to always have an ","type":"text"},{"code":"actorSystem","type":"codeVoice"},{"text":" parameter as","type":"text"},{"text":" ","type":"text"},{"text":"the last non-defaulted non-closure parameter in every actor’s","type":"text"},{"text":" ","type":"text"},{"text":"initializer parameter list. This way it is simple to swap in a “test actor","type":"text"},{"text":" ","type":"text"},{"text":"system” instance in unit tests, and avoid relying on global state which could","type":"text"},{"text":" ","type":"text"},{"text":"make testing more difficult.","type":"text"}]},{"type":"heading","text":"Implicit properties","level":2,"anchor":"Implicit-properties"},{"type":"paragraph","inlineContent":[{"text":"Every concrete ","type":"text"},{"type":"codeVoice","code":"distributed actor"},{"text":" type receives two synthesized properties,","type":"text"},{"text":" ","type":"text"},{"text":"which implement the protocol requirements of this protocol: ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"actorSystem"},{"text":".","type":"text"}]},{"type":"heading","text":"Property: Actor System","level":3,"anchor":"Property-Actor-System"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property"},{"type":"text","text":" property is an important part of every distributed actor’s lifecycle management."}]},{"inlineContent":[{"text":"Both initialization as well as de-initialization require interactions with the actor system,","type":"text"},{"text":" ","type":"text"},{"text":"and it is the actor system that handles all remote interactions of an actor, by both sending","type":"text"},{"text":" ","type":"text"},{"text":"or receiving remote calls made on the actor.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property"},{"text":" property must be assigned in every designated initializer","type":"text"},{"text":" ","type":"text"},{"text":"of a distributed actor explicitly. It is highly recommended to make it a","type":"text"},{"text":" ","type":"text"},{"text":"parameter of every distributed actor initializer, and simply forward the","type":"text"},{"text":" ","type":"text"},{"text":"value to the stored property, like this:","type":"text"}],"type":"paragraph"},{"code":["init(name: String, actorSystem: Self.ActorSystem) {","  self.name = name","  self.actorSystem = actorSystem","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Forgetting to initialize the actor system, will result in a compile time error:","type":"text"}]},{"code":["\/\/ BAD","init(name: String, actorSystem: Self.ActorSystem) {","  self.name = name","  \/\/ BAD, will cause compile-time error; the `actorSystem` was not initialized.","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Property-Distributed-Actor-Identity","text":"Property: Distributed Actor Identity","level":3},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"type":"text","text":" is assigned by the actor system during the distributed actor’s"},{"type":"text","text":" "},{"type":"text","text":"initialization, and cannot be set or mutated by the actor itself."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"type":"text","text":" is the effective identity of the actor, and is used in equality checks,"},{"type":"text","text":" "},{"type":"text","text":"as well as the actor’s synthesized "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance if the "},{"code":"ID","type":"codeVoice"},{"type":"text","text":" type"},{"type":"text","text":" "},{"type":"text","text":"conforms to "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":"."}]},{"level":2,"text":"Automatic Conformances","anchor":"Automatic-Conformances","type":"heading"},{"level":3,"text":"Hashable and Identifiable conformance","anchor":"Hashable-and-Identifiable-conformance","type":"heading"},{"inlineContent":[{"type":"text","text":"Every distributed actor conforms to the "},{"type":"codeVoice","code":"Hashable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Identifiable"},{"text":" protocols.","type":"text"},{"text":" ","type":"text"},{"text":"Its identity is strictly driven by its ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true},{"text":", and therefore hash and equality","type":"text"},{"text":" ","type":"text"},{"text":"implementations directly delegate to the ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true},{"text":" property.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Comparing a local distributed actor instance and a remote reference to it","type":"text"},{"text":" ","type":"text"},{"text":"(both using the same ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference"},{"text":") always returns true, as they both conceptually","type":"text"},{"text":" ","type":"text"},{"text":"point at the same distributed actor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is not possible to implement these protocols relying on the actual actor’s"},{"type":"text","text":" "},{"type":"text","text":"state, because it may be remote and the state may not be available. In other"},{"type":"text","text":" "},{"type":"text","text":"words, since these protocols must be implemented using "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" functions,"},{"type":"text","text":" "},{"type":"text","text":"only "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" "},{"type":"codeVoice","code":"id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" properties are accessible for their"},{"type":"text","text":" "},{"type":"text","text":"implementations."}]},{"type":"heading","level":3,"anchor":"Implicit-Codable-conformance","text":"Implicit Codable conformance"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If created with an actor system whose "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"compiler will synthesize code for the concrete distributed actor to conform"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" as well."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is necessary to support distributed calls where the "},{"code":"SerializationRequirement","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" and thus users may want to pass actors as arguments to remote calls."}]},{"type":"paragraph","inlineContent":[{"text":"The synthesized implementations use a single ","type":"text"},{"code":"SingleValueEncodingContainer","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"encode\/decode the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"text":" property of the actor. The ","type":"text"},{"code":"Decoder","type":"codeVoice"},{"text":" required","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Decoder\/init(from:)"},{"type":"text","text":" is implemented by retrieving an actor system from the"},{"text":" ","type":"text"},{"text":"decoders’ ","type":"text"},{"code":"userInfo","type":"codeVoice"},{"text":", effectively like as follows:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["decoder.userInfo[.actorSystemKey] as? ActorSystem","","The such obtained actor system is then used to ``resolve(id:using:)`` the decoded ``ID``.","","Use the ``CodingUserInfoKey\/actorSystemKey`` to provide the necessary","actor system for the decoding initializer when decoding a distributed actor.","","- SeeAlso: ``DistributedActorSystem``","- SeeAlso: ``Actor``","- SeeAlso: ``AnyActor``"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Distributed"]]},"kind":"symbol","seeAlsoSections":[{"title":"Distributed Actors","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem","doc:\/\/com.apple.Swift\/documentation\/Distributed\/Resolvable()","doc:\/\/com.apple.Swift\/documentation\/Distributed\/buildDefaultDistributedRemoteActorExecutor(_:)"],"anchor":"Distributed-Actors"}],"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"type":"inheritsFrom"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/distributed\/distributedactor"]}],"sections":[],"metadata":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DistributedActor","kind":"identifier"}],"navigatorTitle":[{"text":"DistributedActor","kind":"identifier"}],"modules":[{"name":"Distributed"}],"platforms":[{"name":"iOS","deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false},{"name":"iPadOS","deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false},{"name":"Mac Catalyst","deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false},{"name":"macOS","deprecated":false,"beta":false,"introducedAt":"13.0","unavailable":false},{"name":"tvOS","deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false},{"name":"watchOS","deprecated":false,"beta":false,"introducedAt":"9.0","unavailable":false}],"externalID":"s:11Distributed0A5ActorP","roleHeading":"Protocol","symbolKind":"protocol","role":"symbol","title":"DistributedActor"},"references":{"doc://com.apple.Swift/documentation/Swift/Sendable":{"navigatorTitle":[{"text":"Sendable","kind":"identifier"}],"abstract":[{"type":"text","text":"A thread-safe type whose values can be shared across arbitrary concurrent"},{"type":"text","text":" "},{"text":"contexts without introducing a risk of data races.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","title":"Sendable","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/swift\/sendable","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sendable","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Distr