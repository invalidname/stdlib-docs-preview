emaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Distributed"]]},"abstract":[{"type":"text","text":"Common protocol to which all distributed actors conform implicitly."}],"references":{"doc://com.apple.Swift/documentation/Distributed/DistributedActor/unownedExecutor":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unownedExecutor","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sce","text":"UnownedSerialExecutor","kind":"typeIdentifier"}],"title":"unownedExecutor","type":"topic","abstract":[{"type":"text","text":"Retrieve the executor for this distributed actor as an optimized,"},{"type":"text","text":" "},{"type":"text","text":"unowned reference. This API is equivalent to "},{"type":"codeVoice","code":"Actor.unownedExecutor"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"however, by default, it intentionally returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if this actor is a reference"},{"type":"text","text":" "},{"type":"text","text":"to a remote distributed actor, because the executor for remote references"},{"type":"text","text":" "},{"type":"text","text":"is effectively never going to execute any code “on” this actor’s isolated state"},{"type":"text","text":" "},{"type":"text","text":"(because it is located on a remote)."}],"kind":"symbol","required":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/unownedExecutor","url":"\/documentation\/distributed\/distributedactor\/unownedexecutor","role":"symbol"},"doc://com.apple.Swift/documentation/Distributed/DistributedActor/assumeIsolated(_:file:line:)":{"role":"symbol","title":"assumeIsolated(_:file:line:)","type":"topic","url":"\/documentation\/distributed\/distributedactor\/assumeisolated(_:file:line:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/assumeIsolated(_:file: