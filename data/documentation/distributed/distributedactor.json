{"metadata":{"platforms":[{"introducedAt":"16.0","beta":false,"name":"iOS","deprecated":false,"unavailable":false},{"introducedAt":"16.0","beta":false,"name":"iPadOS","deprecated":false,"unavailable":false},{"introducedAt":"16.0","beta":false,"name":"Mac Catalyst","deprecated":false,"unavailable":false},{"introducedAt":"13.0","beta":false,"name":"macOS","deprecated":false,"unavailable":false},{"introducedAt":"16.0","beta":false,"name":"tvOS","deprecated":false,"unavailable":false},{"introducedAt":"9.0","beta":false,"name":"watchOS","deprecated":false,"unavailable":false}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DistributedActor"}],"roleHeading":"Protocol","title":"DistributedActor","externalID":"s:11Distributed0A5ActorP","navigatorTitle":[{"kind":"identifier","text":"DistributedActor"}],"role":"symbol","symbolKind":"protocol","modules":[{"name":"Distributed"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DistributedActor","kind":"identifier"},{"text":" : AnyObject, ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Identifiable","preciseIdentifier":"s:s12IdentifiableP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","kind":"typeIdentifier"}]}]},{"kind":"mentions","mentions":["doc:\/\/com.apple.Swift\/documentation\/Swift\/implementing-a-custom-distributed-actor-system"]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DistributedActor"},{"type":"text","text":" protocol generalizes over all distributed actor types."},{"type":"text","text":" "},{"type":"text","text":"Distributed actor types implicitly conform to this protocol."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is not possible to conform to this protocol by any other declaration other than a "},{"type":"codeVoice","code":"distributed actor"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to require a type to conform to the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor"},{"type":"text","text":" protocol by refining it with another protocol,"},{"type":"text","text":" "},{"type":"text","text":"or by using a generic constraint."}]},{"type":"heading","level":2,"text":"Synthesized properties","anchor":"Synthesized-properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For every concrete distributed actor declaration, the compiler synthesizes two properties: "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" and "},{"type":"codeVoice","code":"id"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"They witness the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" protocol requirements of the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor"},{"type":"text","text":" protocol."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is not possible to implement these properties explicitly in user code."},{"type":"text","text":" "},{"type":"text","text":"These properties are "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" and accessible even if the instance is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"remote"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"because "},{"type":"emphasis","inlineContent":[{"type":"text","text":"all"}]},{"type":"text","text":" distributed actor references must store the actor system remote calls"},{"type":"text","text":" "},{"type":"text","text":"will be delivered through, as well as the id identifying the target of those calls."}]},{"anchor":"The-ActorSystem-associated-type","text":"The ActorSystem associated type","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every distributed actor must declare what type of actor system"},{"type":"text","text":" "},{"type":"text","text":"it is part of by implementing the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"type":"text","text":" associated type requirement."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This causes a number of other properties of the actor to be inferred:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/SerializationRequirement"},{"type":"text","text":" that will be used at compile time to"},{"type":"text","text":" "},{"type":"text","text":"verify "},{"type":"codeVoice","code":"distributed"},{"type":"text","text":" target declarations are well formed,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if the distributed actor is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", based on the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" being Codable or not,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the type of the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"type":"text","text":" accepted in the synthesized default initializer."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A distributed actor must declare what type of actor system it is ready to"},{"type":"text","text":" "},{"type":"text","text":"work with by fulfilling the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"type":"text","text":" type member requirement:"}]},{"type":"codeListing","code":["distributed actor Greeter {","  typealias ActorSystem = GreetingSystem \/\/ which conforms to DistributedActorSystem","","  func greet() -> String { \"Hello!\" }","}"],"syntax":"swift"},{"anchor":"The-DefaultDistributedActorSystem-type-alias","text":"The DefaultDistributedActorSystem type alias","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since it is fairly common to only be using one specific type of actor system"},{"type":"text","text":" "},{"type":"text","text":"within a module or entire codebase, it is possible to declare the default type"},{"type":"text","text":" "},{"type":"text","text":"of actor system all distributed actors will be using in a module by declaring"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"DefaultDistributedActorSystem"},{"type":"text","text":" module wide typealias:"}]},{"type":"codeListing","code":["import Distributed","import AmazingActorSystemLibrary","","typealias DefaultDistributedActorSystem = AmazingActorSystem","","distributed actor Greeter {} \/\/ ActorSystem == AmazingActorSystem"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This declaration makes all "},{"type":"codeVoice","code":"distributed actor"},{"type":"text","text":" declarations"},{"type":"text","text":" "},{"type":"text","text":"that do not explicitly specify an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"type":"text","text":" type alias to assume the"},{"type":"text","text":" "},{"type":"codeVoice","code":"AmazingActorSystem"},{"type":"text","text":" as their "},{"type":"codeVoice","code":"ActorSystem"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible for a specific actor to override the system it is using,"},{"type":"text","text":" "},{"type":"text","text":"by declaring an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"type":"text","text":" type alias as usual:"}]},{"type":"codeListing","code":["typealias DefaultDistributedActorSystem = AmazingActorSystem","","distributed actor Amazing {","  \/\/ ActorSystem == AmazingActorSystem","}","","distributed actor Superb {","  typealias ActorSystem = SuperbActorSystem","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In general the "},{"type":"codeVoice","code":"DefaultDistributedActorSystem"},{"type":"text","text":" should not be declared public,"},{"type":"text","text":" "},{"type":"text","text":"as picking the default should be left up to each specific module of a project."}]},{"text":"Default initializer","anchor":"Default-initializer","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"While classes and actors receive a synthesized "},{"type":"emphasis","inlineContent":[{"type":"text","text":"argument-free default"},{"type":"text","text":" "},{"type":"text","text":"initializer"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"init()"},{"type":"text","text":"), distributed actors synthesize a default initializer"},{"type":"text","text":" "},{"type":"text","text":"that accepts a distributed actor system the actor is part of: "},{"type":"codeVoice","code":"init(actorSystem:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The accepted actor system must be of the "},{"type":"codeVoice","code":"Self.ActorSystem"},{"type":"text","text":" type, which"},{"type":"text","text":" "},{"type":"text","text":"must conform to the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem"},{"type":"text","text":" protocol. This is required"},{"type":"text","text":" "},{"type":"text","text":"because distributed actors are always managed by a concrete"},{"type":"text","text":" "},{"type":"text","text":"distributed actor system and cannot exist on their own without one."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to explicitly declare a parameter-free initializer ("},{"type":"codeVoice","code":"init()"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"however the "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" property still must be assigned a concrete actor"},{"type":"text","text":" "},{"type":"text","text":"system instance the actor shall be part of."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In general it is recommended to always have an "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" parameter as"},{"type":"text","text":" "},{"type":"text","text":"the last non-defaulted non-closure parameter in every actor’s"},{"type":"text","text":" "},{"type":"text","text":"initializer parameter list. This way it is simple to swap in a “test actor"},{"type":"text","text":" "},{"type":"text","text":"system” instance in unit tests, and avoid relying on global state which could"},{"type":"text","text":" "},{"type":"text","text":"make testing more difficult."}]},{"level":2,"text":"Implicit properties","anchor":"Implicit-properties","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every concrete "},{"type":"codeVoice","code":"distributed actor"},{"type":"text","text":" type receives two synthesized properties,"},{"type":"text","text":" "},{"type":"text","text":"which implement the protocol requirements of this protocol: "},{"type":"codeVoice","code":"id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":"."}]},{"level":3,"text":"Property: Actor System","anchor":"Property-Actor-System","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property"},{"type":"text","text":" property is an important part of every distributed actor’s lifecycle management."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both initialization as well as de-initialization require interactions with the actor system,"},{"type":"text","text":" "},{"type":"text","text":"and it is the actor system that handles all remote interactions of an actor, by both sending"},{"type":"text","text":" "},{"type":"text","text":"or receiving remote calls made on the actor."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property"},{"type":"text","text":" property must be assigned in every designated initializer"},{"type":"text","text":" "},{"type":"text","text":"of a distributed actor explicitly. It is highly recommended to make it a"},{"type":"text","text":" "},{"type":"text","text":"parameter of every distributed actor initializer, and simply forward the"},{"type":"text","text":" "},{"type":"text","text":"value to the stored property, like this:"}]},{"type":"codeListing","code":["init(name: String, actorSystem: Self.ActorSystem) {","  self.name = name","  self.actorSystem = actorSystem","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forgetting to initialize the actor system, will result in a compile time error:"}]},{"type":"codeListing","code":["\/\/ BAD","init(name: String, actorSystem: Self.ActorSystem) {","  self.name = name","  \/\/ BAD, will cause compile-time error; the `actorSystem` was not initialized.","}"],"syntax":"swift"},{"level":3,"text":"Property: Distributed Actor Identity","anchor":"Property-Distributed-Actor-Identity","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" is assigned by the actor system during the distributed actor’s"},{"type":"text","text":" "},{"type":"text","text":"initialization, and cannot be set or mutated by the actor itself."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" is the effective identity of the actor, and is used in equality checks,"},{"type":"text","text":" "},{"type":"text","text":"as well as the actor’s synthesized "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance if the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" type"},{"type":"text","text":" "},{"type":"text","text":"conforms to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":"."}]},{"level":2,"text":"Automatic Conformances","anchor":"Automatic-Conformances","type":"heading"},{"level":3,"text":"Hashable and Identifiable conformance","anchor":"Hashable-and-Identifiable-conformance","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every distributed actor conforms to the "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Identifiable"},{"type":"text","text":" protocols."},{"type":"text","text":" "},{"type":"text","text":"Its identity is strictly driven by its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":", and therefore hash and equality"},{"type":"text","text":" "},{"type":"text","text":"implementations directly delegate to the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" property."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Comparing a local distributed actor instance and a remote reference to it"},{"type":"text","text":" "},{"type":"text","text":"(both using the same "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":") always returns true, as they both conceptually"},{"type":"text","text":" "},{"type":"text","text":"point at the same distributed actor."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is not possible to implement these protocols relying on the actual actor’s"},{"type":"text","text":" "},{"type":"text","text":"state, because it may be remote and the state may not be available. In other"},{"type":"text","text":" "},{"type":"text","text":"words, since these protocols must be implemented using "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" functions,"},{"type":"text","text":" "},{"type":"text","text":"only "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" "},{"type":"codeVoice","code":"id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" properties are accessible for their"},{"type":"text","text":" "},{"type":"text","text":"implementations."}]},{"anchor":"Implicit-Codable-conformance","text":"Implicit Codable conformance","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"If created with an actor system whose "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"compiler will synthesize code for the concrete distributed actor to conform"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" as well."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is necessary to support distributed calls where the "},{"type":"codeVoice","code":"SerializationRequirement"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" and thus users may want to pass actors as arguments to remote calls."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The synthesized implementations use a single "},{"type":"codeVoice","code":"SingleValueEncodingContainer"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"encode\/decode the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" property of the actor. The "},{"type":"codeVoice","code":"Decoder"},{"type":"text","text":" required"},{"type":"text","text":" "},{"type":"codeVoice","code":"Decoder.init(from:)"},{"type":"text","text":" is implemented by retrieving an actor system from the"},{"type":"text","text":" "},{"type":"text","text":"decoders’ "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":", effectively like as follows:"}]},{"type":"codeListing","code":["decoder.userInfo[.actorSystemKey] as? ActorSystem"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The such obtained actor system is then used to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/resolve(id:using:)"},{"type":"text","text":" the decoded "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"CodingUserInfoKey.actorSystemKey"},{"type":"text","text":" to provide the necessary"},{"type":"text","text":" "},{"type":"text","text":"actor system for the decoding initializer when decoding a distributed actor."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem"}]}],"name":"See Also","type":"aside"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"type":"inheritsFrom","title":"Inherits From","kind":"relationships"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor"},"topicSections":[{"generated":true,"anchor":"Associated-Types","title":"Associated Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/SerializationRequirement"]},{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/init(from:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/asLocalActor","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/unownedExecutor"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/assertIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/assumeIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/encode(to:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/preconditionIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/whenLocal(_:)"]},{"generated":true,"anchor":"Type-Methods","title":"Type Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/resolve(id:using:)"]}],"abstract":[{"type":"text","text":"Common protocol to which all distributed actors conform implicitly."}],"seeAlsoSections":[{"generated":true,"anchor":"Distributed-actors","title":"Distributed actors","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/Resolvable()","doc:\/\/com.apple.Swift\/documentation\/Distributed\/buildDefaultDistributedRemoteActorExecutor(_:)"]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Distributed"]]},"variants":[{"paths":["\/documentation\/distributed\/distributedactor"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Distributed/DistributedActor/unownedExecutor":{"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/unownedExecutor","abstract":[{"type":"text","text":"Retrieve the executor for this distributed actor as an optimized,"},{"type":"text","text":" "},{"type":"text","text":"unowned reference. This API is equivalent to "},{"type":"codeVoice","code":"Actor.unownedExecutor"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"however, by default, it intentionally returns "},{"code":"nil","type":"codeVoice"},{"text":" if this actor is a reference","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to a remote distributed actor, because the executor for remote references"},{"type":"text","text":" "},{"type":"text","text":"is effectively never going to execute any code “on” this actor’s isolated state"},{"type":"text","text":" "},{"type":"text","text":"(because it is located on a remote)."}],"title":"unownedExecutor","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unownedExecutor","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sce","text":"UnownedSerialExecutor","kind":"typeIdentifier"}],"url":"\/documentation\/distributed\/distributedactor\/unownedexecutor","required":true,"kind":"symbol"},"doc://com.apple.Swift/documentation/Distributed/DistributedActor/asLocalActor":{"type":"topic","url":"\/documentation\/distributed\/distributedactor\/aslocalactor","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"asLocalActor","kind":"identifier"},{"text":": ","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind"