{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Distributed"]]},"kind":"symbol","seeAlsoSections":[{"generated":true,"anchor":"Distributed-actors","title":"Distributed actors","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/Resolvable()","doc:\/\/com.apple.Swift\/documentation\/Distributed\/buildDefaultDistributedRemoteActorExecutor(_:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DistributedActor","kind":"identifier"},{"text":" : AnyObject, ","kind":"text"},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable"},{"text":", ","kind":"text"},{"kind":"typeIdentifier","text":"Identifiable","preciseIdentifier":"s:s12IdentifiableP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable"},{"text":", ","kind":"text"},{"text":"Sendable","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/com.apple.Swift\/documentation\/Swift\/implementing-a-custom-distributed-actor-system"],"kind":"mentions"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DistributedActor"},{"type":"text","text":" protocol generalizes over all distributed actor types."},{"type":"text","text":" "},{"type":"text","text":"Distributed actor types implicitly conform to this protocol."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is not possible to conform to this protocol by any other declaration other than a "},{"type":"codeVoice","code":"distributed actor"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is possible to require a type to conform to the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor"},{"type":"text","text":" protocol by refining it with another protocol,"},{"type":"text","text":" "},{"type":"text","text":"or by using a generic constraint."}],"type":"paragraph"},{"text":"Synthesized properties","anchor":"Synthesized-properties","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For every concrete distributed actor declaration, the compiler synthesizes two properties: "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" and "},{"type":"codeVoice","code":"id"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"They witness the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true,"type":"reference"},{"type":"text","text":" protocol requirements of the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor","isActive":true,"type":"reference"},{"type":"text","text":" protocol."}]},{"inlineContent":[{"type":"text","text":"It is not possible to implement these properties explicitly in user code."},{"type":"text","text":" "},{"type":"text","text":"These properties are "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" and accessible even if the instance is "},{"inlineContent":[{"type":"text","text":"remote"}],"type":"emphasis"},{"type":"text","text":","},{"type":"text","text":" "},{"text":"because ","type":"text"},{"inlineContent":[{"text":"all","type":"text"}],"type":"emphasis"},{"text":" distributed actor references must store the actor system remote calls","type":"text"},{"text":" ","type":"text"},{"text":"will be delivered through, as well as the id identifying the target of those calls.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"The-ActorSystem-associated-type","type":"heading","text":"The ActorSystem associated type"},{"inlineContent":[{"type":"text","text":"Every distributed actor must declare what type of actor system"},{"type":"text","text":" "},{"type":"text","text":"it is part of by implementing the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","type":"reference","isActive":true},{"type":"text","text":" associated type requirement."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This causes a number of other properties of the actor to be inferred:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/SerializationRequirement"},{"type":"text","text":" that will be used at compile time to"},{"type":"text","text":" "},{"type":"text","text":"verify "},{"code":"distributed","type":"codeVoice"},{"type":"text","text":" target declarations are well formed,"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"if the distributed actor is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", based on the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" being Codable or not,"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the type of the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"text":" accepted in the synthesized default initializer.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A distributed actor must declare what type of actor system it is ready to","type":"text"},{"type":"text","text":" "},{"text":"work with by fulfilling the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","isActive":true,"type":"reference"},{"type":"text","text":" type member requirement:"}],"type":"paragraph"},{"code":["distributed actor Greeter {","  typealias ActorSystem = GreetingSystem \/\/ which conforms to DistributedActorSystem","","  func greet() -> String { \"Hello!\" }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"The DefaultDistributedActorSystem type alias","anchor":"The-DefaultDistributedActorSystem-type-alias","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since it is fairly common to only be using one specific type of actor system"},{"text":" ","type":"text"},{"type":"text","text":"within a module or entire codebase, it is possible to declare the default type"},{"type":"text","text":" "},{"type":"text","text":"of actor system all distributed actors will be using in a module by declaring"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"DefaultDistributedActorSystem"},{"type":"text","text":" module wide typealias:"}]},{"code":["import Distributed","import AmazingActorSystemLibrary","","typealias DefaultDistributedActorSystem = AmazingActorSystem","","distributed actor Greeter {} \/\/ ActorSystem == AmazingActorSystem"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This declaration makes all "},{"code":"distributed actor","type":"codeVoice"},{"type":"text","text":" declarations"},{"text":" ","type":"text"},{"text":"that do not explicitly specify an ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","isActive":true,"type":"reference"},{"text":" type alias to assume the","type":"text"},{"type":"text","text":" "},{"code":"AmazingActorSystem","type":"codeVoice"},{"text":" as their ","type":"text"},{"code":"ActorSystem","type":"codeVoice"},{"type":"text","text":"."}]},{"inlineContent":[{"text":"It is possible for a specific actor to override the system it is using,","type":"text"},{"text":" ","type":"text"},{"text":"by declaring an ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","isActive":true,"type":"reference"},{"type":"text","text":" type alias as usual:"}],"type":"paragraph"},{"syntax":"swift","code":["typealias DefaultDistributedActorSystem = AmazingActorSystem","","distributed actor Amazing {","  \/\/ ActorSystem == AmazingActorSystem","}","","distributed actor Superb {","  typealias ActorSystem = SuperbActorSystem","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"In general the "},{"code":"DefaultDistributedActorSystem","type":"codeVoice"},{"text":" should not be declared public,","type":"text"},{"type":"text","text":" "},{"text":"as picking the default should be left up to each specific module of a project.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Default-initializer","type":"heading","text":"Default initializer"},{"inlineContent":[{"type":"text","text":"While classes and actors receive a synthesized "},{"inlineContent":[{"type":"text","text":"argument-free default"},{"text":" ","type":"text"},{"type":"text","text":"initializer"}],"type":"emphasis"},{"type":"text","text":" ("},{"code":"init()","type":"codeVoice"},{"text":"), distributed actors synthesize a default initializer","type":"text"},{"text":" ","type":"text"},{"text":"that accepts a distributed actor system the actor is part of: ","type":"text"},{"code":"init(actorSystem:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The accepted actor system must be of the "},{"type":"codeVoice","code":"Self.ActorSystem"},{"type":"text","text":" type, which"},{"text":" ","type":"text"},{"text":"must conform to the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem"},{"type":"text","text":" protocol. This is required"},{"type":"text","text":" "},{"text":"because distributed actors are always managed by a concrete","type":"text"},{"type":"text","text":" "},{"type":"text","text":"distributed actor system and cannot exist on their own without one."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is possible to explicitly declare a parameter-free initializer ("},{"type":"codeVoice","code":"init()"},{"type":"text","text":"),"},{"type":"text","text":" "},{"text":"however the ","type":"text"},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" property still must be assigned a concrete actor"},{"text":" ","type":"text"},{"text":"system instance the actor shall be part of.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In general it is recommended to always have an "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" parameter as"},{"type":"text","text":" "},{"text":"the last non-defaulted non-closure parameter in every actor’s","type":"text"},{"text":" ","type":"text"},{"text":"initializer parameter list. This way it is simple to swap in a “test actor","type":"text"},{"text":" ","type":"text"},{"text":"system” instance in unit tests, and avoid relying on global state which could","type":"text"},{"type":"text","text":" "},{"type":"text","text":"make testing more difficult."}],"type":"paragraph"},{"level":2,"anchor":"Implicit-properties","type":"heading","text":"Implicit properties"},{"inlineContent":[{"type":"text","text":"Every concrete "},{"type":"codeVoice","code":"distributed actor"},{"text":" type receives two synthesized properties,","type":"text"},{"text":" ","type":"text"},{"text":"which implement the protocol requirements of this protocol: ","type":"text"},{"type":"codeVoice","code":"id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"anchor":"Property-Actor-System","text":"Property: Actor System","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","type":"reference"},{"text":" property is an important part of every distributed actor’s lifecycle management.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Both initialization as well as de-initialization require interactions with the actor system,","type":"text"},{"text":" ","type":"text"},{"text":"and it is the actor system that handles all remote interactions of an actor, by both sending","type":"text"},{"text":" ","type":"text"},{"text":"or receiving remote calls made on the actor.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","type":"reference"},{"text":" property must be assigned in every designated initializer","type":"text"},{"text":" ","type":"text"},{"text":"of a distributed actor explicitly. It is highly recommended to make it a","type":"text"},{"text":" ","type":"text"},{"text":"parameter of every distributed actor initializer, and simply forward the","type":"text"},{"text":" ","type":"text"},{"text":"value to the stored property, like this:","type":"text"}]},{"code":["init(name: String, actorSystem: Self.ActorSystem) {","  self.name = name","  self.actorSystem = actorSystem","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forgetting to initialize the actor system, will result in a compile time error:"}]},{"code":["\/\/ BAD","init(name: String, actorSystem: Self.ActorSystem) {","  self.name = name","  \/\/ BAD, will cause compile-time error; the `actorSystem` was not initialized.","}"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Property-Distributed-Actor-Identity","type":"heading","text":"Property: Distributed Actor Identity"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"type":"text","text":" is assigned by the actor system during the distributed actor’s"},{"type":"text","text":" "},{"type":"text","text":"initialization, and cannot be set or mutated by the actor itself."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"type":"text","text":" is the effective identity of the actor, and is used in equality checks,"},{"type":"text","text":" "},{"type":"text","text":"as well as the actor’s synthesized "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance if the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"type":"text","text":" type"},{"type":"text","text":" "},{"type":"text","text":"conforms to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":"."}]},{"level":2,"anchor":"Automatic-Conformances","type":"heading","text":"Automatic Conformances"},{"level":3,"anchor":"Hashable-and-Identifiable-conformance","type":"heading","text":"Hashable and Identifiable conformance"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every distributed actor conforms to the "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Identifiable"},{"type":"text","text":" protocols."},{"type":"text","text":" "},{"type":"text","text":"Its identity is strictly driven by its "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"type":"text","text":", and therefore hash and equality"},{"type":"text","text":" "},{"type":"text","text":"implementations directly delegate to the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"type":"text","text":" property."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Comparing a local distributed actor instance and a remote reference to it"},{"type":"text","text":" "},{"type":"text","text":"(both using the same "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"type":"text","text":") always returns true, as they both conceptually"},{"type":"text","text":" "},{"type":"text","text":"point at the same distributed actor."}]},{"inlineContent":[{"text":"It is not possible to implement these protocols relying on the actual actor’s","type":"text"},{"text":" ","type":"text"},{"text":"state, because it may be remote and the state may not be available. In other","type":"text"},{"text":" ","type":"text"},{"text":"words, since these protocols must be implemented using ","type":"text"},{"code":"nonisolated","type":"codeVoice"},{"text":" functions,","type":"text"},{"text":" ","type":"text"},{"text":"only ","type":"text"},{"type":"codeVoice","code":"nonisolated"},{"text":" ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"actorSystem"},{"text":" properties are accessible for their","type":"text"},{"text":" ","type":"text"},{"text":"implementations.","type":"text"}],"type":"paragraph"},{"text":"Implicit Codable conformance","type":"heading","anchor":"Implicit-Codable-conformance","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"If created with an actor system whose "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID"},{"text":" is ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"compiler will synthesize code for the concrete distributed actor to conform"},{"type":"text","text":" "},{"text":"to ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" as well.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This is necessary to support distributed calls where the ","type":"text"},{"code":"SerializationRequirement","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"is "},{"code":"Codable","type":"codeVoice"},{"text":" and thus users may want to pass actors as arguments to remote calls.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The synthesized implementations use a single "},{"type":"codeVoice","code":"SingleValueEncodingContainer"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"encode\/decode the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"text":" property of the actor. The ","type":"text"},{"type":"codeVoice","code":"Decoder"},{"type":"text","text":" required"},{"type":"text","text":" "},{"type":"codeVoice","code":"Decoder.init(from:)"},{"type":"text","text":" is implemented by retrieving an actor system from the"},{"text":" ","type":"text"},{"text":"decoders’ ","type":"text"},{"code":"userInfo","type":"codeVoice"},{"text":", effectively like as follows:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["decoder.userInfo[.actorSystemKey] as? ActorSystem"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The such obtained actor system is then used to "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/resolve(id:using:)","type":"reference","isActive":true},{"type":"text","text":" the decoded "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"CodingUserInfoKey.actorSystemKey"},{"type":"text","text":" to provide the necessary"},{"type":"text","text":" "},{"type":"text","text":"actor system for the decoding initializer when decoding a distributed actor."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem"}]}],"type":"aside","style":"note","name":"See Also"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/distributed\/distributedactor"]}],"relationshipsSections":[{"kind":"relationships","type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"]}],"abstract":[{"text":"Common protocol to which all distributed actors conform implicitly.","type":"text"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor"},"topicSections":[{"generated":true,"anchor":"Associated-Types","title":"Associated Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/SerializationRequirement"]},{"generated":true,"anchor":"Initializers","title":"Initializers","identi