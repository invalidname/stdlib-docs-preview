{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor"},"seeAlsoSections":[{"generated":true,"anchor":"Distributed-Actors","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem","doc:\/\/com.apple.Swift\/documentation\/Distributed\/Resolvable()","doc:\/\/com.apple.Swift\/documentation\/Distributed\/buildDefaultDistributedRemoteActorExecutor(_:)"],"title":"Distributed Actors"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DistributedActor","kind":"identifier"},{"text":" : AnyObject, ","kind":"text"},{"text":"Hashable","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"},{"text":", ","kind":"text"},{"text":"Identifiable","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable","kind":"typeIdentifier","preciseIdentifier":"s:s12IdentifiableP"},{"text":", ","kind":"text"},{"text":"Sendable","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DistributedActor"},{"type":"text","text":" protocol generalizes over all distributed actor types."},{"type":"text","text":" "},{"type":"text","text":"Distributed actor types implicitly conform to this protocol."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is not possible to conform to this protocol by any other declaration other than a "},{"type":"codeVoice","code":"distributed actor"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is possible to require a type to conform to the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor","isActive":true},{"type":"text","text":" protocol by refining it with another protocol,"},{"type":"text","text":" "},{"type":"text","text":"or by using a generic constraint."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Synthesized properties","anchor":"Synthesized-properties"},{"inlineContent":[{"type":"text","text":"For every concrete distributed actor declaration, the compiler synthesizes two properties: "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" and "},{"type":"codeVoice","code":"id"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"They witness the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true},{"type":"text","text":" protocol requirements of the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor","isActive":true},{"type":"text","text":" protocol."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is not possible to implement these properties explicitly in user code."},{"type":"text","text":" "},{"type":"text","text":"These properties are "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" and accessible even if the instance is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"remote"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"because "},{"type":"emphasis","inlineContent":[{"type":"text","text":"all"}]},{"type":"text","text":" distributed actor references must store the actor system remote calls"},{"type":"text","text":" "},{"type":"text","text":"will be delivered through, as well as the id identifying the target of those calls."}],"type":"paragraph"},{"type":"heading","level":2,"text":"The ActorSystem associated type","anchor":"The-ActorSystem-associated-type"},{"inlineContent":[{"type":"text","text":"Every distributed actor must declare what type of actor system"},{"type":"text","text":" "},{"type":"text","text":"it is part of by implementing the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","isActive":true},{"type":"text","text":" associated type requirement."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This causes a number of other properties of the actor to be inferred:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/SerializationRequirement","isActive":true},{"type":"text","text":" that will be used at compile time to"},{"type":"text","text":" "},{"type":"text","text":"verify "},{"type":"codeVoice","code":"distributed"},{"type":"text","text":" target declarations are well formed,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if the distributed actor is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", based on the "},{"type":"codeVoice","code":"ID"},{"type":"text","text":" being Codable or not,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the type of the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","isActive":true},{"type":"text","text":" accepted in the synthesized default initializer."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A distributed actor must declare what type of actor system it is ready to"},{"type":"text","text":" "},{"type":"text","text":"work with by fulfilling the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","isActive":true},{"type":"text","text":" type member requirement:"}],"type":"paragraph"},{"type":"codeListing","code":["distributed actor Greeter {","  typealias ActorSystem = GreetingSystem \/\/ which conforms to DistributedActorSystem","","  func greet() -> String { \"Hello!\" }","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"The DefaultDistributedActorSystem type alias","anchor":"The-DefaultDistributedActorSystem-type-alias"},{"inlineContent":[{"type":"text","text":"Since it is fairly common to only be using one specific type of actor system"},{"type":"text","text":" "},{"type":"text","text":"within a module or entire codebase, it is possible to declare the default type"},{"type":"text","text":" "},{"type":"text","text":"of actor system all distributed actors will be using in a module by declaring"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"DefaultDistributedActorSystem"},{"type":"text","text":" module wide typealias:"}],"type":"paragraph"},{"type":"codeListing","code":["import Distributed","import AmazingActorSystemLibrary","","typealias DefaultDistributedActorSystem = AmazingActorSystem","","distributed actor Greeter {} \/\/ ActorSystem == AmazingActorSystem"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"This declaration makes all "},{"type":"codeVoice","code":"distributed actor"},{"type":"text","text":" declarations"},{"type":"text","text":" "},{"type":"text","text":"that do not explicitly specify an "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","isActive":true},{"type":"text","text":" type alias to assume the"},{"type":"text","text":" "},{"type":"codeVoice","code":"AmazingActorSystem"},{"type":"text","text":" as their "},{"type":"codeVoice","code":"ActorSystem"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is possible for a specific actor to override the system it is using,"},{"type":"text","text":" "},{"type":"text","text":"by declaring an "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","isActive":true},{"type":"text","text":" type alias as usual:"}],"type":"paragraph"},{"type":"codeListing","code":["typealias DefaultDistributedActorSystem = AmazingActorSystem","","distributed actor Amazing {","  \/\/ ActorSystem == AmazingActorSystem","}","","distributed actor Superb {","  typealias ActorSystem = SuperbActorSystem","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"In general the "},{"type":"codeVoice","code":"DefaultDistributedActorSystem"},{"type":"text","text":" should not be declared public,"},{"type":"text","text":" "},{"type":"text","text":"as picking the default should be left up to each specific module of a project."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Default initializer","anchor":"Default-initializer"},{"inlineContent":[{"type":"text","text":"While classes and actors receive a synthesized "},{"type":"emphasis","inlineContent":[{"type":"text","text":"argument-free default"},{"type":"text","text":" "},{"type":"text","text":"initializer"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"init()"},{"type":"text","text":"), distributed actors synthesize a default initializer"},{"type":"text","text":" "},{"type":"text","text":"that accepts a distributed actor system the actor is part of: "},{"type":"codeVoice","code":"init(actorSystem:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The accepted actor system must be of the "},{"type":"codeVoice","code":"Self.ActorSystem"},{"type":"text","text":" type, which"},{"type":"text","text":" "},{"type":"text","text":"must conform to the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem","isActive":true},{"type":"text","text":" protocol. This is required"},{"type":"text","text":" "},{"type":"text","text":"because distributed actors are always managed by a concrete"},{"type":"text","text":" "},{"type":"text","text":"distributed actor system and cannot exist on their own without one."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is possible to explicitly declare a parameter-free initializer ("},{"type":"codeVoice","code":"init()"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"however the "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" property still must be assigned a concrete actor"},{"type":"text","text":" "},{"type":"text","text":"system instance the actor shall be part of."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In general it is recommended to always have an "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" parameter as"},{"type":"text","text":" "},{"type":"text","text":"the last non-defaulted non-closure parameter in every actor’s"},{"type":"text","text":" "},{"type":"text","text":"initializer parameter list. This way it is simple to swap in a “test actor"},{"type":"text","text":" "},{"type":"text","text":"system” instance in unit tests, and avoid relying on global state which could"},{"type":"text","text":" "},{"type":"text","text":"make testing more difficult."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Implicit properties","anchor":"Implicit-properties"},{"inlineContent":[{"type":"text","text":"Every concrete "},{"type":"codeVoice","code":"distributed actor"},{"type":"text","text":" type receives two synthesized properties,"},{"type":"text","text":" "},{"type":"text","text":"which implement the protocol requirements of this protocol: "},{"type":"codeVoice","code":"id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Property: Actor System","anchor":"Property-Actor-System"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","isActive":true},{"type":"text","text":" property is an important part of every distributed actor’s lifecycle management."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both initialization as well as de-initialization require interactions with the actor system,"},{"type":"text","text":" "},{"type":"text","text":"and it is the actor system that handles all remote interactions of an actor, by both sending"},{"type":"text","text":" "},{"type":"text","text":"or receiving remote calls made on the actor."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","isActive":true},{"type":"text","text":" property must be assigned in every designated initializer"},{"type":"text","text":" "},{"type":"text","text":"of a distributed actor explicitly. It is highly recommended to make it a"},{"type":"text","text":" "},{"type":"text","text":"parameter of every distributed actor initializer, and simply forward the"},{"type":"text","text":" "},{"type":"text","text":"value to the stored property, like this:"}],"type":"paragraph"},{"type":"codeListing","code":["init(name: String, actorSystem: Self.ActorSystem) {","  self.name = name","  self.actorSystem = actorSystem","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Forgetting to initialize the actor system, will result in a compile time error:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ BAD","init(name: String, actorSystem: Self.ActorSystem) {","  self.name = name","  \/\/ BAD, will cause compile-time error; the `actorSystem` was not initialized.","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"Property: Distributed Actor Identity","anchor":"Property-Distributed-Actor-Identity"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true},{"type":"text","text":" is assigned by the actor system during the distributed actor’s"},{"type":"text","text":" "},{"type":"text","text":"initialization, and cannot be set or mutated by the actor itself."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true},{"type":"text","text":" is the effective identity of the actor, and is used in equality checks,"},{"type":"text","text":" "},{"type":"text","text":"as well as the actor’s synthesized "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance if the "},{"type":"codeVoice","code":"ID"},{"type":"text","text":" type"},{"type":"text","text":" "},{"type":"text","text":"conforms to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Automatic Conformances","anchor":"Automatic-Conformances"},{"type":"heading","level":3,"text":"Hashable and Identifiable conformance","anchor":"Hashable-and-Identifiable-conformance"},{"inlineContent":[{"type":"text","text":"Every distributed actor conforms to the "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Identifiable"},{"type":"text","text":" protocols."},{"type":"text","text":" "},{"type":"text","text":"Its identity is strictly driven by its "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true},{"type":"text","text":", and therefore hash and equality"},{"type":"text","text":" "},{"type":"text","text":"implementations directly delegate to the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true},{"type":"text","text":" property."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Comparing a local distributed actor instance and a remote reference to it"},{"type":"text","text":" "},{"type":"text","text":"(both using the same "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true},{"type":"text","text":") always returns true, as they both conceptually"},{"type":"text","text":" "},{"type":"text","text":"point at the same distributed actor."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is not possible to implement these protocols relying on the actual actor’s"},{"type":"text","text":" "},{"type":"text","text":"state, because it may be remote and the state may not be available. In other"},{"type":"text","text":" "},{"type":"text","text":"words, since these protocols must be implemented using "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" functions,"},{"type":"text","text":" "},{"type":"text","text":"only "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" "},{"type":"codeVoice","code":"id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" properties are accessible for their"},{"type":"text","text":" "},{"type":"text","text":"implementations."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Implicit Codable conformance","anchor":"Implicit-Codable-conformance"},{"inlineContent":[{"type":"text","text":"If created with an actor system whose "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"compiler will synthesize code for the concrete distributed actor to conform"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" as well."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is necessary to support distributed calls where the "},{"type":"codeVoice","code":"SerializationRequirement"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" and thus users may want to pass actors as arguments to remote calls."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The synthesized implementations use a single "},{"type":"codeVoice","code":"SingleValueEncodingContainer"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"encode\/decode the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true},{"type":"text","text":" property of the actor. The "},{"type":"codeVoice","code":"Decoder"},{"type":"text","text":" required"},{"type":"text","text":" "},{"type":"codeVoice","code":"Decoder\/init(from:)"},{"type":"text","text":" is implemented by retrieving an actor system from the"},{"type":"text","text":" "},{"type":"text","text":"decoders’ "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":", effectively like as follows:"}],"type":"paragraph"},{"type":"codeListing","code":["decoder.userInfo[.actorSystemKey] as? ActorSystem","","The such obtained actor system is then used to ``resolve(id:using:)`` the decoded ``ID``.","","Use the ``CodingUserInfoKey\/actorSystemKey`` to provide the necessary","actor system for the decoding initializer when decoding a distributed actor.","","- SeeAlso: ``DistributedActorSystem``","- SeeAlso: ``Actor``","- SeeAlso: ``AnyActor``"],"syntax":"swift"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/distributed\/distributedactor"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"kind":"relationships"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Distributed"]]},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"DistributedActor"}],"externalID":"s:11Distributed0A5ActorP","roleHeading":"Protocol","symbolKind":"protocol","platforms":[{"unavailable":false,"name":"iOS","beta":false,"deprecated":false,"introducedAt":"16.0"},{"unavailable":false,"name":"iPadOS","beta":false,"deprecated":false,"introducedAt":"16.0"},{"unavailable":false,"name":"Mac Catalyst","beta":false,"deprecated":false,"introducedAt":"16.0"},{"unavailable":false,"name":"macOS","beta":false,"deprecated":false,"introducedAt":"13.0"},{"unavailable":false,"name":"tvOS","beta":false,"deprecated":false,"introducedAt":"16.0"},{"unavailable":false,"name":"watchOS","beta":false,"deprecated":false,"introducedAt":"9.0"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DistributedActor"}],"role":"symbol","modules":[{"name":"Distributed"}],"title":"DistributedActor"},"abstract":[{"type":"text","text":"Common protocol to which all distributed actors conform implicitly."}],"topicSections":[{"generated":true,"anchor":"Associated-Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/SerializationRequirement"],"title":"Associated Types"},{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/init(from:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/asLocalActor","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/unownedExecutor"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/assertIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/assumeIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/encode(to:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/preconditionIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/whenLocal(_:)"],"title":"Instance Methods"},{"generated":true,"anchor":"Type-Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/resolve(id:using:)"],"title":"Type Methods"}],"references":{"doc://com.apple.Swift/documentation/Distributed/DistributedActor/init(from:)":{"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"ID"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Decodable"},{"type":"text","text":"."}]},"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/init(from:)","type":"topic","role":"symbol","url":"\/documentation\/distributed\/distributedactor\/init(from:)","kind":"symbol","abstract":[{"text":"Initializes an instance of this distributed actor by decoding its ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and passing it to the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem","isActive":true,"type":"reference"},{"type":"text","text":" obtained from "},{"type":"codeVoice","code":"decoder.userInfo[actorSystemKey]"},{"type":"text","text":"."}],"title":"init(from:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Decoder","kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}]},"doc://com.apple.Swift/documentation/Distributed/DistributedActorSystem/ActorID":{"kind":"symbol","role":"symbol","required":true,"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActorID","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"},{"kind":"text","text":", "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}],"abstract":[{"type":"text","text":"The type ID that will be assigned to any distributed actor managed by this actor system."}],"title":"ActorID","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID","url":"\/documentation\/distributed\/distributedactorsystem\/actorid"},"doc://com.apple.Swift/documentation/Distributed/Resolvable()":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/Resolvable()","type":"topic","role":"symbol","url":"\/documentation\/distributed\/resolvable()","kind":"symbol","title":"Resolvable()","abstract":[{"text":"Enables the attached to protocol to be resolved as remote distributed","type":"text"},{"text":" ","t