{"metadata":{"platforms":[{"introducedAt":"16.0","name":"iOS","unavailable":false,"beta":false,"deprecated":false},{"name":"iPadOS","deprecated":false,"introducedAt":"16.0","unavailable":false,"beta":false},{"name":"Mac Catalyst","deprecated":false,"introducedAt":"16.0","unavailable":false,"beta":false},{"introducedAt":"13.0","name":"macOS","unavailable":false,"beta":false,"deprecated":false},{"name":"tvOS","deprecated":false,"introducedAt":"16.0","unavailable":false,"beta":false},{"introducedAt":"9.0","name":"watchOS","unavailable":false,"beta":false,"deprecated":false}],"modules":[{"name":"Distributed"}],"roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DistributedActor","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"DistributedActor","kind":"identifier"}],"symbolKind":"protocol","externalID":"s:11Distributed0A5ActorP","title":"DistributedActor"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem","doc:\/\/com.apple.Swift\/documentation\/Distributed\/Resolvable()","doc:\/\/com.apple.Swift\/documentation\/Distributed\/buildDefaultDistributedRemoteActorExecutor(_:)"],"title":"Distributed Actors","generated":true,"anchor":"Distributed-Actors"}],"topicSections":[{"anchor":"Associated-Types","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/SerializationRequirement"],"title":"Associated Types"},{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/init(from:)"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/asLocalActor","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/unownedExecutor"],"title":"Instance Properties"},{"anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/assertIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/assumeIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/encode(to:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/preconditionIsolated(_:file:line:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/whenLocal(_:)"],"title":"Instance Methods"},{"anchor":"Type-Methods","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/resolve(id:using:)"],"title":"Type Methods"}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DistributedActor"},{"text":" : AnyObject, ","kind":"text"},{"kind":"typeIdentifier","text":"Hashable","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","preciseIdentifier":"s:SH"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:s12IdentifiableP","text":"Identifiable","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DistributedActor"},{"type":"text","text":" protocol generalizes over all distributed actor types."},{"type":"text","text":" "},{"type":"text","text":"Distributed actor types implicitly conform to this protocol."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is not possible to conform to this protocol by any other declaration other than a "},{"type":"codeVoice","code":"distributed actor"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is possible to require a type to conform to the"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor","type":"reference"},{"text":" protocol by refining it with another protocol,","type":"text"},{"type":"text","text":" "},{"text":"or by using a generic constraint.","type":"text"}],"type":"paragraph"},{"text":"Synthesized properties","anchor":"Synthesized-properties","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"For every concrete distributed actor declaration, the compiler synthesizes two properties: "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" and "},{"type":"codeVoice","code":"id"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"They witness the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","isActive":true},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference"},{"text":" protocol requirements of the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor","type":"reference"},{"text":" protocol.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It is not possible to implement these properties explicitly in user code.","type":"text"},{"text":" ","type":"text"},{"text":"These properties are ","type":"text"},{"code":"nonisolated","type":"codeVoice"},{"text":" and accessible even if the instance is ","type":"text"},{"inlineContent":[{"type":"text","text":"remote"}],"type":"emphasis"},{"type":"text","text":","},{"text":" ","type":"text"},{"text":"because ","type":"text"},{"inlineContent":[{"text":"all","type":"text"}],"type":"emphasis"},{"text":" distributed actor references must store the actor system remote calls","type":"text"},{"text":" ","type":"text"},{"text":"will be delivered through, as well as the id identifying the target of those calls.","type":"text"}],"type":"paragraph"},{"anchor":"The-ActorSystem-associated-type","type":"heading","level":2,"text":"The ActorSystem associated type"},{"inlineContent":[{"text":"Every distributed actor must declare what type of actor system","type":"text"},{"type":"text","text":" "},{"text":"it is part of by implementing the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","isActive":true,"type":"reference"},{"text":" associated type requirement.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This causes a number of other properties of the actor to be inferred:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/SerializationRequirement"},{"type":"text","text":" that will be used at compile time to"},{"type":"text","text":" "},{"type":"text","text":"verify "},{"code":"distributed","type":"codeVoice"},{"type":"text","text":" target declarations are well formed,"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"if the distributed actor is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", based on the "},{"code":"ID","type":"codeVoice"},{"text":" being Codable or not,","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the type of the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"type":"text","text":" accepted in the synthesized default initializer."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"A distributed actor must declare what type of actor system it is ready to"},{"text":" ","type":"text"},{"text":"work with by fulfilling the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","isActive":true,"type":"reference"},{"text":" type member requirement:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["distributed actor Greeter {","  typealias ActorSystem = GreetingSystem \/\/ which conforms to DistributedActorSystem","","  func greet() -> String { \"Hello!\" }","}"]},{"type":"heading","text":"The DefaultDistributedActorSystem type alias","level":3,"anchor":"The-DefaultDistributedActorSystem-type-alias"},{"type":"paragraph","inlineContent":[{"text":"Since it is fairly common to only be using one specific type of actor system","type":"text"},{"text":" ","type":"text"},{"text":"within a module or entire codebase, it is possible to declare the default type","type":"text"},{"text":" ","type":"text"},{"text":"of actor system all distributed actors will be using in a module by declaring","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"DefaultDistributedActorSystem","type":"codeVoice"},{"text":" module wide typealias:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Distributed","import AmazingActorSystemLibrary","","typealias DefaultDistributedActorSystem = AmazingActorSystem","","distributed actor Greeter {} \/\/ ActorSystem == AmazingActorSystem"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This declaration makes all "},{"type":"codeVoice","code":"distributed actor"},{"type":"text","text":" declarations"},{"type":"text","text":" "},{"text":"that do not explicitly specify an ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","isActive":true,"type":"reference"},{"text":" type alias to assume the","type":"text"},{"text":" ","type":"text"},{"code":"AmazingActorSystem","type":"codeVoice"},{"text":" as their ","type":"text"},{"type":"codeVoice","code":"ActorSystem"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible for a specific actor to override the system it is using,"},{"type":"text","text":" "},{"type":"text","text":"by declaring an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"type":"text","text":" type alias as usual:"}]},{"syntax":"swift","type":"codeListing","code":["typealias DefaultDistributedActorSystem = AmazingActorSystem","","distributed actor Amazing {","  \/\/ ActorSystem == AmazingActorSystem","}","","distributed actor Superb {","  typealias ActorSystem = SuperbActorSystem","}"]},{"inlineContent":[{"type":"text","text":"In general the "},{"type":"codeVoice","code":"DefaultDistributedActorSystem"},{"type":"text","text":" should not be declared public,"},{"type":"text","text":" "},{"type":"text","text":"as picking the default should be left up to each specific module of a project."}],"type":"paragraph"},{"type":"heading","text":"Default initializer","level":2,"anchor":"Default-initializer"},{"inlineContent":[{"type":"text","text":"While classes and actors receive a synthesized "},{"type":"emphasis","inlineContent":[{"type":"text","text":"argument-free default"},{"type":"text","text":" "},{"text":"initializer","type":"text"}]},{"type":"text","text":" ("},{"code":"init()","type":"codeVoice"},{"type":"text","text":"), distributed actors synthesize a default initializer"},{"text":" ","type":"text"},{"text":"that accepts a distributed actor system the actor is part of: ","type":"text"},{"code":"init(actorSystem:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The accepted actor system must be of the "},{"type":"codeVoice","code":"Self.ActorSystem"},{"type":"text","text":" type, which"},{"type":"text","text":" "},{"type":"text","text":"must conform to the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem"},{"type":"text","text":" protocol. This is required"},{"type":"text","text":" "},{"type":"text","text":"because distributed actors are always managed by a concrete"},{"type":"text","text":" "},{"type":"text","text":"distributed actor system and cannot exist on their own without one."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is possible to explicitly declare a parameter-free initializer ("},{"type":"codeVoice","code":"init()"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"however the "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" property still must be assigned a concrete actor"},{"type":"text","text":" "},{"type":"text","text":"system instance the actor shall be part of."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In general it is recommended to always have an "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" parameter as"},{"type":"text","text":" "},{"text":"the last non-defaulted non-closure parameter in every actor’s","type":"text"},{"type":"text","text":" "},{"text":"initializer parameter list. This way it is simple to swap in a “test actor","type":"text"},{"type":"text","text":" "},{"type":"text","text":"system” instance in unit tests, and avoid relying on global state which could"},{"type":"text","text":" "},{"type":"text","text":"make testing more difficult."}]},{"anchor":"Implicit-properties","type":"heading","level":2,"text":"Implicit properties"},{"inlineContent":[{"type":"text","text":"Every concrete "},{"type":"codeVoice","code":"distributed actor"},{"type":"text","text":" type receives two synthesized properties,"},{"type":"text","text":" "},{"type":"text","text":"which implement the protocol requirements of this protocol: "},{"type":"codeVoice","code":"id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"Property: Actor System","anchor":"Property-Actor-System","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property"},{"type":"text","text":" property is an important part of every distributed actor’s lifecycle management."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both initialization as well as de-initialization require interactions with the actor system,"},{"type":"text","text":" "},{"type":"text","text":"and it is the actor system that handles all remote interactions of an actor, by both sending"},{"type":"text","text":" "},{"type":"text","text":"or receiving remote calls made on the actor."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property"},{"type":"text","text":" property must be assigned in every designated initializer"},{"type":"text","text":" "},{"type":"text","text":"of a distributed actor explicitly. It is highly recommended to make it a"},{"type":"text","text":" "},{"type":"text","text":"parameter of every distributed actor initializer, and simply forward the"},{"type":"text","text":" "},{"type":"text","text":"value to the stored property, like this:"}],"type":"paragraph"},{"code":["init(name: String, actorSystem: Self.ActorSystem) {","  self.name = name","  self.actorSystem = actorSystem","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Forgetting to initialize the actor system, will result in a compile time error:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ BAD","init(name: String, actorSystem: Self.ActorSystem) {","  self.name = name","  \/\/ BAD, will cause compile-time error; the `actorSystem` was not initialized.","}"],"syntax":"swift"},{"anchor":"Property-Distributed-Actor-Identity","type":"heading","level":3,"text":"Property: Distributed Actor Identity"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" is assigned by the actor system during the distributed actor’s"},{"type":"text","text":" "},{"type":"text","text":"initialization, and cannot be set or mutated by the actor itself."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" is the effective identity of the actor, and is used in equality checks,"},{"text":" ","type":"text"},{"text":"as well as the actor’s synthesized ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance if the ","type":"text"},{"code":"ID","type":"codeVoice"},{"type":"text","text":" type"},{"text":" ","type":"text"},{"type":"text","text":"conforms to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Automatic Conformances","anchor":"Automatic-Conformances","type":"heading"},{"level":3,"text":"Hashable and Identifiable conformance","anchor":"Hashable-and-Identifiable-conformance","type":"heading"},{"inlineContent":[{"type":"text","text":"Every distributed actor conforms to the "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Identifiable"},{"type":"text","text":" protocols."},{"type":"text","text":" "},{"type":"text","text":"Its identity is strictly driven by its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":", and therefore hash and equality"},{"type":"text","text":" "},{"type":"text","text":"implementations directly delegate to the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" property."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Comparing a local distributed actor instance and a remote reference to it"},{"type":"text","text":" "},{"type":"text","text":"(both using the same "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":") always returns true, as they both conceptually"},{"type":"text","text":" "},{"type":"text","text":"point at the same distributed actor."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is not possible to implement these protocols relying on the actual actor’s"},{"type":"text","text":" "},{"type":"text","text":"state, because it may be remote and the state may not be available. In other"},{"type":"text","text":" "},{"type":"text","text":"words, since these protocols must be implemented using "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" functions,"},{"type":"text","text":" "},{"type":"text","text":"only "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" "},{"type":"codeVoice","code":"id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" properties are accessible for their"},{"type":"text","text":" "},{"type":"text","text":"implementations."}],"type":"paragraph"},{"level":3,"text":"Implicit Codable conformance","anchor":"Implicit-Codable-conformance","type":"heading"},{"inlineContent":[{"type":"text","text":"If created with an actor system whose "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"compiler will synthesize code for the concrete distributed actor to conform"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" as well."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is necessary to support distributed calls where the "},{"type":"codeVoice","code":"SerializationRequirement"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" and thus users may want to pass actors as arguments to remote calls."}],"type":"paragraph"},{"inlineContent":[{"text":"The synthesized implementations use a single ","type":"text"},{"type":"codeVoice","code":"SingleValueEncodingContainer"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"encode\/decode the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" property of the actor. The "},{"type":"codeVoice","code":"Decoder"},{"type":"text","text":" required"},{"type":"text","text":" "},{"type":"codeVoice","code":"Decoder\/init(from:)"},{"type":"text","text":" is implemented by retrieving an actor system from the"},{"type":"text","text":" "},{"type":"text","text":"decoders’ "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":", effectively like as follows:"}],"type":"paragraph"},{"code":["decoder.userInfo[.actorSystemKey] as? ActorSystem","","The such obtained actor system is then used to ``resolve(id:using:)`` the decoded ``ID``.","","Use the ``CodingUserInfoKey\/actorSystemKey`` to provide the necessary","actor system for the decoding initializer when decoding a distributed actor.","","- SeeAlso: ``DistributedActorSystem``","- SeeAlso: ``Actor``","- SeeAlso: ``AnyActor``"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor"},"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"type":"inheritsFrom","title":"Inherits From","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/distributed\/distributedactor"]}],"abstract":[{"text":"Common protocol to which all distributed actors conform implicitly.","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Distributed"]]},"references":{"doc://com.apple.Swift/documentation/Distributed/DistributedActorSystem/ActorID":{"title":"ActorID","type":"topic","required":true,"abstract":[{"text":"The type ID that will be assigned to any distributed actor managed by this actor system.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"ActorID"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"role":"symbol","url":"\/documentation\/distributed\/distributedactorsystem\/actorid","kind":"symbol"},"doc://com.apple.Swift/documentation/Distributed/DistributedActor/init(from:)":{"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"ID"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Decodable"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"role":"symbol","title":"init(from:)","abstract":[{"text":"Initializes an instance of this distributed actor by decoding its ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and passing it to the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem","isActive":true,"type":"reference"},{"text":" obtained from ","type":"text"},{"type":"codeVoice","code":"decoder.userInfo[actorSystemKey]"},{"text":".","type":"text"}],"url":"\/documentation\/distributed\/distributedactor\/init(from:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/init(from:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"kind":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/Distributed/buildDefaultDistributedRemoteActorExecutor(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"buildDefaultDistributedRemoteActorExecutor"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Act"},{"kind":"text","text":">("},{"kind":"typeIdentifier","preciseIdentifier":"