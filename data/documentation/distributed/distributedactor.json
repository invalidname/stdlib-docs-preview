{"relationshipsSections":[{"title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"type":"inheritsFrom"}],"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/distributed\/distributedactor"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"DistributedActor","kind":"identifier"},{"text":" : AnyObject, ","kind":"text"},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:s12IdentifiableP","kind":"typeIdentifier","text":"Identifiable","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/com.apple.Swift\/documentation\/Swift\/implementing-a-custom-distributed-actor-system"]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"DistributedActor","type":"codeVoice"},{"text":" protocol generalizes over all distributed actor types.","type":"text"},{"text":" ","type":"text"},{"text":"Distributed actor types implicitly conform to this protocol.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It is not possible to conform to this protocol by any other declaration other than a ","type":"text"},{"code":"distributed actor","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"It is possible to require a type to conform to the","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor","isActive":true},{"text":" protocol by refining it with another protocol,","type":"text"},{"text":" ","type":"text"},{"text":"or by using a generic constraint.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Synthesized properties","anchor":"Synthesized-properties"},{"inlineContent":[{"type":"text","text":"For every concrete distributed actor declaration, the compiler synthesizes two properties: "},{"code":"actorSystem","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"id"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"They witness the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"type":"text","text":" protocol requirements of the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor","isActive":true},{"text":" protocol.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is not possible to implement these properties explicitly in user code."},{"type":"text","text":" "},{"type":"text","text":"These properties are "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" and accessible even if the instance is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"remote"}]},{"type":"text","text":","},{"type":"text","text":" "},{"text":"because ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"all"}]},{"type":"text","text":" distributed actor references must store the actor system remote calls"},{"type":"text","text":" "},{"type":"text","text":"will be delivered through, as well as the id identifying the target of those calls."}]},{"text":"The ActorSystem associated type","level":2,"anchor":"The-ActorSystem-associated-type","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Every distributed actor must declare what type of actor system","type":"text"},{"type":"text","text":" "},{"type":"text","text":"it is part of by implementing the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"type":"text","text":" associated type requirement."}]},{"type":"paragraph","inlineContent":[{"text":"This causes a number of other properties of the actor to be inferred:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/SerializationRequirement","type":"reference","isActive":true},{"text":" that will be used at compile time to","type":"text"},{"text":" ","type":"text"},{"text":"verify ","type":"text"},{"type":"codeVoice","code":"distributed"},{"text":" target declarations are well formed,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"if the distributed actor is ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":", based on the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"text":" being Codable or not,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the type of the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"text":" accepted in the synthesized default initializer.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A distributed actor must declare what type of actor system it is ready to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"work with by fulfilling the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype"},{"type":"text","text":" type member requirement:"}],"type":"paragraph"},{"syntax":"swift","code":["distributed actor Greeter {","  typealias ActorSystem = GreetingSystem \/\/ which conforms to DistributedActorSystem","","  func greet() -> String { \"Hello!\" }","}"],"type":"codeListing"},{"level":3,"type":"heading","text":"The DefaultDistributedActorSystem type alias","anchor":"The-DefaultDistributedActorSystem-type-alias"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since it is fairly common to only be using one specific type of actor system"},{"type":"text","text":" "},{"type":"text","text":"within a module or entire codebase, it is possible to declare the default type"},{"text":" ","type":"text"},{"text":"of actor system all distributed actors will be using in a module by declaring","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"DefaultDistributedActorSystem","type":"codeVoice"},{"text":" module wide typealias:","type":"text"}]},{"code":["import Distributed","import AmazingActorSystemLibrary","","typealias DefaultDistributedActorSystem = AmazingActorSystem","","distributed actor Greeter {} \/\/ ActorSystem == AmazingActorSystem"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This declaration makes all "},{"type":"codeVoice","code":"distributed actor"},{"type":"text","text":" declarations"},{"text":" ","type":"text"},{"text":"that do not explicitly specify an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","type":"reference"},{"text":" type alias to assume the","type":"text"},{"text":" ","type":"text"},{"code":"AmazingActorSystem","type":"codeVoice"},{"type":"text","text":" as their "},{"code":"ActorSystem","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible for a specific actor to override the system it is using,"},{"type":"text","text":" "},{"type":"text","text":"by declaring an "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/ActorSystem-swift.associatedtype","type":"reference","isActive":true},{"type":"text","text":" type alias as usual:"}]},{"type":"codeListing","code":["typealias DefaultDistributedActorSystem = AmazingActorSystem","","distributed actor Amazing {","  \/\/ ActorSystem == AmazingActorSystem","}","","distributed actor Superb {","  typealias ActorSystem = SuperbActorSystem","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"In general the ","type":"text"},{"type":"codeVoice","code":"DefaultDistributedActorSystem"},{"text":" should not be declared public,","type":"text"},{"type":"text","text":" "},{"text":"as picking the default should be left up to each specific module of a project.","type":"text"}]},{"level":2,"text":"Default initializer","type":"heading","anchor":"Default-initializer"},{"inlineContent":[{"type":"text","text":"While classes and actors receive a synthesized "},{"inlineContent":[{"text":"argument-free default","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"initializer"}],"type":"emphasis"},{"type":"text","text":" ("},{"type":"codeVoice","code":"init()"},{"type":"text","text":"), distributed actors synthesize a default initializer"},{"text":" ","type":"text"},{"type":"text","text":"that accepts a distributed actor system the actor is part of: "},{"type":"codeVoice","code":"init(actorSystem:)"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The accepted actor system must be of the "},{"type":"codeVoice","code":"Self.ActorSystem"},{"type":"text","text":" type, which"},{"text":" ","type":"text"},{"type":"text","text":"must conform to the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem"},{"type":"text","text":" protocol. This is required"},{"type":"text","text":" "},{"type":"text","text":"because distributed actors are always managed by a concrete"},{"type":"text","text":" "},{"type":"text","text":"distributed actor system and cannot exist on their own without one."}]},{"inlineContent":[{"text":"It is possible to explicitly declare a parameter-free initializer (","type":"text"},{"code":"init()","type":"codeVoice"},{"text":"),","type":"text"},{"type":"text","text":" "},{"text":"however the ","type":"text"},{"type":"codeVoice","code":"actorSystem"},{"text":" property still must be assigned a concrete actor","type":"text"},{"type":"text","text":" "},{"type":"text","text":"system instance the actor shall be part of."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In general it is recommended to always have an "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" parameter as"},{"text":" ","type":"text"},{"text":"the last non-defaulted non-closure parameter in every actor’s","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"initializer parameter list. This way it is simple to swap in a “test actor"},{"type":"text","text":" "},{"text":"system” instance in unit tests, and avoid relying on global state which could","type":"text"},{"type":"text","text":" "},{"type":"text","text":"make testing more difficult."}]},{"text":"Implicit properties","level":2,"type":"heading","anchor":"Implicit-properties"},{"type":"paragraph","inlineContent":[{"text":"Every concrete ","type":"text"},{"code":"distributed actor","type":"codeVoice"},{"text":" type receives two synthesized properties,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"which implement the protocol requirements of this protocol: "},{"type":"codeVoice","code":"id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":"."}]},{"text":"Property: Actor System","type":"heading","anchor":"Property-Actor-System","level":3},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","type":"reference","isActive":true},{"text":" property is an important part of every distributed actor’s lifecycle management.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Both initialization as well as de-initialization require interactions with the actor system,","type":"text"},{"text":" ","type":"text"},{"text":"and it is the actor system that handles all remote interactions of an actor, by both sending","type":"text"},{"text":" ","type":"text"},{"text":"or receiving remote calls made on the actor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/actorSystem-swift.property","type":"reference","isActive":true},{"text":" property must be assigned in every designated initializer","type":"text"},{"text":" ","type":"text"},{"text":"of a distributed actor explicitly. It is highly recommended to make it a","type":"text"},{"text":" ","type":"text"},{"text":"parameter of every distributed actor initializer, and simply forward the","type":"text"},{"text":" ","type":"text"},{"text":"value to the stored property, like this:","type":"text"}]},{"code":["init(name: String, actorSystem: Self.ActorSystem) {","  self.name = name","  self.actorSystem = actorSystem","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forgetting to initialize the actor system, will result in a compile time error:"}]},{"code":["\/\/ BAD","init(name: String, actorSystem: Self.ActorSystem) {","  self.name = name","  \/\/ BAD, will cause compile-time error; the `actorSystem` was not initialized.","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Property: Distributed Actor Identity","anchor":"Property-Distributed-Actor-Identity","level":3},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true},{"type":"text","text":" is assigned by the actor system during the distributed actor’s"},{"type":"text","text":" "},{"type":"text","text":"initialization, and cannot be set or mutated by the actor itself."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"type":"text","text":" is the effective identity of the actor, and is used in equality checks,"},{"type":"text","text":" "},{"type":"text","text":"as well as the actor’s synthesized "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance if the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","type":"reference","isActive":true},{"text":" type","type":"text"},{"text":" ","type":"text"},{"text":"conforms to ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Automatic Conformances","type":"heading","anchor":"Automatic-Conformances","level":2},{"text":"Hashable and Identifiable conformance","type":"heading","anchor":"Hashable-and-Identifiable-conformance","level":3},{"inlineContent":[{"type":"text","text":"Every distributed actor conforms to the "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Identifiable","type":"codeVoice"},{"type":"text","text":" protocols."},{"type":"text","text":" "},{"type":"text","text":"Its identity is strictly driven by its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":", and therefore hash and equality"},{"type":"text","text":" "},{"type":"text","text":"implementations directly delegate to the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":" property."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Comparing a local distributed actor instance and a remote reference to it"},{"type":"text","text":" "},{"type":"text","text":"(both using the same "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id"},{"type":"text","text":") always returns true, as they both conceptually"},{"type":"text","text":" "},{"type":"text","text":"point at the same distributed actor."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is not possible to implement these protocols relying on the actual actor’s"},{"type":"text","text":" "},{"type":"text","text":"state, because it may be remote and the state may not be available. In other"},{"type":"text","text":" "},{"type":"text","text":"words, since these protocols must be implemented using "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" functions,"},{"type":"text","text":" "},{"type":"text","text":"only "},{"type":"codeVoice","code":"nonisolated"},{"type":"text","text":" "},{"type":"codeVoice","code":"id"},{"type":"text","text":" and "},{"type":"codeVoice","code":"actorSystem"},{"type":"text","text":" properties are accessible for their"},{"type":"text","text":" "},{"type":"text","text":"implementations."}]},{"level":3,"type":"heading","anchor":"Implicit-Codable-conformance","text":"Implicit Codable conformance"},{"type":"paragraph","inlineContent":[{"text":"If created with an actor system whose ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID","type":"reference","isActive":true},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"compiler will synthesize code for the concrete distributed actor to conform","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" as well."}]},{"inlineContent":[{"text":"This is necessary to support distributed calls where the ","type":"text"},{"type":"codeVoice","code":"SerializationRequirement"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" and thus users may want to pass actors as arguments to remote calls.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The synthesized implementations use a single ","type":"text"},{"code":"SingleValueEncodingContainer","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"encode\/decode the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true,"type":"reference"},{"text":" property of the actor. The ","type":"text"},{"code":"Decoder","type":"codeVoice"},{"text":" required","type":"text"},{"text":" ","type":"text"},{"code":"Decoder.init(from:)","type":"codeVoice"},{"text":" is implemented by retrieving an actor system from the","type":"text"},{"text":" ","type":"text"},{"text":"decoders’ ","type":"text"},{"code":"userInfo","type":"codeVoice"},{"text":", effectively like as follows:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["decoder.userInfo[.actorSystemKey] as? ActorSystem"],"type":"codeListing"},{"inlineContent":[{"text":"The such obtained actor system is then used to ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/resolve(id:using:)","isActive":true,"type":"reference"},{"text":" the decoded ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":"CodingUserInfoKey.actorSystemKey","type":"codeVoice"},{"text":" to provide the necessary","type":"text"},{"text":" ","type":"text"},{"text":"actor system for the decoding initializer when decoding a distributed actor.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem"}]}],"style":"note","type":"aside","name":"See Also"}]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"DistributedActor"}],"externalID":"s:11Distributed0A5ActorP","role":"symbol","modules":[{"name":"Distributed"}],"title":"DistributedActor","roleHeading":"Protocol","symbolKind":"protocol","platforms":[{"beta":false,"name":"iOS","introducedAt":"16.0","deprecated":false,"unavailable":false},{"beta":false,"name":"iPadOS","introducedAt":"16.0","deprecated":false,"unavailable":false},{"beta":false,"name":"Mac Catalyst","introducedAt":"16.0","deprecated":false,"unavailable":false},{"beta":false,"name":"macOS","introducedAt":"13.0","deprecated":false,"unavailable":false},{"beta":false,"name":"tvOS","introducedAt":"16.0","deprecated":false,"unavailable":false},{"unavailable":false,"name":"watchOS","introducedAt":"9.0","beta":false,"deprecated":false}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":