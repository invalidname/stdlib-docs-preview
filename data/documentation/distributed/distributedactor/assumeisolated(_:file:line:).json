tent","content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"The return value of the ","type":"text"},{"code":"operation","type":"codeVoice"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"This method allows to ","type":"text"},{"inlineContent":[{"text":"assume and verify","type":"text"}],"type":"emphasis"},{"text":" that the currently","type":"text"},{"text":" ","type":"text"},{"text":"executing synchronous function is actually executing on the serial","type":"text"},{"text":" ","type":"text"},{"text":"executor of the this (local) distributed actor.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If that is the case, the operation is invoked isolated to the main actor","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"("},{"code":"@MainActor () -> T","type":"codeVoice"},{"type":"text","text":"), allowing synchronous access to actor local state"},{"type":"text","text":" "},{"type":"text","text":"without hopping through asynchronous boundaries."}]},{"inlineContent":[{"type":"text","text":"If the current context is not running on the actor’s serial executor,"},{"type":"text","text":" "},{"type":"text","text":"this method will crash with a fatal error (similar"},{"type":"text","text":" "},{"type":"text","text":"to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/preconditionIsolated(_:file:line:)"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method can only be used from synchronous functions, as asynchronous"},{"type":"text","text":" "},{"type":"text","text":"functions should instead perform a normal method call to the actor, which"},{"type":"text","text":" "},{"type":"text","text":"will hop task execution to the target actor if necessary."}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Because this check is performed against the actor’s serial executor,"},{"type":"text","text":" "},{"type":"text","text":"if another actor uses the same serial executor–by using"},{"type":"text","text":" "},{"type":"text","text":"another actor’s executor as its own "},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/unownedExecutor","type":"reference"},{"text":" ","type":"text"},{"text":"–this check will succeed.  From a concurrency safety perspective,","type":"text"},{"text":" ","type":"text"},{"text":"the serial executor guarantees mutual exclusion of those two actors.","type":"text"}],"type":"paragraph"}]},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The error thrown by the operation, if it threw"}],"type":"paragraph"}]}]}],"metadata":{"title":"assumeIsolated(_:file:line:)","extendedModule":"Distributed","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"assumeIsolated","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">((","kind":"text"},{"text":"isolated","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"E","preciseIdentifier":"s:11Distributed0A5ActorPAAE14assumeIsolated_4file4lineqd__qd__xYiqd_0_YKXE_s12StaticStringVSutqd_0_YKs8SendableRd__s5ErrorRd_0_Ri_d__r0_lF1EL_qd_0_mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"T","preciseIdentifier":"s:11Distributed0A5ActorPAAE14assumeIsolated_4file4lineqd__qd__xYiqd_0_YKXE_s12StaticStringVSutqd_0_YKs8SendableRd__s5ErrorRd_0_Ri_d__r0_lF1TL_qd__mfp","kind":"typeIdentifier"},{"text