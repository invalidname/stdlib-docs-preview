{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Distributed","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor"]]},"metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s12IdentifiableP2IDQa","text":"ID"}],"platforms":[{"deprecated":false,"unavailable":false,"beta":false,"name":"iOS","introducedAt":"16.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"iPadOS","introducedAt":"16.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"Mac Catalyst","introducedAt":"16.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"macOS","introducedAt":"13.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"tvOS","introducedAt":"16.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"watchOS","introducedAt":"9.0"}],"externalID":"s:11Distributed0A5ActorP2id2IDQzvp","required":true,"role":"symbol","roleHeading":"Instance Property","title":"id","modules":[{"name":"Distributed"}],"symbolKind":"property"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"nonisolated","kind":"attribute"},{"text":" ","kind":"text"},{"text":"override","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ID","kind":"typeIdentifier","preciseIdentifier":"s:s12IdentifiableP2IDQa","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable\/ID-swift.associatedtype"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Many distributed actor references may be pointing at, logically, the same actor."},{"type":"text","text":" "},{"type":"text","text":"For example, calling "},{"type":"codeVoice","code":"resolve(id:using:)"},{"type":"text","text":" multiple times, is not guaranteed"},{"type":"text","text":" "},{"type":"text","text":"to return the same exact resolved actor instance, however all the references would"},{"type":"text","text":" "},{"type":"text","text":"represent logically references to the same distributed actor, e.g. on a different node."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Depending on the capabilities of the actor system producing the identifiers,"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"ID"},{"type":"text","text":" may also be used to store instance specific metadata."}]},{"anchor":"Synthesized-property","type":"heading","level":2,"text":"Synthesized property"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In concrete distributed actor declarations, a witness for this protocol requirement is synthesized by the compiler."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is not possible to assign a value to the "},{"type":"codeVoice","code":"id"},{"type":"text","text":" directly; instead, it is assigned during an actors "},{"type":"codeVoice","code":"init"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"resolve"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"by the managing actor system."}]}]}],"variants":[{"paths":["\/documentation\/distributed\/distributedactor\/id"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Logical identity of this distributed actor."}],"references":{"doc://com.apple.Swift/documentation/Distributed":{"url":"\/documentat