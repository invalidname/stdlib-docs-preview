{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor\/id","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"nonisolated","kind":"attribute"},{"text":" ","kind":"text"},{"text":"override","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ID","kind":"typeIdentifier","preciseIdentifier":"s:s12IdentifiableP2IDQa","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable\/ID-swift.associatedtype"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Many distributed actor references may be pointing at, logically, the same actor.","type":"text"},{"text":" ","type":"text"},{"text":"For example, calling ","type":"text"},{"type":"codeVoice","code":"resolve(id:using:)"},{"text":" multiple times, is not guaranteed","type":"text"},{"text":" ","type":"text"},{"text":"to return the same exact resolved actor instance, however all the references would","type":"text"},{"text":" ","type":"text"},{"text":"represent logically references to the same distributed actor, e.g. on a different node.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Depending on the capabilities of the actor system producing the identifiers,","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"codeVoice","code":"ID"},{"text":" may also be used to store instance specific metadata.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Synthesized property","anchor":"Synthesized-property"},{"inlineContent":[{"text":"In concrete distributed actor declarations, a witness for this protocol requirement is synthesized by the compiler.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It is not possible to assign a value to the ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" directly; instead, it is assigned during an actors ","type":"text"},{"type":"codeVoice","code":"init"},{"text":" (or ","type":"text"},{"type":"codeVoice","code":"resolve"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"by the managing actor system.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/distributed\/distributedactor\/id"]}],"abstract":[{"text":"Logical identity of this distributed actor.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Distributed","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","metadata":{"externalID":"s:11Distributed0A5ActorP2id2IDQzvp","role":"symbol","title":"id","roleHeading":"Instance Property","required":true,"symbolKind":"property","platforms":[{"beta":false,"name":"iOS","deprecated":false,"introducedAt":"16.0","unavailable":false},{"beta":false,"name":"iPadOS","deprecated":false,"introducedAt":"16.0","unavailable":false},{"beta":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"16.0","unavailable":false},{"beta":false,"name":"macOS","deprecated":false,"introducedAt":"13.0","unavailable":false},{"beta":false,"name":"tvOS","deprecated":false,"introducedAt":"16.0","unavailable":false},{"beta":false,"name":"watchOS","deprecated":false,"introducedAt":"9.0","unavailable":false}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s12IdentifiableP2IDQa","text":"ID"}],"modules":[{"name":"Distributed"}]},"sections":[],"references":{"doc://com.apple.Swift/documentation/Distributed":{"title":"Distribute