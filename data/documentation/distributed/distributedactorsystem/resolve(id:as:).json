ype":"text"}]},{"syntax":"swift","type":"codeListing","code":["distributed actor Worker { \/* ... *\/ }","","\/\/ the following internally calls actorSystem.resolve(id: id, as: Worker.self)","let worker: Worker = try  Worker.resolve(id: id, using: actorSystem)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If this function returns correctly, the returned actor reference is immediately"},{"type":"text","text":" "},{"type":"text","text":"usable. It may not necessarily imply the strict "},{"type":"emphasis","inlineContent":[{"type":"text","text":"existence"}]},{"type":"text","text":" of a remote actor"},{"type":"text","text":" "},{"type":"text","text":"the identity was pointing towards, e.g. when a remote system allocates actors"},{"type":"text","text":" "},{"type":"text","text":"lazily as they are first time messaged to, however this should not be a concern"},{"type":"text","text":" "},{"type":"text","text":"of the sending side."}]},{"inlineContent":[{"type":"text","text":"Detecting liveness of such remote actors shall be offered \/ by transport libraries"},{"type":"text","text":" "},{"type":"text","text":"by other means, such as “watching an actor for termination” or similar."}],"type":"paragraph"},{"type":"aside","name":"Throws","content":[{"inlineContent":[{"type":"text","text":"When unable to confirm if the "},{"type":"codeVoice","code":"id"},{"text":" is correct, the resolved actor does not match the expected ","type":"text"},{"type":"codeVoice","code":"actorType"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"or any other internal validation error within the actor system’s resolve process occurs.","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Resolves a local or remote "},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID","type":"reference"},{"type":"text","text":" to a reference to given actor, or throws