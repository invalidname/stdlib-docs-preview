ier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID","preciseIdentifier":"s:11Distributed0A11ActorSystemP0B2IDQa","text":"ActorID","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"Act","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable\/ID-swift.associatedtype","preciseIdentifier":"s:s12IdentifiableP2IDQa","text":"ID","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"id","content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ActorID"},{"type":"text","text":" to resolve an actor reference for"}],"type":"paragraph"}]},{"name":"actorType","content":[{"inlineContent":[{"type":"text","text":"The type of distributed actor the ID is expected to point at."}],"type":"paragraph"}]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The returned value is either a local actor or proxy to a remote actor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This function is not intended to be used directly, but instead is called by the Swift runtime","type":"text"},{"text":" ","type":"text"},{"text":"whenever ``DistributedActor\/resolve(id:using:)","type":"text"},{"type":"codeVoice","code":"or  a concrete distributed actor's"},{"text":"init(from:)` is invoked.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This function should either return an existing actor reference, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" to signal that a remote distributed actor","type":"text"},{"text":" ","type":"text"},{"text":"“proxy” should be created for this ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID","isActive":true},{"text":". If the resolve fails, meaning that it can neither locate a local","type":"text"},{"text":" ","type":"text"},{"text":"actor managed by this actor system, nor identify that the identity is located on some remote actor system, then","type":"text"},{"text":" ","type":"text"},{"text":"this function should throw.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["distributed actor Worker { \/* ... *\/ }","","\/\/ the following internally calls actorSystem.resolve(id: id, as: Worker.self)","let worker: Worker = try  Worker.resolve(id: id, using: actorSystem)"]},{"type":"paragraph","inlineContent":[{"text":"If this function returns correctly, the returned actor reference is immediately","type":"text"},{"text":" ","type":"text"},{"text":"usable. It may not necessarily imply the strict ","type":"text"},{"inlineContent":[{"type":"text","text":"existence"}],"type":"emphasis"},{"text":" of a remote actor","type":"text"},{"text":" ","type":"text"},{"text":"the identity was pointing towards, e.g. when a remote system allocates actors","type":"text"},{"text":" ","type":"text"},{"text":"lazily as they are first time messaged to, however this should not be a concern","type":"text"},{"text":" ","type":"text"},{"text":"of the sending side.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Detecting liveness of such remote actors shall be offered \/ by transport libraries","type":"text"},{"text":" ","type":"text"},{"text":"by other means, such as “watching an actor for termination” or similar.","type":"text"}]},{"name":"Throws","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"When unable to confirm if the "},{"type":"codeVoice","code":"id"},{"type":"text","text":" is correct, the resolved actor does not match the expected "},{"type":"codeVoice","code":"actorType"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or any other internal validation error within the actor system’s resolve process occurs."}],"type":"paragraph"}]}],"