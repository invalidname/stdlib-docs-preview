type":"text","text":" "},{"type":"text","text":"this function should throw."}],"type":"paragraph"},{"syntax":"swift","code":["distributed actor Worker { \/* ... *\/ }","","\/\/ the following internally calls actorSystem.resolve(id: id, as: Worker.self)","let worker: Worker = try  Worker.resolve(id: id, using: actorSystem)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If this function returns correctly, the returned actor reference is immediately"},{"type":"text","text":" "},{"type":"text","text":"usable. It may not necessarily imply the strict "},{"type":"emphasis","inlineContent":[{"text":"existence","type":"text"}]},{"type":"text","text":" of a remote actor"},{"type":"text","text":" "},{"type":"text","text":"the identity was pointing towards, e.g. when a remote system allocates actors"},{"type":"text","text":" "},{"type":"text","text":"lazily as they are first time messaged to, however this should not be a concern"},{"type":"text","text":" "},{"type":"text","text":"of the sending side."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Detecting liveness of such remote actors shall be offered \/ by transport libraries"},{"type":"text","text":" "},{"type":"text","text":"by other means, such as “watching an actor for termination” or similar."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"When unable to confirm if the ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" is correct, the resolved actor does not match the expected ","type":"text"},{"type":"codeVoice","code":"actorType"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"or any other internal validation error within the actor system’s resolve process occurs.","type":"text"}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/distributed\/distributedactorsystem\/resolve(id:as:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Sw