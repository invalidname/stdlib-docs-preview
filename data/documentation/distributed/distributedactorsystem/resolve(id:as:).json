ift\/documentation\/Swift\/Identifiable\/ID-swift.associatedtype","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"ActorID","type":"codeVoice"},{"text":" to resolve an actor reference for","type":"text"}]}],"name":"id"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The type of distributed actor the ID is expected to point at.","type":"text"}]}],"name":"actorType"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned value is either a local actor or proxy to a remote actor."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This function is not intended to be used directly, but instead is called by the Swift runtime"},{"type":"text","text":" "},{"type":"text","text":"whenever ``DistributedActor\/resolve(id:using:)"},{"type":"codeVoice","code":"or  a concrete distributed actor's"},{"type":"text","text":"init(from:)` is invoked."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This function should either return an existing actor reference, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to signal that a remote distributed actor"},{"type":"text","text":" "},{"type":"text","text":"“proxy” should be created for this "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID"},{"type":"text","text":". If the resolve fails, meaning that it can neither locate a local"},{"type":"text","text":" "},{"type":"text","text":"actor managed by this actor system, nor identify that the identity is located on some remote actor system, then"},{"type":"text","text":" "},{"type":"text","text":"this function should throw."}]},{"type":"codeListing","syntax":"swift","code":["distributed actor Worker { \/* ... *\/ }","","\/\/ the following internally calls actorSystem.resolve(id: id, as: Worker.self)","let worker: Worker = try  Worker.resolve(id: id, using: actorSystem)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If this function returns correctly, the returned actor reference is immediately"},{"type":"text","text":" "},{"type":"text","text":"usable. It may not necessarily imply the strict "},{"type":"emphasis","inlineContent":[{"text":"existence","type":"text"}]},{"type":"text","text":" of a remote actor"},{"type":"text","text":" "},{"type":"text","text":"the identity was pointing towards, e.g. when a remote system allocates actors"},{"type":"text","text":" "},{"type":"text","text":"lazily as they are first time messaged to, however this should not be a concern"},{"type":"text","text":" "},{"type":"text","text":"of the sending side."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Detecting liveness of such remote actors shall be offered \/ by transport libraries"},{"type":"text","text":" "},{"type":"text","text":"by other means, such as “watching an actor for termination” or similar."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"When unable to confirm if the ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" is correct, the resolved actor does not match the expected ","type":"text"},{"code":"actorType","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"or any other internal validation error within the actor system’s resolve process occurs.","type":"text"}]}],"style":"note","type":"aside","name":"Throws"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Distributed","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem"]]},"abstract":[{"text":"Resolves a local or remote ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedAct