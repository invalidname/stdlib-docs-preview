ode":"nil","type":"codeVoice"},{"text":" to signal that a remote distributed actor","type":"text"},{"text":" ","type":"text"},{"text":"“proxy” should be created for this ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID","type":"reference"},{"text":". If the resolve fails, meaning that it can neither locate a local","type":"text"},{"text":" ","type":"text"},{"text":"actor managed by this actor system, nor identify that the identity is located on some remote actor system, then","type":"text"},{"text":" ","type":"text"},{"text":"this function should throw.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["distributed actor Worker { \/* ... *\/ }","","\/\/ the following internally calls actorSystem.resolve(id: id, as: Worker.self)","let worker: Worker = try  Worker.resolve(id: id, using: actorSystem)"]},{"type":"paragraph","inlineContent":[{"text":"If this function returns correctly, the returned actor reference is immediately","type":"text"},{"text":" ","type":"text"},{"text":"usable. It may not necessarily imply the strict ","type":"text"},{"inlineContent":[{"type":"text","text":"existence"}],"type":"emphasis"},{"text":" of a remote actor","type":"text"},{"text":" ","type":"text"},{"text":"the identity was pointing towards, e.g. when a remote system allocates actors","type":"text"},{"text":" ","type":"text"},{"text":"lazily as they are first time messaged to, however this should not be a concern","type":"text"},{"text":" ","type":"text"},{"text":"of the sending side.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Detecting liveness of such remote actors shall be offered \/ by transport libraries","type":"text"},{"text":" ","type":"text"},{"text":"by other means, such as “watching an actor for termination” or similar.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"When unable to confirm if the "},{"code":"id","type":"codeVoice"},{"type":"text","text":" is correct, the resolved actor does not match the expected "},{"code":"actorType","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or any other internal validation error within the actor system’s resolve process occurs."}],"type":"paragraph"}],"style":"note","name":"Throws"}],"kind":"content"}],"metadata":{"role":"symbol","roleHeading":"Instance Method","platforms":[{"unavailable":false,"name":"iOS","beta":false,"deprecated":false,"introducedAt":"16.0"},{"unavailable":false,"name":"iPadOS","beta":false,"deprecated":false,"introducedAt":"16.0"},{"unavailable":false,"name":"Mac Catalyst","beta":false,"deprecated":false,"introducedAt":"16.0"},{"unavailable":false,"name":"macOS","beta":false,"deprecated":false,"introducedAt":"13.0"},{"unavailable":false,"name":"tvOS","beta":false,"deprecated":false,"introducedAt":"16.0"},{"unavailable":false,"name":"watchOS","beta":false,"deprecated":false,"introducedAt":"9.0"}],"title":"resolve(id:as:)","symbolKind":"method","required":true,"modules":[{"name":"Distributed"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resolve","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Act","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ActorID","kind":"typeIdentifier","preciseIdentifier":"s:11Distributed0A11ActorSystemP0B2IDQa"},{"text":", ","kind":"text"},{"text":"as","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Act","kind":"typeIdentifier","preciseIdentifier":"s:11Distributed0A11ActorSystemP7resolve2id2asqd__Sg0B2IDQz_qd__mtKAA0aB0Rd__0G0Qyd__AIRSlF3ActL_qd__mfp"},{"text":".Type) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Act","kind":"typeIdentifier","preciseIdentifier":"s:11Distributed0A11ActorSystemP7resolve2id2asqd__Sg0B2IDQz_qd__mtKAA0aB0Rd__0G0Qyd__AIRSlF3ActL_qd__m