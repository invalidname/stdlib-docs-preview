ion should throw."}]},{"type":"codeListing","syntax":"swift","code":["distributed actor Worker { \/* ... *\/ }","","\/\/ the following internally calls actorSystem.resolve(id: id, as: Worker.self)","let worker: Worker = try  Worker.resolve(id: id, using: actorSystem)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If this function returns correctly, the returned actor reference is immediately"},{"type":"text","text":" "},{"type":"text","text":"usable. It may not necessarily imply the strict "},{"type":"emphasis","inlineContent":[{"text":"existence","type":"text"}]},{"type":"text","text":" of a remote actor"},{"type":"text","text":" "},{"text":"the identity was pointing towards, e.g. when a remote system allocates actors","type":"text"},{"type":"text","text":" "},{"type":"text","text":"lazily as they are first time messaged to, however this should not be a concern"},{"type":"text","text":" "},{"type":"text","text":"of the sending side."}]},{"inlineContent":[{"type":"text","text":"Detecting liveness of such remote actors shall be offered \/ by transport libraries"},{"type":"text","text":" "},{"type":"text","text":"by other means, such as “watching an actor for termination” or similar."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Throws","content":[{"inlineContent":[{"type":"text","text":"When unable to confirm if the "},{"type":"codeVoice","code":"id"},{"type":"text","text":" is correct, the resolved actor does not match the expected "},{"type":"codeVoice","code":"actorType"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"or any other internal validation error within the actor system’s resolve process occurs."}],"type":"paragraph"}]}]}],"kind":"symbol","abstract":[{"type":"text","text":"Resolves a local or remote "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/ActorID","type":"reference","isActive":true},{"type":"text","text":" to a reference to given actor, or