{"sections":[],"relationshipsSections":[{"kind":"relationships","type":"conformingTypes","title":"Conforming Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/LocalTestingInvocationDecoder"]}],"metadata":{"externalID":"s:11Distributed0A23TargetInvocationDecoderP","navigatorTitle":[{"text":"DistributedTargetInvocationDecoder","kind":"identifier"}],"title":"DistributedTargetInvocationDecoder","platforms":[{"unavailable":false,"beta":false,"name":"iOS","introducedAt":"16.0","deprecated":false},{"beta":false,"deprecated":false,"name":"iPadOS","unavailable":false,"introducedAt":"16.0"},{"unavailable":false,"beta":false,"name":"Mac Catalyst","introducedAt":"16.0","deprecated":false},{"beta":false,"deprecated":false,"name":"macOS","unavailable":false,"introducedAt":"13.0"},{"beta":false,"deprecated":false,"name":"tvOS","unavailable":false,"introducedAt":"16.0"},{"beta":false,"deprecated":false,"name":"watchOS","unavailable":false,"introducedAt":"9.0"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DistributedTargetInvocationDecoder"}],"modules":[{"name":"Distributed"}],"symbolKind":"protocol","role":"symbol","roleHeading":"Protocol"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Distributed"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DistributedTargetInvocationDecoder"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationDecoder\/SerializationRequirement","preciseIdentifier":"s:11Distributed0A23TargetInvocationDecoderP24SerializationRequirementQa","text":"SerializationRequirement"},{"kind":"text","text":">"}]}]},{"content":[{"anchor":"Decoding-DistributedActor-arguments-using-Codable","type":"