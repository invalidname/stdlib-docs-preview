ed by this ID, or creating a remote actor reference."},{"type":"text","text":" "},{"type":"text","text":"Thus, you must set the actor system the decoding is performed for, on the decoder’s "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":", as follows:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["mutating func decodeNextArgument<Argument: SerializationRequirement>() throws -> Argument {","  let argumentData: Data = \/\/\/ ...","  \/\/ ...","  decoder.userInfo[.actorSystemKey] = self.actorSystem","  return try Argument.decode(","}"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/distributed\/distributedtargetinvocationdecoder"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Decoder that must be provided to ","type":"text"},{"type":"codeVoice","code":"executeDistributedTarget"},{"text":" and is used","type":"text"},{"text":" ","type":"text"},{"text":"by the Swift runtime to decode arguments of the invocation.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationDecoder"},"topicSections":[{"anchor":"Associated-Types","generated":true,"title":"Associated Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationDecoder\/SerializationRequirement"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationDecoder\/decodeErrorType()","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationDecoder\/decodeGenericSubstitutions()","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationDecoder\/decodeNextArgument()","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationDecoder\/decodeReturnType()"]}],"seeAlsoSections":[{"anchor":"Remote-C