{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Distributed","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationDecoder"]]},"abstract":[{"type":"text","text":"Attempt to decode the next argument from the underlying buffers into pre-allocated storage"},{"text":" ","type":"text"},{"type":"text","text":"pointed at by ‘pointer’."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationDecoder\/decodeNextArgument()","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/distributed\/distributedtargetinvocationdecoder\/decodenextargument()"]}],"metadata":{"roleHeading":"Instance Method","platforms":[{"introducedAt":"16.0","deprecated":false,"beta":false,"name":"iOS","unavailable":false},{"introducedAt":"16.0","deprecated":false,"beta":false,"name":"iPadOS","unavailable":false},{"introducedAt":"16.0","deprecated":false,"beta":false,"name":"Mac Catalyst","unavailable":false},{"introducedAt":"13.0","deprecated":false,"beta":false,"name":"macOS","unavailable":false},{"introducedAt":"16.0","deprecated":false,"beta":false,"name":"tvOS","unavailable":false},{"introducedAt":"9.0","name":"watchOS","deprecated":false,"unavailable":false,"beta":false}],"modules":[{"name":"Distributed"}],"symbolKind":"method","required":true,"externalID":"s:11Distributed0A23TargetInvocationDecoderP18decodeNextArgumentqd__yKlF","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"decodeNextArgument"},{"text":"<","kind":"text"},{"text":"Argument","kind":"genericParameter"},{"text":">() ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Argument","kind":"typeIdentifier","preciseIdentifier":"s:11Distributed0A23TargetInvocationDecoderP18decodeNextArgumentqd__yKlF0G0L_qd__mfp"}],"title":"decodeNextArgument()","role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"decodeNextArgument"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Argument"},{"kind":"text","text":">() "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Argument","preciseIdentifier":"s:11Distributed0A23TargetInvocationDecoderP18decodeNextArgumentqd__yKlF0G0L_qd__mfp"}],"languages":["swift"]}]},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"This method should throw if it has no more arguments available, if decoding the argument failed,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"or, optionally, if the argument type we’re trying to decode does not match the stored type."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The result of the decoding operation must be stored into the provided ‘pointer’ rather than"},{"type":"text","text":" "},{"type":"text","text":"returning a value. This pattern allows the runtime to use a heavily optimized, pre-allocated"},{"type":"text","text":" "},{"type":"text","text":"buffer for all the arguments and their expected types. The ‘pointer’ passed here is a pointer"},{"type":"text","text":" "},{"type":"text","text":"to a “slot” in that pre-allocated buffer. That buffer will then be passed to a thunk that"},{"type":"text","text":" "},{"type":"text","text":"performs the actual distributed (local) instance method invocation."}]},{"level":3,"anchor":"Serialization-Requirement","type":"heading","text":"Serialization Requirement"},{"type":"paragraph","inlineContent":[{"text":"Implementations of this method must ensure that the ","type":"text"},{"code":"Argument","type":"codeVoice"},{