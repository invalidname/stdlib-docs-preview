{"relationshipsSections":[{"title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/LocalTestingInvocationEncoder"],"type":"conformingTypes"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DistributedTargetInvocationEncoder","kind":"identifier"},{"text":"<","kind":"text"},{"text":"SerializationRequirement","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/SerializationRequirement","preciseIdentifier":"s:11Distributed0A23TargetInvocationEncoderP24SerializationRequirementQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"Forming-an-invocation","text":"Forming an invocation"},{"type":"paragraph","inlineContent":[{"text":"On the sending-side an instance of an invocation is constructed by the runtime,","type":"text"},{"text":" ","type":"text"},{"text":"and calls to: ","type":"text"},{"code":"recordGenericSubstitution","type":"codeVoice"},{"text":", ","type":"text"},{"code":"recordArgument","type":"codeVoice"},{"text":", ","type":"text"},{"code":"recordReturnType","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"recordErrorType","type":"codeVoice"},{"text":", and finally ","type":"text"},{"code":"doneRecording","type":"codeVoice"},{"text":" are made (in this order).","type":"text"}]},{"inlineContent":[{"type":"text","text":"If the return type of the target is "},{"type":"codeVoice","code":"Void"},{"text":" the ","type":"text"},{"type":"codeVoice","code":"recordReturnType"},{"text":" is not invoked.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the error type thrown by the target is not defined the "},{"type":"codeVoice","code":"recordErrorType"},{"type":"text","text":" is not invoked."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An invocation implementation may decide to perform serialization right-away in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"record..."},{"type":"text","text":" invocations, or it may choose to delay doing so until the invocation is passed"},{"type":"text","text":" "},{"type":"text","text":"to the "},{"type":"codeVoice","code":"remoteCall"},{"type":"text","text":". This decision largely depends on if serialization is allowed to happen"},{"type":"text","text":" "},{"type":"text","text":"on the caller’s task, and if any smarter encoding can be used once all parameter calls have been"},{"type":"text","text":" "},{"type":"text","text":"recorded (e.g. it may be possible to run-length encode values of certain types etc.)"}],"type":"paragraph"},{"inlineContent":[{"text":"Once encoded, the system should use some underlying transport mechanism to send the","type":"text"},{"text":" ","type":"text"},{"text":"bytes serialized by the invocation to the remote peer.","type":"text"}],"type":"paragraph"},{"text":"Decoding an invocation","anchor":"Decoding-an-invocation","level":2,"type":"heading"},{"inlineContent":[{"text":"Since every actor system is going to deal with a concrete invocation type, they may","type":"text"},{"type":"text","text":" "},{"type":"text","text":"implement decoding them whichever way is most optimal for the given system."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Once decided, the invocation must be passed to ","type":"text"},{"code":"executeDistributedTarget","type":"codeVoice"},{"text":" ","type":"text"},{"text":"which will decode the substitutions, argument values, return and error types (in that order).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note that the decoding will be provided the specific types that the sending side used to preform the call,","type":"text"},{"text":" ","type":"text"},{"text":"so decoding can rely on simply invoking e.g. ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" (if that is the ","type":"text"},{"code":"SerializationRequirement","type":"codeVoice"},{"text":") decoding","type":"text"},{"text":" ","type":"text"},{"text":"entry points on the provided types.","type":"text"}]}],"kind":"content"}],"abstract":[{"text":"Used to encode an invocation of a distributed target (method or computed property).","type":"text"}],"topicSections":[{"generated":true,"title":"Associated Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/SerializationRequirement"],"anchor":"Associated-Types"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/doneRecording()","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/recordArgument(_:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/recordErrorType(_:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/recordGenericSubstitution(_:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/recordReturnType(_:)"],"anchor":"Instance-Methods"}],"metadata":{"navigatorTitle":[{"text":"DistributedTargetInvocationEncoder","kind":"identifier"}],"role":"symbol","title":"DistributedTargetInvocationEncoder","symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DistributedTargetInvocationEncoder","kind":"identifier"}],"platforms":[{"beta":false,"introducedAt":"16.0","name":"iOS","deprecated":false,"unavailable":false},{"beta":false,"introducedAt":"16.0","name":"iPadOS","deprecated":false,"unavailable":false},{"beta":false,"introducedAt":"16.0","name":"Mac Catalyst","deprecated":false,"unavailable":false},{"beta":false,"introducedAt":"13.0","name":"macOS","deprecated":false,"una