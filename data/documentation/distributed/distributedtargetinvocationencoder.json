{"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/LocalTestingInvocationEncoder"],"title":"Conforming Types","type":"conformingTypes","kind":"relationships"}],"metadata":{"externalID":"s:11Distributed0A23TargetInvocationEncoderP","navigatorTitle":[{"kind":"identifier","text":"DistributedTargetInvocationEncoder"}],"title":"DistributedTargetInvocationEncoder","platforms":[{"name":"iOS","beta":false,"unavailable":false,"deprecated":false,"introducedAt":"16.0"},{"name":"iPadOS","beta":false,"unavailable":false,"deprecated":false,"introducedAt":"16.0"},{"name":"Mac Catalyst","beta":false,"unavailable":false,"deprecated":false,"introducedAt":"16.0"},{"name":"macOS","beta":false,"unavailable":false,"deprecated":false,"introducedAt":"13.0"},{"name":"tvOS","beta":false,"unavailable":false,"deprecated":false,"introducedAt":"16.0"},{"name":"watchOS","beta":false,"unavailable":false,"deprecated":false,"introducedAt":"9.0"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DistributedTargetInvocationEncoder"}],"modules":[{"name":"Distributed"}],"symbolKind":"protocol","roleHeading":"Protocol","role":"symbol"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Distributed"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DistributedTargetInvocationEncoder","kind":"identifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/SerializationRequirement","preciseIdentifier":"s:11Distributed0A23TargetInvocationEncoderP24SerializationRequirementQa","text":"SerializationRequirement","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Forming an invocation","anchor":"Forming-an-invocation"},{"inlineContent":[{"text":"On the sending-side an instance of an invocation is constructed by the runtime,","type":"text"},{"text":" ","type":"text"},{"text":"and calls to: ","type":"text"},{"code":"recordGenericSubstitution","type":"codeVoice"},{"text":", ","type":"text"},{"code":"recordArgument","type":"codeVoice"},{"text":", ","type":"text"},{"code":"recordReturnType","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"recordErrorType","type":"codeVoice"},{"text":", and finally ","type":"text"},{"code":"doneRecording","type":"codeVoice"},{"text":" are made (in this order).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the return type of the target is ","type":"text"},{"code":"Void","type":"codeVoice"},{"text":" the ","type":"text"},{"code":"recordReturnType","type":"codeVoice"},{"text":" is not invoked.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the error type thrown by the target is not defined the ","type":"text"},{"code":"recordErrorType","type":"codeVoice"},{"text":" is not invoked.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An invocation implementation may decide to perform serialization right-away in the","type":"text"},{"text":" ","type":"text"},{"code":"record...","type":"codeVoice"},{"text":" invocations, or it may choose to delay doing so until the invocation is passed","type":"text"},{"text":" ","type":"text"},{"text":"to the ","type":"text"},{"code":"remoteCall","type":"codeVoice"},{"text":". This decision largely depends on if serialization is allowed to happen","type":"text"},{"text":" ","type":"text"},{"text":"on the caller’s task, and if any smarter encoding can be used once all parameter calls have been","type":"text"},{"text":" ","type":"text"},{"text":"recorded (e.g. it may be possible to run-length encode values of certain types etc.)","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Once encoded, the system should use some underlying transport mechanism to send the","type":"text"},{"text":" ","type":"text"},{"text":"bytes serialized by the invocation to the remote peer.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Decoding an invocation","anchor":"Decoding-an-invocation"},{"inlineContent":[{"text":"Since every actor system is going to deal with a concrete invocation type, they may","type":"text"},{"text":" ","type":"text"},{"text":"implement decoding them whichever way is most optimal for the given system.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Once decided, the invocation must be passed to ","type":"text"},{"code":"executeDistributedTarget","type":"codeVoice"},{"text":" ","type":"text"},{"text":"which will decode the substitutions, argument values, return and error types (in that order).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Note that the decoding will be provided the specific types that the sending side used to preform the call,","type":"text"},{"text":" ","type":"text"},{"text":"so decoding can rely on simply invoking e.g. ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" (if that is the ","type":"text"},{"code":"SerializationRequirement","type":"codeVoice"},{"text":") decoding","type":"text"},{"text":" ","type":"text"},{"text":"entry points on the provided types.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/distributed\/distributedtargetinvocationencoder"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Used to encode an invocation of a distributed target (method or computed property)."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder"},"topicSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/Se