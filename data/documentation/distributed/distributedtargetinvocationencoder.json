{"sections":[],"topicSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/SerializationRequirement"],"generated":true,"title":"Associated Types","anchor":"Associated-Types"},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/doneRecording()","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/recordArgument(_:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/recordErrorType(_:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/recordGenericSubstitution(_:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/recordReturnType(_:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"}],"abstract":[{"text":"Used to encode an invocation of a distributed target (method or computed property).","type":"text"}],"relationshipsSections":[{"type":"conformingTypes","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/LocalTestingInvocationEncoder"],"kind":"relationships","title":"Conforming Types"}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/RemoteCallTarget","doc:\/\/com.apple.Swift\/documentation\/Distributed\/RemoteCallArgument","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationDecoder","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationResultHandler"],"generated":true,"title":"Remote Calls","anchor":"Remote-Calls"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DistributedTargetInvocationEncoder"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:11Distributed0A23TargetInvocationEncoderP24SerializationRequirementQa","kind":"typeIdentifier","text":"SerializationRequirement","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/SerializationRequirement"},{"kind":"text","text":">"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Forming an invocation","anchor":"Forming-an-invocation","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"On the sending-side an instance of an invocation is constructed by the runtime,"},{"type":"text","text":" "},{"type":"text","text":"and calls to: "},{"type":"codeVoice","code":"recordGenericSubstitution"},{"type":"text","text":", "},{"type":"codeVoice","code":"recordArgument"},{"type":"text","text":", "},{"type":"codeVoice","code":"recordReturnType"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"recordErrorType"},{"type":"text","text":", and finally "},{"type":"codeVoice","code":"doneRecording"},{"type":"text","text":" are made (in this order)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the return type of the target is "},{"type":"codeVoice","code":"Void"},{"type":"text","text":" the "},{"type":"codeVoice","code":"recordReturnType"},{"type":"text","text":" is not invoked."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the error type thrown by the target is not defined the "},{"type":"codeVoice","code":"recordErrorType"},{"type":"text","text":" is not invoked."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An invocation implementation may decide to perform serialization right-away in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"record..."},{"type":"text","text":" invocations, or it may choose to delay doing so until the invocation is passed"},{"type":"text","text":" "},{"type":"text","text":"to the "},{"type":"codeVoice","code":"remoteCall"},{"type":"text","text":". This decision largely depends on if serialization is allowed to happen"},{"type":"text","text":" "},{"type":"text","text":"on the caller’s task, and if any smarter encoding can be used once all parameter calls have been"},{"type":"text","text":" "},{"type":"text","text":"recorded (e.g. it may be possible to run-length encode values of certain types etc.)"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once encoded, the system should use some underlying transport mechanism to send the"},{"type":"text","text":" "},{"type":"text","text":"bytes serialized by the invocation to the remote peer."}]},{"anchor":"Decoding-an-invocation","level":2,"type":"heading","text":"Decoding an invocation"},{"inlineContent":[{"type":"text","text":"Since every actor system is going to deal with a concrete invocation type, they may"},{"type":"text","text":" "},{"type":"text","text":"implement decoding them whichever way is most optimal for the given system."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Once decided, the invocation must be passed to "},{"type":"codeVoice","code":"executeDistributedTarget"},{"type":"text","text":" "},{"type":"text","text":"which will decode the substitutions, argument values, return and error types (in that order)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note that the decoding will be provided the specific types that the sending side used to preform the call,"},{"type":"text","text":" "},{"text":"so decoding can rely on simply invoking e.g. ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" (if that is the ","type":"text"},{"code":"SerializationRequirement","type":"codeVoice"},{"text":") decoding","type":"text"},{"text":" ","type":"text"},{"text":"entry points on the provided types.","type":"text"}],"type":"paragraph"}]}],"metadata":{"role":"symbol","platforms":[{"beta":false,"name":"iOS","deprecated":false,"introducedAt":"16.0","unavailable":false},{"beta":false,"name":"iPadOS","deprecated":false,"introducedAt":"16.0","unavailable":false},{"beta":false,"name":"