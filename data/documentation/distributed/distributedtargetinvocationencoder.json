{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Distributed"]]},"abstract":[{"type":"text","text":"Used to encode an invocation of a distributed target (method or computed property)."}],"topicSections":[{"title":"Associated Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/SerializationRequirement"],"generated":true,"anchor":"Associated-Types"},{"title":"Instance Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/doneRecording()","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/recordArgument(_:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/recordErrorType(_:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/recordGenericSubstitution(_:)","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/recordReturnType(_:)"],"generated":true,"anchor":"Instance-Methods"}],"kind":"symbol","relationshipsSections":[{"title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/LocalTestingInvocationEncoder"],"type":"conformingTypes"}],"seeAlsoSections":[{"title":"Remote Calls","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/RemoteCallTarget","doc:\/\/com.apple.Swift\/documentation\/Distributed\/RemoteCallArgument","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationDecoder","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationResultHandler"],"generated":true,"anchor":"Remote-Calls"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DistributedTargetInvocationEncoder","kind":"identifier"},{"text":"<","kind":"text"},{"text":"SerializationRequirement","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/SerializationRequirement","preciseIdentifier":"s:11Distributed0A23TargetInvocationEncoderP24SerializationRequirementQa"},{"text":">","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"Forming-an-invocation","type":"heading","level":2,"text":"Forming an invocation"},{"type":"paragraph","inlineContent":[{"text":"On the sending-side an instance of an invocation is constructed by the runtime,","type":"text"},{"text":" ","type":"text"},{"text":"and calls to: ","type":"text"},{"code":"recordGenericSubstitution","type":"codeVoice"},{"text":", ","type":"text"},{"code":"recordArgument","type":"codeVoice"},{"text":", ","type":"text"},{"code":"recordReturnType","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"recordErrorType","type":"codeVoice"},{"text":", and finally ","type":"text"},{"code":"doneRecording","type":"codeVoice"},{"text":" are made (in this order).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the return type of the target is ","type":"text"},{"code":"Void","type":"codeVoice"},{"text":" the ","type":"text"},{"code":"recordReturnType","type":"codeVoice"},{"text":" is not invoked.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the error type thrown by the target is not defined the ","type":"text"},{"code":"recordErrorType","type":"codeVoice"},{"text":" is not invoked.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An invocation implementation may decide to perform serialization right-away in the","type":"text"},{"text":" ","type":"text"},{"code":"record...","type":"codeVoice"},{"text":" invocations, or it may choose to delay doing so until the invocation is passed","type":"text"},{"text":" ","type":"text"},{"text":"to the ","type":"text"},{"code":"remoteCall","type":"codeVoice"},{"text":". This decision largely depends on if serialization is allowed to happen","type":"text"},{"text":" ","type":"text"},{"text":"on the caller’s task, and if any smarter encoding can be used once all parameter calls have been","type":"text"},{"text":" ","type":"text"},{"text":"recorded (e.g. it may be possible to run-length encode values of certain types etc.)","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Once encoded, the system should use some underlying transport mechanism to send the","type":"text"},{"text":" ","type":"text"},{"text":"bytes serialized by the invocation to the remote peer.","type":"text"}]},{"anchor":"Decoding-an-invocation","type":"heading","level":2,"text":"Decoding an invocation"},{"type":"paragraph","inlineContent":[{"text":"Since every actor system is going to deal with a concrete invocation type, they may","type":"text"},{"text":" ","type":"text"},{"text":"implement decoding them whichever way is most optimal for the given system.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Once decided, the invocation must be passed to ","type":"text"},{"code":"executeDistributedTarget","type":"codeVoice"},{"text":" ","type":"text"},{"text":"which will decode the substitutions, argument values, return and error types (in that order).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note that the decoding will be provided the specific types that the sending side used to preform the call,","type":"text"},{"text":" ","type":"text"},{"text":"so decoding can rely on simply invoking e.g. ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" (if that is the ","type":"text"},{"code":"SerializationRequirement","type":"codeVoice"},{"text":") decoding","type":"text"},{"text":" ","type":"text"},{"text":"entry points on the provided types.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/distributed\/distributedtargetinvocationencoder"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"roleHeading":"Protocol","navigatorTitle":[{"kind":"identifier","text":"DistributedTargetInvocationEncoder"}],"externalID":"s:11Distributed0A23TargetInvocationEncoderP","symbolKind":"protocol","title":"DistributedTargetInvocationEncoder","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DistributedTargetInvocationEncoder"}],"role":"symbol","modules":[{"name":"Distributed"}],"platforms":[{"unavailable":false,"name":"iOS","introducedAt":"16.0","deprecated":false,"beta":false},{"unavailable":false,"name":"iPadOS","introducedAt":"16.0","deprecated":false,"beta":false},{"unavailable":false,"name":"Mac Catalyst","introducedAt":"16.0","deprecated":false,"beta":false},{"unavailable":false,"name":"macOS","introducedAt":"13.0","deprecated":false,"beta":false},{"unavailable":false,"name":"tvOS","introducedAt":"16.0","deprecated":false,"beta":false},{"unavailable":false,"name":"watchOS","introducedAt":"9.0","deprecated":false,"beta":false}]},"references":{"doc://com.apple.Swift/documentation/Distributed/DistributedTargetInvocationEncoder/recordReturnType(_:)":{"abstract":[{"type":"text","text":"Record the return type of the distributed method."},{"type":"text","text":" "},{"type":"text","text":"This method will not be invoked if the target is returning "},{"type":"codeVoice","code":"Void"},{"type":"text","text":"."}],"required":true,"url":"\/documentation\/distributed\/distributedtargetinvocationencoder\/recordreturntype(_:)","kind":"symbol","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedTargetInvocationEncoder\/recordReturnType(_:)","title":"recordReturnType(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"recordReturnType"},{"kind":"text"