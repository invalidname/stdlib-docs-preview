{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"navigatorTitle":[{"text":"Reference","kind":"identifier"}],"externalID":"s:12RegexBuilder9ReferenceV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Reference","kind":"identifier"}],"roleHeading":"Structure","role":"symbol","title":"Reference","symbolKind":"struct","modules":[{"name":"RegexBuilder"}],"platforms":[{"beta":false,"deprecated":false,"name":"iOS","introducedAt":"16.0","unavailable":false},{"introducedAt":"16.0","deprecated":false,"unavailable":false,"beta":false,"name":"iPadOS"},{"name":"Mac Catalyst","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"16.0"},{"name":"macOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"13.0"},{"name":"tvOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"16.0"},{"name":"watchOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"9.0"}]},"seeAlsoSections":[{"generated":true,"title":"Captures","identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Capture","doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/TryCapture"],"anchor":"Captures"}],"variants":[{"paths":["\/documentation\/regexbuilder\/reference"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/init(_:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/regex"]}],"abstract":[{"type":"text","text":"A reference to a captured portion of a regular expression."}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexComponent"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Reference"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Capture"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"You can use a ","type":"text"},{"type":"codeVoice","code":"Reference"},{"text":" to access a regular expression, both during","type":"text"},{"text":" ","type":"text"},{"text":"the matching process and after a capture has been successful.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In this example, the ","type":"text"},{"code":"kind","type":"codeVoice"},{"text":" reference captures either ","type":"text"},{"code":"\"CREDIT\"","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"code":"\"DEBIT\"","type":"codeVoice"},{"type":"text","text":" at the beginning of a line. Later in the regular expression, the"},{"type":"text","text":" "},{"type":"text","text":"presence of "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" matches the same substring that was captured previously"},{"text":" ","type":"text"},{"text":"at the end of the line.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let kindRef = Reference(Substring.self)","let kindRegex = ChoiceOf {","    \"CREDIT\"","    \"DEBIT\"","}","","let transactionRegex = Regex {","    Anchor.startOfLine","    Capture(kindRegex, as: kindRef)","    OneOrMore(.anyNonNewline)","    kindRef","    Anchor.endOfLine","}","","let validTransaction = \"CREDIT     109912311421    Payroll   $69.73  CREDIT\"","let invalidTransaction = \"DEBIT     00522142123    Expense   $5.17  CREDIT\"","","print(validTransaction.contains(transactionRegex))","\/\/ Prints \"true\"","print(invalidTransaction.contains(transactionRegex))","\/\/ Prints \"false\""]},{"inlineContent":[{"type":"text","text":"Any reference that is used for matching must be captured elsewhere in the"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Regex"},{"text":" block. You can use a reference for matching before it is captured;","type":"text"},{"text":" ","type":"text"},{"text":"in that case, the reference will not match until it has previously been","type":"text"},{"type":"text","text":" "},{"text":"captured.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To access the captured “transaction kind”, you can use the "},{"code":"kind","type":"codeVoice"},{"text":" reference","type":"text"},{"text":" ","type":"text"},{"text":"to subscript a ","type":"text"},{"type":"codeVoice","code":"Regex.Match"},{"text":" instance:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if let match = validTransaction.firstMatch(of: transactionRegex) {","    print(match[kindRef])","}","\/\/ Prints \"CREDIT\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use a "},{"code":"Reference","type":"codeVoice"},{"type":"text","text":" to capture a transformed value, include a "},{"type":"codeVoice","code":"transform"},{"text":" ","type":"text"},{"type":"text","text":"closure when capturing."}]},{"syntax":"swift","code":["struct Transaction {","    var id: UInt64","}","let transactionRef = Reference(Transaction.self)","","let transactionIDRegex = Regex {","    Capture(kindRegex, as: kindRef)","    OneOrMore(.whitespace)","    TryCapture(as: transactionRef) {","        OneOrMore(.digit)","    } transform: { str in","        UInt64(str).map(Transaction.init(id:))","    }","    OneOrMore(.anyNonNewline)","    kindRef","    Anchor.endOfLine","}","","if let match = validTransaction.firstMatch(of: transactionIDRegex) {","    print(match[transactionRef])","}","\/\/ Prints \"Transaction(id: 109912311421)\""],"type":"codeListing"}]}]