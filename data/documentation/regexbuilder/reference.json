{"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/init(_:)"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/regex"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder"]]},"sections":[],"seeAlsoSections":[{"anchor":"Captures","generated":true,"title":"Captures","identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Capture","doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/TryCapture"]}],"metadata":{"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Reference","kind":"identifier"}],"externalID":"s:12RegexBuilder9ReferenceV","platforms":[{"name":"iOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"16.0"},{"name":"iPadOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"16.0"},{"name":"Mac Catalyst","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"16.0"},{"name":"macOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"13.0"},{"name":"tvOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"16.0"},{"name":"watchOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"9.0"}],"symbolKind":"struct","title":"Reference","role":"symbol","modules":[{"name":"RegexBuilder"}],"navigatorTitle":[{"text":"Reference","kind":"identifier"}]},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexComponent"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Reference","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Capture","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["macOS"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use a "},{"type":"codeVoice","code":"Reference"},{"type":"text","text":" to access a regular expression, both during"},{"type":"text","text":" "},{"type":"text","text":"the matching process and after a capture has been successful."}]},{"inlineContent":[{"type":"text","text":"In this example, the "},{"code":"kind","type":"codeVoice"},{"type":"text","text":" reference captures either "},{"code":"\"CREDIT\"","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"DEBIT\""},{"type":"text","text":" at the beginning of a line. Later in the regular expression, the"},{"type":"text","text":" "},{"type":"text","text":"presence of "},{"code":"kind","type":"codeVoice"},{"type":"text","text":" matches the same substring that was captured previously"},{"type":"text","text":" "},{"type":"text","text":"at the end of the line."}],"type":"paragraph"},{"type":"codeListing","code":["let kindRef = Reference(Substring.self)","let kindRegex = ChoiceOf {","    \"CREDIT\"","    \"DEBIT\"","}","","let transactionRegex = Regex {","    Anchor.startOfLine","    Capture(kindRegex, as: kindRef)","    OneOrMore(.anyNonNewline)","    kindRef","    Anchor.endOfLine","}","","let validTransaction = \"CREDIT     109912311421    Payroll   $69.73  CREDIT\"","let invalidTransaction = \"DEBIT     00522142123    Expense   $5.17  CREDIT\"","","print(validTransaction.contains(transactionRegex))","\/\/ Prints \"true\"","print(invalidTransaction.contains(transactionRegex))","\/\/ Prints \"false\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Any reference that is used for matching must be captured elsewhere in the"},{"type":"text","text":" "},{"code":"Regex","type":"codeVoice"},{"type":"text","text":" block. You can use a reference for matching before it is captured;"},{"type":"text","text":" "},{"type":"text","text":"in that case, the reference will not match until it has previously been"},{"type":"text","text":" "},{"type":"text","text":"captured."}],"type":"paragraph"},{"inlineContent":[{"text":"To access the captured “transaction kind”, you can use the ","type":"text"},{"code":"kind","type":"codeVoice"},{"type":"text","text":" reference"},{"type":"text","text":" "},{"type":"text","text":"to subscript a "},{"code":"Regex.Match","type":"codeVoice"},{"type":"text","text":" instance:"}],"type":"paragraph"},{"code":["if let match = validTransaction.firstMatch(of: transactionRegex) {","    print(match[kindRef])","}","\/\/ Prints \"CREDIT\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"To use a "},{"code":"Reference","type":"codeVoice"},{"type":"text","text":" to capture a transformed value, include a "},{"code":"transform","type":"codeVoice"},{"type":"text","text":" "},{"text":"closure when capturing.","type":"text"}],"type":"paragraph"},{"code":["struct Transaction {","    var id: UInt64","}","let transactionRef = Reference(Transaction.self)","","let transactionIDRegex = Regex {","    Capture(kindRegex, as: kindRef)","    OneOrMore(.whitespace)","    TryCapture(as: transactionRef) {","        OneOrMore(.digit)","    } transform: { str in","        UInt64(str).map(Transaction.init(id:))","    }","    OneOrMore(.anyNonNewline)","    kindRef","    Anchor.endOfLine","}","","if let match = validTransaction.firstMatch(of: transactionIDRegex) {","    print(match[transactionRef])","}","\/\/ Prints \"Transaction(id: 109912311421)\""],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"kind":"symbol","variants":[{"paths":["\/documentation\/regexbuilder\/reference"],"traits":[{"interfaceLan