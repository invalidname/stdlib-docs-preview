{"seeAlsoSections":[{"anchor":"Captures","identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Capture","doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/TryCapture"],"generated":true,"title":"Captures"}],"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Reference"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Capture"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use a "},{"type":"codeVoice","code":"Reference"},{"type":"text","text":" to access a regular expression, both during"},{"type":"text","text":" "},{"type":"text","text":"the matching process and after a capture has been successful."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this example, the "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" reference captures either "},{"type":"codeVoice","code":"\"CREDIT\""},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"DEBIT\""},{"type":"text","text":" at the beginning of a line. Later in the regular expression, the"},{"type":"text","text":" "},{"type":"text","text":"presence of "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" matches the same substring that was captured previously"},{"type":"text","text":" "},{"type":"text","text":"at the end of the line."}]},{"code":["let kindRef = Reference(Substring.self)","let kindRegex = ChoiceOf {","    \"CREDIT\"","    \"DEBIT\"","}","","let transactionRegex = Regex {","    Anchor.startOfLine","    Capture(kindRegex, as: kindRef)","    OneOrMore(.anyNonNewline)","    kindRef","    Anchor.endOfLine","}","","let validTransaction = \"CREDIT     109912311421    Payroll   $69.73  CREDIT\"","let invalidTransaction = \"DEBIT     00522142123    Expense   $5.17  CREDIT\"","","print(validTransaction.contains(transactionRegex))","\/\/ Prints \"true\"","print(invalidTransaction.contains(transactionRegex))","\/\/ Prints \"false\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any reference that is used for matching must be captured elsewhere in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Regex"},{"type":"text","text":" block. You can use a reference for matching before it is captured;"},{"type":"text","text":" "},{"type":"text","text":"in that case, the reference will not match until it has previously been"},{"type":"text","text":" "},{"type":"text","text":"captured."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To access the captured “transaction kind”, you can use the "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" reference"},{"type":"text","text":" "},{"type":"text","text":"to subscript a "},{"type":"codeVoice","code":"Regex.Match"},{"type":"text","text":" instance:"}]},{"code":["if let match = validTransaction.firstMatch(of: transactionRegex) {","    print(match[kindRef])","}","\/\/ Prints \"CREDIT\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use a "},{"type":"codeVoice","code":"Reference"},{"type":"text","text":" to capture a transformed value, include a "},{"type":"codeVoice","code":"transform"},{"type":"text","text":" "},{"type":"text","text":"closure when capturing."}]},{"code":["struct Transaction {","    var id: UInt64","}","let transactionRef = Reference(Transaction.self)","","let transactionIDRegex = Regex {","    Capture(kindRegex, as: kindRef)","    OneOrMore(.whitespace)","    TryCapture(as: transactionRef) {","        OneOrMore(.digit)","    } transform: { str in","        UInt64(str).map(Transaction.init(id:))","    }","    OneOrMore(.anyNonNewline)","    kindRef","    Anchor.endOfLine","}","","if let match = validTransaction.firstMatch(of: transactionIDRegex) {","    print(match[transactionRef])","}","\/\/ Prints \"Transaction(id: 109912311421)\""],"type":"codeListing","syntax":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder"]]},"metadata":{"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"Reference"}],"externalID":"s:12RegexBuilder9ReferenceV","platforms":[{"name":"iOS","introducedAt":"16.0","deprecated":false,"beta":false,"unavailable":false},{"name":"iPadOS","introducedAt":"16.0","deprecated":false,"beta":false,"unavailable":false},{"name":"Mac Catalyst","introducedAt":"16.0","deprecated":false,"beta":false,"unavailable":false},{"unavailable":false,"introducedAt":"13.0","beta":false,"deprecated":false,"name":"macOS"},{"deprecated":false,"name":"tvOS","unavailable":false,"introducedAt":"16.0","beta":false},{"unavailable":false,"introducedAt":"9.0","beta":false,"deprecated":false,"name":"watchOS"}],"symbolKind":"struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Reference"}],"modules":[{"name":"RegexBuilder"}],"title":"Reference"},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/init(_:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/regex"],"anchor":"Instance-Properties"}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexComponent"],"kind":"relationships","title":"Conforms To"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/regexbuilder\/reference"]}],"abstract":[{"type":"text","text":"A reference to a captured portion of a regular expression."}]