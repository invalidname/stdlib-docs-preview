ilder\/Reference\/init(_:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:12RegexBuilder9ReferenceV7Capturexmfp","text":"Capture"},{"kind":"text","text":".Type)"}],"title":"init(_:)","url":"\/documentation\/regexbuilder\/reference\/init(_:)","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Creates a reference with the specified capture type."}]},"doc://com.apple.Swift/documentation/RegexBuilder":{"role":"collection","title":"RegexBuilder","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder","abstract":[],"url":"\/documentation\/regexbuilder","type":"topic"},"doc://com.apple.Swift/documentation/RegexBuilder/TryCapture":{"type":"topic","url":"\/documentation\/regexbuilder\/trycapture","title":"TryCapture","kind":"symbol","abstract":[{"type":"text","text":"A regex component that attempts to transform a matched substring, saving"},{"type":"text","text":" "},{"type":"text","text":"the result if successful and backtracking if the transformation fails."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TryCapture"}],"navigatorTitle":[{"kind":"identifier","text":"TryCapture"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/TryCapture"},"doc://com.apple.Swift/documentation/RegexBuilder/Capture":{"abstract":[{"type":"text","text":"A regex component that saves the matched substring, or a transformed result,"},{"type":"text","text":" "},{"type":"text","text":"for access in a regex match."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Capture"}],"url":"\/documentation\/regexbuilder\/capture","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Capture"}],"title":"Capture","identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Capture"}}