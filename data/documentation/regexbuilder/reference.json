{"seeAlsoSections":[{"anchor":"Captures","identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Capture","doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/TryCapture"],"generated":true,"title":"Captures"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/regexbuilder\/reference"]}],"abstract":[{"type":"text","text":"A reference to a captured portion of a regular expression."}],"metadata":{"externalID":"s:12RegexBuilder9ReferenceV","title":"Reference","role":"symbol","platforms":[{"name":"iOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"16.0"},{"name":"iPadOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"16.0"},{"name":"Mac Catalyst","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"16.0"},{"name":"macOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"13.0"},{"name":"tvOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"16.0"},{"name":"watchOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"9.0"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Reference"}],"modules":[{"name":"RegexBuilder"}],"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"Reference"}],"symbolKind":"struct"},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Reference","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Capture","kind":"genericParameter"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"You can use a "},{"code":"Reference","type":"codeVoice"},{"type":"text","text":" to access a regular expression, both during"},{"type":"text","text":" "},{"type":"text","text":"the matching process and after a capture has been successful."}],"type":"paragraph"},{"inlineContent":[{"text":"In this example, the ","type":"text"},{"code":"kind","type":"codeVoice"},{"text":" reference captures either ","type":"text"},{"code":"\"CREDIT\"","type":"codeVoice"},{"type":"text","text":" or"},{"text":" ","type":"text"},{"code":"\"DEBIT\"","type":"codeVoice"},{"text":" at the beginning of a line. Later in the regular expression, the","type":"text"},{"text":" ","type":"text"},{"text":"presence of ","type":"text"},{"code":"kind","type":"codeVoice"},{"type":"text","text":" matches the same substring that was captured previously"},{"type":"text","text":" "},{"type":"text","text":"at the end of the line."}],"type":"paragraph"},{"code":["let kindRef = Reference(Substring.self)","let kindRegex = ChoiceOf {","    \"CREDIT\"","    \"DEBIT\"","}","","let transactionRegex = Regex {","    Anchor.startOfLine","    Capture(kindRegex, as: kindRef)","    OneOrMore(.anyNonNewline)","    kindRef","    Anchor.endOfLine","}","","let validTransaction = \"CREDIT     109912311421    Payroll   $69.73  CREDIT\"","let invalidTransaction = \"DEBIT     00522142123    Expense   $5.17  CREDIT\"","","print(validTransaction.contains(transactionRegex))","\/\/ Prints \"true\"","print(invalidTransaction.contains(transactionRegex))","\/\/ Prints \"false\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Any reference that is used for matching must be captured elsewhere in the","type":"text"},{"text":" ","type":"text"},{"code":"Regex","type":"codeVoice"},{"text":" block. You can use a reference for matching before it is captured;","type":"text"},{"text":" ","type":"text"},{"text":"in that case, the reference will not match until it has previously been","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"captured."}]},{"inlineContent":[{"type":"text","text":"To access the captured “transaction kind”, you can use the "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" reference"},{"type":"text","text":" "},{"type":"text","text":"to subscript a "},{"code":"Regex.Match","type":"codeVoice"},{"type":"text","text":" instance:"}],"type":"paragraph"},{"code":["if let match = validTransaction.firstMatch(of: transactionRegex) {","    print(match[kindRef])","}","\/\/ Prints \"CREDIT\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use a "},{"code":"Reference","type":"codeVoice"},{"text":" to capture a transformed value, include a ","type":"text"},{"code":"transform","type":"codeVoice"},{"type":"text","text":" "},{"text":"closure when capturing.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct Transaction {","    var id: UInt64","}","let transactionRef = Reference(Transaction.self)","","let transactionIDRegex = Regex {","    Capture(kindRegex, as: kindRef)","    OneOrMore(.whitespace)","    TryCapture(as: transactionRef) {","        OneOrMore(.digit)","    } transform: { str in","        UInt64(str).map(Transaction.init(id:))","    }","    OneOrMore(.anyNonNewline)","    kindRef","    Anchor.endOfLine","}","","if let match = validTransaction.firstMatch(of: transactionIDRegex) {","    print(match[transactionRef])","}","\/\/ Prints \"Transaction(id: 109912311421)\""]}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder"]]},"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/init(_:)"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/regex"],"generated":true,"title":"Instance Properties"}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexComponent"],"kind":"relationships","title":"Conforms To"}],"identifier":