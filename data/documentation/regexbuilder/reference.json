{"metadata":{"platforms":[{"unavailable":false,"name":"iOS","deprecated":false,"introducedAt":"16.0","beta":false},{"unavailable":false,"name":"iPadOS","deprecated":false,"introducedAt":"16.0","beta":false},{"unavailable":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"16.0","beta":false},{"unavailable":false,"name":"macOS","deprecated":false,"introducedAt":"13.0","beta":false},{"unavailable":false,"name":"tvOS","deprecated":false,"introducedAt":"16.0","beta":false},{"unavailable":false,"name":"watchOS","deprecated":false,"introducedAt":"9.0","beta":false}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Reference"}],"roleHeading":"Structure","title":"Reference","externalID":"s:12RegexBuilder9ReferenceV","navigatorTitle":[{"kind":"identifier","text":"Reference"}],"role":"symbol","symbolKind":"struct","modules":[{"name":"RegexBuilder"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Reference"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Capture"},{"text":">","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"You can use a ","type":"text"},{"code":"Reference","type":"codeVoice"},{"type":"text","text":" to access a regular expression, both during"},{"type":"text","text":" "},{"text":"the matching process and after a capture has been successful.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In this example, the "},{"code":"kind","type":"codeVoice"},{"type":"text","text":" reference captures either "},{"code":"\"CREDIT\"","type":"codeVoice"},{"type":"text","text":" or"},{"text":" ","type":"text"},{"code":"\"DEBIT\"","type":"codeVoice"},{"text":" at the beginning of a line. Later in the regular expression, the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"presence of "},{"code":"kind","type":"codeVoice"},{"type":"text","text":" matches the same substring that was captured previously"},{"text":" ","type":"text"},{"type":"text","text":"at the end of the line."}],"type":"paragraph"},{"syntax":"swift","code":["let kindRef = Reference(Substring.self)","let kindRegex = ChoiceOf {","    \"CREDIT\"","    \"DEBIT\"","}","","let transactionRegex = Regex {","    Anchor.startOfLine","    Capture(kindRegex, as: kindRef)","    OneOrMore(.anyNonNewline)","    kindRef","    Anchor.endOfLine","}","","let validTransaction = \"CREDIT     109912311421    Payroll   $69.73  CREDIT\"","let invalidTransaction = \"DEBIT     00522142123    Expense   $5.17  CREDIT\"","","print(validTransaction.contains(transactionRegex))","\/\/ Prints \"true\"","print(invalidTransaction.contains(transactionRegex))","\/\/ Prints \"false\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any reference that is used for matching must be captured elsewhere in the"},{"type":"text","text":" "},{"code":"Regex","type":"codeVoice"},{"type":"text","text":" block. You can use a reference for matching before it is captured;"},{"type":"text","text":" "},{"type":"text","text":"in that case, the reference will not match until it has previously been"},{"type":"text","text":" "},{"type":"text","text":"captured."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To access the captured “transaction kind”, you can use the "},{"code":"kind","type":"codeVoice"},{"type":"text","text":" reference"},{"type":"text","text":" "},{"type":"text","text":"to subscript a "},{"code":"Regex.Match","type":"codeVoice"},{"type":"text","text":" instance:"}]},{"code":["if let match = validTransaction.firstMatch(of: transactionRegex) {","    print(match[kindRef])","}","\/\/ Prints \"CREDIT\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use a "},{"code":"Reference","type":"codeVoice"},{"type":"text","text":" to capture a transformed value, include a "},{"code":"transform","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"closure when capturing."}]},{"code":["struct Transaction {","    var id: UInt64","}","let transactionRef = Reference(Transaction.self)","","let transactionIDRegex = Regex {","    Capture(kindRegex, as: kindRef)","    OneOrMore(.whitespace)","    TryCapture(as: transactionRef) {","        OneOrMore(.digit)","    } transform: { str in","        UInt64(str).map(Transaction.init(id:))","    }","    OneOrMore(.anyNonNewline)","    kindRef","    Anchor.endOfLine","}","","if let match = validTransaction.firstMatch(of: transactionIDRegex) {","    print(match[transactionRef])","}","\/\/ Prints \"Transaction(id: 109912311421)\""],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexComponent"],"type":"conformsTo"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference"},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/init(_:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/regex"]}],"abstract":[{"type":"text","text":"A reference to a captured portion of a regular expression."}],"seeAlsoSections":[{"generated":true,"title":"Captures","identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Capture","doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/TryCapture"],"anchor":"Captures"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder"]]},"variants":[{"paths":["\/documentation\/regexbuilder\/reference"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/RegexBuilder/TryCapture":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/TryCapture","role":"symbol","title":"TryCapture","navigatorTitle":[{"text":"TryCapture","kind":"identifier"}],"url":"\/documentation\/regexbuilder\/trycapture","abstract":[{"type":"text","text":"A regex component that attempts to transform a matched substring, saving"},{"type":"text","text":" "},{"type":"text","text":"the result if successful and backtracking if the transformation fails."}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TryCapture"}]},"doc://com.apple.Swift/documentation/Swift/RegexComponent":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexComponent","role":"symbol","url":"\/documentation\/swift\/regexcomponent","title":"RegexComponent","type":"topic","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RegexComponent","kind":"identifier"}],"navigatorTitle":[{"text":"RegexComponent","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that represents a regular expression."}]},"doc://com.apple.Swift/documentation/RegexBuilder/Reference":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference","role":"symbol","title":"Reference","navigatorTitle":[{"text":"Reference","kind":"identifier"}],"url":"\/documentation\/regexbuilder\/reference","abstract":[{"type":"text","text":"A reference to a captured portion of a regular expression."}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Reference","kind":"identifier"}]},"doc://com.apple.Swift/documentation/RegexBuilder/Reference/regex":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/regex","abstract":[],"role":"symbol","title":"regex","kind":"symbol","url":"\/documentation\/regexbuilder\/reference\/regex","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"regex","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Regex","preciseIdentifier":"s:17_StringProcessing5RegexV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Capture","preciseIdentifier":"s:12RegexBuilder9ReferenceV7Capturexmfp"},{"kind":"text","text":">"}]},"doc://com.apple.Swift/documentation/RegexBuilder/Capture":{"type":"topic","abstract":[{"text":"A regex component that saves the matched substring, or a transformed result,","type":"text"},{"text":" ","type":"text"},{"text":"for access in a regex match.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Capture","role":"symbol","title":"Capture","navigatorTitle":[{"text":"Capture","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/regexbuilder\/capture","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Capture","kind":"identifier"}]},"doc://com.apple.Swift/documentation/RegexBuilder":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder","role":"collection","url":"\/documentation\/regexbuilder","title":"RegexBuilder","type":"topic","kind":"symbol","abstract":[]},"doc://com.apple.Swift/documentation/RegexBuilder/Reference/init(_:)":{"role":"symbol","type":"topic","title":"init(_:)","url":"\/documentation\/regexbuilder\/reference\/init(_:)","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/init(_:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Capture","kind":"typeIdentifier","preciseIdentifier":"s:12RegexBuilder9ReferenceV7Capturexmfp"},{"text":".Type)","kind":"text"}],"abstract":[{"text":"Creates a reference with the specified capture type.","type":"text"}]}}