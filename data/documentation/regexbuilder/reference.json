{"abstract":[{"type":"text","text":"A reference to a captured portion of a regular expression."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder"]]},"kind":"symbol","metadata":{"externalID":"s:12RegexBuilder9ReferenceV","title":"Reference","symbolKind":"struct","platforms":[{"introducedAt":"16.0","beta":false,"name":"iOS","unavailable":false,"deprecated":false},{"introducedAt":"16.0","beta":false,"name":"iPadOS","unavailable":false,"deprecated":false},{"introducedAt":"16.0","beta":false,"name":"Mac Catalyst","unavailable":false,"deprecated":false},{"introducedAt":"13.0","beta":false,"name":"macOS","unavailable":false,"deprecated":false},{"introducedAt":"16.0","beta":false,"name":"tvOS","unavailable":false,"deprecated":false},{"introducedAt":"9.0","beta":false,"name":"watchOS","unavailable":false,"deprecated":false}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Reference","kind":"identifier"}],"roleHeading":"Structure","navigatorTitle":[{"text":"Reference","kind":"identifier"}],"role":"symbol","modules":[{"name":"RegexBuilder"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexComponent"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Reference","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Capture","kind":"genericParameter"},{"text":">","kind":"text"}]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"You can use a "},{"type":"codeVoice","code":"Reference"},{"type":"text","text":" to access a regular expression, both during"},{"type":"text","text":" "},{"type":"text","text":"the matching process and after a capture has been successful."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In this example, the "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" reference captures either "},{"type":"codeVoice","code":"\"CREDIT\""},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"DEBIT\""},{"type":"text","text":" at the beginning of a line. Later in the regular expression, the"},{"type":"text","text":" "},{"type":"text","text":"presence of "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" matches the same substring that was captured previously"},{"type":"text","text":" "},{"type":"text","text":"at the end of the line."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let kindRef = Reference(Substring.self)","let kindRegex = ChoiceOf {","    \"CREDIT\"","    \"DEBIT\"","}","","let transactionRegex = Regex {","    Anchor.startOfLine","    Capture(kindRegex, as: kindRef)","    OneOrMore(.anyNonNewline)","    kindRef","    Anchor.endOfLine","}","","let validTransaction = \"CREDIT     109912311421    Payroll   $69.73  CREDIT\"","let invalidTransaction = \"DEBIT     00522142123    Expense   $5.17  CREDIT\"","","print(validTransaction.contains(transactionRegex))","\/\/ Prints \"true\"","print(invalidTransaction.contains(transactionRegex))","\/\/ Prints \"false\""]},{"inlineContent":[{"type":"text","text":"Any reference that is used for matching must be captured elsewhere in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Regex"},{"type":"text","text":" block. You can use a reference for matching before it is captured;"},{"type":"text","text":" "},{"type":"text","text":"in that case, the reference will not match until it has previously been"},{"type":"text","text":" "},{"type":"text","text":"captured."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To access the captured “transaction kind”, you can use the "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" reference"},{"type":"text","text":" "},{"type":"text","text":"to subscript a "},{"type":"codeVoice","code":"Regex.Match"},{"type":"text","text":" instance:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["if let match = validTransaction.firstMatch(of: transactionRegex) {","    print(match[kindRef])","}","\/\/ Prints \"CREDIT\""]},{"inlineContent":[{"type":"text","text":"To use a "},{"type":"codeVoice","code":"Reference"},{"type":"text","text":" to capture a transformed value, include a "},{"type":"codeVoice","code":"transform"},{"type":"text","text":" "},{"type":"text","text":"closure when capturing."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct Transaction {","    var id: UInt64","}","let transactionRef = Reference(Transaction.self)","","let transactionIDRegex = Regex {","    Capture(kindRegex, as: kindRef)","    OneOrMore(.whitespace)","    TryCapture(as: transactionRef) {","        OneOrMore(.digit)","    } transform: { str in","        UInt64(str).map(Transaction.init(id:))","    }","    OneOrMore(.anyNonNewline)","    kindRef","    Anchor.endOfLine","}","","if let match = validTransaction.firstMatch(of: transactionIDRegex) {","    print(match[transactionRef])","}","\/\/ Prints \"Transaction(id: 109912311421)\""]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/regexbuilder\/reference"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Capture","doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/TryCapture"],"generated":true,"anchor":"Captures","title":"Captures"}],"topicSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/init(_:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/regex"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"}],"references":{"doc://com.apple.Swift/documentation/RegexBuilder/Reference/regex":{"abstract":[],"type":"topic","kind":"symbol","title":"regex","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"regex"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17_StringProcessing5RegexV","kind":"typeIdentifier","text":"Regex"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:12RegexBuilder9ReferenceV7Capturexmfp","kind":"typeIdentifier","text":"Capture"},{"kind":"text","text":">"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/regex","role":"symbol","url":"\/documentation\/regexbuilder\/reference\/regex"},"doc://com.apple.Swift/documentation/RegexBuilder/Reference":{"abstract":[{"type":"text","text":"A reference to a captured portion of a regular expression."}],"navigatorTitle":[{"kind":"identifier","text":"Reference"}],"url":"\/documentation\/regexbuilder\/reference","type":"topic","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference","title":"Reference","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Reference"}],"role":"symbol"},"doc://com.apple.Swift/documentation/RegexBuilder":{"abstract":[],"type":"topic","kind":"symbol","title":"RegexBuilder","identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder","role":"collection","url":"\/documentation\/regexbuilder"},"doc://com.apple.Swift/documentation/RegexBuilder/TryCapture":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TryCapture"}],"abstract":[{"type":"text","text":"A regex component that attempts to transform a matched substring, saving"},{"type":"text","text":" "},{"type":"text","text":"the result if successful and backtracking if the transformation fails."}],"title":"TryCapture","navigatorTitle":[{"kind":"identifier","text":"TryCapture"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/TryCapture","type":"topic","url":"\/documentation\/regexbuilder\/trycapture"},"doc://com.apple.Swift/documentation/RegexBuilder/Reference/init(_:)":{"abstract":[{"type":"text","text":"Creates a reference with the specified capture type."}],"type":"topic","kind":"symbol","title":"init(_:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"preciseIdentifier":"s:12RegexBuilder9ReferenceV7Capturexmfp","kind":"typeIdentifier","text":"Capture"},{"kind":"text","text":".Type)"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/init(_:)","role":"symbol","url":"\/documentation\/regexbuilder\/reference\/init(_:)"},"doc://com.apple.Swift/documentation/Swift/RegexComponent":{"abstract":[{"type":"text","text":"A type that represents a regular expression."}],"type":"topic","kind":"symbol","title":"RegexComponent","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RegexComponent"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexComponent","navigatorTitle":[{"kind":"identifier","text":"RegexComponent"}],"role":"symbol","url":"\/documentation\/swift\/regexcomponent"},"doc://com.apple.Swift/documentation/RegexBuilder/Capture":{"abstract":[{"type":"text","text":"A regex component that saves the matched substring, or a transformed result,"},{"type":"text","text":" "},{"type":"text","text":"for access in a regex match."}],"type":"topic","kind":"symbol","title":"Capture","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Capture"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Capture","navigatorTitle":[{"kind":"identifier","text":"Capture"}],"role":"symbol","url":"\/documentation\/regexbuilder\/capture"}}}