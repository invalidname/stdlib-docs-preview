{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder"]]},"kind":"symbol","seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Capture","doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/TryCapture"],"title":"Captures","generated":true,"anchor":"Captures"}],"abstract":[{"text":"A reference to a captured portion of a regular expression.","type":"text"}],"metadata":{"title":"Reference","role":"symbol","modules":[{"name":"RegexBuilder"}],"externalID":"s:12RegexBuilder9ReferenceV","navigatorTitle":[{"text":"Reference","kind":"identifier"}],"platforms":[{"unavailable":false,"introducedAt":"16.0","deprecated":false,"beta":false,"name":"iOS"},{"unavailable":false,"introducedAt":"16.0","deprecated":false,"beta":false,"name":"iPadOS"},{"unavailable":false,"introducedAt":"16.0","deprecated":false,"beta":false,"name":"Mac Catalyst"},{"unavailable":false,"introducedAt":"13.0","deprecated":false,"beta":false,"name":"macOS"},{"unavailable":false,"introducedAt":"16.0","deprecated":false,"beta":false,"name":"tvOS"},{"unavailable":false,"introducedAt":"9.0","deprecated":false,"beta":false,"name":"watchOS"}],"roleHeading":"Structure","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Reference","kind":"identifier"}]},"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexComponent"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Reference"},{"kind":"text","text":"<"},{"text":"Capture","kind":"genericParameter"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"You can use a ","type":"text"},{"code":"Reference","type":"codeVoice"},{"text":" to access a regular expression, both during","type":"text"},{"text":" ","type":"text"},{"text":"the matching process and after a capture has been successful.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In this example, the ","type":"text"},{"code":"kind","type":"codeVoice"},{"text":" reference captures either ","type":"text"},{"type":"codeVoice","code":"\"CREDIT\""},{"text":" or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\"DEBIT\""},{"text":" at the beginning of a line. Later in the regular expression, the","type":"text"},{"text":" ","type":"text"},{"text":"presence of ","type":"text"},{"type":"codeVoice","code":"kind"},{"text":" matches the same substring that was captured previously","type":"text"},{"text":" ","type":"text"},{"text":"at the end of the line.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let kindRef = Reference(Substring.self)","let kindRegex = ChoiceOf {","    \"CREDIT\"","    \"DEBIT\"","}","","let transactionRegex = Regex {","    Anchor.startOfLine","    Capture(kindRegex, as: kindRef)","    OneOrMore(.anyNonNewline)","    kindRef","    Anchor.endOfLine","}","","let validTransaction = \"CREDIT     109912311421    Payroll   $69.73  CREDIT\"","let invalidTransaction = \"DEBIT     00522142123    Expense   $5.17  CREDIT\"","","print(validTransaction.contains(transactionRegex))","\/\/ Prints \"true\"","print(invalidTransaction.contains(transactionRegex))","\/\/ Prints \"false\""]},{"type":"paragraph","inlineContent":[{"text":"Any reference that is used for matching must be captured elsewhere in the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Regex"},{"text":" block. You can use a reference for matching before it is captured;","type":"text"},{"text":" ","type":"text"},{"text":"in that case, the reference will not match until it has previously been","type":"text"},{"text":" ","type":"text"},{"text":"captured.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To access the captured “transaction kind”, you can use the ","type":"text"},{"type":"codeVoice","code":"kind"},{"text":" reference","type":"text"},{"text":" ","type":"text"},{"text":"to subscript a ","type":"text"},{"type":"codeVoice","code":"Regex.Match"},{"text":" instance:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if let match = validTransaction.firstMatch(of: transactionRegex) {","    print(match[kindRef])","}","\/\/ Prints \"CREDIT\""]},{"type":"paragraph","inlineContent":[{"text":"To use a ","type":"text"},{"type":"codeVoice","code":"Reference"},{"text":" to capture a transformed value, include a ","type":"text"},{"type":"codeVoice","code":"transform"},{"text":" ","type":"text"},{"text":"closure when capturing.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Transaction {","    var id: UInt64","}","let transactionRef = Reference(Transaction.self)","","let transactionIDRegex = Regex {","    Capture(kindRegex, as: kindRef)","    OneOrMore(.whitespace)","    TryCapture(as: transactionRef) {","        OneOrMore(.digit)","    } transform: { str in","        UInt64(str).map(Transaction.init(id:))","    }","    OneOrMore(.anyNonNewline)","    kindRef","    Anchor.endOfLine","}","","if let match = validTransaction.firstMatch(of: transactionIDRegex) {","    print(match[transactionRef])","}","\/\/ Prints \"Transaction(id: 109912311421)\""]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/regexbuilder\/reference"]}],"topicSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/init(_:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/regex"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.apple.Swift/documentation/RegexBuilder/TryCapture":{"navigatorTitle":[{"kind":"identifier","text":"TryCapture"}],"type":"topic","title":"TryCapture","url":"\/documentation\/regexbuilder\/trycapture","abstract":[{"text":"A regex component that attempts to transform a matched substring, saving","type":"text"},{"text":" ","type":"text"},{"text":"the result if successful and backtracking if the transformation fails.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/TryCapture","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TryCapture"}],"kind":"symbol","role":"symbol"},"doc://com.apple.Swift/documentation/RegexBuilder/Reference":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Reference"}],"url":"\/documentation\/regexbuilder\/reference","title":"Reference","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Reference"}],"type":"topic","abstract":[{"type":"text","text":"A reference to a captured portion of a regular expression."}],"role":"symbol"},"doc://com.apple.Swift/documentation/RegexBuilder":{"kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder","url":"\/documentation\/regexbuilder","title":"RegexBuilder","type":"topic","abstract":[],"role":"collection"},"doc://com.apple.Swift/documentation/RegexBuilder/Reference/init(_:)":{"type":"topic","title":"init(_:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/init(_:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Capture","preciseIdentifier":"s:12RegexBuilder9ReferenceV7Capturexmfp","kind":"typeIdentifier"},{"text":".Type)","kind":"text"}],"url":"\/documentation\/regexbuilder\/reference\/init(_:)","abstract":[{"type":"text","text":"Creates a reference with the specified capture type."}]},"doc://com.apple.Swift/documentation/Swift/RegexComponent":{"kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexComponent","navigatorTitle":[{"text":"RegexComponent","kind":"identifier"}],"url":"\/documentation\/swift\/regexcomponent","title":"RegexComponent","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"RegexComponent"}],"type":"topic","abstract":[{"type":"text","text":"A type that represents a regular expression."}],"role":"symbol"},"doc://com.apple.Swift/documentation/RegexBuilder/Capture":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Capture","role":"symbol","abstract":[{"text":"A regex component that saves the matched substring, or a transformed result,","type":"text"},{"text":" ","type":"text"},{"text":"for access in a regex match.","type":"text"}],"url":"\/documentation\/regexbuilder\/capture","title":"Capture","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Capture"}],"navigatorTitle":[{"kind":"identifier","text":"Capture"}]},"doc://com.apple.Swift/documentation/RegexBuilder/Reference/regex":{"abstract":[],"type":"topic","role":"symbol","url":"\/documentation\/regexbuilder\/reference\/regex","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/RegexBuilder\/Reference\/regex","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"regex","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17_StringProcessing5RegexV","kind":"typeIdentifier","text":"Regex"},{"text":"<","kind":"text"},{"text":"Capture","kind":"typeIdentifier","preciseIdentifier":"s:12RegexBuilder9ReferenceV7Capturexmfp"},{"text":">","kind":"text"}],"title":"regex"}}