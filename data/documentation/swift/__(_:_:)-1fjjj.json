oice"},{"type":"text","text":" have the same type."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"A nil-coalescing operation unwraps the left-hand side if it has a value, or","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"returns the right-hand side as a default. The result of this operation"},{"text":" ","type":"text"},{"text":"will be the same type as its arguments.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This operator uses short-circuit evaluation: "},{"code":"optional","type":"codeVoice"},{"type":"text","text":" is checked first,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"defaultValue","type":"codeVoice"},{"type":"text","text":" is evaluated only if "},{"code":"optional","type":"codeVoice"},{"type":"text","text":" is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":". For example:"}]},{"code":["let goodNumber = Int(\"100\") ?? Int(\"42\")","print(goodNumber)","\/\/ Prints \"Optional(100)\"","","let notSoGoodNumber = Int(\"invalid-input\") ?? Int(\"42\")","print(notSoGoodNumber)","\/\/ Prints \"Optional(42)\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this example, "},{"code":"goodNumber","type":"codeVoice"},{"type":"text","text":" is assigned a value of "},{"code":"100","type":"codeVoice"},{"type":"text","text":" because"},{"type":"text","text":" "},{"code":"Int(\"100\")","type":"codeVoice"},{"type":"text","text":" succeeds in returning a non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" result. When"},{"type":"text","text":" "},{"code":"notSoGoodNumber","type":"codeVoice"},{"type":"text","text":" is initialized, "},{"code":"Int(\"invalid-input\")","type":"codeVoice"},{"type":"text","text":" fails and returns"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", and so "},{"type":"codeVoice","code":"Int(\"42\")"},{"type":"text","text":" is called to supply a default value."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the result of this nil-coalescing operation is itself an optional"},{"type":"text","text":" "},{"type":"text","text":"value, you can chain default values by using "},{"code":"??","type":"codeVoice"},{"type":"text","text":" multiple times. The"},{"type":"text","text":" "},{"type":"text","text":"first optional value that isn’t "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" stops the chain and becomes the"},{"type":"text","text":" "},{"type":"text","text":"result of the whole expression. The next example tries to find the correct"},{"type":"text","text":" "},{"type":"text","text":"text for a greeting in two separate dictionaries before falling back to a"},{"type":"text","text":" "},{"type":"text","text":"static default."}]},{"syntax":"swift","code":["let greeting = userPrefs[greetingKey] ??","    defaults[greetingKey] ?? \"Greetings!\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"userPrefs[greetingKey]"},{"type":"text","text":" has a value, that value is assigned to"},{"type":"text","text":" "},{"code":"greeting","type":"codeVoice"},{"text":". If not, any value in ","type":"text"},{"code":"defaults[greetingKey]","type":"codeVoice"},{"text":" will succeed, and","type":"text"},{"text":" ","type":"text"},{"text":"if not that, ","type":"text"},{"code":"greeting","type":"codeVoice"},{"text":" will be set to the non-optional default value,","type":"text"},{"text":" ","type":"text"},{"code":"\"Greetings!\"","type":"codeVoice"},{"text":".","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/__(_:_:)-1fjjj"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"metadata":{"ext