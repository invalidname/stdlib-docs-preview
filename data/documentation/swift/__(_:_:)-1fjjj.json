graph","inlineContent":[{"text":"A value to use as a default. ","type":"text"},{"code":"defaultValue","type":"codeVoice"},{"text":" and","type":"text"},{"type":"text","text":" "},{"code":"optional","type":"codeVoice"},{"text":" have the same type.","type":"text"}]}],"name":"defaultValue"}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A nil-coalescing operation unwraps the left-hand side if it has a value, or"},{"type":"text","text":" "},{"type":"text","text":"returns the right-hand side as a default. The result of this operation"},{"type":"text","text":" "},{"type":"text","text":"will be the same type as its arguments."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This operator uses short-circuit evaluation: "},{"type":"codeVoice","code":"optional"},{"type":"text","text":" is checked first,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"defaultValue"},{"type":"text","text":" is evaluated only if "},{"type":"codeVoice","code":"optional"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". For example:"}]},{"type":"codeListing","syntax":"swift","code":["let goodNumber = Int(\"100\") ?? Int(\"42\")","print(goodNumber)","\/\/ Prints \"Optional(100)\"","","let notSoGoodNumber = Int(\"invalid-input\") ?? Int(\"42\")","print(notSoGoodNumber)","\/\/ Prints \"Optional(42)\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this example, "},{"type":"codeVoice","code":"goodNumber"},{"type":"text","text":" is assigned a value of "},{"type":"codeVoice","code":"100"},{"type":"text","text":" because"},{"type":"text","text":" "},{"type":"codeVoice","code":"Int(\"100\")"},{"type":"text","text":" succeeds in returning a non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" result. When"},{"type":"text","text":" "},{"type":"codeVoice","code":"notSoGoodNumber"},{"type":"text","text":" is initialized, "},{"type":"codeVoice","code":"Int(\"invalid-input\")"},{"type":"text","text":" fails and returns"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", and so "},{"type":"codeVoice","code":"Int(\"42\")"},{"type":"text","text":" is called to supply a default value."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the result of this nil-coalescing operation is itself an optional"},{"type":"text","text":" "},{"text":"value, you can chain default values by using ","type":"text"},{"code":"??","type":"codeVoice"},{"text":" multiple times. The","type":"text"},{"text":" ","type":"text"},{"text":"first optional value that isn’t ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" stops the chain and becomes the","type":"text"},{"text":" ","type":"text"},{"text":"result of the whole expression. The next example tries to find the correct","type":"text"},{"text":" ","type":"text"},{"text":"text for a greeting in two separate dictionaries before falling back to a","type":"text"},{"text":" ","type":"text"},{"text":"static default.","type":"text"}]},{"code":["let greeting = userPrefs[greetingKey] ??","    defaults[greetingKey] ?? \"Greetings!\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"userPrefs[greetingKey]","type":"codeVoice"},{"text":" has a value, that value is assigned to","type":"text"},{"text":" ","type":"text"},{"code":"greeting","type":"codeVoice"},{"text":". If not, any value in ","type":"text"},{"type":"codeVoice","code":"defaults[greetingKey]"},{"type":"text","text":" will succeed, and"},{"text":" ","type":"text"},{"text":"if not that, ","type":"text"},{"type":"codeVoice","code":"greeting"},{"text":" will be set to the non-optional default value,","type":"text"},{"text":" ","type":"text"},{"code":"\"Greetings!\"","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"references":{"doc: