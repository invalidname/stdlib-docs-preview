e":"text","text":"A nil-coalescing operation unwraps the left-hand side if it has a value, or"},{"type":"text","text":" "},{"type":"text","text":"returns the right-hand side as a default. The result of this operation"},{"type":"text","text":" "},{"type":"text","text":"will be the same type as its arguments."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This operator uses short-circuit evaluation: "},{"type":"codeVoice","code":"optional"},{"type":"text","text":" is checked first,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"defaultValue"},{"type":"text","text":" is evaluated only if "},{"type":"codeVoice","code":"optional"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". For example:"}],"type":"paragraph"},{"code":["let goodNumber = Int(\"100\") ?? Int(\"42\")","print(goodNumber)","\/\/ Prints \"Optional(100)\"","","let notSoGoodNumber = Int(\"invalid-input\") ?? Int(\"42\")","print(notSoGoodNumber)","\/\/ Prints \"Optional(42)\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this example, "},{"type":"codeVoice","code":"goodNumber"},{"type":"text","text":" is assigned a value of "},{"type":"codeVoice","code":"100"},{"type":"text","text":" because"},{"type":"text","text":" "},{"type":"codeVoice","code":"Int(\"100\")"},{"type":"text","text":" succeeds in returning a non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" result. When"},{"text":" ","type":"text"},{"type":"codeVoice","code":"notSoGoodNumber"},{"type":"text","text":" is initialized, "},{"code":"Int(\"invalid-input\")","type":"codeVoice"},{"type":"text","text":" fails and returns"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", and so "},{"type":"codeVoice","code":"Int(\"42\")"},{"type":"text","text":" is called to supply a default value."}]},{"type":"paragraph","inlineContent":[{"text":"Because the result of this nil-coalescing operation is itself an optional","type":"text"},{"type":"text","text":" "},{"type":"text","text":"value, you can chain default values by using "},{"type":"codeVoice","code":"??"},{"type":"text","text":" multiple times. The"},{"type":"text","text":" "},{"type":"text","text":"first optional value that isn’t "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" stops the chain and becomes the"},{"type":"text","text":" "},{"type":"text","text":"result of the whole expression. The next example tries to find the correct"},{"type":"text","text":" "},{"type":"text","text":"text for a greeting in two separate dictionaries before falling back to a"},{"text":" ","type":"text"},{"text":"static default.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let greeting = userPrefs[greetingKey] ??","    defaults[greetingKey] ?? \"Greetings!\""]},{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"userPrefs[greetingKey]"},{"text":" has a value, that value is assigned to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"greeting"},{"text":". If not, any value in ","type":"text"},{"type":"codeVoice","code":"defaults[greetingKey]"},{"type":"text","text":" will succeed, and"},{"text":" ","type":"text"},{"type":"text","text":"if not that, "},{"type":"codeVoice","code":"greeting"},{"type":"text","text":" will be set to the non-optional default value,"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"Greetings!\""},{"type":"text","text":"."}],"type":"paragraph"}]}],"metadata":{"title":"??(_:_:)","modules":[{"name":"Swift"}],"externalID":"s:s2qqoiyxSgABn_AByKXKtKRi_zlF","role":"symbol","platforms":[{"deprecated":false,"introducedAt":"8.0","unavailable":false,"beta":false,"name":"iOS"},{"deprecated":false,"introducedAt":"8.0","unavailable":false,"beta":false,"name":"iPadOS"},{"deprecated":false,"introducedAt":"13.0","unavailable":false,"beta":false,"name":"Mac Catalyst"},{"deprecated":false,"i