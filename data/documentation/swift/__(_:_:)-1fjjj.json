:"declarations"},{"parameters":[{"name":"optional","content":[{"inlineContent":[{"text":"An optional value.","type":"text"}],"type":"paragraph"}]},{"name":"defaultValue","content":[{"inlineContent":[{"type":"text","text":"A value to use as a default. "},{"code":"defaultValue","type":"codeVoice"},{"type":"text","text":" and"},{"text":" ","type":"text"},{"code":"optional","type":"codeVoice"},{"type":"text","text":" have the same type."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"A nil-coalescing operation unwraps the left-hand side if it has a value, or"},{"type":"text","text":" "},{"type":"text","text":"returns the right-hand side as a default. The result of this operation"},{"text":" ","type":"text"},{"text":"will be the same type as its arguments.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This operator uses short-circuit evaluation: "},{"code":"optional","type":"codeVoice"},{"type":"text","text":" is checked first,"},{"text":" ","type":"text"},{"type":"text","text":"and "},{"code":"defaultValue","type":"codeVoice"},{"text":" is evaluated only if ","type":"text"},{"type":"codeVoice","code":"optional"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":". For example:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let goodNumber = Int(\"100\") ?? Int(\"42\")","print(goodNumber)","\/\/ Prints \"Optional(100)\"","","let notSoGoodNumber = Int(\"invalid-input\") ?? Int(\"42\")","print(notSoGoodNumber)","\/\/ Prints \"Optional(42)\""],"type":"codeListing"},{"inlineContent":[{"text":"In this example, ","type":"text"},{"type":"codeVoice","code":"goodNumber"},{"text":" is assigned a value of ","type":"text"},{"code":"100","type":"codeVoice"},{"text":" because","type":"text"},{"text":" ","type":"text"},{"code":"Int(\"100\")","type":"codeVoice"},{"text":" succeeds in returning a non-","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" result. When","type":"text"},{"text":" ","type":"text"},{"code":"notSoGoodNumber","type":"codeVoice"},{"text":" is initialized, ","type":"text"},{"code":"Int(\"invalid-input\")","type":"codeVoice"},{"text":" fails and returns","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", and so ","type":"text"},{"code":"Int(\"42\")","type":"codeVoice"},{"type":"text","text":" is called to supply a default value."}],"type":"paragraph"},{"inlineContent":[{"text":"Because the result of this nil-coalescing operation is itself an optional","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"value, you can chain default values by using "},{"code":"??","type":"codeVoice"},{"type":"text","text":" multiple times. The"},{"text":" ","type":"text"},{"text":"first optional value that isn’t ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" stops the chain and becomes the","type":"text"},{"text":" ","type":"text"},{"text":"result of the whole expression. The next example tries to find the correct","type":"text"},{"text":" ","type":"text"},{"text":"text for a greeting in two separate dictionaries before falling back to a","type":"text"},{"text":" ","type":"text"},{"text":"static default.","type":"text"}],"type":"paragraph"},{"code":["let greeting = userPrefs[greetingKey] ??","    defaults[greetingKey] ?? \"Greetings!\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"userPrefs[greetingKey]"},{"type":"text","text":" has a value, that value is assigned to"},{"type":"text","text":" "},{"type":"codeVoice","code":"greeting"},{"type":"text","text":". If not, any value in "},{"type":"codeVoice","code":"defaults[greetingKey]"},{"type":"text","text":" will succeed, and"},{"type":"text","text":" "},{"type":"text","text":"if not that, "},{"type":"codeVoice","code":"greeting"},{"type":"text","text":" will be set to t