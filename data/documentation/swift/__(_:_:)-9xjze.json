ult. "},{"type":"codeVoice","code":"defaultValue"},{"type":"text","text":" is the same"},{"type":"text","text":" "},{"type":"text","text":"type as the "},{"type":"codeVoice","code":"Wrapped"},{"type":"text","text":" type of "},{"type":"codeVoice","code":"optional"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"defaultValue"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"A nil-coalescing operation unwraps the left-hand side if it has a value, or","type":"text"},{"text":" ","type":"text"},{"text":"it returns the right-hand side as a default. The result of this operation","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"will have the non-optional type of the left-hand side’s "},{"type":"codeVoice","code":"Wrapped"},{"type":"text","text":" type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This operator uses short-circuit evaluation: "},{"type":"codeVoice","code":"optional"},{"type":"text","text":" is checked first,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"defaultValue"},{"type":"text","text":" is evaluated only if "},{"type":"codeVoice","code":"optional"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". For example:"}],"type":"paragraph"},{"code":["func getDefault() -> Int {","    print(\"Calculating default...\")","    return 42","}","","let goodNumber = Int(\"100\") ?? getDefault()","\/\/ goodNumber == 100","","let notSoGoodNumber = Int(\"invalid-input\") ?? getDefault()","\/\/ Prints \"Calculating default...\"","\/\/ notSoGoodNumber == 42"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"In this example, "},{"type":"codeVoice","code":"goodNumber"},{"type":"text","text":" is assigned a value of "},{"type":"codeVoice","code":"100"},{"type":"text","text":" because"},{"type":"text","text":" "},{"type":"codeV