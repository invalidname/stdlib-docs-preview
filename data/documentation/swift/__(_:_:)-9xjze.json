","text":" succeeded in returning a non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" result. When"},{"type":"text","text":" "},{"type":"codeVoice","code":"notSoGoodNumber"},{"type":"text","text":" is initialized, "},{"type":"codeVoice","code":"Int(\"invalid-input\")"},{"type":"text","text":" fails and returns"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", and so the "},{"type":"codeVoice","code":"getDefault()"},{"type":"text","text":" method is called to supply a default"},{"type":"text","text":" "},{"type":"text","text":"value."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/__(_:_:)-9xjze","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/__(_:_:)-9xjze"]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Operator","externalID":"s:s2qqoiyxxSgn_xyKXKtKRi_zlF","symbolKind":"op","title":"??(_:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"??"},{"kind":"text","text":" "},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"T"},{"text":">(","kind":"text"},{"kind":"keyword","text":"consuming"},{"text":" ","kind":"text"},{"text":"T","kind":"typeIdentifier","preciseIdentifier":"s:s2qqoiyxxSgn_xyKXKtKRi_zlF1TL_xmfp"},{"kind":"text","text":"?, "},{"kind":"attribute","text":"@autoclosure"},{"kind":"text","text":" () "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"text":"T","kind":"typeIdentifier","preciseIdentifier":"s:s2qqoiyxxSgn_xyKXKtKRi_zlF1TL_xmfp"},{"kind":"text","text":") "},{"text":"rethrows","kind":"keyword"},{"kind":"text","text":" -> "},{"text":"T","kind":"typeIdentifier","preciseIdentifier":"s:s2qqoiyxxSgn_xyKXKtKRi_zlF1TL_xmfp"}],"role":"symbol","modules":[{"name":"Swift"}],"platforms":[{"unavailable":false,"name":"iOS","introducedAt":"8.0","depreca