-hand side if it has a value, or","type":"text"},{"text":" ","type":"text"},{"text":"it returns the right-hand side as a default. The result of this operation","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"will have the non-optional type of the left-hand side’s "},{"code":"Wrapped","type":"codeVoice"},{"text":" type.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This operator uses short-circuit evaluation: ","type":"text"},{"type":"codeVoice","code":"optional"},{"text":" is checked first,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"defaultValue"},{"text":" is evaluated only if ","type":"text"},{"type":"codeVoice","code":"optional"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":". For example:","type":"text"}],"type":"paragraph"},{"code":["func getDefault() -> Int {","    print(\"Calculating default...\")","    return 42","}","","let goodNumber = Int(\"100\") ?? getDefault()","\/\/ goodNumber == 100","","let notSoGoodNumber = Int(\"invalid-input\") ?? getDefault()","\/\/ Prints \"Calculating default...\"","\/\/ notSoGoodNumber == 42"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"In this example, ","type":"text"},{"type":"codeVoice","code":"goodNumber"},{"text":" is assigned a value of ","type":"text"},{"type":"codeVoice","code":"100"},{"type":"text","text":" because"},{"type":"text","text":" "},{"type":"codeVoice","code":"Int(\"100\")"},{"text":" succeeded in returning a non-","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" result. When"},{"text":" ","type":"text"},{"type":"codeVoice","code":"notSoGoodNumber"},{"type":"text","text":" is initialized, "},{"type":"codeVoice","code":"Int(\"invalid-input\")"},{"type":"text","text":" fails and returns"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"text":", and so the ","type":"text"},{"code":"getDefault()","type":"codeVoice"},{"text":" method