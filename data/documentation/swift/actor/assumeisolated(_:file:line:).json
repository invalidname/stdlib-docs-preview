eContent":[{"type":"text","text":"The return value of the "},{"type":"codeVoice","code":"operation"}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"You call this method to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"assume and verify"}]},{"type":"text","text":" that the currently"},{"type":"text","text":" "},{"type":"text","text":"executing synchronous function is actually executing on the serial"},{"type":"text","text":" "},{"type":"text","text":"executor of this actor."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If that is the case, the operation is invoked with an "},{"type":"codeVoice","code":"isolated"},{"text":" version","type":"text"},{"text":" ","type":"text"},{"text":"of the actor, allowing synchronous access to actor local state without","type":"text"},{"text":" ","type":"text"},{"text":"hopping through asynchronous boundaries.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the current context is not running on the actor’s serial executor, or"},{"type":"text","text":" "},{"type":"text","text":"if the actor is a reference to a remote actor, this method will crash"},{"type":"text","text":" "},{"type":"text","text":"with a fatal error (similar to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/preconditionIsolated(_:file:line:)"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that this check is performed against the passed in actor’s serial"},{"type":"text","text":" "},{"type":"text","text":"executor, meaning that if another actor uses the same serial executor–by"},{"type":"text","text":" "},{"type":"text","text":"using that actor’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/unownedExecutor"},{"type":"text","text":" as its own"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/unownedExecutor","isActive":true},{"type":"text","text":"–this check will succeed, as from a concurrency"},{"type":"text","text":" "},{"type":"text","text":"safety perspective, the serial executor guarantees mutual exclusion of"},{"text":" ","type":"text"},{"text":"those two actors.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This method can only be used from synchronous functions, as asynchronous","type":"text"},{"type":"text","text":" "},{"text":"functions should instead perform a normal method call to the actor, which","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"will hop task execution to the target actor if necessary."}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Because this check is performed against the actor’s serial executor,"},{"type":"text","text":" "},{"text":"if another actor uses the same serial executor–by using","type":"text"},{"text":" ","type":"text"},{"text":"another actor’s executor as its own ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/unownedExecutor","isActive":true},{"type":"text","text":" "},{"text":"–this check will succeed.  Fom a concurrency safety perspective,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the serial executor guarantees mutual exclusion of those two actors."}]}],"name":"Note"},{"type":"aside","content":[{"inlineContent":[{"text":"The error thrown by the operation, if it threw","type":"text"}],"type":"paragraph"}],"style":"note","name":"Throws"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/assumeIsolated(_:file:line:)"},"metadata":{"role":"symbol","roleHeading":"Instance Method","modules":[{"name":"Swift","relatedModules":[]}],"title":"assumeIsolat