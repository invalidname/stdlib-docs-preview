,"inlineContent":[{"type":"text","text":"You call this method to "},{"inlineContent":[{"text":"assume and verify","type":"text"}],"type":"emphasis"},{"text":" that the currently","type":"text"},{"text":" ","type":"text"},{"text":"executing synchronous function is actually executing on the serial","type":"text"},{"text":" ","type":"text"},{"text":"executor of this actor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If that is the case, the operation is invoked with an ","type":"text"},{"type":"codeVoice","code":"isolated"},{"text":" version","type":"text"},{"text":" ","type":"text"},{"text":"of the actor, allowing synchronous access to actor local state without","type":"text"},{"text":" ","type":"text"},{"text":"hopping through asynchronous boundaries.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the current context is not running on the actor’s serial executor, or","type":"text"},{"text":" ","type":"text"},{"text":"if the actor is a reference to a remote actor, this method will crash","type":"text"},{"text":" ","type":"text"},{"text":"with a fatal error (similar to ","type":"text"},{"type":"codeVoice","code":"preconditionIsolated()"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note that this check is performed against the passed in actor’s serial","type":"text"},{"text":" ","type":"text"},{"text":"executor, meaning that if another actor uses the same serial executor–by","type":"text"},{"text":" ","type":"text"},{"text":"using that actor’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/unownedExecutor"},{"text":" as its own","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/unownedExecutor"},{"text":"–this check will succeed, as from a concurrency","type":"text"},{"text":" ","type":"text"},{"text":"safety perspective, the serial executor guarantees mutual exclusion of","type":"text"},{"text":" ","type":"text"},{"text":"those two actors.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This method can only be used from synchronous functions, as asynchronous","type":"text"},{"text":" ","type":"text"},{"text":"functions should instead perform a normal method call to the actor, which","type":"text"},{"text":" ","type":"text"},{"text":"will hop task execution to the target actor if necessary.","type":"text"}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This check is performed against the actor’s serial executor,"},{"type":"text","text":" "},{"type":"text","text":"meaning that \/ if another actor uses the same serial executor–by using"},{"type":"text","text":" "},{"type":"text","text":"another actor’s executor as its own "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/unownedExecutor","isActive":true},{"type":"text","text":" "},{"type":"text","text":"–this check will succeed , as from a concurrency safety perspective,"},{"type":"text","text":" "},{"type":"text","text":"the serial executor guarantees mutual exclusion of those two actors."}]}],"name":"Note","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rethrows the "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" thrown by the operation if it threw"}]}],"name":"Throws","type":"aside"}],"kind":"content"}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/Actor":{"type":"topic","abstract":[{"type":"text","text":"Common protocol to which all actors conform."}],"kind":"symbol","title":"Actor","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Actor","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor","navigatorTitle":[{"text":"Actor","kind":"identifier"}],"role":"symbol","url":"\/documen