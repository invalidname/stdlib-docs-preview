directionalCollection\/enumerated()"},"references":{"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"EnumeratedSequence","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnumeratedSequence","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","url":"\/documentation\/swift\/enumeratedsequence","title":"EnumeratedSequence","abstract":[{"text":"An enumeration of the elements of a sequence or collection.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/AnyBidirectionalCollection":{"url":"\/documentation\/swift\/anybidirectionalcollection","navigatorTitle":[{"kind":"identifier","text":"AnyBidirectionalCollection"}],"kind":"symbol","abstract":[{"type":"text","text":"A type-erased wrapper over any collection with indices that"},{"type":"text","text":" "},{"type":"text","text":"support bidirectional traversal."}],"role":"symbol","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyBidirectionalCollection","title":"AnyBidirectionalCollection","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyBidirectionalCollection"}]},"doc://com.apple.Swift/documentation/Swift":{"title":"Swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","url":"\/documentation\/swift"},"doc://com.apple.Swift/documentation/Swift/AnyBidirectionalCollection/enumerated()":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyBidirectionalCollection\/enumerated()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"enumerated"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:s18EnumeratedSequenceV","text":"Enumer