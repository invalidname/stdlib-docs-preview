any collection with indices that","type":"text"},{"text":" ","type":"text"},{"text":"support bidirectional traversal.","type":"text"}],"kind":"symbol","url":"\/documentation\/swift\/anybidirectionalcollection","title":"AnyBidirectionalCollection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyBidirectionalCollection","role":"symbol"},"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/swift\/enumeratedsequence","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"EnumeratedSequence"}],"navigatorTitle":[{"kind":"identifier","text":"EnumeratedSequence"}],"title":"EnumeratedSequence","abstract":[{"type":"text","text":"An enumeration of the elements of a sequence or collection."}]}}}