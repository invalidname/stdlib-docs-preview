xt":".Type","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"You can use the ","type":"text"},{"code":"AnyClass","type":"codeVoice"},{"text":" protocol as the concrete type for an instance of","type":"text"},{"text":" ","type":"text"},{"text":"any class. When you do, all known ","type":"text"},{"code":"@objc","type":"codeVoice"},{"text":" class methods and properties are","type":"text"},{"text":" ","type":"text"},{"text":"available as implicitly unwrapped optional methods and properties,","type":"text"},{"text":" ","type":"text"},{"text":"respectively. For example:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["class IntegerRef {","    @objc class func getDefaultValue() -> Int {","        return 42","    }","}","","func getDefaultValue(_ c: AnyClass) -> Int? {","    return c.getDefaultValue?()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"getDefaultValue(_:)"},{"type":"text","text":" function uses optional chaining to safely call"},{"type":"text","text":" "},{"type":"text","text":"the implicitly unwrapped class method on "},{"type":"codeVoice","code":"c"},{"type":"text","text":". Calling the function with"},{"type":"text","text":" "},{"type":"text","text":"different class types shows how the "},{"type":"codeVoice","code":"getDefaultValue()"},{"type":"text","text":" class method is"},{"type":"text","text":" "},{"type":"text","text":"only conditionally available."}]},{"type":"codeListing","syntax":"swift","code":["print(getDefaultValue(IntegerRef.self))","\/\/ Prints \"Optional(42)\"","","print(getDefaultValue(NSString.self))","\/\/ Prints \"nil\""]}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/AnyClass":{"url":"\/documentation\/swift\/anyclass","type":"topic","navigatorTitle":[{"text":"AnyClass","kind":"identifier"}],"kin