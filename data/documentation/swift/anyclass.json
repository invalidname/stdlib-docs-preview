:2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"You can use the ","type":"text"},{"type":"codeVoice","code":"AnyClass"},{"text":" protocol as the concrete type for an instance of","type":"text"},{"text":" ","type":"text"},{"text":"any class. When you do, all known ","type":"text"},{"type":"codeVoice","code":"@objc"},{"text":" class methods and properties are","type":"text"},{"text":" ","type":"text"},{"text":"available as implicitly unwrapped optional methods and properties,","type":"text"},{"text":" ","type":"text"},{"text":"respectively. For example:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["class IntegerRef {","    @objc class func getDefaultValue() -> Int {","        return 42","    }","}","","func getDefaultValue(_ c: AnyClass) -> Int? {","    return c.getDefaultValue?()","}"],"syntax":"swift"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"getDefaultValue(_:)"},{"text":" function uses optional chaining to safely call","type":"text"},{"text":" ","type":"text"},{"text":"the implicitly unwrapped class method on ","type":"text"},{"type":"codeVoice","code":"c"},{"text":". Calling the function with","type":"text"},{"text":" ","type":"text"},{"text":"different class types shows how the ","type":"text"},{"type":"codeVoice","code":"getDefaultValue()"},{"text":" class method is","type":"text"},{"text":" ","type":"text"},{"text":"only conditionally available.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["print(getDefaultValue(IntegerRef.self))","\/\/ Prints \"Optional(42)\"","","print(getDefaultValue(NSString.self))","\/\/ Prints \"nil\""],"syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/anyclass"]}],"references":{"doc://com.apple.Swift/documentation/Swift":{"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","title":"Swift","url":"\/documentation\/swift","abstract":