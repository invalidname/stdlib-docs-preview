ext":"), where ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":" represents a","type":"text"},{"text":" ","type":"text"},{"text":"consecutive integer starting at zero and ","type":"text"},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"type":"text","text":" represents an element of"},{"type":"text","text":" "},{"type":"text","text":"the sequence."}],"type":"topic","url":"\/documentation\/swift\/anycollection\/enumerated()","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyCollection\/enumerated()"},"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"role":"symbol","type":"topic","url":"\/documentation\/swift\/enumeratedsequence","title":"EnumeratedSequence","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EnumeratedSequence"}],"abstract":[{"type":"text","text":"An enumeration of the elements of a sequence or collection."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EnumeratedSequence"}]}}}