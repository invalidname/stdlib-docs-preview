pe":"text"},{"text":" ","type":"text"},{"text":"support forward traversal.","type":"text"}],"title":"AnyCollection","url":"\/documentation\/swift\/anycollection","type":"topic"},"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"EnumeratedSequence","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnumeratedSequence","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","url":"\/documentation\/swift\/enumeratedsequence","title":"EnumeratedSequence","abstract":[{"text":"An enumeration of the elements of a sequence or collection.","type":"text"}]}}}