r starting at zero and "},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"text":" represents an element of","type":"text"},{"text":" ","type":"text"},{"text":"the sequence.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"role":"symbol","type":"topic","title":"EnumeratedSequence","url":"\/documentation\/swift\/enumeratedsequence","kind":"symbol","navigatorTitle":[{"text":"EnumeratedSequence","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnumeratedSequence","kind":"identifier"}],"abstract":[{"type":"text","text":"An enumeration of the elements of a sequence or collection."}]}}}