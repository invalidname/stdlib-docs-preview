{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"metadata":{"symbolKind":"typealias","fragments":[{"kind":"keyword","text":"typealias"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AnyObject"}],"platforms":[{"deprecated":false,"introducedAt":"8.0","unavailable":false,"name":"iOS","beta":false},{"deprecated":false,"introducedAt":"8.0","unavailable":false,"name":"iPadOS","beta":false},{"introducedAt":"13.0","deprecated":false,"unavailable":false,"name":"Mac Catalyst","beta":false},{"unavailable":false,"beta":false,"introducedAt":"10.10","name":"macOS","deprecated":false},{"unavailable":false,"beta":false,"introducedAt":"9.0","name":"tvOS","deprecated":false},{"unavailable":false,"beta":false,"introducedAt":"1.0","name":"visionOS","deprecated":false},{"unavailable":false,"beta":false,"introducedAt":"2.0","name":"watchOS","deprecated":false}],"externalID":"s:s9AnyObjecta","title":"AnyObject","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AnyObject"}],"modules":[{"name":"Standard Library"}],"roleHeading":"Type Alias"},"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyObject","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyObject"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You use "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" when you need the flexibility of an untyped object or"},{"type":"text","text":" "},{"type":"text","text":"when you use bridged Objective-C methods and properties that return an"},{"type":"text","text":" "},{"type":"text","text":"untyped result. "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" can be used as the concrete type for an"},{"type":"text","text":" "},{"type":"text","text":"instance of any class, class type, or class-only protocol. For example:"}]},{"type":"codeListing","code":["class FloatRef {","    let value: Float","    init(_ value: Float) {","        self.value = value","    }","}","","let x = FloatRef(2.3)","let y: AnyObject = x","let z: AnyObject = FloatRef.self"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" can also be used as the concrete type for an instance of a type"},{"type":"text","text":" "},{"type":"text","text":"that bridges to an Objective-C class. Many value types in Swift bridge to"},{"type":"text","text":" "},{"type":"text","text":"Objective-C counterparts, like "},{"type":"codeVoice","code":"String"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","code":["let s: AnyObject = \"This is a bridged string.\" as NSString","print(s is NSString)","\/\/ Prints \"true\"","","let v: AnyObject = 100 as NSNumber","print(type(of: v))","\/\/ Prints \"__NSCFNumber\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The flexible behavior of the "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" protocol is similar to"},{"type":"text","text":" "},{"type":"text","text":"Objective-C’s "},{"type":"codeVoice","code":"id"},{"type":"text","text":" type. For this reason, imported Objective-C types"},{"type":"text","text":" "},{"type":"text","text":"frequently use "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" as the type for properties, method parameters,"},{"type":"text","text":" "},{"type":"text","text":"and return values."}],"type":"paragraph"},{"type":"heading","anchor":"Casting-AnyObject-Instances-to-a-Known-Type","level":1,"text":"Casting AnyObject Instances to a Known Type"},{"inlineContent":[{"type":"text","text":"Objects with a concrete type of "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" maintain a specific dynamic"},{"type":"text","text":" "},{"type":"text","text":"type and can be cast to that type using one of the type-cast operators"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"as"},{"type":"text","text":", "},{"type":"codeVoice","code":"as?"},{"type":"text","text":", or "},{"type":"codeVoice","code":"as!"},{"type":"text","text":")."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This example uses the conditional downcast operator ("},{"type":"codeVoice","code":"as?"},{"type":"text","text":") to"},{"type":"text","text":" "},{"type":"text","text":"conditionally cast the "},{"type":"codeVoice","code":"s"},{"type":"text","text":" constant declared above to an instance of"},{"type":"text","text":" "},{"type":"text","text":"Swift’s "},{"type":"codeVoice","code":"String"},{"type":"text","text":" type."}]},{"type":"codeListing","syntax":"swift","code":["if let message = s as? String {","    print(\"Successful cast to String: \\(message)\")","}","\/\/ Prints \"Successful cast to String: This is a bridged string.\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have prior knowledge that an "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" instance has a particular"},{"type":"text","text":" "},{"type":"text","text":"type, you can use the unconditional downcast operator ("},{"type":"codeVoice","code":"as!"},{"type":"text","text":"). Performing"},{"type":"text","text":" "},{"type":"text","text":"an invalid cast triggers a runtime error."}]},{"type":"codeListing","syntax":"swift","code":["let message = s as! String","print(\"Successful cast to String: \\(message)\")","\/\/ Prints \"Successful cast to String: This is a bridged string.\"","","let badCase = v as! String","\/\/ Runtime error"]},{"inlineContent":[{"type":"text","text":"Casting is always safe in the context of a "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" statement."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let mixedArray: [AnyObject] = [s, v]","for object in mixedArray {","    switch object {","    case let x as String:","        print(\"'\\(x)' is a String\")","    default:","        print(\"'\\(object)' is not a String\")","    }","}","\/\/ Prints \"'This is a bridged string.' is a String\"","\/\/ Prints \"'100' is not a String\""]},{"type":"heading","level":1,"anchor":"Accessing-Objective-C-Methods-and-Properties","text":"Accessing Objective-C Methods and Properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you use "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" as a concrete type, you have at your disposal"},{"type":"text","text":" "},{"type":"text","text":"every "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" method and property—that is, methods and properties"},{"type":"text","text":" "},{"type":"text","text":"imported from Objective-C or marked with the "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" attribute. Because"},{"type":"text","text":" "},{"type":"text","text":"Swift can’t guarantee at compile time that these methods and properties"},{"type":"text","text":" "},{"type":"text","text":"are actually available on an "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" instance’s underlying type, these"},{"type":"text","text":" "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" symbols are available as implicitly unwrapped optional methods and"},{"type":"text","text":" "},{"type":"text","text":"properties, respectively."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This example defines an "},{"type":"codeVoice","code":"IntegerRef"},{"type":"text","text":" type with an "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" method named"},{"type":"text","text":" "},{"type":"codeVoice","code":"getIntegerValue()"},{"type":"text","text":"."}]},{"type":"codeListing","code":["class IntegerRef {","    let value: Int","    init(_ value: Int) {","        self.value = value","    }","","    @objc func getIntegerValue() -> Int {","        return value","    }","}","","func getObject() -> AnyObject {","    return IntegerRef(100)","}","","let obj: AnyObject = getObject()"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"In the example, "},{"type":"codeVoice","code":"obj"},{"type":"text","text":" has a static type of "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" and a dynamic type"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"IntegerRef"},{"type":"text","text":". You can use optional chaining to call the "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"codeVoice","code":"getIntegerValue()"},{"type":"text","text":" on "},{"type":"codeVoice","code":"obj"},{"type":"text","text":" safely. If you’re sure of the dynamic type of"},{"type":"text","text":" "},{"type":"codeVoice","code":"obj"},{"type":"text","text":", you can call "},{"type":"codeVoice","code":"getIntegerValue()"},{"type":"text","text":" directly."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let possibleValue = obj.getIntegerValue?()","print(possibleValue)","\/\/ Prints \"Optional(100)\"","","let certainValue = obj.getIntegerValue()","print(certainValue)","\/\/ Prints \"100\""]},{"inlineContent":[{"type":"text","text":"If the dynamic type of "},{"type":"codeVoice","code":"obj"},{"type":"text","text":" doesn’t implement a "},{"type":"codeVoice","code":"getIntegerValue()"},{"type":"text","text":" "},{"type":"text","text":"method, the system returns a runtime error when you initialize"},{"type":"text","text":" "},{"type":"codeVoice","code":"certainValue"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Alternatively, if you need to test whether "},{"type":"codeVoice","code":"obj.getIntegerValue()"},{"type":"text","text":" exists,"},{"type":"text","text":" "},{"type":"text","text":"use optional binding before calling the method."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if let f = obj.getIntegerValue {","    print(\"The value of 'obj' is \\(f())\")","} else {","    print(\"'obj' does not have a 'getIntegerValue()' method\")","}","\/\/ Prints \"The value of 'obj' is 100\""]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"The protocol to which all classes implicitly conform."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/anyobject"]}],"seeAlsoSections":[{"anchor":"Existential-Types","title":"Existential Types","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyClass"]}],"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/AnyClass":{"url":"\/documentation\/swift\/anyclass","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyClass","abstract":[{"type":"text","text":"The protocol to which all class types implicitly conform."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AnyClass"}],"title":"AnyClass","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyClass"}]},"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"url":"\/documentation\/swift","abstract":[{"text":"Browse the essential types provided by Swift’s standard library.","type":"text"}],"type":"topic","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/AnyObject":{"url":"\/documentation\/swift\/anyobject","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyObject","abstract":[{"type":"text","text":"The protocol to which all classes implicitly conform."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AnyObject"}],"title":"AnyObject","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyObject"}]}}}