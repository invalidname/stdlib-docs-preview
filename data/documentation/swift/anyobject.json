{"abstract":[{"type":"text","text":"The protocol to which all classes implicitly conform."}],"kind":"symbol","sections":[],"metadata":{"modules":[{"name":"Standard Library"}],"roleHeading":"Type Alias","title":"AnyObject","navigatorTitle":[{"text":"AnyObject","kind":"identifier"}],"externalID":"s:s9AnyObjecta","role":"symbol","platforms":[{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"8.0","name":"iOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"8.0","name":"iPadOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"13.0","name":"Mac Catalyst"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"10.10","name":"macOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"9.0","name":"tvOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"1.0","name":"visionOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"2.0","name":"watchOS"}],"symbolKind":"typealias","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyObject","kind":"identifier"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"generated":true,"title":"Existential Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyClass"],"anchor":"Existential-Types"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyObject","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/anyobject"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyObject","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"You use "},{"code":"AnyObject","type":"codeVoice"},{"type":"text","text":" when you need the flexibility of an untyped object or"},{"text":" ","type":"text"},{"type":"text","text":"when you use bridged Objective-C methods and properties that return an"},{"text":" ","type":"text"},{"type":"text","text":"untyped result. "},{"code":"AnyObject","type":"codeVoice"},{"type":"text","text":" can be used as the concrete type for an"},{"text":" ","type":"text"},{"text":"instance of any class, class type, or class-only protocol. For example:","type":"text"}]},{"code":["class FloatRef {","    let value: Float","    init(_ value: Float) {","        self.value = value","    }","}","","let x = FloatRef(2.3)","let y: AnyObject = x","let z: AnyObject = FloatRef.self"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"AnyObject","type":"codeVoice"},{"text":" can also be used as the concrete type for an instance of a type","type":"text"},{"text":" ","type":"text"},{"text":"that bridges to an Objective-C class. Many value types in Swift bridge to","type":"text"},{"text":" ","type":"text"},{"text":"Objective-C counterparts, like ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let s: AnyObject = \"This is a bridged string.\" as NSString","print(s is NSString)","\/\/ Prints \"true\"","","let v: AnyObject = 100 as NSNumber","print(type(of: v))","\/\/ Prints \"__NSCFNumber\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The flexible behavior of the "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" protocol is similar to"},{"type":"text","text":" "},{"text":"Objective-C’s ","type":"text"},{"type":"codeVoice","code":"id"},{"type":"text","text":" type. For this reason, imported Objective-C types"},{"text":" ","type":"text"},{"type":"text","text":"frequently use "},{"code":"AnyObject","type":"codeVoice"},{"type":"text","text":" as the type for properties, method parameters,"},{"text":" ","type":"text"},{"type":"text","text":"and return values."}]},{"text":"Casting AnyObject Instances to a Known Type","type":"heading","anchor":"Casting-AnyObject-Instances-to-a-Known-Type","level":1},{"inlineContent":[{"text":"Objects with a concrete type of ","type":"text"},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" maintain a specific dynamic"},{"text":" ","type":"text"},{"text":"type and can be cast to that type using one of the type-cast operators","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"as"},{"type":"text","text":", "},{"type":"codeVoice","code":"as?"},{"type":"text","text":", or "},{"code":"as!","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"text":"This example uses the conditional downcast operator (","type":"text"},{"code":"as?","type":"codeVoice"},{"text":") to","type":"text"},{"text":" ","type":"text"},{"text":"conditionally cast the ","type":"text"},{"code":"s","type":"codeVoice"},{"text":" constant declared above to an instance of","type":"text"},{"text":" ","type":"text"},{"text":"Swift’s ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" type.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if let message = s as? String {","    print(\"Successful cast to String: \\(message)\")","}","\/\/ Prints \"Successful cast to String: This is a bridged string.\""]},{"inlineContent":[{"text":"If you have prior knowledge that an ","type":"text"},{"type":"codeVoice","code":"AnyObject"},{"text":" instance has a particular","type":"text"},{"text":" ","type":"text"},{"text":"type, you can use the unconditional downcast operator (","type":"text"},{"code":"as!","type":"codeVoice"},{"text":"). Performing","type":"text"},{"text":" ","type":"text"},{"text":"an invalid cast triggers a runtime error.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let message = s as! String","print(\"Successful cast to String: \\(message)\")","\/\/ Prints \"Successful cast to String: This is a bridged string.\"","","let badCase = v as! String","\/\/ Runtime error"]},{"inlineContent":[{"text":"Casting is always safe in the context of a ","type":"text"},{"type":"codeVoice","code":"switch"},{"text":" statement.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let mixedArray: [AnyObject] = [s, v]","for object in mixedArray {","    switch object {","    case let x as String:","        print(\"'\\(x)' is a String\")","    default:","        print(\"'\\(object)' is not a String\")","    }","}","\/\/ Prints \"'This is a bridged string.' is a String\"","\/\/ Prints \"'100' is not a String\""],"type":"codeListing"},{"text":"Accessing Objective-C Methods and Properties","type":"heading","anchor":"Accessing-Objective-C-Methods-and-Properties","level":1},{"inlineContent":[{"text":"When you use ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":" as a concrete type, you have at your disposal","type":"text"},{"text":" ","type":"text"},{"text":"every ","type":"text"},{"code":"@objc","type":"codeVoice"},{"text":" method and property—that is, methods and properties","type":"text"},{"text":" ","type":"text"},{"text":"imported from Objective-C or marked with the ","type":"text"},{"code":"@objc","type":"codeVoice"},{"text":" attribute. Because","type":"text"},{"text":" ","type":"text"},{"text":"Swift can’t guarantee at compile time that these methods and properties","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"are actually available on an "},{"code":"AnyObject","type":"codeVoice"},{"text":" instance’s underlying type, these","type":"text"},{"text":" ","type":"text"},{"code":"@objc","type":"codeVoice"},{"text":" symbols are available as implicitly unwrapped optional methods and","type":"text"},{"text":" ","type":"text"},{"text":"properties, respectively.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This example defines an ","type":"text"},{"code":"IntegerRef","type":"codeVoice"},{"text":" type with an ","type":"text"},{"code":"@objc","type":"codeVoice"},{"text":" method named","type":"text"},{"text":" ","type":"text"},{"code":"getIntegerValue()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["class IntegerRef {","    let value: Int","    init(_ value: Int) {","        self.value = value","    }","","    @objc func getIntegerValue() -> Int {","        return value","    }","}","","func getObject() -> AnyObject {","    return IntegerRef(100)","}","","let obj: AnyObject = getObject()"],"type":"codeListing"},{"inlineContent":[{"text":"In the example, ","type":"text"},{"type":"codeVoice","code":"obj"},{"text":" has a static type of ","type":"text"},{"type":"codeVoice","code":"AnyObject"},{"text":" and a dynamic type","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"type":"codeVoice","code":"IntegerRef"},{"text":". You can use optional chaining to call the ","type":"text"},{"type":"codeVoice","code":"@objc"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"getIntegerValue()"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"obj"},{"text":" safely. If you’re sure of the dynamic type of","type":"text"},{"text":" ","type":"text"},{"code":"obj","type":"codeVoice"},{"text":", you can call ","type":"text"},{"type":"codeVoice","code":"getIntegerValue()"},{"text":" directly.","type":"text"}],"type":"paragraph"},{"code":["let possibleValue = obj.getIntegerValue?()","print(possibleValue)","\/\/ Prints \"Optional(100)\"","","let certainValue = obj.getIntegerValue()","print(certainValue)","\/\/ Prints \"100\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"If the dynamic type of ","type":"text"},{"code":"obj","type":"codeVoice"},{"text":" doesn’t implement a ","type":"text"},{"type":"codeVoice","code":"getIntegerValue()"},{"text":" ","type":"text"},{"text":"method, the system returns a runtime error when you initialize","type":"text"},{"text":" ","type":"text"},{"code":"certainValue","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Alternatively, if you need to test whether ","type":"text"},{"code":"obj.getIntegerValue()","type":"codeVoice"},{"type":"text","text":" exists,"},{"type":"text","text":" "},{"text":"use optional binding before calling the method.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["if let f = obj.getIntegerValue {","    print(\"The value of 'obj' is \\(f())\")","} else {","    print(\"'obj' does not have a 'getIntegerValue()' method\")","}","\/\/ Prints \"The value of 'obj' is 100\""],"type":"codeListing"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/AnyObject":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyObject","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AnyObject"}],"title":"AnyObject","kind":"symbol","abstract":[{"type":"text","text":"The protocol to which all classes implicitly conform."}],"role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"text":"AnyObject","kind":"identifier"}],"url":"\/documentation\/swift\/anyobject"},"doc://com.apple.Swift/documentation/Swift/AnyClass":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyClass","type":"topic","navigatorTitle":[{"text":"AnyClass","kind":"identifier"}],"title":"AnyClass","kind":"symbol","abstract":[{"text":"The protocol to which all class types implicitly conform.","type":"text"}],"role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyClass","kind":"identifier"}],"url":"\/documentation\/swift\/anyclass"},"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","url":"\/documentation\/swift","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"title":"Standard Library","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"role":"collection"}}}