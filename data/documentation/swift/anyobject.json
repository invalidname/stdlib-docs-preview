{"abstract":[{"text":"The protocol to which all classes implicitly conform.","type":"text"}],"seeAlsoSections":[{"title":"Existential Types","anchor":"Existential-Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyClass"],"generated":true}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"sections":[],"metadata":{"externalID":"s:s9AnyObjecta","title":"AnyObject","platforms":[{"beta":false,"name":"iOS","deprecated":false,"introducedAt":"8.0","unavailable":false},{"beta":false,"name":"iPadOS","deprecated":false,"introducedAt":"8.0","unavailable":false},{"beta":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"13.0","unavailable":false},{"beta":false,"name":"macOS","deprecated":false,"introducedAt":"10.10","unavailable":false},{"beta":false,"name":"tvOS","deprecated":false,"introducedAt":"9.0","unavailable":false},{"beta":false,"name":"visionOS","deprecated":false,"introducedAt":"1.0","unavailable":false},{"beta":false,"name":"watchOS","deprecated":false,"introducedAt":"2.0","unavailable":false}],"role":"symbol","modules":[{"name":"Swift"}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyObject","kind":"identifier"}],"symbolKind":"typealias","navigatorTitle":[{"text":"AnyObject","kind":"identifier"}],"roleHeading":"Type Alias"},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyObject","kind":"identifier"}]}]},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"You use "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" when you need the flexibility of an untyped object or"},{"type":"text","text":" "},{"type":"text","text":"when you use bridged Objective-C methods and properties that return an"},{"type":"text","text":" "},{"type":"text","text":"untyped result. "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" can be used as the concrete type for an"},{"type":"text","text":" "},{"type":"text","text":"instance of any class, class type, or class-only protocol. For example:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class FloatRef {","    let value: Float","    init(_ value: Float) {","        self.value = value","    }","}","","let x = FloatRef(2.3)","let y: AnyObject = x","let z: AnyObject = FloatRef.self"]},{"inlineContent":[{"type":"codeVoice","code":"AnyObject"},{"text":" can also be used as the concrete type for an instance of a type","type":"text"},{"type":"text","text":" "},{"type":"text","text":"that bridges to an Objective-C class. Many value types in Swift bridge to"},{"type":"text","text":" "},{"type":"text","text":"Objective-C counterparts, like "},{"type":"codeVoice","code":"String"},{"text":" and ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let s: AnyObject = \"This is a bridged string.\" as NSString","print(s is NSString)","\/\/ Prints \"true\"","","let v: AnyObject = 100 as NSNumber","print(type(of: v))","\/\/ Prints \"__NSCFNumber\""]},{"inlineContent":[{"text":"The flexible behavior of the ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":" protocol is similar to","type":"text"},{"text":" ","type":"text"},{"text":"Objective-C’s ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" type. For this reason, imported Objective-C types","type":"text"},{"text":" ","type":"text"},{"text":"frequently use ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":" as the type for properties, method parameters,","type":"text"},{"text":" ","type":"text"},{"text":"and return values.","type":"text"}],"type":"paragraph"},{"anchor":"Casting-AnyObject-Instances-to-a-Known-Type","level":1,"type":"heading","text":"Casting AnyObject Instances to a Known Type"},{"inlineContent":[{"text":"Objects with a concrete type of ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":" maintain a specific dynamic","type":"text"},{"text":" ","type":"text"},{"text":"type and can be cast to that type using one of the type-cast operators","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"as","type":"codeVoice"},{"text":", ","type":"text"},{"code":"as?","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"as!","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This example uses the conditional downcast operator (","type":"text"},{"code":"as?","type":"codeVoice"},{"text":") to","type":"text"},{"text":" ","type":"text"},{"text":"conditionally cast the ","type":"text"},{"code":"s","type":"codeVoice"},{"text":" constant declared above to an instance of","type":"text"},{"text":" ","type":"text"},{"text":"Swift’s ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" type.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if let message = s as? String {","    print(\"Successful cast to String: \\(message)\")","}","\/\/ Prints \"Successful cast to String: This is a bridged string.\""]},{"inlineContent":[{"type":"text","text":"If you have prior knowledge that an "},{"code":"AnyObject","type":"codeVoice"},{"type":"text","text":" instance has a particular"},{"type":"text","text":" "},{"type":"text","text":"type, you can use the unconditional downcast operator ("},{"code":"as!","type":"codeVoice"},{"type":"text","text":"). Performing"},{"type":"text","text":" "},{"type":"text","text":"an invalid cast triggers a runtime error."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let message = s as! String","print(\"Successful cast to String: \\(message)\")","\/\/ Prints \"Successful cast to String: This is a bridged string.\"","","let badCase = v as! String","\/\/ Runtime error"]},{"inlineContent":[{"type":"text","text":"Casting is always safe in the context of a "},{"code":"switch","type":"codeVoice"},{"type":"text","text":" statement."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let mixedArray: [AnyObject] = [s, v]","for object in mixedArray {","    switch object {","    case let x as String:","        print(\"'\\(x)' is a String\")","    default:","        print(\"'\\(object)' is not a String\")","    }","}","\/\/ Prints \"'This is a bridged string.' is a String\"","\/\/ Prints \"'100' is not a String\""]},{"anchor":"Accessing-Objective-C-Methods-and-Properties","level":1,"type":"heading","text":"Accessing Objective-C Methods and Properties"},{"inlineContent":[{"type":"text","text":"When you use "},{"code":"AnyObject","type":"codeVoice"},{"type":"text","text":" as a concrete type, you have at your disposal"},{"type":"text","text":" "},{"type":"text","text":"every "},{"code":"@objc","type":"codeVoice"},{"type":"text","text":" method and property—that is, methods and properties"},{"type":"text","text":" "},{"type":"text","text":"imported from Objective-C or marked with the "},{"code":"@objc","type":"codeVoice"},{"type":"text","text":" attribute. Because"},{"type":"text","text":" "},{"type":"text","text":"Swift can’t guarantee at compile time that these methods and properties"},{"type":"text","text":" "},{"type":"text","text":"are actually available on an "},{"code":"AnyObject","type":"codeVoice"},{"type":"text","text":" instance’s underlying type, these"},{"type":"text","text":" "},{"code":"@objc","type":"codeVoice"},{"type":"text","text":" symbols are available as implicitly unwrapped optional methods and"},{"type":"text","text":" "},{"type":"text","text":"properties, respectively."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This example defines an "},{"code":"IntegerRef","type":"codeVoice"},{"type":"text","text":" type with an "},{"code":"@objc","type":"codeVoice"},{"type":"text","text":" method named"},{"type":"text","text":" "},{"code":"getIntegerValue()","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class IntegerRef {","    let value: Int","    init(_ value: Int) {","        self.value = value","    }","","    @objc func getIntegerValue() -> Int {","        return value","    }","}","","func getObject() -> AnyObject {","    return IntegerRef(100)","}","","let obj: AnyObject = getObject()"]},{"inlineContent":[{"text":"In the example, ","type":"text"},{"code":"obj","type":"codeVoice"},{"text":" has a static type of ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":" and a dynamic type","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"IntegerRef","type":"codeVoice"},{"text":". You can use optional chaining to call the ","type":"text"},{"code":"@objc","type":"codeVoice"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"code":"getIntegerValue()","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"obj","type":"codeVoice"},{"text":" safely. If you’re sure of the dynamic type of","type":"text"},{"text":" ","type":"text"},{"code":"obj","type":"codeVoice"},{"text":", you can call ","type":"text"},{"code":"getIntegerValue()","type":"codeVoice"},{"text":" directly.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let possibleValue = obj.getIntegerValue?()","print(possibleValue)","\/\/ Prints \"Optional(100)\"","","let certainValue = obj.getIntegerValue()","print(certainValue)","\/\/ Prints \"100\""]},{"inlineContent":[{"text":"If the dynamic type of ","type":"text"},{"code":"obj","type":"codeVoice"},{"text":" doesn’t implement a ","type":"text"},{"code":"getIntegerValue()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"method, the system returns a runtime error when you initialize","type":"text"},{"text":" ","type":"text"},{"code":"certainValue","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Alternatively, if you need to test whether ","type":"text"},{"code":"obj.getIntegerValue()","type":"codeVoice"},{"text":" exists,","type":"text"},{"text":" ","type":"text"},{"text":"use optional binding before calling the method.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if let f = obj.getIntegerValue {","    print(\"The value of 'obj' is \\(f())\")","} else {","    print(\"'obj' does not have a 'getIntegerValue()' method\")","}","\/\/ Prints \"The value of 'obj' is 100\""]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/anyobject"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyObject","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift/AnyClass":{"fragments":[{"text":"typealias","kind":"keyword"},{"kind":"text","text":" "},{"text":"AnyClass","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyClass","title":"AnyClass","url":"\/documentation\/swift\/anyclass","kind":"symbol","role":"symbol","type":"topic","abstract":[{"text":"The protocol to which all class types implicitly conform.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AnyClass"}]},"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","type":"topic","role":"collection","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","title":"Swift","kind":"symbol","images":[{"identifier":"Swift-PageImage-card.png","type":"card"}]},"doc://com.apple.Swift/documentation/Swift/AnyObject":{"type":"topic","abstract":[{"type":"text","text":"The protocol to which all classes implicitly conform."}],"kind":"symbol","role":"symbol","title":"AnyObject","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyObject","kind":"identifier"}],"navigatorTitle":[{"text":"AnyObject","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyObject","url":"\/documentation\/swift\/anyobject"},"Swift-PageImage-card.png":{"identifier":"Swift-PageImage-card.png","type":"image","variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png","traits":["2x","dark"]}],"alt":"An orange Swift logo on a gradient background."}}}