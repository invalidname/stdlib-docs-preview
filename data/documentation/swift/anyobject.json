{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"abstract":[{"type":"text","text":"The protocol to which all classes implicitly conform."}],"seeAlsoSections":[{"generated":true,"title":"Existential Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyClass"],"anchor":"Existential-Types"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyObject","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"You use ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":" when you need the flexibility of an untyped object or","type":"text"},{"text":" ","type":"text"},{"text":"when you use bridged Objective-C methods and properties that return an","type":"text"},{"text":" ","type":"text"},{"text":"untyped result. ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":" can be used as the concrete type for an","type":"text"},{"text":" ","type":"text"},{"text":"instance of any class, class type, or class-only protocol. For example:","type":"text"}]},{"code":["class FloatRef {","    let value: Float","    init(_ value: Float) {","        self.value = value","    }","}","","let x = FloatRef(2.3)","let y: AnyObject = x","let z: AnyObject = FloatRef.self"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"AnyObject","type":"codeVoice"},{"text":" can also be used as the concrete type for an instance of a type","type":"text"},{"text":" ","type":"text"},{"text":"that bridges to an Objective-C class. Many value types in Swift bridge to","type":"text"},{"text":" ","type":"text"},{"text":"Objective-C counterparts, like ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["let s: AnyObject = \"This is a bridged string.\" as NSString","print(s is NSString)","\/\/ Prints \"true\"","","let v: AnyObject = 100 as NSNumber","print(type(of: v))","\/\/ Prints \"__NSCFNumber\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The flexible behavior of the ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":" protocol is similar to","type":"text"},{"text":" ","type":"text"},{"text":"Objective-C’s ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" type. For this reason, imported Objective-C types","type":"text"},{"text":" ","type":"text"},{"text":"frequently use ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":" as the type for properties, method parameters,","type":"text"},{"text":" ","type":"text"},{"text":"and return values.","type":"text"}]},{"level":1,"anchor":"Casting-AnyObject-Instances-to-a-Known-Type","type":"heading","text":"Casting AnyObject Instances to a Known Type"},{"type":"paragraph","inlineContent":[{"text":"Objects with a concrete type of ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":" maintain a specific dynamic","type":"text"},{"text":" ","type":"text"},{"text":"type and can be cast to that type using one of the type-cast operators","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"("},{"type":"codeVoice","code":"as"},{"type":"text","text":", "},{"type":"codeVoice","code":"as?"},{"type":"text","text":", or "},{"type":"codeVoice","code":"as!"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This example uses the conditional downcast operator ("},{"type":"codeVoice","code":"as?"},{"type":"text","text":") to"},{"type":"text","text":" "},{"type":"text","text":"conditionally cast the "},{"type":"codeVoice","code":"s"},{"type":"text","text":" constant declared above to an instance of"},{"type":"text","text":" "},{"type":"text","text":"Swift’s "},{"type":"codeVoice","code":"String"},{"type":"text","text":" type."}]},{"type":"codeListing","code":["if let message = s as? String {","    print(\"Successful cast to String: \\(message)\")","}","\/\/ Prints \"Successful cast to String: This is a bridged string.\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have prior knowledge that an "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" instance has a particular"},{"type":"text","text":" "},{"type":"text","text":"type, you can use the unconditional downcast operator ("},{"type":"codeVoice","code":"as!"},{"type":"text","text":"). Performing"},{"type":"text","text":" "},{"type":"text","text":"an invalid cast triggers a runtime error."}]},{"type":"codeListing","code":["let message = s as! String","print(\"Successful cast to String: \\(message)\")","\/\/ Prints \"Successful cast to String: This is a bridged string.\"","","let badCase = v as! String","\/\/ Runtime error"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Casting is always safe in the context of a "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" statement."}],"type":"paragraph"},{"type":"codeListing","code":["let mixedArray: [AnyObject] = [s, v]","for object in mixedArray {","    switch object {","    case let x as String:","        print(\"'\\(x)' is a String\")","    default:","        print(\"'\\(object)' is not a String\")","    }","}","\/\/ Prints \"'This is a bridged string.' is a String\"","\/\/ Prints \"'100' is not a String\""],"syntax":"swift"},{"level":1,"type":"heading","text":"Accessing Objective-C Methods and Properties","anchor":"Accessing-Objective-C-Methods-and-Properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you use "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" as a concrete type, you have at your disposal"},{"type":"text","text":" "},{"type":"text","text":"every "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" method and property—that is, methods and properties"},{"type":"text","text":" "},{"type":"text","text":"imported from Objective-C or marked with the "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" attribute. Because"},{"type":"text","text":" "},{"type":"text","text":"Swift can’t guarantee at compile time that these methods and properties"},{"type":"text","text":" "},{"type":"text","text":"are actually available on an "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" instance’s underlying type, these"},{"type":"text","text":" "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" symbols are available as implicitly unwrapped optional methods and"},{"type":"text","text":" "},{"type":"text","text":"properties, respectively."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This example defines an "},{"type":"codeVoice","code":"IntegerRef"},{"type":"text","text":" type with an "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" method named"},{"type":"text","text":" "},{"type":"codeVoice","code":"getIntegerValue()"},{"type":"text","text":"."}]},{"type":"codeListing","code":["class IntegerRef {","    let value: Int","    init(_ value: Int) {","        self.value = value","    }","","    @objc func getIntegerValue() -> Int {","        return value","    }","}","","func getObject() -> AnyObject {","    return IntegerRef(100)","}","","let obj: AnyObject = getObject()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the example, "},{"type":"codeVoice","code":"obj"},{"type":"text","text":" has a static type of "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" and a dynamic type"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"IntegerRef"},{"type":"text","text":". You can use optional chaining to call the "},{"code":"@objc","type":"codeVoice"},{"type":"text","text":" method"},{"type":"text","text":" "},{"code":"getIntegerValue()","type":"codeVoice"},{"type":"text","text":" on "},{"code":"obj","type":"codeVoice"},{"type":"text","text":" safely. If you’re sure of the dynamic type of"},{"type":"text","text":" "},{"type":"codeVoice","code":"obj"},{"type":"text","text":", you can call "},{"code":"getIntegerValue()","type":"codeVoice"},{"type":"text","text":" directly."}]},{"type":"codeListing","syntax":"swift","code":["let possibleValue = obj.getIntegerValue?()","print(possibleValue)","\/\/ Prints \"Optional(100)\"","","let certainValue = obj.getIntegerValue()","print(certainValue)","\/\/ Prints \"100\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the dynamic type of "},{"code":"obj","type":"codeVoice"},{"type":"text","text":" doesn’t implement a "},{"code":"getIntegerValue()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"method, the system returns a runtime error when you initialize"},{"type":"text","text":" "},{"code":"certainValue","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alternatively, if you need to test whether "},{"code":"obj.getIntegerValue()","type":"codeVoice"},{"type":"text","text":" exists,"},{"type":"text","text":" "},{"type":"text","text":"use optional binding before calling the method."}]},{"type":"codeListing","syntax":"swift","code":["if let f = obj.getIntegerValue {","    print(\"The value of 'obj' is \\(f())\")","} else {","    print(\"'obj' does not have a 'getIntegerValue()' method\")","}","\/\/ Prints \"The value of 'obj' is 100\""]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyObject"},"variants":[{"paths":["\/documentation\/swift\/anyobject"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Type Alias","navigatorTitle":[{"kind":"identifier","text":"AnyObject"}],"externalID":"s:s9A