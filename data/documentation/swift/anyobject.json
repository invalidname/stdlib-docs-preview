{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/anyobject"]}],"kind":"symbol","metadata":{"symbolKind":"typealias","title":"AnyObject","navigatorTitle":[{"text":"AnyObject","kind":"identifier"}],"platforms":[{"unavailable":false,"introducedAt":"8.0","deprecated":false,"name":"iOS","beta":false},{"unavailable":false,"introducedAt":"8.0","deprecated":false,"name":"iPadOS","beta":false},{"unavailable":false,"introducedAt":"13.0","deprecated":false,"name":"Mac Catalyst","beta":false},{"unavailable":false,"introducedAt":"10.10","name":"macOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"9.0","deprecated":false,"name":"tvOS","beta":false},{"unavailable":false,"introducedAt":"1.0","deprecated":false,"name":"visionOS","beta":false},{"unavailable":false,"introducedAt":"2.0","deprecated":false,"name":"watchOS","beta":false}],"externalID":"s:s9AnyObjecta","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"text":" ","kind":"text"},{"text":"AnyObject","kind":"identifier"}],"modules":[{"name":"Standard Library"}],"roleHeading":"Type Alias"},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyObject","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"The protocol to which all classes implicitly conform.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyClass"],"title":"Existential Types","generated":true,"anchor":"Existential-Types"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyObject"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"You use ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":" when you need the flexibility of an untyped object or","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"when you use bridged Objective-C methods and properties that return an"},{"type":"text","text":" "},{"type":"text","text":"untyped result. "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" can be used as the concrete type for an"},{"type":"text","text":" "},{"type":"text","text":"instance of any class, class type, or class-only protocol. For example:"}]},{"type":"codeListing","syntax":"swift","code":["class FloatRef {","    let value: Float","    init(_ value: Float) {","        self.value = value","    }","}","","let x = FloatRef(2.3)","let y: AnyObject = x","let z: AnyObject = FloatRef.self"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" can also be used as the concrete type for an instance of a type"},{"type":"text","text":" "},{"type":"text","text":"that bridges to an Objective-C class. Many value types in Swift bridge to"},{"type":"text","text":" "},{"type":"text","text":"Objective-C counterparts, like "},{"type":"codeVoice","code":"String"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Int"},{"text":".","type":"text"}]},{"code":["let s: AnyObject = \"This is a bridged string.\" as NSString","print(s is NSString)","\/\/ Prints \"true\"","","let v: AnyObject = 100 as NSNumber","print(type(of: v))","\/\/ Prints \"__NSCFNumber\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The flexible behavior of the ","type":"text"},{"type":"codeVoice","code":"AnyObject"},{"text":" protocol is similar to","type":"text"},{"text":" ","type":"text"},{"text":"Objective-C’s ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" type. For this reason, imported Objective-C types","type":"text"},{"text":" ","type":"text"},{"text":"frequently use ","type":"text"},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" as the type for properties, method parameters,"},{"type":"text","text":" "},{"type":"text","text":"and return values."}],"type":"paragraph"},{"level":1,"type":"heading","anchor":"Casting-AnyObject-Instances-to-a-Known-Type","text":"Casting AnyObject Instances to a Known Type"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Objects with a concrete type of "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" maintain a specific dynamic"},{"type":"text","text":" "},{"type":"text","text":"type and can be cast to that type using one of the type-cast operators"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"as"},{"type":"text","text":", "},{"type":"codeVoice","code":"as?"},{"type":"text","text":", or "},{"type":"codeVoice","code":"as!"},{"type":"text","text":")."}]},{"inlineContent":[{"type":"text","text":"This example uses the conditional downcast operator ("},{"type":"codeVoice","code":"as?"},{"text":") to","type":"text"},{"text":" ","type":"text"},{"text":"conditionally cast the ","type":"text"},{"code":"s","type":"codeVoice"},{"text":" constant declared above to an instance of","type":"text"},{"text":" ","type":"text"},{"text":"Swift’s ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" type.","type":"text"}],"type":"paragraph"},{"code":["if let message = s as? String {","    print(\"Successful cast to String: \\(message)\")","}","\/\/ Prints \"Successful cast to String: This is a bridged string.\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"If you have prior knowledge that an ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":" instance has a particular","type":"text"},{"text":" ","type":"text"},{"text":"type, you can use the unconditional downcast operator (","type":"text"},{"type":"codeVoice","code":"as!"},{"type":"text","text":"). Performing"},{"text":" ","type":"text"},{"text":"an invalid cast triggers a runtime error.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let message = s as! String","print(\"Successful cast to String: \\(message)\")","\/\/ Prints \"Successful cast to String: This is a bridged string.\"","","let badCase = v as! String","\/\/ Runtime error"],"type":"codeListing"},{"inlineContent":[{"text":"Casting is always safe in the context of a ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" statement.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let mixedArray: [AnyObject] = [s, v]","for object in mixedArray {","    switch object {","    case let x as String:","        print(\"'\\(x)' is a String\")","    default:","        print(\"'\\(object)' is not a String\")","    }","}","\/\/ Prints \"'This is a bridged string.' is a String\"","\/\/ Prints \"'100' is not a String\""],"type":"codeListing"},{"type":"heading","text":"Accessing Objective-C Methods and Properties","level":1,"anchor":"Accessing-Objective-C-Methods-and-Properties"},{"inlineContent":[{"text":"When you use ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":" as a concrete type, you have at your disposal","type":"text"},{"text":" ","type":"text"},{"text":"every ","type":"text"},{"code":"@objc","type":"codeVoice"},{"type":"text","text":" method and property—that is, methods and properties"},{"type":"text","text":" "},{"text":"imported from Objective-C or marked with the ","type":"text"},{"code":"@objc","type":"codeVoice"},{"text":" attribute. Because","type":"text"},{"text":" ","type":"text"},{"text":"Swift can’t guarantee at compile time that these methods and properties","type":"text"},{"text":" ","type":"text"},{"text":"are actually available on an ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":" instance’s underlying type, these","type":"text"},{"text":" ","type":"text"},{"code":"@objc","type":"codeVoice"},{"text":" symbols are available as implicitly unwrapped optional methods and","type":"text"},{"text":" ","type":"text"},{"text":"properties, respectively.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This example defines an ","type":"text"},{"code":"IntegerRef","type":"codeVoice"},{"type":"text","text":" type with an "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" method named"},{"type":"text","text":" "},{"type":"codeVoice","code":"getIntegerValue()"},{"text":".","type":"text"}]},{"code":["class IntegerRef {","    let value: Int","    init(_ value: Int) {","        self.value = value","    }","","    @objc func getIntegerValue() -> Int {","        return value","    }","}","","func getObject() -> AnyObject {","    return IntegerRef(100)","}","","let obj: AnyObject = getObject()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the example, "},{"type":"codeVoice","code":"obj"},{"type":"text","text":" has a static type of "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" and a dynamic type"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"IntegerRef"},{"type":"text","text":". You can use optional chaining to call the "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"codeVoice","code":"getIntegerValue()"},{"type":"text","text":" on "},{"type":"codeVoice","code":"obj"},{"type":"text","text":" safely. If you’re sure of the dynamic type of"},{"type":"text","text":" "},{"type":"codeVoice","code":"obj"},{"type":"text","text":", you can call "},{"type":"codeVoice","code":"getIntegerValue()"},{"type":"text","text":" directly."}]},{"type":"codeListing","code":["let possibleValue = obj.getIntegerValue?()","print(possibleValue)","\/\/ Prints \"Optional(100)\"","","let certainValue = obj.getIntegerValue()","print(certainValue)","\/\/ Prints \"100\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"If the dynamic type of "},{"type":"codeVoice","code":"obj"},{"type":"text","text":" doesn’t implement a "},{"type":"codeVoice","code":"getIntegerValue()"},{"type":"text","text":" "},{"type":"text","text":"method, the system returns a runtime error when you initialize"},{"type":"text","text":" "},{"type":"codeVoice","code":"certainValue"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Alternatively, if you need to test whether ","type":"text"},{"code":"obj.getIntegerValue()","type":"codeVoice"},{"text":" exists,","type":"text"},{"text":" ","type":"text"},{"text":"use optional binding before calling the method.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["if let f = obj.getIntegerValue {","    print(\"The value of 'obj' is \\(f())\")","} else {","    print(\"'obj' does not have a 'getIntegerValue()' method\")","}","\/\/ Prints \"The value of 'obj' is 100\""],"type":"codeListing"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/AnyObject":{"role":"symbol","title":"AnyObject","navigatorTitle":[{"text":"AnyObject","kind":"identifier"}],"type":"topic","url":"\/documentation\/swift\/anyobject","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyObject","abstract":[{"type":"text","text":"The protocol to which all classes implicitly conform."}],"kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyObject","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/AnyClass":{"url":"\/documentation\/swift\/anyclass","type":"topic","navigatorTitle":[{"text":"AnyClass","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The protocol to which all class types implicitly conform."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyClass","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyClass","kind":"identifier"}],"role":"symbol","title":"AnyClass"}}}