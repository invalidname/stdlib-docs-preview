ragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enumerated"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18EnumeratedSequenceV","text":"EnumeratedSequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AnyRegexOutput\/enumerated()"},"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","url":"\/documentation\/swift","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"title":"Standard Library","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"role":"collection"}}}