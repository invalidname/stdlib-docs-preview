{"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Swift macros help you avoid writing repetitive code in Swift","type":"text"},{"text":" ","type":"text"},{"text":"by generating that part of your source code at compile time.","type":"text"},{"text":" ","type":"text"},{"text":"Calling a macro is always additive:","type":"text"},{"text":" ","type":"text"},{"text":"The macro adds new code alongside the code that you wrote,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"but never modifies or deletes code that’s already part of your project."}]},{"inlineContent":[{"type":"text","text":"Many libraries provide macros,"},{"type":"text","text":" "},{"type":"text","text":"including the Swift standard library and many frameworks."},{"type":"text","text":" "},{"type":"text","text":"You can also write your own macros."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because macros generate Swift code,"},{"type":"text","text":" "},{"type":"text","text":"you use the same tools for development and debugging,"},{"type":"text","text":" "},{"type":"text","text":"regardless of whether your code uses macros."}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"macro-expansion"}],"type":"paragraph"},{"level":3,"anchor":"Call-a-Macro","text":"Call a Macro","type":"heading"},{"inlineContent":[{"type":"text","text":"The syntax you use to call a macro varies slightly,"},{"type":"text","text":" "},{"type":"text","text":"depending on whether you attach the macro to a declaration."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To attach a macro to a declaration,"},{"type":"text","text":" "},{"type":"text","text":"write an at sign ("},{"type":"codeVoice","code":"@"},{"type":"text","text":") before the macro’s name"},{"type":"text","text":" "},{"type":"text","text":"and write any macro arguments after its name."},{"type":"text","text":" "},{"type":"text","text":"This syntax is the same as writing an attribute."},{"text":" ","type":"text"},{"text":"For example:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Observable","public final class MyObject {","    public var someProperty: String = \"\"","    public var someOtherProperty: Int = 0","    fileprivate var somePrivateProperty: Int = 1","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A macro that’s attached to a declaration"},{"type":"text","text":" "},{"type":"text","text":"generates code"},{"type":"text","text":" "},{"type":"text","text":"and adds that code to the declaration."},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","type":"reference","isActive":true},{"type":"text","text":" macro in the code above"},{"type":"text","text":" "},{"type":"text","text":"adds additional members to the "},{"code":"MyObject","type":"codeVoice"},{"type":"text","text":" class"},{"type":"text","text":" "},{"type":"text","text":"so it implements the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable","isActive":true},{"type":"text","text":" protocol,"},{"type":"text","text":" "},{"type":"text","text":"and marks "},{"code":"MyObject","type":"codeVoice"},{"type":"text","text":" as conforming to "},{"code":"Observable","type":"codeVoice"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"To call a macro without attaching it to a declaration,"},{"type":"text","text":" "},{"type":"text","text":"write a number sign ("},{"code":"#","type":"codeVoice"},{"type":"text","text":") before the macro’s name"},{"type":"text","text":" "},{"type":"text","text":"and write any macro arguments after its name."},{"type":"text","text":" "},{"type":"text","text":"This syntax is the same as "},{"code":"#if","type":"codeVoice"},{"type":"text","text":" and other compile-time operations."},{"type":"text","text":" "},{"type":"text","text":"For example:"}],"type":"paragraph"},{"code":["let messagePredicate = #Predicate<Message> { message in","    message.recipient == \"John Appleseed\"","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A macro that isn’t attached to a declaration","type":"text"},{"text":" ","type":"text"},{"text":"generates code and adds that code","type":"text"},{"text":" ","type":"text"},{"text":"in the location where where you call the macro.","type":"text"},{"text":" ","type":"text"},{"text":"For example,","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"Predicate","type":"codeVoice"},{"text":" macro in the code above creates an instance of the","type":"text"},{"text":" ","type":"text"},{"text":"Swift Foundation ","type":"text"},{"code":"Predicate","type":"codeVoice"},{"text":" structure.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For more information,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros"},{"type":"text","text":" in "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Inspect an Expanded Macro","anchor":"Inspect-an-Expanded-Macro"},{"inlineContent":[{"type":"text","text":"When you build your project,"},{"type":"text","text":" "},{"type":"text","text":"Swift reads your code and finds the places where you call a macro."},{"type":"text","text":" "},{"type":"text","text":"Swift then calls the implementation of each macro,"},{"type":"text","text":" "},{"type":"text","text":"to expand the code."},{"type":"text","text":" "},{"type":"text","text":"Finally, Swift builds your project as usual,"},{"type":"text","text":" "},{"type":"text","text":"including the generated code."}],"type":"paragraph"},{"inlineContent":[{"text":"To view the code that a macro generated,","type":"text"},{"text":" ","type":"text"},{"text":"click on the code where you call the macro in Xcode,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"then choose Editor > Expand Macro."},{"type":"text","text":" "},{"type":"text","text":"You can read the expanded code"},{"type":"text","text":" "},{"type":"text","text":"to help you understand details about the macro’s behavior,"},{"type":"text","text":" "},{"type":"text","text":"and you can use the expanded code"},{"type":"text","text":" "},{"type":"text","text":"to help you debug code that uses macros."},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"you can set breakpoints inside code generated by a macro."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/applying-macros"},"abstract":[{"type":"text","text":"Use macros to generate repetitive code at compile time."}],"metadata":{"roleHeading":"Article","title":"Applying Macros","role":"article","modules":[{"name":"Swift"}]},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","doc:\/\/com.apple.Swift\/documentation\/Swift\/macros"]]},"sections":[],"references":{"Swift-PageImage-card.png":{"identifier":"Swift-PageImage-card.png","type":"image","variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png","traits":["2x","dark"]}],"alt":"An orange Swift logo on a gradient background."},"https://docs.swift.org/swift-book/documentation/the-swift-programming-language":{"titleInlineContent":[{"text":"The Swift Programming Language","type":"text"}],"identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language","url":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language","type":"link","title":"The Swift Programming Language"},"doc://com.apple.Swift/documentation/Observation/Observable()":{"abstract":[{"text":"Defines and implements conformance of the Observable protocol.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Observable"},{"text":"()","kind":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","url":"\/documentation\/observation\/observable()","kind":"symbol","title":"Observable()","type":"topic"},"https://docs.swift.org/swift-book/documentation/the-swift-programming-language/macros":{"url":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","title":"Macros","type":"link","identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","titleInlineContent":[{"text":"Macros","type":"text"}]},"doc://com.apple.Swift/documentation/Observation/Observable":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable","kind":"symbol","abstract":[{"type":"text","text":"A type that emits notifications to observers when underlying data changes."}],"url":"\/documentation\/observation\/observable","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Observable","kind":"identifier"}],"title":"Observable","role":"symbol","navigatorTitle":[{"text":"Observable","kind":"identifier"}],"type":"topic"},"doc://com.apple.Swift/documentation/Swift/swift-standard-library":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","url":"\/documentation\/swift\/swift-standard-library","kind":"article","role":"collectionGroup","type":"topic","title":"Swift Standard Library","abstract":[{"type":"text","text":"Solve complex problems and write high-performance, readable code."}]},"doc://com.apple.Swift/documentation/Swift":{"kind":"symbol","type":"topic","role":"collection","title":"Swift","images":[{"type":"card","identifier":"Swift-PageImage-card.png"}],"abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"macro-expansion":{"variants":[{"url":"\/images\/com.apple.Swift\/macro-expansion@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/macro-expansion~dark@2x.png","traits":["2x","dark"]}],"type":"image","identifier":"macro-expansion","alt":"A diagram showing an overview of macro expansion. On the left, a stylized representation of Swift code. On the right, the same code with several lines added by the macro."},"doc://com.apple.Swift/documentation/Swift/macros":{"kind":"article","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/macros","role":"collectionGroup","url":"\/documentation\/swift\/macros","abstract":[{"text":"Generate boilerplate code and perform other compile-time operations.","type":"text"}],"title":"Macros","type":"topic"}}}