{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/macros"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/applying-macros"]}],"kind":"article","metadata":{"title":"Applying Macros","modules":[{"name":"Standard Library"}],"roleHeading":"Article","role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/applying-macros"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Use macros to generate repetitive code at compile time.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Swift macros help you avoid writing repetitive code in Swift","type":"text"},{"text":" ","type":"text"},{"text":"by generating that part of your source code at compile time.","type":"text"},{"text":" ","type":"text"},{"text":"Calling a macro is always additive:","type":"text"},{"text":" ","type":"text"},{"text":"The macro adds new code alongside the code that you wrote,","type":"text"},{"text":" ","type":"text"},{"text":"but never modifies or deletes code that’s already part of your project.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Many libraries provide macros,"},{"type":"text","text":" "},{"type":"text","text":"including the Swift standard library and many frameworks."},{"type":"text","text":" "},{"type":"text","text":"You can also write your own macros."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because macros generate Swift code,"},{"type":"text","text":" "},{"type":"text","text":"you use the same tools for development and debugging,"},{"type":"text","text":" "},{"type":"text","text":"regardless of whether your code uses macros."}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"macro-expansion"}]},{"level":3,"type":"heading","text":"Call a Macro","anchor":"Call-a-Macro"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The syntax you use to call a macro varies slightly,"},{"type":"text","text":" "},{"type":"text","text":"depending on whether you attach the macro to a declaration."}]},{"inlineContent":[{"type":"text","text":"To attach a macro to a declaration,"},{"type":"text","text":" "},{"type":"text","text":"write an at sign ("},{"type":"codeVoice","code":"@"},{"type":"text","text":") before the macro’s name"},{"type":"text","text":" "},{"type":"text","text":"and write any macro arguments after its name."},{"type":"text","text":" "},{"text":"This syntax is the same as writing an attribute.","type":"text"},{"text":" ","type":"text"},{"text":"For example:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Observable","public final class MyObject {","    public var someProperty: String = \"\"","    public var someOtherProperty: Int = 0","    fileprivate var somePrivateProperty: Int = 1","}"],"type":"codeListing"},{"inlineContent":[{"text":"A macro that’s attached to a declaration","type":"text"},{"text":" ","type":"text"},{"text":"generates code","type":"text"},{"text":" ","type":"text"},{"text":"and adds that code to the declaration.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","isActive":true},{"type":"text","text":" macro in the code above"},{"type":"text","text":" "},{"type":"text","text":"adds additional members to the "},{"type":"codeVoice","code":"MyObject"},{"type":"text","text":" class"},{"type":"text","text":" "},{"type":"text","text":"so it implements the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable"},{"type":"text","text":" protocol,"},{"type":"text","text":" "},{"type":"text","text":"and marks "},{"type":"codeVoice","code":"MyObject"},{"type":"text","text":" as conforming to "},{"code":"Observable","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To call a macro without attaching it to a declaration,"},{"type":"text","text":" "},{"type":"text","text":"write a number sign ("},{"type":"codeVoice","code":"#"},{"type":"text","text":") before the macro’s name"},{"type":"text","text":" "},{"type":"text","text":"and write any macro arguments after its name."},{"type":"text","text":" "},{"type":"text","text":"This syntax is the same as "},{"type":"codeVoice","code":"#if"},{"type":"text","text":" and other compile-time operations."},{"type":"text","text":" "},{"type":"text","text":"For example:"}],"type":"paragraph"},{"type":"codeListing","code":["let messagePredicate = #Predicate<Message> { message in","    message.recipient == \"John Appleseed\"","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A macro that isn’t attached to a declaration"},{"type":"text","text":" "},{"type":"text","text":"generates code and adds that code"},{"type":"text","text":" "},{"type":"text","text":"in the location where where you call the macro."},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"Predicate","type":"codeVoice"},{"text":" macro in the code above creates an instance of the","type":"text"},{"text":" ","type":"text"},{"text":"Swift Foundation ","type":"text"},{"code":"Predicate","type":"codeVoice"},{"type":"text","text":" structure."}]},{"inlineContent":[{"type":"text","text":"For more information,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","isActive":true},{"type":"text","text":" in "},{"isActive":true,"identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Inspect an Expanded Macro","level":3,"anchor":"Inspect-an-Expanded-Macro"},{"type":"paragraph","inlineContent":[{"text":"When you build your project,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Swift reads your code and finds the places where you call a macro."},{"type":"text","text":" "},{"type":"text","text":"Swift then calls the implementation of each macro,"},{"type":"text","text":" "},{"type":"text","text":"to expand the code."},{"type":"text","text":" "},{"type":"text","text":"Finally, Swift builds your project as usual,"},{"type":"text","text":" "},{"type":"text","text":"including the generated code."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To view the code that a macro generated,"},{"type":"text","text":" "},{"type":"text","text":"click on the code where you call the macro in Xcode,"},{"type":"text","text":" "},{"text":"then choose Editor > Expand Macro.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"You can read the expanded code"},{"type":"text","text":" "},{"type":"text","text":"to help you understand details about the macro’s behavior,"},{"type":"text","text":" "},{"type":"text","text":"and you can use the expanded code"},{"type":"text","text":" "},{"type":"text","text":"to help you debug code that uses macros."},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"you can set breakpoints inside code generated by a macro."}]}]}],"references":{"macro-expansion":{"variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.Swift\/macro-expansion@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.Swift\/macro-expansion~dark@2x.png"}],"alt":"A diagram showing an overview of macro expansion. On the left, a stylized representation of Swift code. On the right, the same code with several lines added by the macro.","identifier":"macro-expansion","type":"image"},"doc://com.apple.Swift/documentation/Observation/Observable()":{"abstract":[{"type":"text","text":"Defines and implements conformance of the Observable protocol."}],"kind":"symbol","url":"\/documentation\/observation\/observable()","type":"topic","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Observable","kind":"identifier"},{"text":"()","kind":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","title":"Observable()","role":"symbol"},"https://docs.swift.org/swift-book/documentation/the-swift-programming-language":{"title":"The Swift Programming Language","url":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language","identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language","type":"link","titleInlineContent":[{"type":"text","text":"The Swift Programming Language"}]},"https://docs.swift.org/swift-book/documentation/the-swift-programming-language/macros":{"url":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","title":"Macros","type":"link","identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","titleInlineContent":[{"text":"Macros","type":"text"}]},"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/macros":{"url":"\/documentation\/swift\/macros","type":"topic","kind":"article","abstract":[{"type":"text","text":"Generate boilerplate code and perform other compile-time operations."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/macros","role":"collectionGroup","title":"Macros"},"doc://com.apple.Swift/documentation/Observation/Observable":{"navigatorTitle":[{"text":"Observable","kind":"identifier"}],"url":"\/documentation\/observation\/observable","type":"topic","kind":"symbol","role":"symbol","abstract":[{"text":"A type that emits notifications to observers when underlying data changes.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable","title":"Observable","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Observable","kind":"identifier"}]}}}