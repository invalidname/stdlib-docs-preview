{"abstract":[{"type":"text","text":"Use macros to generate repetitive code at compile time."}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/applying-macros"},"metadata":{"role":"article","modules":[{"name":"Swift"}],"roleHeading":"Article","title":"Applying Macros"},"variants":[{"paths":["\/documentation\/swift\/applying-macros"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","doc:\/\/com.apple.Swift\/documentation\/Swift\/macros"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Swift macros help you avoid writing repetitive code in Swift","type":"text"},{"text":" ","type":"text"},{"text":"by generating that part of your source code at compile time.","type":"text"},{"text":" ","type":"text"},{"text":"Calling a macro is always additive:","type":"text"},{"text":" ","type":"text"},{"text":"The macro adds new code alongside the code that you wrote,","type":"text"},{"text":" ","type":"text"},{"text":"but never modifies or deletes code that’s already part of your project.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Many libraries provide macros,","type":"text"},{"text":" ","type":"text"},{"text":"including the Swift standard library and many frameworks.","type":"text"},{"text":" ","type":"text"},{"text":"You can also write your own macros.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because macros generate Swift code,","type":"text"},{"text":" ","type":"text"},{"text":"you use the same tools for development and debugging,","type":"text"},{"text":" ","type":"text"},{"text":"regardless of whether your code uses macros.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"macro-expansion","type":"image"}]},{"type":"heading","anchor":"Call-a-Macro","text":"Call a Macro","level":3},{"type":"paragraph","inlineContent":[{"text":"The syntax you use to call a macro varies slightly,","type":"text"},{"text":" ","type":"text"},{"text":"depending on whether you attach the macro to a declaration.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To attach a macro to a declaration,","type":"text"},{"text":" ","type":"text"},{"text":"write an at sign (","type":"text"},{"code":"@","type":"codeVoice"},{"text":") before the macro’s name","type":"text"},{"text":" ","type":"text"},{"text":"and write any macro arguments after its name.","type":"text"},{"text":" ","type":"text"},{"text":"This syntax is the same as writing an attribute.","type":"text"},{"text":" ","type":"text"},{"text":"For example:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@Observable","public final class MyObject {","    public var someProperty: String = \"\"","    public var someOtherProperty: Int = 0","    fileprivate var somePrivateProperty: Int = 1","}"]},{"inlineContent":[{"text":"A macro that’s attached to a declaration","type":"text"},{"text":" ","type":"text"},{"text":"generates code","type":"text"},{"text":" ","type":"text"},{"text":"and adds that code to the declaration.","type":"text"},{"text":" ","type":"text"},{"text":"For example,","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()"},{"type":"text","text":" macro in the code above"},{"type":"text","text":" "},{"type":"text","text":"adds additional members to the "},{"type":"codeVoice","code":"MyObject"},{"type":"text","text":" class"},{"type":"text","text":" "},{"type":"text","text":"so it implements the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable"},{"type":"text","text":" protocol,"},{"type":"text","text":" "},{"type":"text","text":"and marks "},{"type":"codeVoice","code":"MyObject"},{"type":"text","text":" as conforming to "},{"type":"codeVoice","code":"Observable"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To call a macro without attaching it to a declaration,"},{"type":"text","text":" "},{"type":"text","text":"write a number sign ("},{"code":"#","type":"codeVoice"},{"type":"text","text":") before the macro’s name"},{"type":"text","text":" "},{"type":"text","text":"and write any macro arguments after its name."},{"type":"text","text":" "},{"type":"text","text":"This syntax is the same as "},{"code":"#if","type":"codeVoice"},{"type":"text","text":" and other compile-time operations."},{"type":"text","text":" "},{"type":"text","text":"For example:"}]},{"type":"codeListing","syntax":"swift","code":["let messagePredicate = #Predicate<Message> { message in","    message.recipient == \"John Appleseed\"","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A macro that isn’t attached to a declaration"},{"type":"text","text":" "},{"type":"text","text":"generates code and adds that code"},{"type":"text","text":" "},{"type":"text","text":"in the location where where you call the macro."},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"Predicate","type":"codeVoice"},{"type":"text","text":" macro in the code above creates an instance of the"},{"text":" ","type":"text"},{"type":"text","text":"Swift Foundation "},{"code":"Predicate","type":"codeVoice"},{"text":" structure.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For more information,","type":"text"},{"text":" ","type":"text"},{"text":"see ","type":"text"},{"identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","isActive":true,"type":"reference"},{"text":" in ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language"},{"text":".","type":"text"}]},{"anchor":"Inspect-an-Expanded-Macro","type":"heading","level":3,"text":"Inspect an Expanded Macro"},{"inlineContent":[{"text":"When you build your project,","type":"text"},{"type":"text","text":" "},{"text":"Swift reads your code and finds the places where you call a macro.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Swift then calls the implementation of each macro,"},{"text":" ","type":"text"},{"text":"to expand the code.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Finally, Swift builds your project as usual,"},{"type":"text","text":" "},{"type":"text","text":"including the generated code."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To view the code that a macro generated,"},{"type":"text","text":" "},{"type":"text","text":"click on the code where you call the macro in Xcode,"},{"type":"text","text":" "},{"text":"then choose Editor > Expand Macro.","type":"text"},{"text":" ","type":"text"},{"text":"You can read the expanded code","type":"text"},{"text":" ","type":"text"},{"text":"to help you understand details about the macro’s behavior,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and you can use the expanded code"},{"text":" ","type":"text"},{"text":"to help you debug code that uses macros.","type":"text"},{"text":" ","type":"text"},{"text":"For example,","type":"text"},{"text":" ","type":"text"},{"text":"you can set breakpoints inside code generated by a macro.","type":"text"}],"type":"paragraph"}]}],"sections":[],"references":{"macro-expansion":{"alt":"A diagram showing an overview of macro expansion. On the left, a stylized representation of Swift code. On the right, the same code with several lines added by the macro.","variants":[{"url":"\/images\/com.apple.Swift\/macro-expansion@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/macro-expansion~dark@2x.png","traits":["2x","dark"]}],"type":"image","identifier":"macro-expansion"},"https://docs.swift.org/swift-book/documentation/the-swift-programming-language":{"titleInlineContent":[{"text":"The Swift Programming Language","type":"text"}],"type":"link","url":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language","title":"The Swift Programming Language","identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language"},"doc://com.apple.Swift/documentation/Observation/Observable()":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Observable","kind":"identifier"},{"text":"()","kind":"text"}],"role":"symbol","abstract":[{"type":"text","text":"Defines and implements conformance of the Observable protocol."}],"kind":"symbol","url":"\/documentation\/observation\/observable()","title":"Observable()","type":"topic"},"doc://com.apple.Swift/documentation/Observation/Observable":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Observable","kind":"identifier"}],"abstract":[{"text":"A type that emits notifications to observers when underlying data changes.","type":"text"}],"type":"topic","title":"Observable","role":"symbol","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable","url":"\/documentation\/observation\/observable","navigatorTitle":[{"text":"Observable","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift":{"title":"Swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","url":"\/documentation\/swift"},"doc://com.apple.Swift/documentation/Swift/swift-standard-library":{"title":"Swift Standard Library","abstract":[{"text":"Solve complex problems and write high-performance, readable code.","type":"text"}],"kind":"article","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","role":"collectionGroup","url":"\/documentation\/swift\/swift-standard-library"},"https://docs.swift.org/swift-book/documentation/the-swift-programming-language/macros":{"titleInlineContent":[{"text":"Macros","type":"text"}],"type":"link","url":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","title":"Macros","identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros"},"doc://com.apple.Swift/documentation/Swift/macros":{"url":"\/documentation\/swift\/macros","kind":"article","abstract":[{"text":"Generate boilerplate code and perform other compile-time operations.","type":"text"}],"role":"collectionGroup","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/macros","title":"Macros"}}}