{"sections":[],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift macros help you avoid writing repetitive code in Swift"},{"type":"text","text":" "},{"type":"text","text":"by generating that part of your source code at compile time."},{"type":"text","text":" "},{"type":"text","text":"Calling a macro is always additive:"},{"type":"text","text":" "},{"type":"text","text":"The macro adds new code alongside the code that you wrote,"},{"type":"text","text":" "},{"type":"text","text":"but never modifies or deletes code that’s already part of your project."}]},{"inlineContent":[{"type":"text","text":"Many libraries provide macros,"},{"type":"text","text":" "},{"type":"text","text":"including the Swift standard library and many frameworks."},{"type":"text","text":" "},{"type":"text","text":"You can also write your own macros."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because macros generate Swift code,"},{"type":"text","text":" "},{"type":"text","text":"you use the same tools for development and debugging,"},{"type":"text","text":" "},{"type":"text","text":"regardless of whether your code uses macros."}],"type":"paragraph"},{"inlineContent":[{"identifier":"macro-expansion","type":"image"}],"type":"paragraph"},{"level":3,"text":"Call a Macro","type":"heading","anchor":"Call-a-Macro"},{"inlineContent":[{"type":"text","text":"The syntax you use to call a macro varies slightly,"},{"type":"text","text":" "},{"type":"text","text":"depending on whether you attach the macro to a declaration."}],"type":"paragraph"},{"inlineContent":[{"text":"To attach a macro to a declaration,","type":"text"},{"text":" ","type":"text"},{"text":"write an at sign (","type":"text"},{"code":"@","type":"codeVoice"},{"text":") before the macro’s name","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and write any macro arguments after its name."},{"type":"text","text":" "},{"type":"text","text":"This syntax is the same as writing an attribute."},{"type":"text","text":" "},{"text":"For example:","type":"text"}],"type":"paragraph"},{"code":["@Observable","public final class MyObject {","    public var someProperty: String = \"\"","    public var someOtherProperty: Int = 0","    fileprivate var somePrivateProperty: Int = 1","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A macro that’s attached to a declaration","type":"text"},{"text":" ","type":"text"},{"text":"generates code","type":"text"},{"text":" ","type":"text"},{"text":"and adds that code to the declaration.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"For example,"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","isActive":true,"type":"reference"},{"text":" macro in the code above","type":"text"},{"type":"text","text":" "},{"type":"text","text":"adds additional members to the "},{"type":"codeVoice","code":"MyObject"},{"text":" class","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"so it implements the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable","isActive":true,"type":"reference"},{"type":"text","text":" protocol,"},{"type":"text","text":" "},{"text":"and marks ","type":"text"},{"type":"codeVoice","code":"MyObject"},{"type":"text","text":" as conforming to "},{"code":"Observable","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To call a macro without attaching it to a declaration,"},{"type":"text","text":" "},{"type":"text","text":"write a number sign ("},{"type":"codeVoice","code":"#"},{"text":") before the macro’s name","type":"text"},{"text":" ","type":"text"},{"text":"and write any macro arguments after its name.","type":"text"},{"type":"text","text":" "},{"text":"This syntax is the same as ","type":"text"},{"code":"#if","type":"codeVoice"},{"type":"text","text":" and other compile-time operations."},{"type":"text","text":" "},{"type":"text","text":"For example:"}],"type":"paragraph"},{"code":["let messagePredicate = #Predicate<Message> { message in","    message.recipient == \"John Appleseed\"","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A macro that isn’t attached to a declaration","type":"text"},{"text":" ","type":"text"},{"text":"generates code and adds that code","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in the location where where you call the macro."},{"type":"text","text":" "},{"text":"For example,","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"Predicate","type":"codeVoice"},{"type":"text","text":" macro in the code above creates an instance of the"},{"type":"text","text":" "},{"type":"text","text":"Swift Foundation "},{"type":"codeVoice","code":"Predicate"},{"text":" structure.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For more information,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","type":"reference","isActive":true},{"type":"text","text":" in "},{"identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"Inspect an Expanded Macro","type":"heading","anchor":"Inspect-an-Expanded-Macro"},{"inlineContent":[{"text":"When you build your project,","type":"text"},{"type":"text","text":" "},{"text":"Swift reads your code and finds the places where you call a macro.","type":"text"},{"text":" ","type":"text"},{"text":"Swift then calls the implementation of each macro,","type":"text"},{"text":" ","type":"text"},{"text":"to expand the code.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Finally, Swift builds your project as usual,"},{"type":"text","text":" "},{"text":"including the generated code.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"To view the code that a macro generated,","type":"text"},{"text":" ","type":"text"},{"text":"click on the code where you call the macro in Xcode,","type":"text"},{"text":" ","type":"text"},{"text":"then choose Editor > Expand Macro.","type":"text"},{"type":"text","text":" "},{"text":"You can read the expanded code","type":"text"},{"type":"text","text":" "},{"text":"to help you understand details about the macro’s behavior,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and you can use the expanded code"},{"text":" ","type":"text"},{"text":"to help you debug code that uses macros.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"you can set breakpoints inside code generated by a macro."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/applying-macros"},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Standard Library"}],"title":"Applying Macros"},"abstract":[{"type":"text","text":"Use macros to generate repetitive code at compile time."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/macros"]]},"kind":"article","variants":[{"paths":["\/documentation\/swift\/applying-macros"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://docs.swift.org/swift-book/documentation/the-swift-programming-language":{"titleInlineContent":[{"type":"text","text":"The Swift Programming Language"}],"url":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language","identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language","title":"The Swift Programming Language","type":"link"},"macro-expansion":{"variants":[{"url":"\/images\/com.apple.Swift\/macro-expansion@2x.png","traits":["2x","light"]},{"traits":["2x","dark"],"url":"\/images\/com.apple.Swift\/macro-expansion~dark@2x.png"}],"identifier":"macro-expansion","alt":"A diagram showing an overview of macro expansion. On the left, a stylized representation of Swift code. On the right, the same code with several lines added by the macro.","type":"image"},"https://docs.swift.org/swift-book/documentation/the-swift-programming-language/macros":{"title":"Macros","url":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","titleInlineContent":[{"type":"text","text":"Macros"}],"identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","type":"link"},"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"url":"\/documentation\/swift","abstract":[{"text":"Browse the essential types provided by Swift’s standard library.","type":"text"}],"type":"topic","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/macros":{"kind":"article","url":"\/documentation\/swift\/macros","type":"topic","abstract":[{"type":"text","text":"Generate boilerplate code and perform other compile-time operations."}],"role":"collectionGroup","title":"Macros","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/macros"},"doc://com.apple.Swift/documentation/Observation/Observable":{"role":"symbol","type":"topic","title":"Observable","url":"\/documentation\/observation\/observable","kind":"symbol","navigatorTitle":[{"text":"Observable","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Observable","kind":"identifier"}],"abstract":[{"text":"A type that emits notifications to observers when underlying data changes.","type":"text"}]},"doc://com.apple.Swift/documentation/Observation/Observable()":{"type":"topic","url":"\/documentation\/observation\/observable()","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Observable","kind":"identifier"},{"text":"()","kind":"text"}],"title":"Observable()","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","role":"symbol","abstract":[{"text":"Defines and implements conformance of the Observable protocol.","type":"text"}]}}}