{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Swift macros help you avoid writing repetitive code in Swift"},{"type":"text","text":" "},{"type":"text","text":"by generating that part of your source code at compile time."},{"type":"text","text":" "},{"type":"text","text":"Calling a macro is always additive:"},{"type":"text","text":" "},{"type":"text","text":"The macro adds new code alongside the code that you wrote,"},{"type":"text","text":" "},{"type":"text","text":"but never modifies or deletes code that’s already part of your project."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Many libraries provide macros,"},{"type":"text","text":" "},{"type":"text","text":"including the Swift standard library and many frameworks."},{"type":"text","text":" "},{"type":"text","text":"You can also write your own macros."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because macros generate Swift code,"},{"type":"text","text":" "},{"type":"text","text":"you use the same tools for development and debugging,"},{"type":"text","text":" "},{"type":"text","text":"regardless of whether your code uses macros."}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"macro-expansion"}],"type":"paragraph"},{"anchor":"Call-a-Macro","type":"heading","level":3,"text":"Call a Macro"},{"inlineContent":[{"type":"text","text":"The syntax you use to call a macro varies slightly,"},{"type":"text","text":" "},{"type":"text","text":"depending on whether you attach the macro to a declaration."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To attach a macro to a declaration,"},{"type":"text","text":" "},{"type":"text","text":"write an at sign ("},{"type":"codeVoice","code":"@"},{"type":"text","text":") before the macro’s name"},{"type":"text","text":" "},{"type":"text","text":"and write any macro arguments after its name."},{"type":"text","text":" "},{"type":"text","text":"This syntax is the same as writing an attribute."},{"type":"text","text":" "},{"type":"text","text":"For example:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Observable","public final class MyObject {","    public var someProperty: String = \"\"","    public var someOtherProperty: Int = 0","    fileprivate var somePrivateProperty: Int = 1","}"]},{"inlineContent":[{"type":"text","text":"A macro that’s attached to a declaration"},{"type":"text","text":" "},{"type":"text","text":"generates code"},{"type":"text","text":" "},{"type":"text","text":"and adds that code to the declaration."},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","isActive":true},{"type":"text","text":" macro in the code above"},{"type":"text","text":" "},{"type":"text","text":"adds additional members to the "},{"type":"codeVoice","code":"MyObject"},{"type":"text","text":" class"},{"type":"text","text":" "},{"type":"text","text":"so it implements the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable","isActive":true},{"type":"text","text":" protocol,"},{"type":"text","text":" "},{"text":"and marks ","type":"text"},{"code":"MyObject","type":"codeVoice"},{"text":" as conforming to ","type":"text"},{"code":"Observable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To call a macro without attaching it to a declaration,"},{"type":"text","text":" "},{"type":"text","text":"write a number sign ("},{"type":"codeVoice","code":"#"},{"type":"text","text":") before the macro’s name"},{"type":"text","text":" "},{"type":"text","text":"and write any macro arguments after its name."},{"type":"text","text":" "},{"type":"text","text":"This syntax is the same as "},{"type":"codeVoice","code":"#if"},{"type":"text","text":" and other compile-time operations."},{"type":"text","text":" "},{"type":"text","text":"For example:"}],"type":"paragraph"},{"syntax":"swift","code":["let messagePredicate = #Predicate<Message> { message in","    message.recipient == \"John Appleseed\"","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A macro that isn’t attached to a declaration"},{"type":"text","text":" "},{"type":"text","text":"generates code and adds that code"},{"type":"text","text":" "},{"type":"text","text":"in the location where where you call the macro."},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"Predicate"},{"type":"text","text":" macro in the code above creates an instance of the"},{"type":"text","text":" "},{"type":"text","text":"Swift Foundation "},{"type":"codeVoice","code":"Predicate"},{"type":"text","text":" structure."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For more information,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","isActive":true},{"type":"text","text":" in "},{"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"anchor":"Inspect-an-Expanded-Macro","text":"Inspect an Expanded Macro","type":"heading"},{"inlineContent":[{"type":"text","text":"When you build your project,"},{"type":"text","text":" "},{"type":"text","text":"Swift reads your code and finds the places where you call a macro."},{"type":"text","text":" "},{"type":"text","text":"Swift then calls the implementation of each macro,"},{"type":"text","text":" "},{"type":"text","text":"to expand the code."},{"type":"text","text":" "},{"type":"text","text":"Finally, Swift builds your project as usual,"},{"type":"text","text":" "},{"type":"text","text":"including the generated code."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To view the code that a macro generated,"},{"type":"text","text":" "},{"type":"text","text":"click on the code where you call the macro in Xcode,"},{"type":"text","text":" "},{"type":"text","text":"then choose Editor > Expand Macro."},{"type":"text","text":" "},{"type":"text","text":"You can read the expanded code"},{"type":"text","text":" "},{"type":"text","text":"to help you understand details about the macro’s behavior,"},{"type":"text","text":" "},{"type":"text","text":"and you can use the expanded code"},{"type":"text","text":" "},{"type":"text","text":"to help you debug code that uses macros."},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"you can set breakpoints inside code generated by a macro."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"metadata":{"modules":[{"name":"Swift"}],"roleHeading":"Article","role":"article","title":"Applying Macros"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","doc:\/\/com.apple.Swift\/documentation\/Swift\/macros"]]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/applying-macros","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Use macros to generate repetitive code at compile time."}],"variants":[{"paths":["\/documentation\/swift\/applying-macros"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","references":{"doc://com.apple.Swift/documentation/Observation/Observable":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Observable"}],"abstract":[{"type":"text","text":"A type that emits notifications to observers when underlying data changes."}],"title":"Observable","navigatorTitle":[{"kind":"identifier","text":"Observable"}],"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable","url":"\/documentation\/observation\/observable"},"https://docs.swift.org/swift-book/documentation/the-swift-programming-language":{"identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language","type":"link","titleInlineContent":[{"type":"text","text":"The Swift Programming Language"}],"url":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language","title":"The Swift Programming Language"},"macro-expansion":{"alt":"A diagram showing an overview of macro expansion. On the left, a stylized representation of Swift code. On the right, the same code with several lines added by the macro.","identifier":"macro-expansion","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.Swift\/macro-expansion@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.Swift\/macro-expansion~dark@2x.png"}]},"https://docs.swift.org/swift-book/documentation/the-swift-programming-language/macros":{"identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","type":"link","titleInlineContent":[{"type":"text","text":"Macros"}],"url":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","title":"Macros"},"doc://com.apple.Swift/documentation/Observation/Observable()":{"role":"symbol","title":"Observable()","url":"\/documentation\/observation\/observable()","abstract":[{"type":"text","text":"Defines and implements conformance of the Observable protocol."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Observable"},{"kind":"text","text":"()"}],"kind":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/Swift/macros":{"kind":"article","role":"collectionGroup","abstract":[{"type":"text","text":"Generate boilerplate code and perform other compile-time operations."}],"title":"Macros","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/macros","type":"topic","url":"\/documentation\/swift\/macros"},"doc://com.apple.Swift/documentation/Swift":{"type":"topic","kind":"symbol","url":"\/documentation\/swift","role":"collection","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/swift-standard-library":{"type":"topic","kind":"article","url":"\/documentation\/swift\/swift-standard-library","role":"collectionGroup","title":"Swift Standard Library","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","abstract":[{"text":"Solve complex problems and write high-performance, readable code.","type":"text"}]}}}