{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/applying-macros"]}],"metadata":{"roleHeading":"Article","modules":[{"name":"Standard Library"}],"role":"article","title":"Applying Macros"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Swift macros help you avoid writing repetitive code in Swift"},{"type":"text","text":" "},{"type":"text","text":"by generating that part of your source code at compile time."},{"type":"text","text":" "},{"type":"text","text":"Calling a macro is always additive:"},{"type":"text","text":" "},{"type":"text","text":"The macro adds new code alongside the code that you wrote,"},{"type":"text","text":" "},{"type":"text","text":"but never modifies or deletes code that’s already part of your project."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Many libraries provide macros,"},{"type":"text","text":" "},{"type":"text","text":"including the Swift standard library and many frameworks."},{"type":"text","text":" "},{"type":"text","text":"You can also write your own macros."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because macros generate Swift code,"},{"type":"text","text":" "},{"type":"text","text":"you use the same tools for development and debugging,"},{"type":"text","text":" "},{"type":"text","text":"regardless of whether your code uses macros."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"identifier":"macro-expansion","type":"image"}]},{"text":"Call a Macro","type":"heading","anchor":"Call-a-Macro","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The syntax you use to call a macro varies slightly,"},{"type":"text","text":" "},{"type":"text","text":"depending on whether you attach the macro to a declaration."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To attach a macro to a declaration,"},{"type":"text","text":" "},{"type":"text","text":"write an at sign ("},{"code":"@","type":"codeVoice"},{"type":"text","text":") before the macro’s name"},{"type":"text","text":" "},{"type":"text","text":"and write any macro arguments after its name."},{"type":"text","text":" "},{"type":"text","text":"This syntax is the same as writing an attribute."},{"type":"text","text":" "},{"type":"text","text":"For example:"}]},{"code":["@Observable","public final class MyObject {","    public var someProperty: String = \"\"","    public var someOtherProperty: Int = 0","    fileprivate var somePrivateProperty: Int = 1","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A macro that’s attached to a declaration"},{"type":"text","text":" "},{"type":"text","text":"generates code"},{"type":"text","text":" "},{"type":"text","text":"and adds that code to the declaration."},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","isActive":true,"type":"reference"},{"type":"text","text":" macro in the code above"},{"type":"text","text":" "},{"type":"text","text":"adds additional members to the "},{"code":"MyObject","type":"codeVoice"},{"type":"text","text":" class"},{"type":"text","text":" "},{"type":"text","text":"so it implements the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable","isActive":true,"type":"reference"},{"type":"text","text":" protocol,"},{"type":"text","text":" "},{"type":"text","text":"and marks "},{"code":"MyObject","type":"codeVoice"},{"type":"text","text":" as conforming to "},{"code":"Observable","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To call a macro without attaching it to a declaration,"},{"type":"text","text":" "},{"type":"text","text":"write a number sign ("},{"type":"codeVoice","code":"#"},{"type":"text","text":") before the macro’s name"},{"type":"text","text":" "},{"type":"text","text":"and write any macro arguments after its name."},{"type":"text","text":" "},{"type":"text","text":"This syntax is the same as "},{"code":"#if","type":"codeVoice"},{"type":"text","text":" and other compile-time operations."},{"type":"text","text":" "},{"type":"text","text":"For example:"}]},{"code":["let messagePredicate = #Predicate<Message> { message in","    message.recipient == \"John Appleseed\"","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A macro that isn’t attached to a declaration"},{"type":"text","text":" "},{"type":"text","text":"generates code and adds that code"},{"type":"text","text":" "},{"type":"text","text":"in the location where where you call the macro."},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"Predicate","type":"codeVoice"},{"type":"text","text":" macro in the code above creates an instance of the"},{"type":"text","text":" "},{"type":"text","text":"Swift Foundation "},{"code":"Predicate","type":"codeVoice"},{"type":"text","text":" structure."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","isActive":true,"type":"reference"},{"type":"text","text":" in "},{"identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"heading","text":"Inspect an Expanded Macro","anchor":"Inspect-an-Expanded-Macro","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you build your project,"},{"type":"text","text":" "},{"type":"text","text":"Swift reads your code and finds the places where you call a macro."},{"type":"text","text":" "},{"type":"text","text":"Swift then calls the implementation of each macro,"},{"type":"text","text":" "},{"type":"text","text":"to expand the code."},{"type":"text","text":" "},{"type":"text","text":"Finally, Swift builds your project as usual,"},{"type":"text","text":" "},{"type":"text","text":"including the generated code."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To view the code that a macro generated,"},{"type":"text","text":" "},{"type":"text","text":"click on the code where you call the macro in Xcode,"},{"type":"text","text":" "},{"type":"text","text":"then choose Editor > Expand Macro."},{"type":"text","text":" "},{"type":"text","text":"You can read the expanded code"},{"type":"text","text":" "},{"type":"text","text":"to help you understand details about the macro’s behavior,"},{"type":"text","text":" "},{"type":"text","text":"and you can use the expanded code"},{"type":"text","text":" "},{"type":"text","text":"to help you debug code that uses macros."},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"you can set breakpoints inside code generated by a macro."}]}],"kind":"content"}],"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Use macros to generate repetitive code at compile time."}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/macros"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/applying-macros"},"references":{"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","url":"\/documentation\/swift","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"title":"Standard Library","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"role":"collection"},"doc://com.apple.Swift/documentation/Observation/Observable()":{"type":"topic","role":"symbol","abstract":[{"text":"Defines and implements conformance of the Observable protocol.","type":"text"}],"kind":"symbol","url":"\/documentation\/observation\/observable()","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Observable"},{"kind":"text","text":"()"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","title":"Observable()"},"https://docs.swift.org/swift-book/documentation/the-swift-programming-language/macros":{"url":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros","type":"link","title":"Macros","titleInlineContent":[{"type":"text","text":"Macros"}],"identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/macros"},"doc://com.apple.Swift/documentation/Swift/macros":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/macros","title":"Macros","kind":"article","abstract":[{"type":"text","text":"Generate boilerplate code and perform other compile-time operations."}],"role":"collectionGroup","url":"\/documentation\/swift\/macros"},"macro-expansion":{"type":"image","variants":[{"url":"\/images\/com.apple.Swift\/macro-expansion@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/macro-expansion~dark@2x.png","traits":["2x","dark"]}],"alt":"A diagram showing an overview of macro expansion. On the left, a stylized representation of Swift code. On the right, the same code with several lines added by the macro.","identifier":"macro-expansion"},"doc://com.apple.Swift/documentation/Observation/Observable":{"type":"topic","role":"symbol","abstract":[{"text":"A type that emits notifications to observers when underlying data changes.","type":"text"}],"kind":"symbol","url":"\/documentation\/observation\/observable","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Observable"}],"navigatorTitle":[{"kind":"identifier","text":"Observable"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable","title":"Observable"},"https://docs.swift.org/swift-book/documentation/the-swift-programming-language":{"type":"link","titleInlineContent":[{"type":"text","text":"The Swift Programming Language"}],"title":"The Swift Programming Language","url":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language","identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language"}}}