:"swift","code":["var numbers = [10, 20, 30, 40, 50]","\/\/ numbers.count == 5","\/\/ numbers.capacity == 5","","numbers.append(contentsOf: stride(from: 60, through: 100, by: 10))","\/\/ numbers.count == 10","\/\/ numbers.capacity == 10"]}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/Array/isEmpty":{"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/isEmpty","title":"isEmpty","url":"\/documentation\/swift\/array\/isempty","abstract":[{"text":"A Boolean value indicating whether the collection is empty.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEmpty"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}]},"Swift-PageImage-card.png":{"alt":"An orange Swift logo on a gradient background.","type":"image","identifier":"Swift-PageImage-card.png","variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png","traits":["2x","dark"]}]},"doc://com.apple.Swift/documentation/Swift/Int":{"navigatorTitle":[{"kind":"identifier","text":"Int"}],"url":"\/documentation\/swift\/int","abstract":[{"text":"A signed integer value type.","type":"text"}],"kind":"symbol","title":"Int","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Int"}]},"doc://com.apple.Swift/documentation/Swift":{"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","title":"Swift","url":"\/documentation\/swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"images":[{"identifier":"Swift-PageImage-card.png","type":"card"}],"kind":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/Swi