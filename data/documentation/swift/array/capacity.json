{"kind":"symbol","abstract":[{"type":"text","text":"The total number of elements that the array can contain without"},{"type":"text","text":" "},{"type":"text","text":"allocating new storage."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"capacity","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Every array reserves a specific amount of memory to hold its contents.","type":"text"},{"text":" ","type":"text"},{"text":"When you add elements to an array and that array begins to exceed its","type":"text"},{"text":" ","type":"text"},{"text":"reserved capacity, the array allocates a larger region of memory and","type":"text"},{"text":" ","type":"text"},{"text":"copies its elements into the new storage. The new storage is a multiple","type":"text"},{"text":" ","type":"text"},{"text":"of the old storage’s size. This exponential growth strategy means that","type":"text"},{"text":" ","type":"text"},{"text":"appending an element happens in constant time, averaging the performance","type":"text"},{"text":" ","type":"text"},{"text":"of many append operations. Append operations that trigger reallocation","type":"text"},{"text":" ","type":"text"},{"text":"have a performance cost, but they occur less and less often as the array","type":"text"},{"text":" ","type":"text"},{"text":"grows larger.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example creates an array of integers from an array literal,","type":"text"},{"text":" ","type":"text"},{"text":"then appends the elements of another collection. Before appending, the","type":"text"},{"text":" ","type":"text"},{"text":"array allocates new storage that is large enough store the resulting","type":"text"},{"text":" ","type":"text"},{"text":"elements.","type":"text"}]},{"code":["var numbers = [10, 20, 30, 40, 50]","\/\/ numbers.count == 5","\/\/ numbers.capacity == 5","","numbers.append(contentsOf: stride(from: 60, through: 100, by: 10))","\/\/ numbers.count == 10","\/\/ numbers.capacity == 10"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/array\/capacity"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/capacity"},"metadata":{"title":"capacity","symbolKind":"property","platforms":[{"name":"iOS","beta":false,"deprecated":false,"introducedAt":"8.0","unavailable":false},{"name":"iPadOS","beta":false,"deprecated":false,"introducedAt":"8.0","unavailable":false},{"name":"Mac Catalyst","beta":false,"deprecated":false,"introducedAt":"13.0","unavailable":false},{"name":"macOS","beta":false,"deprecated":false,"introducedAt":"10.10","unavailable":false},{"name":"tvOS","beta":false,"deprecated":false,"introducedAt":"9.0","unavailable":false},{"name":"visionOS","beta":false,"deprecated":false,"introducedAt":"1.0","unavailable":false},{"name":"watchOS","beta":false,"deprecated":false,"introducedAt":"2.0","unavailable":false}],"extendedModule":"Swift","role":"symbol","externalID":"s:Sa8capacitySivp","modules":[{"name":"Standard Library"}],"roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"capacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}]},"seeAlsoSections":[{"title":"Inspecting an Array","anchor":"Inspecting-an-Array","generated":true,"identifiers":["