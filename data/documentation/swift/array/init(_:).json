xt","text":" "},{"type":"text","text":"around a range instead of typing all those numbers in an array literal."}],"type":"paragraph"},{"code":["let numbers = Array(1...7)","print(numbers)","\/\/ Prints \"[1, 2, 3, 4, 5, 6, 7]\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"You can also use this initializer to convert a complex sequence or"},{"type":"text","text":" "},{"type":"text","text":"collection type back to an array. For example, the "},{"type":"codeVoice","code":"keys"},{"type":"text","text":" property of"},{"text":" ","type":"text"},{"text":"a dictionary isn’t an array with its own storage, it’s a collection","type":"text"},{"text":" ","type":"text"},{"text":"that maps its elements from the dictionary only when they’re","type":"text"},{"text":" ","type":"text"},{"text":"accessed, saving the time and space needed to allocate an array. If","type":"text"},{"text":" ","type":"text"},{"text":"you need to pass those keys to a method that takes an array, however,","type":"text"},{"text":" ","type":"text"},{"text":"use this initializer to convert that list from its type of","type":"text"},{"text":" ","type":"text"},{"code":"LazyMapCollection<Dictionary<String, Int>, Int>","type":"codeVoice"},{"text":" to a simple","type":"text"},{"text":" ","type":"text"},{"code":"[String]","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func cacheImages(withNames names: [String]) {","    \/\/ custom image loading and caching"," }","","let namedHues: [String: Int] = [\"Vermillion\": 18, \"Magenta\": 302,","        \"Gold\": 50, \"Cerise\": 320]","let colorNames = Array(namedHues.keys)","cacheImages(withNames: colorNames)","","print(colorNames)","\/\/ Prints \"[\"Gold\", \"Cerise\", \"Magenta\", \"Vermillion\"]\""],"type":"codeListing"}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/Array":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":