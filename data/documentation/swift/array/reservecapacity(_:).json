{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/reserveCapacity(_:)","interfaceLanguage":"swift"},"sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reserveCapacity"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"symbolKind":"method","platforms":[{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"8.0","name":"iOS"},{"introducedAt":"8.0","beta":false,"deprecated":false,"name":"iPadOS","unavailable":false},{"introducedAt":"13.0","beta":false,"deprecated":false,"name":"Mac Catalyst","unavailable":false},{"introducedAt":"10.10","beta":false,"deprecated":false,"name":"macOS","unavailable":false},{"introducedAt":"9.0","beta":false,"deprecated":false,"name":"tvOS","unavailable":false},{"introducedAt":"1.0","beta":false,"deprecated":false,"name":"visionOS","unavailable":false},{"introducedAt":"2.0","beta":false,"deprecated":false,"name":"watchOS","unavailable":false}],"title":"reserveCapacity(_:)","extendedModule":"Swift","externalID":"s:Sa15reserveCapacityyySiF","roleHeading":"Instance Method","modules":[{"name":"Standard Library"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reserveCapacity","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"_"},{"text":" ","kind":"text"},{"text":"minimumCapacity","kind":"internalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Int","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The requested number of elements to store."}],"type":"paragraph"}],"name":"minimumCapacity"}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"If you are adding a known number of elements to an array, use this method"},{"type":"text","text":" "},{"text":"to avoid multiple reallocations. This method ensures that the array has","type":"text"},{"text":" ","type":"text"},{"text":"unique, mutable, contiguous storage, with space allocated for at least","type":"text"},{"text":" ","type":"text"},{"text":"the requested number of elements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Calling the ","type":"text"},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"text":" method on an array with bridged storage","type":"text"},{"text":" ","type":"text"},{"text":"triggers a copy to contiguous storage even if the existing storage","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"has room to store "},{"type":"codeVoice","code":"minimumCapacity"},{"type":"text","text":" elements."}],"type":"paragraph"},{"inlineContent":[{"text":"For performance reasons, the size of the newly allocated storage might be","type":"text"},{"text":" ","type":"text"},{"text":"greater than the requested capacity. Use the array’s ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" property","type":"text"},{"text":" ","type":"text"},{"text":"to determine the size of the new storage.","type":"text"}],"type":"paragraph"},{"type":"heading","level":1,"anchor":"Preserving-an-Arrays-Geometric-Growth-Strategy","text":"Preserving an Array’s Geometric Growth Strategy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you implement a custom data structure backed by an array that grows"},{"type":"text","text":" "},{"type":"text","text":"dynamically, naively calling the "},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"text":" method can lead","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to worse than expected performance. Arrays need to follow a geometric"},{"type":"text","text":" "},{"type":"text","text":"allocation pattern for appending elements to achieve amortized"},{"type":"text","text":" "},{"type":"text","text":"constant-time performance. The "},{"code":"Array","type":"codeVoice"},{"text":" type’s ","type":"text"},{"code":"append(_:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"append(contentsOf:)","type":"codeVoice"},{"type":"text","text":" methods take care of this detail for you, but"},{"type":"text","text":" "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" allocates only as much space as you tell it to"},{"type":"text","text":" "},{"type":"text","text":"(padded to a round value), and no more. This avoids over-allocation, but"},{"text":" ","type":"text"},{"type":"text","text":"can result in insertion not having amortized constant-time performance."}]},{"inlineContent":[{"text":"The following code declares ","type":"text"},{"code":"values","type":"codeVoice"},{"text":", an array of integers, and the","type":"text"},{"text":" ","type":"text"},{"code":"addTenQuadratic()","type":"codeVoice"},{"text":" function, which adds ten more values to the ","type":"text"},{"code":"values","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"array on each call."}],"type":"paragraph"},{"type":"codeListing","code":["  var values: [Int] = [0, 1, 2, 3]","","  \/\/ Don't use 'reserveCapacity(_:)' like this","  func addTenQuadratic() {","      let newCount = values.count + 10","      values.reserveCapacity(newCount)","      for n in values.count..<newCount {","          values.append(n)","      }","  }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The call to "},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"type":"text","text":" increases the "},{"type":"codeVoice","code":"values"},{"type":"text","text":" array’s capacity"},{"type":"text","text":" "},{"type":"text","text":"by exactly 10 elements on each pass through "},{"type":"codeVoice","code":"addTenQuadratic()"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"is linear growth. Instead of having constant time when averaged over"},{"type":"text","text":" "},{"text":"many calls, the function may decay to performance that is linear in","type":"text"},{"text":" ","type":"text"},{"code":"values.count","type":"codeVoice"},{"type":"text","text":". This is almost certainly not what you want."}]},{"inlineContent":[{"type":"text","text":"In cases like this, the simplest fix is often to simply remove the call"},{"text":" ","type":"text"},{"type":"text","text":"to "},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"type":"text","text":", and let the "},{"type":"codeVoice","code":"append(_:)"},{"type":"text","text":" method grow the array"},{"type":"text","text":" "},{"text":"for you.","type":"text"}],"type":"paragraph"},{"code":["  func addTen() {","      let newCount = values.count + 10","      for n in values.count..<newCount {","          values.append(n)","      }","  }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need more control over the capacity of your array, implement your"},{"type":"text","text":" "},{"type":"text","text":"own geometric growth strategy, passing the size you compute to"},{"text":" ","type":"text"},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"text":".","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":"), where "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" is the number of elements in the array.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Complexity"}],"kind":"content"}],"seeAlsoSections":[{"title":"Adding Elements","anchor":"Adding-Elements","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/append(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/insert(_:at:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/insert(contentsOf:at:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/replaceSubrange(_:with:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/replaceSubrange(_:with:)-7293p","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/append(addingCapacity:initializingWith:)"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/array\/reservecapacity(_:)"]}],"kind":"symbol","abstract":[{"text":"Reserves enough space to store the specified number of elements.","type":"text"}],"references":{"doc://com.apple.Swift/documentation/Swift/Array/append(_:)":{"abstract":[{"type":"text","text":"Adds a new element at the end of the array."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/append(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"append"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:Sa7Elementxmfp"},{"kind":"text","text":")"}],"title":"append(_:)","url":"\/documentation\/swift\/array\/append(_:)","kind":"symbol","role":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/Swift/Array/replaceSubrange(_:with:)-7293p":{"type":"topic","kind":"symbol","role":"symbol","abstract":[{"text":"Replaces the specified subrange of elements with the given collection.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/replaceSubrange(_:with:)-7293p","title":"replaceSubrange(_:with:)","url":"\/documentation\/swift\/array\/replacesubrange(_:with:)-7293p","fragments":[{"kind":"keyword"