{"abstract":[{"type":"text","text":"Reserves enough space to store the specified number of elements."}],"kind":"symbol","seeAlsoSections":[{"title":"Adding Elements","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/append(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/insert(_:at:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/insert(contentsOf:at:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/replaceSubrange(_:with:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/replaceSubrange(_:with:)-7293p"],"generated":true,"anchor":"Adding-Elements"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/reserveCapacity(_:)"},"metadata":{"modules":[{"name":"Swift"}],"title":"reserveCapacity(_:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"reserveCapacity","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"text":")","kind":"text"}],"role":"symbol","externalID":"s:Sa15reserveCapacityyySiF","platforms":[{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"8.0","name":"iOS"},{"introducedAt":"8.0","name":"iPadOS","beta":false,"deprecated":false,"unavailable":false},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"13.0","name":"Mac Catalyst"},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"10.10","name":"macOS"},{"introducedAt":"9.0","name":"tvOS","beta":false,"deprecated":false,"unavailable":false},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"1.0","name":"visionOS"},{"introducedAt":"2.0","name":"watchOS","beta":false,"deprecated":false,"unavailable":false}],"extendedModule":"Swift","roleHeading":"Instance Method","symbolKind":"method"},"variants":[{"paths":["\/documentation\/swift\/array\/reservecapacity(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reserveCapacity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"minimumCapacity","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"minimumCapacity","content":[{"inlineContent":[{"type":"text","text":"The requested number of elements to store."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"If you are adding a known number of elements to an array, use this method","type":"text"},{"text":" ","type":"text"},{"text":"to avoid multiple reallocations. This method ensures that the array has","type":"text"},{"text":" ","type":"text"},{"text":"unique, mutable, contiguous storage, with space allocated for at least","type":"text"},{"text":" ","type":"text"},{"text":"the requested number of elements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Calling the ","type":"text"},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"text":" method on an array with bridged storage","type":"text"},{"text":" ","type":"text"},{"text":"triggers a copy to contiguous storage even if the existing storage","type":"text"},{"text":" ","type":"text"},{"text":"has room to store ","type":"text"},{"code":"minimumCapacity","type":"codeVoice"},{"text":" elements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For performance reasons, the size of the newly allocated storage might be","type":"text"},{"text":" ","type":"text"},{"text":"greater than the requested capacity. Use the array’s ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" property","type":"text"},{"text":" ","type":"text"},{"text":"to determine the size of the new storage.","type":"text"}],"type":"paragraph"},{"anchor":"Preserving-an-Arrays-Geometric-Growth-Strategy","text":"Preserving an Array’s Geometric Growth Strategy","level":1,"type":"heading"},{"inlineContent":[{"text":"If you implement a custom data structure backed by an array that grows","type":"text"},{"text":" ","type":"text"},{"text":"dynamically, naively calling the ","type":"text"},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"text":" method can lead","type":"text"},{"text":" ","type":"text"},{"text":"to worse than expected performance. Arrays need to follow a geometric","type":"text"},{"text":" ","type":"text"},{"text":"allocation pattern for appending elements to achieve amortized","type":"text"},{"text":" ","type":"text"},{"text":"constant-time performance. The ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" type’s ","type":"text"},{"code":"append(_:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"append(contentsOf:)","type":"codeVoice"},{"text":" methods take care of this detail for you, but","type":"text"},{"text":" ","type":"text"},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"text":" allocates only as much space as you tell it to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"(padded to a round value), and no more. This avoids over-allocation, but"},{"type":"text","text":" "},{"type":"text","text":"can result in insertion not having amortized constant-time performance."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following code declares "},{"type":"codeVoice","code":"values"},{"type":"text","text":", an array of integers, and the"},{"type":"text","text":" "},{"code":"addTenQuadratic()","type":"codeVoice"},{"type":"text","text":" function, which adds ten more values to the "},{"type":"codeVoice","code":"values"},{"text":" ","type":"text"},{"text":"array on each call.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["  var values: [Int] = [0, 1, 2, 3]","","  \/\/ Don't use 'reserveCapacity(_:)' like this","  func addTenQuadratic() {","      let newCount = values.count + 10","      values.reserveCapacity(newCount)","      for n in values.count..<newCount {","          values.append(n)","      }","  }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The call to ","type":"text"},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"text":" increases the ","type":"text"},{"code":"values","type":"codeVoice"},{"text":" array’s capacity","type":"text"},{"text":" ","type":"text"},{"text":"by exactly 10 elements on each pass through ","type":"text"},{"code":"addTenQuadratic()","type":"codeVoice"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"is linear growth. Instead of having constant time when averaged over","type":"text"},{"text":" ","type":"text"},{"text":"many calls, the function may decay to performance that is linear in","type":"text"},{"text":" ","type":"text"},{"code":"values.count","type":"codeVoice"},{"text":". This is almost certainly not what you want.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In cases like this, the simplest fix is often to simply remove the call","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"text":", and let the ","type":"text"},{"code":"append(_:)","type":"codeVoice"},{"text":" method grow the array","type":"text"},{"text":" ","type":"text"},{"text":"for you.","type":"text"}]},{"type":"codeListing","code":["  func addTen() {","      let newCount = values.count + 10","      for n in values.count..<newCount {","          values.append(n)","      }","  }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If you need more control over the capacity of your array, implement your","type":"text"},{"text":" ","type":"text"},{"text":"own geometric growth strategy, passing the size you compute to","type":"text"},{"text":" ","type":"text"},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is the number of elements in the array.","type":"text"}],"type":"paragraph"}],"name":"Complexity"}]}],"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/Array/replaceSubrange(_:with:)-7293p":{"url":"\/documentation\/swift\/array\/replacesubrange(_:with:)-7293p","kind":"symbol","abstract":[{"text":"Replaces the specified subrange of elements with the given collection.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/replaceSubrange(_:with:)-7293p","title":"replaceSubrange(_:with:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replaceSubrange","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:SmsE15replaceSubrange_4withyqd_0__qd__ntSlRd__SXRd_0_7ElementQyd__ACRtz5BoundQyd_0_5IndexRtzr0_lF1RL_qd_0_mfp","text":"R","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"with","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SmsE15replaceSubrange_4withyqd_0__qd__ntSlRd__SXRd_0_7ElementQyd__ACRtz5BoundQyd_0_5IndexRtzr0_lF1CL_qd__mfp","text":"C","kind":"typeIdentifier"},{"text":")",