{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/reserveCapacity(_:)"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array"]]},"metadata":{"externalID":"s:Sa15reserveCapacityyySiF","extendedModule":"Swift","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"reserveCapacity"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"modules":[{"name":"Standard Library"}],"platforms":[{"name":"iOS","deprecated":false,"beta":false,"unavailable":false,"introducedAt":"8.0"},{"name":"iPadOS","deprecated":false,"beta":false,"unavailable":false,"introducedAt":"8.0"},{"unavailable":false,"introducedAt":"13.0","deprecated":false,"beta":false,"name":"Mac Catalyst"},{"unavailable":false,"introducedAt":"10.10","deprecated":false,"beta":false,"name":"macOS"},{"name":"tvOS","deprecated":false,"beta":false,"unavailable":false,"introducedAt":"9.0"},{"unavailable":false,"introducedAt":"1.0","deprecated":false,"beta":false,"name":"visionOS"},{"unavailable":false,"introducedAt":"2.0","deprecated":false,"beta":false,"name":"watchOS"}],"title":"reserveCapacity(_:)","roleHeading":"Instance Method","role":"symbol"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Reserves enough space to store the specified number of elements."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reserveCapacity"},{"kind":"text","text":"("},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"text":"minimumCapacity","kind":"internalParam"},{"kind":"text","text":": "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"name":"minimumCapacity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The requested number of elements to store."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you are adding a known number of elements to an array, use this method"},{"type":"text","text":" "},{"type":"text","text":"to avoid multiple reallocations. This method ensures that the array has"},{"type":"text","text":" "},{"type":"text","text":"unique, mutable, contiguous storage, with space allocated for at least"},{"type":"text","text":" "},{"type":"text","text":"the requested number of elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calling the "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" method on an array with bridged storage"},{"type":"text","text":" "},{"type":"text","text":"triggers a copy to contiguous storage even if the existing storage"},{"type":"text","text":" "},{"type":"text","text":"has room to store "},{"type":"codeVoice","code":"minimumCapacity"},{"type":"text","text":" elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For performance reasons, the size of the newly allocated storage might be"},{"type":"text","text":" "},{"type":"text","text":"greater than the requested capacity. Use the array’s "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" property"},{"type":"text","text":" "},{"type":"text","text":"to determine the size of the new storage."}]},{"type":"heading","level":1,"anchor":"Preserving-an-Arrays-Geometric-Growth-Strategy","text":"Preserving an Array’s Geometric Growth Strategy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you implement a custom data structure backed by an array that grows"},{"type":"text","text":" "},{"type":"text","text":"dynamically, naively calling the "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" method can lead"},{"type":"text","text":" "},{"type":"text","text":"to worse than expected performance. Arrays need to follow a geometric"},{"type":"text","text":" "},{"type":"text","text":"allocation pattern for appending elements to achieve amortized"},{"type":"text","text":" "},{"type":"text","text":"constant-time performance. The "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" type’s "},{"type":"codeVoice","code":"append(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"append(contentsOf:)"},{"type":"text","text":" methods take care of this detail for you, but"},{"type":"text","text":" "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" allocates only as much space as you tell it to"},{"type":"text","text":" "},{"type":"text","text":"(padded to a round value), and no more. This avoids over-allocation, but"},{"type":"text","text":" "},{"type":"text","text":"can result in insertion not having amortized constant-time performance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following code declares "},{"type":"codeVoice","code":"values"},{"type":"text","text":", an array of integers, and the"},{"type":"text","text":" "},{"type":"codeVoice","code":"addTenQuadratic()"},{"type":"text","text":" function, which adds ten more values to the "},{"type":"codeVoice","code":"values"},{"type":"text","text":" "},{"type":"text","text":"array on each call."}]},{"type":"codeListing","syntax":"swift","code":["  var values: [Int] = [0, 1, 2, 3]","","  \/\/ Don't use 'reserveCapacity(_:)' like this","  func addTenQuadratic() {","      let newCount = values.count + 10","      values.reserveCapacity(newCount)","      for n in values.count..<newCount {","          values.append(n)","      }","  }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The call to "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" increases the "},{"type":"codeVoice","code":"values"},{"type":"text","text":" array’s capacity"},{"type":"text","text":" "},{"type":"text","text":"by exactly 10 elements on each pass through "},{"type":"codeVoice","code":"addTenQuadratic()"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"is linear growth. Instead of having constant time when averaged over"},{"type":"text","text":" "},{"type":"text","text":"many calls, the function may decay to performance that is linear in"},{"type":"text","text":" "},{"type":"codeVoice","code":"values.count"},{"type":"text","text":". This is almost certainly not what you want."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In cases like this, the simplest fix is often to simply remove the call"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":", and let the "},{"type":"codeVoice","code":"append(_:)"},{"type":"text","text":" method grow the array"},{"type":"text","text":" "},{"type":"text","text":"for you."}]},{"type":"codeListing","syntax":"swift","code":["  func addTen() {","      let newCount = values.count + 10","      for n in values.count..<newCount {","          values.append(n)","      }","  }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need more control over the capacity of your array, implement your"},{"type":"text","text":" "},{"type":"text","text":"own geometric growth strategy, passing the size you compute to"},{"type":"text","text":" "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":"."}]},{"name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" is the number of elements in the array."}]}],"style":"note"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/append(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/insert(_:at:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/insert(contentsOf:at:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/replaceSubrange(_:with:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/replaceSubrange(_:with:)-7293p","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/append(addingCapacity:initializingWith:)"],"title":"Adding Elements","generated":true,"anchor":"Adding-Elements"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/array\/reservecapacity(_:)"]}],"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/Array/replaceSubrange(_:with:)":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replaceSubrange","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:Sn","text":"Range","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"with","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sa15replaceSubrange_4withySnySiG_qd__nt7ElementQyd__RszSlRd__lF1CL_qd__mfp","text":"C","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"Replaces a range of elements with the elements in the specified"},{"type":"text","text":" "},{"type":"text","text":"collection."}],"type":"topic","title":"replaceSubrange(_:with:)","url":"\/documentation\/swift\/array\/replacesubrange(_:with:)","identifier":"doc:\/\/com.apple.Swift\/do