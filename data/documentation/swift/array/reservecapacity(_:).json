{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reserveCapacity"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"minimumCapacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"minimumCapacity","content":[{"inlineContent":[{"text":"The requested number of elements to store.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you are adding a known number of elements to an array, use this method"},{"type":"text","text":" "},{"type":"text","text":"to avoid multiple reallocations. This method ensures that the array has"},{"type":"text","text":" "},{"type":"text","text":"unique, mutable, contiguous storage, with space allocated for at least"},{"type":"text","text":" "},{"type":"text","text":"the requested number of elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calling the "},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"type":"text","text":" method on an array with bridged storage"},{"type":"text","text":" "},{"type":"text","text":"triggers a copy to contiguous storage even if the existing storage"},{"type":"text","text":" "},{"type":"text","text":"has room to store "},{"code":"minimumCapacity","type":"codeVoice"},{"type":"text","text":" elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For performance reasons, the size of the newly allocated storage might be"},{"type":"text","text":" "},{"type":"text","text":"greater than the requested capacity. Use the array’s "},{"code":"capacity","type":"codeVoice"},{"type":"text","text":" property"},{"type":"text","text":" "},{"type":"text","text":"to determine the size of the new storage."}]},{"type":"heading","text":"Preserving an Array’s Geometric Growth Strategy","anchor":"Preserving-an-Arrays-Geometric-Growth-Strategy","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you implement a custom data structure backed by an array that grows"},{"type":"text","text":" "},{"type":"text","text":"dynamically, naively calling the "},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"type":"text","text":" method can lead"},{"type":"text","text":" "},{"type":"text","text":"to worse than expected performance. Arrays need to follow a geometric"},{"type":"text","text":" "},{"type":"text","text":"allocation pattern for appending elements to achieve amortized"},{"type":"text","text":" "},{"type":"text","text":"constant-time performance. The "},{"code":"Array","type":"codeVoice"},{"type":"text","text":" type’s "},{"code":"append(_:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"append(contentsOf:)","type":"codeVoice"},{"type":"text","text":" methods take care of this detail for you, but"},{"type":"text","text":" "},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"type":"text","text":" allocates only as much space as you tell it to"},{"type":"text","text":" "},{"type":"text","text":"(padded to a round value), and no more. This avoids over-allocation, but"},{"type":"text","text":" "},{"type":"text","text":"can result in insertion not having amortized constant-time performance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following code declares "},{"code":"values","type":"codeVoice"},{"type":"text","text":", an array of integers, and the"},{"type":"text","text":" "},{"code":"addTenQuadratic()","type":"codeVoice"},{"type":"text","text":" function, which adds ten more values to the "},{"code":"values","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"array on each call."}]},{"type":"codeListing","syntax":"swift","code":["  var values: [Int] = [0, 1, 2, 3]","","  \/\/ Don't use 'reserveCapacity(_:)' like this","  func addTenQuadratic() {","      let newCount = values.count + 10","      values.reserveCapacity(newCount)","      for n in values.count..<newCount {","          values.append(n)","      }","  }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The call to "},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"type":"text","text":" increases the "},{"code":"values","type":"codeVoice"},{"type":"text","text":" array’s capacity"},{"type":"text","text":" "},{"type":"text","text":"by exactly 10 elements on each pass through "},{"code":"addTenQuadratic()","type":"codeVoice"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"is linear growth. Instead of having constant time when averaged over"},{"type":"text","text":" "},{"type":"text","text":"many calls, the function may decay to performance that is linear in"},{"type":"text","text":" "},{"type":"codeVoice","code":"values.count"},{"type":"text","text":". This is almost certainly not what you want."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In cases like this, the simplest fix is often to simply remove the call"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":", and let the "},{"type":"codeVoice","code":"append(_:)"},{"type":"text","text":" method grow the array"},{"type":"text","text":" "},{"type":"text","text":"for you."}]},{"type":"codeListing","syntax":"swift","code":["  func addTen() {","      let newCount = values.count + 10","      for n in values.count..<newCount {","          values.append(n)","      }","  }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need more control over the capacity of your array, implement your"},{"type":"text","text":" "},{"type":"text","text":"own geometric growth strategy, passing the size you compute to"},{"type":"text","text":" "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":"."}]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" is the number of elements in the array.","type":"text"}]}]}],"kind":"content"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/reserveCapacity(_:)"},"seeAlsoSections":[{"generated":true,"title":"Adding Elements","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/append(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/insert(_:at:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/insert(contentsOf:at:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/replaceSubrange(_:with:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/replaceSubrange(_:with:)-7293p"],"anchor":"Adding-Elements"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Reserves enough space to store the specified number of elements."}],"sections":[],"metadata":{"role":"symbol","modules":[{"name":"Swift"}],"title":"reserveCapacity(_:)","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reserveCapacity","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}],"roleHeading":"Instance Method","externalID":"s:Sa15reserveCap