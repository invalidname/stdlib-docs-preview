{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/array\/sort(by:)"]}],"sections":[],"abstract":[{"text":"Sorts the collection in place, using the given predicate as the","type":"text"},{"text":" ","type":"text"},{"text":"comparison between elements.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/sort()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/sorted()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/sorted(by:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/reverse()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/reversed()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/shuffle()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/shuffle(using:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/shuffled()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/shuffled(using:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/partition(by:)-90po8","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/swapAt(_:_:)"],"generated":true,"anchor":"Reordering-an-Arrays-Elements","title":"Reordering an Array’s Elements"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/sort(by:)"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"mutating"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sort","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"areInIncreasingOrder","kind":"internalParam"},{"text":": (","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomAccessCollection\/Element","prec