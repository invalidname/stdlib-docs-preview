ementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/Equatable-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/ExpressibleByArrayLiteral-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/Hashable-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/MutableCollection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/RandomAccessCollection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/RangeReplaceableCollection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/Sequence-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"text":"ArraySlice","kind":"identifier"}],"externalID":"s:s10ArraySliceV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArraySlice","kind":"identifier"}],"platforms":[{"unavailable":false,"introducedAt":"8.0","name":"iOS","beta":false,"deprecated":false},{"unavailable":false,"introducedAt":"8.0","name":"iPadOS","beta":false,"deprecated":false},{"unavailable":false,"introducedAt":"13.0","name":"Mac Catalyst","beta":false,"deprecated":false},{"unavailable":false,"introducedAt":"10.10","name":"macOS","beta":false,"deprecated":false},{"unavailable":false,"introducedAt":"9.0","name":"tvOS","beta":false,"deprecated":false},{"unavailable":false,"introducedAt":"1.0","name":"visionOS","beta":false,"deprecated":false},{"unavailable":false,"introducedAt":"2.0","name":"watchOS","beta":false,"deprecated":false}],"role":"symbol","modules":[{"name":"Standard Library"}],"title":"ArraySlice"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice"},"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral","doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","doc:\/\/com.apple.Swift\/documentation\/Swift\/MutableCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomAccessCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/RangeReplaceableCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"],"generated":true,"title":"Related Array Types","anchor":"Related-Array-Types"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArraySlice","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" type makes it fast and efficient for you to perform"},{"type":"text","text":" "},{"type":"text","text":"operations on sections of a larger array. Instead of copying over the"},{"type":"text","text":" "},{"type":"text","text":"elements of a slice to new storage, an "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" instance presents a"},{"type":"text","text":" "},{"type":"text","text":"view onto the storage of a larger array. And because "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" "},{"type":"text","text":"presents the same interface as "},{"type":"codeVoice","code":"Array"},{"type":"text","text":", you can generally perform the"},{"type":"text","text":" "},{"type":"text","text":"same operations on a slice as you could on the original array."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information about using arrays, see "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ContiguousArray"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"with which "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" shares most properties and methods."}]},{"text":"Slices Are Views onto Arrays","type":"heading","level":1,"anchor":"Slices-Are-Views-onto-Arrays"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, suppose you have an array holding the number of absences"},{"type":"text","text":" "},{"type":"text","text":"from each class during a session."}]},{"type":"codeListing","syntax":"swift","code":["let absences = [0, 2, 0, 4, 0, 3, 1, 0]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You want to compare the absences in the first half of the session with"},{"type":"text","text":" "},{"type":"text","text":"those in the second half. To do so, start by creating two slices of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array."}]},{"type":"codeListing","syntax":"swift","code":["let midpoint = absences.count \/ 2","","let firstHalf = absences[..<midpoint]","let secondHalf = absences[midpoint...]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Neither the "},{"type":"codeVoice","code":"firstHalf"},{"type":"text","text":" nor "},{"type":"codeVoice","code":"secondHalf"},{"type":"text","text":" slices allocate any new storage"},{"type":"text","text":" "},{"type":"text","text":"of their own. Instead, each presents a view onto the storage of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can call any method on the slices that you might have called on the"},{"type":"text","text":" "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array. To learn which half had more absences, use the"},{"type":"text","text":" "},{"type":"codeVoice","code":"reduce(_:_:)"},{"type":"text","text":" method to calculate each sum."}]},{"type":"codeListing","syntax":"swift","code":["let firstHalfSum = firstHalf.reduce(0, +)","let secondHalfSum = secondHalf.reduce(0, +)","","if firstHalfSum > secondHalfSum {","    print(\"More absences in the first half.\")","} else {","    print(\"More absences in the second half.\")","}","\/\/ Prints \"More absences in the first half.\""]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Long-term storage of ","type":"text"},{"type":"codeVoice","code":"ArraySlice"},{"text":" instances is discouraged. A","type":"text"},{"text":" ","type":"text"},{"text":"slice holds a reference to the entire storage of a larger array, not","type":"text"},{"text":" ","type":"text"},{"text":"just to the portion it presents, even after the original array’s lifetime","type":"text"},{"text":" ","type":"text"},{"text":"ends. Long-term storage of a slice may therefore prolong the lifetime of","type":"text"},{"text":" ","type":"text"},{"text":"elements that are no longer otherwise accessible, which can appear to be","type":"text"},{"text":" ","type":"text"},{"text":"memory and object leakage.","type":"text"}]}],"name":"Important","type":"aside","style":"important"},{"text":"Slices Maintain Indices","type":"heading","level":1,"anchor":"Slices-Maintain-Indices"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ContiguousArray"},{"type":"text","text":", the starting index for an"},{"type":"text","text":" "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" instance isn’t always zero. Slices maintain the same"},{"type":"text","text":" "},{"type":"text","text":"indices of the larger array for the same elements, so the starting"},{"type":"text","text":" "},{"type":"text","text":"index of a slice depends on how it was created, letting you perform"},{"type":"text","text":" "},{"type":"text","text":"index-based operations on either a full array or a slice."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sharing indices between collections and their subsequences is an important"},{"type":"text","text":" "},{"type":"text","text":"part of the design of Swift’s collection algorithms. Suppose you are"},{"type":"text","text":" "},{"type":"text","text":"tasked with finding the first two days with absences in the session. To"},{"type":"text","text":" "},{"type":"text","text":"find the indices of the two days in question, follow these steps:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"firstIndex(where:)"},{"type":"text","text":" to find the index of the first element in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array that is greater than zero."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a slice of the "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array starting after the index found in"},{"type":"text","text":" "},{"type":"text","text":"step 1."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"firstIndex(where:)"},{"type":"text","text":" again, this time on the slice created in step"},{"type":"text","text":" "},{"type":"text","text":"2. Where in some languages you might pass a starting index into an"},{"type":"text","text":" "},{"type":"codeVoice","code":"indexOf"},{"type":"text","text":" method to find the second day, in Swift you perform the same"},{"type":"text","text":" "},{"type":"text","text":"operation on a slice of the original array."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Print the results using the indices found in steps 1 and 3 on the"},{"type":"text","text":" "},{"type":"text","text":"original "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s an implementation of those steps:"}]},{"type":"codeListing","syntax":"swift","code":["if let i = absences.firstIndex(where: { $0 > 0 }) {                 \/\/ 1","    let absencesAfterFirst = absences[(i + 1)...]                   \/\/ 2","    if let j = absencesAfterFirst.firstIndex(where: { $0 > 0 }) {   \/\/ 3","        print(\"The first day with absences had \\(absences[i]).\")    \/\/ 4","        print(\"The second day with absences had \\(absences[j]).\")","    }","}","\/\/ Prints \"The first day with absences had 2.\"","\/\/ Prints \"The second day with absences had 4.\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In particular, note that "},{"type":"codeVoice","code":"j"},{"type":"text","text":", the index of the second day with absences,"},{"type":"text","text":" "},{"type":"text","text":"was found in a slice of the original array and then used to access a value"},{"type":"text","text":" "},{"type":"text","text":"in the original "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array itself."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"To safely reference the starting and ending indices of a slice,","type":"text"},{"text":" ","type":"text"},{"text":"always use the ","type":"text"},{"type":"codeVoice","code":"startIndex"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"endIndex"},{"text":" properties instead of","type":"text"},{"text":" ","type":"text"},{"text":"specific values.","type":"text"}]}],"name":"Note","type":"aside","style":"note"}]}],"variants":[{"paths":["\/documentation\/swift\/arrayslice"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/ArraySlice/insert(_:at:)":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/insert(_:at:)","abstract":[{"type":"text","text":"Inserts a new element at the specified position."}],"role":"symbol","title":"insert(_:at:)","kind":"symbol","url":"\/documentation\/swift\/arrayslice\/insert(_:at:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"preciseIdentifier":"s:s10ArraySliceV7Elementxmfp","kind":"typeIdentifier","text":"Element"},{"kind":"text","text":", "},{"kind":"externalParam","text":"at"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":")"}]},"doc://com.apple.Swift/documentation/Swift/ArraySlice/MutableCollection-Implementations":{"role":"collectionGroup","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/MutableCollection-Implementations","abstract":[],"title":"MutableCollection Implementations","type":"topic","url":"\/documentation\/swift\/arrayslice\/mutablecollection-implementations","kind":"article"},"doc://com.apple.Swift/documentation/Swift/CustomDebugStringConvertible":{"type":"topic","abstract":[{"type":"text","text":"A type with a customized textual representation suitable for debugging"