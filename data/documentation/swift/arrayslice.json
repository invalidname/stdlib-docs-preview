Catalyst","unavailable":false,"introducedAt":"13.0","deprecated":false,"beta":false},{"name":"macOS","unavailable":false,"introducedAt":"10.10","deprecated":false,"beta":false},{"name":"tvOS","unavailable":false,"introducedAt":"9.0","deprecated":false,"beta":false},{"name":"visionOS","unavailable":false,"introducedAt":"1.0","deprecated":false,"beta":false},{"name":"watchOS","unavailable":false,"introducedAt":"2.0","deprecated":false,"beta":false}],"modules":[{"name":"Swift"}],"externalID":"s:s10ArraySliceV","roleHeading":"Structure","symbolKind":"struct","role":"symbol","title":"ArraySlice","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArraySlice","kind":"identifier"}],"navigatorTitle":[{"text":"ArraySlice","kind":"identifier"}]},"sections":[],"abstract":[{"text":"A slice of an ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ContiguousArray","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"ArraySlice","type":"codeVoice"},{"text":" instance.","type":"text"}],"seeAlsoSections":[{"title":"Related Array Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"],"anchor":"Related-Array-Types","generated":true}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArraySlice","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" type makes it fast and efficient for you to perform"},{"type":"text","text":" "},{"type":"text","text":"operations on sections of a larger array. Instead of copying over the"},{"type":"text","text":" "},{"type":"text","text":"elements of a slice to new storage, an "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" instance presents a"},{"type":"text","text":" "},{"type":"text","text":"view onto the storage of a larger array. And because "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" "},{"type":"text","text":"presents the same interface as "},{"type":"codeVoice","code":"Array"},{"type":"text","text":", you can generally perform the"},{"type":"text","text":" "},{"type":"text","text":"same operations on a slice as you could on the original array."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information about using arrays, see "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ContiguousArray"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"with which "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" shares most properties and methods."}]},{"text":"Slices Are Views onto Arrays","level":1,"anchor":"Slices-Are-Views-onto-Arrays","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, suppose you have an array holding the number of absences"},{"type":"text","text":" "},{"type":"text","text":"from each class during a session."}]},{"code":["let absences = [0, 2, 0, 4, 0, 3, 1, 0]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You want to compare the absences in the first half of the session with"},{"type":"text","text":" "},{"type":"text","text":"those in the second half. To do so, start by creating two slices of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array."}]},{"code":["let midpoint = absences.count \/ 2","","let firstHalf = absences[..<midpoint]","let secondHalf = absences[midpoint...]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Neither the "},{"type":"codeVoice","code":"firstHalf"},{"type":"text","text":" nor "},{"type":"codeVoice","code":"secondHalf"},{"type":"text","text":" slices allocate any new storage"},{"type":"text","text":" "},{"type":"text","text":"of their own. Instead, each presents a view onto the storage of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can call any method on the slices that you might have called on the"},{"type":"text","text":" "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array. To learn which half had more absences, use the"},{"type":"text","text":" "},{"type":"codeVoice","code":"reduce(_:_:)"},{"type":"text","text":" method to calculate each sum."}]},{"code":["let firstHalfSum = firstHalf.reduce(0, +)","let secondHalfSum = secondHalf.reduce(0, +)","","if firstHalfSum > secondHalfSum {","    print(\"More absences in the first half.\")","} else {","    print(\"More absences in the second half.\")","}","\/\/ Prints \"More absences in the first half.\""],"type":"codeListing","syntax":"swift"},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Long-term storage of "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" instances is discouraged. A"},{"type":"text","text":" "},{"type":"text","text":"slice holds a reference to the entire storage of a larger array, not"},{"type":"text","text":" "},{"type":"text","text":"just to the portion it presents, even after the original array’s lifetime"},{"type":"text","text":" "},{"type":"text","text":"ends. Long-term storage of a slice may therefore prolong the lifetime of"},{"type":"text","text":" "},{"type":"text","text":"elements that are no longer otherwise accessible, which can appear to be"},{"type":"text","text":" "},{"type":"text","text":"memory and object leakage."}]}]},{"text":"Slices Maintain Indices","level":1,"anchor":"Slices-Maintain-Indices","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ContiguousArray"},{"type":"text","text":", the starting index for an"},{"type":"text","text":" "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" instance isn’t always zero. Slices maintain the same"},{"type":"text","text":" "},{"type":"text","text":"indices of the larger array for the same elements, so the starting"},{"type":"text","text":" "},{"type":"text","text":"index of a slice depends on how it was created, letting you perform"},{"type":"text","text":" "},{"type":"text","text":"index-based operations on either a full array or a slice."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sharing indices between collections and their subsequences is an important"},{"type":"text","text":" "},{"type":"text","text":"part of the design of Swift’s collection algorithms. Suppose you are"},{"type":"text","text":" "},{"type":"text","text":"tasked with finding the first two days with absences in the session. To"},{"type":"text","text":" "},{"type":"text","text":"find the indices of the two days in question, follow these steps:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"code":"firstIndex(where:)","type":"codeVoice"},{"type":"text","text":" to find the index of the first element in the"},{"type":"text","text":" "},{"code":"absences","type":"codeVoice"},{"type":"text","text":" array that is greater than zero."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a slice of the "},{"code":"absences","type":"codeVoice"},{"type":"text","text":" array starting after the index found in"},{"type":"text","text":" "},{"type":"text","text":"step 1."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"code":"firstIndex(where:)","type":"codeVoice"},{"type":"text","text":" again, this time on the slice created in step"},{"type":"text","text":" "},{"type":"text","text":"2. Where in some languages you might pass a starting index into an"},{"type":"text","text":" "},{"code":"indexOf","type":"codeVoice"},{"type":"text","text":" method to find the second day, in Swift you perform the same"},{"type":"text","text":" "},{"type":"text","text":"operation on a slice of the original array."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Print the results using the indices found in steps 1 and 3 on the"},{"type":"text","text":" "},{"type":"text","text":"original "},{"code":"absences","type":"codeVoice"},{"type":"text","text":" array."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s an implementation of those steps:"}]},{"code":["if let i = absences.firstIndex(where: { $0 > 0 }) {                 \/\/ 1","    let absencesAfterFirst = absences[(i + 1)...]                   \/\/ 2","    if let j = absencesAfterFirst.firstIndex(where: { $0 > 0 }) {   \/\/ 3","        print(\"The first day with absences had \\(absences[i]).\")    \/\/ 4","        print(\"The second day with absences had \\(absences[j]).\")","    }","}","\/\/ Prints \"The first day with absences had 2.\"","\/\/ Prints \"The second day with absences had 4.\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In particular, note that "},{"type":"codeVoice","code":"j"},{"type":"text","text":", the index of the second day with absences,"},{"type":"text","text":" "},{"type":"text","text":"was found in a slice of the original array and then used to access a value"},{"type":"text","text":" "},{"type":"text","text":"in the original "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array itself."}]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"To safely reference the starting and ending indices of a slice,"},{"type":"text","text":" "},{"type":"text","text":"always use the "},{"type":"codeVoice","code":"startIndex"},{"type":"text","text":" and "},{"type":"codeVoice","code":"endIndex"},{"type":"text","text":" properties instead of"},{"type":"text","text":" "},{"type":"text","text":"specific values."}]}]}]}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/ArraySlice/withUnsafeMutableBytes(_:)":{"url":"\/documentation\/swift\/arrayslice\/withunsafemutablebytes(_:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/withUnsafeMutableBytes(_:)","abstract":[{"type":"text","text":"Calls the given closure with a pointer to the underlying bytes of the"},{"type":"text","text":" "},{"type":"text","text":"array’s mutable contiguous storage."}],"role":"symbol","type":"topic","title":"withUnsafeMutableBytes(_:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"withUnsafeMutableBytes"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"R"},{"text":">((","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sw","text":"UnsafeMutableRawBufferPointer"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"text":"R","kind":"typeIdentifier","preciseIdentifier":"s:s10ArraySliceV22withUnsafeMutableBytesyqd__qd__SwKXEKlF1RL_qd__mfp"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"R","kind":"typeIdentifier","preciseIdentifier":"s:s10ArraySliceV22withUnsafeMutableBytesyqd__qd__SwKXEKlF1RL_qd__mfp"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/ArraySlice/CustomReflect