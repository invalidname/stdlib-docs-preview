{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"seeAlsoSections":[{"title":"Related Array Types","anchor":"Related-Array-Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"],"generated":true}],"abstract":[{"type":"text","text":"A slice of an "},{"type":"codeVoice","code":"Array"},{"type":"text","text":", "},{"type":"codeVoice","code":"ContiguousArray"},{"type":"text","text":", or "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" instance."}],"metadata":{"title":"ArraySlice","role":"symbol","modules":[{"name":"Swift"}],"externalID":"s:s10ArraySliceV","navigatorTitle":[{"kind":"identifier","text":"ArraySlice"}],"platforms":[{"name":"iOS","introducedAt":"8.0","beta":false,"unavailable":false,"deprecated":false},{"name":"iPadOS","introducedAt":"8.0","beta":false,"unavailable":false,"deprecated":false},{"name":"Mac Catalyst","introducedAt":"13.0","beta":false,"unavailable":false,"deprecated":false},{"name":"macOS","introducedAt":"10.10","beta":false,"unavailable":false,"deprecated":false},{"name":"tvOS","introducedAt":"9.0","beta":false,"unavailable":false,"deprecated":false},{"name":"visionOS","introducedAt":"1.0","beta":false,"unavailable":false,"deprecated":false},{"name":"watchOS","introducedAt":"2.0","beta":false,"unavailable":false,"deprecated":false}],"roleHeading":"Structure","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ArraySlice"}]},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Escapable","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral","doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","doc:\/\/com.apple.Swift\/documentation\/Swift\/MutableCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomAccessCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/RangeReplaceableCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"],"type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArraySlice","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"ArraySlice"},{"text":" type makes it fast and efficient for you to perform","type":"text"},{"text":" ","type":"text"},{"text":"operations on sections of a larger array. Instead of copying over the","type":"text"},{"text":" ","type":"text"},{"text":"elements of a slice to new storage, an ","type":"text"},{"type":"codeVoice","code":"ArraySlice"},{"text":" instance presents a","type":"text"},{"text":" ","type":"text"},{"text":"view onto the storage of a larger array. And because ","type":"text"},{"type":"codeVoice","code":"ArraySlice"},{"text":" ","type":"text"},{"text":"presents the same interface as ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":", you can generally perform the","type":"text"},{"text":" ","type":"text"},{"text":"same operations on a slice as you could on the original array.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For more information about using arrays, see ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"ContiguousArray"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"with which ","type":"text"},{"type":"codeVoice","code":"ArraySlice"},{"text":" shares most properties and methods.","type":"text"}]},{"type":"heading","text":"Slices Are Views onto Arrays","anchor":"Slices-Are-Views-onto-Arrays","level":1},{"type":"paragraph","inlineContent":[{"text":"For example, suppose you have an array holding the number of absences","type":"text"},{"text":" ","type":"text"},{"text":"from each class during a session.","type":"text"}]},{"type":"codeListing","code":["let absences = [0, 2, 0, 4, 0, 3, 1, 0]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"You want to compare the absences in the first half of the session with","type":"text"},{"text":" ","type":"text"},{"text":"those in the second half. To do so, start by creating two slices of the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"absences"},{"text":" array.","type":"text"}]},{"type":"codeListing","code":["let midpoint = absences.count \/ 2","","let firstHalf = absences[..<midpoint]","let secondHalf = absences[midpoint...]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Neither the ","type":"text"},{"type":"codeVoice","code":"firstHalf"},{"text":" nor ","type":"text"},{"type":"codeVoice","code":"secondHalf"},{"text":" slices allocate any new storage","type":"text"},{"text":" ","type":"text"},{"text":"of their own. Instead, each presents a view onto the storage of the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"absences"},{"text":" array.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can call any method on the slices that you might have called on the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"absences"},{"text":" array. To learn which half had more absences, use the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"reduce(_:_:)"},{"text":" method to calculate each sum.","type":"text"}]},{"type":"codeListing","code":["let firstHalfSum = firstHalf.reduce(0, +)","let secondHalfSum = secondHalf.reduce(0, +)","","if firstHalfSum > secondHalfSum {","    print(\"More absences in the first half.\")","} else {","    print(\"More absences in the second half.\")","}","\/\/ Prints \"More absences in the first half.\""],"syntax":"swift"},{"type":"aside","name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Long-term storage of "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" instances is discouraged. A"},{"type":"text","text":" "},{"type":"text","text":"slice holds a reference to the entire storage of a larger array, not"},{"type":"text","text":" "},{"type":"text","text":"just to the portion it presents, even after the original array’s lifetime"},{"type":"text","text":" "},{"type":"text","text":"ends. Long-term storage of a slice may therefore prolong the lifetime of"},{"type":"text","text":" "},{"type":"text","text":"elements that are no longer otherwise accessible, which can appear to be"},{"type":"text","text":" "},{"type":"text","text":"memory and object leakage."}]}]},{"type":"heading","text":"Slices Maintain Indices","anchor":"Slices-Maintain-Indices","level":1},{"type":"paragraph","inlineContent":[{"text":"Unlike ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"ContiguousArray"},{"text":", the starting index for an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ArraySlice"},{"text":" instance isn’t always zero. Slices maintain the same","type":"text"},{"text":" ","type":"text"},{"text":"indices of the larger array for the same elements, so the starting","type":"text"},{"text":" ","type":"text"},{"text":"index of a slice depends on how it was created, letting you perform","type":"text"},{"text":" ","type":"text"},{"text":"index-based operations on either a full array or a slice.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sharing indices between collections and their subsequences is an important"},{"type":"text","text":" "},{"type":"text","text":"part of the design of Swift’s collection algorithms. Suppose you are"},{"type":"text","text":" "},{"type":"text","text":"tasked with finding the first two days with absences in the session. To"},{"type":"text","text":" "},{"type":"text","text":"find the indices of the two days in question, follow these steps:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Call ","type":"text"},{"type":"codeVoice","code":"firstIndex(where:)"},{"text":" to find the index of the first element in the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"absences"},{"text":" array that is greater than zero.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a slice of the "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array starting after the index found in"},{"type":"text","text":" "},{"type":"text","text":"step 1."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"firstIndex(where:)"},{"type":"text","text":" again, this time on the slice created in step"},{"type":"text","text":" "},{"type":"text","text":"2. Where in some languages you might pass a starting index into an"},{"type":"text","text":" "},{"type":"codeVoice","code":"indexOf"},{"type":"text","text":" method to find the second day, in Swift you perform the same"},{"type":"text","text":" "},{"type":"text","text":"operation on a slice of the original array."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Print the results using the indices found in steps 1 and 3 on the"},{"type":"text","text":" "},{"type":"text","text":"original "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Here’s an implementation of those steps:","type":"text"}]},{"type":"codeListing","code":["if let i = absences.firstIndex(where: { $0 > 0 }) {                 \/\/ 1","    let absencesAfterFirst = absences[(i + 1)...]                   \/\/ 2","    if let j = absencesAfterFirst.firstIndex(where: { $0 > 0 }) {   \/\/ 3","        print(\"The first day with absences had \\(absences[i]).\")    \/\/ 4","        print(\"The second day with absences had \\(absences[j]).\")","    }","}","\/\/ Prints \"The first day with absences had 2.\"","\/\/ Prints \"The second day with absences had 4.\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In particular, note that "},{"type":"codeVoice","code":"j"},{"text":", the index of the second day with absences,","type":"text"},{"type":"text","text":" "},{"text":"was found in a slice of the original array and then used to access a value","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in the original "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array itself."}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"To safely reference the starting and ending indices of a slice,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"always use the "},{"type":"codeVoice","code":"startIndex"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"endIndex"},{"text":" properties instead of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"specific values."}]}]}]}],"variants":[{"paths":["\/documentation\/swift\/arrayslice"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/init(_:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/capacity","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/mutableSpan","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/span"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/insert(_:at:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/isTriviallyIdentical(to:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/remove(at:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/reserveCapacity(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/withUnsafeBufferPointer(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/withUnsafeBytes(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/withUnsafeMutableBufferPointer(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/withUnsafeMutableBytes(_:)"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/BidirectionalCollection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/Collection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/CustomDebugStringConvertible-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/CustomReflectable-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/CustomStringConvertible-Implementations","doc:\/\/com.apple.Swift\/docume