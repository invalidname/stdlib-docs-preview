-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/MutableCollection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/RandomAccessCollection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/RangeReplaceableCollection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/Sequence-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"metadata":{"title":"ArraySlice","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArraySlice","kind":"identifier"}],"symbolKind":"struct","roleHeading":"Structure","navigatorTitle":[{"text":"ArraySlice","kind":"identifier"}],"modules":[{"name":"Swift"}],"externalID":"s:s10ArraySliceV","platforms":[{"beta":false,"introducedAt":"8.0","deprecated":false,"name":"iOS","unavailable":false},{"beta":false,"introducedAt":"8.0","deprecated":false,"name":"iPadOS","unavailable":false},{"beta":false,"introducedAt":"13.0","deprecated":false,"name":"Mac Catalyst","unavailable":false},{"beta":false,"introducedAt":"10.10","deprecated":false,"name":"macOS","unavailable":false},{"beta":false,"introducedAt":"9.0","deprecated":false,"name":"tvOS","unavailable":false},{"beta":false,"introducedAt":"1.0","deprecated":false,"name":"visionOS","unavailable":false},{"beta":false,"introducedAt":"2.0","deprecated":false,"name":"watchOS","unavailable":false}]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ArraySlice"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":">"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"code":"ArraySlice","type":"codeVoice"},{"type":"text","text":" type makes it fast and efficient for you to perform"},{"type":"text","text":" "},{"type":"text","text":"operations on sections of a larger array. Instead of copying over the"},{"type":"text","text":" "},{"type":"text","text":"elements of a slice to new storage, an "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" instance presents a"},{"type":"text","text":" "},{"type":"text","text":"view onto the storage of a larger array. And because "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" "},{"type":"text","text":"presents the same interface as "},{"type":"codeVoice","code":"Array"},{"type":"text","text":", you can generally perform the"},{"type":"text","text":" "},{"type":"text","text":"same operations on a slice as you could on the original array."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information about using arrays, see "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ContiguousArray"},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"text","text":"with which "},{"code":"ArraySlice","type":"codeVoice"},{"type":"text","text":" shares most properties and methods."}]},{"anchor":"Slices-Are-Views-onto-Arrays","text":"Slices Are Views onto Arrays","type":"heading","level":1},{"inlineContent":[{"text":"For example, suppose you have an array holding the number of absences","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"from each class during a session."}],"type":"paragraph"},{"type":"codeListing","code":["let absences = [0, 2, 0, 4, 0, 3, 1, 0]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You want to compare the absences in the first half of the session with"},{"text":" ","type":"text"},{"text":"those in the second half. To do so, start by creating two slices of the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"absences"},{"text":" array.","type":"text"}]},{"code":["let midpoint = absences.count \/ 2","","let firstHalf = absences[..<midpoint]","let secondHalf = absences[midpoint...]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Neither the ","type":"text"},{"type":"codeVoice","code":"firstHalf"},{"text":" nor ","type":"text"},{"type":"codeVoice","code":"secondHalf"},{"text":" slices allocate any new storage","type":"text"},{"text":" ","type":"text"},{"text":"of their own. Instead, each presents a view onto the storage of the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"absences"},{"text":" array.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"You can call any method on the slices that you might have called on the","type":"text"},{"text":" ","type":"text"},{"code":"absences","type":"codeVoice"},{"text":" array. To learn which half had more absences, use the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"reduce(_:_:)"},{"type":"text","text":" method to calculate each sum."}]},{"syntax":"swift","code":["let firstHalfSum = firstHalf.reduce(0, +)","let secondHalfSum = secondHalf.reduce(0, +)","","if firstHalfSum > secondHalfSum {","    print(\"More absences in the first half.\")","} else {","    print(\"More absences in the second half.\")","}","\/\/ Prints \"More absences in the first half.\""],"type":"codeListing"},{"type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"Long-term storage of "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" instances is discouraged. A"},{"type":"text","text":" "},{"type":"text","text":"slice holds a reference to the entire storage of a larger array, not"},{"text":" ","type":"text"},{"type":"text","text":"just to the portion it presents, even after the original array’s lifetime"},{"type":"text","text":" "},{"type":"text","text":"ends. Long-term storage of a slice may therefore prolong the lifetime of"},{"type":"text","text":" "},{"type":"text","text":"elements that are no longer otherwise accessible, which can appear to be"},{"type":"text","text":" "},{"type":"text","text":"memory and object leakage."}],"type":"paragraph"}],"name":"Important"},{"type":"heading","level":1,"anchor":"Slices-Maintain-Indices","text":"Slices Maintain Indices"},{"inlineContent":[{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ContiguousArray"},{"type":"text","text":", the starting index for an"},{"type":"text","text":" "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" instance isn’t always zero. Slices maintain the same"},{"type":"text","text":" "},{"type":"text","text":"indices of the larger array for the same elements, so the starting"},{"type":"text","text":" "},{"type":"text","text":"index of a slice depends on how it was created, letting you perform"},{"type":"text","text":" "},{"type":"text","text":"index-based operations on either a full array or a slice."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sharing indices between collections and their subsequences is an important"},{"type":"text","text":" "},{"type":"text","text":"part of the design of Swift’s collection algorithms. Suppose you are"},{"type":"text","text":" "},{"type":"text","text":"tasked with finding the first two days with absences in the session. To"},{"type":"text","text":" "},{"type":"text","text":"find the indices of the two days in question, follow these steps:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"firstIndex(where:)","type":"codeVoice"},{"type":"text","text":" to find the index of the first element in the"},{"type":"text","text":" "},{"code":"absences","type":"codeVoice"},{"type":"text","text":" array that is greater than zero."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a slice of the "},{"code":"absences","type":"codeVoice"},{"type":"text","text":" array starting after the index found in"},{"type":"text","text":" "},{"type":"text","text":"step 1."}]}]},{"content":[{"inlineContent":[{"text":"Call ","type":"text"},{"type":"codeVoice","code":"firstIndex(where:)"},{"text":" again, this time on the slice created in step","type":"text"},{"text":" ","type":"text"},{"text":"2. Where in some languages you might pass a starting index into an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"indexOf"},{"text":" method to find the second day, in Swift you perform the same","type":"text"},{"text":" ","type":"text"},{"text":"operation on a slice of the original array.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Print the results using the indices found in steps 1 and 3 on the","type":"text"},{"text":" ","type":"text"},{"text":"original ","type":"text"},{"type":"codeVoice","code":"absences"},{"text":" array.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Here’s an implementation of those steps:"}],"type":"paragraph"},{"type":"codeListing","code":["if let i = absences.firstIndex(where: { $0 > 0 }) {                 \/\/ 1","    let absencesAfterFirst = absences[(i + 1)...]                   \/\/ 2","    if let j = absencesAfterFirst.firstIndex(where: { $0 > 0 }) {   \/\/ 3","        print(\"The first day with absences had \\(absences[i]).\")    \/\/ 4","        print(\"The second day with absences had \\(absences[j]).\")","    }","}","\/\/ Prints \"The first day with absences had 2.\"","\/\/ Prints \"The second day with absences had 4.\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"In particular, note that "},{"type":"codeVoice","code":"j"},{"type":"text","text":", the index of the second day with absences,"},{"type":"text","text":" "},{"type":"text","text":"was found in a slice of the original array and then used to access a value"},{"type":"text","text":" "},{"type":"text","text":"in the original "},{"type":"codeVoice","code":"absences"},{"text":" array itself.","type":"text"}],"type":"paragraph"},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"To safely reference the starting and ending indices of a slice,"},{"type":"text","text":" "},{"type":"text","text":"always use the "},{"code":"startIndex","type":"codeVoice"},{"type":"text","text":" and "},{"code":"endIndex","type":"codeVoice"},{"type":"text","text":" properties instead of"},{"type":"text","text":" "},{"type":"text","text":"specific values."}],"type":"paragraph"}]}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/arrayslice"]}],"abstract":[{"text":"A slice of an ","type":"text"},{"type":"codeVoice","code":"Array"},{"type":"text","text":", "},{"type":"codeVoice","code":"ContiguousArray"},{"type":"text","text":", or "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" instance."}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"generated":true,"title":"Related Array Types","anchor":"Related-Array-Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documen