{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"struct","roleHeading":"Structure","title":"ArraySlice","externalID":"s:s10ArraySliceV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"ArraySlice","kind":"identifier"}],"modules":[{"name":"Standard Library"}],"navigatorTitle":[{"text":"ArraySlice","kind":"identifier"}],"role":"symbol","platforms":[{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"8.0","name":"iOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"8.0","name":"iPadOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"13.0","name":"Mac Catalyst"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"10.10","name":"macOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"9.0","name":"tvOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"1.0","name":"visionOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"2.0","name":"watchOS"}]},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice"},"seeAlsoSections":[{"title":"Related Array Types","generated":true,"anchor":"Related-Array-Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"]}],"kind":"symbol","abstract":[{"text":"A slice of an ","type":"text"},{"code":"Array","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"ContiguousArray"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"ArraySlice"},{"text":" instance.","type":"text"}],"variants":[{"paths":["\/documentation\/swift\/arrayslice"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArraySlice","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"ArraySlice","type":"codeVoice"},{"text":" type makes it fast and efficient for you to perform","type":"text"},{"text":" ","type":"text"},{"text":"operations on sections of a larger array. Instead of copying over the","type":"text"},{"text":" ","type":"text"},{"text":"elements of a slice to new storage, an ","type":"text"},{"code":"ArraySlice","type":"codeVoice"},{"text":" instance presents a","type":"text"},{"text":" ","type":"text"},{"text":"view onto the storage of a larger array. And because ","type":"text"},{"type":"codeVoice","code":"ArraySlice"},{"text":" ","type":"text"},{"text":"presents the same interface as ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":", you can generally perform the","type":"text"},{"text":" ","type":"text"},{"text":"same operations on a slice as you could on the original array.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For more information about using arrays, see ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"ContiguousArray"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"with which ","type":"text"},{"code":"ArraySlice","type":"codeVoice"},{"text":" shares most properties and methods.","type":"text"}]},{"type":"heading","anchor":"Slices-Are-Views-onto-Arrays","level":1,"text":"Slices Are Views onto Arrays"},{"type":"paragraph","inlineContent":[{"text":"For example, suppose you have an array holding the number of absences","type":"text"},{"text":" ","type":"text"},{"text":"from each class during a session.","type":"text"}]},{"code":["let absences = [0, 2, 0, 4, 0, 3, 1, 0]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"You want to compare the absences in the first half of the session with","type":"text"},{"text":" ","type":"text"},{"text":"those in the second half. To do so, start by creating two slices of the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"absences"},{"text":" array.","type":"text"}]},{"code":["let midpoint = absences.count \/ 2","","let firstHalf = absences[..<midpoint]","let secondHalf = absences[midpoint...]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Neither the ","type":"text"},{"type":"codeVoice","code":"firstHalf"},{"text":" nor ","type":"text"},{"code":"secondHalf","type":"codeVoice"},{"text":" slices allocate any new storage","type":"text"},{"text":" ","type":"text"},{"text":"of their own. Instead, each presents a view onto the storage of the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"absences"},{"text":" array.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can call any method on the slices that you might have called on the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"absences"},{"text":" array. To learn which half had more absences, use the","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"reduce(_:_:)"},{"type":"text","text":" method to calculate each sum."}]},{"type":"codeListing","syntax":"swift","code":["let firstHalfSum = firstHalf.reduce(0, +)","let secondHalfSum = secondHalf.reduce(0, +)","","if firstHalfSum > secondHalfSum {","    print(\"More absences in the first half.\")","} else {","    print(\"More absences in the second half.\")","}","\/\/ Prints \"More absences in the first half.\""]},{"name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Long-term storage of ","type":"text"},{"code":"ArraySlice","type":"codeVoice"},{"text":" instances is discouraged. A","type":"text"},{"text":" ","type":"text"},{"text":"slice holds a reference to the entire storage of a larger array, not","type":"text"},{"text":" ","type":"text"},{"text":"just to the portion it presents, even after the original array’s lifetime","type":"text"},{"text":" ","type":"text"},{"text":"ends. Long-term storage of a slice may therefore prolong the lifetime of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"elements that are no longer otherwise accessible, which can appear to be"},{"type":"text","text":" "},{"text":"memory and object leakage.","type":"text"}]}],"type":"aside"},{"text":"Slices Maintain Indices","anchor":"Slices-Maintain-Indices","type":"heading","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"Array"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"ContiguousArray"},{"text":", the starting index for an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" instance isn’t always zero. Slices maintain the same"},{"type":"text","text":" "},{"type":"text","text":"indices of the larger array for the same elements, so the starting"},{"type":"text","text":" "},{"type":"text","text":"index of a slice depends on how it was created, letting you perform"},{"type":"text","text":" "},{"type":"text","text":"index-based operations on either a full array or a slice."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sharing indices between collections and their subsequences is an important"},{"type":"text","text":" "},{"type":"text","text":"part of the design of Swift’s collection algorithms. Suppose you are"},{"type":"text","text":" "},{"type":"text","text":"tasked with finding the first two days with absences in the session. To"},{"type":"text","text":" "},{"type":"text","text":"find the indices of the two days in question, follow these steps:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"firstIndex(where:)"},{"type":"text","text":" to find the index of the first element in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array that is greater than zero."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a slice of the "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array starting after the index found in"},{"type":"text","text":" "},{"type":"text","text":"step 1."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"firstIndex(where:)"},{"type":"text","text":" again, this time on the slice created in step"},{"type":"text","text":" "},{"type":"text","text":"2. Where in some languages you might pass a starting index into an"},{"type":"text","text":" "},{"type":"codeVoice","code":"indexOf"},{"type":"text","text":" method to find the second day, in Swift you perform the same"},{"type":"text","text":" "},{"type":"text","text":"operation on a slice of the original array."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Print the results using the indices found in steps 1 and 3 on the"},{"type":"text","text":" "},{"type":"text","text":"original "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s an implementation of those steps:"}]},{"type":"codeListing","syntax":"swift","code":["if let i = absences.firstIndex(where: { $0 > 0 }) {                 \/\/ 1","    let absencesAfterFirst = absences[(i + 1)...]                   \/\/ 2","    if let j = absencesAfterFirst.firstIndex(where: { $0 > 0 }) {   \/\/ 3","        print(\"The first day with absences had \\(absences[i]).\")    \/\/ 4","        print(\"The second day with absences had \\(absences[j]).\")","    }","}","\/\/ Prints \"The first day with absences had 2.\"","\/\/ Prints \"The second day with absences had 4.\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In particular, note that "},{"type":"codeVoice","code":"j"},{"type":"text","text":", the index of the second day with absences,"},{"type":"text","text":" "},{"type":"text","text":"was found in a slice of the original array and then used to access a value"},{"type":"text","text":" "},{"type":"text","text":"in the original "},{"type":"codeVoice","code":"absences"},{"type":"text","text":" array itself."}]},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"To safely reference the starting and ending indices of a slice,","type":"text"},{"text":" ","type":"text"},{"text":"always use the ","type":"text"},{"type":"codeVoice","code":"startIndex"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"endIndex"},{"text":" properties instead of","type":"text"},{"text":" ","type":"text"},{"text":"specific values.","type":"text"}]}],"style":"note"}]}],"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/init(_:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/capacity","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/mutableSpan","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/span"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/insert(_:at:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/isTriviallyIdentical(to:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/remove(at:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/reserveCapacity(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/withUnsafeBufferPointer(_:)","doc:\/\/