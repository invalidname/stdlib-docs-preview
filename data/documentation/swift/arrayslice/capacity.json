{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"capacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every array reserves a specific amount of memory to hold its contents."},{"type":"text","text":" "},{"text":"When you add elements to an array and that array begins to exceed its","type":"text"},{"text":" ","type":"text"},{"text":"reserved capacity, the array allocates a larger region of memory and","type":"text"},{"type":"text","text":" "},{"text":"copies its elements into the new storage. The new storage is a multiple","type":"text"},{"type":"text","text":" "},{"text":"of the old storage’s size. This exponential growth strategy means that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"appending an element happens in constant time, averaging the performance"},{"type":"text","text":" "},{"type":"text","text":"of many append operations. Append operations that trigger reallocation"},{"text":" ","type":"text"},{"type":"text","text":"have a performance cost, but they occur less and less often as the array"},{"text":" ","type":"text"},{"type":"text","text":"grows larger."}]},{"type":"paragraph","inlineContent":[{"text":"The following example creates an array of integers from an array literal,","type":"text"},{"text":" ","type":"text"},{"text":"then appends the elements of another collection. Before appending, the","type":"text"},{"text":" ","type":"text"},{"text":"array allocates new storage that is large enough store the resulting","type":"text"},{"text":" ","type":"text"},{"text":"elements.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var numbers = [10, 20, 30, 40, 50]","\/\/ numbers.count == 5","\/\/ numbers.capacity == 5","","numbers.append(contentsOf: stride(from: 60, through: 100, by: 10))","\/\/ numbers.count == 10","\/\/ numbers.capacity == 10"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/arrayslice\/capacity"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/capacity"},"metadata":{"modules":[{"name":"Swift"}],"title":"capacity","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"capacity"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"role":"symbol","externalID":"s:s10ArraySliceV8capacitySivp","platforms":[{"introducedAt":"8.0","beta":false,"name":"iOS","deprecated":false,"unavailable":false},{"unavailable":false,"name":"iPadOS","beta":false,"introducedAt":"8.0","deprecated":false},{"introducedAt":"13.0","beta":false,"name":"Mac Catalyst","deprecated":false,"unavailable":false},{"unavailable":false,"introducedAt":"10.10","beta":false,"deprecated":false,"name":"macOS"},{"unavailable":false,"introducedAt":"9.0","beta":false,"deprecated":false,"name":"tvOS"},{"unavailable":false,"name":"visionOS","beta":false,"introducedAt":"1.0","deprecated":false},{"introducedAt":"2.0","beta":false,"name":"watchOS","deprecated":false,"unavailable":false}],"extendedModule":"Swift","roleHeading":"Instance Property","symbolKind":"property"},"abstract":[{"text":"The total number of elements that the array can contain without","type":"text"},{"text":" ","type":"text"},{"text":"allocating