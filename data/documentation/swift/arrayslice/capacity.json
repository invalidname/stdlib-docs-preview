{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice"]]},"metadata":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"capacity"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"role":"symbol","extendedModule":"Swift","modules":[{"name":"Standard Library"}],"externalID":"s:s10ArraySliceV8capacitySivp","title":"capacity","roleHeading":"Instance Property","platforms":[{"deprecated":false,"name":"iOS","unavailable":false,"beta":false,"introducedAt":"8.0"},{"beta":false,"name":"iPadOS","deprecated":false,"introducedAt":"8.0","unavailable":false},{"name":"Mac Catalyst","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"13.0"},{"name":"macOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"10.10"},{"name":"tvOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"9.0"},{"name":"visionOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"1.0"},{"name":"watchOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"2.0"}],"symbolKind":"property"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/capacity"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"capacity","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","text":"Int"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"]}]},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every array reserves a specific amount of memory to hold its contents."},{"text":" ","type":"text"},{"type":"text","text":"When you add elements to an array and that array begins to exceed its"},{"text":" ","type":"text"},{"type":"text","text":"reserved capacity, the array allocates a larger region of memory and"},{"text":" ","type":"text"},{"text":"copies its elements into the new storage. The new storage is a multiple","type":"text"},{"text":" ","type":"text"},{"text":"of the old storage’s size. This exponential growth strategy means that","type":"text"},{"text":" ","type":"text"},{"text":"appending an element happens in constant time, averaging the performance","type":"text"},{"text":" ","type":"text"},{"text":"of many append operations. Append operations that trigger reallocation","type":"text"},{"text":" ","type":"text"},{"text":"have a performance cost, but they occur less and less often as the array","type":"text"},{"text":" ","type":"text"},{"text":"grows larger.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example creates an array of integers from an array literal,"},{"text":" ","type":"text"},{"text":"then appends the elements of another collection. Before appending, the","type":"text"},{"text":" ","type":"text"},{"text":"array allocates new storage that is large enough store the resulting","type":"text"},{"text":" ","type":"text"},{"text":"elements.","type":"text"}]},{"type":"codeListing","code":["var numbers = [10, 20, 30, 40, 50]","\/\/ numbers.count == 5","\/\/ numbers.capacity == 5","","numbers.append(contentsOf: stride(from: 60, through: 100, by: 10))","\/\/ numbers.count == 10","\/\/ numbers.capacity == 10"],"syntax":"swift"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"The total number of elements that the array can contain without","type":"text"},{"text":" ","type":"text"},{"text":"allocating new storage.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/docum