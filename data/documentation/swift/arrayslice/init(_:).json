":"Element","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence\/Element","preciseIdentifier":"s:ST7ElementQa"},{"text":", ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence","preciseIdentifier":"s:ST"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The sequence of elements to turn into an array."}],"type":"paragraph"}],"name":"s"}],"kind":"parameters"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"You can use this initializer to create an array from any other type that","type":"text"},{"text":" ","type":"text"},{"text":"conforms to the ","type":"text"},{"type":"codeVoice","code":"Sequence"},{"text":" protocol. For example, you might want to","type":"text"},{"text":" ","type":"text"},{"text":"create an array with the integers from 1 through 7. Use this initializer","type":"text"},{"text":" ","type":"text"},{"text":"around a range instead of typing all those numbers in an array literal.","type":"text"}],"type":"paragraph"},{"code":["let numbers = Array(1...7)","print(numbers)","\/\/ Prints \"[1, 2, 3, 4, 5, 6, 7]\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"You can also use this initializer to convert a complex sequence or","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"collection type back to an array. For example, the "},{"type":"codeVoice","code":"keys"},{"type":"text","text":" property of"},{"type":"text","text":" "},{"type":"text","text":"a dictionary isn’t an array with its own storage, it’s a collection"},{"type":"text","text":" "},{"type":"text","text":"that maps its elements from the dictionary only when they’re"},{"type":"text","text":" "},{"type":"text","text":"accessed, saving the time and space needed to allocate an array. If"},{"text":" ","type":"text"},{"type":"text","text":"you need to pass those keys to a method that takes an array, however,"},{"text":" ","type":"text"},{"text":"use this initializer to convert that list from its type of","type":"text"},{"text":" ","type":"text"},{"code":"LazyMapCollection<Dictionary<String, Int>, Int>","type":"codeVoice"},{"text":" to a simple","type":"text"},{"text":" ","type":"text"},{"code":"[String]","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func cacheImagesWithNames(names: [String]) {","    \/\/ custom image loading and caching"," }","","let namedHues: [String: Int] = [\"Vermillion\": 18, \"Magenta\": 302,","        \"Gold\": 50, \"Cerise\": 320]","let colorNames = Array(namedHues.keys)","cacheImagesWithNames(colorNames)","","print(colorNames)","\/\/ Prints \"[\"Gold\", \"Cerise\", \"Magenta\", \"Vermillion\"]\""],"type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/arrayslice\/init(_:)"]}],"sections":[],"kind":"symbol","abstract":[{"text":"Creates an array containing the elements of a sequence.","type":"text"}],"references":{"doc://com.apple.Swift/documentation/Swift":{"type":"topic","kind":"symbol","url":"\/documentation\/swift","role":"collection","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/ArraySlice/init(_:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/init(_:)","type":"topic","role":"symbol","url":"\/documentation\/swift\/arrayslice\/init(_:)","kind":"symbol","title":"init(_:)","abstract":[{"type":"text","text":"Creates an array containing the