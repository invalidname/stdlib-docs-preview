{"sections":[],"abstract":[{"text":"Creates an array containing the elements of a sequence.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"s"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"S","preciseIdentifier":"s:s10ArraySliceVyAByxGqd__c7ElementQyd__RszSTRd__lufc1SL_qd__mfp"},{"kind":"text","text":") "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence\/Element"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The sequence of elements to turn into an array."}]}],"name":"s"}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"You can use this initializer to create an array from any other type that"},{"type":"text","text":" "},{"type":"text","text":"conforms to the "},{"code":"Sequence","type":"codeVoice"},{"type":"text","text":" protocol. For example, you might want to"},{"type":"text","text":" "},{"type":"text","text":"create an array with the integers from 1 through 7. Use this initializer"},{"type":"text","text":" "},{"type":"text","text":"around a range instead of typing all those numbers in an array literal."}],"type":"paragraph"},{"syntax":"swift","code":["let numbers = Array(1...7)","print(numbers)","\/\/ Prints \"[1, 2, 3, 4, 5, 6, 7]\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can also use this initializer to convert a complex sequence or"},{"type":"text","text":" "},{"type":"text","text":"collection type back to an array. For example, the "},{"code":"keys","type":"codeVoice"},{"type":"text","text":" property of"},{"type":"text","text":" "},{"type":"text","text":"a dictionary isn’t an array with its own storage, it’s a collection"},{"type":"text","text":" "},{"type":"text","text":"that maps its elements from the dictionary only when they’re"},{"type":"text","text":" "},{"type":"text","text":"accessed, saving the time and space needed to allocate an array. If"},{"type":"text","text":" "},{"type":"text","text":"you need to pass those keys to a method that takes an array, however,"},{"type":"text","text":" "},{"type":"text","text":"use this initializer to convert that list from its type of"},{"type":"text","text":" "},{"code":"LazyMapCollection<Dictionary<String, Int>, Int>","type":"codeVoice"},{"type":"text","text":" to a simple"},{"type":"text","text":" "},{"code":"[String]","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["func cacheImagesWithNames(names: [String]) {","    \/\/ custom image loading and caching"," }","","let namedHues: [String: Int] = [\"Vermillion\": 18, \"Magenta\": 302,","        \"Gold\": 50, \"Cerise\": 320]","let colorNames = Array(namedHues.keys)","cacheImagesWithNames(colorNames)","","print(colorNames)","\/\/ Prints \"[\"Gold\", \"Cerise\", \"Magenta\", \"Vermillion\"]\""],"type":"codeListing"}],"kind":"content"}],"metadata":{"role":"symbol","platforms":[{"name":"iOS","introducedAt":"8.0","beta":false,"unavailable":false,"deprecated":false},{"name":"iPadOS","introducedAt":"8.0","beta":false,"unavailable":false,"deprecated":false},{"name":"Mac C