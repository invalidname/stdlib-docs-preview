{"abstract":[{"text":"Reorders the elements of the collection such that all the elements","type":"text"},{"text":" ","type":"text"},{"text":"that match the given predicate are after all the elements that don’t","type":"text"},{"text":" ","type":"text"},{"text":"match.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice"]]},"sections":[],"metadata":{"extendedModule":"Swift","symbolKind":"method","title":"partition(by:)","platforms":[{"name":"iOS","introducedAt":"8.0","beta":false,"unavailable":false,"deprecated":false},{"name":"iPadOS","introducedAt":"8.0","beta":false,"unavailable":false,"deprecated":false},{"name":"Mac Catalyst","introducedAt":"13.0","beta":false,"unavailable":false,"deprecated":false},{"name":"macOS","introducedAt":"10.10","beta":false,"unavailable":false,"deprecated":false},{"name":"tvOS","introducedAt":"9.0","beta":false,"unavailable":false,"deprecated":false},{"name":"visionOS","introducedAt":"1.0","beta":false,"unavailable":false,"deprecated":false},{"name":"watchOS","introducedAt":"2.0","beta":false,"unavailable":false,"deprecated":false}],"externalID":"s:SMsE9partition2by5IndexQzSb7ElementQzKXE_tKF::SYNTHESIZED::s:s10ArraySliceV","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"partition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:SM7ElementQa"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SM5IndexQa","text":"Index"}],"modules":[{"name":"Standard Library"}],"roleHeading":"Instance Method"},"variants":[{"paths":["\/documentation\/swift\/arrayslice\/partition(by:)-706dh"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/partition(by:)-706dh"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"kind":"text","text":" "},{"text":"belongsInSecondPartition","kind":"internalParam"},{"text":": (","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MutableCollection\/Element","text":"Element","preciseIdentifier":"s:SM7ElementQa","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MutableCollection\/Index","text":"Index","preciseIdentifier":"s:SM5IndexQa","kind":"typeIdentifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"belongsInSecondPartition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A predicate used to partition"},{"type":"text","text":" "},{"type":"text","text":"the collection. All elements satisfying this predicate are ordered"},{"type":"text","text":" "},{"text":"after all elements not satisfying it.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"inlineContent":[{"text":"The index of the first element in the reordered collection","type":"text"},{"type":"text","text":" "},{"text":"that matches ","type":"text"},{"type":"codeVoice","code":"belongsInSecondPartition"},{"type":"text","text":". If no elements in the"},{"type":"text","text":" "},{"type":"text","text":"collection match "},{"type":"codeVoice","code":"belongsInSecondPartition"},{"type":"text","text":", the returned index is"},{"type":"text","text":" "},{"type":"text","text":"equal to the collection’s "},{"type":"codeVoice","code":"endIndex"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"After partitioning a collection, there is a pivot index ","type":"text"},{"type":"codeVoice","code":"p"},{"type":"text","text":" where"},{"type":"text","text":" "},{"type":"text","text":"no element before "},{"code":"p","type":"codeVoice"},{"type":"text","text":" satisfies the "},{"type":"codeVoice","code":"belongsInSecondPartition"},{"type":"text","text":" "},{"type":"text","text":"predicate and every element at or after "},{"type":"codeVoice","code":"p"},{"type":"text","text":" satisfies"},{"type":"text","text":" "},{"type":"codeVoice","code":"belongsInSecondPartition"},{"type":"text","text":". This operation isn’t guaranteed to be"},{"type":"text","text":" "},{"type":"text","text":"stable, so the relative ordering of elements within the partitions might"},{"type":"text","text":" "},{"type":"text","text":"change."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the following example, an array of numbers is partitioned by a"},{"text":" ","type":"text"},{"type":"text","text":"predicate that matches elements greater than 30."}]},{"code":["var numbers = [30, 40, 20, 30, 30, 60, 10]","let p = numbers.partition(by: { $0 > 30 })","\/\/ p == 5","\/\/ numbers == [30, 10, 20, 30, 30, 60, 40]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"numbers","type":"codeVoice"},{"text":" array is now arranged in two partitions. The first","type":"text"},{"text":" ","type":"text"},{"text":"partition, ","type":"text"},{"code":"numbers[..<p]","type":"codeVoice"},{"text":", is made up of the elements that","type":"text"},{"text":" ","type":"text"},{"text":"are not greater than 30. The second partition, ","type":"text"},{"code":"numbers[p...]","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"is made up of the elements that ","type":"text"},{"inlineContent":[{"text":"are","type":"text"}],"type":"emphasis"},{"type":"text","text":" greater than 30."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let first = numbers[..<p]","\/\/ first == [30, 10, 20, 30, 30]","let second = numbers[p...]","\/\/ second == [60, 40]"]},{"inlineContent":[{"text":"Note that the order of elements in both partitions changed.","type":"text"},{"text":" ","type":"text"},{"text":"That is, ","type":"text"},{"code":"40","type":"codeVoice"},{"text":" appears before ","type":"text"},{"code":"60","type":"codeVoice"},{"text":" in the original collection,","type":"text"},{"text":" ","type":"text"},{"text":"but, after calling ","type":"text"},{"type":"codeVoice","code":"partition(by:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"60"},{"type":"text","text":" appears before "},{"type":"codeVoice","code":"40"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is the length of the collection.","type":"text"}],"type":"paragraph"}],"name":"Complexity","type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/MutableCollection/Index":{"type":"topic","url":"\/documentation\/swift\/mutablecollection\/index","kind":"symbol","abstract":[],"identifier