maryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"belongsInSecondPartition","kind":"internalParam"},{"text":": (","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MutableCollection\/Element","text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:SM7ElementQa"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MutableCollection\/Index","text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:SM5IndexQa"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"belongsInSecondPartition","content":[{"type":"paragraph","inlineContent":[{"text":"A predicate used to partition","type":"text"},{"text":" ","type":"text"},{"text":"the collection. All elements satisfying this predicate are ordered","type":"text"},{"text":" ","type":"text"},{"text":"after all elements not satisfying it.","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The index of the first element in the reordered collection","type":"text"},{"text":" ","type":"text"},{"text":"that matches ","type":"text"},{"code":"belongsInSecondPartition","type":"codeVoice"},{"text":". If no elements in the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"collection match "},{"code":"belongsInSecondPartition","type":"codeVoice"},{"type":"text","text":", the returned index is"},{"text":" ","type":"text"},{"type":"text","text":"equal to the collection’s "},{"type":"codeVoice","code":"endIndex"},{"type":"text","text":"."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"After partitioning a collection, there is a pivot index ","type":"text"},{"type":"codeVoice","code":"p"},{"text":" where","type":"text"},{"text":" ","type":"text"},{"text":"no element before ","type":"text"},{"type":"codeVoice","code":"p"},{"text":" satisfies the ","type":"text"},{"type":"codeVoice","code":"belongsInSecondPartition"},{"text":" ","type":"text"},{"text":"predicate and every element at or after ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" satisfies","type":"text"},{"text":" ","type":"text"},{"code":"belongsInSecondPartition","type":"codeVoice"},{"text":". This operation isn’t guaranteed to be","type":"text"},{"text":" ","type":"text"},{"text":"stable, so the relative ordering of elements within the partitions might","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In the following example, an array of numbers is partitioned by a","type":"text"},{"text":" ","type":"text"},{"text":"predicate that matches elements greater than 30.","type":"text"}]},{"type":"codeListing","code":["var numbers = [30, 40, 20, 30, 30, 60, 10]","let p = numbers.partition(by: { $0 > 30 })","\/\/ p == 5","\/\/ numbers == [30, 10, 20, 30, 30, 60, 40]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"numbers","type":"codeVoice"},{"text":" array is now arranged in two partitions. The first","type":"text"},{"text":" ","type":"text"},{"text":"partition, ","type":"text"},{"code":"numbers[..<p]","type":"codeVoice"},{"text":", is made up of the elements that","type":"text"},{"text":" ","type":"text"},{"text":"are not greater than 30. The second partition, ","type":"text"},{"type":"codeVoice","code":"numbers[p...]"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"is made up of the elements that ","type":"text"},{"inlineContent":[{"text":"are","type":"text"}],"type":"emphasis"},{"text":" greater than 30.","type":"text"}]},{"code":["let first = numbers[..<p]","\/\/ first == [30, 10, 20, 30, 30]","let second = numbers[p...]","\/\/ second == [60, 40]"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Note that the order of elements in both partitions changed.","type":"text"},{"text":" ","type":"text"},{"text":"That is, ","type":"text"},{"type":"codeVoice","code":"40"},{"text":" appears before ","type":"text"},{"type":"codeVoice","code":"60"},{"text":" in the original collection,","type":"text"},{"text":" ","type":"text"},{"text":"but, after calling ","type":"text"},{"code":"partition(by:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"60","type":"codeVoice"},{"text":" appears before ","type":"text"},{"code":"40","type":"codeVoice"},{"text":".","type":"text"}]},{"content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is the length of the collection.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Complexity","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/arrayslice\/partition(by:)-706dh"]}],"sections":[],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/ArraySlice/partition(by:)-706dh":{"url":"\/documentation\/swift\/arrayslice\/partition(by:)-706dh","title":"partition(by:)","kind":"symbol","fragments