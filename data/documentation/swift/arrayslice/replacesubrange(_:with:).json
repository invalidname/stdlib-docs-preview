":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" is length of the array and","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"m"}],"type":"emphasis"},{"text":" is the length of ","type":"text"},{"code":"newElements","type":"codeVoice"},{"text":". If the call to this method simply","type":"text"},{"text":" ","type":"text"},{"text":"appends the contents of ","type":"text"},{"code":"newElements","type":"codeVoice"},{"text":" to the array, this method is","type":"text"},{"text":" ","type":"text"},{"text":"equivalent to ","type":"text"},{"code":"append(contentsOf:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Complexity","type":"aside"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/replaceSubrange(_:with:)"},"abstract":[{"text":"Replaces a range of elements with the elements in the specified","type":"text"},{"text":" ","type":"text"},{"text":"collection.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/arrayslice\/replacesubrange(_:with:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice"]]},"references":{"doc://com.apple.Swift/documentation/Swift/Collection":{"url":"\/documentation\/swift\/collection","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Collection","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Collection","kind":"identifier"}],"title":"Collection","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","kind":"symbo