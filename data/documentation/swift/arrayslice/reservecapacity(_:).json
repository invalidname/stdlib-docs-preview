{"kind":"symbol","abstract":[{"text":"Reserves enough space to store the specified number of elements.","type":"text"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/reserveCapacity(_:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/arrayslice\/reservecapacity(_:)"]}],"metadata":{"externalID":"s:s10ArraySliceV15reserveCapacityyySiF","modules":[{"name":"Standard Library"}],"platforms":[{"beta":false,"deprecated":false,"name":"iOS","unavailable":false,"introducedAt":"8.0"},{"beta":false,"deprecated":false,"name":"iPadOS","unavailable":false,"introducedAt":"8.0"},{"beta":false,"deprecated":false,"name":"Mac Catalyst","unavailable":false,"introducedAt":"13.0"},{"beta":false,"deprecated":false,"name":"macOS","unavailable":false,"introducedAt":"10.10"},{"beta":false,"deprecated":false,"name":"tvOS","unavailable":false,"introducedAt":"9.0"},{"beta":false,"deprecated":false,"name":"visionOS","unavailable":false,"introducedAt":"1.0"},{"beta":false,"deprecated":false,"name":"watchOS","unavailable":false,"introducedAt":"2.0"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reserveCapacity"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"extendedModule":"Swift","role":"symbol","roleHeading":"Instance Method","symbolKind":"method","title":"reserveCapacity(_:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reserveCapacity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"minimumCapacity","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"minimumCapacity","content":[{"inlineContent":[{"text":"The requested number of elements to store.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"If you are adding a known number of elements to an array, use this method","type":"text"},{"text":" ","type":"text"},{"text":"to avoid multiple reallocations. This method ensures that the array has","type":"text"},{"text":" ","type":"text"},{"text":"unique, mutable, contiguous storage, with space allocated for at least","type":"text"},{"text":" ","type":"text"},{"text":"the requested number of elements.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Calling the ","type":"text"},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"text":" method on an array with bridged storage","type":"text"},{"text":" ","type":"text"},{"text":"triggers a copy to contiguous storage even if the existing storage","type":"text"},{"text":" ","type":"text"},{"text":"has room to store ","type":"text"},{"type":"codeVoice","code":"minimumCapacity"},{"text":" elements.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For performance reasons, the size of the newly allocated storage might be"},{"type":"text","text":" "},{"type":"text","text":"greater than the requested capacity. Use the array’s "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" property"},{"type":"text","text":" "},{"type":"text","text":"to determine the size of the new storage."}]},{"anchor":"Preserving-an-Arrays-Geometric-Growth-Strategy","type":"heading","level":1,"text":"Preserving an Array’s Geometric Growth Strategy"},{"type":"paragraph","inlineContent":[{"text":"If you implement a custom data structure backed by an array that grows","type":"text"},{"text":" ","type":"text"},{"text":"dynamically, naively calling the ","type":"text"},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" method can lead"},{"type":"text","text":" "},{"type":"text","text":"to worse than expected performance. Arrays need to follow a geometric"},{"type":"text","text":" "},{"type":"text","text":"allocation pattern for appending elements to achieve amortized"},{"type":"text","text":" "},{"type":"text","text":"constant-time performance. The "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" type’s "},{"type":"codeVoice","code":"append(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"append(contentsOf:)"},{"type":"text","text":" methods take care of this detail for you, but"},{"type":"text","text":" "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" allocates only as much space as you tell it to"},{"type":"text","text":" "},{"type":"text","text":"(padded to a round value), and no more. This avoids over-allocation, but"},{"type":"text","text":" "},{"type":"text","text":"can result in insertion not having amortized constant-time performance."}]},{"inlineContent":[{"type":"text","text":"The following code declares "},{"type":"codeVoice","code":"values"},{"type":"text","text":", an array of integers, and the"},{"type":"text","text":" "},{"type":"codeVoice","code":"addTenQuadratic()"},{"type":"text","text":" function, which adds ten more values to the "},{"type":"codeVoice","code":"values"},{"type":"text","text":" "},{"type":"text","text":"array on each call."}],"type":"paragraph"},{"code":["  var values: [Int] = [0, 1, 2, 3]","","  \/\/ Don't use 'reserveCapacity(_:)' like this","  func addTenQuadratic() {","      let newCount = values.count + 10","      values.reserveCapacity(newCount)","      for n in values.count..<newCount {","          values.append(n)","      }","  }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The call to ","type":"text"},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"text":" increases the ","type":"text"},{"code":"values","type":"codeVoice"},{"text":" array’s capacity","type":"text"},{"text":" ","type":"text"},{"text":"by exactly 10 elements on each pass through ","type":"text"},{"code":"addTenQuadratic()","type":"codeVoice"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"is linear growth. Instead of having constant time when averaged over","type":"text"},{"text":" ","type":"text"},{"text":"many calls, the function may decay to performance that is linear in","type":"text"},{"text":" ","type":"text"},{"code":"values.count","type":"codeVoice"},{"text":". This is almost certainly not what you want.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In cases like this, the simplest fix is often to simply remove the call","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"text":", and let the ","type":"text"},{"code":"append(_:)","type":"codeVoice"},{"text":" method grow the array","type":"text"},{"text":" ","type":"text"},{"text":"for you.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["  func addTen() {","      let newCount = values.count + 10","      for n in values.count..<newCount {","          values.append(n)","      }","  }"]},{"inlineContent":[{"text":"If you need more control over the capacity of your array, implement your","type":"text"},{"text":" ","type":"text"},{"text":"own geometric growth strategy, passing the size you compute to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" is the number of elements in the array."}]}],"style":"note","type":"aside","name":"Complexity"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.apple.Swift/documentation/Swift/ArraySlice/reserveCapacity(_:)":{"abstract":[{"text":"Reserves enough space to store the specified number of elements.","type":"text"}],"type":"topic","title":"reserveCapacity(_:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/reserveCapacity(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"reserveCapacity","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"role":"symbol","url":"\/documentation\/swift\/arrayslice\/reservecapacity(_:)","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/ArraySlice":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice","title":"ArraySlice","role":"symbol","abstract":[{"type":"text","text":"A slice of an "},{"type":"codeVoice","code":"Array"},{"type":"text","text":", "},{"type":"codeVoice","code":"ContiguousArray"},{"type":"text","text":", or "},{"type":"codeVoice","code":"ArraySlice"},{"text":" instance.","type":"text"}],"url":"\/documentation\/swift\/arrayslice","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"ArraySlice","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"ArraySlice","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/Int":{"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swift\/int","navigatorTitle":[{"text":"Int","kind":"identifier"}],"title":"Int","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Int","kind":"identifier"}],"abstract":[{"type":"text","text":"A signed integer value type."}]}}}