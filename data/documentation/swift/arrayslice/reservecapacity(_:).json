{"abstract":[{"type":"text","text":"Reserves enough space to store the specified number of elements."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/reserveCapacity(_:)"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reserveCapacity"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"minimumCapacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"minimumCapacity","content":[{"inlineContent":[{"type":"text","text":"The requested number of elements to store."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"If you are adding a known number of elements to an array, use this method","type":"text"},{"text":" ","type":"text"},{"text":"to avoid multiple reallocations. This method ensures that the array has","type":"text"},{"text":" ","type":"text"},{"text":"unique, mutable, contiguous storage, with space allocated for at least","type":"text"},{"text":" ","type":"text"},{"text":"the requested number of elements.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calling the "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" method on an array with bridged storage"},{"type":"text","text":" "},{"type":"text","text":"triggers a copy to contiguous storage even if the existing storage"},{"text":" ","type":"text"},{"text":"has room to store ","type":"text"},{"code":"minimumCapacity","type":"codeVoice"},{"text":" elements.","type":"text"}]},{"inlineContent":[{"text":"For performance reasons, the size of the newly allocated storage might be","type":"text"},{"text":" ","type":"text"},{"text":"greater than the requested capacity. Use the array’s ","type":"text"},{"type":"codeVoice","code":"capacity"},{"text":" property","type":"text"},{"text":" ","type":"text"},{"text":"to determine the size of the new storage.","type":"text"}],"type":"paragraph"},{"level":1,"type":"heading","text":"Preserving an Array’s Geometric Growth Strategy","anchor":"Preserving-an-Arrays-Geometric-Growth-Strategy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you implement a custom data structure backed by an array that grows"},{"type":"text","text":" "},{"type":"text","text":"dynamically, naively calling the "},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"type":"text","text":" method can lead"},{"type":"text","text":" "},{"type":"text","text":"to worse than expected performance. Arrays need to follow a geometric"},{"type":"text","text":" "},{"type":"text","text":"allocation pattern for appending elements to achieve amortized"},{"type":"text","text":" "},{"type":"text","text":"constant-time performance. The "},{"type":"codeVoice","code":"Array"},{"text":" type’s ","type":"text"},{"type":"codeVoice","code":"append(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"append(contentsOf:)"},{"type":"text","text":" methods take care of this detail for you, but"},{"text":" ","type":"text"},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"type":"text","text":" allocates only as much space as you tell it to"},{"type":"text","text":" "},{"type":"text","text":"(padded to a round value), and no more. This avoids over-allocation, but"},{"type":"text","text":" "},{"type":"text","text":"can result in insertion not having amortized constant-time performance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following code declares "},{"type":"codeVoice","code":"values"},{"text":", an array of integers, and the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"addTenQuadratic()"},{"type":"text","text":" function, which adds ten more values to the "},{"type":"codeVoice","code":"values"},{"type":"text","text":" "},{"type":"text","text":"array on each call."}]},{"syntax":"swift","type":"codeListing","code":["  var values: [Int] = [0, 1, 2, 3]","","  \/\/ Don't use 'reserveCapacity(_:)' like this","  func addTenQuadratic() {","      let newCount = values.count + 10","      values.reserveCapacity(newCount)","      for n in values.count..<newCount {","          values.append(n)","      }","  }"]},{"inlineContent":[{"text":"The call to ","type":"text"},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"text":" increases the ","type":"text"},{"type":"codeVoice","code":"values"},{"text":" array’s capacity","type":"text"},{"text":" ","type":"text"},{"text":"by exactly 10 elements on each pass through ","type":"text"},{"type":"codeVoice","code":"addTenQuadratic()"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"is linear growth. Instead of having constant time when averaged over","type":"text"},{"text":" ","type":"text"},{"text":"many calls, the function may decay to performance that is linear in","type":"text"},{"text":" ","type":"text"},{"code":"values.count","type":"codeVoice"},{"text":". This is almost certainly not what you want.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In cases like this, the simplest fix is often to simply remove the call","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":", and let the "},{"type":"codeVoice","code":"append(_:)"},{"type":"text","text":" method grow the array"},{"text":" ","type":"text"},{"text":"for you.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["  func addTen() {","      let newCount = values.count + 10","      for n in values.count..<newCount {","          values.append(n)","      }","  }"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need more control over the capacity of your array, implement your"},{"text":" ","type":"text"},{"text":"own geometric growth strategy, passing the size you compute to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"text":".","type":"text"}]},{"type":"aside","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" is the number of elements in the array."}],"type":"paragraph"}],"style":"note"}]}],"sections":[],"variants":[{"paths":["\/documentation\/swift\/arrayslice\/reservecapacity(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Instance Method","platforms":[{"name":"iOS","introducedAt":"8.0","unavailable":false,"beta":false,"deprecated":false},{"name":"iPadOS","introducedAt":"8.0","unavailable":false,"beta":false,"deprecated":false},{"name":"Mac Catalyst","introducedAt":"13.0","unavailable":false,"beta":false,"deprecated":false},{"name":"macOS","introducedAt":"10.10","unavailable":false,"beta":false,"deprecated":false},{"name":"tvOS","introducedAt":"9.0","unavailable":false,"beta":false,"deprecated":false},{"name":"visionOS","introducedAt":"1.0","unavailable":false,"beta":false,"deprecated":false},{"name":"watchOS","introducedAt":"2.0","unavailable":false,"beta":false,"deprecated":false}],"extendedModule":"Swift","role":"symbol","title":"reserveCapacity(_:)","symbolKind":"method","modules":[{"name":"Swift"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reserveCapacity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"externalID":"s:s10ArraySliceV15reserveCapacityyySiF"},"references":{"doc://com.apple.Swift/documentation/Swift/ArraySlice":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice","kind":"symbol","role":"symbol","url":"\/documentation\/swift\/arrayslice","abstract":[{"text":"A slice of an ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ContiguousArray","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"ArraySlice","type":"codeVoice"},{"text":" instance.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"ArraySlice","kind":"identifier"}],"navigatorTitle":[{"text":"ArraySlice","kind":"identifier"}],"title":"ArraySlice","type":"topic"},"doc://com.apple.Swift/documentation/Swift":{"kind":"symbol","type":"topic","role":"collection","title":"Swift","images":[{"type":"card","identifier":"Swift-PageImage-card.png"}],"abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"Swift-PageImage-card.png":{"type":"image","identifier":"Swift-PageImage-card.png","alt":"An orange Swift logo on a gradient background.","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png"}]},"doc://com.apple.Swift/documentation/Swift/ArraySlice/reserveCapacity(_:)":{"kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/reserveCapacity(_:)","abstract":[{"type":"text","text":"Reserves enough space to store the spe