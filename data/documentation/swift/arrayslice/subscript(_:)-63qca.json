{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"text":"bounds","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Range","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Range","preciseIdentifier":"s:Sn"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","preciseIdentifier":"s:Si"},{"text":">) -> ","kind":"text"},{"text":"ArraySlice","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice","preciseIdentifier":"s:s10ArraySliceV"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:s10ArraySliceV7Elementxmfp"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"bounds","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A range of integers. The bounds of the range must be"},{"type":"text","text":" "},{"type":"text","text":"valid indices of the array."}]}]}]},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"The returned ","type":"text"},{"type":"codeVoice","code":"ArraySlice"},{"text":" instance uses the same indices for the same","type":"text"},{"text":" ","type":"text"},{"text":"elements as the original array. In particular, that slice, unlike an","type":"text"},{"text":" ","type":"text"},{"text":"array, may have a nonzero ","type":"text"},{"type":"codeVoice","code":"startIndex"},{"text":" and an ","type":"text"},{"type":"codeVoice","code":"endIndex"},{"text":" that is not","type":"text"},{"text":" ","type":"text"},{"text":"equal to ","type":"text"},{"type":"codeVoice","code":"count"},{"text":". Always use the slice’s ","type":"text"},{"type":"codeVoice","code":"startIndex"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"endIndex"},{"text":" ","type":"text"},{"text":"properties instead of assuming that its indices start or end at a","type":"text"},{"text":" ","type":"text"},{"text":"particular value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This example demonstrates getting a slice of an array of strings, finding","type":"text"},{"text":" ","type":"text"},{"text":"the index of one of the strings in the slice, and then using that index","type":"text"},{"text":" ","type":"text"},{"text":"in the original array.","type":"text"}],"type":"paragraph"},{"code":["let streets = [\"Adams\", \"Bryant\", \"Channing\", \"Douglas\", \"Evarts\"]","let streetsSlice = streets[2 ..< streets.endIndex]","print(streetsSlice)","\/\/ Prints \"[\"Channing\", \"Douglas\", \"Evarts\"]\"","","let i = streetsSlice.firstIndex(of: \"Evarts\")    \/\/ 4","print(streets[i!])","\/\/ Prints \"Evarts\""],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/subscript(_:)-63qca","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swift\/arrayslice\/subscript(_:)-63qca"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Accesses a contiguous subrange of the array’s elements.","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice"]]},"metadata":{"extendedModule":"Swift","roleHeading":"Instance Subscript","title":"subscript(_:)","platforms":[{"introducedAt":"8.0","beta":false,"name":"iOS","unavailable":false,"deprecated":false},{"introducedAt":"8.0","beta":false,"name":"iPadOS","unavailable":false,"deprecated":false},{"introducedAt":"13.0","beta":false,"name":"Mac Catalyst","unavailable":false,"deprecated":fa