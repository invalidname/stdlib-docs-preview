ocumentation\/Swift\/Range"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:s10ArraySliceV","text":"ArraySlice","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s10ArraySliceV7Elementxmfp","text":"Element","kind":"typeIdentifier"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"bounds","content":[{"inlineContent":[{"type":"text","text":"A range of integers. The bounds of the range must be"},{"type":"text","text":" "},{"type":"text","text":"valid indices of the array."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The returned "},{"type":"codeVoice","code":"ArraySlice"},{"type":"text","text":" instance uses the same indices for the same"},{"type":"text","text":" "},{"type":"text","text":"elements as the original array. In particular, that slice, unlike an"},{"type":"text","text":" "},{"type":"text","text":"array, may have a nonzero "},{"type":"codeVoice","code":"startIndex"},{"type":"text","text":" and an "},{"type":"codeVoice","code":"endIndex"},{"type":"text","text":" that is not"},{"type":"text","text":" "},{"type":"text","text":"equal to "},{"type":"codeVoice","code":"count"},{"type":"text","text":". Always use the slice’s "},{"type":"codeVoice","code":"startIndex"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"endIndex"},{"text":" ","type":"text"},{"text":"properties instead of assuming that its indices start or end at a","type":"text"},{"text":" ","type":"text"},{"text":"particular value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This example demonstrates getting a slice of an array of strings, finding"},{"type":"text","text":" "},{"type":"text","text":"the index of one of the strings in the slice, and then using that index"},{"type":"text","text":" "},{"type":"text","text":"in the original array."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let streets = [\"Adams\", \"Bryant\", \"Channing\", \"Douglas\", \"Evarts\"]","let streetsSlice = streets[2 ..< streets.endIndex]","print(streetsSlice)","\/\/ Prints \"[\"Channing\", \"Douglas\", \"Evarts\"]\"","","let i = streetsSlice.firstIndex(of: \"Evarts\")    \/\/ 4","print(streets[i!])","\/\/ Prints \"Evarts\""]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/arrayslice\/subscript(_:)-63qca"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/subscript(_:)-63qca"},"references":{"doc://com.apple.Swift/documentation/Swift/ArraySlice/subscript(_:)-63qca":{"url":"\/documentation\/swift\/arrayslice\/subscript(_:)-63qca","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/subscript(_:)-63qca","abstract":[{"type":"text","text":"Accesses a contiguous subrange of the array’s elements."}],"role":"symbol","type":"topic","title":"subscript(_:)","fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Range","kind":"typeIdentifier","preciseIdentifier":"s:Sn"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">) -> ","kind":"text"},{"text":"ArraySlice","kind":"typeIdentifier","preciseIdentifier":"s:s10ArraySliceV"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:s10ArraySliceV7Elementxmfp"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift":{"type":"topic","kind":"symb