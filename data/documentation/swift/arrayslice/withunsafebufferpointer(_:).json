":"parameters","parameters":[{"name":"body","content":[{"inlineContent":[{"type":"text","text":"A closure with an "},{"type":"codeVoice","code":"UnsafeBufferPointer"},{"type":"text","text":" parameter that"},{"type":"text","text":" "},{"type":"text","text":"points to the contiguous storage for the array.  If"},{"type":"text","text":" "},{"type":"codeVoice","code":"body"},{"type":"text","text":" has a return value, that value is also used as the return value"},{"type":"text","text":" "},{"type":"text","text":"for the "},{"type":"codeVoice","code":"withUnsafeBufferPointer(_:)"},{"type":"text","text":" method. The pointer argument is"},{"type":"text","text":" "},{"type":"text","text":"valid only for the duration of the method’s execution."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure parameter."}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Often, the optimizer can eliminate bounds checks within an array"},{"type":"text","text":" "},{"type":"text","text":"algorithm, but when that fails, invoking the same algorithm on the"},{"type":"text","text":" "},{"type":"text","text":"buffer pointer passed into your closure lets you trade safety for speed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows how you can iterate over the contents of the"},{"type":"text","text":" "},{"type":"text","text":"buffer pointer:"}]},{"type":"codeListing","syntax":"swift","code":["let numbers = [1, 2, 3, 4, 5]","let sum = numbers.withUnsafeBufferPointer { buffer -> Int in","    var result = 0","    for i in stride(from: buffer.startIndex, to: buffer.endIndex, by: 2) {","        result += buffer[i]","    }","    return result","}","\/\/ 'sum' == 9"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pointer passed as an argument to "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is valid only during the"},{"type":"text","text":" "},{"type":"text","text":"execution of "},{"type":"codeVoice","code":"withUnsafeBufferPointer(_:)"},{"type":"text","text":". Do not store or return the"},{"type":"text","text":" "},{"type":"text","text":"pointer for later use."}]}]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice"]]},"abstract":[{"type":"text","text":"Calls a closure with a pointer to the array’s contiguous storage."}],"metadata":{"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withUnsafeBufferPointer","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">((","kind":"text"},{"text":"UnsafeBufferPointer","preciseIdentifier":"s:SR","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Element","preciseIdentifier":"s:s10ArraySliceV7Elementxmfp","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"E","preciseIdentifier":"s:s10ArraySliceV23withUnsafeBufferPointeryqd__qd__SRyxGqd_0_YKXEqd_0_YKs5ErrorRd_0_r0_lF1EL_qd_0_mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"R","preciseIdentifier":"s:s10ArraySliceV23withUnsafeBufferPointeryqd__qd__SRyxGqd_0_YKXEqd_0_YKs5ErrorRd_0_r0_lF1RL_qd__mfp","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"E","preciseIdentifier":"s:s10ArraySliceV23withUnsafeBufferPointeryqd__qd__SRyxGqd_0_YKXEqd_0_YKs5ErrorRd_0_r0_lF1EL_qd_0_mfp","kind":"typeIdentifier"},{"text":") ->