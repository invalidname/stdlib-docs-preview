ext":" "},{"type":"text","text":"this method during execution of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure; it might not"},{"type":"text","text":" "},{"type":"text","text":"appear to have its correct value. Instead, use only the"},{"type":"text","text":" "},{"type":"codeVoice","code":"UnsafeMutableBufferPointer"},{"type":"text","text":" argument to "},{"type":"codeVoice","code":"body"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","name":"Warning"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/arrayslice\/withunsafemutablebufferpointer(_:)"]}],"references":{"doc://com.apple.Swift/documentation/Swift/UnsafeMutableBufferPointer":{"navigatorTitle":[{"kind":"identifier","text":"UnsafeMutableBufferPointer"}],"url":"\/documentation\/swift\/unsafemutablebufferpointer","abstract":[{"text":"A nonowning collection interface to a buffer of mutable","type":"text"},{"type":"text","text":" "},{"text":"elements stored contiguously in memory.","type":"text"}],"kind":"symbol","title":"UnsafeMutableBufferPointer","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableBufferPointer","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnsafeMutableBufferPointer"}]},"doc://com.apple.Swift/documentation/Swift/Error":{"title":"Error","abstract":[{"text":"A type representing an error value that can be thrown.","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Error","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Error"}],"url":"\/documentation\/swift\/error","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error"},"doc://com.apple.Swift/documentation/Swift":{"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","title":"Sw