:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"A closure with an "},{"type":"codeVoice","code":"UnsafeMutableBufferPointer"},{"type":"text","text":" "},{"type":"text","text":"parameter that points to the contiguous storage for the array."},{"type":"text","text":" "},{"type":"text","text":"If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" has a return value, that value is also"},{"type":"text","text":" "},{"type":"text","text":"used as the return value for the "},{"type":"codeVoice","code":"withUnsafeMutableBufferPointer(_:)"},{"type":"text","text":" "},{"type":"text","text":"method. The pointer argument is valid only for the duration of the"},{"type":"text","text":" "},{"type":"text","text":"method’s execution."}],"type":"paragraph"}],"name":"body"}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"text":"The return value, if any, of the ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" closure parameter.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"Often, the optimizer can eliminate bounds checks within an array","type":"text"},{"text":" ","type":"text"},{"text":"algorithm, but when that fails, invoking the same algorithm on the","type":"text"},{"text":" ","type":"text"},{"text":"buffer pointer passed into your closure lets you trade safety for speed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example shows how modifying the contents of the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UnsafeMutableBufferPointer"},{"text":" argument to ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" alters the contents of","type":"text"},{"text":" ","type":"text"},{"text":"the array:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var numbers = [1, 2, 3, 4, 5]","numbers.withUnsafeMutableBufferPointer { buffer in","    for i in stride(from: buffer.startIndex, to: buffer.endIndex - 1, by: 2) {","        buffer.swapAt(i, i + 1)","    }","}","print(numbers)","\/\/ Prints \"[2, 1, 4, 3, 5]\""]},{"inlineContent":[{"text":"The pointer passed as an argument to ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" is valid only during the","type":"text"},{"text":" ","type":"text"},{"text":"execution of ","type":"text"},{"type":"codeVoice","code":"withUnsafeMutableBufferPointer(_:)"},{"text":". Do not store or","type":"text"},{"text":" ","type":"text"},{"text":"return the pointer for later use.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Do not rely on anything about the array that is the target of"},{"type":"text","text":" "},{"type":"text","text":"this method during execution of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure; it might not"},{"type":"text","text":" "},{"type":"text","text":"appear to have its correct value. Instead, use only the"},{"type":"text","text":" "},{"type":"codeVoice","code":"UnsafeMutableBufferPointer"},{"type":"text","text":" argument to "},{"type":"codeVoice","code":"body"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"warning","name":"Warning","type":"aside"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice\/withUnsafeMutableBufferPointer(_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/arrayslice\/withunsafemutablebufferpointer(_:)"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Calls the given closure with a pointer to the array’s mutable contiguous