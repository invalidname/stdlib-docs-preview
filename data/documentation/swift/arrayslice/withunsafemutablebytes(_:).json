{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withUnsafeMutableBytes"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"text":": (","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawBufferPointer","text":"UnsafeMutableRawBufferPointer","preciseIdentifier":"s:Sw"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s10ArraySliceV22withUnsafeMutableBytesyqd__qd__SwKXEKlF1RL_qd__mfp","text":"R","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s10ArraySliceV22withUnsafeMutableBytesyqd__qd__SwKXEKlF1RL_qd__mfp","text":"R","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"body","content":[{"inlineContent":[{"type":"text","text":"A closure with an "},{"type":"codeVoice","code":"UnsafeMutableRawBufferPointer"},{"type":"text","text":" "},{"type":"text","text":"parameter that points to the contiguous storage for the array."},{"text":" ","type":"text"},{"text":"If no such storage exists, it is created. If ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" has a return value, that value is also","type":"text"},{"type":"text","text":" "},{"text":"used as the return value for the ","type":"text"},{"type":"codeVoice","code":"withUnsafeMutableBytes(_:)"},{"text":" method.","type":"text"},{"type":"text","text":" "},{"text":"The argument is valid only for the duration of the closure’s","type":"text"},{"text":" ","type":"text"},{"text":"execution.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure parameter."}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"The array’s "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type must be a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"trivial type"}]},{"type":"text","text":", which can be copied"},{"type":"text","text":" "},{"type":"text","text":"with just a bit-for-bit copy without any indirection or"},{"type":"text","text":" "},{"type":"text","text":"reference-counting operations. Generally, native Swift types that do not"},{"type":"text","text":" "},{"type":"text","text":"contain strong or weak references are trivial, as are imported C structs"},{"type":"text","text":" "},{"type":"text","text":"and enums."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example copies bytes from the "},{"type":"codeVoice","code":"byteValues"},{"type":"text","text":" array into"},{"type":"text","text":" "},{"type":"codeVoice","code":"numbers"},{"type":"text","text":", an array of "},{"type":"codeVoice","code":"Int32"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var numbers: [Int32] = [0, 0]","var byteValues: [UInt8] = [0x01, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00]","","numbers.withUnsafeMutableBytes { destBytes in","    byteValues.withUnsafeBytes { srcBytes in","        destBytes.copyBytes(from: srcBytes)","    }","}","\/\/ numbers == [1, 2]"]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"This example shows the behavior on a little-endian platform.","type":"text"}]}],"style":"note"},{"inlineContent":[{"type":"text","text":"The pointer passed as an argument to "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is valid only for the"},{"type":"text","text":" "},{"type":"text","text":"lifetime of the closure. Do not escape it from the closure for later"},{"type":"text","text":" "},{"type":"text","text":"use."}],"type":"paragraph"},{"type":"aside","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"Do not rely on anything about the array that is the target of","type":"text"},{"text":" ","type":"text"},{"text":"this method during execution of the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" closure; it might not","type":"text"},{"text":" ","type":"text"},{"text":"appear to have its correct value. Instead, use only the","type":"text"},{"text":" ","type":"text"},{"code":"UnsafeMutableRawBufferPointer","type":"codeVoice"},{"text":" argument to ","type":"text"},{"code":"body","type":"codeVoice"},{"text":".","type":"text"}]}],"style":"warning"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"title":"withUnsafeMutableBytes(_:)","externalID":"s:s10ArraySliceV22withUnsafeMutableBytesyqd__qd__SwKXEKlF","symbolKind":"method","platforms":[{"introducedAt":"8.0","deprecated":false,"unavailable":false,"name":"iOS","beta":false},{"introducedAt":"8.0","deprecated":false,"unavailable":false,"name":"iPadOS","beta":false},{"introducedAt":"13.0","deprecated":false,"unavailable":false,"name":"Mac Catalyst","beta":false},{"introducedAt":"10.10","deprecated":false,"unavailable":false,"name":"macOS","beta":false},{"introducedAt":"9.0","deprecated":false,"unavailable":false,"name":"tvOS","beta":false},{"introducedAt":"1.0","deprecated":false,"unavailable":false,"name":"visionOS","beta":false},{"introducedAt":"2.0","deprecated":false,"unavailable":false,"name":"watchOS","beta":false}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withUnsafeMutableBy