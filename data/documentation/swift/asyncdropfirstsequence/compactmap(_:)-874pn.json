"},{"type":"text","text":" from a"},{"type":"text","text":" "},{"type":"codeVoice","code":"romanNumeralDict"},{"type":"text","text":" dictionary. Because there is no key for "},{"type":"codeVoice","code":"4"},{"type":"text","text":", the closure"},{"type":"text","text":" "},{"type":"text","text":"returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" in this case, which "},{"type":"codeVoice","code":"compactMap(_:)"},{"type":"text","text":" omits from the"},{"type":"text","text":" "},{"type":"text","text":"transformed asynchronous sequence."}],"type":"paragraph"},{"code":["let romanNumeralDict: [Int: String] =","    [1: \"I\", 2: \"II\", 3: \"III\", 5: \"V\"]","    ","let stream = Counter(howHigh: 5)","    .compactMap { romanNumeralDict[$0] }","for await numeral in stream {","    print(numeral, terminator: \" \")","}","\/\/ Prints \"I II III V \""],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/asyncdropfirstsequence\/compactmap(_:)-874pn"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Creates an asynchronous sequence that maps the given closure over the"},{"type":"text","text":" "},{"type":"text","text":"asynchronous sequence’s elements, omitting results that don’t return a"},{"type":"text","text":" "},{"type":"text","text":"value."}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncDropFirstSequence"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"extendedModule":"_Concurrency","externalID":"s:Sci12_ConcurrencyE10compactMapyAA012AsyncCompactC8SequenceVyxqd__Gqd__Sg7ElementQzYaclF::SYNTHESIZED::s:12_Concurrency22AsyncDropFirstSequenceV","role":"symbol","modules":[{"name":"Swift","relatedModules":[]}],"symbolKind":"method","title":"compactMap(_:)","platforms":[{"introducedAt":"8.0","unavailable":false,"beta":false,"name":"iOS","deprecated":false},{"introducedAt":"8.0","unav