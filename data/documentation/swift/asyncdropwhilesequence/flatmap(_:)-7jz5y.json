},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncSequence","text":"AsyncSequence","preciseIdentifier":"s:Sci","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"transform","content":[{"type":"paragraph","inlineContent":[{"text":"An error-throwing mapping closure. ","type":"text"},{"type":"codeVoice","code":"transform"},{"type":"text","text":" "},{"text":"accepts an element of this sequence as its parameter and returns an","type":"text"},{"type":"text","text":" "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":". If "},{"type":"codeVoice","code":"transform"},{"type":"text","text":" throws an error, the sequence ends."}]}]}],"kind":"parameters"},{"content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single, flattened asynchronous sequence that contains all"},{"type":"text","text":" "},{"type":"text","text":"elements in all the asynchronous sequences produced by "},{"code":"transform","type":"codeVoice"},{"type":"text","text":". The"},{"text":" ","type":"text"},{"text":"sequence ends either when the last sequence created from the last","type":"text"},{"type":"text","text":" "},{"type":"text","text":"element from base sequence ends, or when "},{"code":"transform","type":"codeVoice"},{"type":"text","text":" throws an error."}]}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use this method to receive a single-level asynchronous sequence when your"},{"type":"text","text":" "},{"type":"text","text":"transformation produces an asynchronous sequence for each element."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"In this example, an asynchronous sequence called ","type":"text"},{"type":"codeVoice","code":"Counter"},{"type":"text","text":" produces "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"values from "},{"code":"1","type":"codeVoice"},{"type":"text","text":" to "},{"code":"5","type":"codeVoice"},{"text":". The transforming closure takes the received ","type":"text"},{"code":"Int","type":"codeVoice"},{"type":"text","text":" "},{"text":"and returns a new ","type":"text"},{"code":"Counter","type":"codeVoice"},{"type":"text","text":" that counts that high. For example, when the"},{"type":"text","text":" "},{"type":"text","text":"transform receives "},{"code":"3","type":"codeVoice"},{"type":"text","text":" from the base sequence, it creates a new "},{"code":"Counter","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"that produces the values "},{"code":"1","type":"codeVoice"},{"type":"text","text":", "},{"code":"2","type":"codeVoice"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"3"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"flatMap(_:)"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"“flattens” the resulting sequence-of-sequences into a single","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":". However, when the closure receives "},{"type":"codeVoice","code":"4"},{"type":"text","text":", it throws an"},{"type":"text","text":" "},{"type":"text","text":"error, terminating the sequence."}]},{"code":["do {","    let stream = Counter(howHigh: 5)","        .flatMap { (value) -> Counter in","            if value == 4 {","                throw MyError()","            }","            return Counter(howHigh: value)","        }","    for try await number in stream {","        print(number, terminator: \" \")","    }","} catch {","    print(error)","}","\/\/ Prints \"1 1 2 1 2 3 MyError() \""],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"metadata":{"role":"symbol","title":"flatMap(_:)","modules":[{"name":"Swift","related