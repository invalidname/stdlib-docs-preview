pple.Swift\/documentation\/Swift\/AsyncSequence"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"An error-throwing mapping closure. ","type":"text"},{"code":"transform","type":"codeVoice"},{"text":" ","type":"text"},{"text":"accepts an element of this sequence as its parameter and returns an","type":"text"},{"text":" ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":". If ","type":"text"},{"code":"transform","type":"codeVoice"},{"text":" throws an error, the sequence ends.","type":"text"}]}],"name":"transform"}]},{"content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A single, flattened asynchronous sequence that contains all","type":"text"},{"text":" ","type":"text"},{"text":"elements in all the asynchronous sequences produced by ","type":"text"},{"code":"transform","type":"codeVoice"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends either when the last sequence created from the last","type":"text"},{"text":" ","type":"text"},{"text":"element from base sequence ends, or when ","type":"text"},{"code":"transform","type":"codeVoice"},{"text":" throws an error.","type":"text"}]}],"kind":"content"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to receive a single-level asynchronous sequence when your"},{"type":"text","text":" "},{"type":"text","text":"transformation produces an asynchronous sequence for each element."}]},{"inlineContent":[{"type":"text","text":"In this example, an asynchronous sequence called "},{"code":"Counter","type":"codeVoice"},{"type":"text","text":" produces "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"values from "},{"code":"1","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"5","type":"codeVoice"},{"text":". The transforming closure takes the received ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and returns a new ","type":"text"},{"code":"Counter","type":"codeVoice"},{"text":" that counts that high. For example, when the","type":"text"},{"text":" ","type":"text"},{"text":"transform receives ","type":"text"},{"code":"3","type":"codeVoice"},{"text":" from the base sequence, it creates a new ","type":"text"},{"code":"Counter","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"that produces the values "},{"code":"1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"2","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"3","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"flatMap(_:)","type":"codeVoice"},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"“flattens” the resulting sequence-of-sequences into a single"},{"type":"text","text":" "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":". However, when the closure receives "},{"code":"4","type":"codeVoice"},{"text":", it throws an","type":"text"},{"text":" ","type":"text"},{"text":"error, terminating the sequence.","type":"text"}],"type":"paragraph"},{"code":["do {","    let stream = Counter(howHigh: 5)","        .flatMap { (value) -> Counter in","            if value == 4 {","                throw MyError()","            }","            return Counter(howHigh: value)","        }","    for try await number in stream {","        print(number, terminator: \" \")","    }","} catch {","    print(error)","}","\/\/ Prints \"1 1 2 1 2 3 MyError() \""],"syntax":"swift","type":"codeListing"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/asyncfiltersequence\/flatmap(_:)-kp0l"]}],"sections":[],"abstract":[{"text":"Creates an asynchronous sequence that concatenates