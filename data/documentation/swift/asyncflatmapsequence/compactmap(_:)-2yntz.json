ult","kind":"typeIdentifier","preciseIdentifier":"s:Sci12_ConcurrencyE10compactMapyAA020AsyncThrowingCompactC8SequenceVyxqd__Gqd__Sg7ElementQzYaKclF0H8OfResultL_qd__mfp"},{"text":">","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"transform","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An error-throwing mapping closure. "},{"code":"transform","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"accepts an element of this sequence as its parameter and returns a"},{"text":" ","type":"text"},{"text":"transformed value of the same or of a different type. If ","type":"text"},{"type":"codeVoice","code":"transform"},{"text":" ","type":"text"},{"type":"text","text":"throws an error, the sequence ends."}]}]}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"text":"An asynchronous sequence that contains, in order, the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" elements produced by the "},{"code":"transform","type":"codeVoice"},{"type":"text","text":" closure. The sequence"},{"text":" ","type":"text"},{"text":"ends either when the base sequence ends or when ","type":"text"},{"code":"transform","type":"codeVoice"},{"type":"text","text":" throws an"},{"text":" ","type":"text"},{"text":"error.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":"compactMap(_:)","type":"codeVoice"},{"text":" method to transform every element received from","type":"text"},{"text":" ","type":"text"},{"text":"a base asynchronous sequence, while also discarding any ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" results","type":"text"},{"type":"text","text":" "},{"type":"text","text":"from the closure. Typically, you use this to transform from one type of"},{"type":"text","text":" "},{"type":"text","text":"element to another."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this example, an asynchronous sequence called "},{"code":"Counter","type":"codeVoice"},{"text":" produces ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"values from "},{"code":"1","type":"codeVoice"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"5"},{"text":". The closure provided to the ","type":"text"},{"code":"compactMap(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"method takes each ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" and looks up a corresponding ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" from a","type":"text"},{"type":"text","text":" "},{"code":"romanNumeralDict","type":"codeVoice"},{"type":"text","text":" dictionary. Since there is no key for "},{"type":"codeVoice","code":"4"},{"text":", the closure","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" in this case, which "},{"type":"codeVoice","code":"compactMap(_:)"},{"text":" omits from the","type":"text"},{"type":"text","text":" "},{"text":"transformed asynchronous sequence. When the value is ","type":"text"},{"code":"5","type":"codeVoice"},{"text":", the closure","type":"text"},{"type":"text","text":" "},{"text":"throws ","type":"text"},{"type":"codeVoice","code":"MyError"},{"type":"text","text":", terminating the sequence."}]},{"code":["let romanNumeralDict: [Int: String] =","    [1: \"I\", 2: \"II\", 3: \"III\", 5: \"V\"]","","do {","    let stream = Counter(howHigh: 5)","        .compactMap { (value) throws -> String? in","            if value == 5 {","                throw MyError()","            }","            return romanNumeralDict[value]","        }","    for try await numeral in stream {","        print(numeral, terminator: \" \")","    }","} catch {","    print(\"Error: \\(error)\")","}","\/\/ Prints \"I II III Error: MyError() \""],"type":"codeListing","syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncFlatMapSequence"]]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncFlatMapSequence\/compactMap(_:)-2yntz","interfaceLanguage":"swift"},"abstract":[{"text":"Creates an asynchronous sequence that maps an error-throwing closure over","type":"text"},{"text":" ","type":"text"},{"text":"the base sequence’s elements, omitting results that don’t return a value.","type":"text"}],"references":{"doc://com.apple.Swift/documentation/Swift/AsyncFlatMapSequence":{"abstract":[{"type":"text","text":"An asynchronous sequence that concatenates the results of calling a given"},{"type":"text","text":" "},{"text":"transformation with each element of this sequence.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AsyncFlatMapSequence"}],"title":"AsyncFlatMapSequence","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AsyncFlatMapSequence"}],"url":"\/documentation\/swift\/asyncflatmapsequence","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncFlatMapSequence"},"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/AsyncFlatMapSequence/compactMap(_:)-2yntz":{"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swift\/asyncflatmapsequence\/compactmap(_:)-2yntz","title"