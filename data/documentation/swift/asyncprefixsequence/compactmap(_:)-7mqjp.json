":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"compactMap(_:)"},{"type":"text","text":" method to transform every element received from"},{"type":"text","text":" "},{"type":"text","text":"a base asynchronous sequence, while also discarding any "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" results"},{"type":"text","text":" "},{"type":"text","text":"from the closure. Typically, you use this to transform from one type of"},{"type":"text","text":" "},{"type":"text","text":"element to another."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this example, an asynchronous sequence called "},{"type":"codeVoice","code":"Counter"},{"type":"text","text":" produces "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" "},{"type":"text","text":"values from "},{"type":"codeVoice","code":"1"},{"type":"text","text":" to "},{"type":"codeVoice","code":"5"},{"type":"text","text":". The closure provided to the "},{"type":"codeVoice","code":"compactMap(_:)"},{"text":" ","type":"text"},{"type":"text","text":"method takes each "},{"code":"Int","type":"codeVoice"},{"text":" and looks up a corresponding ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" from a","type":"text"},{"text":" ","type":"text"},{"code":"romanNumeralDict","type":"codeVoice"},{"text":" dictionary. Since there is no key for ","type":"text"},{"code":"4","type":"codeVoice"},{"text":", the closure","type":"text"},{"text":" ","type":"text"},{"text":"returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" in this case, which ","type":"text"},{"code":"compactMap(_:)","type":"codeVoice"},{"text":" omits from the","type":"text"},{"text":" ","type":"text"},{"text":"transformed asynchronous sequence. When the value is ","type":"text"},{"code":"5","type":"codeVoice"},{"text":", the closure","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"throws "},{"code":"MyError","type":"codeVoice"},{"text":", terminating the sequence.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let romanNumeralDict: [Int: String] =","    [1: \"I\", 2: \"II\", 3: \"III\", 5: \"V\"]","","do {","    let stream = Counter(howHigh: 5)","        .compactMap { (value) throws -> String? in","            if value == 5 {","                throw MyError()","            }","            return romanNumeralDict[value]","        }","    for try await numeral in stream {","        print(numeral, terminator: \" \")","    }","} catch {","    print(\"Error: \\(error)\")","}","\/\/ Prints \"I II III Error: MyError() \""]}]}],"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/AsyncPrefixSequence":{"navigatorTitle":[{"kind":"identifier","text":"AsyncPrefixSequence"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncPrefixSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AsyncPrefixSequence"}],"role":"symbol","title":"AsyncPrefixSequence","kind":"symbol","url":"\/documentation\/swift\/asyncprefixsequence","abstract":[{"text":"An asynchronous sequence, up to a specified maximum length,","type":"text"},{"type":"text","text":" "},{"text":"containing the initial elements of a base asynchronous sequence.","type":"text"}],"type":"topic"},"doc://com.apple.Swift/documentation/Swift/AsyncPrefixSequence/compactMap(_:)-7mqjp":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"compactMap","kind":"identifier"},{"text":"<","kind":"text"},{"text":"ElementOfResult","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" (","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:Sci7ElementQa"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"t