tOfResult","preciseIdentifier":"s:Sci12_ConcurrencyE7flatMapyAA017AsyncThrowingFlatC8SequenceVyxqd__Gqd__7ElementQzYaKcSciRd__lF15SegmentOfResultL_qd__mfp","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","text":"SegmentOfResult"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sci","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncSequence","text":"AsyncSequence"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An error-throwing mapping closure. "},{"code":"transform","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"accepts an element of this sequence as its parameter and returns an"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncSequence"},{"text":". If ","type":"text"},{"code":"transform","type":"codeVoice"},{"type":"text","text":" throws an error, the sequence ends."}]}],"name":"transform"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"A single, flattened asynchronous sequence that contains all"},{"type":"text","text":" "},{"type":"text","text":"elements in all the asynchronous sequences produced by "},{"type":"codeVoice","code":"transform"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"sequence ends either when the last sequence created from the last"},{"type":"text","text":" "},{"type":"text","text":"element from base sequence ends, or when "},{"type":"codeVoice","code":"transform"},{"text":" throws an error.","type":"text"}],"type":"paragraph"}]},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to receive a single-level asynchronous sequence when your"},{"type":"text","text":" "},{"type":"text","text":"transformation produces an asynchronous sequence for each element."}]},{"inlineContent":[{"type":"text","text":"In this example, an asynchronous sequence called "},{"code":"Counter","type":"codeVoice"},{"type":"text","text":" produces "},{"type":"codeVoice","code":"Int"},{"text":" ","type":"text"},{"text":"values from ","type":"text"},{"type":"codeVoice","code":"1"},{"type":"text","text":" to "},{"type":"codeVoice","code":"5"},{"type":"text","text":". The transforming closure takes the received "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" "},{"type":"text","text":"and returns a new "},{"type":"codeVoice","code":"Counter"},{"text":" that counts that high. For example, when the","type":"text"},{"type":"text","text":" "},{"text":"transform receives ","type":"text"},{"code":"3","type":"codeVoice"},{"type":"text","text":" from the base sequence, it creates a new "},{"type":"codeVoice","code":"Counter"},{"text":" ","type":"text"},{"type":"text","text":"that produces the values "},{"type":"codeVoice","code":"1"},{"text":", ","type":"text"},{"type":"codeVoice","code":"2"},{"type":"text","text":", and "},{"type":"codeVoice","code":"3"},{"text":". The ","type":"text"},{"code":"flatMap(_:)","type":"codeVoice"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"“flattens” the resulting sequence-of-sequences into a single","type":"text"},{"text":" ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":". However, when the closure receives ","type":"text"},{"code":"4","type":"codeVoice"},{"text":", it throws an","type":"text"},{"text":" ","type":"text"},{"text":"error, terminating the sequence.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["do {","    let stream = Counter(howHigh: 5)","        .flatMap { (value) -> Counter in","            if value == 4 {","                throw MyError()","            }","            return Counter(howHigh: value)","        }","    for try await number in stream {","        print(number, terminator: \" \")","    }","} catch {","    print(error)","}","\/\/ Prints \"1 1 2 1 2 3 MyError() \""],"syntax":"swift"}],"kind":"content"}],"metadata":{"title":"flatMap(_:)","platforms":[{"name":"iOS","beta":false,"introducedAt":"8.0","deprecated":false,"unavailable":false},{"name":"iPadOS","beta":false,"introducedAt":"8.0","deprecated":false,"unavailable":false},{"name":"Mac Catalyst","beta":false,"introducedAt":"13.0","deprecated":false,"unavailable":false},{"name":"macOS","beta":false,"introducedAt":"10.10","deprecated":false,"unavailable":false},{"name":"tvOS","beta":false,"introducedAt":"9.0","deprecated":false,"unavailable":false},{"name":"visionOS","beta":false,"introducedAt":"1.0","deprecated":false,"unavailable":false},{"name":"watchOS","beta":false,"introducedAt":"2.0","deprecated":false,"unavailable":false}],"roleHeading":"Instance Method","externalID":"s:Sci12_ConcurrencyE7flatMapyAA017AsyncThrowingFlatC8SequenceVyxqd__Gqd__7ElementQzYaKcSciRd__lF::SYNTHESIZED::s:12_Concurrency19AsyncPrefixSequenceV","modules":[{"name":"Swift","relatedModules":[]}],"role":"symbol","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"flatMap"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"SegmentOfResult"},{"kind":"text","text":">("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:Sci7ElementQa"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"text":"SegmentOfResult","preciseIdentifier":"s:Sci12_ConcurrencyE7flatMapyAA017AsyncThrowingFlatC8SequenceVyxqd__Gqd__7ElementQzYaKcSciRd__lF15SegmentOfResultL_qd__mfp","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"text":"AsyncThrowingFlatMapSequence","kind":"typeIdentifier",