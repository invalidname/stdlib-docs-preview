nous sequence, while also discarding any "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" results"},{"text":" ","type":"text"},{"text":"from the closure. Typically, you use this to transform from one type of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"element to another."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this example, an asynchronous sequence called "},{"type":"codeVoice","code":"Counter"},{"type":"text","text":" produces "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" "},{"type":"text","text":"values from "},{"type":"codeVoice","code":"1"},{"type":"text","text":" to "},{"type":"codeVoice","code":"5"},{"type":"text","text":". The closure provided to the "},{"type":"codeVoice","code":"compactMap(_:)"},{"type":"text","text":" "},{"type":"text","text":"method takes each "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" and looks up a corresponding "},{"type":"codeVoice","code":"String"},{"type":"text","text":" from a"},{"type":"text","text":" "},{"type":"codeVoice","code":"romanNumeralDict"},{"type":"text","text":" dictionary. Since there is no key for "},{"type":"codeVoice","code":"4"},{"type":"text","text":", the closure"},{"type":"text","text":" "},{"type":"text","text":"returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" in this case, which "},{"type":"codeVoice","code":"compactMap(_:)"},{"type":"text","text":" omits from the"},{"type":"text","text":" "},{"type":"text","text":"transformed asynchronous sequence. When the value is "},{"type":"codeVoice","code":"5"},{"type":"text","text":", the closure"},{"type":"text","text":" "},{"type":"text","text":"throws "},{"type":"codeVoice","code":"MyError"},{"type":"text","text":", terminating the sequence."}]},{"code":["let romanNumeralDict: [Int: String] =","    [1: \"I\", 2: \"II\", 3: \"III\", 5: \"V\"]","","do {","    let stream = Counter(howHigh: 5)","        .compactMap { (value) throws -> String? in","            if value == 5 {","                throw MyError()","            }","            return romanNumeralDict[value]","        }","    for try await numeral in stream {","        print(numeral, terminator: \" \")","    }","} catch {","    print(\"Error: \\(error)\")","}","\/\/ Prints \"I II III Error: MyError() \""],"type":"codeListing","syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/asyncstream\/compactmap(_:)-944op"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/compactMap(_:)-944op"},"seeAlsoSections":[{"title":"Transforming a Sequence","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/map(_:)-58nsf","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/map(_:)-4a4la","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/compactMap(_:)-7mgjd","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/flatMap(_:)-vhhr","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/reduce(_:_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/reduce(into:_:)"],"generated":true,"anchor":"Transforming-a-Sequence"}],"references":{"doc://com.apple.Swift/documentation/Swift/AsyncStream":{"url":"\/documentation\/swift\/asyncstream","kind":"symbol","abstract":[{"type":"text","text":"An asynchronous sequence generated from a closure that calls a continuation"},{"type":"text","text":" "},{"type":"text","text":"to produce new elements."}],"navigatorTitle":[{"kind":"identifier","text":"AsyncStream"}],"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncStream"}],"title":"AsyncStream"},"doc://com.apple.Swift/documentation/Swift/AsyncSequence/Element":{"abstract":[{"type":"text","text":"The type of element produced by this async