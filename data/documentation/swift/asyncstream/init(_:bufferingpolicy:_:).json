"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"elementType","content":[{"type":"paragraph","inlineContent":[{"text":"The type of element the ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" produces."}]}]},{"name":"limit","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Continuation.BufferingPolicy"},{"text":" value to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"set the stream’s buffering behavior. By default, the stream buffers an"},{"type":"text","text":" "},{"type":"text","text":"unlimited number of elements. You can also set the policy to buffer a"},{"type":"text","text":" "},{"type":"text","text":"specified number of oldest or newest elements."}]}]},{"content":[{"inlineContent":[{"text":"A custom closure that yields values to the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"text":". This closure receives an ","type":"text"},{"code":"AsyncStream.Continuation","type":"codeVoice"},{"text":" ","type":"text"},{"text":"instance that it uses to provide elements to the stream and terminate the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"stream when finished."}],"type":"paragraph"}],"name":"build"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"AsyncStream.Continuation"},{"text":" received by the ","type":"text"},{"type":"codeVoice","code":"build"},{"type":"text","text":" closure is"},{"type":"text","text":" "},{"type":"text","text":"appropriate for use in concurrent contexts. It is thread safe to send and"},{"type":"text","text":" "},{"type":"text","text":"finish; all calls to the continuation are serialized. However, calling"},{"type":"text","text":" "},{"type":"text","text":"this from multiple concurrent contexts could result in out-of-order"},{"type":"text","text":" "},{"type":"text","text":"delivery."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows an "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" created with this"},{"type":"text","text":" "},{"type":"text","text":"initializer that produces 100 random numbers on a one-second interval,"},{"type":"text","text":" "},{"type":"text","text":"calling "},{"type":"codeVoice","code":"yield(_:)"},{"type":"text","text":" to deliver each element to the awaiting call point."},{"type":"text","text":" "},{"type":"text","text":"When the "},{"code":"for","type":"codeVoice"},{"type":"text","text":" loop exits, the stream finishes by calling the"},{"type":"text","text":" "},{"type":"text","text":"continuation’s "},{"code":"finish()","type":"codeVoice"},{"text":" method.","type":"text"}]},{"syntax":"swift","code":["let stream = AsyncStream<Int>(Int.self,","                              bufferingPolicy: .bufferingNewest(5)) { continuation in","    Task.detached {","        for _ in 0..<100 {","            await Task.sleep(1 * 1_000_000_000)","            continuation.yield(Int.random(in: 1...10))","        }","        continuation.finish()","    }","}","","\/\/ Call point:","for await random in stream {","    print(random)","}"],"type":"codeListing"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.apple.Swift/documentation/Swift/AsyncStream/Continuation":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Continuation","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Continuation"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/Continuation","role":"symbol","title":"AsyncStream.Continuation","url":"\/document