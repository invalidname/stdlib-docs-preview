ounded, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"build"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/Continuation","preciseIdentifier":"s:ScS12ContinuationV","text":"Continuation"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Void","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":")"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"elementType","content":[{"inlineContent":[{"type":"text","text":"The type of element the "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" produces."}],"type":"paragraph"}]},{"name":"limit","content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Continuation.BufferingPolicy"},{"type":"text","text":" value to"},{"type":"text","text":" "},{"type":"text","text":"set the stream’s buffering behavior. By default, the stream buffers an"},{"type":"text","text":" "},{"type":"text","text":"unlimited number of elements. You can also set the policy to buffer a"},{"type":"text","text":" "},{"type":"text","text":"specified number of oldest or newest elements."}],"type":"paragraph"}]},{"name":"build","content":[{"inlineContent":[{"type":"text","text":"A custom closure that yields values to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":". This closure receives an "},{"type":"codeVoice","code":"AsyncStream.Continuation"},{"type":"text","text":" "},{"type":"text","text":"instance that it uses to provide elements to the stream and terminate the"},{"type":"text","text":" "},{"type":"text","text":"stream when finished."}],"type":"paragraph"}]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"AsyncStream.Continuation"},{"type":"text","text":" received by the "},{"type":"codeVoice","code":"build"},{"type":"text","text":" closure is"},{"type":"text","text":" "},{"type":"text","text":"appropriate for use in concurrent contexts. It is thread safe to send and"},{"type":"text","text":" "},{"type":"text","text":"finish; all calls to the continuation are serialized. However, calling"},{"type":"text","text":" "},{"type":"text","text":"this from multiple concurrent contexts could result in out-of-order"},{"type":"text","text":" "},{"text":"delivery.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example shows an ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" created with this","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"initializer that produces 100 random numbers on a one-second interval,"},{"text":" ","type":"text"},{"text":"calling ","type":"text"},{"code":"yield(_:)","type":"codeVoice"},{"text":" to deliver each element to the awaiting call point.","type":"text"},{"text":" ","type":"text"},{"text":"When the ","type":"text"},{"code":"for","type":"codeVoice"},{"text":" loop exits, the stream finishes by calling the","type":"text"},{"type":"text","text":" "},{"text":"continuation’s ","type":"text"},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" method."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let stream = AsyncStream<Int>(Int.self,","                              bufferingPolicy: .bufferingNewest(5)) { continuation in","    Task.detached {","        for _ in 0..<100 {","            await Task.sleep(1 * 1_000_000_000)","            continuation.yield(Int.random(in: 1...10))","        }","        continuation.finish()","    }","}","","\/\/ Call point:","for await random in stream {","    print(random)","}"]}],"kind":"content"}],"metadata":{"title":"init(_:bufferingPolicy:_:)","roleHeading":"Initializer","fragments":[{"text":"init","kin