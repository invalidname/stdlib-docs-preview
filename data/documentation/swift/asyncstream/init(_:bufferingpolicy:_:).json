00 random numbers on a one-second interval,"},{"text":" ","type":"text"},{"text":"calling ","type":"text"},{"code":"yield(_:)","type":"codeVoice"},{"text":" to deliver each element to the awaiting call point.","type":"text"},{"text":" ","type":"text"},{"text":"When the ","type":"text"},{"code":"for","type":"codeVoice"},{"text":" loop exits, the stream finishes by calling the","type":"text"},{"text":" ","type":"text"},{"text":"continuation’s ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" method.","type":"text"}],"type":"paragraph"},{"code":["let stream = AsyncStream<Int>(Int.self,","                              bufferingPolicy: .bufferingNewest(5)) { continuation in","    Task.detached {","        for _ in 0..<100 {","            await Task.sleep(1 * 1_000_000_000)","            continuation.yield(Int.random(in: 1...10))","        }","        continuation.finish()","    }","}","","\/\/ Call point:","for await random in stream {","    print(random)","}"],"syntax":"swift","type":"codeListing"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/init(_:bufferingPolicy:_:)","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"anchor":"Creating-a-Continuation-Based-Stream","title":"Creating a Continuation-Based Stream","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/Continuation\/BufferingPolicy","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/Continuation"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Constructs an asynchronous stream for an element type, using the"},{"type":"text","text":" "},{"type":"text","text":"specified buffering policy and element-producing closure."}],"sections":[],"metadata":{"role":"symbol","title":"init(_:bufferingPolicy:_:)","symbolKind":"init","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:ScS7Elementxmfp","text":"Element","kind"