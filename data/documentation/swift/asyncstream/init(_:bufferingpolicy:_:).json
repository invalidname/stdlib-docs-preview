e","code":"Continuation.BufferingPolicy"},{"type":"text","text":" value to"},{"type":"text","text":" "},{"type":"text","text":"set the stream’s buffering behavior. By default, the stream buffers an"},{"type":"text","text":" "},{"type":"text","text":"unlimited number of elements. You can also set the policy to buffer a"},{"type":"text","text":" "},{"type":"text","text":"specified number of oldest or newest elements."}],"type":"paragraph"}],"name":"limit"},{"name":"build","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A custom closure that yields values to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":". This closure receives an "},{"type":"codeVoice","code":"AsyncStream.Continuation"},{"type":"text","text":" "},{"type":"text","text":"instance that it uses to provide elements to the stream and terminate the"},{"type":"text","text":" "},{"type":"text","text":"stream when finished."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"AsyncStream.Continuation"},{"type":"text","text":" received by the "},{"type":"codeVoice","code":"build"},{"type":"text","text":" closure is"},{"type":"text","text":" "},{"type":"text","text":"appropriate for use in concurrent contexts. It is thread safe to send and"},{"type":"text","text":" "},{"type":"text","text":"finish; all calls to the continuation are serialized. However, calling"},{"type":"text","text":" "},{"type":"text","text":"this from multiple concurrent contexts could result in out-of-order"},{"type":"text","text":" "},{"type":"text","text":"delivery."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows an "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" created with this"},{"type":"text","text":" "},{"type":"text","text":"initi