{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream"]]},"metadata":{"symbolKind":"init","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"unfolding"},{"kind":"text","text":": "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ScS7Elementxmfp"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"onCancel"},{"kind":"text","text":": ("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":")?)"}],"platforms":[{"deprecated":false,"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iOS"},{"deprecated":false,"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iPadOS"},{"unavailable":false,"beta":false,"deprecated":false,"name":"Mac Catalyst","introducedAt":"13.0"},{"deprecated":false,"beta":false,"unavailable":false,"introducedAt":"10.10","name":"macOS"},{"deprecated":false,"beta":false,"unavailable":false,"introducedAt":"9.0","name":"tvOS"},{"unavailable":false,"beta":false,"deprecated":false,"name":"visionOS","introducedAt":"1.0"},{"unavailable":false,"beta":false,"deprecated":false,"name":"watchOS","introducedAt":"2.0"}],"externalID":"s:ScS9unfolding8onCancelScSyxGxSgyYac_yycSgtcfc","title":"init(unfolding:onCancel:)","role":"symbol","modules":[{"name":"Swift","relatedModules":[]}],"roleHeading":"Initializer"},"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/init(unfolding:onCancel:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@preconcurrency","kind":"attribute"},{"text":" ","kind":"text"},{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"unfolding","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"produce","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping","kind":"attribute"},{"text":" ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ScS7Elementxmfp"},{"text":"?, ","kind":"text"},{"text":"onCancel","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Void","preciseIdentifier":"s:s4Voida"},{"text":")? = nil)","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"produce","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that asynchronously produces elements for the"},{"type":"text","text":" "},{"type":"text","text":"stream."}]}]},{"name":"onCancel","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure to execute when canceling the stream’s task."}]}]}]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"text":"Use this convenience initializer when you have an asynchronous function","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that can produce elements for the stream, and don’t want to invoke"},{"type":"text","text":" "},{"type":"text","text":"a continuation manually. This initializer “unfolds” your closure into"},{"type":"text","text":" "},{"type":"text","text":"an asynchronous stream. The created stream handles conformance"},{"type":"text","text":" "},{"type":"text","text":"to the "},{"type":"codeVoice","code":"AsyncSequence"},{"text":" protocol automatically, including termination","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(either by cancellation or by returning "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" from the closure to finish"},{"type":"text","text":" "},{"type":"text","text":"iteration)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows an "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" created with this"},{"text":" ","type":"text"},{"type":"text","text":"initializer that produces random numbers on a one-second interval. This"},{"type":"text","text":" "},{"type":"text","text":"example uses the Swift multiple trailing closure syntax, which omits"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"unfolding","type":"codeVoice"},{"type":"text","text":" parameter label."}]},{"syntax":"swift","code":["let stream = AsyncStream<Int> {","    await Task.sleep(1 * 1_000_000_000)","    return Int.random(in: 1...10)","} onCancel: { @Sendable () in print(\"Canceled.\") }","","\/\/ Call point:","for await random in stream {","    print(random)","}"],"type":"codeListing"},{"type":"aside","content":[{"inlineContent":[{"text":"Because the system might call the ","type":"text"},{"code":"onCancel","type":"codeVoice"},{"text":" callback as","type":"text"},{"text":" ","type":"text"},{"text":"part of task cancellation, it’s subject to the same considerations for","type":"text"},{"text":" ","type":"text"},{"text":"avoiding deadlock as outlined in the documentation for","type":"text"},{"text":" ","type":"text"},{"code":"withTaskCancellationHandler(operation:onCancel:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Constructs an asynchronous stream from a given element-producing"},{"type":"text","text":" "},{"type":"text","text":"closure, with an optional closure to handle cancellation."}],"variants":[{"paths":["\/d