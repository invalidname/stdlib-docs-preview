pe":"text"},{"type":"text","text":" "},{"type":"text","text":"part of task cancellation, it’s subject to the same considerations for"},{"type":"text","text":" "},{"type":"text","text":"avoiding deadlock as outlined in the documentation for"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"style":"note","name":"Note"}]}],"metadata":{"platforms":[{"introducedAt":"8.0","deprecated":false,"beta":false,"name":"iOS","unavailable":false},{"introducedAt":"8.0","deprecated":false,"beta":false,"name":"iPadOS","unavailable":false},{"introducedAt":"13.0","deprecated":false,"beta":false,"name":"Mac Catalyst","unavailable":false},{"introducedAt":"10.10","deprecated":false,"beta":false,"name":"macOS","unavailable":false},{"introducedAt":"9.0","deprecated":false,"beta":false,"name":"tvOS","unavailable":false},{"introducedAt":"1.0","deprecated":false,"beta":false,"name":"visionOS","unavailable":false},{"introducedAt":"2.0","deprecated":false,"beta":false,"name":"watchOS","unavailable":false}],"externalID":"s:ScS9unfolding8onCancelScSyxGxSgyYac_yycSgtcfc","role":"symbol","symbolKind":"init","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"unfolding","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:ScS7Elementxmfp","text":"Element","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"onCancel","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":")?)","kind":"text"}],"title":"init(unfolding:onCancel:)","modules":[{"relatedModules":[],"name":"Swift"}