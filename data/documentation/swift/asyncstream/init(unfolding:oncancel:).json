s” your closure into"},{"type":"text","text":" "},{"text":"an asynchronous stream. The created stream handles conformance","type":"text"},{"text":" ","type":"text"},{"text":"to the ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" protocol automatically, including termination","type":"text"},{"text":" ","type":"text"},{"text":"(either by cancellation or by returning ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" from the closure to finish"},{"type":"text","text":" "},{"text":"iteration).","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows an "},{"type":"codeVoice","code":"AsyncStream"},{"text":" created with this","type":"text"},{"type":"text","text":" "},{"type":"text","text":"initializer that produces random numbers on a one-second interval. This"},{"type":"text","text":" "},{"type":"text","text":"example uses the Swift multiple trailing closure syntax, which omits"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"unfolding"},{"type":"text","text":" parameter label."}]},{"type":"codeListing","code":["let stream = AsyncStream<Int> {","    await Task.sleep(1 * 1_000_000_000)","    return Int.random(in: 1...10)","} onCancel: { @Sendable () in print(\"Canceled.\") }","","\/\/ Call point:","for await random in stream {","    print(random)","}"],"syntax":"swift"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the system might call the "},{"type":"codeVoice","code":"onCancel"},{"type":"text","text":" callback as"},{"type":"text","text":" "},{"type":"text","text":"part of task cancellation, it’s subject to the same considerations for"},{"type":"text","text":" "},{"type":"text","text":"avoiding deadlock as outlined in the documentation for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)","isActive":true},{"type":"text","text":"."}]}],"style":"note","name":"Note"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/asyncstream\/init(unfolding:oncancel:)"]}],"kind":"symbol","abstract":[{"type":"text","text":"Constructs an asynchronous stream from a given element-producing"},{"type":"text","text":" "},{"type":"text","text":"closure, with an optional closure to handle cancellation."}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream"]]},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"symbolKind":"init","title":"init(unfolding:onCancel:)","externalID":"s:ScS9unfolding8onCancelScSyxGxSgyYac_yycSgtcfc","role":"symbol","platforms":[{"deprecated":false,"beta":false,"unavailable":false,"name":"iOS","introducedAt":"8.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"iPadOS","introducedAt":"8.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"Mac Catalyst","introducedAt":"13.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"macOS","introducedAt":"10.10"},{"deprecated":false,"beta":false,"unavailable":false,"name":"tvOS","introducedAt":"9.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0"},{"name":"watchOS","introducedAt":"2.0","deprecated":false,"beta":false,"unavailable":false}],"fragments":[{"text":"init","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"unfolding"},{"text":": ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Element","preciseIdentifier":"s:ScS7Elementxmfp","kind":"typeIdentifier"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"onCancel"},{"kind":"text","text":": ("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" (