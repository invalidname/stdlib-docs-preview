{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/init(unfolding:onCancel:)"},"sections":[],"abstract":[{"type":"text","text":"Constructs an asynchronous stream from a given element-producing"},{"type":"text","text":" "},{"type":"text","text":"closure, with an optional closure to handle cancellation."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@preconcurrency"},{"kind":"text","text":" "},{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"unfolding"},{"kind":"text","text":" "},{"kind":"internalParam","text":"produce"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping"},{"kind":"text","text":" "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ScS7Elementxmfp"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"onCancel"},{"kind":"text","text":": ("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Void"},{"kind":"text","text":")? = nil)"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"produce","content":[{"inlineContent":[{"type":"text","text":"A closure that asynchronously produces elements for the"},{"type":"text","text":" "},{"type":"text","text":"stream."}],"type":"paragraph"}]},{"name":"onCancel","content":[{"inlineContent":[{"type":"text","text":"A closure to execute when canceling the stream’s task."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use this convenience initializer when you have an asynchronous function","type":"text"},{"type":"text","text":" "},{"type":"text","text":"that can produce elements for the stream, and don’t want to invoke"},{"type":"text","text":" "},{"type":"text","text":"a continuation manually. This initializer “unfolds” your closure into"},{"type":"text","text":" "},{"type":"text","text":"an asynchronous stream. The created stream handles conformance"},{"type":"text","text":" "},{"text":"to the ","type":"text"},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" protocol automatically, including termination"},{"type":"text","text":" "},{"type":"text","text":"(either by cancellation or by returning "},{"type":"codeVoice","code":"nil"},{"text":" from the closure to finish","type":"text"},{"text":" ","type":"text"},{"text":"iteration).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example shows an ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"text":" created with this","type":"text"},{"text":" ","type":"text"},{"text":"initializer that produces random numbers on a one-second interval. This","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"example uses the Swift multiple trailing closure syntax, which omits"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"unfolding"},{"type":"text","text":" parameter label."}]},{"type":"codeListing","syntax":"swift","code":["let stream = AsyncStream<Int> {","    await Task.sleep(1 * 1_000_000_000)","    return Int.random(in: 1...10)","} onCancel: { @Sendable () in print(\"Canceled.\") }","","\/\/ Call point:","for await random in stream {","    print(random)","}"]},{"style":"note","content":[{"inlineContent":[{"text":"Because the system might call the ","type":"text"},{"code":"onCancel","type":"codeVoice"},{"type":"text","text":" callback as"},{"type":"text","text":" "},{"type":"text","text":"part of task cancellation, it’s subject to the same considerations for"},{"text":" ","type":"text"},{"text":"avoiding deadlock as outlined in the documentation for","type":"text"},{"text":" ","type":"text"},{"code":"withTaskCancellationHandler(operation:onCancel:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Note","type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/asyncstream\/init(unfolding:oncancel:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"role":"symbol","title":"init(unfolding:onCancel:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"unfolding","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ScS7Elementxmfp"},{"text":"?, ","kind":"text"},{"text":"onCancel","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":")?)","kind":"text"}],"modules":[{"name":"Swift","relatedModules":[]}],"externalID":"s:ScS9unfolding8onCancelScSyxGxSgyYac_yycSgtcfc","symbolKind":"init","roleHeading":"Initializer","platforms":[{"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iPadOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"13.0","name":"Mac Catalyst","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"10.10","name":"macOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"9.0","name":"tvOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"1.0","name":"visio