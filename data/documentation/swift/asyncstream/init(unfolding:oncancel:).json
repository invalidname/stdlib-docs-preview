"},{"type":"text","text":" "},{"type":"text","text":"to the "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" protocol automatically, including termination"},{"type":"text","text":" "},{"type":"text","text":"(either by cancellation or by returning "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" from the closure to finish"},{"type":"text","text":" "},{"type":"text","text":"iteration)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows an "},{"code":"AsyncStream","type":"codeVoice"},{"type":"text","text":" created with this"},{"type":"text","text":" "},{"type":"text","text":"initializer that produces random numbers on a one-second interval. This"},{"type":"text","text":" "},{"type":"text","text":"example uses the Swift multiple trailing closure syntax, which omits"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"unfolding","type":"codeVoice"},{"type":"text","text":" parameter label."}]},{"code":["let stream = AsyncStream<Int> {","    await Task.sleep(1 * 1_000_000_000)","    return Int.random(in: 1...10)","} onCancel: { @Sendable () in print(\"Canceled.\") }","","\/\/ Call point:","for await random in stream {","    print(random)","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream\/init(unfolding:onCancel:)"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncStream"]]},"metadata":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"unfolding"},{"kind":"text","text":": "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS7Elementxmfp","t