eciseIdentifier":"s:Sci12_ConcurrencyE7flatMapyAA017AsyncThrowingFlatC8SequenceVyxqd__Gqd__7ElementQzYaKcSciRd__lF15SegmentOfResultL_qd__mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingFlatMapSequence","text":"AsyncThrowingFlatMapSequence","preciseIdentifier":"s:12_Concurrency28AsyncThrowingFlatMapSequenceV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"SegmentOfResult","preciseIdentifier":"s:Sci12_ConcurrencyE7flatMapyAA017AsyncThrowingFlatC8SequenceVyxqd__Gqd__7ElementQzYaKcSciRd__lF15SegmentOfResultL_qd__mfp","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SegmentOfResult","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncSequence","text":"AsyncSequence","preciseIdentifier":"s:Sci","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"transform","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An error-throwing mapping closure. "},{"type":"codeVoice","code":"transform"},{"type":"text","text":" "},{"type":"text","text":"accepts an element of this sequence as its parameter and returns an"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":". If "},{"type":"codeVoice","code":"transform"},{"type":"text","text":" throws an error, the sequence ends."}]}]}]},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A single, flattened asynchronous sequence that contains all","type":"text"},{"text":" ","type":"text"},{"text":"elements in all the asynchronous sequences produced by ","type":"text"},{"type":"codeVoice","code":"transform"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"sequence ends either when the last sequence created from the last","type":"text"},{"text":" ","type":"text"},{"text":"element from base sequence ends, or when ","type":"text"},{"type":"codeVoice","code":"transform"},{"text":" throws an error.","type":"text"}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Use this method to receive a single-level asynchronous sequence when your","type":"text"},{"text":" ","type":"text"},{"text":"transformation produces an asynchronous sequence for each element.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In this example, an asynchronous sequence called ","type":"text"},{"type":"codeVoice","code":"Counter"},{"text":" produces ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" ","type":"text"},{"text":"values from ","type":"text"},{"type":"codeVoice","code":"1"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"5"},{"text":". The transforming closure takes the received ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" ","type":"text"},{"text":"and returns a new ","type":"text"},{"type":"codeVoice","code":"Counter"},{"text":" that counts that high. For example, when the","type":"text"},{"text":" ","type":"text"},{"text":"transform receives ","type":"text"},{"type":"codeVoice","code":"3"},{"text":" from the base sequence, it creates a new ","type":"text"},{"type":"codeVoice","code":"Counter"},{"text":" ","type":"text"},{"text":"that produces the values ","type":"text"},{"type":"codeVoice","code":"1"},{"text":", ","type":"text"},{"type":"codeVoice","code":"2"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"3"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"flatMap(_:)"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"“flattens” the resulting sequence-of-sequences into a single","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncSequence"},{"text":". However, when the closure receives ","type":"text"},{"type":"codeVoice","code":"4"},{"text":", it throws an","type":"text"},{"text":" ","type":"text"},{"text":"error, terminating the sequence.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let stream = Counter(howHigh: 5)","        .flatMap { (value) -> Counter in","            if value == 4 {","                throw MyError()","            }","            return Counter(howHigh: value)","        }","    for try await number in stream {","        print(number, terminator: \" \")","    }","} catch {","    print(error)","}","\/\/ Prints \"1 1 2 1 2 3 MyError() \""]}],"kind":"content"}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/AsyncThrowingCompactMapSequence":{"abstract":[{"text":"An asynchronous sequence that maps an error-throwing closure over the base","type":"text"},{"text":" ","type":"text"},{"text":"sequence’s elements, omitting results that don’t return a value.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AsyncThrowingCompactMapSequence"}],"url":"\/documentation\/swift\/asyncthrowingcompactmapsequence","kind":"symbol","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingCompactMapSequence","title":"AsyncThrowingCompactMapSequence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncThrowingCompactMapSequence"}],"role":"symbol"},"doc://com.apple.Swift/documentation/Swift/AsyncThrowingCompactMapSequence/flatMap(_:)-1xasg":{"url":"\/documentation\/swift\/asyncthrowingcompactmapsequence\/flatmap(_:)-1xasg","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingCompactMapSequence\/flatMap(_:)-1xasg","abstract":[{"type":"text","text":"Creates an asynchronous sequence that concatenates the results of calling"},{"type":"text","text":" "},{"type":"text","text