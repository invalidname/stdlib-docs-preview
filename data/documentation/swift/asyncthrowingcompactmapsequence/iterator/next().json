"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This iterator calls "},{"code":"next()","type":"codeVoice"},{"type":"text","text":" on its base iterator; if this call returns"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", "},{"code":"next()","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":". Otherwise, "},{"code":"next()","type":"codeVoice"},{"type":"text","text":" calls the"},{"type":"text","text":" "},{"type":"text","text":"transforming closure on the received element, returning it if the"},{"type":"text","text":" "},{"type":"text","text":"transform returns a non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" value. If the transform returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"this method continues to wait for further elements until it gets one"},{"type":"text","text":" "},{"type":"text","text":"that transforms to a non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" value. If calling the closure throws an"},{"type":"text","text":" "},{"type":"text","text":"error, the sequence ends and "},{"code":"next()","type":"codeVoice"},{"type":"text","text":" rethrows the error."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingCompactMapSequence\/Iterator\/next()","interfaceLanguage":"swift"},"abstract":[{"text":"Produces the next element in the compact map sequence.","type":"text"}],"variants":[{"paths":["\/documentation\/swift\/asyncthrowingcompactmapsequence\/iterator\/next()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingCompactMapSequence","doc:\/\/com.apple.Swift\/