ation produces an asynchronous sequence for each element."}]},{"type":"paragraph","inlineContent":[{"text":"In this example, an asynchronous sequence called ","type":"text"},{"code":"Counter","type":"codeVoice"},{"text":" produces ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" ","type":"text"},{"text":"values from ","type":"text"},{"type":"codeVoice","code":"1"},{"text":" to ","type":"text"},{"code":"5","type":"codeVoice"},{"type":"text","text":". The transforming closure takes the received "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" "},{"type":"text","text":"and returns a new "},{"code":"Counter","type":"codeVoice"},{"text":" that counts that high. For example, when the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"transform receives "},{"type":"codeVoice","code":"3"},{"type":"text","text":" from the base sequence, it creates a new "},{"code":"Counter","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"that produces the values "},{"type":"codeVoice","code":"1"},{"type":"text","text":", "},{"code":"2","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"3","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"flatMap(_:)","type":"codeVoice"},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"“flattens” the resulting sequence-of-sequences into a single"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":". However, when the closure receives "},{"type":"codeVoice","code":"4"},{"type":"text","text":", it throws an"},{"type":"text","text":" "},{"type":"text","text":"error, terminating the sequence."}]},{"type":"codeListing","code":["do {","    let stream = Counter(howHigh: 5)","        .flatMap { (value) -> Counter in","            if value == 4 {","                throw MyError()","            }","            return Counter(howHigh: value)","        }","    for try await number in stream {","        print(number, terminator: \" \")","    }","} catch {","    print(error)","}","\/\/ Prints \"1 1 2 1 2 3 MyError() \""],"syntax":"swift"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/asyncthrowingdropwhilesequence\/flatmap(_:)-86tec"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingDropWhileSequence\/flatMap(_:)-86tec","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Creates an asynchronous sequence that concatenates the results of calling"},{"type":"text","text":" "},{"type":"text","text":"the given error-throwing transformation with each element of this"},{"type":"text","text":" "},{"type":"text","text":"sequence."}],"kind":"symbol","sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/AsyncSequence/Element":{"required":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncSequence\/Element","title":"Element","role":"symbol","abstract":[{"text":"The type of element produced by this asynchronous sequence.","type":"text"}],"type":"topic","url":"\/documentation\/swift\/asyncsequence\/element","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Element"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/AsyncSequence":{"url":"\/documentation\/swift\/asyncsequence","title":"AsyncSequence","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"AsyncSequence","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A type that provides asynchronous, sequential, iterated access to its"},{"type":"text","text":" "},{"type":"text","text":"elements."}],"navigatorTitle":[{"text":"AsyncSequence","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncSequence","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard 