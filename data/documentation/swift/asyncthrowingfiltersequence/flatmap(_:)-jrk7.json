type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Use this method to receive a single-level asynchronous sequence when your","type":"text"},{"text":" ","type":"text"},{"text":"transformation produces an asynchronous sequence for each element.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In this example, an asynchronous sequence called ","type":"text"},{"code":"Counter","type":"codeVoice"},{"text":" produces ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" ","type":"text"},{"text":"values from ","type":"text"},{"code":"1","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"5","type":"codeVoice"},{"text":". The transforming closure takes the received ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and returns a new ","type":"text"},{"code":"Counter","type":"codeVoice"},{"text":" that counts that high. For example, when the","type":"text"},{"text":" ","type":"text"},{"text":"transform receives ","type":"text"},{"code":"3","type":"codeVoice"},{"text":" from the base sequence, it creates a new ","type":"text"},{"code":"Counter","type":"codeVoice"},{"text":" ","type":"text"},{"text":"that produces the values ","type":"text"},{"code":"1","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"2"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"3"},{"type":"text","text":". The "},{"type":"codeVoice","code":"flatMap(_:)"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"“flattens” the resulting sequence-of-sequences into a single","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncSequence"},{"text":". However, when the closure receives ","type":"text"},{"type":"codeVoice","code":"4"},{"text":", it throws an","type":"text"},{"type":"text","text":" "},{"type":"text","text":"error, terminating the sequence."}],"type":"paragraph"},{"code":["do {","    let stream = Counter(howHigh: 5)","        .flatMap { (value) -> Counter in","            if value == 4 {","                throw MyError()","            }","            return Counter(howHigh: value)","        }","    for try await number in stream {","        print(number, terminator: \" \")","    }","} catch {","    print(error)","}","\/\/ Prints \"1 1 2 1 2 3 MyError() \""],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/asyncthrowingfiltersequence\/flatmap(_:)-jrk7"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingFilterSequence\/flatMap(_:)-jrk7"},"references":{"doc://com.apple.Swift/documentation/Swift/AsyncThrowingFlatMapSequence":{"abstract":[{"type":"text","text":"An asynchronous sequence that concatenates the results of calling a given"},{"type":"text","text":" "},{"text":"error-throwing transformation with each element of this sequence.","type":"text"}],"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingFlatMapSequence","navigatorTitle":[{"text":"AsyncThrowingFlatMapSequence","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncThrowingFlatMapSequence","kind":"identifier"}],"kind":"symbol","title":"AsyncThrowingFlatMapSequence","role":"symbol","url":"\/documentation\/swift\/asyncthrowingflatmapsequence"},"doc://com.apple.Swift/documentation/Swift/AsyncSequence":{"url":"\/documentation\/swift\/asyncsequence","title":"AsyncSequence","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncSequence","abstract":[{"text":"A type that provides asynchronous, sequential, iterated access to its","type":"text"},{"type":"text","text":" "},{"type":"text","text":"elements."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{