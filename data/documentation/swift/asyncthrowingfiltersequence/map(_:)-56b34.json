ode":"1","type":"codeVoice"},{"type":"text","text":" to "},{"code":"5","type":"codeVoice"},{"type":"text","text":". The closure provided to the "},{"code":"map(_:)","type":"codeVoice"},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"takes each "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" and looks up a corresponding "},{"code":"String","type":"codeVoice"},{"type":"text","text":" from a"},{"type":"text","text":" "},{"code":"romanNumeralDict","type":"codeVoice"},{"type":"text","text":" dictionary. This means the outer "},{"type":"codeVoice","code":"for await in"},{"type":"text","text":" loop"},{"type":"text","text":" "},{"type":"text","text":"iterates over "},{"type":"codeVoice","code":"String"},{"type":"text","text":" instances instead of the underlying "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" values"},{"type":"text","text":" "},{"type":"text","text":"that "},{"type":"codeVoice","code":"Counter"},{"type":"text","text":" produces. Also, the dictionary doesn’t provide a key for"},{"type":"text","text":" "},{"code":"4","type":"codeVoice"},{"type":"text","text":", and the closure throws an error for any key it can’t look up, so"},{"type":"text","text":" "},{"type":"text","text":"receiving this value from "},{"code":"Counter","type":"codeVoice"},{"type":"text","text":" ends the modified sequence with an"},{"type":"text","text":" "},{"type":"text","text":"error."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let romanNumeralDict: [Int: String] =","    [1: \"I\", 2: \"II\", 3: \"III\", 5: \"V\"]","","do {","    let stream = Counter(howHigh: 5)","        .map { (value) throws -> String in","            guard let roman = romanNumeralDict[value] else {","                throw MyError()","            }","            return roman","        }","    for try await numeral in stream {","        print(numeral, terminator: \" \")","    }","} catch {","    print(\"Error: \\(error)\")","}","\/\/ Prints \"I II III Error: MyError() \""]}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingFilterSequence"]]},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/asyncthrowingfiltersequence\/map(_:)-56b34"]}],"references":{"doc://com.apple.Swift/documentation/Swift/AsyncThrowingMapSequence":{"type":"topic","role":"symbol","abstract":[{"text":"An asynchronous sequence that maps the given error-throwing closure over the","type":"text"},{"text":" ","type":"text"},{"text":"asynchronous sequence’s elements.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncThrowingMapSequence","kind":"identifier"}],"navigatorTitle":[{"text":"AsyncThrowingMapSequence","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingMapSequence","title":"AsyncThrowingMapSequence","kind":"symbol","url":"\/documentation\/swift\/asyncthrowingmapsequence"},"doc://com.apple.Swift/documentation/Swift/AsyncThrowingFilterSequence":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingFilterSequence","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncThrowingFilterSequence","kind":"identifier"}],"title":"AsyncThrowingFilterSequence","navigatorTitle":[{"text":"AsyncThrowingFilterSequence","kind":"identifier"}],"url":"\/documentation\/swift\/asyncthrowingfiltersequence","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"An asynchronous sequence that contains, in order, the elements of"},{"type":"text","text":" "},{"type":"text","text":"the base sequence that satisfy the given error-throwing predicate."}]},"doc://com.apple.Swift/documentation/Swift/AsyncSequence/Element":{"type":"topic","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":