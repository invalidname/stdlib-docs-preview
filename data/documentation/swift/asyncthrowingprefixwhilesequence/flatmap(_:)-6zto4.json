xt","text":"element from base sequence ends, or when "},{"type":"codeVoice","code":"transform"},{"type":"text","text":" throws an error."}],"type":"paragraph"}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this method to receive a single-level asynchronous sequence when your"},{"type":"text","text":" "},{"type":"text","text":"transformation produces an asynchronous sequence for each element."}],"type":"paragraph"},{"inlineContent":[{"text":"In this example, an asynchronous sequence called ","type":"text"},{"code":"Counter","type":"codeVoice"},{"text":" produces ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" ","type":"text"},{"text":"values from ","type":"text"},{"type":"codeVoice","code":"1"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"5"},{"text":". The transforming closure takes the received ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" ","type":"text"},{"text":"and returns a new ","type":"text"},{"type":"codeVoice","code":"Counter"},{"text":" that counts that high. For example, when the","type":"text"},{"text":" ","type":"text"},{"text":"transform receives ","type":"text"},{"type":"codeVoice","code":"3"},{"text":" from the base sequence, it creates a new ","type":"text"},{"type":"codeVoice","code":"Counter"},{"text":" ","type":"text"},{"text":"that produces the values ","type":"text"},{"type":"codeVoice","code":"1"},{"text":", ","type":"text"},{"type":"codeVoice","code":"2"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"3"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"flatMap(_:)"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"“flattens” the resulting sequence-of-sequences into a single","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncSequence"},{"text":". However, when the closure receives ","type":"text"},{"type":"codeVoice","code":"4"},{"text":", it throws an","type":"text"},{"text":" ","type":"text"},{"text":"error, terminating the sequence.","type":"text"}],"type":"paragraph"},{"code":["do {","    let stream = Counter(howHigh: 5)","        .flatMap { (value) -> Counter in","            if value == 4 {","                throw MyError()","            }","            return Counter(howHigh: value)","        }","    for try await number in stream {","        print(number, terminator: \" \")","    }","} catch {","    print(error)","}","\/\/ Prints \"1 1 2 1 2 3 MyError() \""],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingPrefixWhileSequence\/flatMap(_:)-6zto4"},"sections":[],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/AsyncSequence/Element":{"abstract":[{"type":"text","text":"The type of element produced by this asynchronous sequence."}],"type":"topic","url":"\/documentation\/swift\/asyncsequence\/element","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncSequence\/Element","title":"Element","required":true,"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"role":"symbol"},"doc://com.apple.Swift/documentation/Swift/AsyncThrowingPrefixWhileSequence":{"role":"symbol","abstract":[{"text":"An asynchronous sequence, containing the initial, consecutive","type":"text"},{"text":" ","type":"text"},{"text":"elements of the base sequence that satisfy the given error-throwing","type":"text"},{"text":" ","type":"text"},{"text":"predicate.","type":"text"}],"url":"\/documentation\/swift\/asyncthrowingprefixwhilesequence","title":"AsyncThrowingPrefixWhileSequence","navigatorTitle":[{"kind":"identifier","text":"AsyncThrowingPrefixWhileSequence"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingPrefixWhileSequence","type":"topic","fragments":[{"text":"struct","ki