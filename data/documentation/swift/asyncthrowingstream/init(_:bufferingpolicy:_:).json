wift\/documentation\/Swift\/AsyncThrowingStream"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"text":"elementType","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Element","preciseIdentifier":"s:Scs7Elementxmfp","kind":"typeIdentifier"},{"text":".Type = Element.self, ","kind":"text"},{"text":"bufferingPolicy","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"limit","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Scs12ContinuationV","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/Continuation","text":"Continuation"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Scs12ContinuationV15BufferingPolicyO","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/Continuation\/BufferingPolicy","text":"BufferingPolicy"},{"text":" = .unbounded, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"build","kind":"internalParam"},{"text":": (","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/Continuation","kind":"typeIdentifier","text":"Continuation","preciseIdentifier":"s:Scs12ContinuationV"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Void","kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" == any ","kind":"text"},{"text":"Error","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The type of element the "},{"type":"codeVoice","code":"AsyncThrowingStream"},{"type":"text","text":" "},{"type":"text","text":"produces."}],"type":"paragraph"}],"name":"elementType"},{"content":[{"inlineContent":[{"type":"text","text":"The maximum number of elements to"},{"type":"text","text":" "},{"type":"text","text":"hold in the buffer. By default, this value is unlimited. Use a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Continuation.BufferingPolicy"},{"text":" to buffer a specified number of oldest","type":"text"},{"text":" ","type":"text"},{"text":"or newest elements.","type":"text"}],"type":"paragraph"}],"name":"limit"},{"name":"build","content":[{"inlineContent":[{"type":"text","text":"A custom closure that yields values to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncThrowingStream"},{"type":"text","text":". This closure receives an"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncThrowingStream.Continuation"},{"type":"text","text":" instance that it uses to provide"},{"type":"text","text":" "},{"type":"text","text":"elements to the stream and terminate the stream when finished."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"AsyncStream.Continuation","type":"codeVoice"},{"text":" received by the ","type":"text"},{"code":"build","type":"codeVoice"},{"text":" closure is","type":"text"},{"text":" ","type":"text"},{"text":"appropriate for use in concurrent contexts. It is thread safe to send and","type":"text"},{"text":" ","type":"text"},{"text":"finish; all calls to the continuation are serialized. However, calling","type":"text"},{"text":" ","type":"text"},{"text":"this from multiple concurrent contexts could result in out-of-order","type":"text"},{"text":" ","type":"text"},{"text":"delivery.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example shows an ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" created with this","type":"text"},{"text":" ","type":"text"},{"text":"initializer that produces 100 random numbers on a one-second interval,","type":"text"},{"text":" ","type":"text"},{"text":"calling ","type":"text"},{"code":"yield(_:)","type":"codeVoice"},{"text":" to deliver each element to the awaiting call point.","type":"text"},{"text":" ","type":"text"},{"text":"When the ","type":"text"},{"code":"for","type":"codeVoice"},{"text":" loop exits, the stream finishes by calling the","type":"text"},{"text":" ","type":"text"},{"text":"continuation’s ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" method. If the random number is divisible by 5","type":"text"},{"text":" ","type":"text"},{"text":"with no remainder, the stream throws a ","type":"text"},{"code":"MyRandomNumberError","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let stream = AsyncThrowingStream<Int, Error>(Int.self,","                                             bufferingPolicy: .bufferingNewest(5)) { continuation in","    Task.detached {","        for _ in 0..<100 {","            await Task.sleep(1 * 1_000_000_000)","            let random = Int.random(in: 1...10)","            if random % 5 == 0 {","                continuation.finish(throwing: MyRandomNumberError())","                return","            } else {","                continuation.yield(random)","            }","        }","        continuation.finish()","    }","}","","\/\/ Call point:","do {","    for try await random in stream {","        print(random)","    }","} catch {","    print(error)","}"],"type":"codeListing"}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/Continuation\/BufferingPolicy","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/Continuation"],"title":"Creating a Continuation-Based Stream"