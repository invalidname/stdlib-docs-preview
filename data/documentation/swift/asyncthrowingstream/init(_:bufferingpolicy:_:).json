ved by the "},{"type":"codeVoice","code":"build"},{"type":"text","text":" closure is"},{"type":"text","text":" "},{"type":"text","text":"appropriate for use in concurrent contexts. It is thread safe to send and"},{"type":"text","text":" "},{"type":"text","text":"finish; all calls to the continuation are serialized. However, calling"},{"type":"text","text":" "},{"type":"text","text":"this from multiple concurrent contexts could result in out-of-order"},{"type":"text","text":" "},{"type":"text","text":"delivery."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows an "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" created with this"},{"type":"text","text":" "},{"type":"text","text":"initializer that produces 100 random numbers on a one-second interval,"},{"type":"text","text":" "},{"type":"text","text":"calling "},{"type":"codeVoice","code":"yield(_:)"},{"type":"text","text":" to deliver each element to the awaiting call point."},{"type":"text","text":" "},{"type":"text","text":"When the "},{"type":"codeVoice","code":"for"},{"type":"text","text":" loop exits, the stream finishes by calling the"},{"type":"text","text":" "},{"type":"text","text":"continuation’s "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" method. If the random number is divisible by 5"},{"type":"text","text":" "},{"type":"text","text":"with no remainder, the stream throws a "},{"type":"codeVoice","code":"MyRandomNumberError"},{"type":"text","text":"."}]},{"code":["let stream = AsyncThrowingStream<Int, Error>(Int.self,","                                             bufferingPolicy: .bufferingNewest(5)) { continuation in","    Task.detached {","        for _ in 0..<100 {","            await Task.sleep(1 * 1_000_000_000)","            let random = Int.random(in: 1...10)","            if random % 5 == 0 {","                continuation.finish(throwing: MyRandomNumberError())","                return","            } else {","                continuation.yield(random)","            }","        }","        continuation.finish()","    }","}","","\/\/ Call point:","do {","    for try await random in stream {","        print(random)","    }","} catch {","    print(error)","}"],"syntax":"swift","type":"codeListing"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/init(_:bufferingPolicy:_:)"},"references":{"doc://com.apple.Swift/documentation/Swift":{"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","title":"Swift","url":"\/documentation\/swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"images":[{"identifier":"Swift-PageImage-card.png","type":"card"}],"kind":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream":{"abstract":[{"text":"An asynchronous sequence generated from an error-throwing closure that","type":"text"},{"text":" ","type":"text"},{"text":"calls a continuation to produce new elements.","type":"text"}],"title":"AsyncThrowingStream","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncThrowingStream","kind":"identifier"}],"navigatorTitle":[{"text":"AsyncThrowingStream","kind":"identifier"}],"url":"\/documentation\/swift\/asyncthrowingstream","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream"},"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream/Continuation/BufferingPolicy":{"abstract":[{"type":"text","text":"A strategy that handles exhaustion of a buffer’s capacity."}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"BufferingPolicy","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"BufferingPolicy"}],"url":"\/documentation\/swift\/asyncthrowingstream\/continuation\/bufferingpolicy","title"