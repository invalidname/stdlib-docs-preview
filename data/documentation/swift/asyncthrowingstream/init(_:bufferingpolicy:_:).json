d":"text","text":" "},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":" == any "},{"preciseIdentifier":"s:s5ErrorP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","kind":"typeIdentifier","text":"Error"}]}]},{"kind":"parameters","parameters":[{"name":"elementType","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The type of element the "},{"code":"AsyncThrowingStream","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"produces."}]}]},{"name":"limit","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The maximum number of elements to"},{"type":"text","text":" "},{"type":"text","text":"hold in the buffer. By default, this value is unlimited. Use a"},{"type":"text","text":" "},{"code":"Continuation.BufferingPolicy","type":"codeVoice"},{"type":"text","text":" to buffer a specified number of oldest"},{"type":"text","text":" "},{"type":"text","text":"or newest elements."}]}]},{"name":"build","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A custom closure that yields values to the"},{"type":"text","text":" "},{"code":"AsyncThrowingStream","type":"codeVoice"},{"type":"text","text":". This closure receives an"},{"type":"text","text":" "},{"code":"AsyncThrowingStream.Continuation","type":"codeVoice"},{"type":"text","text":" instance that it uses to provide"},{"type":"text","text":" "},{"type":"text","text":"elements to the stream and terminate the stream when finished."}]}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"AsyncStream.Continuation"},{"type":"text","text":" received by the "},{"type":"codeVoice","code":"build"},{"type":"text","text":" closure is"},{"type":"text","text":" "},{"type":"text","text":"appropriate for use in concurrent contexts. It is thread safe to send and"},{"type":"text","text":" "},{"type":"text","text":"finish; all calls are to the continuation are serialized. However, calling"},{"type":"text","text":" "},{"type":"text","text":"this from multiple concurrent contexts could result in out-of-order"},{"type":"text","text":" "},{"type":"text","text":"delivery."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example shows an "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" created with this"},{"type":"text","text":" "},{"type":"text","text":"initializer that produces 100 random numbers on a one-second interval,"},{"type":"text","text":" "},{"type":"text","text":"calling "},{"type":"codeVoice","code":"yield(_:)"},{"type":"text","text":" to deliver each element to the awaiting call point."},{"type":"text","text":" "},{"type":"text","text":"When the "},{"type":"codeVoice","code":"for"},{"type":"text","text":" loop exits, the stream finishes by calling the"},{"type":"text","text":" "},{"type":"text","text":"continuation’s "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" method. If the random number is divisible by 5"},{"type":"text","text":" "},{"type":"text","text":"with no remainder, the stream throws a "},{"type":"codeVoice","code":"MyRandomNumberError"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let stream = AsyncThrowingStream<Int, Error>(Int.self,","                                             bufferingPolicy: .bufferingNewest(5)) { continuation in","    Task.detached {","        for _ in 0..<100 {","            await Task.sleep(1 * 1_000_000_000)","            let random = Int.random(in: 1...10)","            if random % 5 == 0 {","                continuation.finish(throwing: MyRandomNumberError())","                return","            } else {","                continuation.yield(random)","            }","        }","        continuation.finish()","    }","}","","\/\/ Call point:","do {","    for try await random in stream {","        print(random)","    }","} catch {","    print(error)","}"]}]}],"variants":[{"paths":["\/documentation\/swift\/asyncthrowingstream\/init(_:bufferingpolicy:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Constructs an asynchronous stream for an element type, using the"},{"type":"text","text":" "},{"type":"text","text":"specified buffering policy and element-producing closure."}],"references":{"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream/Continuation":{"type":"topic","abstract":[{"type":"text","text":"A mechanism to interface between synchronous code and an asynchronous"},{"type":"text","text":" "},{"type":"text","text":"stream."}],"kind":"symbol","title":"AsyncThrowingStream.Continuation","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Continuation","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/Continuation","navigatorTitle":[{"text":"Continuation","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swift\/asyncthrowingstream\/continuation"},"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream/Continuation/BufferingPolicy":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/Continuation\/BufferingPolicy","navigatorTitle":[{"kind":"identifier","text":"BufferingPolicy"}],"url":"\/documentation\/swift\/asyncthrowingstream\/continuation\/bufferingpolicy","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"BufferingPolicy"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A strategy that handles exhaustion of a buffer’s capacity."}],"title":"AsyncThrowingStream.Continuation.BufferingPolicy"},"doc://com.apple.Swift/documentation/Swift":{"type":"topic","kind":"symbol","url":"\/documentation\/swift","role":"collection","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/