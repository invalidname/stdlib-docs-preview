,"code":"AsyncStream.Continuation"},{"type":"text","text":" received by the "},{"type":"codeVoice","code":"build"},{"type":"text","text":" closure is"},{"type":"text","text":" "},{"type":"text","text":"appropriate for use in concurrent contexts. It is thread safe to send and"},{"type":"text","text":" "},{"type":"text","text":"finish; all calls to the continuation are serialized. However, calling"},{"type":"text","text":" "},{"type":"text","text":"this from multiple concurrent contexts could result in out-of-order"},{"type":"text","text":" "},{"type":"text","text":"delivery."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example shows an "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" created with this"},{"type":"text","text":" "},{"type":"text","text":"initializer that produces 100 random numbers on a one-second interval,"},{"type":"text","text":" "},{"type":"text","text":"calling "},{"type":"codeVoice","code":"yield(_:)"},{"type":"text","text":" to deliver each element to the awaiting call point."},{"type":"text","text":" "},{"type":"text","text":"When the "},{"type":"codeVoice","code":"for"},{"type":"text","text":" loop exits, the stream finishes by calling the"},{"type":"text","text":" "},{"type":"text","text":"continuation’s "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" method. If the random number is divisible by 5"},{"type":"text","text":" "},{"type":"text","text":"with no remainder, the stream throws a "},{"type":"codeVoice","code":"MyRandomNumberError"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["let stream = AsyncThrowingStream<Int, Error>(Int.self,","                                             bufferingPolicy: .bufferingNewest(5)) { continuation in","    Task.detached {","        for _ in 0..<100 {","            await Task.sleep(1 * 1_000_000_000)","            let random = Int.random(in: 1...10)","            if random % 5 == 0 {","                continuation.finish(throwing: MyRandomNumberError())","                return","            } else {","                continuation.yield(random)","            }","        }","        continuation.finish()","    }","}","","\/\/ Call point:","do {","    for try await random in stream {","        print(random)","    }","} catch {","    print(error)","}"],"type":"codeListing"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.apple.Swift/documentation/Swift":{"title":"Swift","type":"topic","abstract":[{"type":"text","text":"Build apps using a powerful open language."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","url":"\/documentation\/swift","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream/Continuation":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Continuation","kind":"identifier"}],"title":"AsyncThrowingStream.Continuation","navigatorTitle":[{"text":"Continuation","kind":"identifier"}],"type":"topic","url":"\/documentation\/swift\/asyncthrowingstream\/continuation","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/Continuation","abstract":[{"type":"text","text":"A mechanism to interface between synchronous code and an asynchronous"},{"type":"text","text":" "},{"type":"text","text":"stream."}],"role":"symbol"},"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream/init(_:bufferingPolicy:_:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/init(_:bufferingPolicy:_:)","url":"\/documentation\/swift\/asyncthrowingstream\/init(_:bufferingpolicy:_:)","kind":"symbol","abstract":[{"type":"text","text":"Constructs an asynchronous stream for an element type, using the"},{"type":"text","text":" "},{"type":"text","text":"specified buffering policy and element-producing closure."}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"t