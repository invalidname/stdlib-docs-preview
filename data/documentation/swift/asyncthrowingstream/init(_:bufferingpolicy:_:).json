ng a Continuation-Based Stream"}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"elementType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Scs7Elementxmfp","text":"Element"},{"kind":"text","text":".Type = Element.self, "},{"kind":"externalParam","text":"bufferingPolicy"},{"kind":"text","text":" "},{"kind":"internalParam","text":"limit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Continuation","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/Continuation","preciseIdentifier":"s:Scs12ContinuationV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"BufferingPolicy","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/Continuation\/BufferingPolicy","preciseIdentifier":"s:Scs12ContinuationV15BufferingPolicyO"},{"kind":"text","text":" = .unbounded, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"build"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Continuation","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/Continuation","preciseIdentifier":"s:Scs12ContinuationV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":" == any "},{"kind":"typeIdentifier","text":"Error","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The type of element the ","type":"text"},{"code":"AsyncThrowingStream","type":"codeVoice"},{"text":" ","type":"text"},{"text":"produces.","type":"text"}],"type":"paragraph"}],"name":"elementType"},{"name":"limit","content":[{"type":"paragraph","inlineContent":[{"text":"The maximum number of elements to","type":"text"},{"text":" ","type":"text"},{"text":"hold in the buffer. By default, this value is unlimited. Use a","type":"text"},{"text":" ","type":"text"},{"code":"Continuation.BufferingPolicy","type":"codeVoice"},{"text":" to buffer a specified number of oldest","type":"text"},{"text":" ","type":"text"},{"text":"or newest elements.","type":"text"}]}]},{"name":"build","content":[{"type":"paragraph","inlineContent":[{"text":"A custom closure that yields values to the","type":"text"},{"text":" ","type":"text"},{"code":"AsyncThrowingStream","type":"codeVoice"},{"text":". This closure receives an","type":"text"},{"text":" ","type":"text"},{"code":"AsyncThrowingStream.Continuation","type":"codeVoice"},{"text":" instance that it uses to provide","type":"text"},{"text":" ","type":"text"},{"text":"elements to the stream and terminate the stream when finished.","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"AsyncStream.Continuation"},{"type":"text","text":" received by the "},{"type":"codeVoice","code":"build"},{"text":" closure is","type":"text"},{"text":" ","type":"text"},{"text":"appropriate for use in concurrent contexts. It is thread safe to send and","type":"text"},{"text":" ","type":"text"},{"text":"finish; all calls to the continuation are serialized. However, calling","type":"text"},{"text":" ","type":"text"},{"text":"this from multiple concurrent contexts could result in out-of-order","type":"text"},{"text":" ","type":"text"},{"text":"delivery.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows an "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" created with this"},{"type":"text","text":" "},{"type":"text","text":"initializer that produces 100 random numbers on a one-second interval,"},{"type":"text","text":" "},{"text":"calling ","type":"text"},{"code":"yield(_:)","type":"codeVoice"},{"type":"text","text":" to deliver each element to the awaiting call point."},{"type":"text","text":" "},{"type":"text","text":"When the "},{"type":"codeVoice","code":"for"},{"text":" loop exits, the stream finishes by calling the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"continuation’s "},{"type":"codeVoice","code":"finish()"},{"text":" method. If the random number is divisible by 5","type":"text"},{"text":" ","type":"text"},{"text":"with no remainder, the stream throws a ","type":"text"},{"type":"codeVoice","code":"MyRandomNumberError"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let stream = AsyncThrowingStream<Int, Error>(Int.self,","                                             bufferingPolicy: .bufferingNewest(5)) { continuation in","    Task.detached {","        for _ in 0..<100 {","            await Task.sleep(1 * 1_000_000_000)","            let random = Int.random(in: 1...10)","            if random % 5 == 0 {","                continuation.finish(throwing: MyRandomNumberError())","                return","            } else {","                continuation.yield(random)","            }","        }","        continuation.finish()","    }","}","","\/\/ Call point:","do {","    for try await random in stream {","        print(random)","    }","} catch {","    print(error)","}"]}]}],"variants":[{"paths":["\/documentation\/swift\/asyncthrowingst