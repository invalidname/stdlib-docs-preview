,{"type":"text","text":" "},{"type":"text","text":"appropriate for use in concurrent contexts. It is thread safe to send and"},{"type":"text","text":" "},{"type":"text","text":"finish; all calls to the continuation are serialized. However, calling"},{"type":"text","text":" "},{"type":"text","text":"this from multiple concurrent contexts could result in out-of-order"},{"type":"text","text":" "},{"type":"text","text":"delivery."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example shows an "},{"code":"AsyncStream","type":"codeVoice"},{"type":"text","text":" created with this"},{"type":"text","text":" "},{"type":"text","text":"initializer that produces 100 random numbers on a one-second interval,"},{"type":"text","text":" "},{"type":"text","text":"calling "},{"code":"yield(_:)","type":"codeVoice"},{"type":"text","text":" to deliver each element to the awaiting call point."},{"type":"text","text":" "},{"type":"text","text":"When the "},{"code":"for","type":"codeVoice"},{"type":"text","text":" loop exits, the stream finishes by calling the"},{"type":"text","text":" "},{"type":"text","text":"continuation’s "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" method. If the random number is divisible by 5"},{"type":"text","text":" "},{"type":"text","text":"with no remainder, the stream throws a "},{"code":"MyRandomNumberError","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let stream = AsyncThrowingStream<Int, Error>(Int.self,","                                             bufferingPolicy: .bufferingNewest(5)) { continuation in","    Task.detached {","        for _ in 0..<100 {","            await Task.sleep(1 * 1_000_000_000)","            let random = Int.random(in: 1...10)","            if random % 5 == 0 {","                continuation.finish(throwing: MyRandomNumberError())","                return","            } else {","                continuation.yie