ind":"typeIdentifier","text":"Void"},{"kind":"text","text":") "},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" == any ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","text":"Error"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"elementType","content":[{"type":"paragraph","inlineContent":[{"text":"The type of element the ","type":"text"},{"code":"AsyncThrowingStream","type":"codeVoice"},{"text":" ","type":"text"},{"text":"produces.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The maximum number of elements to"},{"type":"text","text":" "},{"type":"text","text":"hold in the buffer. By default, this value is unlimited. Use a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Continuation.BufferingPolicy"},{"type":"text","text":" to buffer a specified number of oldest"},{"type":"text","text":" "},{"type":"text","text":"or newest elements."}],"type":"paragraph"}],"name":"limit"},{"name":"build","content":[{"inlineContent":[{"type":"text","text":"A custom closure that yields values to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncThrowingStream"},{"text":". This closure receives an","type":"text"},{"text":" ","type":"text"},{"code":"AsyncThrowingStream.Continuation","type":"codeVoice"},{"text":" instance that it uses to provide","type":"text"},{"type":"text","text":" "},{"text":"elements to the stream and terminate the stream when finished.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"AsyncStream.Continuation","type":"codeVoice"},{"text":" received by the ","type":"text"},{"code":"build","type":"codeVoice"},{"text":" closure is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"appropriate for use in concurrent contexts. It is thread safe to send and"},{"type":"text","text":" "},{"type":"text","text":"finish; all calls to the continuation are serialized. However, calling"},{"type":"text","text":" "},{"text":"this from multiple concurrent contexts could result in out-of-order","type":"text"},{"text":" ","type":"text"},{"text":"delivery.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example shows an ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" created with this"},{"text":" ","type":"text"},{"text":"initializer that produces 100 random numbers on a one-second interval,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"calling "},{"code":"yield(_:)","type":"codeVoice"},{"type":"text","text":" to deliver each element to the awaiting call point."},{"text":" ","type":"text"},{"type":"text","text":"When the "},{"code":"for","type":"codeVoice"},{"type":"text","text":" loop exits, the stream finishes by calling the"},{"type":"text","text":" "},{"type":"text","text":"continuation’s "},{"type":"codeVoice","code":"finish()"},{"text":" method. If the random number is divisible by 5","type":"text"},{"text":" ","type":"text"},{"text":"with no remainder, the stream throws a ","type":"text"},{"code":"MyRandomNumberError","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["let stream = AsyncThrowingStream<Int, Error>(Int.self,","                                             bufferingPolicy: .bufferingNewest(5)) { continuation in","    Task.detached {","        for _ in 0..<100 {","            await Task.sleep(1 * 1_000_000_000)","            let random = Int.random(in: 1...10)","            if random % 5 == 0 {","                continuation.finish(throwing: MyRandomNumberError())","                return","            } else {","                continuation.yield(random)","            }","        }","        continuation.finish()","    }","}","","\/\/ Call point:","do {","    for try await random in stream {","        print(random)","    }","} catch {","    print(error)","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"Constructs an asynchronous stream for an element type, using the","type":"text"},{"text":" ","type":"text"},{"text":"specified buffering policy and element-producing closure.","type":"text"}],"references":{"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream/Continuation":{"url":"\/documentation\/swift\/asyncthrowingstream\/continuation","type":"topic","navigatorTitle":[{"text":"Continuation","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A mechanism to interface between synchronous code and an asynchronous"},{"text":" ","type":"text"},{"type":"text","text":"stream."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/Continuation","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Continuation","kind":"identifier"}],"role":"symbol","title":"AsyncThrowingStream.Continuation"},"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream/init(_:bufferingPolicy:_:)":{"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swift\/asyncthrowingstream\/init(_:bufferingpolicy:_:)","title":"init(_:bufferingPolicy:_:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/init(_:bufferingPolicy:_:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:Scs7Elementxmfp","text":"Element","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"bufferingPolicy","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Scs12ContinuationV","text":"Continuation","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"BufferingPolicy","preciseIdentifier":"s:Scs12ContinuationV15BufferingPolicyO","kind":"typeIdentifier"},{