{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream"]]},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@preconcurrency"},{"kind":"text","text":" "},{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"unfolding"},{"kind":"text","text":" "},{"kind":"internalParam","text":"produce"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping"},{"kind":"text","text":" "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:Scs7Elementxmfp"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":" == any "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","preciseIdentifier":"s:s5ErrorP"}]}]},{"parameters":[{"name":"produce","content":[{"type":"paragraph","inlineContent":[{"text":"A closure that asynchronously produces elements for the","type":"text"},{"text":" ","type":"text"},{"text":"stream.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Use this convenience initializer when you have an asynchronous function"},{"type":"text","text":" "},{"type":"text","text":"that can produce elements for the stream, and don’t want to invoke"},{"type":"text","text":" "},{"type":"text","text":"a continuation manually. This initializer “unfolds” your closure into"},{"type":"text","text":" "},{"type":"text","text":"a full-blown asynchronous stream. The created stream handles adherence to"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" protocol automatically. To terminate the stream with"},{"type":"text","text":" "},{"type":"text","text":"an error, throw the error from your closure."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example shows an "},{"code":"AsyncThrowingStream","type":"codeVoice"},{"type":"text","text":" created with this"},{"type":"text","text":" "},{"type":"text","text":"initializer that produces random numbers on a one-second interval. If the"},{"type":"text","text":" "},{"type":"text","text":"random number is divisible by 5 with no remainder, the stream throws a"},{"type":"text","text":" "},{"code":"MyRandomNumberError","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let stream = AsyncThrowingStream<Int, Error> {","    await Task.sleep(1 * 1_000_000_000)","    let random = Int.random(in: 1...10)","    if random % 5 == 0 {","        throw MyRandomNumberError()","    }","    return random","}","","\/\/ Call point:","do {","    for try await random in stream {","        print(random)","    }","} catch {","    print(error)","}"]}]}],"metadata":{"roleHeading":"Initializer","symbolKind":"init","role":"symbol","modules":[{"name":"Swift","relatedModules":[]}],"platforms":[{"name":"iOS","introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false},{"beta":false,"unavailable":false,"name":"iPadOS","deprecated":false,"introducedAt":"8.0"},{"name":"Mac Catalyst","introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false},{"name":"macOS","introducedAt":"10.10","deprecated":false,"unavailable":false,"beta":false},{"name":"tvOS","introducedAt":"9.0","deprecated":false,"unavailable":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false},{"name":"watchOS","introducedAt":"2.0","deprecated":false,"unavailable":false,"beta":false}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"unfolding","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:Scs7Elementxmfp"},{"text":"?)","kind":"text"}],"title":"init(unfolding:)","externalID":"s:Scs9unfoldingScsyxs5Error_pGxSgyYaKc_tcsAB_pRs_rlufc"},"abstract":[{"type":"text","text":"Constructs an asynchronous throwing stream from a given element-producing"},{"type":"text","text":" "},{"type":"text","text":"closure."}],"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/init(unfolding:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swift\/asyncthrowingstream\/init(unfolding:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","type":"topic","role":"collection","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","title":"Swift","kind":"symbol","images":[{"identifier":"Swift-PageImage-card.png","type":"card"}]},"doc://com.apple.Swift/documentation/Swift/Error":{"abstract":[{"text":"A type representing an error value that can be thrown.","type":"text"}],"navigatorTitle":[{"text":"Error","kind":"identifier"}],"type":"topic","title":"Error","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Error","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","url":"\/documentation\/swift\/error","role":"symbol"},"doc://com