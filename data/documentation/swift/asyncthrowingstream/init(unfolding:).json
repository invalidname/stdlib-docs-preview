eclarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@preconcurrency","kind":"attribute"},{"text":" ","kind":"text"},{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"unfolding","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"produce","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping","kind":"attribute"},{"text":" ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:Scs7Elementxmfp"},{"text":"?) ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" == any ","kind":"text"},{"text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error"}]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"A closure that asynchronously produces elements for the"},{"type":"text","text":" "},{"type":"text","text":"stream."}],"type":"paragraph"}],"name":"produce"}],"kind":"parameters"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use this convenience initializer when you have an asynchronous function","type":"text"},{"text":" ","type":"text"},{"text":"that can produce elements for the stream, and don’t want to invoke","type":"text"},{"text":" ","type":"text"},{"text":"a continuation manually. This initializer “unfolds” your closure into","type":"text"},{"text":" ","type":"text"},{"text":"a full-blown asynchronous stream. The created stream handles adherence to","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" protocol automatically. To terminate the stream with","type":"text"},{"text":" ","type":"text"},{"text":"an error, throw the error from your closure.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example shows an ","type":"text"},{"code":"AsyncThrowingStream","type":"codeVoice"},{"text":" created with this","type":"text"},{"text":" ","type":"text"},{"text":"initializer that produces random numbers on a one-second interval. If the","type":"text"},{"text":" ","type":"text"},{"text":"random number is divisible by 5 with no remainder, the stream throws a","type":"text"},{"text":" ","type":"text"},{"code":"MyRandomNumberError","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":"swift","code":["let stream = AsyncThrowingStream<Int, Error> {","    await Task.sleep(1 * 1_000_000_000)","    let random = Int.random(in: 1...10)","    if random % 5 == 0 {","        throw MyRandomNumberError()","    }","    return random","}","","\/\/ Call point:","do {","    for try await random in stream {","        print(random)","    }","} catch {","    print(error)","}"],"type":"codeListing"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://com.apple.Swift/documentation/Swift/Error":{"title":"Error","abstract":[{"text":"A type representing an error value that can be thrown.","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Error","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Error"}],"url":"\/documentation\/swift\/error","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error"},"Swift-PageImage-card.png":{"alt":"An orange Swift logo on a gradient background.","type":"image","identifier":"Swift-PageImage-card.png","variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png","traits":["2x","dark"]}]},"doc://com.apple.Swift/docume