{"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Constructs an asynchronous throwing stream from a given element-producing"},{"type":"text","text":" "},{"type":"text","text":"closure."}],"variants":[{"paths":["\/documentation\/swift\/asyncthrowingstream\/init(unfolding:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@preconcurrency","kind":"attribute"},{"text":" ","kind":"text"},{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"unfolding","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"produce","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping","kind":"attribute"},{"text":" ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:Scs7Elementxmfp","text":"Element","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" == any ","kind":"text"},{"preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"produce","content":[{"type":"paragraph","inlineContent":[{"text":"A closure that asynchronously produces elements for the","type":"text"},{"text":" ","type":"text"},{"text":"stream.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this convenience initializer when you have an asynchronous function"},{"type":"text","text":" "},{"type":"text","text":"that can produce elements for the stream, and don’t want to invoke"},{"type":"text","text":" "},{"type":"text","text":"a continuation manually. This initializer “unfolds” your closure into"},{"type":"text","text":" "},{"type":"text","text":"a full-blown asynchronous stream. The created stream handles adherence to"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" protocol automatically. To terminate the stream with"},{"type":"text","text":" "},{"type":"text","text":"an error, throw the error from your closure."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows an "},{"type":"codeVoice","code":"AsyncThrowingStream"},{"type":"text","text":" created with this"},{"type":"text","text":" "},{"type":"text","text":"initializer that produces random numbers on a one-second interval. If the"},{"type":"text","text":" "},{"type":"text","text":"random number is divisible by 5 with no remainder, the stream throws a"},{"type":"text","text":" "},{"type":"codeVoice","code":"MyRandomNumberError"},{"type":"text","text":"."}]},{"type":"codeListing","code":["let stream = AsyncThrowingStream<Int, Error> {","    await Task.sleep(1 * 1_000_000_000)","    let random = Int.random(in: 1...10)","    if random % 5 == 0 {","        throw MyRandomNumberError()","    }","    return random","}","","\/\/ Call point:","do {","    for try await random in stream {","        print(random)","    }","} catch {","    print(error)","}"],"syntax":"swift"}],"kind":"content"}],"sections":[],"metadata":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"unfolding"},{"kind":"text","text":": "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Scs7Elementxmfp","text":"Element"},{"kind":"text","text":"?)"}],"platforms":[{"name":"iOS","introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false},{"name":"iPadOS","introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false},{"name":"Mac Catalyst","introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false},{"name":"macOS","introducedAt":"10.10","deprecated":false,"unavailable":false,"beta":false},{"name":"tvOS","introducedAt":"9.0","deprecated":false,"unavailable":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false},{"name":"watchOS","introducedAt":"2.0","deprecated":false,"unavailable":false,"beta":false}],"role":"symbol","symbolKind":"init","roleHeading":"Initializer","modules":[{"name":"Swift","relatedModules":[]}],"title":"init(unfolding:)","externalID":"s:Scs9unfoldingScsyxs5Error_pGxSgyYaKc_tcsAB_pRs_rlufc"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/init(unfolding:)"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream"]]},"references":{"doc://com.apple.Swift/documentation/Swift":{"title":"Swift","type":"topic","abstract":[{"type":"text","text":"Build apps using a powerful open language."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","url":"\/documentation\/swift","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream":{"title":"AsyncThrowingStream","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AsyncThrowingStream"}],"role":"symbol","url":"\/documentation\/swift\/asyncthrowingstream","abstract":[{"text":"An asynchronous sequence generated from an error-throwing closure that","type":"text"},{"text":" ","type":"text"},{"text":"calls a continuation to produce new elements.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncThrowingStream"}]},"doc://com.apple.Swift/documentation/Swift/Error":{"type":"topic","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Error","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","role":"symbol","navigatorTitle":[{"text":"Error","kind":"identifier"}],"abstract":[{"type":"text","text":"A type representing an error value that can be thrown."}],"url":"\/documentation\/swift\/error","title":"Error"},"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream/init(unfolding:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"unfolding","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:Scs7Elementxmfp","text":"Element","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Constructs an asynchronous throwing stream from a given element-producing"},{"type":"text","text":" "},{"type":"text","text":"closure."}],"role":"symbol","url":"\/documentation\/swift\/asyncthrowingstream\/init(unfolding:)","type":"topic","title":"init(unfolding:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/init(unfolding:)"}}}