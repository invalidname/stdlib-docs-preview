{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream"]]},"abstract":[{"type":"text","text":"Constructs an asynchronous throwing stream from a given element-producing"},{"type":"text","text":" "},{"type":"text","text":"closure."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@preconcurrency"},{"kind":"text","text":" "},{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"unfolding"},{"kind":"text","text":" "},{"kind":"internalParam","text":"produce"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping"},{"kind":"text","text":" "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:Scs7Elementxmfp"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":" == any "},{"kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:s5ErrorP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error"}]}]},{"kind":"parameters","parameters":[{"name":"produce","content":[{"inlineContent":[{"type":"text","text":"A closure that asynchronously produces elements for the"},{"type":"text","text":" "},{"type":"text","text":"stream."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this convenience initializer when you have an asynchronous function"},{"type":"text","text":" "},{"type":"text","text":"that can produce elements for the stream, and don’t want to invoke"},{"type":"text","text":" "},{"type":"text","text":"a continuation manually. This initializer “unfolds” your closure into"},{"type":"text","text":" "},{"type":"text","text":"a full-blown asynchronous stream. The created stream handles adherence to"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" protocol automatically. To terminate the stream with"},{"type":"text","text":" "},{"type":"text","text":"an error, throw the error from your closure."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows an "},{"type":"codeVoice","code":"AsyncThrowingStream"},{"type":"text","text":" created with this"},{"type":"text","text":" "},{"type":"text","text":"initializer that produces random numbers on a one-second interval. If the"},{"type":"text","text":" "},{"type":"text","text":"random number is divisible by 5 with no remainder, the stream throws a"},{"type":"text","text":" "},{"type":"codeVoice","code":"MyRandomNumberError"},{"type":"text","text":"."}]},{"code":["let stream = AsyncThrowingStream<Int, Error> {","    await Task.sleep(1 * 1_000_000_000)","    let random = Int.random(in: 1...10)","    if random % 5 == 0 {","        throw MyRandomNumberError()","    }","    return random","}","","\/\/ Call point:","do {","    for try await random in stream {","        print(random)","    }","} catch {","    print(error)","}"],"syntax":"swift","type":"codeListing"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/init(unfolding:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/asyncthrowingstream\/init(unfolding:)"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"roleHeading":"Initializer","externalID":"s:Scs9unfoldingScsyxs5Error_pGxSgyYaKc_tcsAB_pRs_rlufc","symbolKind":"init","title":"init(unfolding:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"unfolding"},{"kind":"text","text":": "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Scs7Elementxmfp","text":"Element"},{"kind":"text","text":"?)"}],"role":"symbol","modules":[{"name":"Swift","relatedModules":[]}],"platforms":[{"introducedAt":"8.0","deprecated":false,"unavailable":false,"name":"iOS","beta":false},{"introducedAt":"8.0","deprecated":false,"unavailable":false,"name":"iPadOS","beta":false},{"introducedAt":"13.0","deprecated":false,"unavailable":false,"name":"Mac Catalyst","beta":false},{"introducedAt":"10.10","deprecated":false,"unavailable":false,"name":"macOS","beta":false},{"introducedAt":"9.0","deprecated":false,"unavailable":false,"name":"tvOS","beta":false},{"introducedAt":"1.0","deprecated":false,"unavailable":false,"name":"visionOS","beta":false},{"introducedAt":"2.0","deprecated":false,"unavailable":false,"name":"watchOS","beta":false}]},"references":{"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream/init(unfolding:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/init(unfolding:)","type":"topic","role":"symbol","url":"\/documentation\/swift\/asyncthrowingstream\/init(unfolding:)","kind":"symbol","title":"init(unfolding:)","abstract":[{"type":"text","text":"Constructs an asynchronous throwing stream from a given element-producing"},{"type":"text","text":" "},{"type":"text","text":"closure."}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"unfolding"},{"kind":"text","text":": "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:Scs7Elementxmfp"},{"kind":"text","text":"?)"}]},"doc://com.apple.Swift/documentation/Swift/Error":{"abstract":[{"type":"text","text":"A type representing an error value that can be thrown."}],"type":"topic","kind":"symbol","title":"Error","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Error"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","navigatorTitle":[{"kind":"identifier","text":"Error"}],"role":"symbol","url":"\/documentation\/swift\/error"},"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream":{"type":"topic","abstract":[{"type":"text","text":"An asynchronous sequence generated from an error-throwing closure that"},{"type":"text","text":" "},{"type":"text","text":"calls a continuation to produce new elements."}],"kind":"symbol","title":"AsyncThrowingStream","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncThrowingStream","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream","navigatorTitle":[{"text":"AsyncThrowingStream","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swift\/asyncthrowingstream"},"doc://com.apple.Swift/documentation/Swift":{"type":"topic","kind":"symbol","url":"\/documentation\/swift","role":"collection","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}]}}}