ragraph","inlineContent":[{"text":"The following example shows an ","type":"text"},{"code":"AsyncThrowingStream","type":"codeVoice"},{"text":" created with this","type":"text"},{"text":" ","type":"text"},{"text":"initializer that produces random numbers on a one-second interval. If the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"random number is divisible by 5 with no remainder, the stream throws a"},{"type":"text","text":" "},{"type":"codeVoice","code":"MyRandomNumberError"},{"type":"text","text":"."}]},{"type":"codeListing","code":["let stream = AsyncThrowingStream<Int, Error> {","    await Task.sleep(1 * 1_000_000_000)","    let random = Int.random(in: 1...10)","    if random % 5 == 0 {","        throw MyRandomNumberError()","    }","    return random","}","","\/\/ Call point:","do {","    for try await random in stream {","        print(random)","    }","} catch {","    print(error)","}"],"syntax":"swift"}]}],"abstract":[{"type":"text","text":"Constructs an asynchronous throwing stream from a given element-producing"},{"type":"text","text":" "},{"type":"text","text":"closure."}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncThrowingStream","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream","kind":"symbol","abstract":[{"type":"text","text":"An asynchronous sequence generated from an error-throwing closure that"},{"type":"text","text":" "},{"type":"text","text":"calls a continuation to produce new elements."}],"title":"AsyncThrowingStream","role":"symbol","navigatorTitle":[{"text":"AsyncThrowingStream","kind":"identifier"}],"url":"\/documentation\/swift\/asyncthrowingstream"},"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream/init(unfolding:)":{"abstract":[{"text":"Constructs an asynchronous throwing stream from a given element-producing","type":"text"},{"text":" ","type":"text"},{"text":"closure.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream\/init(unfolding:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"unfolding","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:Scs7Elementxmfp"},{"text":"?)","kind":"text"}],"title":"init(unfolding:)","url":"\/documentation\/swift\/asyncthrowingstream\/init(unfolding:)","kind":"symbol","role":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","url":"\/documentation\/swift","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"title":"Standard Library","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"role":"collection"},"doc://com.apple.Swift/documentation/Swift/Error":{"url":"\/documentation\/swift\/error","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Error","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","navigatorTitle":[{"text":"Error","kind":"identifier"}],"role":"symbol","title":"Error","abstract":[{"type":"text","text":"A type representing an error value that can be thrown."}],"type":"topic","kind":"symbol"}}}