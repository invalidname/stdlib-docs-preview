xt":"(","kind":"text"},{"text":"unfolding","kind":"externalParam"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"produce"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping"},{"kind":"text","text":" "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () "},{"text":"async","kind":"keyword"},{"kind":"text","text":" "},{"text":"throws","kind":"keyword"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Scs7Elementxmfp","text":"Element"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"text":"Failure","kind":"typeIdentifier"},{"text":" == any ","kind":"text"},{"text":"Error","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"produce","content":[{"inlineContent":[{"text":"A closure that asynchronously produces elements for the","type":"text"},{"type":"text","text":" "},{"text":"stream.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Use this convenience initializer when you have an asynchronous function","type":"text"},{"text":" ","type":"text"},{"text":"that can produce elements for the stream, and don’t want to invoke","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a continuation manually. This initializer “unfolds” your closure into"},{"type":"text","text":" "},{"type":"text","text":"a full-blown asynchronous stream. The created stream handles adherence to"},{"text":" ","type":"text"},{"type":"text","text":"the "},{"code":"AsyncSequence","type":"codeVoice"},{"text":" protocol automatically. To terminate the stream with","type":"text"},{"type":"text","text":" "},{"type":"text","text":"an error, throw the error from your closure."}]},{"inlineContent":[{"type":"text","text":"The following example shows an "},{"type":"codeVoice","code":"AsyncThrowingStream"},{"text":" created with this","type":"text"},{"type":"text","text":" "},{"type":"text","text":"initializer that produces random numbers on a one-second interval. If the"},{"type":"text","text":" "},{"text":"random number is divisible by 5 with no remainder, the stream throws a","type":"text"},{"text":" ","type":"text"},{"code":"MyRandomNumberError","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["let stream = AsyncThrowingStream<Int, Error> {","    await Task.sleep(1 * 1_000_000_000)","    let random = Int.random(in: 1...10)","    if random % 5 == 0 {","        throw MyRandomNumberError()","    }","    return random","}","","\/\/ Call point:","do {","    for try await random in stream {","        print(random)","    }","} catch {","    print(error)","}"],"type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncThrowingStream"]]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.apple.Swift/documentation/Swift/AsyncThrowingStream/init(unfolding:)":{"abstract":[{"type":"text","text":"Constructs an asynchronous throwing stream from a given element-producing"},{"type":"text","text":" "},{"type":"text","text":"closure."}],"kind":"symbol","url":"\/documentation\/swift\/asyncthrowingstream\/init(unfolding:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"unfolding"},{"text":": ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:Scs7Elementxmfp","text":"Element","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"identifier":"doc:\/\/com.apple.Swif