},"kind":"symbol","abstract":[{"type":"text","text":"An integer type with a binary representation."}],"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/AdditiveArithmetic","doc:\/\/com.apple.Swift\/documentation\/Swift\/Comparable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByIntegerLiteral","doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Numeric","doc:\/\/com.apple.Swift\/documentation\/Swift\/Strideable"],"kind":"relationships","type":"inheritsFrom"},{"title":"Inherited By","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/FixedWidthInteger","doc:\/\/com.apple.Swift\/documentation\/Swift\/SignedInteger","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsignedInteger"],"kind":"relationships","type":"inheritedBy"},{"title":"Conforming Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","doc:\/\/com.apple.Swift\/documentation\/Swift\/Int128","doc:\/\/com.apple.Swift\/documentation\/Swift\/Int16","doc:\/\/com.apple.Swift\/documentation\/Swift\/Int32","doc:\/\/com.apple.Swift\/documentation\/Swift\/Int64","doc:\/\/com.apple.Swift\/documentation\/Swift\/Int8","doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt","doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt128","doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt16","doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt32","doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt64","doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt8"],"kind":"relationships","type":"conformingTypes"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryInteger","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"CustomStringConvertible","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","preciseIdentifier":"s:s23CustomStringConvertibleP"},{"text":", ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Hashable","preciseIdentifier":"s:SH"},{"text":", ","kind":"text"},{"text":"Numeric","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Numeric","preciseIdentifier":"s:Sj"},{"text":", ","kind":"text"},{"text":"Strideable","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Strideable","preciseIdentifier":"s:Sx"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Magnitude","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Numeric\/Magnitude-swift.associatedtype","preciseIdentifier":"s:Sj9MagnitudeQa"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BinaryInteger","preciseIdentifier":"s:Sz"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Magnitude","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Numeric\/Magnitude-swift.associatedtype","preciseIdentifier":"s:Sj9MagnitudeQa"},{"text":" == ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Magnitude","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Numeric\/Magnitude-swift.associatedtype","preciseIdentifier":"s:Sj9MagnitudeQa"},{"text":".","kind":"text"},{"text":"Magnitude","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Numeric\/Magnitude-swift.associatedtype","preciseIdentifier":"s:Sj9MagnitudeQa"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"BinaryInteger"},{"type":"text","text":" protocol is the basis for all the integer types"},{"type":"text","text":" "},{"type":"text","text":"provided by the standard library. All of the standard library’s integer"},{"type":"text","text":" "},{"type":"text","text":"types, such as "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UInt32"},{"type":"text","text":", conform to "},{"type":"codeVoice","code":"BinaryInteger"},{"type":"text","text":"."}]},{"text":"Converting Between Numeric Types","type":"heading","anchor":"Converting-Between-Numeric-Types","level":1},{"inlineContent":[{"type":"text","text":"You can create new instances of a type that conforms to the "},{"type":"codeVoice","code":"BinaryInteger"},{"type":"text","text":" "},{"type":"text","text":"protocol from a floating-point number or another binary integer of any"},{"type":"text","text":" "},{"type":"text","text":"type. The "},{"type":"codeVoice","code":"BinaryInteger"},{"type":"text","text":" protocol provides initializers for four"},{"type":"text","text":" "},{"type":"text","text":"different kinds of conversion."}],"type":"paragraph"},{"text":"Range-Checked Conversion","type":"heading","anchor":"Range-Checked-Conversion","level":2},{"inlineContent":[{"type":"text","text":"You use the default "},{"type":"codeVoice","code":"init(_:)"},{"type":"text","text":" initializer to create a new instance when"},{"type":"text","text":" "},{"type":"text","text":"you’re sure that the value passed is representable in the new type. For"},{"type":"text","text":" "},{"type":"text","text":"example, an instance of "},{"type":"codeVoice","code":"Int16"},{"type":"text","text":" can represent the value "},{"type":"codeVoice","code":"500"},{"text":", so the","type":"text"},{"text":" ","type":"text"},{"text":"first conversion in the code sample below succeeds. That same value is too","type":"text"},{"text":" ","type":"text"},{"text":"large to represent as an ","type":"text"},{"code":"Int8","type":"codeVoice"},{"type":"text","text":" instance, so the second conversion fails,"},{"type":"text","text":" "},{"type":"text","text":"triggering a runtime error."}],"type":"paragraph"},{"code":["let x: Int = 500","let y = Int16(x)","\/\/ y == 500","","let z = Int8(x)","\/\/ Error: Not enough bits to represent..."],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"When you create a binary integer from a floating-point value using the"},{"type":"text","text":" "},{"type":"text","text":"default initializer, the value is rounded toward zero before the range is"},{"type":"text","text":" "},{"text":"checked. In the following example, the value ","type":"text"},{"code":"127.75","type":"codeVoice"},{"text":" is rounded to ","type":"text"},{"code":"127","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which is representable by the "},{"type":"codeVoice","code":"Int8"},{"type":"text","text":" type.  "},{"type":"codeVoice","code":"128.25"},{"type":"text","text":" is rounded to "},{"type":"codeVoice","code":"128"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which is not representable as an "},{"type":"codeVoice","code":"Int8"},{"type":"text","text":" instance, triggering a runtime"},{"type":"text","text":" "},{"type":"text","text":"error."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let e = Int8(127.75)","\/\/ e == 127","","let f = Int8(128.25)","\/\/ Error: Double value cannot be converted..."]},{"type":"heading","text":"Exact Conversion","anchor":"Exact-Conversion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"init?(exactly:)"},{"type":"text","text":" initializer to create a new instance after"},{"type":"text","text":" "},{"type":"text","text":"checking whether the passed value is representable. Instead of trapping on"},{"type":"text","text":" "},{"type":"text","text":"out-of-range values, using the failable "},{"type":"codeVoice","code":"init?(exactly:)"},{"type":"text","text":" "},{"type":"text","text":"initializer results in "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let x = Int16(exactly: 500)","\/\/ x == Optional(500)","","let y = Int8(exactly: 500)","\/\/ y == nil"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When converting floating-point values, the "},{"type":"codeVoice","code":"init?(exactly:)"},{"type":"text","text":" initializer"},{"type":"text","text":" "},{"type":"text","text":"checks both that the passed value has no fractional part and that the"},{"type":"text","text":" "},{"type":"text","text":"value is representable in the resulting type."}]},{"type":"codeListing","syntax":"swift","code":["let e = Int8(exactly: 23.0)       \/\/ integral value, representable","\/\/ e == Optional(23)","","let f = Int8(exactly: 23.75)      \/\/ fractional value, representable","\/\/ f == nil","","let g = Int8(exactly: 500.0)      \/\/ integral value, nonrepresentable","\/\/ g == nil"]},{"type":"heading","text":"Clamping Conversion","anchor":"Clamping-Conversion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"init(clamping:)"},{"type":"text","text":" initializer to create a new instance of a binary"},{"type":"text","text":" "},{"type":"text","text":"integer type where out-of-range values are clamped to the representable"},{"type":"text","text":" "},{"type":"text","text":"range of the type. For a type "},{"type":"codeVoice","code":"T"},{"type":"text","text":", the resulting value is in the range"},{"type":"text","text":" "},{"type":"codeVoice","code":"T.min...T.max"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let x = Int16(clamping: 500)","\/\/ x == 500","","let y = Int8(clamping: 500)","\/\/ y == 127","","let z = UInt8(clamping: -500)","\/\/ z == 0"]},{"anchor":"Bit-Pattern-Conversion","level":2,"type":"heading","text":"Bit Pattern Conversion"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"init(truncatingIfNeeded:)"},{"type":"text","text":" initializer to create a new instance"},{"type":"text","text":" "},{"type":"text","text":"with the same bit pattern as the passed value, extending or truncating the"},{"type":"text","text":" "},{"type":"text","text":"value’s representation as necessary. Note that the value may not be"},{"type":"text","text":" "},{"type":"text","text":"preserved, particularly when converting between signed to unsigned integer"},{"type":"text","text":" "},{"type":"text","text":"types or when the destination type has a smaller bit width than the source"},{"type":"text","text":" "},{"type":"text","text":"type. The following example shows how extending and truncating work for"},{"type":"text","text":" "},{"type":"text","text":"nonnegative integers:"}],"type":"paragraph"},{"code":["let q: Int16 = 850","\/\/ q == 0b00000011_01010010","","let r = Int8(truncatingIfNeeded: q)      \/\/ truncate 'q' to fit in 8 bits","\/\/ r == 82","\/\/   == 0b01010010","","let s = Int16(truncatingIfNeeded: r)     \/\/ extend 'r' to fill 16 bits","\/\/ s == 82","\/\/   == 0b00000000_01010010"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Any padding is performed by ","type":"text"},{"inlineContent":[{"type":"text","text":"sign-extending"}],"type":"emphasis"},{"text":" the passed value. When","type":"text"},{"text":" ","type":"text"},{"text":"nonnegative integers are extended, the result is padded with zeroes. When","type":"text"},{"text":" ","type":"text"},{"text":"negative integers are extended, the result is padded with ones. This","type":"text"},{"text":" ","type":"text"},{"text":"example shows several extending conversions of a negative value—note","type":"text"},{"text":" ","type":"text"},{"text":"that negative values are sign-extended even when converting to an unsigned","type":"text"},{"text":" ","type":"text"},{"text":"type.","type":"text"}],"type":"paragraph"},{"code":["let t: Int8 = -100","\/\/ t == -100","\/\/ t's binary representation == 0b10011100","","let u = UInt8(truncatingIfNeeded: t)","\/\/ u == 156","\/\/ u's binary representation == 0b10011100","","let v = Int16(truncatingIfNeeded: t)","\/\/ v == -100","\/\/ v's binary representation == 0b11111111_10011100","","let w = UInt16(truncatingIfNeeded: t)","\/\/ w == 65436","\/\/ w's binary representation == 0b11111111_10011100"],"type":"codeListing","syntax":"swift"},{"text":"Comparing Across Integer Types","type":"heading","anchor":"Comparing-Across-Integer-Types","level":1},{"inlineContent":[{"text":"You can use relational operators, such as the less-than and equal-to","type":"text"},{"text":" ","type":"text"},{"text":"operators (","type":"text"},{"code":"<","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"==","type":"codeVoice"},{"text":"), to compare instances of different binary integer","type":"text"},{"text":" ","type":"text"},{"text":"types. The following example compares instances of the ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"UInt","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"UInt8","type":"codeVoice"},{"text":" types:","type":"text"}],"type":"paragraph"},{"code":["let x: Int = -23","let y: UInt = 1_000","let z: UInt8 = 23","","if x < y {","    print(\"\\(x) is less than \\(y).\")","}","\/\/ Prints \"-23 is less than 1000.\"","","if z > x {","    print(\"\\(z) is greater than \\(x).\")","}","\/\/ Prints \"23 is greater than -23.\""],"type":"codeListing","syntax":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Int128