xt","text":") combines two Boolean values and returns"},{"type":"text","text":" "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if both of the values are "},{"type":"codeVoice","code":"true"},{"type":"text","text":". If either of the values is"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":", the operator returns "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This operator uses short-circuit evaluation: The left-hand side ("},{"type":"codeVoice","code":"lhs"},{"type":"text","text":") is"},{"type":"text","text":" "},{"type":"text","text":"evaluated first, and the right-hand side ("},{"type":"codeVoice","code":"rhs"},{"type":"text","text":") is evaluated only if"},{"type":"text","text":" "},{"type":"codeVoice","code":"lhs"},{"type":"text","text":" evaluates to "},{"type":"codeVoice","code":"true"},{"type":"text","text":". For example:"}]},{"syntax":"swift","type":"codeListing","code":["let measurements = [7.44, 6.51, 4.74, 5.88, 6.27, 6.12, 7.76]","let sum = measurements.reduce(0, +)","","if measurements.count > 0 && sum \/ Double(measurements.count) < 6.5 {","    print(\"Average measurement is less than 6.5\")","}","\/\/ Prints \"Average measurement is less than 6.5\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this example, "},{"type":"codeVoice","code":"lhs"},{"type":"text","text":" tests whether "},{"type":"codeVoice","code":"measurements.count"},{"type":"text","text":" is greater than"},{"type":"text","text":" "},{"type":"text","text":"zero. Evaluation of the "},{"type":"codeVoice","code":"&&"},{"type":"text","text":" operator is one of the following:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"measurements.count"},{"type":"text","text":" is equal to zero, "},{"type":"codeVoice","code":"lhs"},{"type":"text","t