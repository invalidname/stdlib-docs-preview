"},{"kind":"identifier","text":"&&"},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"internalParam","text":"lhs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"internalParam","text":"rhs"},{"kind":"text","text":": "},{"kind":"attribute","text":"@autoclosure"},{"kind":"text","text":" () "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","text":"Bool"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","text":"Bool"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"name":"lhs","content":[{"inlineContent":[{"text":"The left-hand side of the operation.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The right-hand side of the operation.","type":"text"}],"type":"paragraph"}],"name":"rhs"}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The logical AND operator (","type":"text"},{"code":"&&","type":"codeVoice"},{"text":") combines two Boolean values and returns","type":"text"},{"type":"text","text":" "},{"code":"true","type":"codeVoice"},{"type":"text","text":" if both of the values are "},{"code":"true","type":"codeVoice"},{"type":"text","text":". If either of the values is"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":", the operator returns "},{"code":"false","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"This operator uses short-circuit evaluation: The left-hand side (","type":"text"},{"code":"lhs","type":"codeVoice"},{"type":"text","text":") is"},{"type":"text","text":" "},{"text":"evaluated first, and the right-hand side (","type":"text"},{"code":"rhs","type":"codeVoice"},{"type":"text","text":") is evaluated only if"},{"type":"text","text":" "},{"code":"lhs","type":"codeVoice"},{"type":"text","text":" evaluates to "},{"code":"true","type":"codeVoice"},{"type":"text","text":". For example:"}]},{"code":["let measurements = [7.44, 6.51, 4.74, 5.88, 6.27, 6.12, 7.76]","let sum = measurements.reduce(0, +)","","if measurements.count > 0 && sum \/ Double(measurements.count) < 6.5 {","    print(\"Average measurement is less than 6.5\")","}","\/\/ Prints \"Average measurement is less than 6.5\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this example, "},{"code":"lhs","type":"codeVoice"},{"type":"text","text":" tests whether "},{"code":"measurements.count","type":"codeVoice"},{"type":"text","text":" is greater than"},{"type":"text","text":" "},{"type":"text","text":"zero. Evaluation of the "},{"code":"&&","type":"codeVoice"},{"text":" operator is one of the following:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"measurements.count","type":"codeVoice"},{"text":" is equal to zero, ","type":"text"},{"code":"lhs","type":"codeVoice"},{"type":"text","text":" evaluates to "},{"code":"false","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"rhs","type":"codeVoice"},{"text":" is not evaluated, preventing a divide-by-zero error in the","type":"text"},{"text":" ","type":"text"},{"text":"expression ","type":"text"},{"code":"sum \/ Double(measurements.count)","type":"codeVoice"},{"type":"text","text":". The result of the"},{"type":"text","text":" "},{"type":"text","text":"operation is "},{"code":"false","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"measurements.count","type":"codeVoice"},{"type":"text","text":" is greater than zero, "},{"code":"lhs","type":"codeVoice"},{"type":"text","text":" evaluates to"},{"type":"text","text":" "},{"code":"true","type":"codeVoice"},{"type":"text","text":" and "},{"code":"rhs","type":"codeVoice"},{"type":"text","text":" is evaluated. The result of evaluating "},{"code":"rhs","type":"codeVoice"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"result of the "},{"code":"&&","type":"codeVoice"},{"type":"text","text":" operation."}]}]}],"type":"unorderedList"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool"]]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool\/&&(_:_:)","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Transforming a Boolean","anchor":"Transforming-a-Boolean","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool\/toggle()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool\/!(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool\/__(_:_:)"]}],"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/Bool/__(_:_:)":{"type":"topic","title":"||(_:_:)","kind":"symbol","url":"\/documentation\/swift\/bool\/__(_:_:)","abstract":[{"text":"Performs a logical OR operation on two Boolean values.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"||"},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"attribute","text":"@autoclosure"},{"kind":"text","text":" () "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Bool","