pe":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This operator uses short-circuit evaluation: The left-hand side (","type":"text"},{"code":"lhs","type":"codeVoice"},{"text":") is","type":"text"},{"text":" ","type":"text"},{"text":"evaluated first, and the right-hand side (","type":"text"},{"code":"rhs","type":"codeVoice"},{"text":") is evaluated only if","type":"text"},{"text":" ","type":"text"},{"code":"lhs","type":"codeVoice"},{"text":" evaluates to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":". For example:","type":"text"}]},{"code":["let measurements = [7.44, 6.51, 4.74, 5.88, 6.27, 6.12, 7.76]","let sum = measurements.reduce(0, +)","","if measurements.count > 0 && sum \/ Double(measurements.count) < 6.5 {","    print(\"Average measurement is less than 6.5\")","}","\/\/ Prints \"Average measurement is less than 6.5\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"In this example, ","type":"text"},{"code":"lhs","type":"codeVoice"},{"text":" tests whether ","type":"text"},{"code":"measurements.count","type":"codeVoice"},{"text":" is greater than","type":"text"},{"text":" ","type":"text"},{"text":"zero. Evaluation of the ","type":"text"},{"code":"&&","type":"codeVoice"},{"text":" operator is one of the following:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"measurements.count"},{"text":" is equal to zero, ","type":"text"},{"type":"codeVoice","code":"lhs"},{"text":" evaluates to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"rhs"},{"text":" is not evaluated, preventing a divide-by-zero error in the","type":"text"},{"text":" ","type":"text"},{"text":"expression ","type":"text"},{"type":"codeVoice","code":"sum \/ Double(measurements.count)"},{"text":". The result of the","type":"text"},{"text":" ","type":"text"},{"text":"operation is ","type":"text"},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"measurements.count"},{"text":" is greater than zero, ","type":"text"},{"type":"codeVoice","code":"lhs"},{"text":" evaluates to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"rhs"},{"text":" is evaluated. The result of evaluating ","type":"text"},{"type":"codeVoice","code":"rhs"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"result of the ","type":"text"},{"type":"codeVoice","code":"&&"},{"text":" operation.","type":"text"}],"type":"paragraph"}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/bool\/&&(_:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"abstract":[{"text":"Performs a logical AND operation on two Boolean values.","type":"text"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool\/&&(_:_:)","interfaceLanguage":"swift"},"metadata":{"title":"&&(_:_:)","roleHeading":"Operator","extendedModule":"Swift","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"&&","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"@autoclosure","kind":"attribute"},{"text":" () ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"type