tor returns ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This operator uses short-circuit evaluation: The left-hand side (","type":"text"},{"code":"lhs","type":"codeVoice"},{"text":") is","type":"text"},{"text":" ","type":"text"},{"text":"evaluated first, and the right-hand side (","type":"text"},{"code":"rhs","type":"codeVoice"},{"text":") is evaluated only if","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"lhs"},{"text":" evaluates to ","type":"text"},{"type":"codeVoice","code":"true"},{"text":". For example:","type":"text"}]},{"code":["let measurements = [7.44, 6.51, 4.74, 5.88, 6.27, 6.12, 7.76]","let sum = measurements.reduce(0, +)","","if measurements.count > 0 && sum \/ Double(measurements.count) < 6.5 {","    print(\"Average measurement is less than 6.5\")","}","\/\/ Prints \"Average measurement is less than 6.5\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"In this example, "},{"type":"codeVoice","code":"lhs"},{"type":"text","text":" tests whether "},{"type":"codeVoice","code":"measurements.count"},{"type":"text","text":" is greater than"},{"type":"text","text":" "},{"type":"text","text":"zero. Evaluation of the "},{"type":"codeVoice","code":"&&"},{"type":"text","text":" operator is one of the following:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"measurements.count","type":"codeVoice"},{"type":"text","text":" is equal to zero, "},{"code":"lhs","type":"codeVoice"},{"type":"text","text":" evaluates to "},{"code":"false","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"rhs","type":"codeVoice"},{"type":"text","text":" is not evaluated, preventing a divide-by-zero error in the"},{"type":"text","text":" "},{"type":"text","text":"expression "},{"code":"sum \/ Double(measurements.count)","type":"codeVoice"},{"type":"text","text":". The result of the"},{"type":"text","text":" "},{"type":"text","text":"operation is "},{"code":"false","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"measurements.count"},{"type":"text","text":" is greater than zero, "},{"type":"codeVoice","code":"lhs"},{"type":"text","text":" evaluates to"},{"type":"text","text":" "},{"type":"codeVoice","code":"true"},{"type":"text","text":" and "},{"type":"codeVoice","code":"rhs"},{"type":"text","text":" is evaluated. The result of evaluating "},{"type":"codeVoice","code":"rhs"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"result of the "},{"type":"codeVoice","code":"&&"},{"type":"text","text":" operation."}],"type":"paragraph"}]}]}]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool\/&&(_:_:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Performs a logical AND operation on two Boolean values."}],"variants":[{"paths":["\/documentation\/swift\/bool\/&&(_:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"anchor":"Transforming-a-Boolean","title":"Transforming a Boolean","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool\/toggle()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool\/!(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool\/__(_:_:)"],"generated":true}],"metadata":{"symbolKind":"op","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"&&","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"attribute","text":"@autoclosure"},{"kind":"text","text":" () "},{"kind":"keyword","text":"throws"},