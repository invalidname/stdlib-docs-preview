ype":"text","text":") combines two Boolean values and returns"},{"type":"text","text":" "},{"code":"true","type":"codeVoice"},{"type":"text","text":" if both of the values are "},{"code":"true","type":"codeVoice"},{"type":"text","text":". If either of the values is"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"text":", the operator returns ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This operator uses short-circuit evaluation: The left-hand side (","type":"text"},{"code":"lhs","type":"codeVoice"},{"text":") is","type":"text"},{"text":" ","type":"text"},{"text":"evaluated first, and the right-hand side (","type":"text"},{"code":"rhs","type":"codeVoice"},{"text":") is evaluated only if","type":"text"},{"text":" ","type":"text"},{"code":"lhs","type":"codeVoice"},{"text":" evaluates to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":". For example:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let measurements = [7.44, 6.51, 4.74, 5.88, 6.27, 6.12, 7.76]","let sum = measurements.reduce(0, +)","","if measurements.count > 0 && sum \/ Double(measurements.count) < 6.5 {","    print(\"Average measurement is less than 6.5\")","}","\/\/ Prints \"Average measurement is less than 6.5\""],"type":"codeListing"},{"inlineContent":[{"text":"In this example, ","type":"text"},{"code":"lhs","type":"codeVoice"},{"type":"text","text":" tests whether "},{"code":"measurements.count","type":"codeVoice"},{"type":"text","text":" is greater than"},{"type":"text","text":" "},{"type":"text","text":"zero. Evaluation of the "},{"type":"codeVoice","code":"&&"},{"type":"text","text":" operator is one of the following:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"measurements.count"},{"type":"text","text":" is equal to zero, "},{"type":"codeVoice","code":"lhs"},{"type":"text","text":" evaluates to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"rhs"},{"type":"text","text":" is not evaluated, preventing a divide-by-zero error in the"},{"type":"text","text":" "},{"text":"expression ","type":"text"},{"code":"sum \/ Double(measurements.count)","type":"codeVoice"},{"text":". The result of the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"operation is "},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"measurements.count"},{"type":"text","text":" is greater than zero, "},{"type":"codeVoice","code":"lhs"},{"type":"text","text":" evaluates to"},{"text":" ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"rhs","type":"codeVoice"},{"text":" is evaluated. The result of evaluating ","type":"text"},{"code":"rhs","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"result of the ","type":"text"},{"code":"&&","type":"codeVoice"},{"text":" operation.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Bool/toggle()":{"title":"toggle()","type":"topic","abstract":[{"text":"Toggles the Boolean variable’s value.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool\/toggle()","url":"\/documentation\/swift\/bool\/toggle()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"toggle","kind":"identifier"},{"text":"()","kind":"text"}]},"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."