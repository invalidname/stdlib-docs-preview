{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Instance Method","modules":[{"name":"Swift"}],"platforms":[{"name":"iOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"8.0"},{"name":"iPadOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"8.0"},{"deprecated":false,"introducedAt":"13.0","unavailable":false,"beta":false,"name":"Mac Catalyst"},{"beta":false,"introducedAt":"10.10","deprecated":false,"unavailable":false,"name":"macOS"},{"unavailable":false,"beta":false,"name":"tvOS","introducedAt":"9.0","deprecated":false},{"introducedAt":"1.0","name":"visionOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"2.0","name":"watchOS","beta":false,"deprecated":false,"unavailable":false}],"required":true,"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nextSpan","kind":"identifier"},{"kind":"text","text":"("},{"text":"maxCount","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") "},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Failure","kind":"typeIdentifier","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7FailureQa"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4SpanV","text":"Span","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s25BorrowingIteratorProtocolP7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":">","kind":"text"}],"symbolKind":"method","title":"nextSpan(maxCount:)","externalID":"s:s25BorrowingIteratorProtocolP8nextSpan8maxCounts0E0Vy7ElementQzGSi_t7FailureQzYKF"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol"]]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/nextSpan(maxCount:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Returns a span over the next group of elements that are ready to by visited,"},{"type":"text","text":" "},{"text":"up to the specifed maximum.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"text","text":"@_lifetime(&self) @_lifetime(self: copy self) "},{"kind":"keyword","text":"mutating"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"nextSpan"},{"text":"(","kind":"text"},{"text":"maxCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Failure","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7FailureQa","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/Failure"},{"text":") -> ","kind":"text"},{"text":"Span","preciseIdentifier":"s:s4SpanV","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Span","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Element","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7ElementQa","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/Element"},{"text":">","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"If the underlying type stores its elements in one or more blocks of","type":"text"},{"text":" ","type":"text"},{"text":"contiguous memory, then the returned span typically directly","type":"text"},{"text":" ","type":"text"},{"text":"addresses one of those buffers. On the other hand, if the underlying type","type":"text"},{"text":" ","type":"text"},{"text":"materializes its elements on demand, then the returned span addresses","type":"text"},{"text":" ","type":"text"},{"text":"a temporary buffer managed by the iterator itself. Consequently, the returned","type":"text"},{"text":" ","type":"text"},{"text":"span is tied to this particular invocation of ","type":"text"},{"code":"nextSpan","type":"codeVoice"},{"text":", and it cannot","type":"text"},{"text":" ","type":"text"},{"text":"survive beyond the next invocation of this method.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the iterator has not yet reached the end of the underlying elements,","type":"text"},{"text":" ","type":"text"},{"text":"then this method returns a non-empty span of at most ","type":"text"},{"code":"maxCount","type":"codeVoice"},{"text":" ","type":"text"},{"text":"elements and updates the iterator’s current position to the element","type":"text"},{"text":" ","type":"text"},{"text":"following the last item in the returned span. The ","type":"text"},{"code":"maxCount","type":"codeVoice"},{"text":" ","type":"text"},{"text":"argument allows callers to avoid getting more items than they are","type":"text"},{"text":" ","type":"text"},{"text":"able to process in one go, simplifying usage, and","type":"text"},{"text":" ","type":"text"},{"text":"avoiding materializing more elements than needed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the iterator’s current position is at the end of the container, then","type":"text"},{"text":" ","type":"text"},{"text":"this method returns an empty span without updating the position.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This method can be used to efficiently process the items of a container","type":"text"},{"text":" ","type":"text"},{"text":"in bulk, by directly iterating over its piecewise contiguous pieces of","type":"text"},{"text":" ","type":"text"},{"text":"storage:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var it = items.makeBorrowingIterator()","while true {","  let span = it.nextSpan(maxCount: .max)","  if span.isEmpty { break }","  \/\/ Process items in `span`","}"],"type":"codeListing"},{"inlineContent":[{"text":"The spans returned by this method are not guaranteed to be disjunct.","type":"text"},{"text":" ","type":"text"},{"text":"Iterators that materialize elements on demand typically reuse the same","type":"text"},{"text":" ","type":"text"},{"text":"buffer over and over again; and even some proper containers may link to a","type":"text"},{"text":" ","type":"text"},{"text":"single storage chunk (or parts of a storage chunk) multiple times, for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"example to repeat their contents."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/borrowingiteratorprotocol\/nextspan(maxcount:)"]}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/BorrowingIteratorProtocol/Failure":{"title":"Failure","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/Failure","url":"\/documentation\/swift\/borrowingiteratorprotocol\/failure","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Failure"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:s5ErrorP"},{"text":" = ","kind":"text"},{"preciseIdentifier":"s:s5NeverO","text":"Never","kind":"typeIdentifier"}],"type":"topic","kind":"symbol","abstract":[],"required":true},"doc://com.apple.Swift/documentation/Swift/BorrowingIteratorProtocol":{"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"BorrowingIteratorProtocol","kind":"identifier"}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BorrowingIteratorProtocol","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Borr