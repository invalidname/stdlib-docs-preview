{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol"]]},"metadata":{"role":"symbol","roleHeading":"Instance Method","modules":[{"name":"Standard Library"}],"title":"nextSpan(maxCount:)","externalID":"s:s25BorrowingIteratorProtocolP8nextSpan8maxCounts0E0Vy7ElementQzGSi_t7FailureQzYKF","platforms":[{"introducedAt":"8.0","unavailable":false,"beta":false,"deprecated":false,"name":"iOS"},{"deprecated":false,"name":"iPadOS","unavailable":false,"beta":false,"introducedAt":"8.0"},{"deprecated":false,"name":"Mac Catalyst","unavailable":false,"beta":false,"introducedAt":"13.0"},{"introducedAt":"10.10","unavailable":false,"beta":false,"deprecated":false,"name":"macOS"},{"name":"tvOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"9.0"},{"name":"visionOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"1.0"},{"introducedAt":"2.0","unavailable":false,"beta":false,"deprecated":false,"name":"watchOS"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nextSpan","kind":"identifier"},{"kind":"text","text":"("},{"text":"maxCount","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:s25BorrowingIteratorProtocolP7FailureQa","text":"Failure","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4SpanV","kind":"typeIdentifier","text":"Span"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:s25BorrowingIteratorProtocolP7ElementQa","text":"Element","kind":"typeIdentifier"},{"kind":"text","text":">"}],"required":true,"symbolKind":"method"},"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/nextSpan(maxCount:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@_lifetime(&self) @_lifetime(self: copy self) ","kind":"text"},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"nextSpan"},{"kind":"text","text":"("},{"text":"maxCount","kind":"externalParam"},{"kind":"text","text":": "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/Failure","text":"Failure","kind":"typeIdentifier","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7FailureQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Span","identifier":"doc:\/\/com.apple.Swift\/documentation\/CompatibilitySpan\/Span","preciseIdentifier":"s:s4SpanV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Element","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/Element","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7ElementQa"},{"text":">","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the underlying type stores its elements in one or more blocks of"},{"type":"text","text":" "},{"type":"text","text":"contiguous memory, then the returned span typically directly"},{"type":"text","text":" "},{"type":"text","text":"addresses one of those buffers. On the other hand, if the underlying type"},{"type":"text","text":" "},{"type":"text","text":"materializes its elements on demand, then the returned span addresses"},{"type":"text","text":" "},{"type":"text","text":"a temporary buffer managed by the iterator itself. Consequently, the returned"},{"type":"text","text":" "},{"type":"text","text":"span is tied to this particular invocation of "},{"type":"codeVoice","code":"nextSpan"},{"type":"text","text":", and it cannot"},{"text":" ","type":"text"},{"type":"text","text":"survive beyond the next invocation of this method."}]},{"type":"paragraph","inlineContent":[{"text":"If the iterator has not yet reached the end of the underlying elements,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"then this method returns a non-empty span of at most "},{"type":"codeVoice","code":"maxCount"},{"type":"text","text":" "},{"type":"text","text":"elements and updates the iterator’s current position to the element"},{"type":"text","text":" "},{"type":"text","text":"following the last item in the returned span. The "},{"type":"codeVoice","code":"maxCount"},{"type":"text","text":" "},{"type":"text","text":"argument allows callers to avoid getting more items than they are"},{"type":"text","text":" "},{"type":"text","text":"able to process in one go, simplifying usage, and"},{"type":"text","text":" "},{"type":"text","text":"avoiding materializing more elements than needed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the iterator’s current position is at the end of the container, then"},{"type":"text","text":" "},{"type":"text","text":"this method returns an empty span without updating the position."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method can be used to efficiently process the items of a container"},{"type":"text","text":" "},{"type":"text","text":"in bulk, by directly iterating over its piecewise contiguous pieces of"},{"type":"text","text":" "},{"type":"text","text":"storage:"}]},{"type":"codeListing","syntax":"swift","code":["var it = items.makeBorrowingIterator()","while true {","  let span = it.nextSpan(maxCount: .max)","  if span.isEmpty { break }","  \/\/ Process items in `span`","}"]},{"inlineContent":[{"type":"text","text":"The spans returned by this method are not guaranteed to be disjunct."},{"type":"text","text":" "},{"type":"text","text":"Iterators that materialize elements on demand typically reuse the same"},{"type":"text","text":" "},{"type":"text","text":"buffer over and over again; and even some proper containers may link to a"},{"type":"text","text":" "},{"type":"text","text":"single storage chunk (or parts of a storage chunk) multiple times, for"},{"type":"text","text":" "},{"type":"text","text":"example to repeat their contents."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Returns a span over the next group of elements that are ready to by visited,"},{"type":"text","text":" "},{"type":"text","text":"up to the specifed maximum."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/borrowingiteratorprotocol\/nextspan(maxcount:)"]}],"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/BorrowingIteratorProtocol":{"role":"symbol","type":"topic","title":"BorrowingIteratorProtocol","url":"\/documentation\/swift\/borrowingiteratorprotocol","kind":"symbol","navigatorTitle":[{"text":"BorrowingIteratorProtocol","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BorrowingIteratorProtocol","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that provides borrowed access to the values of a borrowing sequence."}]},"doc://com.apple.Swift/documentation/Swift/Int":{"type":"topic","abstract":[{"text":"A signed integer value type.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","role":"symbol","title":"Int","navigatorTitle":[{"text":"Int","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/swift\/int","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"tex