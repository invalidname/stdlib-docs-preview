{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/nextSpan(maxCount:)","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"text":"Returns a span over the next group of elements that are ready to by visited,","type":"text"},{"text":" ","type":"text"},{"text":"up to the specifed maximum.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@_lifetime(&self) @_lifetime(self: copy self) ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nextSpan","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maxCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","preciseIdentifier":"s:Si"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Failure","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/Failure","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7FailureQa"},{"text":") -> ","kind":"text"},{"text":"Span","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Span","preciseIdentifier":"s:s4SpanV"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/Element","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7ElementQa"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"If the underlying type stores its elements in one or more blocks of","type":"text"},{"text":" ","type":"text"},{"text":"contiguous memory, then the returned span typically directly","type":"text"},{"text":" ","type":"text"},{"text":"addresses one of those buffers. On the other hand, if the underlying type","type":"text"},{"text":" ","type":"text"},{"text":"materializes its elements on demand, then the returned span addresses","type":"text"},{"text":" ","type":"text"},{"text":"a temporary buffer managed by the iterator itself. Consequently, the returned","type":"text"},{"text":" ","type":"text"},{"text":"span is tied to this particular invocation of ","type":"text"},{"type":"codeVoice","code":"nextSpan"},{"text":", and it cannot","type":"text"},{"text":" ","type":"text"},{"text":"survive beyond the next invocation of this method.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the iterator has not yet reached the end of the underlying elements,","type":"text"},{"text":" ","type":"text"},{"text":"then this method returns a non-empty span of at most ","type":"text"},{"code":"maxCount","type":"codeVoice"},{"text":" ","type":"text"},{"text":"elements and updates the iterator’s current position to the element","type":"text"},{"type":"text","text":" "},{"text":"following the last item in the returned span. The ","type":"text"},{"code":"maxCount","type":"codeVoice"},{"text":" ","type":"text"},{"text":"argument allows callers to avoid getting more items than they are","type":"text"},{"text":" ","type":"text"},{"text":"able to process in one go, simplifying usage, and","type":"text"},{"text":" ","type":"text"},{"text":"avoiding materializing more elements than needed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the iterator’s current position is at the end of the container, then","type":"text"},{"text":" ","type":"text"},{"text":"this method returns an empty span without updating the position.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This method can be used to efficiently process the items of a container","type":"text"},{"text":" ","type":"text"},{"text":"in bulk, by directly iterating over its piecewise contiguous pieces of","type":"text"},{"text":" ","type":"text"},{"text":"storage:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var it = items.makeBorrowingIterator()","while true {","  let span = it.nextSpan(maxCount: .max)","  if span.isEmpty { break }","  \/\/ Process items in `span`","}"]},{"inlineContent":[{"text":"The spans returned by this method are not guaranteed to be disjunct.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Iterators that materialize elements on demand typically reuse the same"},{"type":"text","text":" "},{"text":"buffer over and over again; and even some proper containers may link to a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"single storage chunk (or parts of a storage chunk) multiple times, for"},{"type":"text","text":" "},{"text":"example to repeat their contents.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol"]]},"variants":[{"paths":["\/documentation\/swift\/borrowingiteratorprotocol\/nextspan(maxcount:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Method","platforms":[{"name":"iOS","beta":false,"introducedAt":"8.0","deprecated":false,"unavailable":false},{"name":"iPadOS","beta":false,"introducedAt":"8.0","deprecated":false,"unavailable":false},{"name":"Mac Catalyst","beta":false,"introducedAt":"13.0","deprecated":false,"unavailable":false},{"name":"macOS","beta":false,"introducedAt":"10.10","deprecated":false,"unavailable":false},{"name":"tvOS","beta":false,"introducedAt":"9.0","deprecated":false,"unavailable":false},{"name":"visionOS","beta":false,"introducedAt":"1.0","deprecated":false,"unavailable":false},{"name":"watchOS","beta":false,"introducedAt":"2.0","deprecated":false,"unavailable":false}],"externalID":"s:s25Borrowing