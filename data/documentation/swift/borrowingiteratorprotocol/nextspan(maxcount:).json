xt","text":" "},{"type":"text","text":"up to the specifed maximum."}],"title":"nextSpan(maxCount:)","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"nextSpan"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7FailureQa","text":"Failure"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Span","preciseIdentifier":"s:s4SpanV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7ElementQa","text":"Element"},{"kind":"text","text":">"}],"role":"symbol","type":"topic","kind":"symbol"},"doc://com.apple.Swift/documentation/CompatibilitySpan/Span":{"abstract":[{"code":"Span<Element>","type":"codeVoice"},{"text":" represents a contiguous region of memory","type":"text"},{"text":" ","type":"text"},{"text":"which contains initialized instances of ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Span","kind":"identifier"}],"url":"\/documentation\/compatibilityspan\/span","identifier":"doc:\/\/com.apple.Swift\/documentation\/CompatibilitySpan\/Span","title":"Span","kind":"symbol","navigatorTitle":[{"text":"Span","kind":"identifier"}],"type":"topic"}}}