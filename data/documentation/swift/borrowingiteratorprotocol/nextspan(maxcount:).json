{"abstract":[{"type":"text","text":"Returns a span over the next group of elements that are ready to by visited,"},{"text":" ","type":"text"},{"type":"text","text":"up to the specifed maximum."}],"metadata":{"modules":[{"name":"Standard Library"}],"externalID":"s:s25BorrowingIteratorProtocolP8nextSpan8maxCounts0E0Vy7ElementQzGSi_t7FailureQzYKF","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nextSpan","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"maxCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:s25BorrowingIteratorProtocolP7FailureQa","text":"Failure","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"kind":"typeIdentifier","text":"Span","preciseIdentifier":"s:s4SpanV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7ElementQa","text":"Element"},{"kind":"text","text":">"}],"title":"nextSpan(maxCount:)","symbolKind":"method","required":true,"role":"symbol","platforms":[{"introducedAt":"8.0","unavailable":false,"beta":false,"deprecated":false,"name":"iOS"},{"introducedAt":"8.0","unavailable":false,"beta":false,"deprecated":false,"name":"iPadOS"},{"introducedAt":"13.0","unavailable":false,"beta":false,"deprecated":false,"name":"Mac Catalyst"},{"introducedAt":"10.10","unavailable":false,"beta":false,"deprecated":false,"name":"macOS"},{"introducedAt":"9.0","unavailable":false,"beta":false,"deprecated":false,"name":"tvOS"},{"introducedAt":"1.0","unavailable":false,"beta":false,"deprecated":false,"name":"visionOS"},{"introducedAt":"2.0","unavailable":false,"beta":false,"deprecated":false,"name":"watchOS"}]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/nextSpan(maxCount:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/borrowingiteratorprotocol\/nextspan(maxcount:)"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@_lifetime(&self) @_lifetime(self: copy self) ","kind":"text"},{"kind":"keyword","text":"mutating"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nextSpan","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maxCount","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","text":"Int","preciseIdentifier":"s:Si"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/Failure","text":"Failure","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7FailureQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/CompatibilitySpan\/Span","text":"Span","preciseIdentifier":"s:s4SpanV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Element","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/Element","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7ElementQa"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"If the underlying type stores its elements in one or more blocks of"},{"type":"text","text":" "},{"type":"text","text":"contiguous memory, then the returned span typically directly"},{"type":"text","text":" "},{"type":"text","text":"addresses one of those buffers. On the other hand, if the underlying type"},{"text":" ","type":"text"},{"text":"materializes its elements on demand, then the returned span addresses","type":"text"},{"text":" ","type":"text"},{"text":"a temporary buffer managed by the iterator itself. Consequently, the returned","type":"text"},{"type":"text","text":" "},{"type":"text","text":"span is tied to this particular invocation of "},{"code":"nextSpan","type":"codeVoice"},{"text":", and it cannot","type":"text"},{"type":"text","text":" "},{"text":"survive beyond the next invocation of this method.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the iterator has not yet reached the end of the underlying elements,","type":"text"},{"text":" ","type":"text"},{"text":"then this method returns a non-empty span of at most ","type":"text"},{"code":"maxCount","type":"codeVoice"},{"text":" ","type":"text"},{"text":"elements and updates the iterator’s current position to the element","type":"text"},{"text":" ","type":"text"},{"text":"following the last item in the returned span. The ","type":"text"},{"code":"maxCount","type":"codeVoice"},{"text":" ","type":"text"},{"text":"argument allows callers to avoid getting more items than they are","type":"text"},{"text":" ","type":"text"},{"text":"able to process in one go, simplifying usage, and","type":"text"},{"text":" ","type":"text"},{"text":"avoiding materializing more elements than needed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the iterator’s current position is at the end of the container, then","type":"text"},{"text":" ","type":"text"},{"text":"this method returns an empty span without updating the position.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This method can be used to efficiently process the items of a container","type":"text"},{"text":" ","type":"text"},{"text":"in bulk, by directly iterating over its piecewise contiguous pieces of","type":"text"},{"text":" ","type":"text"},{"text":"storage:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var it = items.makeBorrowingIterator()","while true {","  let span = it.nextSpan(maxCount: .max)","  if span.isEmpty { break }","  \/\/ Process items in `span`","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The spans returned by this method are not guaranteed to be disjunct.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Iterators that materialize elements on demand typically reuse the same"},{"type":"text","text":" "},{"text":"buffer over and over again; and even some proper containers may link to a","type":"text"},{"type":"text","text":" "},{"text":"single storage chunk (or parts of a storage chunk) multiple times, for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"example to repeat their contents."}]}],"kind":"content"}],"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol"]]},"references":{"doc://com.apple.Swift/documentation/Swift/BorrowingIteratorProtocol/Element":{"abstract":[],"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"},{"text":" : ~Copyable","kind":"text"}],"url":"\/documentation\/swift\/borrowingiteratorprotocol\/element","type":"topic","kind":"symbol","required":true,"role":"symbol","title":"Element","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/Element"},"doc://com.apple.Swift/documentation/Swift/Int":{"url":"\/documentation\/swift\/int","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Int","kind":"identifier"}],"title":"Int","navigatorTitle":[{"kind":"identifier","text":"Int"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","role":"symbol","abstract":[{"type":"text","text":"A signed integer value type."}],"kind":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/CompatibilitySpan/Span":{"identifier":"doc:\/\/com.apple.