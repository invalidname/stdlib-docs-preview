"text"},{"text":"maximumCount","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Span","preciseIdentifier":"s:s4SpanV","text":"Span","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/Element","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"If the underlying type stores its elements in one or more blocks of","type":"text"},{"text":" ","type":"text"},{"text":"contiguous memory, then the returned span typically directly","type":"text"},{"text":" ","type":"text"},{"text":"addresses one of those buffers. On the other hand, if the underlying type","type":"text"},{"text":" ","type":"text"},{"text":"materializes its elements on demand, then the returned span addresses","type":"text"},{"text":" ","type":"text"},{"text":"a temporary buffer managed by the iterator itself. Consequently, the returned","type":"text"},{"text":" ","type":"text"},{"text":"span is tied to this particular invocation of ","type":"text"},{"code":"nextSpan","type":"codeVoice"},{"text":", and it cannot","type":"text"},{"text":" ","type":"text"},{"text":"survive beyond the next invocation of this method.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the iterator has not yet reached the end of the underlying elements,","type":"text"},{"text":" ","type":"text"},{"text":"then this method returns a non-empty span of at most ","type":"text"},{"code":"maximumCount","type":"codeVoice"},{"text":" ","type":"text"},{"text":"elements and updates the iterator’s current position to the element","type":"text"},{"text":" ","type":"text"},{"text":"following the last item in the returned span. The ","type":"text"},{"code":"maximumCount","type":"codeVoice"},{"text":" ","type":"text"},{"text":"argument allows callers to avoid getting more items than they are","type":"text"},{"text":" ","type":"text"},{"text":"able to process in one go, simplifying usage, and","type":"text"},{"text":" ","type":"text"},{"text":"avoiding materializing more elements than needed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the iterator’s current position is at the end of the container, then"},{"type":"text","text":" "},{"type":"text","text":"this method returns an empty span without updating the position."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method can be used to efficiently process the items of a container"},{"type":"text","text":" "},{"type":"text","text":"in bulk, by directly iterating over its piecewise contiguous pieces of"},{"type":"text","text":" "},{"type":"text","text":"storage:"}]},{"type":"codeListing","syntax":"swift","code":["var it = items.makeBorrowingIterator()","while true {","  let span = it.nextSpan(maximumCount: .max)","  if span.isEmpty { break }","  \/\/ Process items in `span`","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The spans returned by this method are not guaranteed to be disjunct."},{"type":"text","text":" "},{"type":"text","text":"Iterators that materialize elements on demand typically reuse the same"},{"type":"text","text":" "},{"type":"text","text":"buffer over and over again; and even some proper containers may link to a"},{"type":"text","text":" "},{"type":"text","text":"single storage chunk (or parts of a storage chunk) multiple times, for"},{"type":"text","text":" "},{"type":"text","text":"example to repeat their contents."}]}],"kind":"content"}],"abstract":[{"text":"Returns a span over the next group of elements that are ready to by visited,","type":"text"},{"text":" ","type":"text"},{"text":"up to the specifed maximum.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/borrowingiteratorprotocol\/nextspan(maximumcount:)"]}],"references":{"doc://com.apple.Swift/documentation/Swift/BorrowingIteratorProtocol":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BorrowingIteratorProtocol"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol","role":"symbol","title":"BorrowingIteratorProtocol","abstract":[{"text":"A type that provides borrowed access to the values of a borrowing sequence.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"BorrowingIteratorProtocol"}],"type":"topic","url":"\/documentation\/swift\/borrowingiteratorprotocol"},"Swift-PageImage-card.png":{"identifier":"Swift-PageImage-card.png","variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png","traits":["2x","dark"]}],"alt":"An orange Swift logo on a gradient background.","type":"image"},"doc://com.apple.Swift/documentation/Swift/Int":{"title":"Int","url":"\/documentation\/swift\/int","navigatorTitle":[{"kind":"identifier","text":"Int"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Int","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","abstract":[{"text":"A signed integer value type.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/BorrowingIteratorProtocol/nextSpan(maximumCount:)":{"role":"symbol","kind":"symb