{"abstract":[{"text":"Returns a span over the next group of elements that are ready to by visited,","type":"text"},{"text":" ","type":"text"},{"text":"up to the specifed maximum.","type":"text"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/nextSpan(maximumCount:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"@_lifetime(&self) @_lifetime(self: copy self) ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nextSpan"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maximumCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4SpanV","text":"Span","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Span"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7ElementQa","text":"Element","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/Element"},{"kind":"text","text":">"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"If the underlying type stores its elements in one or more blocks of"},{"type":"text","text":" "},{"type":"text","text":"contiguous memory, then the returned span typically directly"},{"text":" ","type":"text"},{"type":"text","text":"addresses one of those buffers. On the other hand, if the underlying type"},{"type":"text","text":" "},{"type":"text","text":"materializes its elements on demand, then the returned span addresses"},{"text":" ","type":"text"},{"type":"text","text":"a temporary buffer managed by the iterator itself. Consequently, the returned"},{"type":"text","text":" "},{"text":"span is tied to this particular invocation of ","type":"text"},{"code":"nextSpan","type":"codeVoice"},{"text":", and it cannot","type":"text"},{"text":" ","type":"text"},{"text":"survive beyond the next invocation of this method.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the iterator has not yet reached the end of the underlying elements,"},{"type":"text","text":" "},{"type":"text","text":"then this method returns a non-empty span of at most "},{"code":"maximumCount","type":"codeVoice"},{"text":" ","type":"text"},{"text":"elements and updates the iterator’s current position to the element","type":"text"},{"text":" ","type":"text"},{"text":"following the last item in the returned span. The ","type":"text"},{"code":"maximumCount","type":"codeVoice"},{"text":" ","type":"text"},{"text":"argument allows callers to avoid getting more items than they are","type":"text"},{"text":" ","type":"text"},{"text":"able to process in one go, simplifying usage, and","type":"text"},{"text":" ","type":"text"},{"text":"avoiding materializing more elements than needed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the iterator’s current position is at the end of the container, then"},{"text":" ","type":"text"},{"text":"this method returns an empty span without updating the position.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This method can be used to efficiently process the items of a container","type":"text"},{"text":" ","type":"text"},{"text":"in bulk, by directly iterating over its piecewise contiguous pieces of","type":"text"},{"text":" ","type":"text"},{"text":"storage:","type":"text"}],"type":"paragraph"},{"code":["var it = items.makeBorrowingIterator()","while true {","  let span = it.nextSpan(maximumCount: .max)","  if span.isEmpty { break }","  \/\/ Process items in `span`","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The spans returned by this method are not guaranteed to be disjunct."},{"type":"text","text":" "},{"text":"Iterators that materialize elements on demand typically reuse the same","type":"text"},{"text":" ","type":"text"},{"text":"buffer over and over again; and even some proper containers may link to a","type":"text"},{"text":" ","type":"text"},{"text":"single storage chunk (or parts of a storage chunk) multiple times, for","type":"text"},{"text":" ","type":"text"},{"text":"example to repeat their contents.","type":"text"}]}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/borrowingiteratorprotocol\/nextspan(maximumcount:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Instance Method","platforms":[{"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iPadOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"13.0","name":"Mac Catalyst","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"10.10","name":"macOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"9.0","name":"tvOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"1.0","name":"visionOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"2.0","name":"watchOS","deprecated":false}],"role":"symbol","title":"nextSpan(maximumCount:)","symbolKind":"method","required":true,"modules":[{"name":"Swift"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nextSpan","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maximumCount","kind":"externalPa