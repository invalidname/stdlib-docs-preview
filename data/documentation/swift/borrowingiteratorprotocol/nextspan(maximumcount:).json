{"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol"]]},"abstract":[{"text":"Returns a span over the next group of elements that are ready to by visited,","type":"text"},{"text":" ","type":"text"},{"text":"up to the specifed maximum.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/borrowingiteratorprotocol\/nextspan(maximumcount:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/nextSpan(maximumCount:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"text","text":"@_lifetime(&self) @_lifetime(self: copy self) "},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nextSpan"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maximumCount"},{"kind":"text","text":": "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Span","kind":"typeIdentifier","text":"Span","preciseIdentifier":"s:s4SpanV"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/Element","kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7ElementQa"},{"kind":"text","text":">"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the underlying type stores its elements in one or more blocks of"},{"type":"text","text":" "},{"type":"text","text":"contiguous memory, then the returned span typically directly"},{"type":"text","text":" "},{"type":"text","text":"addresses one of those buffers. On the other hand, if the underlying type"},{"type":"text","text":" "},{"type":"text","text":"materializes its elements on demand, then the returned span addresses"},{"type":"text","text":" "},{"type":"text","text":"a temporary buffer managed by the iterator itself. Consequently, the returned"},{"type":"text","text":" "},{"type":"text","text":"span is tied to this particular invocation of "},{"type":"codeVoice","code":"nextSpan"},{"type":"text","text":", and it cannot"},{"type":"text","text":" "},{"type":"text","text":"survive beyond the next invocation of this method."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the iterator has not yet reached the end of the underlying elements,"},{"type":"text","text":" "},{"type":"text","text":"then this method returns a non-empty span of at most "},{"type":"codeVoice","code":"maximumCount"},{"type":"text","text":" "},{"type":"text","text":"elements and updates the iterator’s current position to the element"},{"type":"text","text":" "},{"type":"text","text":"following the last item in the returned span. The "},{"type":"codeVoice","code":"maximumCount"},{"type":"text","text":" "},{"type":"text","text":"argument allows callers to avoid getting more items than they are"},{"type":"text","text":" "},{"type":"text","text":"able to process in one go, simplifying usage, and"},{"type":"text","text":" "},{"type":"text","text":"avoiding materializing more elements than needed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the iterator’s current position is at the end of the container, then"},{"type":"text","text":" "},{"type":"text","text":"this method returns an empty span without updating the position."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method can be used to efficiently process the items of a container"},{"type":"text","text":" "},{"type":"text","text":"in bulk, by directly iterating over its piecewise contiguous pieces of"},{"type":"text","text":" "},{"type":"text","text":"storage:"}]},{"code":["var it = items.makeBorrowingIterator()","while true {","  let span = it.nextSpan(maximumCount: .max)","  if span.isEmpty { break }","  \/\/ Process items in `span`","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The spans returned by this method are not guaranteed to be disjunct."},{"type":"text","text":" "},{"type":"text","text":"Iterators that materialize elements on demand typically reuse the same"},{"type":"text","text":" "},{"type":"text","text":"buffer over and over again; and even some proper containers may link to a"},{"type":"text","text":" "},{"type":"text","text":"single storage chunk (or parts of a storage chunk) multiple times, for"},{"type":"text","text":" "},{"type":"text","text":"example to repeat their contents."}]}],"kind":"content"}],"metadata":{"role":"symbol","roleHeading":"Instance Method","title":"nextSpan(maximumCount:)","platforms":[{"deprecated":false,"unavailable":false,"name":"iOS","beta":false,"introducedAt":"8.0"},{"deprecated":false,"unavailable":false,"name":"iPadOS","beta":false,"introducedAt":"8.0"},{"deprecated":false,"unavailable":false,"name":"Mac Catalyst","beta":false,"introducedAt":"13.0"},{"deprecated":false,"unavailable":false,"name":"macOS","beta":false,"introducedAt":"10.10"},{"deprecated":false,"unavailable":false,"name":"tvOS","beta":false,"introducedAt":"9.0"},{"deprecated":false,"unavailable":false,"name":"visionOS","beta":false,"introducedAt":"1.0"},{"deprecated":false,"unavailable":false,"name":"watchOS","beta":false,"introducedAt":"2.0"}],"symbolKind":"method","modules":[{"name":"Swift"}],"required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nextSpan","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maximumCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Span","kind":"typeIdentifier","preciseIdentifier":"s:s4SpanV"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:s25BorrowingIteratorProtocolP7ElementQa"},{"text":">","kind":"text"}],"externalID":"s:s25BorrowingIteratorProtocolP8nextSpan12maximumCounts0E0Vy7ElementQzGSi_tF"},"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift":{"title":"Swift","type":"topic","abstract":[{"type":"text","text":"Build apps using a powerful open language."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","url":"\/documentation\/swift","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/Span":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Span"}],"navigatorTitle":[{"kind":"identifier","text":"Span"}],"type":"topic","abstract":[{"type":"codeVoice","code":"Span<Element>"},{"type":"text","text":" represents a contiguous region of memory"},{"type":"text","text":" "},{"type":"text","text":"which contains initialized instances of "},{"type":"codeVoice","code":"Element"},{"type":"text","text":"."}],"title":"Span","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Span","kind":"symbol","url":"\/documentation\/swift\/span"},"doc://com.apple.Swift/documentation/Swift/BorrowingIteratorProtocol":{"type":"topic","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"BorrowingIteratorProtocol","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BorrowingIteratorProtocol"}],"abstract":[{"type":"text","text":"A type that provides borrowed access to the values of a borrowing sequence."}],"url":"\/documentation\/swift\/borrowingiteratorprotocol","title":"BorrowingIteratorProtocol"},"doc://com.apple.Swift/documentation/Swift/BorrowingIteratorProtocol/Element":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"},{"text":" : ~Copyable","kind":"text"}],"kind":"symbol","abstract":[],"required":true,"role":"symbol","url":"\/documentation\/swift\/borrowingiteratorprotocol\/element","type":"topic","title":"Element","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BorrowingIteratorProtocol\/Element"},"doc://com.apple.Swift/documentation/Swift/Int":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Int"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Int"}],"abstract":[{"type":"text","text":"A signed integer value type."}],"title":"Int","url":"\/documentation\/swift\/int"},"doc://com.apple.Swift/documentation/Swift/BorrowingIteratorProtocol/nextSpan(maximumCount:)":{"required":true,"url":"\/documentation\/swift\/borrowingiteratorprotocol\/nextspan(maximumcount:)","title":"nextSpan(maximumCount:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nextSpan","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maximumCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4SpanV","text":"Span","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s25BorrowingIteratorProtocolP7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"Returns a span over the next group of elements that are ready to by visited,"},{"type":"text","text":" "},{"type":"text","text":"up to the specifed maximum."}],"identifier":"doc:\/