{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"When calling a function that takes a pointer as a parameter, you can use implicit"},{"type":"text","text":" "},{"type":"text","text":"casting to pass a compatible pointer type or implicit bridging to pass a pointer"},{"type":"text","text":" "},{"type":"text","text":"to a variable or the contents of an array."}],"type":"paragraph"},{"level":3,"text":"Pass a Constant Pointer as a Parameter","anchor":"Pass-a-Constant-Pointer-as-a-Parameter","type":"heading"},{"inlineContent":[{"type":"text","text":"When you call a function that is declared as taking an "},{"type":"codeVoice","code":"UnsafePointer<Type>"},{"type":"text","text":" argument,"},{"type":"text","text":" "},{"type":"text","text":"you can pass any of the following:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"UnsafePointer<Type>"},{"type":"text","text":", "},{"type":"codeVoice","code":"UnsafeMutablePointer<Type>"},{"type":"text","text":", or "},{"type":"codeVoice","code":"AutoreleasingUnsafeMutablePointer<Type>"},{"type":"text","text":" "},{"type":"text","text":"value, which is implicitly cast to "},{"type":"codeVoice","code":"UnsafePointer<Type>"},{"type":"text","text":" as necessary."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"String"},{"type":"text","text":" value, if "},{"type":"codeVoice","code":"Type"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Int8"},{"type":"text","text":" or "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":". The string is automatically converted"},{"type":"text","text":" "},{"type":"text","text":"to UTF8 in a zero-terminated buffer, and a pointer to that buffer is passed to the"},{"type":"text","text":" "},{"type":"text","text":"function."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An in-out expression that contains a mutable variable, property, or subscript reference"},{"type":"text","text":" "},{"type":"text","text":"of type "},{"type":"codeVoice","code":"Type"},{"type":"text","text":", which is passed as a pointer to the address of the left-hand side"},{"type":"text","text":" "},{"type":"text","text":"identifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"[Type]"},{"type":"text","text":" value, which is passed as a pointer to the start of the array."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The pointer you pass to the function is only guaranteed to be valid for the duration"},{"type":"text","text":" "},{"type":"text","text":"of the function call. Do not persist the pointer and access it after the function"},{"type":"text","text":" "},{"type":"text","text":"has returned."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This example shows the different ways that you can call the a function that takes"},{"type":"text","text":" "},{"type":"text","text":"a constant pointer:"}],"type":"paragraph"},{"syntax":"swift","code":["func takesAPointer(_ p: UnsafePointer<Float>) {","    \/\/ ...","}","","var x: Float = 0.0","takesAPointer(&x)","takesAPointer([1.0, 2.0, 3.0])"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"When you call a function that takes an "},{"type":"codeVoice","code":"UnsafeRawPointer"},{"type":"text","text":" argument, you can pass"},{"type":"text","text":" "},{"type":"text","text":"the same operands as "},{"type":"codeVoice","code":"UnsafePointer<Type>"},{"type":"text","text":", but with any type as "},{"type":"codeVoice","code":"Type"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This example shows the different ways that you can call a function that takes a constant"},{"type":"text","text":" "},{"type":"text","text":"raw pointer:"}],"type":"paragraph"},{"syntax":"swift","code":["func takesARawPointer(_ p: UnsafeRawPointer?)  {","    \/\/ ...","}","","var x: Float = 0.0, y: Int = 0","takesARawPointer(&x)","takesARawPointer(&y)","takesARawPointer([1.0, 2.0, 3.0] as [Float])","let intArray = [1, 2, 3]","takesARawPointer(intArray)","takesARawPointer(\"How are you today?\")"],"type":"codeListing"},{"level":3,"text":"Pass a Mutable Pointer as a Parameter","anchor":"Pass-a-Mutable-Pointer-as-a-Parameter","type":"heading"},{"inlineContent":[{"type":"text","text":"When you call a function that is declared as taking an "},{"type":"codeVoice","code":"UnsafeMutablePointer<Type>"},{"type":"text","text":" "},{"type":"text","text":"argument, you can pass any of the following:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"UnsafeMutablePointer<Type>"},{"type":"text","text":" value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An in-out expression of type "},{"type":"codeVoice","code":"Type"},{"type":"text","text":" that contains a mutable variable, property,"},{"type":"text","text":" "},{"type":"text","text":"or subscript reference, which is passed as a pointer to the address of the mutable"},{"type":"text","text":" "},{"type":"text","text":"value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An in-out expression of type "},{"type":"codeVoice","code":"[Type]"},{"type":"text","text":" that contains a mutable variable, property,"},{"type":"text","text":" "},{"type":"text","text":"or subscript reference, which is passed as a pointer to the start of the array, and"},{"type":"text","text":" "},{"type":"text","text":"is lifetime-extended for the duration of the call."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This example shows the different ways that you can call a function that takes a mutable"},{"type":"text","text":" "},{"type":"text","text":"pointer:"}],"type":"paragraph"},{"syntax":"swift","code":["func takesAMutablePointer(_ p: UnsafeMutablePointer<Float>) {","    \/\/ ...","}","","var x: Float = 0.0","var a: [Float] = [1.0, 2.0, 3.0]","takesAMutablePointer(&x)","takesAMutablePointer(&a)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"When you call a function that is declared as taking an "},{"type":"codeVoice","code":"UnsafeMutableRawPointer"},{"type":"text","text":" "},{"type":"text","text":"argument, you can pass the same operands as "},{"type":"codeVoice","code":"UnsafeMutablePointer<Type>"},{"type":"text","text":", but for"},{"type":"text","text":" "},{"type":"text","text":"any type as "},{"type":"codeVoice","code":"Type"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This example shows the different ways that you can call a function that takes a mutable"},{"type":"text","text":" "},{"type":"text","text":"raw pointer:"}],"type":"paragraph"},{"syntax":"swift","code":["func takesAMutableRawPointer(_ p: UnsafeMutableRawPointer?)  {","    \/\/ ...","}","","var x: Float = 0.0, y: Int = 0","var a: [Float] = [1.0, 2.0, 3.0], b: [Int] = [1, 2, 3]","takesAMutableRawPointer(&x)","takesAMutableRawPointer(&y)","takesAMutableRawPointer(&a)","takesAMutableRawPointer(&b)"],"type":"codeListing"},{"level":3,"text":"Pass an Autoreleasing Pointer as a Parameter","anchor":"Pass-an-Autoreleasing-Pointer-as-a-Parameter","type":"heading"},{"inlineContent":[{"type":"text","text":"When you call a function that is declared as taking an "},{"type":"codeVoice","code":"AutoreleasingUnsafeMutablePointer<Type>"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"you can pass any of the following:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"AutoreleasingUnsafeMutablePointer<Type>"},{"type":"text","text":" value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An in-out expression that contains a mutable variable, property, or subscript reference"},{"type":"text","text":" "},{"type":"text","text":"of type "},{"type":"codeVoice","code":"Type"},{"type":"text","text":". The value of the operand is copied bitwise into a temporary nonowning"},{"type":"text","text":" "},{"type":"text","text":"buffer. The address of that buffer is passed to the callee, and on return, the value"},{"type":"text","text":" "},{"type":"text","text":"in the buffer is loaded, retained, and reassigned into the operand."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Unlike with other pointer types, you can’t use an array as an implicitly bridged"},{"type":"text","text":" "},{"type":"text","text":"parameter."}],"type":"paragraph"},{"level":3,"text":"Pass a Function Pointer as a Parameter","anchor":"Pass-a-Function-Pointer-as-a-Parameter","type":"heading"},{"inlineContent":[{"type":"text","text":"When calling a function that takes a C function pointer argument, you can pass a"},{"type":"text","text":" "},{"type":"text","text":"top-level Swift function, a closure literal, a closure declared with the "},{"type":"codeVoice","code":"@convention(c)"},{"type":"text","text":" "},{"type":"text","text":"attribute, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". You can also pass a closure property of a generic type or a"},{"type":"text","text":" "},{"type":"text","text":"generic method as long as no generic type parameters are referenced in the closure’s"},{"type":"text","text":" "},{"type":"text","text":"argument list or body."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, consider Core Foundation’s "},{"code":"CFArrayCreateMutable(_:_:_:)","type":"codeVoice"},{"text":" function.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":"CFArrayCreateMutable(_:_:_:)","type":"codeVoice"},{"type":"text","text":" function takes a "},{"code":"CFArrayCallBacks","type":"codeVoice"},{"type":"text","text":" structure,"},{"text":" ","type":"text"},{"text":"which is initialized with function pointer callbacks:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func customCopyDescription(_ p: UnsafeRawPointer?) -> Unmanaged<CFString>? {","    \/\/ return an Unmanaged<CFString>? value","}","","var callbacks = CFArrayCallBacks(","    version: 0,","    retain: nil,","    release: nil,","    copyDescription: customCopyDescription,","    equal: { (p1, p2) -> DarwinBoolean in","        \/\/ return Bool value","    }",")","var mutableArray = CFArrayCreateMutable(nil, 0, &callbacks)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this example, the "},{"type":"codeVoice","code":"CFArrayCallBacks"},{"type":"text","text":" initializer uses "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" values as arguments"},{"type":"text","text":" "},{"type":"text","text":"for the "},{"type":"codeVoice","code":"retain"},{"type":"text","text":" and "},{"type":"codeVoice","code":"release"},{"text":" parameters, the ","type":"text"},{"code":"customCopyDescription(_:)","type":"codeVoice"},{"type":"text","text":" function"},{"text":" ","type":"text"},{"text":"as the argument for the ","type":"text"},{"code":"customCopyDescription","type":"codeVoice"},{"text":" parameter, and a closure literal","type":"text"},{"type":"text","text":" "},{"text":"as the argument for the ","type":"text"},{"type":"codeVoice","code":"equal"},{"type":"text","text":" parameter."}]},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"Only Swift function types with C function reference calling convention may"},{"type":"text","text":" "},{"type":"text","text":"be used for function pointer arguments. Like a C function pointer, a Swift function"},{"type":"text","text":" "},{"type":"text","text":"type with the "},{"type":"codeVoice","code":"@convention(c)"},{"type":"text","text":" attribute does not capture the context of its surrounding"},{"type":"text","text":" "},{"type":"text","text":"scope."}],"type":"paragraph"}],"style":"note","type":"aside"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/calling-functions-with-pointer-parameters"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/calling-functions-with-pointer-parameters"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Use implicit pointer casting or bridging when calling functions that takes pointers","type":"text"},{"text":" ","type":"text"},{"text":"as parameters.","type":"text"}],"kind":"article","metadata":{"modules":[{"name":"Swift"}],"roleHeading":"Article","role":"article","title":"Calling Functions With Pointer Parameters"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","doc:\/\/com.apple.Swift\/documentation\/Swift\/manual-memory-management"]]},"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/swift-standard-library":{"title":"Swift Standard Library","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","role":"collectionGroup","abstract":[{"text":"Solve complex problems and write high-performance, readable code.","type":"text"}],"kind":"article","url":"\/documentation\/swift\/swift-standard-library"},"doc://com.apple.Swift/documentation/Swift/manual-memory-management":{"title":"Manual Memory Management","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/manual-memory-management","role":"collectionGroup","abstract":[{"text":"Allocate and manage memory manually.","type":"text"}],"kind":"article","url":"\/documentation\/swift\/manual-memory-management"},"doc://com.apple.Swift/documentation/Swift":{"title":"Swift","type":"topic","abstract":[{"type":"text","text":"Build apps using a powerful open language."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","url":"\/documentation\/swift","kind":"symbol"}}}