{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"When calling a function that takes a pointer as a parameter, you can use implicit","type":"text"},{"type":"text","text":" "},{"type":"text","text":"casting to pass a compatible pointer type or implicit bridging to pass a pointer"},{"text":" ","type":"text"},{"type":"text","text":"to a variable or the contents of an array."}]},{"text":"Pass a Constant Pointer as a Parameter","level":3,"type":"heading","anchor":"Pass-a-Constant-Pointer-as-a-Parameter"},{"inlineContent":[{"text":"When you call a function that is declared as taking an ","type":"text"},{"type":"codeVoice","code":"UnsafePointer<Type>"},{"text":" argument,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"you can pass any of the following:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"UnsafePointer<Type>"},{"type":"text","text":", "},{"type":"codeVoice","code":"UnsafeMutablePointer<Type>"},{"type":"text","text":", or "},{"type":"codeVoice","code":"AutoreleasingUnsafeMutablePointer<Type>"},{"text":" ","type":"text"},{"text":"value, which is implicitly cast to ","type":"text"},{"type":"codeVoice","code":"UnsafePointer<Type>"},{"text":" as necessary.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"String"},{"type":"text","text":" value, if "},{"type":"codeVoice","code":"Type"},{"type":"text","text":" is "},{"code":"Int8","type":"codeVoice"},{"type":"text","text":" or "},{"code":"UInt8","type":"codeVoice"},{"text":". The string is automatically converted","type":"text"},{"text":" ","type":"text"},{"text":"to UTF8 in a zero-terminated buffer, and a pointer to that buffer is passed to the","type":"text"},{"text":" ","type":"text"},{"text":"function.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An in-out expression that contains a mutable variable, property, or subscript reference","type":"text"},{"text":" ","type":"text"},{"text":"of type ","type":"text"},{"code":"Type","type":"codeVoice"},{"text":", which is passed as a pointer to the address of the left-hand side","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"identifier."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"code":"[Type]","type":"codeVoice"},{"type":"text","text":" value, which is passed as a pointer to the start of the array."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The pointer you pass to the function is only guaranteed to be valid for the duration","type":"text"},{"text":" ","type":"text"},{"text":"of the function call. Do not persist the pointer and access it after the function","type":"text"},{"text":" ","type":"text"},{"text":"has returned.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This example shows the different ways that you can call the a function that takes","type":"text"},{"text":" ","type":"text"},{"text":"a constant pointer:","type":"text"}]},{"syntax":"swift","code":["func takesAPointer(_ p: UnsafePointer<Float>) {","    \/\/ ...","}","","var x: Float = 0.0","takesAPointer(&x)","takesAPointer([1.0, 2.0, 3.0])"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"When you call a function that takes an ","type":"text"},{"type":"codeVoice","code":"UnsafeRawPointer"},{"text":" argument, you can pass","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the same operands as "},{"type":"codeVoice","code":"UnsafePointer<Type>"},{"text":", but with any type as ","type":"text"},{"type":"codeVoice","code":"Type"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This example shows the different ways that you can call a function that takes a constant"},{"type":"text","text":" "},{"type":"text","text":"raw pointer:"}]},{"syntax":"swift","type":"codeListing","code":["func takesARawPointer(_ p: UnsafeRawPointer?)  {","    \/\/ ...","}","","var x: Float = 0.0, y: Int = 0","takesARawPointer(&x)","takesARawPointer(&y)","takesARawPointer([1.0, 2.0, 3.0] as [Float])","let intArray = [1, 2, 3]","takesARawPointer(intArray)","takesARawPointer(\"How are you today?\")"]},{"text":"Pass a Mutable Pointer as a Parameter","type":"heading","level":3,"anchor":"Pass-a-Mutable-Pointer-as-a-Parameter"},{"type":"paragraph","inlineContent":[{"text":"When you call a function that is declared as taking an ","type":"text"},{"type":"codeVoice","code":"UnsafeMutablePointer<Type>"},{"text":" ","type":"text"},{"type":"text","text":"argument, you can pass any of the following:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"UnsafeMutablePointer<Type>","type":"codeVoice"},{"type":"text","text":" value."}]}]},{"content":[{"inlineContent":[{"text":"An in-out expression of type ","type":"text"},{"code":"Type","type":"codeVoice"},{"type":"text","text":" that contains a mutable variable, property,"},{"type":"text","text":" "},{"type":"text","text":"or subscript reference, which is passed as a pointer to the address of the mutable"},{"type":"text","text":" "},{"type":"text","text":"value."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An in-out expression of type ","type":"text"},{"type":"codeVoice","code":"[Type]"},{"text":" that contains a mutable variable, property,","type":"text"},{"text":" ","type":"text"},{"text":"or subscript reference, which is passed as a pointer to the start of the array, and","type":"text"},{"text":" ","type":"text"},{"text":"is lifetime-extended for the duration of the call.","type":"text"}]}]}]},{"inlineContent":[{"text":"This example shows the different ways that you can call a function that takes a mutable","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"pointer:"}],"type":"paragraph"},{"code":["func takesAMutablePointer(_ p: UnsafeMutablePointer<Float>) {","    \/\/ ...","}","","var x: Float = 0.0","var a: [Float] = [1.0, 2.0, 3.0]","takesAMutablePointer(&x)","takesAMutablePointer(&a)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When you call a function that is declared as taking an ","type":"text"},{"type":"codeVoice","code":"UnsafeMutableRawPointer"},{"type":"text","text":" "},{"text":"argument, you can pass the same operands as ","type":"text"},{"code":"UnsafeMutablePointer<Type>","type":"codeVoice"},{"type":"text","text":", but for"},{"text":" ","type":"text"},{"text":"any type as ","type":"text"},{"type":"codeVoice","code":"Type"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This example shows the different ways that you can call a function that takes a mutable","type":"text"},{"text":" ","type":"text"},{"text":"raw pointer:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func takesAMutableRawPointer(_ p: UnsafeMutableRawPointer?)  {","    \/\/ ...","}","","var x: Float = 0.0, y: Int = 0","var a: [Float] = [1.0, 2.0, 3.0], b: [Int] = [1, 2, 3]","takesAMutableRawPointer(&x)","takesAMutableRawPointer(&y)","takesAMutableRawPointer(&a)","takesAMutableRawPointer(&b)"]},{"text":"Pass an Autoreleasing Pointer as a Parameter","type":"heading","anchor":"Pass-an-Autoreleasing-Pointer-as-a-Parameter","level":3},{"inlineContent":[{"type":"text","text":"When you call a function that is declared as taking an "},{"type":"codeVoice","code":"AutoreleasingUnsafeMutablePointer<Type>"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"you can pass any of the following:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"code":"AutoreleasingUnsafeMutablePointer<Type>","type":"codeVoice"},{"type":"text","text":" value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An in-out expression that contains a mutable variable, property, or subscript reference"},{"type":"text","text":" "},{"type":"text","text":"of type "},{"code":"Type","type":"codeVoice"},{"type":"text","text":". The value of the operand is copied bitwise into a temporary nonowning"},{"type":"text","text":" "},{"type":"text","text":"buffer. The address of that buffer is passed to the callee, and on return, the value"},{"type":"text","text":" "},{"type":"text","text":"in the buffer is loaded, retained, and reassigned into the operand."}]}]}]},{"inlineContent":[{"text":"Unlike with other pointer types, you can’t use an array as an implicitly bridged","type":"text"},{"type":"text","text":" "},{"type":"text","text":"parameter."}],"type":"paragraph"},{"level":3,"text":"Pass a Function Pointer as a Parameter","type":"heading","anchor":"Pass-a-Function-Pointer-as-a-Parameter"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When calling a function that takes a C function pointer argument, you can pass a"},{"text":" ","type":"text"},{"text":"top-level Swift function, a closure literal, a closure declared with the ","type":"text"},{"code":"@convention(c)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"attribute, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":". You can also pass a closure property of a generic type or a","type":"text"},{"text":" ","type":"text"},{"text":"generic method as long as no generic type parameters are referenced in the closure’s","type":"text"},{"text":" ","type":"text"},{"text":"argument list or body.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, consider Core Foundation’s ","type":"text"},{"code":"CFArrayCreateMutable(_:_:_:)","type":"codeVoice"},{"text":" function.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":"CFArrayCreateMutable(_:_:_:)","type":"codeVoice"},{"text":" function takes a ","type":"text"},{"code":"CFArrayCallBacks","type":"codeVoice"},{"text":" structure,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"which is initialized with function pointer callbacks:"}]},{"code":["func customCopyDescription(_ p: UnsafeRawPointer?) -> Unmanaged<CFString>? {","    \/\/ return an Unmanaged<CFString>? value","}","","var callbacks = CFArrayCallBacks(","    version: 0,","    retain: nil,","    release: nil,","    copyDescription: customCopyDescription,","    equal: { (p1, p2) -> DarwinBoolean in","        \/\/ return Bool value","    }",")","var mutableArray = CFArrayCreateMutable(nil, 0, &callbacks)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"In this example, the "},{"type":"codeVoice","code":"CFArrayCallBacks"},{"type":"text","text":" initializer uses "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" values as arguments"},{"type":"text","text":" "},{"type":"text","text":"for the "},{"type":"codeVoice","code":"retain"},{"type":"text","text":" and "},{"type":"codeVoice","code":"release"},{"type":"text","text":" parameters, the "},{"type":"codeVoice","code":"customCopyDescription(_:)"},{"type":"text","text":" function"},{"type":"text","text":" "},{"type":"text","text":"as the argument for the "},{"type":"codeVoice","code":"customCopyDescription"},{"type":"text","text":" parameter, and a closure literal"},{"type":"text","text":" "},{"type":"text","text":"as the argument for the "},{"code":"equal","type":"codeVoice"},{"type":"text","text":" parameter."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Only Swift function types with C function reference calling convention may","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"be used for function pointer arguments. Like a C function pointer, a Swift function"},{"text":" ","type":"text"},{"type":"text","text":"type with the "},{"type":"codeVoice","code":"@convention(c)"},{"text":" attribute does not capture the context of its surrounding","type":"text"},{"text":" ","type":"text"},{"text":"scope.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","doc:\/\/com.apple.Swift\/documentation\/Swift\/manual-memory-management"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"Calling Functions With Pointer Parameters","modules":[{"name":"Swift"}],"roleHeading":"Article","role":"article"},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/calling-functions-with-pointer-parameters","interfaceLanguage":"swift"},"sections":[],"kind":"article","abstract":[{"text":"Use implicit pointer casting or bridging when calling functions that takes pointers","type":"text"},{"text":" ","type":"text"},{"text":"as parameters.","type":"text"}],"references":{"doc://com.apple.Swift/documentation/Swift/swift-standard-library":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","url":"\/documentation\/swift\/swift-standard-library","kind":"article","role":"collectionGroup","type":"topic","title":"Swift Standard Library","abstract":[{"type":"text","text":"Solve complex problems and write high-performance, readable code."}]},"doc://com.apple.Swift/documentation/Swift/manual-memory-management":{"url":"\/documentation\/swift\/manual-memory-management","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/manual-memory-management","abstract":[{"text":"Allocate and manage memory manually.","type":"text"}],"title":"Manual Memory Management","type":"topic","kind":"article","role":"collectionGroup"},"doc://com.apple.Swift/documentation/Swift":{"kind":"symbol","type":"topic","role":"collection","title":"Swift","images":[{"type":"card","identifier":"Swift-PageImage-card.png"}],"abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"Swift-PageImage-card.png":{"variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png"}],"type":"image","identifier":"Swift-PageImage-card.png","alt":"An orange Swift logo on a gradient background."}}}