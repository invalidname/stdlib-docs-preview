{"metadata":{"role":"article","modules":[{"name":"Standard Library"}],"roleHeading":"Article","title":"Calling Functions With Pointer Parameters"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/manual-memory-management"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"When calling a function that takes a pointer as a parameter, you can use implicit","type":"text"},{"text":" ","type":"text"},{"text":"casting to pass a compatible pointer type or implicit bridging to pass a pointer","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to a variable or the contents of an array."}],"type":"paragraph"},{"level":3,"anchor":"Pass-a-Constant-Pointer-as-a-Parameter","type":"heading","text":"Pass a Constant Pointer as a Parameter"},{"inlineContent":[{"type":"text","text":"When you call a function that is declared as taking an "},{"type":"codeVoice","code":"UnsafePointer<Type>"},{"type":"text","text":" argument,"},{"text":" ","type":"text"},{"text":"you can pass any of the following:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"UnsafePointer<Type>"},{"type":"text","text":", "},{"type":"codeVoice","code":"UnsafeMutablePointer<Type>"},{"type":"text","text":", or "},{"type":"codeVoice","code":"AutoreleasingUnsafeMutablePointer<Type>"},{"type":"text","text":" "},{"type":"text","text":"value, which is implicitly cast to "},{"type":"codeVoice","code":"UnsafePointer<Type>"},{"type":"text","text":" as necessary."}]}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" value, if ","type":"text"},{"code":"Type","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Int8","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"UInt8","type":"codeVoice"},{"text":". The string is automatically converted","type":"text"},{"text":" ","type":"text"},{"text":"to UTF8 in a zero-terminated buffer, and a pointer to that buffer is passed to the","type":"text"},{"text":" ","type":"text"},{"text":"function.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An in-out expression that contains a mutable variable, property, or subscript reference"},{"type":"text","text":" "},{"type":"text","text":"of type "},{"type":"codeVoice","code":"Type"},{"text":", which is passed as a pointer to the address of the left-hand side","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"identifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"[Type]"},{"type":"text","text":" value, which is passed as a pointer to the start of the array."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pointer you pass to the function is only guaranteed to be valid for the duration"},{"type":"text","text":" "},{"type":"text","text":"of the function call. Do not persist the pointer and access it after the function"},{"type":"text","text":" "},{"type":"text","text":"has returned."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This example shows the different ways that you can call the a function that takes"},{"type":"text","text":" "},{"text":"a constant pointer:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["func takesAPointer(_ p: UnsafePointer<Float>) {","    \/\/ ...","}","","var x: Float = 0.0","takesAPointer(&x)","takesAPointer([1.0, 2.0, 3.0])"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you call a function that takes an "},{"code":"UnsafeRawPointer","type":"codeVoice"},{"text":" argument, you can pass","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the same operands as "},{"type":"codeVoice","code":"UnsafePointer<Type>"},{"text":", but with any type as ","type":"text"},{"type":"codeVoice","code":"Type"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This example shows the different ways that you can call a function that takes a constant"},{"type":"text","text":" "},{"type":"text","text":"raw pointer:"}]},{"type":"codeListing","syntax":"swift","code":["func takesARawPointer(_ p: UnsafeRawPointer?)  {","    \/\/ ...","}","","var x: Float = 0.0, y: Int = 0","takesARawPointer(&x)","takesARawPointer(&y)","takesARawPointer([1.0, 2.0, 3.0] as [Float])","let intArray = [1, 2, 3]","takesARawPointer(intArray)","takesARawPointer(\"How are you today?\")"]},{"text":"Pass a Mutable Pointer as a Parameter","anchor":"Pass-a-Mutable-Pointer-as-a-Parameter","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you call a function that is declared as taking an "},{"type":"codeVoice","code":"UnsafeMutablePointer<Type>"},{"type":"text","text":" "},{"type":"text","text":"argument, you can pass any of the following:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"UnsafeMutablePointer<Type>"},{"type":"text","text":" value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An in-out expression of type "},{"type":"codeVoice","code":"Type"},{"type":"text","text":" that contains a mutable variable, property,"},{"type":"text","text":" "},{"type":"text","text":"or subscript reference, which is passed as a pointer to the address of the mutable"},{"type":"text","text":" "},{"type":"text","text":"value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An in-out expression of type "},{"type":"codeVoice","code":"[Type]"},{"type":"text","text":" that contains a mutable variable, property,"},{"type":"text","text":" "},{"type":"text","text":"or subscript reference, which is passed as a pointer to the start of the array, and"},{"type":"text","text":" "},{"type":"text","text":"is lifetime-extended for the duration of the call."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This example shows the different ways that you can call a function that takes a mutable","type":"text"},{"text":" ","type":"text"},{"text":"pointer:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func takesAMutablePointer(_ p: UnsafeMutablePointer<Float>) {","    \/\/ ...","}","","var x: Float = 0.0","var a: [Float] = [1.0, 2.0, 3.0]","takesAMutablePointer(&x)","takesAMutablePointer(&a)"]},{"inlineContent":[{"type":"text","text":"When you call a function that is declared as taking an "},{"code":"UnsafeMutableRawPointer","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"argument, you can pass the same operands as "},{"type":"codeVoice","code":"UnsafeMutablePointer<Type>"},{"type":"text","text":", but for"},{"type":"text","text":" "},{"type":"text","text":"any type as "},{"type":"codeVoice","code":"Type"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This example shows the different ways that you can call a function that takes a mutable","type":"text"},{"text":" ","type":"text"},{"text":"raw pointer:","type":"text"}]},{"code":["func takesAMutableRawPointer(_ p: UnsafeMutableRawPointer?)  {","    \/\/ ...","}","","var x: Float = 0.0, y: Int = 0","var a: [Float] = [1.0, 2.0, 3.0], b: [Int] = [1, 2, 3]","takesAMutableRawPointer(&x)","takesAMutableRawPointer(&y)","takesAMutableRawPointer(&a)","takesAMutableRawPointer(&b)"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Pass-an-Autoreleasing-Pointer-as-a-Parameter","text":"Pass an Autoreleasing Pointer as a Parameter","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you call a function that is declared as taking an "},{"type":"codeVoice","code":"AutoreleasingUnsafeMutablePointer<Type>"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"you can pass any of the following:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"code":"AutoreleasingUnsafeMutablePointer<Type>","type":"codeVoice"},{"type":"text","text":" value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An in-out expression that contains a mutable variable, property, or subscript reference"},{"type":"text","text":" "},{"type":"text","text":"of type "},{"code":"Type","type":"codeVoice"},{"type":"text","text":". The value of the operand is copied bitwise into a temporary nonowning"},{"type":"text","text":" "},{"type":"text","text":"buffer. The address of that buffer is passed to the callee, and on return, the value"},{"type":"text","text":" "},{"type":"text","text":"in the buffer is loaded, retained, and reassigned into the operand."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike with other pointer types, you can’t use an array as an implicitly bridged"},{"type":"text","text":" "},{"type":"text","text":"parameter."}]},{"level":3,"anchor":"Pass-a-Function-Pointer-as-a-Parameter","type":"heading","text":"Pass a Function Pointer as a Parameter"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When calling a function that takes a C function pointer argument, you can pass a"},{"type":"text","text":" "},{"type":"text","text":"top-level Swift function, a closure literal, a closure declared with the "},{"type":"codeVoice","code":"@convention(c)"},{"type":"text","text":" "},{"type":"text","text":"attribute, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". You can also pass a closure property of a generic type or a"},{"type":"text","text":" "},{"type":"text","text":"generic method as long as no generic type parameters are referenced in the closure’s"},{"type":"text","text":" "},{"text":"argument list or body.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, consider Core Foundation’s ","type":"text"},{"code":"CFArrayCreateMutable(_:_:_:)","type":"codeVoice"},{"text":" function.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":"CFArrayCreateMutable(_:_:_:)","type":"codeVoice"},{"text":" function takes a ","type":"text"},{"code":"CFArrayCallBacks","type":"codeVoice"},{"text":" structure,","type":"text"},{"text":" ","type":"text"},{"text":"which is initialized with function pointer callbacks:","type":"text"}]},{"code":["func customCopyDescription(_ p: UnsafeRawPointer?) -> Unmanaged<CFString>? {","    \/\/ return an Unmanaged<CFString>? value","}","","var callbacks = CFArrayCallBacks(","    version: 0,","    retain: nil,","    release: nil,","    copyDescription: customCopyDescription,","    equal: { (p1, p2) -> DarwinBoolean in","        \/\/ return Bool value","    }",")","var mutableArray = CFArrayCreateMutable(nil, 0, &callbacks)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"In this example, the ","type":"text"},{"code":"CFArrayCallBacks","type":"codeVoice"},{"text":" initializer uses ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" values as arguments","type":"text"},{"text":" ","type":"text"},{"text":"for the ","type":"text"},{"code":"retain","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"release","type":"codeVoice"},{"text":" parameters, the ","type":"text"},{"code":"customCopyDescription(_:)","type":"codeVoice"},{"text":" function","type":"text"},{"text":" ","type":"text"},{"text":"as the argument for the ","type":"text"},{"code":"customCopyDescription","type":"codeVoice"},{"text":" parameter, and a closure literal","type":"text"},{"text":" ","type":"text"},{"text":"as the argument for the ","type":"text"},{"code":"equal","type":"codeVoice"},{"text":" parameter.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only Swift function types with C function reference calling convention may"},{"type":"text","text":" "},{"text":"be used for function pointer arguments. Like a C function pointer, a Swift function","type":"text"},{"text":" ","type":"text"},{"text":"type with the ","type":"text"},{"code":"@convention(c)","type":"codeVoice"},{"text":" attribute does not capture the context of its surrounding","type":"text"},{"text":" ","type":"text"},{"text":"scope.","type":"text"}]}],"type":"aside","style":"note","name":"Note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/calling-functions-with-pointer-parameters"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/calling-functions-with-pointer-parameters"},"abstract":[{"text":"Use implicit pointer casting or bridging when calling functions that takes pointers","type":"text"},{"text":" ","type":"text"},{"text":"as parameters.","type":"text"}],"kind":"article","sections":[],"references":{"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/manual-memory-management":{"title":"Manual Memory Management","type":"topic","url":"\/documentation\/swift\/manual-memory-management","kind":"article","abstract":[{"type":"text","text":"Allocate and manage memory manually."}],"role":"collectionGroup","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/manual-memory-management"}}}