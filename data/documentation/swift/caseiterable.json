{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"platforms":[{"introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false,"name":"iOS"},{"introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false,"name":"iPadOS"},{"introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false,"name":"Mac Catalyst"},{"introducedAt":"10.10","deprecated":false,"unavailable":false,"beta":false,"name":"macOS"},{"introducedAt":"9.0","deprecated":false,"unavailable":false,"beta":false,"name":"tvOS"},{"introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false,"name":"visionOS"},{"introducedAt":"2.0","deprecated":false,"unavailable":false,"beta":false,"name":"watchOS"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CaseIterable","kind":"identifier"}],"roleHeading":"Protocol","title":"CaseIterable","externalID":"s:s12CaseIterableP","navigatorTitle":[{"text":"CaseIterable","kind":"identifier"}],"role":"symbol","symbolKind":"protocol","modules":[{"name":"Standard Library"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"CaseIterable","kind":"identifier"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Types that conform to the "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":" protocol are typically"},{"type":"text","text":" "},{"type":"text","text":"enumerations without associated values. When using a "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":" type,"},{"type":"text","text":" "},{"type":"text","text":"you can access a collection of all of the type’s cases by using the type’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"allCases"},{"type":"text","text":" property."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, the "},{"type":"codeVoice","code":"CompassDirection"},{"type":"text","text":" enumeration declared in this example"},{"type":"text","text":" "},{"type":"text","text":"conforms to "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":". You access the number of cases and the cases"},{"type":"text","text":" "},{"type":"text","text":"themselves through "},{"type":"codeVoice","code":"CompassDirection.allCases"},{"type":"text","text":"."}]},{"type":"codeListing","code":["enum CompassDirection: CaseIterable {","    case north, south, east, west","}","","print(\"There are \\(CompassDirection.allCases.count) directions.\")","\/\/ Prints \"There are 4 directions.\"","let caseList = CompassDirection.allCases","                               .map({ \"\\($0)\" })","                               .joined(separator: \", \")","\/\/ caseList == \"north, south, east, west\""],"syntax":"swift"},{"type":"heading","level":1,"anchor":"Conforming-to-the-CaseIterable-Protocol","text":"Conforming to the CaseIterable Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The compiler can automatically provide an implementation of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":" requirements for any enumeration without associated values"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"@available"},{"type":"text","text":" attributes on its cases. The synthesized "},{"type":"codeVoice","code":"allCases"},{"type":"text","text":" "},{"type":"text","text":"collection provides the cases in order of their declaration."}]},{"inlineContent":[{"type":"text","text":"You can take advantage of this compiler support when defining your own"},{"type":"text","text":" "},{"type":"text","text":"custom enumeration by declaring conformance to "},{"code":"CaseIterable","type":"codeVoice"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"text","text":"enumeration’s original declaration. The "},{"type":"codeVoice","code":"CompassDirection"},{"type":"text","text":" example above"},{"type":"text","text":" "},{"type":"text","text":"demonstrates this automatic implementation."}],"type":"paragraph"}]}],"relationshipsSections":[{"title":"Conforming Types","type":"conformingTypes","kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError\/Reason-swift.enum"]}],"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CaseIterable","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CaseIterable\/allCases-swift.type.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/CaseIterable\/AllCases-swift.associatedtype"],"anchor":"Accessing-Cases","title":"Accessing Cases"}],"abstract":[{"type":"text","text":"A type that provides a collection of all of its values."}],"seeAlsoSections":[{"title":"Raw Representation","generated":true,"anchor":"Raw-Representation","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/RawRepresentable"]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/caseiterable"]}],"references":{"doc://com.apple.Swift/documentation/Swift/CaseIterable/allCases-swift.type.property":{"type":"topic","url":"\/documentation\/swift\/caseiterable\/allcases-swift.type.property","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"allCases","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s12CaseIterableP8AllCasesQa","text":"AllCases","kind":"typeIdentifier"}],"title":"allCases","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CaseIterable\/allCases-swift.type.property","role":"symbol