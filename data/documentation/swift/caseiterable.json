rue}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CaseIterable","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Accessing-Cases","title":"Accessing Cases","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CaseIterable\/allCases-swift.type.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/CaseIterable\/AllCases-swift.associatedtype"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CaseIterable","kind":"identifier"}]}]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Types that conform to the "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":" protocol are typically"},{"type":"text","text":" "},{"type":"text","text":"enumerations without associated values. When using a "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":" type,"},{"type":"text","text":" "},{"type":"text","text":"you can access a collection of all of the type’s cases by using the type’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"allCases"},{"type":"text","text":" property."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, the "},{"type":"codeVoice","code":"CompassDirection"},{"type":"text","text":" enumeration declared in this example"},{"type":"text","text":" "},{"type":"text","text":"conforms to "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":". You access the number of cases and the cases"},{"type":"text","text":" "},{"type":"text","text":"themselves through "},{"type":"codeVoice","code":"CompassDirection.allCases"},{"type":"text","text":"."}]},{"type":"codeListing","code":["enum CompassDirection: CaseIterable {","    case north, south, east, west","}","","print(\"There are \\(CompassDirection.allCases.count) directions.\")","\/\/ Prints \"There are 4 directions.\"","let caseList = CompassDirection.allCases","                               .map({ \"\\($0)\" })","                               .joined(separator: \", \")","\/\/ caseList == \"north, south, east, west\""],"syntax":"swift"},{"type":"heading","level":1,"anchor":"Conforming-to-the-CaseIterable-Protocol","text":"Conforming to the CaseIterable Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The compiler can automatically provide an implementation of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":" requirements for any enumeration without associated values"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"@available"},{"type":"text","text":" attributes on its cases. The synthesized "},{"type":"codeVoice","code":"allCases"},{"type":"text","text":" "},{"type":"text","text":"collection provides the cases in order of their declaration."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can take advantage of this compiler support when defining your own"},{"type":"text","text":" "},{"type":"text","text":"custom enumeration by declaring conformance to "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"text","text":"enumeration’s original declaration. The "},{"type":"codeVoice","code":"CompassDirection"},{"type":"text","text":" example above"},{"type":"text","text":" "},{"type":"text","text":"demonstrates this automatic implementation."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/caseiterable"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Unicode/BinaryProperty":{"abstract":[{"type":"text","text":"A list of Unicode properties that can either be true or false."}],"title":"Unicode.BinaryProperty","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/B