text":" "},{"type":"text","text":"efficient execution of resumptions by reducing potential operating system"},{"type":"text","text":" "},{"type":"text","text":"wake-ups. If no tolerance is specified (i.e. nil is passed in) the sleep"},{"type":"text","text":" "},{"type":"text","text":"function is expected to schedule with a default tolerance strategy."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For more information about specific clocks see "},{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"SuspendingClock","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"abstract":[{"type":"text","text":"A mechanism in which to measure time, and delay work until a given point"},{"type":"text","text":" "},{"type":"text","text":"in time."}],"metadata":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"Clock","kind":"identifier"}],"navigatorTitle":[{"text":"Clock","kind":"identifier"}],"platforms":[{"deprecated":false,"introducedAt":"8.0","name":"iOS","beta":false,"unavailable":false},{"deprecated":false,"introducedAt":"8.0","name":"iPadOS","beta":false,"unavailable":false},{"deprecated":false,"introducedAt":"13.0","name":"Mac Catalyst","beta":false,"unavailable":false},{"deprecated":false,"introducedAt":"10.10","name":"macOS","beta":false,"unavailable":false},{"deprecated":false,"introducedAt":"9.0","name":"tvOS","beta":false,"unavailable":false},{"deprecated":false,"introducedAt":"1.0","name":"visionOS","beta":false,"unavailable":false},{"deprecated":false,"introducedAt":"2.0","name":"watchOS","beta":false,"unavailable":false}],"externalID":"s:12_Concurrency5ClockP","role":"symbol","roleHeading":"Protocol","title":"Clock","modules":[{"relatedModules":[],"name":"Swift"}],"symbolKind":"protocol"},"variants":[{"traits":[{"inter