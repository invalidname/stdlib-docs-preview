le passes ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for the ","type":"text"},{"code":"omittingEmptySubsequences","type":"codeVoice"},{"text":" ","type":"text"},{"text":"parameter, so the returned array contains empty strings where spaces","type":"text"},{"text":" ","type":"text"},{"text":"were repeated.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["print(line.split(separator: \" \", omittingEmptySubsequences: false)","          .map(String.init))","\/\/ Prints \"[\"BLANCHE:\", \"\", \"\", \"I\", \"don\\'t\", \"want\", \"realism.\", \"I\", \"want\", \"magic!\"]\""],"type":"codeListing"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" is the length of the sequence."}]}],"style":"note","type":"aside"}]}],"sections":[],"abstract":[{"type":"text","text":"Returns the longest possible subsequences of the sequence, in order,"},{"type":"text","text":" "},{"type":"text","text":"around elements equal to the given element."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/collectiondifference\/split(separator:maxsplits:omittingemptysubsequences:)-897oj"]}],"references":{"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"url":"\/documentation\/swift","abstract":[{"text":"Browse the essential types provided by Swift’s standard library.","type":"text"}],"type":"topic","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/ArraySlice":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice","role":"symbol","url":"\/documentation\/swift\/arrayslice","title":"ArraySlice","type":"topic","ki