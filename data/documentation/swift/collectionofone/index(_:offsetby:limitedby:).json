,"type":"text"},{"text":"value, so it succeeds.","type":"text"}]},{"type":"codeListing","code":["let numbers = [10, 20, 30, 40, 50]","let i = numbers.index(numbers.startIndex, offsetBy: 4)","print(numbers[i])","\/\/ Prints \"50\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The next example attempts to retrieve an index ten positions from"},{"type":"text","text":" "},{"type":"codeVoice","code":"numbers.startIndex"},{"type":"text","text":", but fails, because that distance is beyond the"},{"type":"text","text":" "},{"type":"text","text":"index passed as "},{"type":"codeVoice","code":"limit"},{"type":"text","text":"."}]},{"code":["let j = numbers.index(numbers.startIndex,","                      offsetBy: 10,","                      limitedBy: numbers.endIndex)","print(j)","\/\/ Prints \"nil\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The value passed as "},{"code":"distance","type":"codeVoice"},{"type":"text","text":" must not offset "},{"code":"i","type":"codeVoice"},{"type":"text","text":" beyond the bounds of"},{"type":"text","text":" "},{"type":"text","text":"the collection, unless the index passed as "},{"code":"limit","type":"codeVoice"},{"type":"text","text":" prevents offsetting"},{"type":"text","text":" "},{"type":"text","text":"beyond those bounds."}]},{"name":"Complexity","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1)"}]}]}]}],"references":{"doc://com.apple.Swift/documentation/Swift/CollectionOfOne":{"abstract":[{"text":"A collection containing a single element.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"CollectionOfOne","kind":"identifier"}],"url":"\/documentation\/swift\/collectionofone","title":"CollectionOfOne","type":"topic","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CollectionOfOne","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"