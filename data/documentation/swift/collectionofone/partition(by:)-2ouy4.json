rsion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"belongsInSecondPartition","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"Element","preciseIdentifier":"s:SM7ElementQa","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MutableCollection\/Element"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Index","preciseIdentifier":"s:SM5IndexQa","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MutableCollection\/Index"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"belongsInSecondPartition","content":[{"type":"paragraph","inlineContent":[{"text":"A predicate used to partition","type":"text"},{"text":" ","type":"text"},{"text":"the collection. All elements satisfying this predicate are ordered","type":"text"},{"text":" ","type":"text"},{"text":"after all elements not satisfying it.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"inlineContent":[{"text":"The index of the first element in the reordered collection","type":"text"},{"text":" ","type":"text"},{"text":"that matches ","type":"text"},{"code":"belongsInSecondPartition","type":"codeVoice"},{"text":". If no elements in the","type":"text"},{"text":" ","type":"text"},{"text":"collection match ","type":"text"},{"code":"belongsInSecondPartition","type":"codeVoice"},{"text":", the returned index is","type":"text"},{"text":" ","type":"text"},{"text":"equal to the collection’s ","type":"text"},{"code":"endIndex","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"After partitioning a collection, there is a pivot index ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" where","type":"text"},{"text":" ","type":"text"},{"text":"no element before ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" satisfies the ","type":"text"},{"code":"belongsInSecondPartition","type":"codeVoice"},{"text":" ","type":"text"},{"text":"predicate and every element at or after ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" satisfies","type":"text"},{"text":" ","type":"text"},{"code":"belongsInSecondPartition","type":"codeVoice"},{"text":". This operation isn’t guaranteed to be","type":"text"},{"type":"text","text":" "},{"text":"stable, so the relative ordering of elements within the partitions might","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}]},{"inlineContent":[{"text":"In the following example, an array of numbers is partitioned by a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"predicate that matches elements greater than 30."}],"type":"paragraph"},{"code":["var numbers = [30, 40, 20, 30, 30, 60, 10]","let p = numbers.partition(by: { $0 > 30 })","\/\/ p == 5","\/\/ numbers == [30, 10, 20, 30, 30, 60, 40]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"numbers"},{"type":"text","text":" array is now arranged in two partitions. The first"},{"type":"text","text":" "},{"type":"text","text":"partition, "},{"type":"codeVoice","code":"numbers[..<p]"},{"type":"text","text":", is made up of the elements that"},{"text":" ","type":"text"},{"text":"are not greater than 30. The second partition, ","type":"text"},{"type":"codeVoice","code":"numbers[p...]"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is made up of the elements that "},{"inlineContent":[{"type":"text","text":"are"}],"type":"emphasis"},{"type":"text","text":" greater than 30."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let first = numbers[..<p]","\/\/ first == [30, 10, 20, 30, 30]","let second = numbers[p...]","\/\/ second == [60, 40]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that the order of elements in both partitions changed."},{"text":" ","type":"text"},{"text":"That is, ","type":"text"},{"type":"codeVoice","code":"40"},{"type":"text","text":" appears before "},{"type":"codeVoice","code":"60"},{"type":"text","text":" in the original collection,"},{"type":"text","text":" "},{"type":"text","text":"but, after calling "},{"type":"codeVoice","code":"partition(by:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"60"},{"type":"text","text":" appears before "},{"type":"codeVoice","code":"40"},{"type":"text","text":"."}]},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":"), where ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" is the length of the collection."}]}],"style":"note","type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/collectionofone\/partition(by:)-2ouy4"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CollectionOfOne\/partition(by:)-2ouy4","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift/MutableCollection/Index":{"url":"\/documentation\/swift\/mutablecollection\/index","title":"Index","identifier":"doc:\/\/com.apple