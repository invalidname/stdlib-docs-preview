"Discussion"},{"inlineContent":[{"text":"You can reverse a collection without allocating new space for its","type":"text"},{"text":" ","type":"text"},{"text":"elements by calling this ","type":"text"},{"code":"reversed()","type":"codeVoice"},{"text":" method. A ","type":"text"},{"code":"ReversedCollection","type":"codeVoice"},{"text":" ","type":"text"},{"text":"instance wraps an underlying collection and provides access to its","type":"text"},{"text":" ","type":"text"},{"text":"elements in reverse order. This example prints the characters of a","type":"text"},{"text":" ","type":"text"},{"text":"string in reverse order:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let word = \"Backwards\"","for char in word.reversed() {","    print(char, terminator: \"\")","}","\/\/ Prints \"sdrawkcaB\""],"type":"codeListing"},{"inlineContent":[{"text":"If you need a reversed collection of the same type, you may be able to","type":"text"},{"text":" ","type":"text"},{"text":"use the collection’s sequence-based or collection-based initializer. For","type":"text"},{"text":" ","type":"text"},{"text":"example, to get the reversed version of a string, reverse its","type":"text"},{"text":" ","type":"text"},{"text":"characters and initialize a new ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" instance from the result.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let reversedWord = String(word.reversed())","print(reversedWord)","\/\/ Prints \"sdrawkcaB\""],"type":"codeListing"},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"text":"O(1)","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Returns a view presenting the elements of the collection in reverse"},{"type":"text","text":" "},{"type":"text","text":"order."}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/docume