{"variants":[{"paths":["\/documentation\/swift\/contiguousarray\/capacity"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/capacity"},"metadata":{"platforms":[{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"8.0","name":"iOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"8.0","name":"iPadOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"13.0","name":"Mac Catalyst"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"10.10","name":"macOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"9.0","name":"tvOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"1.0","name":"visionOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"2.0","name":"watchOS"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"capacity","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"roleHeading":"Instance Property","extendedModule":"Swift","symbolKind":"property","title":"capacity","externalID":"s:s15ContiguousArrayV8capacitySivp","role":"symbol","modules":[{"name":"Swift"}]},"kind":"symbol","abstract":[{"type":"text","text":"The total number of elements that the array can contain without"},{"type":"text","text":" "},{"type":"text","text":"allocating new storage."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"capacity"},{"kind":"text","text":": "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Every array reserves a specific amount of memory to hold its contents.","type":"text"},{"text":" ","type":"text"},{"text":"When you add elements to an array and that array begins to exceed its","type":"text"},{"text":" ","type":"text"},{"text":"reserved capacity, the array allocates a larger region of memory and","type":"text"},{"text":" ","type":"text"},{"text":"copies its elements into the new storage. The new storage is a multiple","type":"text"},{"text":" ","type":"text"},{"text":"of the old storage’s size. This exponential growth strategy means that","type":"text"},{"text":" ","type":"text"},{"text":"appending an element happens in constant time, averaging the performance","type":"text"},{"text":" ","type":"text"},{"text":"of many append operations. Append operations that trigger reallocation","type":"text"},{"text":" ","type":"text"},{"text":"have a performance cost, but they occur less and less often as the array","type":"text"},{"text":" ","type":"text"},{"text":"grows larger.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example creates an array of integers from an array literal,","type":"text"},{"text":" ","type":"text"},{"text":"then appends the elements of another collection. Before appending, the","type":"text"},{"text":" ","type":"text"},{"text":"array allocates new storage that is large enough store the resulting","type":"text"},{"text":" ","type":"text"},{"text":"elements.","type":"text"}]},{"type":"codeListing","code":["var numbers = [10, 20, 30, 40, 50]","\/\/ numbers.count == 5","\/\/ numbers.capacity == 5","","numbers.append(contentsOf: stride(from: 60, through: 100, by: 10))","\/\/ numbers.count == 10","\/\/ numbers.capacity == 10"],"syntax":"swift"}],"kind":"content"