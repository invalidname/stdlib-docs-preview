{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/contiguousarray\/capacity"]}],"kind":"symbol","abstract":[{"type":"text","text":"The total number of elements that the array can contain without"},{"type":"text","text":" "},{"type":"text","text":"allocating new storage."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"capacity"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Every array reserves a specific amount of memory to hold its contents.","type":"text"},{"text":" ","type":"text"},{"text":"When you add elements to an array and that array begins to exceed its","type":"text"},{"text":" ","type":"text"},{"text":"reserved capacity, the array allocates a larger region of memory and","type":"text"},{"text":" ","type":"text"},{"text":"copies its elements into the new storage. The new storage is a multiple","type":"text"},{"text":" ","type":"text"},{"text":"of the old storage’s size. This exponential growth strategy means that","type":"text"},{"text":" ","type":"text"},{"text":"appending an element happens in constant time, averaging the performance","type":"text"},{"text":" ","type":"text"},{"text":"of many append operations. Append operations that trigger reallocation","type":"text"},{"text":" ","type":"text"},{"text":"have a performance cost, but they occur less and less often as the array","type":"text"},{"text":" ","type":"text"},{"text":"grows larger.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example creates an array of integers from an array literal,"},{"type":"text","text":" "},{"type":"text","text":"then appends the elements of another collection. Before appending, the"},{"type":"text","text":" "},{"type":"text","text":"array allocates new storage that is large enough store the resulting"},{"type":"text","text":" "},{"type":"text","text":"elements."}]},{"code":["var numbers = [10, 20, 30, 40, 50]","\/\/ numbers.count == 5","\/\/ numbers.capacity == 5","","numbers.append(contentsOf: stride(from: 60, through: 100, by: 10))","\/\/ numbers.count == 10","\/\/ numbers.capacity == 10"],"type":"codeListing","syntax":"swift"}]}],"metadata":{"platforms":[{"deprecated":false,"unavailable":false,"introducedAt":"8.0","beta":false,"name":"iOS"},{"beta":false,"deprecated":false,"unavailable":false,"name":"iPadOS","introducedAt":"8.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"Mac Catalyst","introducedAt":"13.0"},{"deprecated":false,"unavailable":false,"introducedAt":"10.10","beta":false,"name":"macOS"},{"beta":false,"deprecated":false,"unavailable":false,"name":"tvOS","introducedAt":"9.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"watchOS","introducedAt":"2.0"}],"externalID":"s:s15ContiguousArrayV8capacitySivp","role":"symbol","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"capacity","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"title":"capacity","modules":[{"name":"Swift"}],"extendedModule":"Swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation