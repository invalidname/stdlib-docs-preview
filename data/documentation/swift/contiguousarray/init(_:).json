{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"]]},"abstract":[{"type":"text","text":"Creates an array containing the elements of a sequence."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"S"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"s","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier","preciseIdentifier":"s:s15ContiguousArrayVyAByxGqd__c7ElementQyd__RszSTRd__lufc1SL_qd__mfp"},{"kind":"text","text":") "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"text":"Element","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"kind":"typeIdentifier","text":"S"},{"text":".","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence\/Element","text":"Element","preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence","text":"Sequence","preciseIdentifier":"s:ST"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The sequence of elements to turn into an array."}]}],"name":"s"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"You can use this initializer to create an array from any other type that","type":"text"},{"text":" ","type":"text"},{"text":"conforms to the ","type":"text"},{"type":"codeVoice","code":"Sequence"},{"text":" protocol. For example, you might want to","type":"text"},{"text":" ","type":"text"},{"text":"create an array with the integers from 1 through 7. Use this initializer","type":"text"},{"text":" ","type":"text"},{"text":"around a range instead of typing all those numbers in an array literal.","type":"text"}],"type":"paragraph"},{"code":["let numbers = Array(1...7)","print(numbers)","\/\/ Prints \"[1, 2, 3, 4, 5, 6, 7]\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"You can also use this initializer to convert a complex sequence or","type":"text"},{"text":" ","type":"text"},{"text":"collection type back to an array. For example, the ","type":"text"},{"type":"codeVoice","code":"keys"},{"text":" property of","type":"text"},{"text":" ","type":"text"},{"text":"a dictionary isn’t an array with its own storage, it’s a collection","type":"text"},{"text":" ","type":"text"},{"text":"that maps its elements from the dictionary only when they’re","type":"text"},{"text":" ","type":"text"},{"text":"accessed, saving the time and space needed to allocate an array. If","type":"text"},{"text":" ","type":"text"},{"text":"you need to pass those keys to a method that takes an array, however,","type":"text"},{"text":" ","type":"text"},{"text":"use this initializer to convert that list from its type of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LazyMapCollection<Dictionary<String, Int>, Int>"},{"text":" to a simple","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"[String]"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["func cacheImagesWithNames(names: [String]) {","    \/\/ custom image loading and caching"," }","","let namedHues: [String: Int] = [\"Vermillion\": 18, \"Magenta\": 302,","        \"Gold\": 50, \"Cerise\": 320]","let colorNames = Array(namedHues.keys)","cacheImagesWithNames(colorNames)","","print(colorNames)","\/\/ Prints \"[\"Gold\", \"Cerise\", \"Magenta\", \"Vermillion\"]\""],"type":"codeListing","syntax":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/ini