ck to an array. For example, the ","type":"text"},{"code":"keys","type":"codeVoice"},{"type":"text","text":" property of"},{"text":" ","type":"text"},{"text":"a dictionary isn’t an array with its own storage, it’s a collection","type":"text"},{"text":" ","type":"text"},{"text":"that maps its elements from the dictionary only when they’re","type":"text"},{"type":"text","text":" "},{"type":"text","text":"accessed, saving the time and space needed to allocate an array. If"},{"type":"text","text":" "},{"type":"text","text":"you need to pass those keys to a method that takes an array, however,"},{"type":"text","text":" "},{"text":"use this initializer to convert that list from its type of","type":"text"},{"type":"text","text":" "},{"code":"LazyMapCollection<Dictionary<String, Int>, Int>","type":"codeVoice"},{"type":"text","text":" to a simple"},{"type":"text","text":" "},{"code":"[String]","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["func cacheImagesWithNames(names: [String]) {","    \/\/ custom image loading and caching"," }","","let namedHues: [String: Int] = [\"Vermillion\": 18, \"Magenta\": 302,","        \"Gold\": 50, \"Cerise\": 320]","let colorNames = Array(namedHues.keys)","cacheImagesWithNames(colorNames)","","print(colorNames)","\/\/ Prints \"[\"Gold\", \"Cerise\", \"Magenta\", \"Vermillion\"]\""]}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/Sequence/Element":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence\/Element","kind":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"required":true,"abstract":[{"text":"A type representing the sequence’s elements.","type":"text"}],"title":"Element","url":"\/documentation\/swift\/sequence\/element","role":"symbol"},"doc://com.apple.Swift/documentation/Swift/ContiguousArray/init(_:)":{"kind":"symbol","identifier":"doc:\/\/c