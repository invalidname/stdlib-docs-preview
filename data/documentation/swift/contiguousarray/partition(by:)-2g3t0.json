{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/partition(by:)-2g3t0"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"partition"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":" "},{"kind":"internalParam","text":"belongsInSecondPartition"},{"kind":"text","text":": ("},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MutableCollection\/Element","kind":"typeIdentifier","preciseIdentifier":"s:SM7ElementQa","text":"Element"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") "},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MutableCollection\/Index","preciseIdentifier":"s:SM5IndexQa","text":"Index"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"A predicate used to partition"},{"type":"text","text":" "},{"type":"text","text":"the collection. All elements satisfying this predicate are ordered"},{"type":"text","text":" "},{"type":"text","text":"after all elements not satisfying it."}],"type":"paragraph"}],"name":"belongsInSecondPartition"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The index of the first element in the reordered collection"},{"type":"text","text":" "},{"type":"text","text":"that matches "},{"code":"belongsInSecondPartition","type":"codeVoice"},{"type":"text","text":". If no elements in the"},{"type":"text","text":" "},{"type":"text","text":"collection match "},{"code":"belongsInSecondPartition","type":"codeVoice"},{"type":"text","text":", the returned index is"},{"type":"text","text":" "},{"type":"text","text":"equal to the collection’s "},{"code":"endIndex","type":"codeVoice"},{"type":"text","text":"."}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After partitioning a collection, there is a pivot index "},{"type":"codeVoice","code":"p"},{"type":"text","text":" where"},{"type":"text","text":" "},{"type":"text","text":"no element before "},{"type":"codeVoice","code":"p"},{"type":"text","text":" satisfies the "},{"code":"belongsInSecondPartition","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"predicate and every element at or after "},{"code":"p","type":"codeVoice"},{"type":"text","text":" satisfies"},{"type":"text","text":" "},{"code":"belongsInSecondPartition","type":"codeVoice"},{"type":"text","text":". This operation isn’t guaranteed to be"},{"type":"text","text":" "},{"type":"text","text":"stable, so the relative ordering of elements within the partitions might"},{"type":"text","text":" "},{"type":"text","text":"change."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the following example, an array of numbers is partitioned by a"},{"type":"text","text":" "},{"type":"text","text":"predicate that matches elements greater than 30."}]},{"type":"codeListing","syntax":"swift","code":["var numbers = [30, 40, 20, 30, 30, 60, 10]","let p = numbers.partition(by: { $0 > 30 })","\/\/ p == 5","\/\/ numbers == [30, 10, 20, 30, 30, 60, 40]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"numbers","type":"codeVoice"},{"type":"text","text":" array is now arranged in two partitions. The first"},{"type":"text","text":" "},{"type":"text","text":"partition, "},{"code":"numbers[..<p]","type":"codeVoice"},{"type":"text","text":", is made up of the elements that"},{"type":"text","text":" "},{"type":"text","text":"are not greater than 30. The second partition, "},{"code":"numbers[p...]","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"is made up of the elements that "},{"inlineContent":[{"type":"text","text":"are"}],"type":"emphasis"},{"type":"text","text":" greater than 30."}]},{"syntax":"swift","type":"codeListing","code":["let first = numbers[..<p]","\/\/ first == [30, 10, 20, 30, 30]","let second = numbers[p...]","\/\/ second == [60, 40]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that the order of elements in both partitions changed."},{"type":"text","text":" "},{"type":"text","text":"That is, "},{"type":"codeVoice","code":"40"},{"type":"text","text":" appears before "},{"type":"codeVoice","code":"60"},{"type":"text","text":" in the original collection,"},{"type":"text","text":" "},{"type":"text","text":"but, after calling "},{"type":"codeVoice","code":"partition(by:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"60"},{"type":"text","text":" appears before "},{"type":"codeVoice","code":"40"},{"type":"text","text":"."}]},{"content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" is the length of the collection."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Complexity"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/contiguousarray\/partition(by:)-2g3t0"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"]]},"metadat