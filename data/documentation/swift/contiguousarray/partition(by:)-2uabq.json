es":[{"name":"Swift"}],"title":"partition(by:)","externalID":"s:SMsSKRzrlE9partition2by5IndexSlQzSb7ElementSTQzKXE_tKF::SYNTHESIZED::s:s15ContiguousArrayV","symbolKind":"method","role":"symbol"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/contiguousarray\/partition(by:)-2uabq"]}],"abstract":[{"text":"Reorders the elements of the collection such that all the elements","type":"text"},{"text":" ","type":"text"},{"text":"that match the given predicate are after all the elements that don’t","type":"text"},{"text":" ","type":"text"},{"text":"match.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"partition"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":" "},{"kind":"internalParam","text":"belongsInSecondPartition"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Element","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection\/Element","preciseIdentifier":"s:SK7ElementQa"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Bool","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Index","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection\/Index","preciseIdentifier":"s:SK5IndexQa"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A predicate used to partition"},{"type":"text","text":" "},{"type":"text","text":"the collection. All elements satisfying this predicate are ordered"},{"type":"text","text":" "},{"type":"text","text":"after all elements not satisfying it."}]}],"name":"belongsInSecondPartition"}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The index of the first element in the reordered collection"},{"type":"text","text":" "},{"type":"text","text":"that matches "},{"type":"codeVoice","code":"belongsInSecondPartition"},{"type":"text","text":". If no elements in the"},{"type":"text","text":" "},{"type":"text","text":"collection match "},{"type":"codeVoice","code":"belongsInSecondPartition"},{"type":"text","text":", the returned index is"},{"type":"text","text":" "},{"type":"text","text":"equal to the collection’s "},{"type":"codeVoice","code":"endIndex"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"After partitioning a collection, there is a pivot index ","type":"text"},{"type":"codeVoice","code":"p"},{"text":" where","type":"text"},{"text":" ","type":"text"},{"text":"no element before ","type":"text"},{"type":"codeVoice","code":"p"},{"text":" satisfies the ","type":"text"},{"type":"codeVoice","code":"belongsInSecondPartition"},{"text":" ","type":"text"},{"text":"predicate and every element at or after ","type":"text"},{"type":"codeVoice","code":"p"},{"text":" satisfies","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"belongsInSecondPartition"},{"text":". This operation isn’t guaranteed to be","type":"text"},{"text":" ","type":"text"},{"text":"stable, so the relative ordering of elements within the partitions might","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In the following example, an array of numbers is partitioned by a","type":"text"},{"text":" ","type":"text"},{"text":"predicate that matches elements greater than 30.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var numbers = [30, 40, 20, 30, 30, 60, 10]","let p = numbers.partition(by: { $0 > 30 })","\/\/ p == 5","\/\/ numbers == [30, 10, 20, 30, 30, 60, 40]"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"numbers"},{"text":" array is now arranged in two partitions. The first","type":"text"},{"text":" ","type":"text"},{"text":"partition, ","type":"text"},{"type":"codeVoice","code":"numbers[..<p]"},{"text":", is made up of the elements that","type":"text"},{"text":" ","type":"text"},{"text":"are not greater than 30. The second partition, ","type":"text"},{"type":"codeVoice","code":"numbers[p...]"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"is made up of the elements that ","type":"text"},{"inlineContent":[{"type":"text","text":"are"}],"type":"emphasis"},{"text":" greater than 30.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let first = numbers[..<p]","\/\/ first == [30, 10, 20, 30, 30]","let second = numbers[p...]","\/\/ second == [60, 40]"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Note that the order of elements in both partitions changed."},{"type":"text","text":" "},{"type":"text","text":"That is, "},{"type":"codeVoice","code":"40"},{"type":"text","text":" appears before "},{"type":"codeVoice","code":"60"},{"type":"text","text":" in the original collection,"},{"type":"text","text":" "},{"type":"text","text":"but, after calling "},{"type":"codeVoice","code":"partition(by:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"60"},{"type":"text","text":" appears before "},{"type":"codeVoice","code":"40"},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" is the length of the collection.","type":"text"}]}],"type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/BidirectionalCollection/Element":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection\/Element","kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"kind":"text","text":" "},{"text":"Element","kind":"identifier"}],"required":true,"abstract":[],"title":"Element","url":"\/documentation\/swift\/bidirectionalcollection\/element","role":"symbol"},"doc://com.apple.Swift/documentation/Swift":{"role":"collection","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","type":"topic","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/Bool":{"type":"topic","abstract":[{"text":"A value type whose instances are either ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","kind":"symbol","title":"Bool","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Bool"}],"url":"\/documentation\/swift\/bool","navigatorTitle":[{"kind":"identifier","text":"Bool"}]},"doc://com.apple.Swift/documentation/Swift/ContiguousArray":{"url":"\/documentation\/swift\/contiguousarray","type":"topic","kind":"symbol","title":"ContiguousArray","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"ContiguousArray","kind":"identifier"}],"abstract":[{"text":"A contiguously stored array.","type":"text"}],"navigatorTitle":[{"text":"ContiguousArray","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray","role":