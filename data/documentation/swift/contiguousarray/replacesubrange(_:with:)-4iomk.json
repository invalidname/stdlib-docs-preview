ext","text":"n"}]},{"type":"text","text":" is length of this collection and"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":" is the length of "},{"type":"codeVoice","code":"newElements"},{"type":"text","text":". If the call to this method simply"},{"type":"text","text":" "},{"type":"text","text":"appends the contents of "},{"type":"codeVoice","code":"newElements"},{"type":"text","text":" to the collection, the complexity"},{"type":"text","text":" "},{"type":"text","text":"is O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"m"}]},{"type":"text","text":")."}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/contiguousarray\/replacesubrange(_:with:)-4iomk"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/ContiguousArray":{"title":"ContiguousArray","abstract":[{"type":"text","text":"A contiguously stored array."}],"role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContiguousArray"}],"navigatorTitle":[{"kind":"identifier","text":"ContiguousArray"}],"url":"\/documentation\/swift\/contiguousarray","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"},"doc://com.apple.Swift/documentation/Swift/Collection":{"title":"Collection","abstract":[{"type":"text","text":"A sequence whose elements can be traversed multiple times,"},{"type":"text","text":" "},{"type":"text","text":"nondestructively, and accessed by an indexed subscript."}],"role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Collection"}],"navigatorTitle":[{"kind":"identifier","text":"Collection"}],"url":"\/documentation\/swift\/collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection"},"doc://com.a