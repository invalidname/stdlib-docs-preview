{"abstract":[{"text":"Reserves enough space to store the specified number of elements.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reserveCapacity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"minimumCapacity","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"minimumCapacity","content":[{"inlineContent":[{"type":"text","text":"The requested number of elements to store."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"If you are adding a known number of elements to an array, use this method"},{"text":" ","type":"text"},{"type":"text","text":"to avoid multiple reallocations. This method ensures that the array has"},{"type":"text","text":" "},{"type":"text","text":"unique, mutable, contiguous storage, with space allocated for at least"},{"type":"text","text":" "},{"text":"the requested number of elements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For performance reasons, the size of the newly allocated storage might be"},{"type":"text","text":" "},{"type":"text","text":"greater than the requested capacity. Use the array’s "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" property"},{"type":"text","text":" "},{"type":"text","text":"to determine the size of the new storage."}],"type":"paragraph"},{"text":"Preserving an Array’s Geometric Growth Strategy","level":1,"type":"heading","anchor":"Preserving-an-Arrays-Geometric-Growth-Strategy"},{"inlineContent":[{"text":"If you implement a custom data structure backed by an array that grows","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"dynamically, naively calling the "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" method can lead"},{"type":"text","text":" "},{"text":"to worse than expected performance. Arrays need to follow a geometric","type":"text"},{"text":" ","type":"text"},{"text":"allocation pattern for appending elements to achieve amortized","type":"text"},{"text":" ","type":"text"},{"text":"constant-time performance. The ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" type’s ","type":"text"},{"type":"codeVoice","code":"append(_:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"append(contentsOf:)","type":"codeVoice"},{"text":" methods take care of this detail for you, but","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" allocates only as much space as you tell it to"},{"type":"text","text":" "},{"type":"text","text":"(padded to a round value), and no more. This avoids over-allocation, but"},{"type":"text","text":" "},{"type":"text","text":"can result in insertion not having amortized constant-time performance."}],"type":"paragraph"},{"inlineContent":[{"text":"The following code declares ","type":"text"},{"code":"values","type":"codeVoice"},{"text":", an array of integers, and the","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"addTenQuadratic()"},{"type":"text","text":" function, which adds ten more values to the "},{"code":"values","type":"codeVoice"},{"text":" ","type":"text"},{"text":"array on each call.","type":"text"}],"type":"paragraph"},{"code":["  var values: [Int] = [0, 1, 2, 3]","","  \/\/ Don't use 'reserveCapacity(_:)' like this","  func addTenQuadratic() {","      let newCount = values.count + 10","      values.reserveCapacity(newCount)","      for n in values.count..<newCount {","          values.append(n)","      }","  }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The call to ","type":"text"},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" increases the "},{"type":"codeVoice","code":"values"},{"type":"text","text":" array’s capacity"},{"type":"text","text":" "},{"type":"text","text":"by exactly 10 elements on each pass through "},{"type":"codeVoice","code":"addTenQuadratic()"},{"type":"text","text":", which"},{"text":" ","type":"text"},{"type":"text","text":"is linear growth. Instead of having constant time when averaged over"},{"type":"text","text":" "},{"type":"text","text":"many calls, the function may decay to performance that is linear in"},{"type":"text","text":" "},{"code":"values.count","type":"codeVoice"},{"text":". This is almost certainly not what you want.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In cases like this, the simplest fix is often to simply remove the call","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":", and let the "},{"type":"codeVoice","code":"append(_:)"},{"type":"text","text":" method grow the array"},{"text":" ","type":"text"},{"text":"for you.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["  func addTen() {","      let newCount = values.count + 10","      for n in values.count..<newCount {","          values.append(n)","      }","  }"]},{"inlineContent":[{"text":"If you need more control over the capacity of your array, implement your","type":"text"},{"text":" ","type":"text"},{"text":"own geometric growth strategy, passing the size you compute to","type":"text"},{"type":"text","text":" "},{"code":"reserveCapacity(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Complexity","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is the number of elements in the array.","type":"text"}],"type":"paragraph"}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"reserveCapacity"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"symbolKind":"method","platforms":[{"introducedAt":"8.0","beta":false,"deprecated":false,"name":"iOS","unavailable":false},{"introducedAt":"8.0","beta":false,"deprecated":false,"name":"iPadOS","unavailable":false},{"introducedAt":"13.0","beta":false,"deprecated":false,"name":"Mac Catalyst","unavailable":false},{"introducedAt":"10.10","beta":false,"deprecated":false,"name":"macOS","unavailable":false},{"introducedAt":"9.0","beta":false,"deprecated":false,"name":"tvOS","unavailable":false},{"introducedAt":"1.0","beta":false,"deprecated":false,"name":"visionOS","unavailable":false},{"introducedAt":"2.0","beta":false,"deprecated":false,"name":"watchOS","unavailable":false}],"title":"reserveCapacity(_:)","extendedModule":"Swift","externalID":"s:s15ContiguousArrayV15reserveCapacityyySiF","roleHeading":"Instance Method","modules":[{"name":"Standard Library"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"]]},"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/reserveCapacity(_:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/contiguousarray\/reservecapacity(_:)"]}],"references":{"doc://com.apple.Swift/documentation/Swift/ContiguousArray":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContiguousArray"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray","url":"\/documentation\/swift\/contiguousarray","abstract":[{"text":"A contiguously stored array.","type":"text"}],"title":"ContiguousArray","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ContiguousArray"}],"role":"symbol"},"doc://com.apple.Swift/documentation/Swift/ContiguousArray/reserveCapacity(_:)":{"type":"topic","title":"reserveCapacity(_:)","url":"\/documentation\/swift\/contiguousarray\/reservecapacity(_:)","kind":"symbol","abstract":[{"type":"text","text":"Reserves enough space to store the specified number of elements."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reserveCapacity"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/reserveCapacity(_:)"},"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","url":"\/documentation\/swift","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"title":"Standard Library","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"role":"collection"},"doc://com.apple.Swift/documentation/Swift/Int":{"url":"\/documentation\/swift\/int","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Int","kind":"identifier"}],"title":"Int","navigatorTitle":[{"kind":"identifier","text":"Int"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","role":"symbol","abstract":[{"type":"text","text":"A signed integer value type."}],"kind":"symbol","type":"topic"}}}