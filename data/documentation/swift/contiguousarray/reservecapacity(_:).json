{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/reserveCapacity(_:)"},"kind":"symbol","abstract":[{"text":"Reserves enough space to store the specified number of elements.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reserveCapacity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"minimumCapacity","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int"},{"text":")","kind":"text"}],"languages":["swift"]}]},{"parameters":[{"name":"minimumCapacity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The requested number of elements to store."}]}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"If you are adding a known number of elements to an array, use this method","type":"text"},{"text":" ","type":"text"},{"text":"to avoid multiple reallocations. This method ensures that the array has","type":"text"},{"text":" ","type":"text"},{"text":"unique, mutable, contiguous storage, with space allocated for at least","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the requested number of elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For performance reasons, the size of the newly allocated storage might be"},{"type":"text","text":" "},{"type":"text","text":"greater than the requested capacity. Use the array’s "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" property"},{"type":"text","text":" "},{"type":"text","text":"to determine the size of the new storage."}]},{"level":1,"text":"Preserving an Array’s Geometric Growth Strategy","type":"heading","anchor":"Preserving-an-Arrays-Geometric-Growth-Strategy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you implement a custom data structure backed by an array that grows"},{"type":"text","text":" "},{"type":"text","text":"dynamically, naively calling the "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" method can lead"},{"type":"text","text":" "},{"type":"text","text":"to worse than expected performance. Arrays need to follow a geometric"},{"type":"text","text":" "},{"type":"text","text":"allocation pattern for appending elements to achieve amortized"},{"text":" ","type":"text"},{"text":"constant-time performance. The ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" type’s ","type":"text"},{"type":"codeVoice","code":"append(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"append(contentsOf:)"},{"type":"text","text":" methods take care of this detail for you, but"},{"type":"text","text":" "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" allocates only as much space as you tell it to"},{"type":"text","text":" "},{"type":"text","text":"(padded to a round value), and no more. This avoids over-allocation, but"},{"type":"text","text":" "},{"type":"text","text":"can result in insertion not having amortized constant-time performance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following code declares "},{"type":"codeVoice","code":"values"},{"type":"text","text":", an array of integers, and the"},{"type":"text","text":" "},{"type":"codeVoice","code":"addTenQuadratic()"},{"type":"text","text":" function, which adds ten more values to the "},{"type":"codeVoice","code":"values"},{"type":"text","text":" "},{"type":"text","text":"array on each call."}]},{"code":["  var values: [Int] = [0, 1, 2, 3]","","  \/\/ Don't use 'reserveCapacity(_:)' like this","  func addTenQuadratic() {","      let newCount = values.count + 10","      values.reserveCapacity(newCount)","      for n in values.count..<newCount {","          values.append(n)","      }","  }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The call to "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" increases the "},{"type":"codeVoice","code":"values"},{"type":"text","text":" array’s capacity"},{"type":"text","text":" "},{"type":"text","text":"by exactly 10 elements on each pass through "},{"code":"addTenQuadratic()","type":"codeVoice"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"is linear growth. Instead of having constant time when averaged over","type":"text"},{"text":" ","type":"text"},{"text":"many calls, the function may decay to performance that is linear in","type":"text"},{"text":" ","type":"text"},{"code":"values.count","type":"codeVoice"},{"type":"text","text":". This is almost certainly not what you want."}]},{"inlineContent":[{"text":"In cases like this, the simplest fix is often to simply remove the call","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"text":", and let the ","type":"text"},{"type":"codeVoice","code":"append(_:)"},{"text":" method grow the array","type":"text"},{"text":" ","type":"text"},{"text":"for you.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["  func addTen() {","      let newCount = values.count + 10","      for n in values.count..<newCount {","          values.append(n)","      }","  }"],"type":"codeListing"},{"inlineContent":[{"text":"If you need more control over the capacity of your array, implement your","type":"text"},{"text":" ","type":"text"},{"text":"own geometric growth strategy, passing the size you compute to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":"), where ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" is the number of elements in the array.","type":"text"}]}],"style":"note","name":"Complexity","type":"aside"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/contiguousarray\/reservecapacity(_:)"]}],"metadata":{"roleHeading":"Instance Method","platforms":[{"introducedAt":"8.0","deprecated":false,"beta":false,"name":"iOS","unavailable":false},{"introducedAt":"8.0","beta":false,"name":"iPadOS","deprecated":false,"unavailable":false},{"introducedAt":"13.0","beta":false,"name":"Mac Catalyst","deprecated":false,"unavailable":false},{"introducedAt":"10.10","beta":false,"name":"macOS","deprecated":false,"unavailable":false},{"introducedAt":"9.0","beta":false,"name":"tvOS","deprecated":false,"unavailable":false},{"introducedAt":"1.0","beta":false,"name":"visionOS","deprecated":false,"unavailable":false},{"introducedAt":"2.0","beta":false,"name":"watchOS","deprecated":false,"unavailable":false}],"externalID":"s:s15ContiguousArrayV15reserveCapacityyySiF","title":"reserveCapacity(_:)","role":"symbol","modules":[{"name":"Swift"}],"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reserveCapacity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"extendedModule":"Swift"},"references":{"doc://com.apple.Swift/documentation/Swift/ContiguousArray":{"url":"\/documentation\/swift\/contiguousarray","type":"topic","kind":"symbol","title":"ContiguousArray","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"ContiguousArray","kind":"identifier"}],"abstract":[{"text":"A contiguously stored array.","type":"text"}],"navigatorTitle":[{"text":"ContiguousArray","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray","role":"symbol"},"doc://com.apple.Swift/documentation/Swift/ContiguousArray/reserveCapacity(_:)":{"url":"\/documentation\/swift\/contiguousarray\/reservecapacity(_:)","type":"topic","kind":"symbol","title":"reserveCapacity(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reserveCapacity","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"text":"Reserves enough space to store the specified number of elements.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/reserveCapacity(_:)","role":"symbol"},"doc://com.apple.Swift/documentation/Swift":{"role":"collection","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","type":"topic","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/Int":{"role":"symbol","abstract":[{"type":"text","text":"A signed integer value type."}],"url":"\/documentation\/swift\/int","title":"Int","navigatorTitle":[{"text":"Int","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Int","kind":"identifier"}],"kind":"symbol"}}}