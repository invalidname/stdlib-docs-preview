{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/reserveCapacity(_:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/contiguousarray\/reservecapacity(_:)"]}],"metadata":{"roleHeading":"Instance Method","externalID":"s:s15ContiguousArrayV15reserveCapacityyySiF","symbolKind":"method","title":"reserveCapacity(_:)","extendedModule":"Swift","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reserveCapacity"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"modules":[{"name":"Swift"}],"platforms":[{"unavailable":false,"name":"iOS","deprecated":false,"beta":false,"introducedAt":"8.0"},{"unavailable":false,"name":"iPadOS","deprecated":false,"beta":false,"introducedAt":"8.0"},{"unavailable":false,"name":"Mac Catalyst","deprecated":false,"beta":false,"introducedAt":"13.0"},{"unavailable":false,"name":"macOS","deprecated":false,"beta":false,"introducedAt":"10.10"},{"unavailable":false,"name":"tvOS","deprecated":false,"beta":false,"introducedAt":"9.0"},{"unavailable":false,"name":"visionOS","deprecated":false,"beta":false,"introducedAt":"1.0"},{"deprecated":false,"unavailable":false,"introducedAt":"2.0","beta":false,"name":"watchOS"}]},"sections":[],"abstract":[{"type":"text","text":"Reserves enough space to store the specified number of elements."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reserveCapacity"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"minimumCapacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The requested number of elements to store.","type":"text"}]}],"name":"minimumCapacity"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"text":"If you are adding a known number of elements to an array, use this method","type":"text"},{"type":"text","text":" "},{"text":"to avoid multiple reallocations. This method ensures that the array has","type":"text"},{"type":"text","text":" "},{"text":"unique, mutable, contiguous storage, with space allocated for at least","type":"text"},{"text":" ","type":"text"},{"text":"the requested number of elements.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For performance reasons, the size of the newly allocated storage might be","type":"text"},{"type":"text","text":" "},{"text":"greater than the requested capacity. Use the array’s ","type":"text"},{"type":"codeVoice","code":"capacity"},{"text":" property","type":"text"},{"type":"text","text":" "},{"text":"to determine the size of the new storage.","type":"text"}]},{"type":"heading","anchor":"Preserving-an-Arrays-Geometric-Growth-Strategy","level":1,"text":"Preserving an Array’s Geometric Growth Strategy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you implement a custom data structure backed by an array that grows"},{"type":"text","text":" "},{"type":"text","text":"dynamically, naively calling the "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" method can lead"},{"type":"text","text":" "},{"type":"text","text":"to worse than expected performance. Arrays need to follow a geometric"},{"type":"text","text":" "},{"type":"text","text":"allocation pattern for appending elements to achieve amortized"},{"type":"text","text":" "},{"type":"text","text":"constant-time performance. The "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" type’s "},{"type":"codeVoice","code":"append(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"append(contentsOf:)"},{"type":"text","text":" methods take care of this detail for you, but"},{"type":"text","text":" "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" allocates only as much space as you tell it to"},{"type":"text","text":" "},{"type":"text","text":"(padded to a round value), and no more. This avoids over-allocation, but"},{"type":"text","text":" "},{"type":"text","text":"can result in insertion not having amortized constant-time performance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following code declares "},{"type":"codeVoice","code":"values"},{"type":"text","text":", an array of integers, and the"},{"type":"text","text":" "},{"type":"codeVoice","code":"addTenQuadratic()"},{"type":"text","text":" function, which adds ten more values to the "},{"type":"codeVoice","code":"values"},{"type":"text","text":" "},{"type":"text","text":"array on each call."}]},{"syntax":"swift","type":"codeListing","code":["  var values: [Int] = [0, 1, 2, 3]","","  \/\/ Don't use 'reserveCapacity(_:)' like this","  func addTenQuadratic() {","      let newCount = values.count + 10","      values.reserveCapacity(newCount)","      for n in values.count..<newCount {","          values.append(n)","      }","  }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The call to "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":" increases the "},{"type":"codeVoice","code":"values"},{"type":"text","text":" array’s capacity"},{"type":"text","text":" "},{"type":"text","text":"by exactly 10 elements on each pass through "},{"type":"codeVoice","code":"addTenQuadratic()"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"is linear growth. Instead of having constant time when averaged over"},{"type":"text","text":" "},{"type":"text","text":"many calls, the function may decay to performance that is linear in"},{"type":"text","text":" "},{"type":"codeVoice","code":"values.count"},{"type":"text","text":". This is almost certainly not what you want."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In cases like this, the simplest fix is often to simply remove the call"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":", and let the "},{"type":"codeVoice","code":"append(_:)"},{"type":"text","text":" method grow the array"},{"type":"text","text":" "},{"type":"text","text":"for you."}]},{"code":["  func addTen() {","      let newCount = values.count + 10","      for n in values.count..<newCount {","          values.append(n)","      }","  }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need more control over the capacity of your array, implement your"},{"type":"text","text":" "},{"type":"text","text":"own geometric growth strategy, passing the size you compute to"},{"type":"text","text":" "},{"type":"codeVoice","code":"reserveCapacity(_:)"},{"type":"text","text":"."}]},{"style":"note","content":[{"inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":"), where ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" is the number of elements in the array.","type":"text"}],"type":"paragraph"}],"name":"Complexity","type":"aside"}]}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/ContiguousArray/reserveCapacity(_:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/reserveCapacity(_:)","type":"topic","role":"symbol","url":"\/documentation\/swift\/contiguousarray\/reservecapacity(_:)","kind":"symbol","abstract":[{"text":"Reserves enough space to store the specified number of elements.","type":"text"}],"title":"reserveCapacity(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reserveCapacity"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}]},"doc://com.apple.Swift/documentation/Swift/ContiguousArray":{"navigatorTitle":[{"kind":"identifier","text":"ContiguousArray"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray","url":"\/documentation\/swift\/contiguousarray","abstract":[{"type":"text","text":"A contiguously stored array."}],"role":"symbol","title":"ContiguousArray","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContiguousArray"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/Int":{"role":"symbol","title":"Int","url":"\/documentation\/swift\/int","abstract":[{"text":"A signed integer value type.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Int","kind":"identifier"}],"navigatorTitle":[{"text":"Int","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/Swift":{"type":"topic","kind":"symbol","url":"\/documentation\/swift","role":"collection","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}]}}}