xt":" "},{"type":"text","text":"particular value."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This example demonstrates getting a slice of an array of strings, finding"},{"type":"text","text":" "},{"type":"text","text":"the index of one of the strings in the slice, and then using that index"},{"type":"text","text":" "},{"type":"text","text":"in the original array."}],"type":"paragraph"},{"code":["let streets = [\"Adams\", \"Bryant\", \"Channing\", \"Douglas\", \"Evarts\"]","let streetsSlice = streets[2 ..< streets.endIndex]","print(streetsSlice)","\/\/ Prints \"[\"Channing\", \"Douglas\", \"Evarts\"]\"","","let i = streetsSlice.firstIndex(of: \"Evarts\")    \/\/ 4","print(streets[i!])","\/\/ Prints \"Evarts\""],"type":"codeListing","syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/contiguousarray\/subscript(_:)-41wt7"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/subscript(_:)-41wt7","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift/Range":{"type":"topic","kind":"symbol","url":"\/documentation\/swift\/range","role":"symbol","title":"Range","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Range","abstract":[{"text":"A half-open interval from a lower bound up to, but not including, an upper","type":"text"},{"type":"text","text":" "},{"type":"text","text":"bound."}],"navigatorTitle":[{"kind":"identifier","text":"Range"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Range"}]},"doc://com.apple.Swift/documentation/Swift/Int":{"role":"symbol","title":"Int","url":"\/documentation\/swift\/int","abstract":[{"text":"A signed integer value type.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Int","kind":"identifier"}],"navigatorTitle":[