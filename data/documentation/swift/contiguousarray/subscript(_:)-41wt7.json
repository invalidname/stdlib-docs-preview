":"text"},{"text":"particular value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This example demonstrates getting a slice of an array of strings, finding","type":"text"},{"text":" ","type":"text"},{"text":"the index of one of the strings in the slice, and then using that index","type":"text"},{"text":" ","type":"text"},{"text":"in the original array.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let streets = [\"Adams\", \"Bryant\", \"Channing\", \"Douglas\", \"Evarts\"]","let streetsSlice = streets[2 ..< streets.endIndex]","print(streetsSlice)","\/\/ Prints \"[\"Channing\", \"Douglas\", \"Evarts\"]\"","","let i = streetsSlice.firstIndex(of: \"Evarts\")    \/\/ 4","print(streets[i!])","\/\/ Prints \"Evarts\""],"syntax":"swift"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/subscript(_:)-41wt7","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"]]},"references":{"doc://com.apple.Swift/documentation/Swift/ContiguousArray":{"url":"\/documentation\/swift\/contiguousarray","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContiguousArray","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray","title":"ContiguousArray","role":"symbol","navigatorTitle":[{"text":"ContiguousArray","kind":"identifier"}],"abstract":[{"text":"A contiguously stored array.","type":"text"}],"type":"topic"},"doc://com.apple.Swift/documentation/Swift/ContiguousArray/subscript(_:)-41wt7":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/subscript(_:)-41wt7","role":"symbol","url":"\/documentation\/swift\/contiguousarray\/subscript(_:)-41wt7","title":"subscript(_:)","type":"topic","kind":"symbol","fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIden