ype":"paragraph","inlineContent":[{"type":"text","text":"Often, the optimizer can eliminate bounds checks within an array"},{"type":"text","text":" "},{"type":"text","text":"algorithm, but when that fails, invoking the same algorithm on the"},{"type":"text","text":" "},{"type":"text","text":"buffer pointer passed into your closure lets you trade safety for speed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows how you can iterate over the contents of the"},{"type":"text","text":" "},{"type":"text","text":"buffer pointer:"}]},{"type":"codeListing","syntax":"swift","code":["let numbers = [1, 2, 3, 4, 5]","let sum = numbers.withUnsafeBufferPointer { buffer -> Int in","    var result = 0","    for i in stride(from: buffer.startIndex, to: buffer.endIndex, by: 2) {","        result += buffer[i]","    }","    return result","}","\/\/ 'sum' == 9"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pointer passed as an argument to "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is valid only during the"},{"type":"text","text":" "},{"type":"text","text":"execution of "},{"type":"codeVoice","code":"withUnsafeBufferPointer(_:)"},{"type":"text","text":". Do not store or return the"},{"type":"text","text":" "},{"type":"text","text":"pointer for later use."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/withUnsafeBufferPointer(_:)"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray"]]},"references":{"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"url":"\/documentation\/swift","abstract":[{"text":"Browse the essential types provided by Swift’s standard library.","type":"text"}],"type":"topic",