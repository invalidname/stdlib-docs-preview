],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Often, the optimizer can eliminate bounds checks within an array"},{"type":"text","text":" "},{"type":"text","text":"algorithm, but when that fails, invoking the same algorithm on the"},{"type":"text","text":" "},{"type":"text","text":"buffer pointer passed into your closure lets you trade safety for speed."}],"type":"paragraph"},{"inlineContent":[{"text":"The following example shows how you can iterate over the contents of the","type":"text"},{"text":" ","type":"text"},{"text":"buffer pointer:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let numbers = [1, 2, 3, 4, 5]","let sum = numbers.withUnsafeBufferPointer { buffer -> Int in","    var result = 0","    for i in stride(from: buffer.startIndex, to: buffer.endIndex, by: 2) {","        result += buffer[i]","    }","    return result","}","\/\/ 'sum' == 9"]},{"inlineContent":[{"type":"text","text":"The pointer passed as an argument to "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is valid only during the"},{"type":"text","text":" "},{"type":"text","text":"execution of "},{"type":"codeVoice","code":"withUnsafeBufferPointer(_:)"},{"type":"text","text":". Do not store or return the"},{"type":"text","text":" "},{"type":"text","text":"pointer for later use."}],"type":"paragraph"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Error":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","type":"topic","url":"\/documentation\/swift\/error","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Error","kind":"identifier"}],"navigatorTitle":[{"text":"Error","kind":"identifier"}],"title":"Error","abstract":[{"type":"text","text":"A type representing an error value that can be thrown."}]},"doc://com.apple.Swift/documentat