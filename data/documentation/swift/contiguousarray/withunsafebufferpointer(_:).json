","type":"text"},{"text":" ","type":"text"},{"text":"buffer pointer passed into your closure lets you trade safety for speed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example shows how you can iterate over the contents of the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"buffer pointer:"}],"type":"paragraph"},{"code":["let numbers = [1, 2, 3, 4, 5]","let sum = numbers.withUnsafeBufferPointer { buffer -> Int in","    var result = 0","    for i in stride(from: buffer.startIndex, to: buffer.endIndex, by: 2) {","        result += buffer[i]","    }","    return result","}","\/\/ 'sum' == 9"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The pointer passed as an argument to "},{"code":"body","type":"codeVoice"},{"type":"text","text":" is valid only during the"},{"text":" ","type":"text"},{"text":"execution of ","type":"text"},{"code":"withUnsafeBufferPointer(_:)","type":"codeVoice"},{"type":"text","text":". Do not store or return the"},{"text":" ","type":"text"},{"type":"text","text":"pointer for later use."}],"type":"paragraph"}]}],"metadata":{"symbolKind":"method","platforms":[{"name":"iOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"8.0"},{"name":"iPadOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"8.0"},{"name":"Mac Catalyst","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"13.0"},{"name":"macOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"10.10"},{"name":"tvOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"9.0"},{"name":"visionOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"1.0"},{"name":"watchOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"2.0"}],"externalID":"s:s15ContiguousArrayV23withUnsafeBufferPointeryqd__qd__SRyxGqd_0_YKXEqd_0_YKs5ErrorRd_0_r0_lF","extendedModule":"Swift","fragments":[{"text":"func","kind":"keywo