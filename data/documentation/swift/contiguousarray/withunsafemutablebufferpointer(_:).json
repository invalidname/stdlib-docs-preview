entifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","preciseIdentifier":"s:s5ErrorP"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"A closure with an ","type":"text"},{"code":"UnsafeMutableBufferPointer","type":"codeVoice"},{"text":" ","type":"text"},{"text":"parameter that points to the contiguous storage for the array.","type":"text"},{"text":" ","type":"text"},{"text":"If ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" has a return value, that value is also","type":"text"},{"text":" ","type":"text"},{"text":"used as the return value for the ","type":"text"},{"code":"withUnsafeMutableBufferPointer(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"method. The pointer argument is valid only for the duration of the","type":"text"},{"text":" ","type":"text"},{"text":"method’s execution.","type":"text"}],"type":"paragraph"}],"name":"body"}]},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure parameter."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Often, the optimizer can eliminate bounds checks within an array"},{"type":"text","text":" "},{"type":"text","text":"algorithm, but when that fails, invoking the same algorithm on the"},{"type":"text","text":" "},{"type":"text","text":"buffer pointer passed into your closure lets you trade safety for speed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows how modifying the contents of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"UnsafeMutableBufferPointer"},{"type":"text","text":" argument to "},{"type":"codeVoice","code":"body"},{"type":"text","text":" alters the contents of"},{"type":"text","text":" "},{"type":"text","text":"the array:"}]},{"type":"codeListing","syntax":"swift","code":["var numbers = [1, 2, 3, 4, 5]","numbers.withUnsafeMutableBufferPointer { buffer in","    for i in stride(from: buffer.startIndex, to: buffer.endIndex - 1, by: 2) {","        buffer.swapAt(i, i + 1)","    }","}","print(numbers)","\/\/ Prints \"[2, 1, 4, 3, 5]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pointer passed as an argument to "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is valid only during the"},{"type":"text","text":" "},{"type":"text","text":"execution of "},{"type":"codeVoice","code":"withUnsafeMutableBufferPointer(_:)"},{"type":"text","text":". Do not store or"},{"type":"text","text":" "},{"type":"text","text":"return the pointer for later use."}]},{"type":"aside","content":[{"inlineContent":[{"text":"Do not rely on anything about the array that is the target of","type":"text"},{"text":" ","type":"text"},{"text":"this method during execution of the ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" closure; it might not","type":"text"},{"text":" ","type":"text"},{"text":"appear to have its correct value. Instead, use only the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UnsafeMutableBufferPointer"},{"text":" argument to ","type":"text"},{"type":"codeVoice","code":"body"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Warning","style":"warning"}],"kind":"content"}],"abstract":[{"text":"Calls the given closure with a pointer to the array’s mutable contiguous","type":"text"},{"text":" ","type":"text"},{"text":"storage.","type":"text"}],"metadata":{"roleHeading":"Instance Method","platforms":[{"beta":false,"deprecated":false,"introducedAt":"8.0","name":"iOS","unavailable":false},{"unavailable":false,"name":"iPadOS","deprecated":false,"introducedAt":"8.0","beta":false},{"beta