,"type":"codeVoice"},{"text":" closure parameter.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Often, the optimizer can eliminate bounds checks within an array","type":"text"},{"text":" ","type":"text"},{"text":"algorithm, but when that fails, invoking the same algorithm on the","type":"text"},{"text":" ","type":"text"},{"text":"buffer pointer passed into your closure lets you trade safety for speed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example shows how modifying the contents of the","type":"text"},{"text":" ","type":"text"},{"code":"UnsafeMutableBufferPointer","type":"codeVoice"},{"text":" argument to ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" alters the contents of","type":"text"},{"text":" ","type":"text"},{"text":"the array:","type":"text"}],"type":"paragraph"},{"code":["var numbers = [1, 2, 3, 4, 5]","numbers.withUnsafeMutableBufferPointer { buffer in","    for i in stride(from: buffer.startIndex, to: buffer.endIndex - 1, by: 2) {","        buffer.swapAt(i, i + 1)","    }","}","print(numbers)","\/\/ Prints \"[2, 1, 4, 3, 5]\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The pointer passed as an argument to ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" is valid only during the","type":"text"},{"text":" ","type":"text"},{"text":"execution of ","type":"text"},{"code":"withUnsafeMutableBufferPointer(_:)","type":"codeVoice"},{"text":". Do not store or","type":"text"},{"text":" ","type":"text"},{"text":"return the pointer for later use.","type":"text"}],"type":"paragraph"},{"style":"warning","content":[{"inlineContent":[{"text":"Do not rely on anything about the array that is the target of","type":"text"},{"text":" ","type":"text"},{"text":"this method during execution of the ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" closure; it might not","type":"text"},{"text":" ","type":"text"},{"text":"appear to have its correct value. Instead, use only the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UnsafeMutableBufferPointer"},{"text":" argument to ","type":"text"},{"type":"codeVoice","code":"body"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Warning","type":"aside"}]}],"variants":[{"paths":["\/documentation\/swift\/contiguousarray\/withunsafemutablebufferpointer(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/withUnsafeMutableBufferPointer(_:)"},"sections":[],"references":{"Swift-PageImage-card.png":{"variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png","traits":["2x","dark"]}],"type":"image","alt":"An orange Swift logo on a gradient background.","identifier":"Swift-PageImage-card.png"},"doc://com.apple.Swift/documentation/Swift/ContiguousArray":{"navigatorTitle":[{"kind":"identifier","text":"ContiguousArray"}],"title":"ContiguousArray","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContiguousArray"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray","url":"\/documentation\/swift\/contiguousarray","abstract":[{"text":"A contiguously stored array.","type":"text"}],"role":"symbol"},"doc://com.apple.Swift/documentation/Swift/ContiguousArray/withUnsafeMutableBufferPointer(_:)":{"type":"topic","title":"withUnsafeMutableBufferPointer(_:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/withUnsafeMutableBufferPointer(_:)","url":"\/documentation\/swift\/contiguousarray\/withunsafemutablebufferpointer(_:)","abstract":[{"text":"Calls the given closure with