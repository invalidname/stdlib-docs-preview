s example shows the behavior on a little-endian platform."}]}],"name":"Note","type":"aside"},{"inlineContent":[{"type":"text","text":"The pointer passed as an argument to "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is valid only for the"},{"type":"text","text":" "},{"type":"text","text":"lifetime of the closure. Do not escape it from the closure for later"},{"type":"text","text":" "},{"type":"text","text":"use."}],"type":"paragraph"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not rely on anything about the array that is the target of"},{"type":"text","text":" "},{"text":"this method during execution of the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" closure; it might not","type":"text"},{"text":" ","type":"text"},{"text":"appear to have its correct value. Instead, use only the","type":"text"},{"text":" ","type":"text"},{"code":"UnsafeMutableRawBufferPointer","type":"codeVoice"},{"type":"text","text":" argument to "},{"type":"codeVoice","code":"body"},{"text":".","type":"text"}]}],"name":"Warning","style":"warning"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/contiguousarray\/withunsafemutablebytes(_:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray\/withUnsafeMutableBytes(_:)"},"references":{"doc://com.apple.Swift/documentation/Swift":{"type":"topic","kind":"symbol","url":"\/documentation\/swift","role":"collection","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/UnsafeMutableRawBufferPointer":{"abstract":[{"type":"text","text":"A mutable nonowning collection interface to the bytes in a"},{"type":"text","text":" "},{"type":"text","text":"region of memory."}],"navigatorTitle":[{"kind":"identifier","text":"UnsafeMutableRaw