},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pointer passed as an argument to "},{"type":"codeVoice","code":"body"},{"text":" is valid only for the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"lifetime of the closure. Do not escape it from the closure for later"},{"text":" ","type":"text"},{"text":"use.","type":"text"}]},{"type":"aside","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not rely on anything about the array that is the target of"},{"type":"text","text":" "},{"type":"text","text":"this method during execution of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure; it might not"},{"type":"text","text":" "},{"type":"text","text":"appear to have its correct value. Instead, use only the"},{"type":"text","text":" "},{"type":"codeVoice","code":"UnsafeMutableRawBufferPointer"},{"type":"text","text":" argument to "},{"type":"codeVoice","code":"body"},{"type":"text","text":"."}]}],"style":"warning"}]}],"abstract":[{"text":"Calls the given closure with a pointer to the underlying bytes of the","type":"text"},{"text":" ","type":"text"},{"text":"array’s mutable contiguous storage.","type":"text"}],"metadata":{"platforms":[{"deprecated":false,"name":"iOS","introducedAt":"8.0","unavailable":false,"beta":false},{"beta":false,"deprecated":false,"introducedAt":"8.0","name":"iPadOS","unavailable":false},{"deprecated":false,"name":"Mac Catalyst","introducedAt":"13.0","unavailable":false,"beta":false},{"deprecated":false,"name":"macOS","introducedAt":"10.10","unavailable":false,"beta":false},{"deprecated":false,"name":"tvOS","introducedAt":"9.0","unavailable":false,"beta":false},{"deprecated":false,"name":"visionOS","introducedAt":"1.0","unavailable":false,"beta":false},{"deprecated":false,"name":"watchOS","introducedAt":"2.0","unavailable":false,"beta":false}],"roleHeading":"Instance Method","externalID":"s:s15ContiguousArrayV22withUnsafeMutableBytesyqd__qd__SwKXEKlF"