:", and the other standard library integer types","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Float","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Double","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Bool","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Date","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"NSDate","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NSAttributedString","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NSNumber","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NSRange","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"URL","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"NSURL","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"CGPoint","type":"codeVoice"},{"text":", ","type":"text"},{"code":"CGSize","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"CGRect","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NSColor","type":"codeVoice"},{"text":", ","type":"text"},{"code":"UIColor","type":"codeVoice"},{"text":", ","type":"text"},{"code":"CGColor","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"CIColor","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NSImage","type":"codeVoice"},{"text":", ","type":"text"},{"code":"UIImage","type":"codeVoice"},{"text":", ","type":"text"},{"code":"CGImage","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"CIImage","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NSBezierPath","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"UIBezierPath","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NSView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"UIView","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Playground logging may also be able to support specialized descriptions","type":"text"},{"type":"text","text":" "},{"type":"text","text":"of other types."}]},{"text":"Conforming to the CustomPlaygroundDisplayConvertible Protocol","type":"heading","level":2,"anchor":"Conforming-to-the-CustomPlaygroundDisplayConvertible-Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add "},{"type":"codeVoice","code":"CustomPlaygroundDisplayConvertible"},{"type":"text","text":" conformance to your custom type,"},{"type":"text","text":" "},{"type":"text","text":"implement the "},{"type":"codeVoice","code":"playgroundDescription"},{"type":"text","text":" property. If your implementation"},{"type":"text","text":" "},{"type":"text","text":"returns an instance of one of the types above, that type’s specialized"},{"type":"text","text":" "},{"type":"text","text":"description is used. If you return any other type, a structured description"},{"type":"text","text":" "},{"type":"text","text":"is generated."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your type has value semantics, the "},{"type":"codeVoice","code":"playgroundDescription"},{"type":"text","text":" should be"},{"type":"text","text":" "},{"type":"text","text":"unaffected by subsequent mutations, if possible."}]},{"inlineContent":[{"type":"text","text":"If your type’s "},{"type":"codeVoice","code":"playgroundDescription"},{"text":" returns an instance which itself","type":"text"},{"text":" ","type":"text"},{"text":"conforms to ","type":"text"},{"code":"CustomPlaygroundDisplayConvertible","type":"codeVoice"},{"text":", then that type’s","type":"text"},{"text":" ","type":"text"},{"code":"playgroundDescription","type":"codeVoice"},{"text":" will be used, and so on. To prevent infinite loops,","type":"text"},{"text":" ","type":"text"},{"text":"playground 