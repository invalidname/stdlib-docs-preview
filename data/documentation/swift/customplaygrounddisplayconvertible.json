,"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Playground logging can generate, at a minimum, a structured description","type":"text"},{"text":" ","type":"text"},{"text":"of any type. If you want to provide a custom description of your type to be","type":"text"},{"text":" ","type":"text"},{"text":"logged in place of the default description, conform to the","type":"text"},{"text":" ","type":"text"},{"code":"CustomPlaygroundDisplayConvertible","type":"codeVoice"},{"text":" protocol.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Playground logging generates a richer, more specialized description of core","type":"text"},{"text":" ","type":"text"},{"text":"types. For example, the contents of a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" are logged, as are the","type":"text"},{"text":" ","type":"text"},{"text":"components of an ","type":"text"},{"code":"NSColor","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"UIColor","type":"codeVoice"},{"text":". The current playground logging","type":"text"},{"text":" ","type":"text"},{"text":"implementation logs specialized descriptions of at least the following","type":"text"},{"text":" ","type":"text"},{"text":"types:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSString"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"UInt"},{"type":"text","text":", and the other standard library integer types"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Float"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Double"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bool"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Date"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSDate"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSAttributedString"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSNumber"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSRange"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"URL"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSURL"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CGPoint"},{"type":"text","text":", "},{"type":"codeVoice","code":"CGSize"},{"type":"text","text":", and "},{"type":"codeVoice","code":"CGRect"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSColor"},{"type":"text","text":", "},{"type":"codeVoice","code":"UIColor"},{"type":"text","text":", "},{"type":"codeVoice","code":"CGColor"},{"type":"text","text":", and "},{"type":"codeVoice","code":"CIColor"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSImage"},{"type":"text","text":", "},{"type":"codeVoice","code":"UIImage"},{"type":"text","text":", "},{"type":"codeVoice","code":"CGImage"},{"type":"text","text":", and "},{"type":"codeVoice","code":"CIImage"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSBezierPath"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UIBezierPath"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UIView"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Playground logging may also be able to support specialized descriptions","type":"text"},{"text":" ","type":"text"},{"text":"of other types.","type":"text"}]},{"text":"Conforming to the CustomPlaygroundDisplayConvertible Protocol","anchor":"Conforming-to-the-CustomPlaygroundDisplayConvertible-Protocol","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"To add ","type":"text"},{"code":"CustomPlaygroundDisplayConvertible","type":"codeVoice"},{"text":" conformance to your custom type,","type":"text"},{"text":" ","type":"text"},{"text":"implement the ","type":"text"},{"code":"playgroundDescription","type":"codeVoice"},{"text":" property. If your implementation","type":"text"},{"text":" ","type":"text"},{"text":"returns an instance of one of the types above, that type’s specialized","type":"text"},{"text":" ","type":"text"},{"text":"description is used. If you return any other type, a structured description","type":"text"},{"text":" ","type":"text"},{"text":"is generated.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If your type has value semantics, the ","type":"text"},{"code":"playgroundDescription","type":"codeVoice"},{"text":" should be","type":"text"},{"text":" ","type":"text"},{"text":"unaffected by subsequent mutations, if possible.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If your type’s ","type":"text"},{"code":"playgroundDescription","type":"codeVoice"},{"text":" returns an instance which itself","type":"text"},{"text":" ","type":"text"},{"text":"conforms to ","type":"text"},{"code":"CustomPlaygroundDisplayConvertible","type":"codeVoice"},{"text":", then that type’s","type":"text"},{"text":" ","type":"text"},{"code":"playgroundDescription","type":"codeVoice"},{"text":" will be used, and so on. To prevent infinite loops,","type":"text"},{"text":" ","type":"text"},{"text":"playground logging implementations can place a reasonable limit on this","type":"text"},{"text":" ","type":"text"},{"text":"kind of chaining.","type":"text"}]}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"topicSections":[{"title":"Instance Properties","anchor