{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomPlaygroundDisplayConvertible"},"seeAlsoSections":[{"title":"Customizing Your Type’s Reflection","anchor":"Customizing-Your-Types-Reflection","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomLeafReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/PlaygroundQuickLook","doc:\/\/com.apple.Swift\/documentation\/Swift\/DebugDescription()"],"generated":true}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CustomPlaygroundDisplayConvertible"}],"platforms":["macOS"]}]},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Playground logging can generate, at a minimum, a structured description"},{"type":"text","text":" "},{"type":"text","text":"of any type. If you want to provide a custom description of your type to be"},{"type":"text","text":" "},{"type":"text","text":"logged in place of the default description, conform to the"},{"type":"text","text":" "},{"code":"CustomPlaygroundDisplayConvertible","type":"codeVoice"},{"text":" protocol.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Playground logging generates a richer, more specialized description of core","type":"text"},{"text":" ","type":"text"},{"text":"types. For example, the contents of a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" are logged, as are the","type":"text"},{"text":" ","type":"text"},{"text":"components of an ","type":"text"},{"code":"NSColor","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"UIColor","type":"codeVoice"},{"text":". The current playground logging","type":"text"},{"text":" ","type":"text"},{"text":"implementation logs specialized descriptions of at least the following","type":"text"},{"text":" ","type":"text"},{"text":"types:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSString"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"UInt"},{"type":"text","text":", and the other standard library integer types"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Float"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Double"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bool"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Date"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSDate"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSAttributedString"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSNumber"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSRange"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"URL"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"NSURL"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"CGPoint"},{"text":", ","type":"text"},{"type":"codeVoice","code":"CGSize"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"CGRect"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSColor"},{"text":", ","type":"text"},{"type":"codeVoice","code":"UIColor"},{"text":", ","type":"text"},{"type":"codeVoice","code":"CGColor"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"CIColor"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSImage"},{"text":", ","type":"text"},{"type":"codeVoice","code":"UIImage"},{"text":", ","type":"text"},{"type":"codeVoice","code":"CGImage"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"CIImage"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSBezierPath"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"UIBezierPath"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSView"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"UIView"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Playground logging may also be able to support specialized descriptions","type":"text"},{"text":" ","type":"text"},{"text":"of other types.","type":"text"}]},{"anchor":"Conforming-to-the-CustomPlaygroundDisplayConvertible-Protocol","type":"heading","text":"Conforming to the CustomPlaygroundDisplayConvertible Protocol","level":2},{"type":"paragraph","inlineContent":[{"text":"To add ","type":"text"},{"code":"CustomPlaygroundDisplayConvertible","type":"codeVoice"},{"text":" conformance to your custom type,","type":"text"},{"text":" ","type":"text"},{"text":"implement the ","type":"text"},{"code":"playgroundDescription","type":"codeVoice"},{"text":" property. If your implementation","type":"text"},{"text":" ","type":"text"},{"text":"returns an instance of one of the types above, that type’s specialized","type":"text"},{"text":" ","type":"text"},{"text":"description is used. If you return any other type, a structured description","type":"text"},{"text":" ","type":"text"},{"text":"is generated.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If your type has value semantics, the ","type":"text"},{"code":"playgroundDescription","type":"codeVoice"},{"text":" should be","type":"text"},{"text":" ","type":"text"},{"text":"unaffected by subsequent mutations, if possible.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If your type’