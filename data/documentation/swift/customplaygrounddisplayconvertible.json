{"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"anchor":"Instance-Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomPlaygroundDisplayConvertible\/playgroundDescription"],"generated":true,"title":"Instance Properties"}],"variants":[{"paths":["\/documentation\/swift\/customplaygrounddisplayconvertible"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A type that supplies a custom description for playground logging."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomPlaygroundDisplayConvertible"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CustomPlaygroundDisplayConvertible"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Playground logging can generate, at a minimum, a structured description"},{"type":"text","text":" "},{"type":"text","text":"of any type. If you want to provide a custom description of your type to be"},{"type":"text","text":" "},{"type":"text","text":"logged in place of the default description, conform to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"CustomPlaygroundDisplayConvertible"},{"type":"text","text":" protocol."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Playground logging generates a richer, more specialized description of core"},{"type":"text","text":" "},{"type":"text","text":"types. For example, the contents of a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" are logged, as are the"},{"type":"text","text":" "},{"type":"text","text":"components of an "},{"type":"codeVoice","code":"NSColor"},{"type":"text","text":" or "},{"type":"codeVoice","code":"UIColor"},{"type":"text","text":". The current playground logging"},{"type":"text","text":" "},{"type":"text","text":"implementation logs specialized descriptions of at least the following"},{"type":"text","text":" "},{"type":"text","text":"types:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"String"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSString"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"UInt"},{"type":"text","text":", and the other standard library integer types"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Float"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Double"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Bool"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Date"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSDate"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSAttributedString"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSNumber"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSRange"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"URL"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSURL"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CGPoint"},{"type":"text","text":", "},{"type":"codeVoice","code":"CGSize"},{"type":"text","text":", and "},{"type":"codeVoice","code":"CGRect"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSColor"},{"type":"text","text":", "},{"type":"codeVoice","code":"UIColor"},{"type":"text","text":", "},{"type":"codeVoice","code":"CGColor"},{"type":"text","text":", and "},{"type":"codeVoice","code":"CIColor"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSImage"},{"type":"text","text":", "},{"type":"codeVoice","code":"UIImage"},{"type":"text","text":", "},{"type":"codeVoice","code":"CGImage"},{"type":"text","text":", and "},{"type":"codeVoice","code":"CIImage"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSBezierPath"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UIBezierPath"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UIView"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Playground logging may also be able to support specialized descriptions"},{"text":" ","type":"text"},{"type":"text","text":"of other types."}]},{"text":"Conforming to the CustomPlaygroundDisplayConvertible Protocol","type":"heading","level":2,"anchor":"Conforming-to-the-CustomPlaygroundDisplayConvertible-Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add "},{"type":"codeVoice","code":"CustomPlaygroundDisplayConvertible"},{"type":"text","text":" conformance to your custom type,"},{"type":"text","text":" "},{"type":"text","text":"implement the "},{"type":"codeVoice","code":"playgroundDescription"},{"type":"text","text":" property. If your implementation"},{"type":"text","text":" "},{"type":"text","text":"returns an instance of one of the types above, that type’s specialized"},{"type":"text","text":" "},{"type":"text","text":"description is used. If you return any other type, a structured description"},{"type":"text","text":" "},{"type":"text","text":"is generated."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your type has value semantics, the "},{"type":"codeVoice","code":"playgroundDescription"},{"type":"text","text":" should be"},{"type":"text","text":" "},{"type":"text","text":"unaffected by subsequent mutations, if possible."}]},{"type":"paragraph","inl