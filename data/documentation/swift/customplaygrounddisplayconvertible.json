{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Playground logging can generate, at a minimum, a structured description"},{"type":"text","text":" "},{"type":"text","text":"of any type. If you want to provide a custom description of your type to be"},{"type":"text","text":" "},{"type":"text","text":"logged in place of the default description, conform to the"},{"type":"text","text":" "},{"code":"CustomPlaygroundDisplayConvertible","type":"codeVoice"},{"type":"text","text":" protocol."}]},{"inlineContent":[{"type":"text","text":"Playground logging generates a richer, more specialized description of core"},{"type":"text","text":" "},{"type":"text","text":"types. For example, the contents of a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" are logged, as are the"},{"text":" ","type":"text"},{"text":"components of an ","type":"text"},{"type":"codeVoice","code":"NSColor"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"UIColor"},{"text":". The current playground logging","type":"text"},{"text":" ","type":"text"},{"text":"implementation logs specialized descriptions of at least the following","type":"text"},{"text":" ","type":"text"},{"text":"types:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"NSString"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"UInt"},{"type":"text","text":", and the other standard library integer types"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Float"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Double"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Bool"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Date"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"NSDate"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NSAttributedString"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSNumber"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSRange"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"URL"},{"type":"text","text":" and "},{"code":"NSURL","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"CGPoint","type":"codeVoice"},{"text":", ","type":"text"},{"code":"CGSize","type":"codeVoice"},{"type":"text","text":", and "},{"type":"codeVoice","code":"CGRect"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NSColor","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"UIColor"},{"type":"text","text":", "},{"code":"CGColor","type":"codeVoice"},{"type":"text","text":", and "},{"code":"CIColor","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSImage"},{"type":"text","text":", "},{"type":"codeVoice","code":"UIImage"},{"type":"text","text":", "},{"type":"codeVoice","code":"CGImage"},{"type":"text","text":", and "},{"type":"codeVoice","code":"CIImage"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSBezierPath"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UIBezierPath"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UIView"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Playground logging may also be able to support specialized descriptions"},{"type":"text","text":" "},{"type":"text","text":"of other types."}]},{"level":2,"type":"heading","anchor":"Conforming-to-the-CustomPlaygroundDisplayConvertible-Protocol","text":"Conforming to the CustomPlaygroundDisplayConvertible Protocol"},{"inlineContent":[{"type":"text","text":"To add "},{"type":"codeVoice","code":"CustomPlaygroundDisplayConvertible"},{"type":"text","text":" conformance to your custom type,"},{"type":"text","text":" "},{"text":"implement the ","type":"text"},{"type":"codeVoice","code":"playgroundDescription"},{"text":" property. If your implementation","type":"text"},{"text":" ","type":"text"},{"text":"returns an instance of one of the types above, that type’s specialized","type":"text"},{"text":" ","type":"text"},{"text":"description is used. If you return any other type, a structured description","type":"text"},{"text":" ","type":"text"},{"text":"is generated.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If your type has value semantics, the ","type":"text"},{"type":"codeVoice","code":"playgroundDescription"},{"type":"text","text":" should be"},{"type":"text","text":" "},{"type":"text","text":"unaffected by subsequent mutations, if possible."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your type’s "},{"type":"codeVoice","code":"playgroundDescription"},{"text":" returns an instance which itself","type":"text"},{"type":"text","text":" "},{"type":"text","text":"conforms to "},{"type":"codeVoice","code":"CustomPlaygroundDisplayConvertible"},{"type":"text","text":", then that type’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"playgroundDescription"},{"type":"text","text":" will be used, and so on. To prevent infinite loops,"},{"type":"text","text":" "},{"type":"text","text":"playground logging implementations can place a reasonable limit on this"},{"type":"text","text":" "},{"text":"kind of chaining.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomPlaygroundDisplayConvertible","interfaceL