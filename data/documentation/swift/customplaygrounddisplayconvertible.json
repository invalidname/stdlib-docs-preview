{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomPlaygroundDisplayConvertible","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"topicSections":[{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomPlaygroundDisplayConvertible\/playgroundDescription"],"title":"Instance Properties"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/customplaygrounddisplayconvertible"]}],"seeAlsoSections":[{"generated":true,"anchor":"Customizing-Your-Types-Reflection","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomLeafReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/PlaygroundQuickLook","doc:\/\/com.apple.Swift\/documentation\/Swift\/DebugDescription()"],"title":"Customizing Your Type’s Reflection"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CustomPlaygroundDisplayConvertible"}]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Playground logging can generate, at a minimum, a structured description"},{"type":"text","text":" "},{"type":"text","text":"of any type. If you want to provide a custom description of your type to be"},{"type":"text","text":" "},{"type":"text","text":"logged in place of the default description, conform to the"},{"type":"text","text":" "},{"code":"CustomPlaygroundDisplayConvertible","type":"codeVoice"},{"type":"text","text":" protocol."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Playground logging generates a richer, more specialized description of core"},{"type":"text","text":" "},{"type":"text","text":"types. For example, the contents of a "},{"code":"String","type":"codeVoice"},{"type":"text","text":" are logged, as are the"},{"type":"text","text":" "},{"type":"text","text":"components of an "},{"code":"NSColor","type":"codeVoice"},{"type":"text","text":" or "},{"code":"UIColor","type":"codeVoice"},{"type":"text","text":". The current playground logging"},{"type":"text","text":" "},{"type":"text","text":"implementation logs specialized descriptions of at least the following"},{"type":"text","text":" "},{"type":"text","text":"types:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"String","type":"codeVoice"},{"type":"text","text":" and "},{"code":"NSString","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"UInt","type":"codeVoice"},{"text":", and the other standard library integer types","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Float"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Double"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Bool","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Date","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"NSDate","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NSAttributedString","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NSNumber","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NSRange","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"URL","type":"codeVoice"},{"type":"text","text":" and "},{"code":"NSURL","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"CGPoint","type":"codeVoice"},{"type":"text","text":", "},{"code":"CGSize","type":"codeVoice"},{"type":"text","text":", and "},{"code":"CGRect","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"NSColor","type":"codeVoice"},{"type":"text","text":", "},{"code":"UIColor","type":"codeVoice"},{"type":"text","text":", "},{"code":"CGColor","type":"codeVoice"},{"type":"text","text":", and "},{"code":"CIColor","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NSImage","type":"codeVoice"},{"type":"text","text":", "},{"code":"UIImage","type":"codeVoice"},{"type":"text","text":", "},{"code":"CGImage","type":"codeVoice"},{"type":"text","text":", and "},{"code":"CIImage","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NSBezierPath","type":"codeVoice"},{"type":"text","text":" and "},{"code":"UIBezierPath","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NSView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"UIView","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Playground logging may also be able to support specialized descriptions","type":"text"},{"text":" ","type":"text"},{"text":"of other types.","type":"text"}],"type":"paragraph"},{"text":"Conforming to the CustomPlaygroundDisplayConvertible Protocol","type":"heading","level":2,"anchor":"Conforming-to-the-CustomPlaygroundDisplayConvertible-Protocol"},{"inlineContent":[{"text":"To add ","type":"text"},{"code":"CustomPlaygroundDisplayConvertible","type":"codeVoice"},{"text":" conformance to your custom type,","type":"text"},{"text":" ","type":"text"},{"text":"implement the ","type":"text"},{"code":"playgroundDescription","type":"codeVoice"},{"text":" property. If your implementation","type":"text"},{"text":" ","type":"text"},{"text":"returns an instance of one of the types above, that type’s specialized","type":"text"},{"text":" ","type":"text"},{"text":"description is used. If you return any other type, a structured description","type":"text"},{"text":" ","type":"text"},{"text":"is generated.","type":"text"}],"type":