{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DebugDescription()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"variants":[{"paths":["\/documentation\/swift\/debugdescription()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Converts description definitions to a debugger Type Summary.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(member) "},{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(memberAttribute) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"DebugDescription"},{"kind":"text","text":"()"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This macro converts compatible description implementations written in Swift"},{"type":"text","text":" "},{"type":"text","text":"to an LLDB format known as a Type Summary. A Type Summary is LLDB’s"},{"type":"text","text":" "},{"type":"text","text":"equivalent to "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":", with the distinction that it does not"},{"type":"text","text":" "},{"type":"text","text":"execute code inside the debugged process. By avoiding code execution,"},{"type":"text","text":" "},{"type":"text","text":"descriptions can be produced faster, without potential side effects, and"},{"type":"text","text":" "},{"type":"text","text":"shown in situations where code execution is not performed, such as the"},{"type":"text","text":" "},{"type":"text","text":"variable list of an IDE."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider this an example. This "},{"type":"codeVoice","code":"Team"},{"type":"text","text":" struct has a "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":" which"},{"type":"text","text":" "},{"type":"text","text":"summarizes some key details, such as the team’s name. The debugger only"},{"type":"text","text":" "},{"type":"text","text":"computes this string on demand - typically via the "},{"type":"codeVoice","code":"po"},{"type":"text","text":" command. By applying"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"DebugDescription"},{"type":"text","text":" macro, a matching Type Summary is constructed. This"},{"type":"text","text":" "},{"type":"text","text":"allows the user to show a string like “Rams [11-2]”, without executing"},{"type":"text","text":" "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":". This improves the usability, performance, and"},{"type":"text","text":" "},{"type":"text","text":"reliability of the debugging experience."}]},{"code":["@DebugDescription","struct Team: CustomDebugStringConvertible {","   var name: String","   var wins, losses: Int","","   var debugDescription: String {","       \"\\(name) [\\(wins)-\\(losses)]\"","   }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"code":"DebugDescription","type":"codeVoice"},{"type":"text","text":" macro supports both "},{"code":"debugDescription","type":"codeVoice"},{"text":", ","type":"text"},{"code":"description","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"as well as a third option: a property named ","type":"text"},{"code":"lldbDescription","type":"codeVoice"},{"text":". The first","type":"text"},{"text":" ","type":"text"},{"text":"two are implemented when conforming to the ","type":"text"},{"code":"CustomDebugStringConvertible","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"CustomStringConvertible","type":"codeVoice"},{"text":" protocols. The additional ","type":"text"},{"code":"lldbDescription","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property is useful when both ","type":"text"},{"code":"debugDescription","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"description","type":"codeVoice"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"implemented, but don’t meet the requirements of the "},{"code":"DebugDescription","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"macro. If "},{"code":"lldbDescription","type":"codeVoice"},{"text":" is implemented, ","type":"text"},{"code":"DebugDescription","type":"codeVoice"},{"text":" choose it","type":"text"},{"text":" ","type":"text"},{"text":"over ","type":"text"},{"code":"debugDescription","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"description","type":"codeVoice"},{"text":". Likewise, ","type":"text"},{"code":"debugDescription","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"preferred over ","type":"text"},{"code":"description","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Description Requirements","anchor":"Description-Requirements","type":"heading","level":3},{"inlineContent":[{"text":"The description implementation has the following requirements:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The body of the description implementation must be a single string"},{"type":"text","text":" "},{"type":"text","text":"expression. String concatenation is not supported, use string interpolation"},{"type":"text","text":" "},{"type":"text","text":"instead."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"String interpolation can reference stored properties only, functions calls"},{"type":"text","text":" "},{"type":"text","text":"and other arbitrary computation are not supported. Of note, conditional"},{"type":"text","text":" "},{"type":"text","text":"logic and computed properties are not supported."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Overloaded string interpolation cannot be used."}]}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DebugDescription","kind":"identifier"},{"text":"()","kind":"text"}],"symbolKind":"macro","platforms":[{"name":"iOS","deprecated":false,"introducedAt":"8.0","unavailable":false,"beta":false},{"name":"iPadOS","deprecated":false,"introducedAt":"8.0","unavailable":false,"beta":false},{"name":"Mac Catalyst","deprecated":false,"introducedAt":"13.0","unavailable":false,"beta":false},{"name":"macOS","deprecated":false,"introducedAt":"10.10","unavailable":false,"beta":false},{"name":"tvOS","deprecated":false,"introducedAt":"9.0","unavailable":false,"beta":false},{"name":"visionOS","deprecated":false,"introducedAt":"1.0","unavailable":false,"beta":false},{"name":"watchOS","deprecated":false,"introducedAt":"2.0","unavailable":false,"beta":false}],"roleHeading":"Macro","role":"symbol","modules":[{"name":"Swift"}],"title":"DebugDescription()","externalID":"s:s16DebugDescriptionyycfm"},"kind":"symbol","seeAlsoSections":[{"anchor":"Customizing-Your-Types-Reflection","generated":true,"title":"Customizing Your Type’s Reflection","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomLeafReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomPlaygroundDisplayConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/PlaygroundQuickLook"]}],"references":{"Swift-PageImage-card.png":{"variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png","traits":["2x","dark"]}],"type":"image","identifier":"Swift-PageImage-card.png","alt":"An orange Swift logo on a gradient background."},"doc://com.apple.Swift/documentation/Swift/CustomReflectable":{"navigatorTitle":[{"kind":"identifier","text":"CustomReflectable"}],"url":"\/documentation\/swift\/customreflectable","abstract":[{"type":"text","text":"A type that explicitly supplies its own mirror."}],"kind":"symbol","title":"CustomReflectable","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomReflectable","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/DebugDescription()":{"abstract":[{"type":"text","text":"Converts description definitions to a debugger Type Summary."}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"macro"},{"text":" ","kind":"text"},{"text":"DebugDescription","kind":"identifier"},{"text":"()","kind":"text"}],"url":"\/documentation\/swift\/debugdescription()","title":"DebugDescription()","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DebugDescription()"},"doc://com.apple.Swift/documentation/Swift/CustomLeafReflectable":{"role":"symbol","navigatorTitle":[{"text":"CustomLeafReflectable","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomLeafReflectable","title":"CustomLeafReflectable","url":"\/documentation\/swift\/customleafreflectable","abstract":[{"type":"text","text":"A type that explicitly supplies its own mirror, but whose"},{"type":"text","text":" "},{"type":"text","text":"descendant classes are not represented in the mirror unless they"},{"type":"text","text":" "},{"type":"text","text":"also override "},{"type":"codeVoice","code":"customMirror"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"CustomLeafReflectable","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/CustomPlaygroundDisplayConvertible":{"role":"symbol","navigatorTitle":[{"text":"CustomPlaygroundDisplayConvertible","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomPlaygroundDisplayConvertible","title":"CustomPlaygroundDisplayConvertible","url":"\/documentation\/swift\/customplaygrounddisplayconvertible","abstract":[{"type":"text","text":"A type that supplies a custom description for playground logging."}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"CustomPlaygroundDisplayConvertible","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/PlaygroundQuickLook":{"role":"symbol","navigatorTitle":[{"text":"PlaygroundQuickLook","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/PlaygroundQuickLook","title":"PlaygroundQuickLook","url":"\/documentation\/swift\/playgroundquicklook","abstract":[{"type":"text","text":"The sum of types that can be used as a Quick Look representation."}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"typealias"},{"text":" ","kind":"text"},{"text":"PlaygroundQuickLook","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift":{"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","title":"Swift","url":"\/documentation\/swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"images":[{"identifier":"Swift-PageImage-card.png","type":"card"}],"kind":"symbol","type":"topic"}}}