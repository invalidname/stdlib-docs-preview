{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"abstract":[{"text":"Converts description definitions to a debugger Type Summary.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DebugDescription()"},"seeAlsoSections":[{"generated":true,"title":"Customizing Your Type’s Reflection","anchor":"Customizing-Your-Types-Reflection","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomLeafReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomPlaygroundDisplayConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/PlaygroundQuickLook"]}],"variants":[{"paths":["\/documentation\/swift\/debugdescription()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","roleHeading":"Macro","title":"DebugDescription()","modules":[{"name":"Standard Library"}],"symbolKind":"macro","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"DebugDescription"},{"kind":"text","text":"()"}],"platforms":[{"deprecated":false,"name":"iOS","beta":false,"unavailable":false,"introducedAt":"8.0"},{"deprecated":false,"name":"iPadOS","beta":false,"unavailable":false,"introducedAt":"8.0"},{"deprecated":false,"name":"Mac Catalyst","beta":false,"unavailable":false,"introducedAt":"13.0"},{"deprecated":false,"name":"macOS","beta":false,"unavailable":false,"introducedAt":"10.10"},{"deprecated":false,"name":"tvOS","beta":false,"unavailable":false,"introducedAt":"9.0"},{"deprecated":false,"name":"visionOS","beta":false,"unavailable":false,"introducedAt":"1.0"},{"deprecated":false,"name":"watchOS","beta":false,"unavailable":false,"introducedAt":"2.0"}],"externalID":"s:s16DebugDescriptionyycfm"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(member) ","kind":"text"},{"text":"@attached","kind":"attribute"},{"text":"(memberAttribute) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DebugDescription","kind":"identifier"},{"text":"()","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This macro converts compatible description implementations written in Swift"},{"type":"text","text":" "},{"type":"text","text":"to an LLDB format known as a Type Summary. A Type Summary is LLDB’s"},{"type":"text","text":" "},{"type":"text","text":"equivalent to "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":", with the distinction that it does not"},{"type":"text","text":" "},{"type":"text","text":"execute code inside the debugged process. By avoiding code execution,"},{"type":"text","text":" "},{"type":"text","text":"descriptions can be produced faster, without potential side effects, and"},{"type":"text","text":" "},{"type":"text","text":"shown in situations where code execution is not performed, such as the"},{"type":"text","text":" "},{"type":"text","text":"variable list of an IDE."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider this an example. This "},{"type":"codeVoice","code":"Team"},{"type":"text","text":" struct has a "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":" which"},{"type":"text","text":" "},{"type":"text","text":"summarizes some key details, such as the team’s name. The debugger only"},{"type":"text","text":" "},{"type":"text","text":"computes this string on demand - typically via the "},{"type":"codeVoice","code":"po"},{"type":"text","text":" command. By applying"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"DebugDescription"},{"type":"text","text":" macro, a matching Type Summary is constructed. This"},{"type":"text","text":" "},{"type":"text","text":"allows the user to show a string like “Rams [11-2]”, without executing"},{"text":" ","type":"text"},{"code":"debugDescription","type":"codeVoice"},{"text":". This improves the usability, performance, and","type":"text"},{"text":" ","type":"text"},{"text":"reliability of the debugging experience.","type":"text"}]},{"code":["@DebugDescription","struct Team: CustomDebugStringConvertible {","   var name: String","   var wins, losses: Int","","   var debugDescription: String {","       \"\\(name) [\\(wins)-\\(losses)]\"","   }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DebugDescription"},{"type":"text","text":" macro supports both "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":", "},{"type":"codeVoice","code":"description"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as well as a third option: a property named "},{"type":"codeVoice","code":"lldbDescription"},{"type":"text","text":". The first"},{"type":"text","text":" "},{"type":"text","text":"two are implemented when conforming to the "},{"type":"codeVoice","code":"CustomDebugStringConvertible"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"CustomStringConvertible"},{"text":" protocols. The additional ","type":"text"},{"type":"codeVoice","code":"lldbDescription"},{"type":"text","text":" "},{"text":"property is useful when both ","type":"text"},{"code":"debugDescription","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"description","type":"codeVoice"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"implemented, but don’t meet the requirements of the "},{"type":"codeVoice","code":"DebugDescription"},{"text":" ","type":"text"},{"text":"macro. If ","type":"text"},{"type":"codeVoice","code":"lldbDescription"},{"text":" is implemented, ","type":"text"},{"type":"codeVoice","code":"DebugDescription"},{"text":" choose it","type":"text"},{"text":" ","type":"text"},{"text":"over ","type":"text"},{"code":"debugDescription","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"description"},{"text":". Likewise, ","type":"text"},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"preferred over "},{"type":"codeVoice","code":"description"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Description Requirements","type":"heading","anchor":"Description-Requirements","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The description implementation has the following requirements:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The body of the description implementation must be a single string"},{"type":"text","text":" "},{"type":"text","text":"expression. String concatenation is not supported, use string interpolation"},{"type":"text","text":" "},{"type":"text","text":"instead."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"String interpolation can reference stored properties only, functions calls"},{"type":"text","text":" "},{"type":"text","text":"and other arbitrary computation are not supported. Of note, conditional"},{"type":"text","text":" "},{"type":"text","text":"logic and computed properties are not supported."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Overloaded string interpolation cannot be used.","type":"text"}]}]}]}]}],"references":{"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/PlaygroundQuickLook":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/PlaygroundQuickLook","title":"PlaygroundQuickLook","role":"symbol","abstract":[{"type":"text","text":"The sum of types that can be used as a Quick Look representation."}],"type":"topic","url":"\/documentation\/swift\/playgroundquicklook","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PlaygroundQuickLook"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PlaygroundQuickLook"}]},"doc://com.apple.Swift/documentation/Swift/CustomReflectable":{"abstract":[{"text":"A type that explicitly supplies its own mirror.","type":"text"}],"type":"topic","title":"CustomReflectable","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomReflectable","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swift\/customreflectable","navigatorTitle":[{"text":"CustomReflectable","kind":"identifier"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/CustomPlaygroundDisplayConvertible":{"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swift\/customplaygrounddisplayconvertible","navigatorTitle":[{"kind":"identifier","text":"CustomPlaygroundDisplayConvertible"}],"title":"CustomPlaygroundDisplayConvertible","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomPlaygroundDisplayConvertible","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CustomPlaygroundDisplayConvertible"}],"abstract":[{"type":"text","text":"A type that supplies a custom description for playground logging."}]},"doc://com.apple.Swift/documentation/Swift/CustomLeafReflectable":{"role":"symbol","title":"CustomLeafReflectable","navigatorTitle":[