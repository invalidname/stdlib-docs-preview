{"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(member) "},{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(memberAttribute) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"DebugDescription"},{"kind":"text","text":"()"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"This macro converts compatible description implementations written in Swift","type":"text"},{"text":" ","type":"text"},{"text":"to an LLDB format known as a Type Summary. A Type Summary is LLDB’s","type":"text"},{"text":" ","type":"text"},{"text":"equivalent to ","type":"text"},{"code":"debugDescription","type":"codeVoice"},{"text":", with the distinction that it does not","type":"text"},{"text":" ","type":"text"},{"text":"execute code inside the debugged process. By avoiding code execution,","type":"text"},{"text":" ","type":"text"},{"text":"descriptions can be produced faster, without potential side effects, and","type":"text"},{"text":" ","type":"text"},{"text":"shown in situations where code execution is not performed, such as the","type":"text"},{"text":" ","type":"text"},{"text":"variable list of an IDE.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Consider this an example. This ","type":"text"},{"code":"Team","type":"codeVoice"},{"text":" struct has a ","type":"text"},{"code":"debugDescription","type":"codeVoice"},{"text":" which","type":"text"},{"text":" ","type":"text"},{"text":"summarizes some key details, such as the team’s name. The debugger only","type":"text"},{"text":" ","type":"text"},{"text":"computes this string on demand - typically via the ","type":"text"},{"code":"po","type":"codeVoice"},{"text":" command. By applying","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"DebugDescription","type":"codeVoice"},{"text":" macro, a matching Type Summary is constructed. This","type":"text"},{"text":" ","type":"text"},{"text":"allows the user to show a string like “Rams [11-2]”, without executing","type":"text"},{"text":" ","type":"text"},{"code":"debugDescription","type":"codeVoice"},{"text":". This improves the usability, performance, and","type":"text"},{"text":" ","type":"text"},{"text":"reliability of the debugging experience.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@DebugDescription","struct Team: CustomDebugStringConvertible {","   var name: String","   var wins, losses: Int","","   var debugDescription: String {","       \"\\(name) [\\(wins)-\\(losses)]\"","   }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DebugDescription"},{"type":"text","text":" macro supports both "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":", "},{"type":"codeVoice","code":"description"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as well as a third option: a property named "},{"type":"codeVoice","code":"lldbDescription"},{"type":"text","text":". The first"},{"type":"text","text":" "},{"type":"text","text":"two are implemented when conforming to the "},{"type":"codeVoice","code":"CustomDebugStringConvertible"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"CustomStringConvertible"},{"type":"text","text":" protocols. The additional "},{"type":"codeVoice","code":"lldbDescription"},{"type":"text","text":" "},{"type":"text","text":"property is useful when both "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":" and "},{"type":"codeVoice","code":"description"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"implemented, but don’t meet the requirements of the "},{"type":"codeVoice","code":"DebugDescription"},{"type":"text","text":" "},{"type":"text","text":"macro. If "},{"type":"codeVoice","code":"lldbDescription"},{"type":"text","text":" is implemented, "},{"type":"codeVoice","code":"DebugDescription"},{"type":"text","text":" choose it"},{"type":"text","text":" "},{"type":"text","text":"over "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":" and "},{"type":"codeVoice","code":"description"},{"type":"text","text":". Likewise, "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"preferred over "},{"type":"codeVoice","code":"description"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Description Requirements","anchor":"Description-Requirements","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The description implementation has the following requirements:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The body of the description implementation must be a single string"},{"type":"text","text":" "},{"type":"text","text":"expression. String concatenation is not supported, use string interpolation"},{"type":"text","text":" "},{"type":"text","text":"instead."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"String interpolation can reference stored properties only, functions calls"},{"type":"text","text":" "},{"type":"text","text":"and other arbitrary computation are not supported. Of note, conditional"},{"type":"text","text":" "},{"type":"text","text":"logic and computed properties are not supported."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Overloaded string interpolation cannot be used."}],"type":"paragraph"}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/debugdescription()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\