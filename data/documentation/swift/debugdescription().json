{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/debugdescription()"]}],"seeAlsoSections":[{"anchor":"Customizing-Your-Types-Reflection","title":"Customizing Your Type’s Reflection","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomLeafReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomPlaygroundDisplayConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/PlaygroundQuickLook"]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DebugDescription()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(member) ","kind":"text"},{"text":"@attached","kind":"attribute"},{"text":"(memberAttribute) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DebugDescription","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"This macro converts compatible description implementations written in Swift","type":"text"},{"text":" ","type":"text"},{"text":"to an LLDB format known as a Type Summary. A Type Summary is LLDB’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"equivalent to "},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":", with the distinction that it does not"},{"type":"text","text":" "},{"type":"text","text":"execute code inside the debugged process. By avoiding code execution,"},{"type":"text","text":" "},{"type":"text","text":"descriptions can be produced faster, without potential side effects, and"},{"type":"text","text":" "},{"type":"text","text":"shown in situations where code execution is not performed, such as the"},{"type":"text","text":" "},{"type":"text","text":"variable list of an IDE."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider this an example. This "},{"type":"codeVoice","code":"Team"},{"type":"text","text":" struct has a "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":" which"},{"type":"text","text":" "},{"type":"text","text":"summarizes some key details, such as the team’s name. The debugger only"},{"type":"text","text":" "},{"type":"text","text":"computes this string on demand - typically via the "},{"type":"codeVoice","code":"po"},{"type":"text","text":" command. By applying"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"DebugDescription"},{"type":"text","text":" macro, a matching Type Summary is constructed. This"},{"type":"text","text":" "},{"type":"text","text":"allows the user to show a string like “Rams [11-2]”, without executing"},{"type":"text","text":" "},{"type":"codeVoice","code":"debugDescription"},{"text":". This improves the usability, performance, and","type":"text"},{"text":" ","type":"text"},{"text":"reliability of the debugging experience.","type":"text"}]},{"syntax":"swift","code":["@DebugDescription","struct Team: CustomDebugStringConvertible {","   var name: String","   var wins, losses: Int","","   var debugDescription: String {","       \"\\(name) [\\(wins)-\\(losses)]\"","   }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DebugDescription"},{"type":"text","text":" macro supports both "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":", "},{"type":"codeVoice","code":"description"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as well as a third option: a property named "},{"type":"codeVoice","code":"lldbDescription"},{"type":"text","text":". The first"},{"type":"text","text":" "},{"type":"text","text":"two are implemented when conforming to the "},{"type":"codeVoice","code":"CustomDebugStringConvertible"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"CustomStringConvertible"},{"type":"text","text":" protocols. The additional "},{"type":"codeVoice","code":"lldbDescription"},{"type":"text","text":" "},{"type":"text","text":"property is useful when both "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":" and "},{"type":"codeVoice","code":"description"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"implemented, but don’t meet the requirements of the "},{"type":"codeVoice","code":"DebugDescription"},{"type":"text","text":" "},{"type":"text","text":"macro. If "},{"type":"codeVoice","code":"lldbDescription"},{"type":"text","text":" is implemented, "},{"type":"codeVoice","code":"DebugDescription"},{"type":"text","text":" choose it"},{"type":"text","text":" "},{"type":"text","text":"over "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":" and "},{"type":"codeVoice","code":"description"},{"type":"text","text":". Likewise, "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"preferred over "},{"type":"codeVoice","code":"description"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"Description Requirements","type":"heading","anchor":"Description-Requirements"},{"inlineContent":[{"text":"The description implementation has the following requirements:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The body of the description implementation must be a single string"},{"type":"text","text":" "},{"type":"text","text":"expression. String concatenation is not supported, use string interpolation"},{"type":"text","text":" "},{"type":"text","text":"instead."}]}]},{"content":[{"inlineContent":[{"text":"String interpolation can reference stored properties only, functions calls","type":"text"},{"text":" ","type":"text"},{"text":"and other arbitrary computation are not supported. Of note, conditional","type":"text"},{"text":" ","type":"text"},{"text":"logic and computed properties are not supported.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Overloaded string interpolation cannot be used.","type":"text"}],"type":"paragraph"}]}]}]}],"abstract":[{"type":"text","text":"Converts description definitions to a debugger Type Summary."}],"metadata":{"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DebugDescription","kind":"identifier"},{"text":"()","kind":"text"}],"platforms":[{"name":"iOS","introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false},{"name":"iPadOS","introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false},{"name":"Mac Catalyst","introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false},{"name":"macOS","introducedAt":"10.10","deprecated":false,"unavailable":false,"beta":false},{"name":"tvOS","introducedAt":"9.0","deprecated":false,"unavailable":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false},{"name":"watchOS","introducedAt":"2.0","deprecated":false,"unavailable":false,"beta":false}],"roleHeading":"Macro","externalID":"s:s16DebugDescriptionyycfm","modules":[{"name":"Swift"}],"title":"DebugDescription()","symbolKind":"macro","role":"symbol"},"sections":[],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.apple.Swift/documentation/Swift":{"kind":"symbol","type":"topic","role":"collection","title":"Swift","images":[{"type":"card","identifier":"Swift-PageImage-card.png"}],"abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","identifier":"doc:\/\/com.apple.Sw