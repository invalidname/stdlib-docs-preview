{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"abstract":[{"type":"text","text":"Converts description definitions to a debugger Type Summary."}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomLeafReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomPlaygroundDisplayConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/PlaygroundQuickLook"],"title":"Customizing Your Type’s Reflection","generated":true,"anchor":"Customizing-Your-Types-Reflection"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(member) "},{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(memberAttribute) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"DebugDescription"},{"kind":"text","text":"()"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This macro converts compatible description implementations written in Swift"},{"text":" ","type":"text"},{"type":"text","text":"to an LLDB format known as a Type Summary. A Type Summary is LLDB’s"},{"text":" ","type":"text"},{"text":"equivalent to ","type":"text"},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":", with the distinction that it does not"},{"type":"text","text":" "},{"type":"text","text":"execute code inside the debugged process. By avoiding code execution,"},{"type":"text","text":" "},{"type":"text","text":"descriptions can be produced faster, without potential side effects, and"},{"text":" ","type":"text"},{"type":"text","text":"shown in situations where code execution is not performed, such as the"},{"type":"text","text":" "},{"type":"text","text":"variable list of an IDE."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider this an example. This "},{"code":"Team","type":"codeVoice"},{"type":"text","text":" struct has a "},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":" which"},{"type":"text","text":" "},{"type":"text","text":"summarizes some key details, such as the team’s name. The debugger only"},{"type":"text","text":" "},{"type":"text","text":"computes this string on demand - typically via the "},{"code":"po","type":"codeVoice"},{"type":"text","text":" command. By applying"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"DebugDescription","type":"codeVoice"},{"type":"text","text":" macro, a matching Type Summary is constructed. This"},{"type":"text","text":" "},{"type":"text","text":"allows the user to show a string like “Rams [11-2]”, without executing"},{"type":"text","text":" "},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":". This improves the usability, performance, and"},{"type":"text","text":" "},{"type":"text","text":"reliability of the debugging experience."}]},{"code":["@DebugDescription","struct Team: CustomDebugStringConvertible {","   var name: String","   var wins, losses: Int","","   var debugDescription: String {","       \"\\(name) [\\(wins)-\\(losses)]\"","   }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"DebugDescription","type":"codeVoice"},{"type":"text","text":" macro supports both "},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":", "},{"code":"description","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as well as a third option: a property named "},{"code":"lldbDescription","type":"codeVoice"},{"type":"text","text":". The first"},{"type":"text","text":" "},{"type":"text","text":"two are implemented when conforming to the "},{"code":"CustomDebugStringConvertible","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"CustomStringConvertible","type":"codeVoice"},{"type":"text","text":" protocols. The additional "},{"code":"lldbDescription","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"property is useful when both "},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":" and "},{"code":"description","type":"codeVoice"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"implemented, but don’t meet the requirements of the "},{"code":"DebugDescription","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"macro. If "},{"code":"lldbDescription","type":"codeVoice"},{"type":"text","text":" is implemented, "},{"code":"DebugDescription","type":"codeVoice"},{"type":"text","text":" choose it"},{"type":"text","text":" "},{"type":"text","text":"over "},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":" and "},{"code":"description","type":"codeVoice"},{"type":"text","text":". Likewise, "},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"preferred over "},{"code":"description","type":"codeVoice"},{"type":"text","text":"."}]},{"text":"Description Requirements","level":3,"anchor":"Description-Requirements","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The description implementation has the following requirements:"}]},{"items":[{"content":[{"inlineContent":[{"text":"The body of the description implementation must a single string","type":"text"},{"text":" ","type":"text"},{"text":"expression. String concatenation is not supported, use string interpolation","type":"text"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"String interpolation can reference stored properties only, functions calls","type":"text"},{"text":" ","type":"text"},{"text":"and other arbitrary computation are not supported. Of note, conditional","type":"text"},{"text":" ","type":"text"},{"text":"logic and computed properties are not supported.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Overloaded string interpolation cannot be used.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DebugDescription()"},"variants":[{"paths":["\/documentation\/swift\/debugdescription()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Macro","externalID":"s:s16DebugDescriptionyycfm","symbolKind":"macro","title":"DebugDescription()","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"DebugDescription"},{"kind":"text","text":"()"}],"role":"symbol","modules":[{"name":"Swift"}],"platforms":[{"deprecated":false,"unavailable":false,"introducedAt":"8.0","name":"iOS","beta":false},{"beta":false,"name":"iPadOS","deprecated":false,"introducedAt":"8.0","unavailable":false},{"deprecated":false,"unavailable":false,"introducedAt":"13.0","name":"Mac Catalyst","beta":false},{"beta":false,"name":"macOS","deprecated":false,"introducedAt":"10.10","unavailable":false},{"beta":false,"name":"tvOS","deprecated":false,"introducedAt":"9.0","unavailable":false},{"beta":false,"name":"visionOS","deprecated":false,"introducedAt":"1.0","unavailable":false},{"beta":false,"name":"watchOS","deprecated":false,"introducedAt":"2.0","unavailable":false}]},"references":{"doc://com.apple.Swift/documentation/Swift/CustomReflectable":{"url":"\/documentation\/swift\/customreflectable","kind":"symbol","abstract":[{"type":"text","text":"A type that explicitly supplies its own mirror."}],"navigatorTitle":[{"kind":"identifier","text":"CustomReflectable"}],"role":"symbol","identifier":"doc:\/\/com.app