{"sections":[],"abstract":[{"type":"text","text":"Converts description definitions to a debugger Type Summary."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(member) "},{"kind":"attribute","text":"@attached"},{"text":"(memberAttribute) ","kind":"text"},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"DebugDescription"},{"kind":"text","text":"()"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This macro converts compatible description implementations written in Swift"},{"type":"text","text":" "},{"type":"text","text":"to an LLDB format known as a Type Summary. A Type Summary is LLDB’s"},{"type":"text","text":" "},{"type":"text","text":"equivalent to "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":", with the distinction that it does not"},{"type":"text","text":" "},{"type":"text","text":"execute code inside the debugged process. By avoiding code execution,"},{"type":"text","text":" "},{"type":"text","text":"descriptions can be produced faster, without potential side effects, and"},{"type":"text","text":" "},{"type":"text","text":"shown in situations where code execution is not performed, such as the"},{"text":" ","type":"text"},{"type":"text","text":"variable list of an IDE."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider this an example. This "},{"code":"Team","type":"codeVoice"},{"type":"text","text":" struct has a "},{"code":"debugDescription","type":"codeVoice"},{"text":" which","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"summarizes some key details, such as the team’s name. The debugger only"},{"text":" ","type":"text"},{"type":"text","text":"computes this string on demand - typically via the "},{"type":"codeVoice","code":"po"},{"text":" command. By applying","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the "},{"type":"codeVoice","code":"DebugDescription"},{"text":" macro, a matching Type Summary is constructed. This","type":"text"},{"type":"text","text":" "},{"type":"text","text":"allows the user to show a string like “Rams [11-2]”, without executing"},{"text":" ","type":"text"},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":". This improves the usability, performance, and"},{"type":"text","text":" "},{"text":"reliability of the debugging experience.","type":"text"}]},{"type":"codeListing","code":["@DebugDescription","struct Team: CustomDebugStringConvertible {","   var name: String","   var wins, losses: Int","","   var debugDescription: String {","       \"\\(name) [\\(wins)-\\(losses)]\"","   }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DebugDescription"},{"type":"text","text":" macro supports both "},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"description"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as well as a third option: a property named "},{"type":"codeVoice","code":"lldbDescription"},{"type":"text","text":". The first"},{"type":"text","text":" "},{"type":"text","text":"two are implemented when conforming to the "},{"type":"codeVoice","code":"CustomDebugStringConvertible"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"CustomStringConvertible"},{"type":"text","text":" protocols. The additional "},{"type":"codeVoice","code":"lldbDescription"},{"type":"text","text":" "},{"type":"text","text":"property is useful when both "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":" and "},{"type":"codeVoice","code":"description"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"implemented, but don’t meet the requirements of the "},{"type":"codeVoice","code":"DebugDescription"},{"type":"text","text":" "},{"type":"text","text":"macro. If "},{"code":"lldbDescription","type":"codeVoice"},{"type":"text","text":" is implemented, "},{"code":"DebugDescription","type":"codeVoice"},{"type":"text","text":" choose it"},{"type":"text","text":" "},{"type":"text","text":"over "},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"description"},{"type":"text","text":". Likewise, "},{"type":"codeVoice","code":"debugDescription"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"preferred over "},{"type":"codeVoice","code":"description"},{"type":"text","text":"."}]},{"type":"heading","text":"Description Requirements","level":3,"anchor":"Description-Requirements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The description implementation has the following requirements:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The body of the description implementation must be a single string"},{"type":"text","text":" "},{"type":"text","text":"expression. String concatenation is not supported, use string interpolation"},{"type":"text","text":" "},{"type":"text","text":"instead."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"String interpolation can reference stored properties only, functions calls"},{"type":"text","text":" "},{"type":"text","text":"and other arbitrary computation are not supported. Of note, conditional"},{"type":"text","text":" "},{"type":"text","text":"logic and computed properties are not supported."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Overloaded string interpolation cannot be used."}]}]}],"type":"unorderedList"}]}],"seeAlsoSections":[{"anchor":"Customizing-Your-Types-Reflection","generated":true,"title":"Customizing Your Type’s Reflection","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomLeafReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomPlaygroundDisplayConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/PlaygroundQuickLook"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DebugDescription()","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swift\/debugdescription()"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"metadata":{"externalID":"s:s16DebugDescriptionyycfm","platforms":[{"beta":false,"name":"iOS","deprecated":false,"unavailable":false,"introducedAt":"8.0"},{"beta":false,"name":"iPadOS","deprecated":false,"unavailable":false,"introducedAt":"8.0"},{"beta":false,"name":"Mac Catalyst","deprecated":false,"unavailable":false,"introducedAt":"13.0"},{"beta":false,"name":"macOS","deprecated":false,"unavailable":false,"introducedAt":"10.10"},{"beta":false,"name":"tvOS","deprecated":false,"unavailable":false,"introducedAt":"9.0"},{"beta":false,"name":"visionOS","deprecated":false,"unavailable":false,"introducedAt":"1.0"},{"name":"watchOS","introducedAt":"2.0","deprecated":false,"unavailable":false,"beta":false}],"title":"DebugDescription()","role":"symbol","roleHeading":"Macro","symbolKind":"macro","modules":[{"name":"Swift"}],"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DebugDescription","kind":"identifier"},{"kind":"text","text":"()"}]},"references":{"doc://com.apple.Swift/documentation/Swift/CustomLeafReflectable":{"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CustomLeafReflectable"}],"type":"topic","url":"\/documentation\/swift\/customleafreflectable","abstract":[{"text":"A type that explicitly supplies its o