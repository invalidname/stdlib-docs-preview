{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/debugdescription()"]}],"metadata":{"platforms":[{"beta":false,"introducedAt":"8.0","unavailable":false,"name":"iOS","deprecated":false},{"deprecated":false,"introducedAt":"8.0","name":"iPadOS","unavailable":false,"beta":false},{"beta":false,"introducedAt":"13.0","unavailable":false,"name":"Mac Catalyst","deprecated":false},{"introducedAt":"10.10","name":"macOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"9.0","name":"tvOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"1.0","name":"visionOS","deprecated":false,"unavailable":false,"beta":false},{"beta":false,"introducedAt":"2.0","unavailable":false,"name":"watchOS","deprecated":false}],"fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"DebugDescription"},{"kind":"text","text":"()"}],"title":"DebugDescription()","modules":[{"name":"Swift"}],"symbolKind":"macro","externalID":"s:s16DebugDescriptionyycfm","role":"symbol","roleHeading":"Macro"},"abstract":[{"type":"text","text":"Converts description definitions to a debugger Type Summary."}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomLeafReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomPlaygroundDisplayConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/PlaygroundQuickLook"],"generated":true,"title":"Customizing Your Type’s Reflection","anchor":"Customizing-Your-Types-Reflection"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(member) "},{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(memberAttribute) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"text":"DebugDescription","kind":"identifier"},{"kind":"text","text":"()"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"This macro converts compatible description implementations written in Swift","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to an LLDB format known as a Type Summary. A Type Summary is LLDB’s"},{"type":"text","text":" "},{"type":"text","text":"equivalent to "},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":", with the distinction that it does not"},{"type":"text","text":" "},{"type":"text","text":"execute code inside the debugged process. By avoiding code execution,"},{"text":" ","type":"text"},{"type":"text","text":"descriptions can be produced faster, without potential side effects, and"},{"text":" ","type":"text"},{"text":"shown in situations where code execution is not performed, such as the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"variable list of an IDE."}]},{"type":"paragraph","inlineContent":[{"text":"Consider this an example. This ","type":"text"},{"code":"Team","type":"codeVoice"},{"text":" struct has a ","type":"text"},{"type":"codeVoice","code":"debugDescription"},{"text":" which","type":"text"},{"text":" ","type":"text"},{"text":"summarizes some key details, such as the team’s name. The debugger only","type":"text"},{"text":" ","type":"text"},{"text":"computes this string on demand - typically via the ","type":"text"},{"type":"codeVoice","code":"po"},{"text":" command. By applying","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"codeVoice","code":"DebugDescription"},{"text":" macro, a matching Type Summary is constructed. This","type":"text"},{"text":" ","type":"text"},{"text":"allows the user to show a string like “Rams [11-2]”, without executing","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"debugDescription"},{"text":". This improves the usability, performance, and","type":"text"},{"text":" ","type":"text"},{"text":"reliability of the debugging experience.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@DebugDescription","struct Team: CustomDebugStringConvertible {","   var name: String","   var wins, losses: Int","","   var debugDescription: String {","       \"\\(name) [\\(wins)-\\(losses)]\"","   }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"DebugDescription","type":"codeVoice"},{"type":"text","text":" macro supports both "},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":", "},{"code":"description","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as well as a third option: a property named "},{"type":"codeVoice","code":"lldbDescription"},{"type":"text","text":". The first"},{"type":"text","text":" "},{"type":"text","text":"two are implemented when conforming to the "},{"code":"CustomDebugStringConvertible","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"CustomStringConvertible","type":"codeVoice"},{"type":"text","text":" protocols. The additional "},{"code":"lldbDescription","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"property is useful when both "},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":" and "},{"code":"description","type":"codeVoice"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"implemented, but don’t meet the requirements of the "},{"type":"codeVoice","code":"DebugDescription"},{"type":"text","text":" "},{"type":"text","text":"macro. If "},{"type":"codeVoice","code":"lldbDescription"},{"type":"text","text":" is implemented, "},{"type":"codeVoice","code":"DebugDescription"},{"type":"text","text":" choose it"},{"type":"text","text":" "},{"type":"text","text":"over "},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":" and "},{"code":"description","type":"codeVoice"},{"type":"text","text":". Likewise, "},{"code":"debugDescription","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"preferred over "},{"code":"description","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"Description-Requirements","type":"heading","level":3,"text":"Description Requirements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The description implementation has the following requirements:"}]},{"items":[{"content":[{"inlineContent":[{"text":"The body of the description implementation must be a single string","type":"text"},{"text":" ","type":"text"},{"text":"expression. String concatenation is not supported, use string interpolation","type":"text"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"String interpolation can reference stored properties only, functions calls"},{"type":"text","text":" "},{"type":"text","text":"and other arbitrary computation are not supported. Of note, conditional"},{"type":"text","text":" "},{"type":"text","text":"logic and computed properties are not supported."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Overloaded string interpolation cannot be used."}]}]}],"type":"unorderedList"}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DebugDescription()","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift":{"title":"Swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","url":"\/documentation\/swift"},"doc://com.apple.Swift/documentation/Sw