r"}],"role":"symbol","abstract":[{"text":"A type that explicitly supplies its own mirror, but whose","type":"text"},{"text":" ","type":"text"},{"text":"descendant classes are not represented in the mirror unless they","type":"text"},{"text":" ","type":"text"},{"text":"also override ","type":"text"},{"code":"customMirror","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","url":"\/documentation\/swift\/customleafreflectable","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomLeafReflectable","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/CustomReflectable":{"title":"CustomReflectable","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","navigatorTitle":[{"text":"CustomReflectable","kind":"identifier"}],"role":"symbol","abstract":[{"text":"A type that explicitly supplies its own mirror.","type":"text"}],"kind":"symbol","url":"\/documentation\/swift\/customreflectable","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomReflectable","kind":"identifier"}]}}}