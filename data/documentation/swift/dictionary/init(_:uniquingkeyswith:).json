ny duplicate keys:"}]},{"syntax":"swift","type":"codeListing","code":["let pairsWithDuplicateKeys = [(\"a\", 1), (\"b\", 2), (\"a\", 3), (\"b\", 4)]","","let firstValues = Dictionary(pairsWithDuplicateKeys,","                             uniquingKeysWith: { (first, _) in first })","\/\/ [\"b\": 2, \"a\": 1]","","let lastValues = Dictionary(pairsWithDuplicateKeys,","                            uniquingKeysWith: { (_, last) in last })","\/\/ [\"b\": 4, \"a\": 3]"]}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Error":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","title":"Error","role":"symbol","abstract":[{"type":"text","text":"A type representing an error value that can be thrown."}],"type":"topic","url":"\/documentation\/swift\/error","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Error","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Error","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/Dictionary/init(_:uniquingKeysWith:)":{"fragments":[{"kind":"identifier","text":"init"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"S","kind":"typeIdentifier","preciseIdentifier":"s:SD_16uniquingKeysWithSDyxq_Gqd__n_q_q__q_tqd_0_YKXEtqd_0_YKcSTRd__s5ErrorRd_0_x_q_t7ElementRtd__r0_lufc1SL_qd__mfp"},{"text":", ","kind":"text"},{"text":"uniquingKeysWith","kind":"externalParam"},{"text":": (","kind":"text"},{"preciseIdentifier":"s:SD5Valueq_mfp","text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:SD5Valueq_mfp","text":"Value","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SD_16uniquingKeysWithSDyxq_Gqd__n_q_q__q_tqd_0_YKXEtqd_0_YKcSTRd__s5ErrorRd_0_x_q_t7ElementRtd__r0_lufc1EL_qd_0_mfp","text":"E","kind":"typeIdentifier"},{