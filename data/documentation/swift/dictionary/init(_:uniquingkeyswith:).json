{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/swift\/dictionary\/init(_:uniquingkeyswith:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"text":"Creates a new dictionary from the key-value pairs in the given sequence,","type":"text"},{"text":" ","type":"text"},{"text":"using a combining closure to determine the value for any duplicate keys.","type":"text"}],"seeAlsoSections":[{"generated":true,"title":"Creating a Dictionary","anchor":"Creating-a-Dictionary","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Dictionary\/init()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Dictionary\/init(minimumCapacity:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Dictionary\/init(uniqueKeysWithValues:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Dictionary\/init(grouping:by:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Dictionary\/init(_:)"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Dictionary\/init(_:uniquingKeysWith:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Dictionary"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"init","kind":"keyword"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"keysAndValues","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier","preciseIdentifier":"s:SD_16uniquingKeysWithSDyxq_Gqd__n_q_q__q_tqd_0_YKXEtqd_0_YKcSTRd__s5ErrorRd_0_x_q_t7ElementRtd__r0_lufc1SL_qd__mfp"},{"text":", ","kind":"text"},{"text":"uniquingKeysWith","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"combine","kind":"internalParam"},{"text":": (","kind":"text"},{"text