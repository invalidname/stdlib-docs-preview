key is not present in the dictionary, a default value. This","type":"text"},{"text":" ","type":"text"},{"text":"example uses the subscript with a message to use in case an HTTP response","type":"text"},{"text":" ","type":"text"},{"text":"code isn’t recognized:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var responseMessages = [200: \"OK\",","                        403: \"Access forbidden\",","                        404: \"File not found\",","                        500: \"Internal server error\"]","","let httpResponseCodes = [200, 403, 301]","for code in httpResponseCodes {","    let message = responseMessages[code, default: \"Unknown response\"]","    print(\"Response \\(code): \\(message)\")","}","\/\/ Prints \"Response 200: OK\"","\/\/ Prints \"Response 403: Access forbidden\"","\/\/ Prints \"Response 301: Unknown response\""],"type":"codeListing"},{"inlineContent":[{"text":"When a dictionary’s ","type":"text"},{"code":"Value","type":"codeVoice"},{"text":" type has value semantics, you can use this","type":"text"},{"text":" ","type":"text"},{"text":"subscript to perform in-place operations on values in the dictionary.","type":"text"},{"text":" ","type":"text"},{"text":"The following example uses this subscript while counting the occurrences","type":"text"},{"text":" ","type":"text"},{"text":"of each letter in a string:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let message = \"Hello, Elle!\"","var letterCounts: [Character: Int] = [:]","for letter in message {","    letterCounts[letter, default: 0] += 1","}","\/\/ letterCounts == [\"H\": 1, \"e\": 2, \"l\": 4, \"o\": 1, ...]"]},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"letterCounts[letter, default: 0] += 1"},{"type":"text","text":" is executed with a"},{"type":"text","text":" "},{"type":"text","text":"value of "},{"type":"codeVoice","code":"letter"},{"type":"text","text":" that isn’t already a key in "},{"type":"codeVoice","code":"letterCounts"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"specified default value ("},{"type":"codeVoice","code":"0"},{"type":"text","text":") is returned from the subscript,"},{"type":"text","text":" "},{"type":"text","text":"incremented, and then added to the dictionary under that key."}],"type":"paragraph"},{"type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":"Do not use this subscript to modify dictionary values if the"},{"type":"text","text":" "},{"type":"text","text":"dictionary’s "},{"type":"codeVoice","code":"Value"},{"type":"text","text":" type is a class. In that case, the default value"},{"type":"text","text":" "},{"type":"text","text":"and key are not written back to the dictionary after an operation."}],"type":"paragraph"}],"style":"note"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/dictionary\/subscript(_:default:)"]}],"metadata":{"roleHeading":"Instance Subscript","modules":[{"name":"Standard Library"}],"symbolKind":"subscript","externalID":"s:SD_7defaultq_x_q_yXKtcip","extendedModule":"Swift","title":"subscript(_:default:)","platforms":[{"deprecated":false,"name":"iOS","introducedAt":"8.0","unavailable":false,"beta":false},{"deprecated":false,"name":"iPadOS","introducedAt":"8.0","unavailable":false,"beta":false},{"deprecated":false,"name":"Mac Catalyst","introducedAt":"13.0","unavailable":false,"beta":false},{"deprecated":false,"name":"macOS","introducedAt":"10.10","unavailable":false,"beta":false},{"deprecated":false,"name":"tvOS","introducedAt":"9.0","unavailable":false,"beta":false},{"deprecated":false,"name":"visionOS","introducedAt":"1.0","unavailable":false,"beta":false},{"deprecated":false,"name":"watchOS","introducedAt":"2.0","unavailable":false,"beta":false}],"fragments":[{"kind":"keyword","text":"subscript"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SD3Keyxmfp","text":"Key"},{"kind"