/UnsafeCurrentTask"],"anchor":"Tasks"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/discardingtaskgroup"]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscardingTaskGroup","kind":"identifier"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To create a discarding task group,"},{"type":"text","text":" "},{"type":"text","text":"call the "},{"type":"codeVoice","code":"withDiscardingTaskGroup(returning:body:)"},{"type":"text","text":" method."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Don’t use a task group from outside the task where you created it."},{"type":"text","text":" "},{"type":"text","text":"In most cases,"},{"type":"text","text":" "},{"type":"text","text":"the Swift type system prevents a task group from escaping like that"},{"type":"text","text":" "},{"type":"text","text":"because adding a child task to a task group is a mutating operation,"},{"type":"text","text":" "},{"type":"text","text":"and mutation operations can’t be performed"},{"type":"text","text":" "},{"type":"text","text":"from a concurrent execution context like a child task."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Refer to "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference","isActive":true},{"type":"text","text":" documentation for detailed discussion of semantics shared between all task groups."}]},{"type":"heading","level":3,"anchor":"Discarding-behavior","text":"Discarding behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A discarding task group eagerly discards and releases its child tasks as"},{"type":"text","text":" "},{"type":"text","text":"soon as they complete. This allows for the efficient releasing of memory used"},{"type":"text","text":" "},{"type":"text","text":"by those tasks, which are not retained for future "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" calls, as would"},{"type":"text","text":" "},{"type":"text","text":"be the case with a "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":3,"anchor":"Cancellation-behavior","text":"Cancellation behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A discarding task group becomes canceled in one of the following ways:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"when ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup\/cancelAll()"},{"text":" is invoked on it,","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"when the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task"},{"text":" running this task group is canceled.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since a "},{"type":"codeVoice","code":"DiscardingTaskGroup"},{"type":"text","text":" is a structured concurrency primitive, cancellation is"},{"type":"text","text":" "},{"type":"text","text":"automatically propagated through all of its child-tasks (and their child"},{"type":"text","text":" "},{"type":"text","text":"tasks)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A canceled task group can still keep adding tasks, however they will start"},{"type":"text","text":" "},{"type":"text","text":"being immediately canceled, and may act accordingly to this. To avoid adding"},{"type":"text","text":" "},{"type":"text","text":"new tasks to an already canceled task group, use "},{"type":"codeVoice","code":"addTaskUnlessCancelled(priority:body:)"},{"type":"text","text":" "},{"type":"text","text":"rather than the plain "},{"type":"codeVoice","code":"addTask(priority:body:)"},{"type":"text","text":" which adds tasks unconditionally."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For information about the language-level concurrency model that "},{"type":"codeVoice","code":"DiscardingTaskGroup"},{"type":"text","text":" is part of,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html","type":"reference","isActive":true},{"type":"text","text":" in "},{"identifier":"https:\/\/docs.swift.org\/swift-book\/","type":"reference","isActive":true},{"type":"text","text":"."}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup"}]}],"name":"See Also"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup"}]}],"name":"See Also"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup"}]}],"name":"See Also"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://com.apple.Swift/documentation/Swift/DiscardingTaskGroup/isCancelled":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup\/isCancelled","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isCancelled","kind":"identifier"},{"text