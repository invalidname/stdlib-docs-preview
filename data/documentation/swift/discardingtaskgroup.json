/Swift\/UnsafeCurrentTask"],"generated":true,"title":"Tasks"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"DiscardingTaskGroup","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"To create a discarding task group,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"call the "},{"code":"withDiscardingTaskGroup(returning:body:)","type":"codeVoice"},{"text":" method.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Don’t use a task group from outside the task where you created it.","type":"text"},{"type":"text","text":" "},{"text":"In most cases,","type":"text"},{"text":" ","type":"text"},{"text":"the Swift type system prevents a task group from escaping like that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"because adding a child task to a task group is a mutating operation,"},{"type":"text","text":" "},{"type":"text","text":"and mutation operations can’t be performed"},{"type":"text","text":" "},{"text":"from a concurrent execution context like a child task.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Refer to "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","isActive":true},{"text":" documentation for detailed discussion of semantics shared between all task groups.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Discarding behavior","anchor":"Discarding-behavior","type":"heading"},{"inlineContent":[{"text":"A discarding task group eagerly discards and releases its child tasks as","type":"text"},{"type":"text","text":" "},{"type":"text","text":"soon as they complete. This allows for the efficient releasing of memory used"},{"type":"text","text":" "},{"text":"by those tasks, which are not retained for future ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" calls, as would","type":"text"},{"type":"text","text":" "},{"text":"be the case with a ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Cancellation behavior","anchor":"Cancellation-behavior","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A discarding task group becomes canceled in one of the following ways:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"when ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup\/cancelAll()","type":"reference","isActive":true},{"text":" is invoked on it,","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"when the ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","isActive":true},{"text":" running this task group is canceled.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Since a ","type":"text"},{"type":"codeVoice","code":"DiscardingTaskGroup"},{"text":" is a structured concurrency primitive, cancellation is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"automatically propagated through all of its child-tasks (and their child"},{"type":"text","text":" "},{"type":"text","text":"tasks)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A canceled task group can still keep adding tasks, however they will start"},{"type":"text","text":" "},{"type":"text","text":"being immediately canceled, and may act accordingly to this. To avoid adding"},{"type":"text","text":" "},{"type":"text","text":"new tasks to an already canceled task group, use "},{"code":"addTaskUnlessCancelled(priority:body:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"rather than the plain ","type":"text"},{"type":"codeVoice","code":"addTask(priority:body:)"},{"type":"text","text":" which adds tasks unconditionally."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For information about the language-level concurrency model that "},{"type":"codeVoice","code":"DiscardingTaskGroup"},{"type":"text","text":" is part of,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html","isActive":true},{"type":"text","text":" in "},{"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/","isActive":true},{"type":"text","text":"."}]},{"content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference","isActive":true}],"type":"paragraph"}],"type":"aside","name":"See Also","style":"note"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","isActive":true}]}],"type":"aside","name":"See Also","style":"note"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup"}],"type":"paragraph"}],"type":"aside","name":"See Also","style":"note"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BitwiseCopyable"],"type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/discardingtaskgroup"]}],"kind":"symbol","sections":[],"abstract":[{"text":"A discarding group that contains dynamically created child task