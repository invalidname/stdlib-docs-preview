dingly to this. To avoid adding"},{"type":"text","text":" "},{"type":"text","text":"new tasks to an already canceled task group, use "},{"type":"codeVoice","code":"addTaskUnlessCancelled(priority:body:)"},{"type":"text","text":" "},{"type":"text","text":"rather than the plain "},{"type":"codeVoice","code":"addTask(priority:body:)"},{"type":"text","text":" which adds tasks unconditionally."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For information about the language-level concurrency model that "},{"type":"codeVoice","code":"DiscardingTaskGroup"},{"type":"text","text":" is part of,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"isActive":true,"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html"},{"type":"text","text":" in "},{"isActive":true,"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/"},{"type":"text","text":"."}]},{"type":"aside","name":"See Also","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference"}],"type":"paragraph"}],"style":"note"},{"type":"aside","name":"See Also","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","type":"reference"}],"type":"paragraph"}],"style":"note"},{"type":"aside","name":"See Also","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","type":"reference"}],"type":"paragraph"}],"style":"note"}]}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/DiscardingTaskGroup/isEmpty":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup\/isEmpty","url":"\/documentation\/swift\/discardingtaskgroup\/isempty","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":