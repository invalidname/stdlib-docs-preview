ated"},{"type":"text","text":" "},{"type":"text","text":"operation this means running on the global concurrent pool, and on an isolated"},{"type":"text","text":" "},{"type":"text","text":"operation it means the appropriate executor of that isolation context."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"As indicated by the lack of "},{"code":"async","type":"codeVoice"},{"type":"text","text":" on this method, this method does "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" "},{"type":"text","text":"suspend, and instead takes over the calling task’s (thread’s) execution in"},{"type":"text","text":" "},{"type":"text","text":"a synchronous manner."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Other than the execution semantics discussed above, the created task"},{"type":"text","text":" "},{"type":"text","text":"is semantically equivalent to its basic version which can be"},{"type":"text","text":" "},{"type":"text","text":"created using "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup\/addTask(priority:operation:)","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/swift\/discardingtaskgroup\/addimmediatetask(name:priority:executorpreference:operation:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup\/addImmediateTask(name:priority:executorPreference:operation:)","interfaceLanguage":"swift"},"metadata":{"modules":[{"relatedModules":[],"name":"Swift"}],"extendedModule":"_Concurrency","externalID":"s:12_Concurrency19DiscardingTaskGroupV012addImmediateC04name8priority18executorPreference9operationySSSg_ScPSgSch_pSgnyyYaYAcntF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addImmediateTask"},{"kind":"text","text":"("},{"kind":"externalParam","tex