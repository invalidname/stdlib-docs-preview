{"sections":[],"abstract":[{"text":"Cancel all of the remaining tasks in the group.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancelAll","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"If you add a task to a group after canceling the group,"},{"type":"text","text":" "},{"type":"text","text":"that task is canceled immediately after being added to the group."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Immediately canceled child tasks should therefore cooperatively check for and"},{"type":"text","text":" "},{"type":"text","text":"react  to cancellation, e.g. by throwing an "},{"code":"CancellationError","type":"codeVoice"},{"type":"text","text":" at their"},{"type":"text","text":" "},{"type":"text","text":"earliest convenience, or otherwise handling the cancellation."}],"type":"paragraph"},{"inlineContent":[{"text":"There are no restrictions on where you can call this method.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Code inside a child task or even another task can cancel a group,"},{"type":"text","text":" "},{"type":"text","text":"however one should be very careful to not keep a reference to the"},{"type":"text","text":" "},{"type":"text","text":"group longer than the "},{"type":"codeVoice","code":"with...TaskGroup(...) { ... }"},{"text":" method body is executing.","type":"text"}],"type":"paragraph"},{"name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"Task.isCancelled","type":"codeVoice"}]}],"style":"note","type":"aside"},{"name":"See Also","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"DiscardingTaskGroup.isCancelled"}],"type":"paragraph"}],"style":"