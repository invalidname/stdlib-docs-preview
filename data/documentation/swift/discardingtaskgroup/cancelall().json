r canceling the group,","type":"text"},{"text":" ","type":"text"},{"text":"that task is canceled immediately after being added to the group.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Immediately canceled child tasks should therefore cooperatively check for and"},{"type":"text","text":" "},{"text":"react  to cancellation, e.g. by throwing an ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" at their","type":"text"},{"text":" ","type":"text"},{"text":"earliest convenience, or otherwise handling the cancellation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There are no restrictions on where you can call this method."},{"text":" ","type":"text"},{"type":"text","text":"Code inside a child task or even another task can cancel a group,"},{"type":"text","text":" "},{"type":"text","text":"however one should be very careful to not keep a reference to the"},{"type":"text","text":" "},{"type":"text","text":"group longer than the "},{"type":"codeVoice","code":"with...TaskGroup(...) { ... }"},{"type":"text","text":" method body is executing."}],"type":"paragraph"},{"name":"See Also","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"Task.isCancelled","type":"codeVoice"}],"type":"paragraph"}],"type":"aside","style":"note"},{"name":"See Also","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"DiscardingTaskGroup.isCancelled","type":"codeVoice"}],"type":"paragraph"}],"type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/DiscardingTaskGroup/cancelAll()":{"abstract":[{"text":"Cancel all of the remaining tasks in the group.","type":"text"}],"title":"cancelAll()","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup\/cancelAll()","url":"\/documentation\/swift\/discardingtaskgroup\/cancelall()","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ca