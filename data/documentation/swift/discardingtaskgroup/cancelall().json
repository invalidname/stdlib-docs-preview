{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/swift\/discardingtaskgroup\/cancelall()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"Cancel all of the remaining tasks in the group.","type":"text"}],"metadata":{"roleHeading":"Instance Method","role":"symbol","title":"cancelAll()","externalID":"s:12_Concurrency19DiscardingTaskGroupV9cancelAllyyF","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancelAll","kind":"identifier"},{"text":"()","kind":"text"}],"platforms":[{"introducedAt":"8.0","beta":false,"deprecated":false,"name":"iOS","unavailable":false},{"introducedAt":"8.0","beta":false,"deprecated":false,"name":"iPadOS","unavailable":false},{"introducedAt":"13.0","beta":false,"deprecated":false,"name":"Mac Catalyst","unavailable":false},{"introducedAt":"10.10","beta":false,"deprecated":false,"name":"macOS","unavailable":false},{"introducedAt":"9.0","beta":false,"deprecated":false,"name":"tvOS","unavailable":false},{"introducedAt":"1.0","beta":false,"deprecated":false,"name":"visionOS","unavailable":false},{"introducedAt":"2.0","beta":false,"deprecated":false,"name":"watchOS","unavailable":false}],"modules":[{"name":"Swift","relatedModules":[]}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancelAll"},{"kind":"text","text":"()"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"If you add a task to a group after canceling the group,","type":"text"},{"text":" ","type":"text"},{"text":"that task is canceled immediately after being added to the group.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Immediately canceled child tasks should therefore cooperatively check for and","type":"text"},{"text":" ","type":"text"},{"text":"react  to cancellation, e.g. by throwing an ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" at their","type":"text"},{"text":" ","type":"text"},{"text":"earliest convenience, or otherwise handling the cancellation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"There are no restrictions on where you can call this method.","type":"text"},{"text":" ","type":"text"},{"text":"Code inside a child task or even another task can cancel a group,","type":"text"},{"text":" ","type":"text"},{"text":"however one should be very careful to not keep a reference to the","type":"text"},{"text":" ","type":"text"},{"text":"group longer than the ","type":"text"},{"code":"with...TaskGroup(...) { ... }","type":"codeVoice"},{"text":" method body is executing.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"Task.isCancelled"}],"type":"paragraph"}],"name":"See Also"},{"type":"aside","name":"See Also","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"DiscardingTaskGroup.isCancelled"}],"type":"paragraph"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup\/cancelAll()"},"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/DiscardingTaskGroup/cancelAll()":{"url":"\/documentation\/swift\/discardingtaskgroup\/cancelall()","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancelAll"},{"kind":"text","text":"()"}],"abstract":[{"text":"Cancel all of the remaining tasks in the group.","type":"text"}],"title":"cancelAll()","type":"topic","identifier":"doc:\/