{"sections":[],"primaryContentSections":[{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Distributed actors share many characteristics with Swift actors,"},{"type":"text","text":" "},{"type":"text","text":"and include additional isolation checks to ensure"},{"type":"text","text":" "},{"type":"text","text":"location transparency and safety in a distributed environment."},{"type":"text","text":" "},{"type":"text","text":"Similar to how actors make it easier to write concurrent code"},{"type":"text","text":" "},{"type":"text","text":"that’s safe and correct to run on a single computer,"},{"type":"text","text":" "},{"type":"text","text":"distributed actors make it easier to write code"},{"type":"text","text":" "},{"type":"text","text":"that runs across multiple computers."}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"distributed-module"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You use three main parts when writing code with distributed actors:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift language support for distributed actors and for building distributed or RPC systems integrated into the language."},{"type":"text","text":" "},{"type":"text","text":"For more information,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html"},{"type":"text","text":" in "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.swift.org\/swift-book\/"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Distributed module, which includes the types and protocols you need"},{"type":"text","text":" "},{"type":"text","text":"to declare and use distributed actors."},{"type":"text","text":" "},{"type":"text","text":"For exam