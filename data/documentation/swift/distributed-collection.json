{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/distributed-collection"]}],"metadata":{"modules":[{"name":"Swift"}],"roleHeading":"API Collection","title":"Distributed","role":"collectionGroup"},"abstract":[{"text":"Build systems that run distributed code across multiple processes and devices.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Distributed actors share many characteristics with Swift actors,"},{"type":"text","text":" "},{"type":"text","text":"and include additional isolation checks to ensure"},{"type":"text","text":" "},{"type":"text","text":"location transparency and safety in a distributed environment."},{"type":"text","text":" "},{"type":"text","text":"Similar to how actors make it easier to write concurrent code"},{"type":"text","text":" "},{"type":"text","text":"that’s safe and correct to run on a single computer,"},{"type":"text","text":" "},{"type":"text","text":"distributed actors make it easier to write code"},{"type":"text","text":" "},{"type":"text","text":"that runs across multiple computers."}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"distributed-module"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You use three main parts when writing code with distributed actors:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Swift language support for distributed actors and for building distributed or RPC systems integrated into the language."},{"type":"text","text":" "},{"type":"text","text":"For more information,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html","isActive":true,"type":"reference"},{"type":"text","text":" in "},{"identifier":"https:\/\/docs.swift.org\/swift-book\/","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The Distributed module, which includes the types and protocols you need"},{"type":"text","text":" "},{"type":"text","text":"to declare and use distributed actors."},{"type":"text","text":" "},{"type":"text","text":"For example, it has"},{"type":"text","text":" "},{"type":"text","text":"protocols to which distributed actors and distributed actor systems conform,"},{"type":"text","text":" "},{"type":"text","text":"and structures that encapsulate information about calls to a distributed actor."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"distributed actor system"}]},{"type":"text","text":" provides an implementation of the"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem","isActive":true,"type":"reference"},{"type":"text","text":" protocol"},{"type":"text","text":" "},{"type":"text","text":"and coordinates between the cluster’s nodes."},{"type":"text","text":" "},{"type":"text","text":"A distributed actor is always part of some distributed actor system;"},{"type":"text","text":" "},{"type":"text","text":"that distributed actor system handles the serialization and networking"},{"type":"text","text":" "},{"type":"text","text":"necessary to perform remote method calls."},{"type":"text","text":" "},{"type":"text","text":"For local testing, you can use "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/LocalTestingDistributedActorSystem","isActive":true,"type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"For production,"},{"type":"text","text":" "},{"type":"text","text":"you can use "},{"code":"ClusterSystem","type":"codeVoice"},{"type":"text","text":" offered by"},{"type":"text","text":" "},{"text":"the ","type":"text"},{"identifier"