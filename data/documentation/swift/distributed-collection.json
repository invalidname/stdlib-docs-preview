{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Distributed-collection","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Distributed actors share many characteristics with Swift actors,"},{"type":"text","text":" "},{"type":"text","text":"and include additional isolation checks to ensure"},{"type":"text","text":" "},{"type":"text","text":"location transparency and safety in a distributed environment."},{"type":"text","text":" "},{"type":"text","text":"Similar to how actors make it easier to write concurrent code"},{"type":"text","text":" "},{"type":"text","text":"that’s safe and correct to run on a single computer,"},{"type":"text","text":" "},{"type":"text","text":"distributed actors make it easier to write code"},{"text":" ","type":"text"},{"type":"text","text":"that runs across multiple computers."}]},{"inlineContent":[{"identifier":"distributed-module","type":"image"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"You use three main parts when writing code with distributed actors:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift language support for actors and distributed actors."},{"type":"text","text":" "},{"type":"text","text":"For more information,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"isActive":true,"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html"},{"type":"text","text":" in "},{"type":"reference","identifier":"https:\/\/docs.swift.org\/swift-book\/","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The Distributed module, which includes the types and protocols you need","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to declare and use distribute actors.