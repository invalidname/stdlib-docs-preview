","references":{"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"url":"\/documentation\/swift\/enumeratedsequence","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"EnumeratedSequence","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"EnumeratedSequence","kind":"identifier"}],"title":"EnumeratedSequence","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","kind":"symbol","abstract":[{"type":"text","text":"An enumeration of the elements of a sequence or collection."}]},"doc://com.apple.Swift/documentation/Swift/DropFirstSequence":{"navigatorTitle":[{"kind":"identifier","text":"DropFirstSequence"}],"abstract":[{"type":"text","text":"A sequence that lazily consumes and drops "},{"type":"codeVoice","code":"n"},{"text":" elements from an underlying","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"Base"},{"type":"text","text":" iterator before possibly returning the first available element."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"DropFirstSequence","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DropFirstSequence","role":"symbol","url":"\/documentation\/swift\/dropfirstsequence","title":"DropFirstSequence"},"Swift-PageImage-card.png":{"variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png"}],"type":"image","alt":"An orange Swift logo on a gradient background.","identifier":"Swift-PageImage-card.png"},"doc://com.apple.Swift/documentation/Swift/DropFirstSequence/enumerated()":{"abstract":[{"type":"text","text":"Returns a sequence of pairs ("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"x","type":"text"}]},{"