e"},{"type":"text","text":") to the "},{"code":"sorted(by:)","type":"codeVoice"},{"text":" method.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let descendingStudents = students.sorted(by: >)","print(descendingStudents)","\/\/ Prints \"[\"Peter\", \"Kweku\", \"Kofi\", \"Akosua\", \"Abena\"]\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The sorting algorithm is guaranteed to be stable. A stable sort"},{"text":" ","type":"text"},{"text":"preserves the relative order of elements that compare as equal.","type":"text"}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is the length of the sequence.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Complexity"}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/DropFirstSequence":{"role":"symbol","title":"DropFirstSequence","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DropFirstSequence","abstract":[{"type":"text","text":"A sequence that lazily consumes and drops "},{"type":"codeVoice","code":"n"},{"type":"text","text":" elements from an underlying"},{"type":"text","text":" "},{"type":"codeVoice","code":"Base"},{"type":"text","text":" iterator before possibly returning the first available element."}],"navigatorTitle":[{"text":"DropFirstSequence","kind":"identifier"}],"url":"\/documentation\/swift\/dropfirstsequence","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DropFirstSequence","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/DropFirstSequence/sorted()":{"title":"sorted()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","te