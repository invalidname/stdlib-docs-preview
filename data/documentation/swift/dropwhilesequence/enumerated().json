:"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","kind":"symbol","abstract":[{"type":"text","text":"An enumeration of the elements of a sequence or collection."}]},"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","type":"topic","role":"collection","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","title":"Swift","kind":"symbol","images":[{"identifier":"Swift-PageImage-card.png","type":"card"}]},"doc://com.apple.Swift/documentation/Swift/DropWhileSequence":{"kind":"symbol","url":"\/documentation\/swift\/dropwhilesequence","role":"symbol","title":"DropWhileSequence","abstract":[{"text":"A sequence that lazily consumes and drops ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" elements from an underlying","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Base"},{"text":" iterator before possibly returning the first available element.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DropWhileSequence"}],"navigatorTitle":[{"kind":"identifier","text":"DropWhileSequence"}],"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DropWhileSequence"}}}