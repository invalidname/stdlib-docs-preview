":"EnumeratedSequence","type":"topic","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnumeratedSequence","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/DropWhileSequence":{"abstract":[{"type":"text","text":"A sequence that lazily consumes and drops "},{"type":"codeVoice","code":"n"},{"type":"text","text":" elements from an underlying"},{"type":"text","text":" "},{"type":"codeVoice","code":"Base"},{"type":"text","text":" iterator before possibly returning the first available element."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DropWhileSequence"}],"url":"\/documentation\/swift\/dropwhilesequence","title":"DropWhileSequence","type":"topic","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DropWhileSequence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DropWhileSequence"}]}}}