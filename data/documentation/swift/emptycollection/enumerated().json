ated()","kind":"symbol","type":"topic","url":"\/documentation\/swift\/emptycollection\/enumerated()","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EmptyCollection\/enumerated()","role":"symbol"},"doc://com.apple.Swift/documentation/Swift/EmptyCollection":{"navigatorTitle":[{"kind":"identifier","text":"EmptyCollection"}],"url":"\/documentation\/swift\/emptycollection","abstract":[{"text":"A collection whose element type is ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" but that is always empty.","type":"text"}],"kind":"symbol","title":"EmptyCollection","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EmptyCollection","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EmptyCollection"}]},"Swift-PageImage-card.png":{"identifier":"Swift-PageImage-card.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png"}],"alt":"An orange Swift logo on a gradient background."}}}