"},{"text":"rethrows","kind":"keyword"},{"text":" -> [","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://com.apple.Swift/documentation/Swift/EmptyCollection/Iterator":{"url":"\/documentation\/swift\/emptycollection\/iterator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Iterator"}],"kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EmptyCollection\/Iterator","title":"EmptyCollection.Iterator","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Iterator"}],"abstract":[{"type":"text","text":"An iterator that never produces an element."}],"type":"topic"}}}