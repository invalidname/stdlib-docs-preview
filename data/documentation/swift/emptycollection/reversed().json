rints \"sdrawkcaB\""]},{"type":"aside","name":"Complexity","style":"note","content":[{"inlineContent":[{"type":"text","text":"O(1)"}],"type":"paragraph"}]}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/EmptyCollection":{"role":"symbol","title":"EmptyCollection","navigatorTitle":[{"kind":"identifier","text":"EmptyCollection"}],"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EmptyCollection","url":"\/documentation\/swift\/emptycollection","abstract":[{"type":"text","text":"A collection whose element type is "},{"code":"Element","type":"codeVoice"},{"text":" but that is always empty.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"EmptyCollection"}]},"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/EmptyCollection/reversed()":{"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swift\/emptycollection\/reversed()","title":"reversed()","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EmptyCollection\/reversed()","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"reversed"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:s18ReversedCollectionV","text":"ReversedCollection","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"Returns a view presenting the elements of the collection in reverse"},{"type":"text","text":" "},{"type":"text","text":"order."}]},"doc://com.apple.Sw