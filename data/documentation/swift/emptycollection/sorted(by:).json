.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EmptyCollection","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EmptyCollection","role":"symbol","url":"\/documentation\/swift\/emptycollection","title":"EmptyCollection"}}}