 return. If ","type":"text"},{"type":"codeVoice","code":"maxSplits + 1"},{"text":" ","type":"text"},{"text":"subsequences are returned, the last one is a suffix of the original","type":"text"},{"text":" ","type":"text"},{"text":"sequence containing the remaining elements. ","type":"text"},{"type":"codeVoice","code":"maxSplits"},{"text":" must be","type":"text"},{"text":" ","type":"text"},{"text":"greater than or equal to zero. The default value is ","type":"text"},{"type":"codeVoice","code":"Int.max"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"omittingEmptySubsequences","content":[{"inlineContent":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", an empty subsequence is","type":"text"},{"text":" ","type":"text"},{"text":"returned in the result for each consecutive pair of ","type":"text"},{"type":"codeVoice","code":"separator"},{"text":" ","type":"text"},{"text":"elements in the sequence and for each instance of ","type":"text"},{"type":"codeVoice","code":"separator"},{"text":" at the","type":"text"},{"text":" ","type":"text"},{"text":"start or end of the sequence. If ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", only nonempty subsequences","type":"text"},{"text":" ","type":"text"},{"text":"are returned. The default value is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An array of subsequences, split from this sequence’s elements."}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The resulting array consists of at most "},{"type":"codeVoice","code":"maxSplits + 1"},{"type":"text","text":" subsequences."},{"type":"text","text":" "},{"type":"text","text":"Elements that are use