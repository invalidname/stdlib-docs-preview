Slice[0])","\/\/ error: Index out of bounds"],"type":"codeListing","syntax":"swift"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1)"}]}],"type":"aside","name":"Complexity"}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"Accesses the contiguous subrange of the collection’s elements specified","type":"text"},{"text":" ","type":"text"},{"text":"by a range expression.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"role":"symbol","symbolKind":"subscript","title":"subscript(_:)","extendedModule":"Swift","roleHeading":"Instance Subscript","externalID":"s:SlsEy11SubSequenceQzqd__cSXRd__5BoundQyd__5IndexRtzluip::SYNTHESIZED::s:s15EmptyCollectionV","fragments":[{"text":"subscript","kind":"keyword"},{"text":"<","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"R","preciseIdentifier":"s:SlsEy11SubSequenceQzqd__cSXRd__5BoundQyd__5IndexRtzluip1RL_qd__mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sl11SubSequenceQa","text":"SubSequence","kind":"typeIdentifier"}],"modules":[{"name":"Swift"}],"platforms":[{"introducedAt":"8.0","deprecated":false,"beta":false,"unavailable":false,"name":"iOS"},{"introducedAt":"8.0","deprecated":false,"beta":false,"unavailable":false,"name":"iPadOS"},{"introducedAt":"13.0","deprecated":false,"beta":false,"unavailable":false,"name":"Mac Catalyst"},{"name":"macOS","beta":false,"deprecated":false,"introducedAt":"10.10","unavailable":false},{"name":"tvOS","beta":false,"deprecated":false,"introducedAt":"9.0","unavailable":false},{"introducedAt":"1.0","deprecated":false,"beta":false,"unavailable":false,"name":"visionOS"},{"introducedAt":"2.0","deprecated":false,"beta":false,"unavailable":false,"name":"watchOS"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/emptycollection\/subscript(_:)-2eo9o"]}],"identifier":{"interfaceLanguage":"swift","