 is never executed"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"initialResult","type":"codeVoice"},{"type":"text","text":" is the result of the call to "},{"code":"reduce(_:_:)","type":"codeVoice"},{"type":"text","text":"."}]},{"name":"Complexity","style":"note","type":"aside","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is the length of the sequence.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/enumeratedsequence\/iterator\/reduce(_:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence\/Iterator"]]},"metadata":{"role":"symbol","roleHeading":"Instance Method","modules":[{"name":"Standard Library"}],"title":"reduce(_:_:)","externalID":"s:STsE6reduceyqd__qd___qd__qd___7ElementQztKXEtKlF::SYNTHESIZED::s:s18EnumeratedSequenceV8IteratorV","extendedModule":"Swift","platforms":[{"introducedAt":"8.0","unavailable":false,"beta":false,"name":"iOS","deprecated":false},{"introducedAt":"8.0","unavailable":false,"beta":false,"name":"iPadOS","deprecated":false},{"introducedAt":"13.0","unavailable":false,"beta":false,"name":"Mac Catalyst","deprecated":false},{"introducedAt":"10.10","unavailable":false,"beta":false,"name":"macOS","deprecated":false},{"introducedAt":"9.0","unavailable":false,"beta":false,"name":"tvOS","deprecated":false},{"introducedAt":"1.0","unavailable":false,"beta":false,"name":"visionOS","deprecated":false},{"introducedAt":"2.0","unavailable":false,"beta":false,"name":"watchOS","deprecated":false}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reduce","kind":"iden