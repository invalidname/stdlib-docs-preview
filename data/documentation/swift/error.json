{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"title":"Inherits From","kind":"relationships","type":"inheritsFrom"},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystemError","doc:\/\/com.apple.Swift\/documentation\/_RegexParser\/LocatedErrorProtocol"],"title":"Inherited By","kind":"relationships","type":"inheritedBy"},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/DecodingError","doc:\/\/com.apple.Swift\/documentation\/_RegexParser\/DelimiterLexError","doc:\/\/com.apple.Swift\/documentation\/Runtime\/DemanglingError","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorCodingError","doc:\/\/com.apple.Swift\/documentation\/Swift\/EncodingError","doc:\/\/com.apple.Swift\/documentation\/Distributed\/ExecuteDistributedTargetError","doc:\/\/com.apple.Swift\/documentation\/Distributed\/LocalTestingDistributedActorSystemError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Never","doc:\/\/com.apple.Swift\/documentation\/_RegexParser\/Source\/LocatedError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF8\/ValidationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF8\/ValidationError\/Kind-swift.struct","doc:\/\/com.apple.Swift\/documentation\/_RegexParser\/Unreachable","doc:\/\/com.apple.Swift\/documentation\/_RegexParser\/Unsupported"],"title":"Conforming Types","kind":"relationships","type":"conformingTypes"}],"variants":[{"paths":["\/documentation\/swift\/error"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Result"],"generated":true,"title":"Errors","anchor":"Errors"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Error"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Any type that declares conformance to the "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" protocol can be used to"},{"type":"text","text":" "},{"type":"text","text":"represent an error in Swift’s error handling system. Because the "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" "},{"type":"text","text":"protocol has no requirements of its own, you can declare conformance on"},{"type":"text","text":" "},{"type":"text","text":"any custom type you create."}],"type":"paragraph"},{"level":1,"type":"heading","text":"Using Enumerations as Errors","anchor":"Using-Enumerations-as-Errors"},{"inlineContent":[{"type":"text","text":"Swift’s enumerations are well suited to represent simple errors. Create an"},{"type":"text","text":" "},{"type":"text","text":"enumeration that conforms to the "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" protocol with a case for each"},{"type":"text","text":" "},{"type":"text","text":"possible error. If there are additional details about the error that could"},{"type":"text","text":" "},{"type":"text","text":"be helpful for recovery, use associated values to include that"},{"type":"text","text":" "},{"type":"text","text":"information."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example shows an "},{"type":"codeVoice","code":"IntParsingError"},{"type":"text","text":" enumeration that captures"},{"type":"text","text":" "},{"type":"text","text":"two different kinds of errors that can occur when parsing an integer from"},{"type":"text","text":" "},{"type":"text","text":"a string: overflow, where the value represented by the string is too large"},{"type":"text","text":" "},{"type":"text","text":"for the integer data type, and invalid input, where nonnumeric characters"},{"type":"text","text":" "},{"type":"text","text":"are found within the input."}],"type":"paragraph"},{"syntax":"swift","code":["enum IntParsingError: Error {","    case overflow","    case invalidInput(Character)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"invalidInput"},{"type":"text","text":" case includes the invalid character as an associated"},{"type":"text","text":" "},{"type":"text","text":"value."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The next code sample shows a possible extension to the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" type that"},{"type":"text","text":" "},{"type":"text","text":"parses the integer value of a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" instance, throwing an error when"},{"type":"text","text":" "},{"type":"text","text":"there is a problem during parsing."}],"type":"paragraph"},{"syntax":"swift","code":["extension Int {","    init(validating input: String) throws {","        \/\/ ...","        let c = _nextCharacter(from: input)","        if !_isValid(c) {","            throw IntParsingError.invalidInput(c)","        }","        \/\/ ...","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"When calling the new ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" initializer within a ","type":"text"},{"code":"do","type":"codeVoice"},{"type":"text","text":" statement, you can use"},{"type":"text","text":" "},{"type":"text","text":"pattern matching to match specific cases of your custom error type and"},{"type":"text","text":" "},{"type":"text","text":"access their associated values, as in the example below."}]},{"type":"codeListing","code":["do {","    let price = try Int(validating: \"$100\")","} catch IntParsingError.invalidInput(let invalid) {","    print(\"Invalid character: '\\(invalid)'\")","} catch IntParsingError.overflow {","    print(\"Overflow error\")","} catch {","    print(\"Other error\")","}","\/\/ Prints \"Invalid character: '$'\""],"syntax":"swift"},{"type":"heading","level":1,"text":"Including More Data in Errors","anchor":"Including-More-Data-in-Errors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sometimes you may want different error states to include the same common"},{"type":"text","text":" "},{"type":"text","text":"data, such as the position in a file or some of your application’s state."},{"type":"text","text":" "},{"type":"text","text":"When you do, use a structure to represent errors. The following example"},{"type":"text","text":" "},{"type":"text","text":"uses a structure to represent an error when parsing an XML document,"},{"type":"text","text":" "},{"type":"text","text":"including the line and column numbers where the error occurred:"}]},{"type":"codeListing","code":["struct XMLParsingError: Error {","    enum Kind {","        case invalidCharacter","        case mismatchedTag","        case internalError","    }","","    let line: Int","    let column: Int","    let kind: Kind","}","","func parse(_ source: String) throws -> XMLDoc {","    \/\/ ...","    throw XMLParsingError(line: 19, column: 5, kind: .mismatchedTag)","    \/\/ ...","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once again, use pattern matching to conditionally catch errors. Here’s how"},{"type":"text","text":" "},{"type":"text","text":"you can catch any "},{"code":"XMLParsingError","type":"codeVoice"},{"type":"text","text":" errors thrown by the "},{"code":"parse(_:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"function:"}]},{"type":"codeListing","code":["do {","    let xmlDoc = try parse(myXMLData)","} catch let e as XMLParsingError {","    print(\"Parsing error: \\(e.kind) [\\(e.line):\\(e.column)]\")","} catch {","    print(\"Other error: \\(error)\")","}","\/\/ Prints \"Parsing error: mismatchedTag [19:5]\""],"syntax":"swift"}],"kind":"content"}],"metadata":{"modules":[{"name":"Swift"}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Error","kind":"identifier"}],"externalID":"s:s5ErrorP","platforms":[{"beta":false,"unavailable":false,"name":"iOS","introducedAt":"8.0","deprecated":false},{"beta":false,"unavailable":false,"name":"iPadOS","introducedAt":"8.0","deprecated":false},{"beta":false,"unavailable":false,"name":"Mac Catalyst","introducedAt":"13.0","deprecated":false},{"beta":false,"unavailable":false,"name":"macOS","introducedAt":"10.10","deprecated":false},{"beta":false,"unavailable":false,"name":"tvOS","introducedAt":"9.0","deprecated":false},{"beta":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0","deprecated":false},{"beta":false,"unavailable":false,"name":"watchOS","introducedAt":"2.0","deprecated":false}],"title":"Error","symbolKind":"protocol","navigatorTitle":[{"text":"Error","kind":"identifier"}],"roleHeading":"Protocol"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"abstract":[{"type":"text","text":"A type representing an error value that can be thrown."}],"references":{"doc://com.apple.Swift/documentation/Swift/Sendable":{"type":"topic","abstract":[{"text":"A thread-safe type whose values can be shared across arbitrary isolation","type":"text"},{"text":" ","type":"text"},{"text":"domains without introducing a risk of data races.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","title":"Sendable","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind