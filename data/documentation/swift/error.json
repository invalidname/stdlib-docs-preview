{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error"},"metadata":{"externalID":"s:s5ErrorP","platforms":[{"introducedAt":"8.0","beta":false,"deprecated":false,"name":"iOS","unavailable":false},{"introducedAt":"8.0","beta":false,"deprecated":false,"name":"iPadOS","unavailable":false},{"introducedAt":"13.0","beta":false,"deprecated":false,"name":"Mac Catalyst","unavailable":false},{"introducedAt":"10.10","beta":false,"deprecated":false,"name":"macOS","unavailable":false},{"introducedAt":"9.0","beta":false,"deprecated":false,"name":"tvOS","unavailable":false},{"introducedAt":"1.0","beta":false,"deprecated":false,"name":"visionOS","unavailable":false},{"introducedAt":"2.0","beta":false,"deprecated":false,"name":"watchOS","unavailable":false}],"role":"symbol","symbolKind":"protocol","modules":[{"name":"Standard Library"}],"navigatorTitle":[{"kind":"identifier","text":"Error"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Error"}],"roleHeading":"Protocol","title":"Error"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"sections":[],"abstract":[{"type":"text","text":"A type representing an error value that can be thrown."}],"relationshipsSections":[{"kind":"relationships","type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"]},{"kind":"relationships","type":"inheritedBy","title":"Inherited By","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystemError"]},{"kind":"relationships","type":"conformingTypes","title":"Conforming Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/DecodingError","doc:\/\/com.apple.Swift\/documentation\/Runtime\/DemanglingError","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorCodingError","doc:\/\/com.apple.Swift\/documentation\/Swift\/EncodingError","doc:\/\/com.apple.Swift\/documentation\/Distributed\/ExecuteDistributedTargetError","doc:\/\/com.apple.Swift\/documentation\/Distributed\/LocalTestingDistributedActorSystemError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Never","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF8\/ValidationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF8\/ValidationError\/Kind-swift.struct"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"generated":true,"anchor":"Errors","title":"Errors","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Result"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Error"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","preciseIdentifier":"s:s8SendableP"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any type that declares conformance to the "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" protocol can be used to"},{"type":"text","text":" "},{"type":"text","text":"represent an error in Swift’s error handling system. Because the "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" "},{"type":"text","text":"protocol has no requirements of its own, you can declare conformance on"},{"type":"text","text":" "},{"type":"text","text":"any custom type you create."}]},{"type":"heading","text":"Using Enumerations as Errors","anchor":"Using-Enumerations-as-Errors","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift’s enumerations are well suited to represent simple errors. Create an"},{"type":"text","text":" "},{"type":"text","text":"enumeration that conforms to the "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" protocol with a case for each"},{"type":"text","text":" "},{"type":"text","text":"possible error. If there are additional details about the error that could"},{"type":"text","text":" "},{"type":"text","text":"be helpful for recovery, use associated values to include that"},{"type":"text","text":" "},{"type":"text","text":"information."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example shows an "},{"type":"codeVoice","code":"IntParsingError"},{"type":"text","text":" enumeration that captures"},{"type":"text","text":" "},{"type":"text","text":"two different kinds of errors that can occur when parsing an integer from"},{"type":"text","text":" "},{"type":"text","text":"a string: overflow, where the value represented by the string is too large"},{"type":"text","text":" "},{"type":"text","text":"for the integer data type, and invalid input, where nonnumeric characters"},{"type":"text","text":" "},{"type":"text","text":"are found within the input."}]},{"type":"codeListing","syntax":"swift","code":["enum IntParsingError: Error {","    case overflow","    case invalidInput(Character)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"invalidInput"},{"type":"text","text":" case includes the invalid character as an associated"},{"type":"text","text":" "},{"type":"text","text":"value."}]},{"inlineContent":[{"type":"text","text":"The next code sample shows a possible extension to the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" type that"},{"type":"text","text":" "},{"type":"text","text":"parses the integer value of a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" instance, throwing an error when"},{"type":"text","text":" "},{"type":"text","text":"there is a problem during parsing."}],"type":"paragraph"},{"syntax":"swift","code":["extension Int {","    init(validating input: String) throws {","        \/\/ ...","        let c = _nextCharacter(from: input)","        if !_isValid(c) {","            throw IntParsingError.invalidInput(c)","        }","        \/\/ ...","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"When calling the new ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" initializer within a ","type":"text"},{"code":"do","type":"codeVoice"},{"text":" statement, you can use","type":"text"},{"text":" ","type":"text"},{"text":"pattern matching to match specific cases of your custom error type and","type":"text"},{"text":" ","type":"text"},{"text":"access their associated values, as in the example below.","type":"text"}]},{"code":["do {","    let price = try Int(validating: \"$100\")","} catch IntParsingError.invalidInput(let invalid) {","    print(\"Invalid character: '\\(invalid)'\")","} catch IntParsingError.overflow {","    print(\"Overflow error\")","} catch {","    print(\"Other error\")","}","\/\/ Prints \"Invalid character: '$'\""],"syntax":"swift","type":"codeListing"},{"type":"heading","text":"Including More Data in Errors","anchor":"Including-More-Data-in-Errors","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sometimes you may want different error states to include the same common"},{"type":"text","text":" "},{"type":"text","text":"data, such as the position in a file or some of your application’s state."},{"type":"text","text":" "},{"type":"text","text":"When you do, use a structure to represent errors. The following example"},{"type":"text","text":" "},{"type":"text","text":"uses a structure to represent an error when parsing an XML document,"},{"type":"text","text":" "},{"type":"text","text":"including the line and column numbers where the error occurred:"}]},{"type":"codeListing","code":["struct XMLParsingError: Error {","    enum Kind {","        case invalidCharacter","        case mismatchedTag","        case internalError","    }","","    let line: Int","    let column: Int","    let kind: Kind","}","","func parse(_ source: String) throws -> XMLDoc {","    \/\/ ...","    throw XMLParsingError(line: 19, column: 5, kind: .mismatchedTag)","    \/\/ ...","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once again, use pattern matching to conditionally catch errors. Here’s how"},{"type":"text","text":" "},{"type":"text","text":"you can catch any "},{"type":"codeVoice","code":"XMLParsingError"},{"type":"text","text":" errors thrown by the "},{"type":"codeVoice","code":"parse(_:)"},{"type":"text","text":" "},{"type":"text","text":"function:"}]},{"syntax":"swift","type":"codeListing","code":["do {","    let xmlDoc = try parse(myXMLData)","} catch let e as XMLParsingError {","    print(\"Parsing error: \\(e.kind) [\\(e.line):\\(e.column)]\")","} catch {","    print(\"Other error: \\(error)\")","}","\/\/ Prints \"Parsing error: mismatchedTag [19:5]\""]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/error"]}],"references":{"doc://com.apple.Swift/documentation/Distributed/DistributedActorSystem/executeDistributedTarget(on:target:invocationDecoder:handler:)":{"type":"topic","kind":"symbol","role":"symbol","abstract":[],"url":"\/documentation\/distributed\/distributedactorsystem\/executedistributedtarget(on:target:invocationdecoder:handler:)","title":"executeDistributedTarget(on:target:invocationDecoder:handler:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystem\/executeDistributedTarget(on:target:invocationDecoder:handler:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"executeDistributedTarget","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Act","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"}