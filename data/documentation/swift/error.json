{"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"type":"inheritsFrom","kind":"relationships"},{"title":"Inherited By","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorSystemError","doc:\/\/com.apple.Swift\/documentation\/_RegexParser\/LocatedErrorProtocol"],"type":"inheritedBy","kind":"relationships"},{"title":"Conforming Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/DecodingError","doc:\/\/com.apple.Swift\/documentation\/_RegexParser\/DelimiterLexError","doc:\/\/com.apple.Swift\/documentation\/Runtime\/DemanglingError","doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActorCodingError","doc:\/\/com.apple.Swift\/documentation\/Swift\/EncodingError","doc:\/\/com.apple.Swift\/documentation\/Distributed\/ExecuteDistributedTargetError","doc:\/\/com.apple.Swift\/documentation\/Distributed\/LocalTestingDistributedActorSystemError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Never","doc:\/\/com.apple.Swift\/documentation\/_RegexParser\/Source\/LocatedError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF8\/ValidationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF8\/ValidationError\/Kind-swift.struct","doc:\/\/com.apple.Swift\/documentation\/_RegexParser\/Unreachable","doc:\/\/com.apple.Swift\/documentation\/_RegexParser\/Unsupported"],"type":"conformingTypes","kind":"relationships"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"abstract":[{"text":"A type representing an error value that can be thrown.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Error","kind":"identifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any type that declares conformance to the "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" protocol can be used to"},{"type":"text","text":" "},{"type":"text","text":"represent an error in Swift’s error handling system. Because the "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" "},{"type":"text","text":"protocol has no requirements of its own, you can declare conformance on"},{"type":"text","text":" "},{"text":"any custom type you create.","type":"text"}]},{"level":1,"text":"Using Enumerations as Errors","anchor":"Using-Enumerations-as-Errors","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Swift’s enumerations are well suited to represent simple errors. Create an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"enumeration that conforms to the "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" protocol with a case for each"},{"type":"text","text":" "},{"type":"text","text":"possible error. If there are additional details about the error that could"},{"type":"text","text":" "},{"type":"text","text":"be helpful for recovery, use associated values to include that"},{"type":"text","text":" "},{"type":"text","text":"information."}]},{"type":"paragraph","inlineContent":[{"text":"The following example shows an ","type":"text"},{"code":"IntParsingError","type":"codeVoice"},{"text":" enumeration that captures","type":"text"},{"text":" ","type":"text"},{"text":"two different kinds of errors that can occur when parsing an integer from","type":"text"},{"text":" ","type":"text"},{"text":"a string: overflow, where the value represented by the string is too large","type":"text"},{"text":" ","type":"text"},{"text":"for the integer data type, and invalid input, where nonnumeric characters","type":"text"},{"text":" ","type":"text"},{"text":"are found within the input.","type":"text"}]},{"syntax":"swift","code":["enum IntParsingError: Error {","    case overflow","    case invalidInput(Character)","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"invalidInput","type":"codeVoice"},{"text":" case includes the invalid character as an associated","type":"text"},{"type":"text","text":" "},{"type":"text","text":"value."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The next code sample shows a possible extension to the "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" type that"},{"type":"text","text":" "},{"type":"text","text":"parses the integer value of a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" instance, throwing an error when"},{"type":"text","text":" "},{"type":"text","text":"there is a problem during parsing."}],"type":"paragraph"},{"code":["extension Int {","    init(validating input: String) throws {","        \/\/ ...","        let c = _nextCharacter(from: input)","        if !_isValid(c) {","            throw IntParsingError.invalidInput(c)","        }","        \/\/ ...","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When calling the new "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" initializer within a "},{"type":"codeVoice","code":"do"},{"type":"text","text":" statement, you can use"},{"type":"text","text":" "},{"type":"text","text":"pattern matching to match specific cases of your custom error type and"},{"type":"text","text":" "},{"type":"text","text":"access their associated values, as in the example below."}]},{"code":["do {","    let price = try Int(validating: \"$100\")","} catch IntParsingError.invalidInput(let invalid) {","    print(\"Invalid character: '\\(invalid)'\")","} catch IntParsingError.overflow {","    print(\"Overflow error\")","} catch {","    print(\"Other error\")","}","\/\/ Prints \"Invalid character: '$'\""],"type":"codeListing","syntax":"swift"},{"type":"heading","level":1,"text":"Including More Data in Errors","anchor":"Including-More-Data-in-Errors"},{"inlineContent":[{"text":"Sometimes you may want different error states to include the same common","type":"text"},{"text":" ","type":"text"},{"text":"data, such as the position in a file or some of your application’s state.","type":"text"},{"text":" ","type":"text"},{"text":"When you do, use a structure to represent errors. The following example","type":"text"},{"text":" ","type":"text"},{"text":"uses a structure to represent an error when parsing an XML document,","type":"text"},{"text":" ","type":"text"},{"text":"including the line and column numbers where the error occurred:","type":"text"}],"type":"paragraph"},{"code":["struct XMLParsingError: Error {","    enum Kind {","        case invalidCharacter","        case mismatchedTag","        case internalError","    }","","    let line: Int","    let column: Int","    let kind: Kind","}","","func parse(_ source: String) throws -> XMLDoc {","    \/\/ ...","    throw XMLParsingError(line: 19, column: 5, kind: .mismatchedTag)","    \/\/ ...","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Once again, use pattern matching to conditionally catch errors. Here’s how"},{"type":"text","text":" "},{"text":"you can catch any ","type":"text"},{"code":"XMLParsingError","type":"codeVoice"},{"text":" errors thrown by the ","type":"text"},{"code":"parse(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"function:","type":"text"}],"type":"paragraph"},{"code":["do {","    let xmlDoc = try parse(myXMLData)","} catch let e as XMLParsingError {","    print(\"Parsing error: \\(e.kind) [\\(e.line):\\(e.column)]\")","} catch {","    print(\"Other error: \\(error)\")","}","\/\/ Prints \"Parsing error: mismatchedTag [19:5]\""],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/error"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"platforms":[{"deprecated":false,"beta":false,"unavailable":false,"name":"iOS","introducedAt":"8.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"iPadOS","introducedAt":"8.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"Mac Catalyst","introducedAt":"13.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"macOS","introducedAt":"10.10"},{"deprecated":false,"beta":false,"unavailable":false,"name":"tvOS","introducedAt":"9.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"watchOS","introducedAt":"2.0"}],"roleHeading":"Protocol","externalID":"s:s5ErrorP","symbolKind":"protocol","navigatorTitle":[{"text":"Error","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Error","kind":"identifier"}],"role":"symbol","modules":[{"name":"Swift"}],"title":"Error"},"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Errors","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Result"],"anchor":"Errors","generated":true}],"references":{"doc://com.apple.Swift/documentation/Runtime/DemanglingError":{"type":"topic","abstract":[{"text":"Error thrown to indicate failure to demangle a Swift symbol.","type":"text"}],"kind":"symbol","title":"DemanglingError","url":"\/documentation\/runtime\/demanglingerror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DemanglingError","kind":"identifier"}],"navigatorTitle":[{"text":"DemanglingError","kind":"identifier"}],"role":"symbol","identifier":"d