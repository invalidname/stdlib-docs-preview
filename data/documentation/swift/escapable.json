xt"},{"text":" ","type":"text"},{"text":"scopes freely because they lack any lifetime dependencies.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In contrast, values of types that suppress their implicit conformance to "},{"type":"codeVoice","code":"Escapable"},{"type":"text","text":" (by writing "},{"type":"codeVoice","code":"~Escapable"},{"text":")","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"carry a lifetime dependency. These dependencies ensure the "},{"code":"~Escapable","type":"codeVoice"},{"type":"text","text":" value does not live longer than the value it"},{"text":" ","type":"text"},{"type":"text","text":"depends on. Explicit lifetime dependency annotations may be required when working with these types."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In generic contexts, "},{"code":"~Escapable","type":"codeVoice"},{"text":" works much in the same way as ","type":"text"},{"code":"~Copyable","type":"codeVoice"},{"text":". It allows functions and types to work","type":"text"},{"text":" ","type":"text"},{"text":"with values that may or may not be Escapable, and types can be conditionally ","type":"text"},{"type":"codeVoice","code":"Escapable"},{"text":" based on their generic","type":"text"},{"type":"text","text":" "},{"type":"text","text":"arguments. A conformance requirement for "},{"code":"Escapable","type":"codeVoice"},{"text":" is automatically inferred in extensions and for generic type","type":"text"},{"type":"text","text":" "},{"text":"parameters, unless suppressed with ","type":"text"},{"type":"codeVoice","code":"~Escapable"},{"text":".","type":"text"}],"type":"paragraph"}]}],"seeAlsoSections":[{"title":"Copying","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/BitwiseCopyable"],"generated":true,"anchor":"Copying"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/escapable"]