{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Escapable","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","title":"Escapable","modules":[{"name":"Standard Library"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Escapable"}],"navigatorTitle":[{"kind":"identifier","text":"Escapable"}],"externalID":"s:s9EscapableP","platforms":[{"name":"iOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"8.0"},{"name":"iPadOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"8.0"},{"name":"Mac Catalyst","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"13.0"},{"name":"macOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"10.10"},{"name":"tvOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"9.0"},{"name":"visionOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"1.0"},{"name":"watchOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"2.0"}],"symbolKind":"protocol","roleHeading":"Protocol"},"abstract":[{"text":"A type whose values can persist beyond their immediate local scope.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Escapable","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"inlineContent":[{"text":"Escapable values can be assigned to global or static variables, returned from functions, captured by escaping","type":"text"},{"text":" ","type":"text"},{"text":"closures, and so on. All Swift types implicitly conform to this protocol by default, allowing them to be moved across","type":"text"},{"text":" ","type":"text"},{"text":"scopes freely because they lack any lifetime dependencies.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In contrast, values of types that suppress their implicit conformance to ","type":"text"},{"code":"Escapable","type":"codeVoice"},{"text":" (by writing ","type":"text"},{"code":"~Escapable","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"carry a lifetime dependency. These dependencies ensure the ","type":"text"},{"code":"~Escapable","type":"codeVoice"},{"text":" value does not live longer than the value it","type":"text"},{"text":" ","type":"text"},{"text":"depends on. Explicit lifetime dependency annotations may be required when working with these types.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In generic contexts, ","type":"text"},{"code":"~Escapable","type":"codeVoice"},{"text":" works much in the same way as ","type":"text"},{"code":"~Copyable","type":"codeVoice"},{"text":". It allows functions and types to work","type":"text"},{"text":" ","type":"text"},{"text":"with values that may or may not be Escapable, and types can be conditionally ","type":"text"},{"code":"Escapable","type":"codeVoice"},{"text":" based on their generic","type":"text"},{"text":" ","type":"text"},{"text":"arguments. A conformance requirement for ","type":"text"},{"code":"Escapable","type":"codeVoice"},{"text":" is automatically inferred in extensions and for generic type","type":"text"},{"text":" ","type":"text"},{"text":"parameters, unless suppressed with ","type":"text"},{"code":"~Escapable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"kind":"symbol","sections":[],"seeAlsoSections":[{"title":"Copying","generated":true,"anchor":"Copying","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/BitwiseCopyable"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swif