{"abstract":[{"type":"text","text":"A type whose values can persist beyond their immediate local scope."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"sections":[],"metadata":{"symbolKind":"protocol","title":"Escapable","navigatorTitle":[{"text":"Escapable","kind":"identifier"}],"platforms":[{"name":"iOS","introducedAt":"8.0","unavailable":false,"deprecated":false,"beta":false},{"name":"iPadOS","introducedAt":"8.0","unavailable":false,"deprecated":false,"beta":false},{"name":"Mac Catalyst","introducedAt":"13.0","unavailable":false,"deprecated":false,"beta":false},{"name":"macOS","introducedAt":"10.10","unavailable":false,"deprecated":false,"beta":false},{"name":"tvOS","introducedAt":"9.0","unavailable":false,"deprecated":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","unavailable":false,"deprecated":false,"beta":false},{"name":"watchOS","introducedAt":"2.0","unavailable":false,"deprecated":false,"beta":false}],"externalID":"s:s9EscapableP","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Escapable","kind":"identifier"}],"modules":[{"name":"Standard Library"}],"roleHeading":"Protocol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/escapable"]}],"kind":"symbol","seeAlsoSections":[{"generated":true,"anchor":"Copying","title":"Copying","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/BitwiseCopyable"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Escapable"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Escapable","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Escapable values can be assigned to global or static variables, returned from functions, captured by escaping"},{"type":"text","text":" "},{"type":"text","text":"closures, and so on. All Swift types implicitly conform to this protocol by default, allowing them to be moved across"},{"type":"text","text":" "},{"type":"text","text":"scopes freely because they lack any lifetime dependencies."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In contrast, values of types that suppress their implicit conformance to "},{"type":"codeVoice","code":"Escapable"},{"type":"text","text":" (by writing "},{"type":"codeVoice","code":"~Escapable"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"carry a lifetime dependency. These dependencies ensure the ","type":"text"},{"type":"codeVoice","code":"~Escapable"},{"text":" value does not live longer than the value it","type":"text"},{"text":" ","type":"text"},{"text":"depends on. Explicit lifetime dependency annotations may be required when working with these types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In generic contexts, "},{"code":"~Escapable","type":"codeVoice"},{"text":" works much in the same way as ","type":"text"},{"code":"~Copyable","type":"codeVoice"},{"text":". It allows functions and types to work","type":"text"},{"text":" ","type":"text"},{"text":"with values that may or may not be Escapable, and types can be conditionally ","type":"text"},{"code":"Escapable","type":"codeVoice"},{"text":" based on their generic","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"arguments. A conformance requirement for "},{"type":"codeVoice","code":"Escapable"},{"text":" is automatically inferred in extensions and for generic type","type":"text"},{"type":"text","text":" "},{"type":"text","text":"parameters, unless suppressed with "},{"type":"codeVoice","code":"~Escapable"},{"type":"text","text":"."}]}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Escapable":{"title":"Escapable","url":"\/documentation\/swift\/escapable","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Escapable"}],"navigatorTitle":[{"text":"Escapable","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A type whose values can persist beyond their immediate local scope.","type":"text"}],"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Escapable"},"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/Copyable":{"abstract":[{"type":"text","text":"A type whose values can be implicitly or explicitly copied."}],"navigatorTitle":[{"kind":"identifier","text":"Copyable"}],"title":"Copyable","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Copyable"}],"url":"\/documentation\/swift\/copyable","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable"},"doc://com.apple.Swift/documentation/Swift/BitwiseCopyable":{"role":"symbol","title":"BitwiseCopyable","navigatorTitle":[{"kind":"identifier","text":"BitwiseCopyable"}],"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BitwiseCopyable","url":"\/documentation\/swift\/bitwisecopyable","abstract":[],"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BitwiseCopyable"}]}}}