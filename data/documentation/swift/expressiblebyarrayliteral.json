{"kind":"symbol","relationshipsSections":[{"kind":"relationships","type":"inheritedBy","title":"Inherited By","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Cxx\/CxxSet","doc:\/\/com.apple.Swift\/documentation\/Cxx\/CxxUniqueSet","doc:\/\/com.apple.Swift\/documentation\/Cxx\/CxxVector","doc:\/\/com.apple.Swift\/documentation\/Swift\/OptionSet","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD","doc:\/\/com.apple.Swift\/documentation\/Swift\/SetAlgebra"]},{"kind":"relationships","type":"conformingTypes","title":"Conforming Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Array","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/DifferentiableView","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice","doc:\/\/com.apple.Swift\/documentation\/Runtime\/Backtrace\/SymbolicationOptions","doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray","doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationTracking\/Options","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD16","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD2","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD3","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD32","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD4","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD64","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD8","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMDMask","doc:\/\/com.apple.Swift\/documentation\/Runtime\/SectionCharacteristics","doc:\/\/com.apple.Swift\/documentation\/Swift\/Set"]}],"metadata":{"platforms":[{"unavailable":false,"name":"iOS","deprecated":false,"introducedAt":"8.0","beta":false},{"unavailable":false,"name":"iPadOS","deprecated":false,"introducedAt":"8.0","beta":false},{"unavailable":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"13.0","beta":false},{"unavailable":false,"name":"macOS","deprecated":false,"introducedAt":"10.10","beta":false},{"unavailable":false,"name":"tvOS","deprecated":false,"introducedAt":"9.0","beta":false},{"unavailable":false,"name":"visionOS","deprecated":false,"introducedAt":"1.0","beta":false},{"unavailable":false,"name":"watchOS","deprecated":false,"introducedAt":"2.0","beta":false}],"title":"ExpressibleByArrayLiteral","symbolKind":"protocol","navigatorTitle":[{"text":"ExpressibleByArrayLiteral","kind":"identifier"}],"roleHeading":"Protocol","modules":[{"name":"Standard Library"}],"role":"symbol","externalID":"s:s25ExpressibleByArrayLiteralP","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExpressibleByArrayLiteral","kind":"identifier"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/expressiblebyarrayliteral"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral"},"abstract":[{"text":"A type that can be initialized using an array literal.","type":"text"}],"seeAlsoSections":[{"generated":true,"anchor":"Collection-Literals","title":"Collection Literals","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral"]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"topicSections":[{"generated":true,"anchor":"Associated-Types","title":"Associated Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral\/ArrayLiteralElement"]},{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral\/init(arrayLiteral:)"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExpressibleByArrayLiteral","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An array literal is a simple way of expressing a list of values. Simply"},{"text":" ","type":"text"},{"type":"text","text":"surround a comma-separated list of values, instances, or literals with"},{"text":" ","type":"text"},{"type":"text","text":"square brackets to create an array literal. You can use an array literal"},{"type":"text","text":" "},{"text":"anywhere an instance of an ","type":"text"},{"code":"ExpressibleByArrayLiteral","type":"codeVoice"},{"type":"text","text":" type is expected: as"},{"text":" ","type":"text"},{"type":"text","text":"a value assigned to a variable or constant, as a parameter to a method or"},{"type":"text","text":" "},{"type":"text","text":"initializer, or even as the subject of a nonmutating operation like"},{"type":"text","text":" "},{"code":"map(_:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"filter(_:)","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"Arrays, sets, and option sets all conform to ","type":"text"},{"code":"ExpressibleByArrayLiteral","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and your own custom types can as well. Here’s an example of creating a set"},{"type":"text","text":" "},{"text":"and an array using array literals:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let employeesSet: Set<String> = [\"Amir\", \"Jihye\", \"Dave\", \"Alessia\", \"Dave\"]","print(employeesSet)","\/\/ Prints \"[\"Amir\", \"Dave\", \"Jihye\", \"Alessia\"]\"","","let employeesArray: [String] = [\"Amir\", \"Jihye\", \"Dave\", \"Alessia\", \"Dave\"]","print(employeesArray)","\/\/ Prints \"[\"Amir\", \"Jihye\", \"Dave\", \"Alessia\", \"Dave\"]\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"Set","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Array","type":"codeVoice"},{"type":"text","text":" types each handle array literals in their own way to"},{"text":" ","type":"text"},{"text":"create new instances. In this case, the newly created set drops the","type":"text"},{"type":"text","text":" "},{"text":"duplicate value (“Dave”) and doesn’t maintain the order of the array","type":"text"},{"text":" ","type":"text"},{"text":"literal’s elements. The new array, on the other hand, matches the order","type":"text"},{"text":" ","type":"text"},{"text":"and number of elements provided.","type":"text"}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"An array literal is not the same as an ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" instance. You can’t","type":"text"},{"type":"text","text":" "},{"text":"initialize a type that conforms to ","type":"text"},{"type":"codeVoice","code":"ExpressibleByArrayLiteral"},{"text":" simply by","type":"text"},{"type":"text","text":" "},{"text":"assigning an existing array.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let anotherSet: Set = employeesArray","\/\/ error: cannot convert value of type '[String]' to specified type 'Set'"]}],"name":"Note"},{"text":"Type Inference of Array Literals","level":1,"anchor":"Type-Inference-of-Array-Literals","type":"heading"},{"inlineContent":[{"type":"text","text":"Whenever possible, Swift’s compiler infers the full intended type of your"},{"type":"text","text":" "},{"type":"text","text":"array literal. Because "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" is the default type for an array literal,"},{"type":"text","text":" "},{"type":"text","text":"without writing any other code, you can declare an array with a particular"},{"type":"text","text":" "},{"type":"text","text":"element type by providing one or more values."}],"type":"paragraph"},{"inlineContent":[{"text":"In this example, the compiler infers the full type of each array literal.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let integers = [1, 2, 3]","\/\/ 'integers' has type '[Int]'","","let strings = [\"a\", \"b\", \"c\"]","\/\/ 'strings' has type '[String]'"],"type":"codeListing"},{"inlineContent":[{"text":"An empty array literal alone doesn’t provide enough information for the","type":"text"},{"text":" ","type":"text"},{"text":"compiler to infer the intended type of the ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":" instance. When using an","type":"text"},{"text":" ","type":"text"},{"text":"empty array literal, specify the type of the variable or constant.","type":"text"}],"type":"paragraph"},{"code":["var emptyArray: [Bool] = []","\/\/ 'emptyArray' has type '[Bool]'"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Because many functions and initializers fully specify the types of their"},{"text":" ","type":"text"},{"text":"parameters, you can often use an array literal with or without elements as","type":"text"},{"text":" ","type":"text"},{"text":"a parameter. For example, the ","type":"text"},{"type":"codeVoice","code":"sum(_:)"},{"text":" function shown here takes an ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" ","type":"text"},{"type":"text","text":"array as a parameter:"}],"type":"paragraph"},{"code":["func sum(values: [Int]) -> Int {","    return values.reduce(0, +)","}","","let sumOfFour = sum([5, 10, 15, 20])","\/\/ 'sumOfFour' == 50","","let sumOfNone = sum([])","\/\/ 'sumOfNone' == 0"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When you call a function that does not fully specify its parameters’ types,","type":"text"},{"text":" ","type":"text"},{"text":"use the type-cast operator (","type":"text"},{"type":"codeVoice","code":"as"},{"type":"text","text":") to specify the type of an array literal."},{"type":"text","text":" "},{"type":"text","text":"For example, the "},{"code":"log(name:value:)","type":"codeVoice"},{"type":"text","text":" function shown here has an"},{"text":" ","type":"text"},{"text":"unconstrained generic ","type":"text"},{"type":"codeVoice","code":"value"},{"text":" parameter.","type":"text"}],"type":"paragraph"},{"code":["func log<T>(name name: String, value: T) {","    print(\"\\(name): \\(value)\")","}","","log(name: \"Four integers\", value: [5, 10, 15, 20])","\/\/ Prints \"Four integers: [5, 10, 15, 20]\"","","log(name: \"Zero integers\", value: [] as [Int])","\/\/ Prints \"Zero integers: []\""],"syntax":"swift","type":"codeListing"},{"level":1,"text":"Conforming to ExpressibleByArrayLiteral","anchor":"Conforming-to-ExpressibleByArrayLiteral","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the capability to be initialized with an array literal to your own"},{"text":" ","type":"text"},{"text":"custom types by declaring an ","type":"text"},{"type":"codeVoice","code":"init(arrayLiteral:)"},{"text":" initializer. The","type":"text"},{"type":"text","text":" "},{"text":"following example shows the array literal initializer for a hypothetical","type":"text"},{"text":" ","type":"text"},{"code":"OrderedSet","type":"codeVoice"},{"text":" type, which has setlike semantics but maintains the order of","type":"text"},{"text":" ","type":"text"},{"text":"its elements.","type":"text"}]},{"code":["struct OrderedSet<Element: Hashable>: Collection, SetAlgebra {","    \/\/ implementation details","}","","extension OrderedSet: ExpressibleByArrayLiteral {","    init(arrayLiteral: Element...) {","        self.init()","        for element in arrayLiteral {","            self.append(element)","        }","    }","}"],"type":"codeListing","syntax":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/ExpressibleByArrayLiteral":{"abstract":[{"text":"A type that can be initialized using an array literal.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ExpressibleByArrayLiteral"}],"url":"\/documentation\/swift\/expressiblebyarrayliteral","title":"ExpressibleByArrayLitera