{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"abstract":[{"text":"A type that can be initialized using an array literal.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","relationshipsSections":[{"kind":"relationships","title":"Inherited By","type":"inheritedBy","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Cxx\/CxxSet","doc:\/\/com.apple.Swift\/documentation\/Cxx\/CxxUniqueSet","doc:\/\/com.apple.Swift\/documentation\/Cxx\/CxxVector","doc:\/\/com.apple.Swift\/documentation\/Swift\/OptionSet","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD","doc:\/\/com.apple.Swift\/documentation\/Swift\/SetAlgebra"]},{"kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Array","doc:\/\/com.apple.Swift\/documentation\/Swift\/Array\/DifferentiableView","doc:\/\/com.apple.Swift\/documentation\/Swift\/ArraySlice","doc:\/\/com.apple.Swift\/documentation\/Runtime\/Backtrace\/SymbolicationOptions","doc:\/\/com.apple.Swift\/documentation\/Swift\/ContiguousArray","doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationTracking\/Options","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD16","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD2","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD3","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD32","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD4","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD64","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMD8","doc:\/\/com.apple.Swift\/documentation\/Swift\/SIMDMask","doc:\/\/com.apple.Swift\/documentation\/Runtime\/SectionCharacteristics","doc:\/\/com.apple.Swift\/documentation\/Swift\/Set"],"title":"Conforming Types","type":"conformingTypes"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral"],"title":"Collection Literals","anchor":"Collection-Literals","generated":true}],"variants":[{"paths":["\/documentation\/swift\/expressiblebyarrayliteral"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"ExpressibleByArrayLiteral","navigatorTitle":[{"kind":"identifier","text":"ExpressibleByArrayLiteral"}],"symbolKind":"protocol","platforms":[{"deprecated":false,"introducedAt":"8.0","beta":false,"unavailable":false,"name":"iOS"},{"unavailable":false,"deprecated":false,"name":"iPadOS","beta":false,"introducedAt":"8.0"},{"unavailable":false,"name":"Mac Catalyst","beta":false,"deprecated":false,"introducedAt":"13.0"},{"unavailable":false,"name":"macOS","beta":false,"deprecated":false,"introducedAt":"10.10"},{"unavailable":false,"name":"tvOS","beta":false,"deprecated":false,"introducedAt":"9.0"},{"name":"visionOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"1.0"},{"unavailable":false,"name":"watchOS","beta":false,"deprecated":false,"introducedAt":"2.0"}],"modules":[{"name":"Standard Library"}],"role":"symbol","externalID":"s:s25ExpressibleByArrayLiteralP","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExpressibleByArrayLiteral"}],"roleHeading":"Protocol"},"topicSections":[{"title":"Associated Types","generated":true,"anchor":"Associated-Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral\/ArrayLiteralElement"]},{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral\/init(arrayLiteral:)"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"ExpressibleByArrayLiteral","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"An array literal is a simple way of expressing a list of values. Simply"},{"type":"text","text":" "},{"text":"surround a comma-separated list of values, instances, or literals with","type":"text"},{"text":" ","type":"text"},{"text":"square brackets to create an array literal. You can use an array literal","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"anywhere an instance of an "},{"type":"codeVoice","code":"ExpressibleByArrayLiteral"},{"type":"text","text":" type is expected: as"},{"type":"text","text":" "},{"type":"text","text":"a value assigned to a variable or constant, as a parameter to a method or"},{"type":"text","text":" "},{"type":"text","text":"initializer, or even as the subject of a nonmutating operation like"},{"text":" ","type":"text"},{"code":"map(_:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"filter(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Arrays, sets, and option sets all conform to ","type":"text"},{"code":"ExpressibleByArrayLiteral","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and your own custom types can as well. Here’s an example of creating a set","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and an array using array literals:"}]},{"type":"codeListing","code":["let employeesSet: Set<String> = [\"Amir\", \"Jihye\", \"Dave\", \"Alessia\", \"Dave\"]","print(employeesSet)","\/\/ Prints \"[\"Amir\", \"Dave\", \"Jihye\", \"Alessia\"]\"","","let employeesArray: [String] = [\"Amir\", \"Jihye\", \"Dave\", \"Alessia\", \"Dave\"]","print(employeesArray)","\/\/ Prints \"[\"Amir\", \"Jihye\", \"Dave\", \"Alessia\", \"Dave\"]\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Set"},{"text":" and ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" types each handle array literals in their own way to","type":"text"},{"text":" ","type":"text"},{"text":"create new instances. In this case, the newly created set drops the","type":"text"},{"text":" ","type":"text"},{"text":"duplicate value (“Dave”) and doesn’t maintain the order of the array","type":"text"},{"text":" ","type":"text"},{"text":"literal’s elements. The new array, on the other hand, matches the order","type":"text"},{"text":" ","type":"text"},{"text":"and number of elements provided.","type":"text"}],"type":"paragraph"},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"text":"An array literal is not the same as an ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" instance. You can’t","type":"text"},{"text":" ","type":"text"},{"text":"initialize a type that conforms to ","type":"text"},{"code":"ExpressibleByArrayLiteral","type":"codeVoice"},{"text":" simply by","type":"text"},{"text":" ","type":"text"},{"text":"assigning an existing array.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let anotherSet: Set = employeesArray","\/\/ error: cannot convert value of type '[String]' to specified type 'Set'"],"type":"codeListing"}]},{"text":"Type Inference of Array Literals","type":"heading","anchor":"Type-Inference-of-Array-Literals","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"Whenever possible, Swift’s compiler infers the full intended type of your"},{"text":" ","type":"text"},{"text":"array literal. Because ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" is the default type for an array literal,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"without writing any other code, you can declare an array with a particular"},{"type":"text","text":" "},{"type":"text","text":"element type by providing one or more values."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this example, the compiler infers the full type of each array literal."}]},{"type":"codeListing","syntax":"swift","code":["let integers = [1, 2, 3]","\/\/ 'integers' has type '[Int]'","","let strings = [\"a\", \"b\", \"c\"]","\/\/ 'strings' has type '[String]'"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An empty array literal alone doesn’t provide enough information for the"},{"type":"text","text":" "},{"type":"text","text":"compiler to infer the intended type of the "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" instance. When using an"},{"type":"text","text":" "},{"type":"text","text":"empty array literal, specify the type of the variable or constant."}]},{"code":["var emptyArray: [Bool] = []","\/\/ 'emptyArray' has type '[Bool]'"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Because many functions and initializers fully specify the types of their"},{"type":"text","text":" "},{"type":"text","text":"parameters, you can often use an array literal with or without elements as"},{"text":" ","type":"text"},{"text":"a parameter. For example, the ","type":"text"},{"code":"sum(_:)","type":"codeVoice"},{"text":" function shown here takes an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" ","type":"text"},{"text":"array as a parameter:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["func sum(values: [Int]) -> Int {","    return values.reduce(0, +)","}","","let sumOfFour = sum([5, 10, 15, 20])","\/\/ 'sumOfFour' == 50","","let sumOfNone = sum([])","\/\/ 'sumOfNone' == 0"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"When you call a function that does not fully specify its parameters’ types,"},{"type":"text","text":" "},{"type":"text","text":"use the type-cast operator ("},{"type":"codeVoice","code":"as"},{"type":"text","text":") to specify the type of an array literal."},{"type":"text","text":" "},{"type":"text","text":"For example, the "},{"type":"codeVoice","code":"log(name:value:)"},{"type":"text","text":" function shown here has an"},{"type":"text","text":" "},{"type":"text","text":"unconstrained generic "},{"type":"codeVoice","code":"value"},{"type":"text","text":" parameter."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func log<T>(name name: String, value: T) {","    print(\"\\(name): \\(value)\")","}","","log(name: \"Four integers\", value: [5, 10, 15, 20])","\/\/ Prints \"Four integers: [5, 10, 15, 20]\"","","log(name: \"Zero integers\", value: [] as [Int])","\/\/ Prints \"Zero integers: []\""]},{"type":"heading","text":"Conforming to ExpressibleByArrayLiteral","anchor":"Conforming-to-ExpressibleByArrayLiteral","level":1},{"inlineContent":[{"type":"text","text":"Add the capability to be initialized with an array literal to your own"},{"type":"text","text":" "},{"type":"text","text":"custom types by declaring an "},{"type":"codeVoice","code":"init(arrayLiteral:)"},{"type":"text","text":" initializer. The"},{"type":"text","text":" "},{"type":"text","text":"following example shows the array literal initializer for a hypothetical"},{"type":"text","text":" "},{"type":"codeVoice","code":"OrderedSet"},{"type":"text","text":" type, which has setlike semantics but maintains the order of"},{"type":"text","text":" "},{"type":"text","text":"its elements."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct OrderedSet<Element: Hashable>: Collection, SetAlgebra {","    \/\/ implementation details","}","","extension OrderedSet: ExpressibleByArrayLiteral {","    init(arrayLiteral: Element...) {","        self.init()","        for element in arrayLiteral {","            self.append(element)","        }","    }","}"]}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Cxx/CxxUniqueSet":{"title":"CxxUniqueSet","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"CxxUniqueSet","kind":"identifier"}],"navigatorTitle":[{"text":"CxxUniqueSet","kind":"identifier"}],"url":"\/documentation\/cxx\/cxxuniqueset","identifier":"doc:\/\/com.apple.Swift\/d