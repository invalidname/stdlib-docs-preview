{"relationshipsSections":[{"title":"Inherited By","kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Cxx\/CxxDictionary"],"type":"inheritedBy"},{"title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Dictionary","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs"],"type":"conformingTypes"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"abstract":[{"text":"A type that can be initialized using a dictionary literal.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"title":"Associated Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/Key","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/Value"],"anchor":"Associated-Types","generated":true},{"title":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/init(dictionaryLiteral:)"],"anchor":"Initializers","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExpressibleByDictionaryLiteral","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"A dictionary literal is a simple way of writing a list of key-value pairs."},{"text":" ","type":"text"},{"text":"You write each key-value pair with a colon (","type":"text"},{"type":"codeVoice","code":":"},{"text":") separating the key and","type":"text"},{"text":" ","type":"text"},{"text":"the value. The dictionary literal is made up of one or more key-value","type":"text"},{"text":" ","type":"text"},{"text":"pairs, separated by commas and surrounded with square brackets.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To declare a dictionary, assign a dictionary literal to a variable or"},{"type":"text","text":" "},{"type":"text","text":"constant:"}],"type":"paragraph"},{"code":["let countryCodes = [\"BR\": \"Brazil\", \"GH\": \"Ghana\",","                    \"JP\": \"Japan\", \"US\": \"United States\"]","\/\/ 'countryCodes' has type '[String: String]'","","print(countryCodes[\"BR\"]!)","\/\/ Prints \"Brazil\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"When the context provides enough type information, you can use a special","type":"text"},{"text":" ","type":"text"},{"text":"form of the dictionary literal, square brackets surrounding a single","type":"text"},{"text":" ","type":"text"},{"text":"colon, to initialize an empty dictionary.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var frequencies: [String: Int] = [:]","print(frequencies.count)","\/\/ Prints \"0\""]},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"A dictionary literal is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" the same as an instance of "},{"code":"Dictionary","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"You can’t initialize a type that conforms to ","type":"text"},{"code":"ExpressibleByDictionaryLiteral","type":"codeVoice"},{"text":" ","type":"text"},{"text":"simply by assigning an instance of ","type":"text"},{"code":"Dictionary","type":"codeVoice"},{"text":", ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":", or similar.","type":"text"}]}],"style":"note"},{"text":"Conforming to the ExpressibleByDictionaryLiteral Protocol","type":"heading","anchor":"Conforming-to-the-ExpressibleByDictionaryLiteral-Protocol","level":1},{"inlineContent":[{"text":"To add the capability to be initialized with a dictionary literal to your","type":"text"},{"text":" ","type":"text"},{"text":"own custom types, declare an ","type":"text"},{"code":"init(dictionaryLiteral:)","type":"codeVoice"},{"text":" initializer. The","type":"text"},{"text":" ","type":"text"},{"text":"following example shows the dictionary literal initializer for a","type":"text"},{"text":" ","type":"text"},{"text":"hypothetical ","type":"text"},{"code":"CountedSet","type":"codeVoice"},{"type":"text","text":" type, which uses setlike semantics while keeping"},{"type":"text","text":" "},{"text":"track of the count for duplicate elements:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct CountedSet<Element: Hashable>: Collection, SetAlgebra {","    \/\/ implementation details","","    \/\/\/ Updates the count stored in the set for the given element,","    \/\/\/ adding the element if necessary.","    \/\/\/","    \/\/\/ - Parameter n: The new count for `element`. `n` must be greater","    \/\/\/   than or equal to zero.","    \/\/\/ - Parameter element: The element to set the new count on.","    mutating func updateCount(_ n: Int, for element: Element)","}","","extension CountedSet: ExpressibleByDictionaryLiteral {","    init(dictionaryLiteral elements: (Element, Int)...) {","        self.init()","        for (element, count) in elements {","            self.updateCount(count, for: element)","        }","    }","}"]}]}],"metadata":{"symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExpressibleByDictionaryLiteral","kind":"identifier"}],"role":"symbol","title":"ExpressibleByDictionaryLiteral","platforms":[{"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iPadOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"13.0","name":"Mac Catalyst","deprecated":false},{"beta":false,"unavailable":false,"introducedA