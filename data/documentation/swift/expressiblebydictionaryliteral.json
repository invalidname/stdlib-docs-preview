{"abstract":[{"type":"text","text":"A type that can be initialized using a dictionary literal."}],"kind":"symbol","sections":[],"metadata":{"modules":[{"name":"Standard Library"}],"roleHeading":"Protocol","title":"ExpressibleByDictionaryLiteral","navigatorTitle":[{"kind":"identifier","text":"ExpressibleByDictionaryLiteral"}],"externalID":"s:s30ExpressibleByDictionaryLiteralP","role":"symbol","platforms":[{"introducedAt":"8.0","beta":false,"deprecated":false,"name":"iOS","unavailable":false},{"introducedAt":"8.0","beta":false,"deprecated":false,"name":"iPadOS","unavailable":false},{"introducedAt":"13.0","beta":false,"deprecated":false,"name":"Mac Catalyst","unavailable":false},{"introducedAt":"10.10","beta":false,"deprecated":false,"name":"macOS","unavailable":false},{"introducedAt":"9.0","beta":false,"deprecated":false,"name":"tvOS","unavailable":false},{"introducedAt":"1.0","beta":false,"deprecated":false,"name":"visionOS","unavailable":false},{"introducedAt":"2.0","beta":false,"deprecated":false,"name":"watchOS","unavailable":false}],"symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"ExpressibleByDictionaryLiteral","kind":"identifier"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Associated Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/Key","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/Value"],"generated":true,"anchor":"Associated-Types"},{"title":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/init(dictionaryLiteral:)"],"generated":true,"anchor":"Initializers"}],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Cxx\/CxxDictionary"],"title":"Inherited By","kind":"relationships","type":"inheritedBy"},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Dictionary","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs"],"title":"Conforming Types","kind":"relationships","type":"conformingTypes"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"seeAlsoSections":[{"title":"Collection Literals","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral"],"generated":true,"anchor":"Collection-Literals"}],"variants":[{"paths":["\/documentation\/swift\/expressiblebydictionaryliteral"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExpressibleByDictionaryLiteral","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A dictionary literal is a simple way of writing a list of key-value pairs."},{"type":"text","text":" "},{"type":"text","text":"You write each key-value pair with a colon ("},{"code":":","type":"codeVoice"},{"type":"text","text":") separating the key and"},{"type":"text","text":" "},{"type":"text","text":"the value. The dictionary literal is made up of one or more key-value"},{"type":"text","text":" "},{"type":"text","text":"pairs, separated by commas and surrounded with square brackets."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To declare a dictionary, assign a dictionary literal to a variable or"},{"type":"text","text":" "},{"type":"text","text":"constant:"}]},{"type":"codeListing","syntax":"swift","code":["let countryCodes = [\"BR\": \"Brazil\", \"GH\": \"Ghana\",","                    \"JP\": \"Japan\", \"US\": \"United States\"]","\/\/ 'countryCodes' has type '[String: String]'","","print(countryCodes[\"BR\"]!)","\/\/ Prints \"Brazil\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the context provides enough type information, you can use a special"},{"type":"text","text":" "},{"type":"text","text":"form of the dictionary literal, square brackets surrounding a single"},{"type":"text","text":" "},{"type":"text","text":"colon, to initialize an empty dictionary."}]},{"type":"codeListing","syntax":"swift","code":["var frequencies: [String: Int] = [:]","print(frequencies.count)","\/\/ Prints \"0\""]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"text","text":" "},{"text":"A dictionary literal is ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" the same as an instance of "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You can’t initialize a type that conforms to "},{"type":"codeVoice","code":"ExpressibleByDictionaryLiteral"},{"type":"text","text":" "},{"type":"text","text":"simply by assigning an instance of "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":", or similar."}]}],"style":"note"},{"level":1,"anchor":"Conforming-to-the-ExpressibleByDictionaryLiteral-Protocol","type":"heading","text":"Conforming to the ExpressibleByDictionaryLiteral Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add the capability to be initialized with a dictionary literal to your"},{"type":"text","text":" "},{"type":"text","text":"own custom types, declare an "},{"type":"codeVoice","code":"init(dictionaryLiteral:)"},{"type":"text","text":" initializer. The"},{"type":"text","text":" "},{"type":"text","text":"following example shows the dictionary literal initializer for a"},{"type":"text","text":" "},{"type":"text","text":"hypothetical "},{"type":"codeVoice","code":"CountedSet"},{"type":"text","text":" type, which uses setlike semantics while keeping"},{"type":"text","text":" "},{"type":"text","text":"track of the count for duplicate elements:"}]},{"type":"codeListing","syntax":"swift","code":["struct CountedSet<Element: Hashable>: Collection, SetAlgebra {","    \/\/ implementation details","","    \/\/\/ Updates the count stored in the set for the given element,","    \/\/\/ adding the element if necessary.","    \/\/\/","    \/\/\/ - Parameter n: The new count for `element`. `n` must be greater","    \/\/\/   than or equal to zero.","    \/\/\/ - Parameter element: The element to set the new count on.","    mutating func updateCount(_ n: Int, for element: Element)","}","","extension CountedSet: ExpressibleByDictionaryLiteral {","    init(dictionaryLiteral elements: (Element, Int)...) {","        self.init()","        for (element, count) in elements {","            self.updateCount(count, for: element)","        }","    }","}"]}]}],"references":{"doc://com.apple.Swift/documentation/Swift/ExpressibleByDictionaryLiteral/init(dictionaryLiteral:)":{"required":true,"abstract":[{"type":"text","text":"Creates an instance initialized with the given key-value pairs."}],"defaultImplementations":1,"type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"dictionaryLiteral"},{"kind":"text","text":": ("},{"preciseIdentifier":"s:s30ExpressibleByDictionaryLiteralP3KeyQa","kind":"typeIdentifier","text":"Key"},{"kind":"text","text":", "},{"preciseIdentifier":"s:s30ExpressibleByDictionaryLiteralP5ValueQa","kind":"typeIdentifier","text":"Value"},{"kind":"text","text":")...)"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/init(dictionaryLiteral:)","kind":"symbol","title":"init(dictionaryLiteral:)","url":"\/documentation\/swift\/expressiblebydictionaryliteral\/init(dictionaryliteral:)","role":"symbol"},"doc://com.apple.Swift/documentation/Swift/