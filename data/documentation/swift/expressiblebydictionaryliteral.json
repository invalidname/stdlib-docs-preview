{"variants":[{"paths":["\/documentation\/swift\/expressiblebydictionaryliteral"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"platforms":[{"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iPadOS","deprecated":false},{"introducedAt":"13.0","name":"Mac Catalyst","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"10.10","name":"macOS","deprecated":false,"unavailable":false,"beta":false},{"deprecated":false,"unavailable":false,"beta":false,"name":"tvOS","introducedAt":"9.0"},{"introducedAt":"1.0","name":"visionOS","deprecated":false,"unavailable":false,"beta":false},{"deprecated":false,"unavailable":false,"beta":false,"name":"watchOS","introducedAt":"2.0"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExpressibleByDictionaryLiteral"}],"title":"ExpressibleByDictionaryLiteral","modules":[{"name":"Swift"}],"symbolKind":"protocol","role":"symbol","externalID":"s:s30ExpressibleByDictionaryLiteralP","roleHeading":"Protocol","navigatorTitle":[{"text":"ExpressibleByDictionaryLiteral","kind":"identifier"}]},"relationshipsSections":[{"kind":"relationships","title":"Inherited By","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Cxx\/CxxDictionary"],"type":"inheritedBy"},{"kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Dictionary","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs"],"type":"conformingTypes"}],"abstract":[{"text":"A type that can be initialized using a dictionary literal.","type":"text"}],"seeAlsoSections":[{"generated":true,"anchor":"Collection-Literals","title":"Collection Literals","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExpressibleByDictionaryLiteral","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A dictionary literal is a simple way of writing a list of key-value pairs."},{"type":"text","text":" "},{"type":"text","text":"You write each key-value pair with a colon ("},{"type":"codeVoice","code":":"},{"type":"text","text":") separating the key and"},{"type":"text","text":" "},{"type":"text","text":"the value. The dictionary literal is made up of one or more key-value"},{"type":"text","text":" "},{"type":"text","text":"pairs, separated by commas and surrounded with square brackets."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"To declare a dictionary, assign a dictionary literal to a variable or","type":"text"},{"text":" ","type":"text"},{"text":"constant:","type":"text"}]},{"code":["let countryCodes = [\"BR\": \"Brazil\", \"GH\": \"Ghana\",","                    \"JP\": \"Japan\", \"US\": \"United States\"]","\/\/ 'countryCodes' has type '[String: String]'","","print(countryCodes[\"BR\"]!)","\/\/ Prints \"Brazil\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"When the context provides enough type information, you can use a special"},{"type":"text","text":" "},{"type":"text","text":"form of the dictionary literal, square brackets surrounding a single"},{"type":"text","text":" "},{"type":"text","text":"colon, to initialize an empty dictionary."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var frequencies: [String: Int] = [:]","print(frequencies.count)","\/\/ Prints \"0\""]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"A dictionary literal is "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"text":" the same as an instance of ","type":"text"},{"type":"codeVoice","code":"Dictionary"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"You can’t initialize a type that conforms to ","type":"text"},{"code":"ExpressibleByDictionaryLiteral","type":"codeVoice"},{"text":" ","type":"text"},{"text":"simply by assigning an instance of ","type":"text"},{"code":"Dictionary","type":"codeVoice"},{"text":", ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"type":"text","text":", or similar."}],"type":"paragraph"}],"name":"Note","style":"note"},{"level":1,"anchor":"Conforming-to-the-ExpressibleByDictionaryLiteral-Protocol","type":"heading","text":"Conforming to the ExpressibleByDictionaryLiteral Protocol"},{"type":"paragraph","inlineContent":[{"text":"To add the capability to be initialized with a dictionary literal to your","type":"text"},{"text":" ","type":"text"},{"text":"own custom types, declare an ","type":"text"},{"code":"init(dictionaryLiteral:)","type":"codeVoice"},{"text":" initializer. The","type":"text"},{"text":" ","type":"text"},{"text":"following example shows the dictionary literal initializer for a","type":"text"},{"text":" ","type":"text"},{"text":"hypothetical ","type":"text"},{"type":"codeVoice","code":"CountedSet"},{"text":" type, which uses setlike semantics while keeping","type":"text"},{"text":" ","type":"text"},{"text":"track of the count for duplicate elements:","type":"text"}]},{"syntax":"swift","code":["struct CountedSet<Element: Hashable>: Collection, SetAlgebra {","    \/\/ implementation details","","    \/\/\/ Updates the count stored in the set for the given element,","    \/\/\/ adding the element if necessary.","    \/\/\/","    \/\/\/ - Parameter n: The new count for `element`. `n` must be greater","    \/\/\/   than or equal to zero.","    \/\/\/ - Parameter element: The element to set the new count on.","    mutating func updateCount(_ n: Int, for element: Element)","}","","extension CountedSet: ExpressibleByDictionaryLiteral {","    init(dictionaryLiteral elements: (Element, Int)...) {","        self.init()","        for (element, count) in elements {","            self.updateCount(count, for: element)","        }","    }","}"],"type":"codeListing"}],"kind":"content"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"topicSections":[{"generated":true,"anchor":"Associated-Types","title":"Associated Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/Key","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/Value"]},{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/init(dictionaryLiteral:)"]}],"references":{"doc://com.apple.Swift/documentation/Swift/ExpressibleByArrayLiteral":{"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ExpressibleByArrayLiteral"}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ExpressibleByArrayLiteral"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral","abstract":[{"type":"text","text":"A type that can be initialized using an array literal."}],"title":"ExpressibleByArrayLiteral","url":"\/documentation\/swift\/expressiblebyarrayliteral"},"doc://com.apple.Swift/documentation/Swift/ExpressibleByDictionaryLiteral":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral","kind":"symbol","url":"\/documentation\/swift\/expressiblebydictionaryliteral","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExpressibleByDictionaryLiteral