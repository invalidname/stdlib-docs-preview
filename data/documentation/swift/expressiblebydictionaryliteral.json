{"metadata":{"title":"ExpressibleByDictionaryLiteral","navigatorTitle":[{"kind":"identifier","text":"ExpressibleByDictionaryLiteral"}],"platforms":[{"unavailable":false,"introducedAt":"8.0","name":"iOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"8.0","name":"iPadOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"13.0","name":"Mac Catalyst","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"10.10","name":"macOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"9.0","name":"tvOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"1.0","name":"visionOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"2.0","name":"watchOS","deprecated":false,"beta":false}],"roleHeading":"Protocol","externalID":"s:s30ExpressibleByDictionaryLiteralP","modules":[{"name":"Standard Library"}],"role":"symbol","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExpressibleByDictionaryLiteral"}]},"relationshipsSections":[{"title":"Inherited By","kind":"relationships","type":"inheritedBy","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Cxx\/CxxDictionary"]},{"title":"Conforming Types","kind":"relationships","type":"conformingTypes","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Dictionary","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs"]}],"topicSections":[{"title":"Associated Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/Key","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/Value"],"generated":true,"anchor":"Associated-Types"},{"title":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/init(dictionaryLiteral:)"],"generated":true,"anchor":"Initializers"}],"seeAlsoSections":[{"title":"Collection Literals","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral"],"generated":true,"anchor":"Collection-Literals"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExpressibleByDictionaryLiteral"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A dictionary literal is a simple way of writing a list of key-value pairs.","type":"text"},{"text":" ","type":"text"},{"text":"You write each key-value pair with a colon (","type":"text"},{"code":":","type":"codeVoice"},{"text":") separating the key and","type":"text"},{"text":" ","type":"text"},{"text":"the value. The dictionary literal is made up of one or more key-value","type":"text"},{"text":" ","type":"text"},{"text":"pairs, separated by commas and surrounded with square brackets.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To declare a dictionary, assign a dictionary literal to a variable or"},{"type":"text","text":" "},{"type":"text","text":"constant:"}]},{"type":"codeListing","syntax":"swift","code":["let countryCodes = [\"BR\": \"Brazil\", \"GH\": \"Ghana\",","                    \"JP\": \"Japan\", \"US\": \"United States\"]","\/\/ 'countryCodes' has type '[String: String]'","","print(countryCodes[\"BR\"]!)","\/\/ Prints \"Brazil\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the context provides enough type information, you can use a special"},{"type":"text","text":" "},{"type":"text","text":"form of the dictionary literal, square brackets surrounding a single"},{"type":"text","text":" "},{"type":"text","text":"colon, to initialize an empty dictionary."}]},{"type":"codeListing","syntax":"swift","code":["var frequencies: [String: Int] = [:]","print(frequencies.count)","\/\/ Prints \"0\""]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"A dictionary literal is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" the same as an instance of "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You can’t initialize a type that conforms to "},{"type":"codeVoice","code":"ExpressibleByDictionaryLiteral"},{"type":"text","text":" "},{"type":"text","text":"simply by assigning an instance of "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":", or similar."}]}],"style":"note","name":"Note"},{"level":1,"type":"heading","anchor":"Conforming-to-the-ExpressibleByDictionaryLiteral-Protocol","text":"Conforming to the ExpressibleByDictionaryLiteral Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add the capability to be initialized with a dictionary literal to your"},{"type":"text","text":" "},{"type":"text","text":"own custom types, declare an "},{"type":"codeVoice","code":"init(dictionaryLiteral:)"},{"type":"text","text":" initializer. The"},{"type":"text","text":" "},{"type":"text","text":"following example shows the dictionary literal initializer for a"},{"type":"text","text":" "},{"type":"text","text":"hypothetical "},{"type":"codeVoice","code":"CountedSet"},{"type":"text","text":" type, which uses setlike semantics while keeping"},{"type":"text","text":" "},{"type":"text","text":"track of the count for duplicate elements:"}]},{"type":"codeListing","syntax":"swift","code":["struct CountedSet<Element: Hashable>: Collection, SetAlgebra {","    \/\/ implementation details","","    \/\/\/ Updates the count stored in the set for the given element,","    \/\/\/ adding the element if necessary.","    \/\/\/","    \/\/\/ - Parameter n: The new count for `element`. `n` must be greater","    \/\/\/   than or equal to zero.","    \/\/\/ - Parameter element: The element to set the new count on.","    mutating func updateCount(_ n: Int, for element: Element)","}","","extension CountedSet: ExpressibleByDictionaryLiteral {","    init(dictionaryLiteral elements: (Element, Int)...) {","        self.init()","        for (element, count) in elements {","            self.updateCount(count, for: element)","        }","    }","}"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/expressiblebydictionaryliteral"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral"},"abstract":[{"text":"A type that can be initialized using a dictionary literal.","type":"text"}],"kind":"symbol","sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/ExpressibleByDictionaryLiteral/Key":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Key"}],"role":"symbol","title":"Key","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/Key","url":"\/documentation\/swift\/expressiblebydictionaryliteral\/key","abstract":[{"type":"text","text":"The key type of a dictionary literal."}],"kind":"symbol","required":true},"doc://com.apple.Swift/documentation/Swift/ExpressibleByDictionaryLiteral/init(dictionaryLiteral:)":{"defaultImplementations":1,"abstract":[{"type":"text","text":"Creates an instance initialized with the given key-value pairs."}],"title":"init(dictionaryLiteral:)","url":"\/documentation\/swift\/expressiblebydictionaryliteral\/init(dictionaryliteral:)","required":true,"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleB