{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Cxx\/CxxDictionary"],"title":"Inherited By","kind":"relationships","type":"inheritedBy"},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Dictionary","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs"],"title":"Conforming Types","kind":"relationships","type":"conformingTypes"}],"metadata":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExpressibleByDictionaryLiteral","kind":"identifier"}],"navigatorTitle":[{"text":"ExpressibleByDictionaryLiteral","kind":"identifier"}],"platforms":[{"name":"iOS","introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false},{"name":"iPadOS","introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false},{"name":"Mac Catalyst","introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false},{"name":"macOS","introducedAt":"10.10","deprecated":false,"unavailable":false,"beta":false},{"name":"tvOS","introducedAt":"9.0","deprecated":false,"unavailable":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false},{"name":"watchOS","introducedAt":"2.0","deprecated":false,"unavailable":false,"beta":false}],"externalID":"s:s30ExpressibleByDictionaryLiteralP","role":"symbol","roleHeading":"Protocol","title":"ExpressibleByDictionaryLiteral","modules":[{"name":"Swift"}],"symbolKind":"protocol"},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral"],"title":"Collection Literals","anchor":"Collection-Literals","generated":true}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExpressibleByDictionaryLiteral","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A dictionary literal is a simple way of writing a list of key-value pairs.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"You write each key-value pair with a colon ("},{"type":"codeVoice","code":":"},{"type":"text","text":") separating the key and"},{"text":" ","type":"text"},{"text":"the value. The dictionary literal is made up of one or more key-value","type":"text"},{"text":" ","type":"text"},{"text":"pairs, separated by commas and surrounded with square brackets.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To declare a dictionary, assign a dictionary literal to a variable or","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"constant:"}]},{"type":"codeListing","syntax":"swift","code":["let countryCodes = [\"BR\": \"Brazil\", \"GH\": \"Ghana\",","                    \"JP\": \"Japan\", \"US\": \"United States\"]","\/\/ 'countryCodes' has type '[String: String]'","","print(countryCodes[\"BR\"]!)","\/\/ Prints \"Brazil\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the context provides enough type information, you can use a special"},{"type":"text","text":" "},{"type":"text","text":"form of the dictionary literal, square brackets surrounding a single"},{"type":"text","text":" "},{"type":"text","text":"colon, to initialize an empty dictionary."}]},{"type":"codeListing","syntax":"swift","code":["var frequencies: [String: Int] = [:]","print(frequencies.count)","\/\/ Prints \"0\""]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"A dictionary literal is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" the same as an instance of "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You can’t initialize a type that conforms to "},{"type":"codeVoice","code":"ExpressibleByDictionaryLiteral"},{"type":"text","text":" "},{"type":"text","text":"simply by assigning an instance of "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":", "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":", or similar."}]}]},{"anchor":"Conforming-to-the-ExpressibleByDictionaryLiteral-Protocol","type":"heading","text":"Conforming to the ExpressibleByDictionaryLiteral Protocol","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add the capability to be initialized with a dictionary literal to your"},{"type":"text","text":" "},{"type":"text","text":"own custom types, declare an "},{"type":"codeVoice","code":"init(dictionaryLiteral:)"},{"type":"text","text":" initializer. The"},{"type":"text","text":" "},{"type":"text","text":"following example shows the dictionary literal initializer for a"},{"type":"text","text":" "},{"type":"text","text":"hypothetical "},{"type":"codeVoice","code":"CountedSet"},{"type":"text","text":" type, which uses setlike semantics while keeping"},{"type":"text","text":" "},{"type":"text","text":"track of the count for duplicate elements:"}]},{"type":"codeListing","syntax":"swift","code":["struct CountedSet<Element: Hashable>: Collection, SetAlgebra {","    \/\/ implementation details","","    \/\/\/ Updates the count stored in the set for the given element,","    \/\/\/ adding the element if necessary.","    \/\/\/","    \/\/\/ - Parameter n: The new count for `element`. `n` must be greater","    \/\/\/   than or equal to zero.","    \/\/\/ - Parameter element: The element to set the new count on.","    mutating func updateCount(_ n: Int, for element: Element)","}","","extension CountedSet: ExpressibleByDictionaryLiteral {","    init(dictionaryLiteral elements: (Element, Int)...) {","        self.init()","        for (element, count) in elements {","            self.updateCount(count, for: element)","        }","    }","}"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/expressiblebydictionaryliteral"]}],"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"A type that can be initialized using a dictionary literal."}],"topicSections":[{"title":"Associated Types","anchor":"Associated-Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/Key","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/Value"],"generated":true},{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/init(dictionaryLiteral:)"],"generated":true}],"references":{"doc://com.apple.Swift/documentation/Cxx/CxxDictionary":{"url":"\/documentation\/cxx\/cxxdictionary","kind":"symbol","abstract":[{"type":"text","text":"A C++ type that represents a dictionary."}],"navigatorTitle":[{"kind":"identifier","text":"CxxDictionary"}],"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Cxx\/CxxDictionary","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CxxDictionary"}],"title":"CxxDictionary"},"doc://com.apple.Swift/documentation/Swift/KeyValuePairs":{"navigatorTitle":[{"text":"KeyValuePairs","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs","url":"\/documentation\/swift\/keyvaluepairs","abstract":[{"type":"text","text":"A lightweight collection of key-value pairs."}],"role":"symbol","title":"KeyValuePairs","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyValuePairs","kind":"identifier"}],"ki