{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral"],"anchor":"Collection-Literals","generated":true,"title":"Collection Literals"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/expressiblebydictionaryliteral"]}],"topicSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/Key","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/Value"],"anchor":"Associated-Types","generated":true,"title":"Associated Types"},{"anchor":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/init(dictionaryLiteral:)"],"generated":true,"title":"Initializers"}],"metadata":{"modules":[{"name":"Swift"}],"externalID":"s:s30ExpressibleByDictionaryLiteralP","title":"ExpressibleByDictionaryLiteral","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"ExpressibleByDictionaryLiteral","kind":"identifier"}],"platforms":[{"beta":false,"unavailable":false,"name":"iOS","introducedAt":"8.0","deprecated":false},{"deprecated":false,"name":"iPadOS","introducedAt":"8.0","unavailable":false,"beta":false},{"beta":false,"unavailable":false,"name":"Mac Catalyst","introducedAt":"13.0","deprecated":false},{"name":"macOS","beta":false,"deprecated":false,"introducedAt":"10.10","unavailable":false},{"deprecated":false,"name":"tvOS","introducedAt":"9.0","unavailable":false,"beta":false},{"deprecated":false,"name":"visionOS","introducedAt":"1.0","unavailable":false,"beta":false},{"beta":false,"unavailable":false,"name":"watchOS","introducedAt":"2.0","deprecated":false}],"navigatorTitle":[{"kind":"identifier","text":"ExpressibleByDictionaryLiteral"}],"symbolKind":"protocol","role":"symbol","roleHeading":"Protocol"},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral"},"abstract":[{"type":"text","text":"A type that can be initialized using a dictionary literal."}],"relationshipsSections":[{"title":"Inherited By","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Cxx\/CxxDictionary"],"type":"inheritedBy","kind":"relationships"},{"kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Dictionary","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs"],"type":"conformingTypes","title":"Conforming Types"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExpressibleByDictionaryLiteral","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"A dictionary literal is a simple way of writing a list of key-value pairs."},{"text":" ","type":"text"},{"type":"text","text":"You write each key-value pair with a colon ("},{"code":":","type":"codeVoice"},{"type":"text","text":") separating the key and"},{"type":"text","text":" "},{"type":"text","text":"the value. The dictionary literal is made up of one or more key-value"},{"type":"text","text":" "},{"type":"text","text":"pairs, separated by commas and surrounded with square brackets."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To declare a dictionary, assign a dictionary literal to a variable or"},{"type":"text","text":" "},{"type":"text","text":"constant:"}],"type":"paragraph"},{"code":["let countryCodes = [\"BR\": \"Brazil\", \"GH\": \"Ghana\",","                    \"JP\": \"Japan\", \"US\": \"United States\"]","\/\/ 'countryCodes' has type '[String: String]'","","print(countryCodes[\"BR\"]!)","\/\/ Prints \"Brazil\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"When the context provides enough type information, you can use a special"},{"type":"text","text":" "},{"type":"text","text":"form of the dictionary literal, square brackets surrounding a single"},{"type":"text","text":" "},{"type":"text","text":"colon, to initialize an empty dictionary."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var frequencies: [String: Int] = [:]","print(frequencies.count)","\/\/ Prints \"0\""]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"A dictionary literal is "},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"type":"text","text":" the same as an instance of "},{"code":"Dictionary","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You can’t initialize a type that conforms to "},{"code":"ExpressibleByDictionaryLiteral","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"simply by assigning an instance of "},{"code":"Dictionary","type":"codeVoice"},{"type":"text","text":", "},{"code":"KeyValuePairs","type":"codeVoice"},{"type":"text","text":", or similar."}]}]},{"type":"heading","text":"Conforming to the ExpressibleByDictionaryLiteral Protocol","level":1,"anchor":"Conforming-to-the-ExpressibleByDictionaryLiteral-Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add the capability to be initialized with a dictionary literal to your"},{"type":"text","text":" "},{"type":"text","text":"own custom types, declare an "},{"type":"codeVoice","code":"init(dictionaryLiteral:)"},{"type":"text","text":" initializer. The"},{"type":"text","text":" "},{"type":"text","text":"following example shows the dictionary literal initializer for a"},{"type":"text","text":" "},{"type":"text","text":"hypothetical "},{"type":"codeVoice","code":"CountedSet"},{"type":"text","text":" type, which uses setlike semantics while keeping"},{"type":"text","text":" "},{"type":"text","text":"track of the count for duplicate elements:"}]},{"type":"codeListing","syntax":"swift","code":["struct CountedSet<Element: Hashable>: Collection, SetAlgebra {","    \/\/ implementation details","","    \/\/\/ Updates the count stored in the set for the given element,","    \/\/\/ adding the element if necessary.","    \/\/\/","    \/\/\/ - Parameter n: The new count for `element`. `n` must be greater","    \/\/\/   than or equal to zero.","    \/\/\/ - Parameter element: The element to set the new count on.","    mutating func updateCount(_ n: Int, for element: Element)","}","","extension CountedSet: ExpressibleByDictionaryLiteral {","    init(dictionaryLiteral elements: (Element, Int)...) {","        self.init()","        for (element, count) in elements {","            self.updateCount(count, for: element)","        }","    }","}"]}]}],"references":{"doc://com.apple.Swift/documentation/Swift/KeyValuePairs":{"title":"KeyValuePairs","url":"\/documentation\/swift\/keyvaluepairs","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"KeyValuePairs"}],"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs","role":"symbol","abstract":[{"type":"text","text":"A lightweight collection of key-value pairs."}],"navigatorTitle":[{"text":"KeyValuePairs","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/ExpressibleByDictionaryLiteral/Value":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"identifier"}],"required":true,"type":"topic","abstract":[{"type":"text","text":"The value type of a dictionary literal."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral\/Value","kind":"symbol","title":"Value","url":"\/documentation\/swift\/expressiblebydictionaryl