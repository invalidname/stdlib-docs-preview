t the shift amount is in the range"},{"text":" ","type":"text"},{"code":"0..<lhs.bitWidth","type":"codeVoice"},{"text":". Before shifting, the masking right shift operator","type":"text"},{"type":"text","text":" "},{"type":"text","text":"masks the shift to this range. The shift is performed using this masked"},{"type":"text","text":" "},{"type":"text","text":"value."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example defines "},{"code":"x","type":"codeVoice"},{"type":"text","text":" as an instance of "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":", an 8-bit,"},{"type":"text","text":" "},{"type":"text","text":"unsigned integer type. If you use "},{"type":"codeVoice","code":"2"},{"type":"text","text":" as the right-hand-side value in an"},{"text":" ","type":"text"},{"type":"text","text":"operation on "},{"type":"codeVoice","code":"x"},{"type":"text","text":", the shift amount requires no masking."}]},{"type":"codeListing","syntax":"swift","code":["let x: UInt8 = 30                 \/\/ 0b00011110","let y = x &>> 2","\/\/ y == 7                         \/\/ 0b00000111"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"However, if you use "},{"type":"codeVoice","code":"8"},{"type":"text","text":" as the shift amount, the method first masks the"},{"text":" ","type":"text"},{"text":"shift amount to zero, and then performs the shift, resulting in no change","type":"text"},{"text":" ","type":"text"},{"text":"to the original value.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let z = x &>> 8","\/\/ z == 30                        \/\/ 0b00011110"]},{"inlineContent":[{"type":"text","text":"If the bit width of the shifted integer type is a power of two, masking"},{"type":"text","text":" "},{"type":"text","text":"is performed using a bitmask; otherwise, masking is performed using a"},{"type":"text","text":" "},{"type":"text","text":"modulo operation."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/fixedwidthinteger\/&__(_:_:)-9b5yu"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/FixedWidthInteger\/&__(_:_:)-9b5yu","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift":{"role":"collection","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","type":"topic","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/FixedWidthInteger":{"kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/FixedWidthInteger","abstract":[{"type":"text","text":"An integer type that uses a fixed size for every instance."}],"type":"topic","title":"FixedWidthInteger","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedWidthInteger","kind":"identifier"}],"navigatorTitle":[{"text":"FixedWidthInteger","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swift\/fixedwidthinteger"},"doc://com.apple.Swift/documentation/Swift/FixedWidthInteger/&__(_:_:)-9b5yu":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Returns the result of shifting a value’s binary representation the"},{"type":"text","text":" "},{"type":"text","text":"specified number of digits to the right, masking the shift amount to the"},{"type":"text","text":" "},{"type":"text","text":"type’s bit width."}],"title":"&>>(_:_:)","url":"\/documentation\/swift\/fixedwidthinteger\/&__(_:_:)-9b5yu","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/FixedWidthInteger\/&__(_:_:)-9b5yu","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"&>>","kind":"identifier"},{"text":" ","kind":"text"},{"text":"<