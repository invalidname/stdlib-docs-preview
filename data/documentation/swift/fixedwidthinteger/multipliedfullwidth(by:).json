nlike traditional truncating multiplication, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"multipliedFullWidth(by:)"},{"type":"text","text":" method returns a tuple containing both the"},{"type":"text","text":" "},{"type":"codeVoice","code":"high"},{"type":"text","text":" and "},{"type":"codeVoice","code":"low"},{"type":"text","text":" parts of the product of this value and "},{"type":"codeVoice","code":"other"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"following example uses this method to multiply two "},{"type":"codeVoice","code":"Int8"},{"type":"text","text":" values that"},{"type":"text","text":" "},{"type":"text","text":"normally overflow when multiplied:"}]},{"type":"codeListing","code":["let x: Int8 = 48","let y: Int8 = -40","let result = x.multipliedFullWidth(by: y)","\/\/ result.high == -8","\/\/ result.low  == 128"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The product of "},{"code":"x","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"y"},{"type":"text","text":" is "},{"type":"codeVoice","code":"-1920"},{"type":"text","text":", which is too large to represent in"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"codeVoice","code":"Int8"},{"type":"text","text":" instance. The "},{"type":"codeVoice","code":"high"},{"type":"text","text":" and "},{"code":"low","type":"codeVoice"},{"type":"text","text":" components of the "},{"type":"codeVoice","code":"result"},{"type":"text","text":" value"},{"type":"text","text":" "},{"type":"text","text":"represent "},{"type":"codeVoice","code":"-1920"},{"type":"text","text":" when concatenated to form a double-width integer; that"},{"type":"text","text":" "},{"type":"text","text":"is, using "},{"type":"codeVoice","code":"result.high"},{"type":"text","text":" as the high byte and "},{"type":"codeVoice","code":"result.low"},{"type":"text","text":" as the low byte"},{"type":"text","text":" "},{"type":"text","te