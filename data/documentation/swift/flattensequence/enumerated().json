ntent":[{"type":"text","text":"x"}],"type":"emphasis"},{"text":" represents an element of","type":"text"},{"text":" ","type":"text"},{"text":"the sequence.","type":"text"}],"title":"enumerated()","url":"\/documentation\/swift\/flattensequence\/enumerated()","role":"symbol"},"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/swift\/enumeratedsequence","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"EnumeratedSequence"}],"navigatorTitle":[{"kind":"identifier","text":"EnumeratedSequence"}],"title":"EnumeratedSequence","abstract":[{"type":"text","text":"An enumeration of the elements of a sequence or collection."}]}}}