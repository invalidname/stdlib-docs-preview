ed, the exponent is separated by a single","type":"text"},{"type":"text","text":" "},{"text":"character, ","type":"text"},{"type":"codeVoice","code":"p"},{"type":"text","text":" or "},{"code":"P","type":"codeVoice"},{"type":"text","text":", and consists of an optional plus or minus sign"},{"type":"text","text":" "},{"type":"text","text":"character and a sequence of decimal digits."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let g = Float16(\"0x1.c6p4\")","\/\/ g == 28.375"]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The input strings "},{"code":"\"inf\"","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"\"infinity\"","type":"codeVoice"},{"type":"text","text":" (case insensitive)"},{"text":" ","type":"text"},{"type":"text","text":"are converted to an infinite result:"}]},{"syntax":"swift","code":["let i = Float16(\"inf\")","\/\/ i == Float16.infinity","","let j = Float16(\"-Infinity\")","\/\/ j == -Float16.infinity"],"type":"codeListing"}]},{"content":[{"inlineContent":[{"type":"text","text":"An input string of "},{"type":"codeVoice","code":"\"nan\""},{"type":"text","text":" (case insensitive) is converted"},{"type":"text","text":" "},{"type":"text","text":"into a "},{"type":"emphasis","inlineContent":[{"text":"NaN","type":"text"}]},{"type":"text","text":" value:"}],"type":"paragraph"},{"syntax":"swift","code":["let n = Float16(\"-nan\")","\/\/ n?.isNaN == true","\/\/ n?.sign == .minus"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A NaN string may also include a payload in parentheses following the"},{"type":"text","text":" "},{"code":"\"nan\"","type":"codeVoice"},{"type":"text","text":" keyword. The payload consists of a sequence of decimal digits,"},{"type":"text","text":" "},{"type":"text","text":"or the characters "},{"code":"0X","type":"codeVoice"},{"type":"text","text":" or "},{"code":"0x","type":"codeVoice"},{"type":"text","text":" followed by a sequence of hexadecimal"},{"t