aN (“not a number”). If "},{"type":"codeVoice","code":"text"},{"type":"text","text":" is not in a recognized format,"},{"type":"text","text":" "},{"type":"text","text":"the optional initializer will fail and return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"text"},{"type":"text","text":" string consists of an optional"},{"type":"text","text":" "},{"type":"text","text":"plus or minus sign character ("},{"type":"codeVoice","code":"+"},{"type":"text","text":" or "},{"type":"codeVoice","code":"-"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"followed by one of the following:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"text":"decimal string","type":"text"}]},{"type":"text","text":" contains a significand consisting of one"},{"type":"text","text":" "},{"type":"text","text":"or more decimal digits that may include a decimal point:"}]},{"type":"codeListing","syntax":"swift","code":["let c = Float80(\"-1.0\")","\/\/ c == -1.0","","let d = Float80(\"28.375\")","\/\/ d == 28.375"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A decimal string may also include an exponent following the"},{"type":"text","text":" "},{"type":"text","text":"significand, indicating the power of 10 by which the significand should"},{"type":"text","text":" "},{"type":"text","text":"be multiplied. If included, the exponent is separated by a single"},{"type":"text","text":" "},{"type":"text","text":"character, "},{"type":"codeVoice","code":"e"},{"type":"text","text":" or "},{"type":"codeVoice","code":"E"},{"type":"text","text":", and consists of an optional plus or minus sign"},{"type":"text","text":" "},{"type":"text","text":"character and a sequence of decimal digits."}]},{"type":"codeListing","syntax":"swift","code":["let e = Float80(\"2837.5e-2\")","\/\/ e == 28.375"]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"text":"hexadecimal string","type":"text"}]},{"type":"text","text":" contains a significand consisting of"},{"type":"text","text":" "},{"type":"codeVoice","code":"0X"},{"type":"text","text":" or "},{"type":"codeVoice","code":"0x"},{"type":"text","text":" followed by one or more hexadecimal digits that may"},{"type":"text","text":" "},{"type":"text","text":"include a decimal point."}]},{"type":"codeListing","syntax":"swift","code":["let f = Float80(\"0x1c.6\")","\/\/ f == 28.375"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A hexadecimal string may also include an exponent"},{"type":"text","text":" "},{"type":"text","text":"indicating the power of 2 by which the significand should"},{"type":"text","text":" "},{"type":"text","text":"be multiplied. If included, the exponent is separated by a single"},{"type":"text","text":" "},{"type":"text","text":"character, "},{"type":"codeVoice","code":"p"},{"type":"text","text":" or "},{"type":"codeVoice","code":"P"},{"type":"text","text":", and consists of an optional plus or minus sign"},{"type":"text","text":" "},{"type":"text","text":"character and a sequence of decimal digits."}]},{"type":"codeListing","syntax":"swift","code":["let g = Float80(\"0x1.c6p4\")","\/\/ g == 28.375"]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The input strings "},{"type":"codeVoice","code":"\"inf\""},{"type":"text","text":" or "},{"type":"codeVoice","code":"\"infinity\""},{"type":"text","text":" (case insensitive)"},{"type":"text","text":" "},{"type":"text","text":"are converted to an infinite result:"}]},{"type":"codeListing","syntax":"swift","code":["let i = Float80(\"inf\")","\/\/ i == Float80.infinity","","let j = Float80(\"-Infinity\")","\/\/ j == -Float80.infinity"]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An input string of "},{"type":"codeVoice","code":"\"nan\""},{"type":"text","text":" (case insensitive) is converted"},{"type":"text","text":" "},{"type":"text","text":"into a "},{"type":"emphasis","inlineContent":[{"text":"NaN","type":"text"}]},{"type":"text","text":" value:"}]},{"type":"codeListing","syntax":"swift","code":["let n = Float80(\"-nan\")","\/\/ n?.isNaN == true","\/\/ n?.sign == .minus"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A NaN string may also include a payload in parentheses following the"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"nan\""},{"type":"text","text":" keyword. The payload consists of a sequence of decimal digits,"},{"type":"text","text":" "},{"type":"text","text":"or the characters "},{"type":"codeVoice","code":"0X"},{"type":"text","text":" or "},{"type":"codeVoice","code":"0x"},{"type":"text","text":" followed by a sequence of hexadecimal"},{"type":"text","text":" "},{"type":"text","text":"digits. If the payload contains any other characters, it is ignored."},{"type":"text","text":" "},{"type":"text","text":"If the value of the payload is larger than can be stored as the"},{"type":"text","text":" "},{"type":"text","text":"payload of a "},{"type":"codeVoice","code":"Float80.nan"},{"type":"text","text":", the least significant bits are used."}]},{"type":"codeListing","syntax":"swift","code":["let p = Float80(\"nan(0x10)\")","\/\/ p?.isNaN == true","\/\/ String(p!) == \"nan(0x10)\""]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An input string of "},{"type":"codeVoice","code":"\"snan\""},{"type":"text","text":" (case insensitive) is converted"},{"type":"text","text":" "},{"type":"text","text":"into a "},{"type":"emphasis","inlineContent":[{"text":"signaling NaN","type":"text"}]},{"type":"text","text":" value.  This form permits an optional"},{"type":"text","text":" "},{"type":"text","text":"payload in the same format as for a non-signaling NaN."}]}]}],"type":"unorderedList"},{"