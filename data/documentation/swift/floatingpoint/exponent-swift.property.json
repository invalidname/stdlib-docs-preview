{"abstract":[{"text":"The exponent of the floating-point value.","type":"text"}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"symbolKind":"property","required":true,"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"exponent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Exponent","preciseIdentifier":"s:SF8ExponentQa"}],"title":"exponent","roleHeading":"Instance Property","platforms":[{"beta":false,"unavailable":false,"name":"iOS","deprecated":false,"introducedAt":"8.0"},{"beta":false,"unavailable":false,"name":"iPadOS","deprecated":false,"introducedAt":"8.0"},{"beta":false,"unavailable":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"13.0"},{"beta":false,"unavailable":false,"name":"macOS","deprecated":false,"introducedAt":"10.10"},{"beta":false,"unavailable":false,"name":"tvOS","deprecated":false,"introducedAt":"9.0"},{"beta":false,"unavailable":false,"name":"visionOS","deprecated":false,"introducedAt":"1.0"},{"beta":false,"unavailable":false,"name":"watchOS","deprecated":false,"introducedAt":"2.0"}],"modules":[{"name":"Swift"}],"externalID":"s:SF8exponent8ExponentQzvp","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/FloatingPoint"]]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/FloatingPoint\/exponent-swift.property","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"exponent","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Exponent","kind":"typeIdentifier","preciseIdentifier":"s:SF8ExponentQa","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/FloatingPoint\/Exponent-swift.associatedtype"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"exponent"}]},{"text":" of a floating-point value is the integer part of the","type":"text"},{"text":" ","type":"text"},{"text":"logarithm of the value’s magnitude. For a value ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" of a floating-point","type":"text"},{"text":" ","type":"text"},{"text":"type ","type":"text"},{"code":"F","type":"codeVoice"},{"text":", the magnitude can be calculated as the following, where ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is exponentiation:","type":"text"}],"type":"paragraph"},{"code":["x.significand * (F.radix ** x.exponent)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"In the next example, ","type":"text"},{"code":"y","type":"codeVoice"},{"text":" has a value of ","type":"text"},{"code":"21.5","type":"codeVoice"},{"text":", which is encoded as","type":"text"},{"text":" ","type":"text"},{"code":"1.34375 * 2 ** 4","type":"codeVoice"},{"text":". The significand of ","type":"text"},{"code":"y","type":"codeVoice"},{"text":" is therefore 1.34375.","type":"text"}],"type":"paragraph"},{"code":["let y: Double = 21.5","\/\/ y.significand == 1.34375","\/\/ y.exponent == 4","\/\/ Double.radix == 2"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"exponent","type":"codeVoice"},{"text":" property has the following edge cases:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"x"},{"type":"text","text":" is zero, then "},{"type":"codeVoice","code":"x.exponent"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Int.min"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"x"},{"type":"text","text":" is +\/-infinity or NaN, then "},{"type":"codeVoice","code":"x.exponent"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Int.max"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This property implements the ","type":"text"},{"code":"logB","type":"codeVoice"},{"text":" operation defined by the ","type":"text"},{"isActive":true,"type":"reference","identifier":"http:\/\/ieeexplore.ieee.org\/servlet\/opac?punumber=4610933"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/floatingpoint\/exponent-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift":{"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","title":"Swift","url":"\/documentation\/swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"images":[{"identifier":"Swift-PageImage-card.png","type":"card"}],"kind":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/Swift/FloatingPoint/Exponent-swift.associatedtype":{"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/FloatingPoint\/Exponent-swift.associatedtype","title":"Exponent","url":"\/documentation\/swift\/floatingpoint\/exponent-swift.associatedtype","abstract":[{"text":"A type that can represent any written exponent.","type":"text"}],"required":true,"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Exponent"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SZ","text":"SignedInteger"}]},"Swift-PageImage-card.png":{"type":"image","identifier":"Swift-PageImage-card.png","alt":"An orange Swift logo on a gradient background.","variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","l