text":" is +\/-infinity or NaN, then "},{"code":"x.exponent","type":"codeVoice"},{"type":"text","text":" is "},{"code":"Int.max","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This property implements the "},{"type":"codeVoice","code":"logB"},{"type":"text","text":" operation defined by the "},{"isActive":true,"type":"reference","identifier":"http:\/\/ieeexplore.ieee.org\/servlet\/opac?punumber=4610933"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/floatingpoint\/exponent-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://com.apple.Swift/documentation/Swift/FloatingPoint/exponent-swift.property":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/FloatingPoint\/exponent-swift.property","type":"topic","kind":"symbol","title":"exponent","required":true,"role":"symbol","url":"\/documentation\/swift\/floatingpoint\/exponent-swift.property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"exponent","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Exponent","preciseIdentifier":"s:SF8ExponentQa","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The exponent of the floating-point value."}]},"doc://com.apple.Swift/documentation/Swift/FloatingPoint":{"title":"FloatingPoint","url":"\/documentation\/swift\/floatingpoint","navigatorTitle":[{"kind":"identifier","text":"FloatingPoint"}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"FloatingPoint"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/FloatingPoint","abstract":[{"text":"A floating-point numeric type.","type":"text"}]},"Swift-PageImage-card.png":{"variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","