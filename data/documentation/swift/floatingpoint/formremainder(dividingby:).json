 \/ y"},{"type":"text","text":" is exactly halfway between two integers, "},{"code":"q","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"chosen to be even. Note that ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"code":"x \/ y","type":"codeVoice"},{"text":" computed in","type":"text"},{"text":" ","type":"text"},{"text":"floating-point arithmetic, and that ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" may not be representable in any","type":"text"},{"text":" ","type":"text"},{"text":"available integer type.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example calculates the remainder of dividing 8.625 by 0.75:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var x = 8.625","print(x \/ 0.75)","\/\/ Prints \"11.5\"","","let q = (x \/ 0.75).rounded(.toNearestOrEven)","\/\/ q == 12.0","x.formRemainder(dividingBy: 0.75)","\/\/ x == -0.375","","let x1 = 0.75 * q + x","\/\/ x1 == 8.625"],"type":"codeListing"},{"inlineContent":[{"text":"If this value and ","type":"text"},{"code":"other","type":"codeVoice"},{"text":" are finite numbers, the remainder is in the","type":"text"},{"text":" ","type":"text"},{"text":"closed range ","type":"text"},{"code":"-abs(other \/ 2)...abs(other \/ 2)","type":"codeVoice"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"code":"formRemainder(dividingBy:)","type":"codeVoice"},{"text":" method is always exact.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/floatingpoint\/formremainder(dividingby:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/FloatingPoint/formTruncatingRemainder(dividingBy:)":{"abstract":[{"type":"text","text":"Replaces this value with the remainder of itself divided by the given"},{"ty