:"keyword"},{"text":" ","kind":"text"},{"text":"formRemainder","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"dividingBy"},{"kind":"text","text":" "},{"kind":"internalParam","text":"other"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":")"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The value to use when dividing this value."}],"type":"paragraph"}],"name":"other"}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For two finite values "},{"code":"x","type":"codeVoice"},{"type":"text","text":" and "},{"code":"y","type":"codeVoice"},{"type":"text","text":", the remainder "},{"code":"r","type":"codeVoice"},{"type":"text","text":" of dividing "},{"code":"x","type":"codeVoice"},{"type":"text","text":" by"},{"type":"text","text":" "},{"code":"y","type":"codeVoice"},{"type":"text","text":" satisfies "},{"code":"x == y * q + r","type":"codeVoice"},{"type":"text","text":", where "},{"code":"q","type":"codeVoice"},{"type":"text","text":" is the integer nearest to"},{"type":"text","text":" "},{"code":"x \/ y","type":"codeVoice"},{"type":"text","text":". If "},{"code":"x \/ y","type":"codeVoice"},{"type":"text","text":" is exactly halfway between two integers, "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"chosen to be even. Note that "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"codeVoice","code":"x \/ y"},{"type":"text","text":" computed in"},{"type":"text","text":" "},{"type":"text","text":"floating-point arithmetic, and that "},{"type":"codeVoice","code":"q"},{"type":"text","text":" may not be representable in any"},{"type":"text","text":" "},{"type":"text","text":"available integer type."}]},{"type":"paragraph","inlineContent":[{"text":"The following example calculates the remainder of dividing 8.625 by 0.75:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var x = 8.625","print(x \/ 0.75)","\/\/ Prints \"11.5\"","","let q = (x \/ 0.75).rounded(.toNearestOrEven)","\/\/ q == 12.0","x.formRemainder(dividingBy: 0.75)","\/\/ x == -0.375","","let x1 = 0.75 * q + x","\/\/ x1 == 8.625"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If this value and "},{"type":"codeVoice","code":"other"},{"type":"text","text":" are finite numbers, the remainder is in the"},{"type":"text","text":" "},{"type":"text","text":"closed range "},{"type":"codeVoice","code":"-abs(other \/ 2)...abs(other \/ 2)"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"codeVoice","code":"formRemainder(dividingBy:)"},{"type":"text","text":" method is always exact."}]}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/FloatingPoint":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"FloatingPoint"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FloatingPoint"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/FloatingPoint","abstract":[{"text":"A floating-point numeric type.","type":"text"}],"url":"\/documentation\/swift\/floatingpoint","title":"FloatingPoint","type":"topic","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift":{"kind":"symbol","type":"topic","role":"collection","title":"Swift","images":[{"type":"card","identifier":"Swift-PageImage-card.png"}],"abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/FloatingPoint/formRemainder(dividingBy:)":{"role":"symbol","kind":"symbol","title":"formRemainder(dividingBy:)","requi