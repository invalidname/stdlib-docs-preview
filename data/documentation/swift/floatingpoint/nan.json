nlineContent":[{"type":"text","text":"A NaN compares not equal, not greater than, and not less than every"},{"type":"text","text":" "},{"type":"text","text":"value, including itself. Passing a NaN to an operation generally results"},{"type":"text","text":" "},{"type":"text","text":"in NaN."}],"type":"paragraph"},{"syntax":"swift","code":["let x = 1.21","\/\/ x > Double.nan == false","\/\/ x < Double.nan == false","\/\/ x == Double.nan == false"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Because a NaN always compares not equal to itself, to test whether a"},{"type":"text","text":" "},{"type":"text","text":"floating-point value is NaN, use its "},{"type":"codeVoice","code":"isNaN"},{"type":"text","text":" property instead of the"},{"type":"text","text":" "},{"type":"text","text":"equal-to operator ("},{"type":"codeVoice","code":"=="},{"type":"text","text":"). In the following example, "},{"type":"codeVoice","code":"y"},{"type":"text","text":" is NaN."}],"type":"paragraph"},{"syntax":"swift","code":["let y = x + Double.nan","print(y == Double.nan)","\/\/ Prints \"false\"","print(y.isNaN)","\/\/ Prints \"true\""],"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/FloatingPoint\/nan","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift":{"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","title":"Swift","url":"\/documentation\/swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"images":[{"identifier":"Swift-PageImage-card.png","type":"card"}],"kind":"symbol","type":"topic"},"Swift-PageImage-card.png":{"alt":"An orange Swift logo on a gradient background.","identifier":"Swift-PageImage-card.png","type":"image","variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png","traits":["2x","dark"]}]},"doc://co