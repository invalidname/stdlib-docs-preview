{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"signalingNaN","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["macOS"]}]},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The default IEEE 754 behavior of operations involving a signaling NaN is"},{"type":"text","text":" "},{"text":"to raise the Invalid flag in the floating-point environment and return a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"quiet NaN."}],"type":"paragraph"},{"inlineContent":[{"text":"Operations on types conforming to the ","type":"text"},{"type":"codeVoice","code":"FloatingPoint"},{"text":" protocol should","type":"text"},{"text":" ","type":"text"},{"text":"support this behavior, but they might also support other options. For","type":"text"},{"text":" ","type":"text"},{"text":"example, it would be reasonable to implement alternative operations in","type":"text"},{"text":" ","type":"text"},{"text":"which operating on a signaling NaN triggers a runtime error or results","type":"text"},{"text":" ","type":"text"},{"text":"in a diagnostic for debugging purposes. Types that implement alternative","type":"text"},{"text":" ","type":"text"},{"text":"behaviors for a signaling NaN must document the departure.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Other than these signaling operations, a signaling NaN behaves in the","type":"text"},{"text":" ","type":"text"},{"text":"same manner as a quiet NaN.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documen