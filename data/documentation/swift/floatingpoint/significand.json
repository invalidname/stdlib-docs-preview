{"metadata":{"externalID":"s:SF11significandxvp","roleHeading":"Instance Property","title":"significand","role":"symbol","required":true,"symbolKind":"property","modules":[{"name":"Standard Library"}],"platforms":[{"introducedAt":"8.0","beta":false,"deprecated":false,"name":"iOS","unavailable":false},{"introducedAt":"8.0","beta":false,"deprecated":false,"name":"iPadOS","unavailable":false},{"introducedAt":"13.0","beta":false,"deprecated":false,"name":"Mac Catalyst","unavailable":false},{"introducedAt":"10.10","beta":false,"deprecated":false,"name":"macOS","unavailable":false},{"introducedAt":"9.0","beta":false,"deprecated":false,"name":"tvOS","unavailable":false},{"introducedAt":"1.0","beta":false,"deprecated":false,"name":"visionOS","unavailable":false},{"introducedAt":"2.0","beta":false,"deprecated":false,"name":"watchOS","unavailable":false}],"fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"significand"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"}]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"significand","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The magnitude of a floating-point value ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" of type ","type":"text"},{"code":"F","type":"codeVoice"},{"text":" can be calculated","type":"text"},{"text":" ","type":"text"},{"text":"by using the following formula, where ","type":"text"},{"code":"**","type":"codeVoice"},{"text":" is exponentiation:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["x.significand * (F.radix ** x.exponent)"]},{"inlineContent":[{"text":"In the next example, ","type":"text"},{"code":"y","type":"codeVoice"},{"text":" has a value of ","type":"text"},{"code":"21.5","type":"codeVoice"},{"text":", which is encoded as","type":"text"},{"text":" ","type":"text"},{"code":"1.34375 * 2 ** 4","type":"codeVoice"},{"text":". The significand of ","type":"text"},{"code":"y","type":"codeVoice"},{"text":" is therefore 1.34375.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let y: Double = 21.5","\/\/ y.significand == 1.34375","\/\/ y.exponent == 4","\/\/ Double.radix == 2"],"type":"codeListing"},{"inlineContent":[{"text":"If a type’s radix is 2, then for finite nonzero numbers, the significand","type":"text"},{"text":" ","type":"text"},{"text":"is in the range ","type":"text"},{"code":"1.0 ..< 2.0","type":"codeVoice"},{"text":". For other values of ","type":"text"},{"code":"x","type":"codeVoice"},{"text":", ","type":"text"},{"code":"x.significand","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is defined as follows:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" is zero, then ","type":"text"},{"code":"x.significand","type":"codeVoice"},{"text":" is 0.0.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"x"},{"type":"text","text":" is infinite, then "},{"code":"x.significand","type":"codeVoice"},{"text":" is infinity.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"x"},{"type":"text","text":" is NaN, then "},{"type":"codeVoice","code":"x.significand"},{"text":" is NaN.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"text":"The significand is frequently also called the ","type":"text"},{"inlineContent":[{"text":"mantissa","type":"text"}],"type":"emphasis