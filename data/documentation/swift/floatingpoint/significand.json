{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/FloatingPoint"]]},"abstract":[{"type":"text","text":"The significand of the floating-point value."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"significand","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"The magnitude of a floating-point value ","type":"text"},{"type":"codeVoice","code":"x"},{"text":" of type ","type":"text"},{"code":"F","type":"codeVoice"},{"type":"text","text":" can be calculated"},{"type":"text","text":" "},{"type":"text","text":"by using the following formula, where "},{"code":"**","type":"codeVoice"},{"type":"text","text":" is exponentiation:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["x.significand * (F.radix ** x.exponent)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the next example, "},{"code":"y","type":"codeVoice"},{"type":"text","text":" has a value of "},{"type":"codeVoice","code":"21.5"},{"type":"text","text":", which is encoded as"},{"type":"text","text":" "},{"type":"codeVoice","code":"1.34375 * 2 ** 4"},{"type":"text","text":". The significand of "},{"type":"codeVoice","code":"y"},{"type":"text","text":" is therefore 1.34375."}]},{"type":"codeListing","code":["let y: Double = 21.5","\/\/ y.significand == 1.34375","\/\/ y.exponent == 4","\/\/ Double.radix == 2"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If a type’s radix is 2, then for finite nonzero numbers, the significand","type":"text"},{"text":" ","type":"text"},{"text":"is in the range ","type":"text"},{"type":"codeVoice","code":"1.0 ..< 2.0"},{"text":". For other values of ","type":"text"},{"type":"codeVoice","code":"x"},{"text":", ","type":"text"},{"type":"codeVoice","code":"x.significand"},{"text":" ","type":"text"},{"text":"is defined as follows:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" is zero, then ","type":"text"},{"code":"x.significand","type":"codeVoice"},{"text":" is 0.0.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"x","type":"codeVoice"},{"type":"text","text":" is infinite, then "},{"code":"x.significand","type":"codeVoice"},{"type":"text","text":" is infinity."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"x"},{"type":"text","text":" is NaN, then "},{"type":"codeVoice","code":"x.significand"},{"type":"text","text":" is NaN."}]}]}]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The significand is frequently also called the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"mantissa"}]},{"type":"text","text":", but"},{"type":"text","text":" "},{"type":"text","text":"significand is the preferred terminology in the "},{"type":"reference","identifier":"http:\/\/ieeexplore.ieee.org\/servlet\/opac?punumber=4610933","isActive":true},{"type":"text","text":", to allay confusion with the use of mantissa for"},{"type":"text","text":" "},{"type":"text","text":"the fractional part of a logarithm."}]}],"style":"note"}]}],"variants":[{"paths":["\/documentation\/swift\/floatingpoint\/significand"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"property","required":true,"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"signific