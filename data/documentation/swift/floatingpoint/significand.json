{"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/FloatingPoint\/significand","interfaceLanguage":"swift"},"metadata":{"role":"symbol","roleHeading":"Instance Property","modules":[{"name":"Swift"}],"title":"significand","platforms":[{"deprecated":false,"introducedAt":"8.0","unavailable":false,"beta":false,"name":"iOS"},{"name":"iPadOS","introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false},{"name":"Mac Catalyst","introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false},{"name":"macOS","introducedAt":"10.10","deprecated":false,"unavailable":false,"beta":false},{"name":"tvOS","introducedAt":"9.0","deprecated":false,"unavailable":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false},{"name":"watchOS","introducedAt":"2.0","deprecated":false,"unavailable":false,"beta":false}],"symbolKind":"property","externalID":"s:SF11significandxvp","required":true,"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"significand","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"significand"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The magnitude of a floating-point value "},{"code":"x","type":"codeVoice"},{"type":"text","text":" of type "},{"code":"F","type":"codeVoice"},{"type":"text","text":" can be calculated"},{"type":"text","text":" "},{"type":"text","text":"by using the following formula, where "},{"code":"**","type":"codeVoice"},{"type":"text","text":" is exponentiation:"}]},{"type":"codeListing","syntax":"swift","code":["x.significand * (F.radix ** x.exponent)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the next example, "},{"code":"y","type":"codeVoice"},{"type":"text","text":" has a value of "},{"code":"21.5","type":"codeVoice"},{"type":"text","text":", which is encoded as"},{"type":"text","text":" "},{"code":"1.34375 * 2 ** 4","type":"codeVoice"},{"type":"text","text":". The significand of "},{"code":"y","type":"codeVoice"},{"type":"text","text":" is therefore 1.34375."}]},{"type":"codeListing","syntax":"swift","code":["let y: Double = 21.5","\/\/ y.significand == 1.34375","\/\/ y.exponent == 4","\/\/ Double.radix == 2"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a type’s radix is 2, then for finite nonzero numbers, the significand"},{"type":"text","text":" "},{"type":"text","text":"is in the range "},{"code":"1.0 ..< 2.0","type":"codeVoice"},{"type":"text","text":". For other values of "},{"code":"x","type":"codeVoice"},{"type":"text","text":", "},{"code":"x.significand","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is defined as follows:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" is zero, then ","type":"text"},{"code":"x.significand","type":"codeVoice"},{"text":" is 0.0.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" is infinite, then ","type":"text"},{"code":"x.significand","type":"codeVoice"},{"text":" is infinity.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"x","type":"codeVoice"},{"text":" is NaN, then ","type":"text"},{"code":"x.significand","type":"codeVoice"},{"text":" is NaN.","type":"text"}],"type":"paragraph"}]}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"The significand is frequently also called the ","type":"text"},{"inlineContent":[{"text":"mantissa","type":"text"}],"type":"emphasis"},{"text":", but","type":"text"},{"text":" ","type":"text"},{"text":"significand is the preferred terminology in the ","type":"text"},{"isActive":true,"identifier":"http:\/\/ieeexplore.ieee.org\/servlet\/opac?punumber=4610933","type":"reference"},{"text":", to allay confusion with the use of mantissa for","type":"text"},{"text":" ","type":"text"},{"text":"the fractional part of a logarithm.","type":"text"}]}],"name":"Note"}]}],"abstract":[{"type":"text","text":"The significand of the floating-point value."}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/FloatingPoint"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/floatingpoint\/significand"]}],"references":{"doc://com.apple.Swift/documentation/Swift/FloatingPoint/significand":{"type":"topic","kind":"symbol","title":"significand","role":"symbol","required":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/FloatingPoint\/significand","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"significand"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"}],"url":"\/documentation\/swift\/floatingpoint\/significand","abstract":[{"type":"text","text":"The significand of the floating-point value."}]},"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","type":"topic","role":"collection","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","title":"Swift","kind":"symbol","images":[{"identifier":"Swift-PageImage-card.png","type":"card"}]},"doc://com.apple.Swift/documenta