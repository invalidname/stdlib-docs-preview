xt","text":" "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/unownedExecutor","isActive":true,"type":"reference"},{"type":"text","text":" nonisolated property in the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/GlobalActor\/ActorType","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"underlying this global actor."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"type":"text","text":" necessary to override the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/GlobalActor\/sharedUnownedExecutor","isActive":true,"type":"reference"},{"type":"text","text":" static"},{"type":"text","text":" "},{"type":"text","text":"property of the global actor, as its default implementation already"},{"type":"text","text":" "},{"type":"text","text":"delegates to the "},{"code":"shared.unownedExecutor","type":"codeVoice"},{"type":"text","text":", which is the most reasonable"},{"type":"text","text":" "},{"type":"text","text":"and correct implementation of this protocol requirement."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can find out more about custom executors, by referring to the"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor","isActive":true,"type":"reference"},{"type":"text","text":" protocol’s documentation."}],"type":"paragraph"},{"name":"See Also","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor","isActive":true}],"type":"paragraph"}],"style":"note","type":"aside"}],"kind":"content"}],"metadata":{"role":"symbol","roleHeading":"Protocol","title":"GlobalActor","platforms":[{"unavailable":false,"name":"iOS","beta":false,"deprecated":false,"introducedAt":"8.0"},{"unavailable":false,"name":"iPadOS","beta":false,"depre