{"metadata":{"navigatorTitle":[{"kind":"identifier","text":"Hasher"}],"role":"symbol","externalID":"s:s6HasherV","roleHeading":"Structure","platforms":[{"introducedAt":"8.0","name":"iOS","beta":false,"unavailable":false,"deprecated":false},{"introducedAt":"8.0","name":"iPadOS","beta":false,"unavailable":false,"deprecated":false},{"introducedAt":"13.0","name":"Mac Catalyst","beta":false,"unavailable":false,"deprecated":false},{"introducedAt":"10.10","name":"macOS","beta":false,"unavailable":false,"deprecated":false},{"introducedAt":"9.0","name":"tvOS","beta":false,"unavailable":false,"deprecated":false},{"introducedAt":"1.0","name":"visionOS","beta":false,"unavailable":false,"deprecated":false},{"introducedAt":"2.0","name":"watchOS","beta":false,"unavailable":false,"deprecated":false}],"modules":[{"name":"Swift"}],"title":"Hasher","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hasher"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/hasher"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hasher","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"code":"Hasher","type":"codeVoice"},{"text":" can be used to map an arbitrary sequence of bytes to an integer","type":"text"},{"text":" ","type":"text"},{"text":"hash value. You can feed data to the hasher using a series of calls to","type":"text"},{"text":" ","type":"text"},{"text":"mutating ","type":"text"},{"code":"combine","type":"codeVoice"},{"text":" methods. When you’ve finished feeding the hasher, the","type":"text"},{"text":" ","type":"text"},{"text":"hash value can be retrieved by calling ","type":"text"},{"code":"finalize()","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var hasher = Hasher()","hasher.combine(23)","hasher.combine(\"Hello\")","let hashValue = hasher.finalize()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Within the execution of a Swift program, "},{"type":"codeVoice","code":"Hasher"},{"type":"text","text":" guarantees that finalizing"},{"type":"text","text":" "},{"type":"text","text":"it will always produce the same hash value as long as it is fed the exact"},{"type":"text","text":" "},{"type":"text","text":"same sequence of bytes. However, the underlying hash algorithm is designed"},{"type":"text","text":" "},{"type":"text","text":"to exhibit avalanche effects: slight changes to the seed or the input byte"},{"type":"text","text":" "},{"type":"text","text":"sequence will typically produce drastic changes in the generated hash value."}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Do not save or otherwise reuse hash values across executions of your","type":"text"},{"text":" ","type":"text"},{"text":"program. ","type":"text"},{"code":"Hasher","type":"codeVoice"},{"text":" is usually randomly seeded, which means it will return","type":"text"},{"text":" ","type":"text"},{"text":"different values on every new execution of your program. The hash","type":"text"},{"text":" ","type":"text"},{"text":"algorithm implemented by ","type":"text"},{"code":"Hasher","type":"codeVoice"},{"type":"text","text":" may itself change between any two"},{"type":"text","text":" "},{"type":"text","text":"versions of the standard library."}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Hasher"},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"topicSections":[{"title":"Creating