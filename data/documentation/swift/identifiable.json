/Identifiable\/ID-swift.associatedtype"],"anchor":"Specifying-the-Associated-Type"},{"title":"Specifying the Identified Item","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable\/id-8t2ws"],"anchor":"Specifying-the-Identified-Item"}],"seeAlsoSections":[{"title":"Equality and Ordering","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Comparable"],"anchor":"Equality-and-Ordering","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Identifiable"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:s12IdentifiableP2IDQa","kind":"typeIdentifier","text":"ID","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable\/ID-swift.associatedtype"},{"kind":"text","text":">"}]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Identifiable"},{"type":"text","text":" protocol to provide a stable notion of identity to a"},{"type":"text","text":" "},{"type":"text","text":"class or value type. For example, you could define a "},{"type":"codeVoice","code":"User"},{"text":" type with an ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" ","type":"text"},{"type":"text","text":"property that is stable across your app and your app’s database storage."},{"type":"text","text":" "},{"type":"text","text":"You could use the "},{"code":"id","type":"codeVoice"},{"type":"text","text":" property to identify a particular user even if other"},{"type":"text","text":" "},{"type":"text","text":"data fields change, such as the user’s name."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Identifiable"},{"type":"text","text":" leaves the duration and scope of the identity unspecified."},{"type":"text","text":" "},{"type":"text","text":"Identities can have any of the following characteristics:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Guaranteed always unique, like UUIDs.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Persistently unique per environment, like database record keys."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unique for the lifetime of a process, like global incrementing integers."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unique for the lifetime of an object, like object identifiers."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Unique within the current collection, like collection indices."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"It’s up to both the conformer and the receiver of the protocol to document","type":"text"},{"text":" ","type":"text"},{"text":"the nature of the identity.","type":"text"}]},{"anchor":"Conforming-to-the-Identifiable-Protocol","text":"Conforming to the Identifiable Protocol","level":1,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Identifiable"},{"type":"text","text":" provides a default implementation for class types (using"},{"type":"text","text":" "},{"type":"codeVoice","code":"ObjectIdentifier"},{"type":"text","text":"), which is only guaranteed to remain unique for the"},{"type":"text","text":" "},{"type":"text","text":"lifetime of an object. If an object has a stronger notion of identity, it"},{"type":"text","text":" "},{"type":"text","text":"may be appropriate to provide a custom implementation."}],"type":"paragraph"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Never":{"type":"topic","title":"Never","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Never