{"abstract":[{"type":"text","text":"A class of types whose instances hold the value of an entity with stable"},{"text":" ","type":"text"},{"text":"identity.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"sections":[],"kind":"symbol","metadata":{"externalID":"s:s12IdentifiableP","title":"Identifiable","symbolKind":"protocol","platforms":[{"name":"iOS","introducedAt":"8.0","unavailable":false,"deprecated":false,"beta":false},{"name":"iPadOS","introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false},{"name":"Mac Catalyst","introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false},{"name":"macOS","introducedAt":"10.10","deprecated":false,"unavailable":false,"beta":false},{"name":"tvOS","introducedAt":"9.0","deprecated":false,"unavailable":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","unavailable":false,"deprecated":false,"beta":false},{"name":"watchOS","introducedAt":"2.0","deprecated":false,"unavailable":false,"beta":false}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Identifiable","kind":"identifier"}],"roleHeading":"Protocol","navigatorTitle":[{"text":"Identifiable","kind":"identifier"}],"role":"symbol","modules":[{"name":"Swift"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"title":"Inherited By","type":"inheritedBy","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor"],"kind":"relationships"},{"title":"Conforming Types","type":"conformingTypes","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Never"],"kind":"relationships"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Identifiable","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s12IdentifiableP2IDQa","text":"ID","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable\/ID-swift.associatedtype"},{"text":">","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Identifiable"},{"type":"text","text":" protocol to provide a stable notion of identity to a"},{"type":"text","text":" "},{"type":"text","text":"class or value type. For example, you could define a "},{"type":"codeVoice","code":"User"},{"type":"text","text":" type with an "},{"type":"codeVoice","code":"id"},{"type":"text","text":" "},{"type":"text","text":"property that is stable across your app and your app’s database storage."},{"type":"text","text":" "},{"type":"text","text":"You could use the "},{"type":"codeVoice","code":"id"},{"type":"text","text":" property to identify a particular user even if other"},{"type":"text","text":" "},{"type":"text","text":"data fields change, such as the user’s name."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Identifiable"},{"type":"text","text":" leaves the duration and scope of the identity unspecified."},{"type":"text","text":" "},{"type":"text","text":"Identities can have any of the following characteristics:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Guaranteed always unique, like UUIDs.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Persistently unique per environment, like database record keys.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Unique for the lifetime of a process, like global incrementing integers."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Unique for the lifetime of an object, like object identifiers."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Unique within the current collection, like collection indices."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It’s up to both the conformer and the receiver of the protocol to document"},{"type":"text","text":" "},{"type":"text","text":"the nature of the identity."}]},{"text":"Conforming to the Identifiable Protocol","level":1,"type":"heading","anchor":"Conforming-to-the-Identifiable-Protocol"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Identifiable"},{"type":"text","text":" provides a default implementation for class types (using"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ObjectIdentifier"},{"type":"text","text":"), which is only guaranteed to remain unique for the"},{"type":"text","text":" "},{"type":"text","text":"lifetime of an object. If an object has a stronger notion of identity, it"},{"type":"text","text":" "},{"type":"text","text":"may be appropriate to provide a custom implementation."}]}]}],"variants":[{"paths":["\/documentation\/swift\/identifiable"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable"},"seeAlsoSections":[{"title":"Equality and Ordering","anchor":"Equality-and-Ordering","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Comparable"],"generated":true}],"topicSections":[{"anchor":"Specifying-the-Associated-Type","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable\/ID-swift.associatedtype"],"title":"Specifying the Associated Type"},{"title":"Specifying the Identified Item","anchor":"Specifying-the-Identified-Item","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable\/id-8t2ws"]}],"references":{"doc://com.apple.Swift/documentation/Swift/Never":{"abstract":[{"type":"text","text":"A type that has no values and can’t be constructed."}],"navigatorTitle":[{"kind":"identifier","text":"Never"}],"url":"\