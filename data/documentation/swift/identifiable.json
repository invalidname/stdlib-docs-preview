minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Identifiable","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s12IdentifiableP2IDQa","text":"ID","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable\/ID-swift.associatedtype"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Identifiable"},{"type":"text","text":" protocol to provide a stable notion of identity to a"},{"type":"text","text":" "},{"type":"text","text":"class or value type. For example, you could define a "},{"type":"codeVoice","code":"User"},{"type":"text","text":" type with an "},{"type":"codeVoice","code":"id"},{"type":"text","text":" "},{"type":"text","text":"property that is stable across your app and your app’s database storage."},{"type":"text","text":" "},{"type":"text","text":"You could use the "},{"type":"codeVoice","code":"id"},{"type":"text","text":" property to identify a particular user even if other"},{"type":"text","text":" "},{"type":"text","text":"data fields change, such as the user’s name."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Identifiable"},{"type":"text","text":" leaves the duration and scope of the identity unspecified."},{"type":"text","text":" "},{"type":"text","text":"Identities can have any of the following characteristics:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Guaranteed always unique, like UUIDs."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Persistently unique per environment, like database record keys.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Unique for the lifetime of a process, like global incrementing integers.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unique for the lifetime of an object, like object identifiers."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unique within the current collection, like collection indices."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It’s up to both the conformer and the receiver of the protocol to document"},{"type":"text","text":" "},{"type":"text","text":"the nature of the identity."}]},{"level":1,"anchor":"Conforming-to-the-Identifiable-Protocol","text":"Conforming to the Identifiable Protocol","type":"heading"},{"inlineContent":[{"code":"Identifiable","type":"codeVoice"},{"text":" provides a default implementation for class types (using","type":"text"},{"text":" ","type":"text"},{"code":"ObjectIdentifier","type":"codeVoice"},{"text":"), which is only guaranteed to remain unique for the","type":"text"},{"text":" ","type":"text"},{"text":"lifetime of an object. If an object has a stronger notion of identity, it","type":"text"},{"text":" ","type":"text"},{"text":"may be appropriate to provide a custom implementation.","type":"text"}],"type":"paragraph"}]}],"topicSections":[{"anchor":"Specifying-the-Associated-Type","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable\/ID-swift.associatedtype"],"title":"Specifying the Associated Type"},{"anchor":"Specifying-the-Identified-Item","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable\/id-8t2ws"],"title":"Specifying the Identified Item"}],"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/Never":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Never","kind":"symbol","url":"\/documentation\/swift\/never","role":"symbol","