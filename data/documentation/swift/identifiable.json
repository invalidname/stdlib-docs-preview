{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Identifiable","kind":"identifier"},{"text":"<","kind":"text"},{"text":"ID","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable\/ID-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:s12IdentifiableP2IDQa"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"Identifiable"},{"text":" protocol to provide a stable notion of identity to a","type":"text"},{"text":" ","type":"text"},{"text":"class or value type. For example, you could define a ","type":"text"},{"type":"codeVoice","code":"User"},{"text":" type with an ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" ","type":"text"},{"text":"property that is stable across your app and your app’s database storage.","type":"text"},{"text":" ","type":"text"},{"text":"You could use the ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" property to identify a particular user even if other","type":"text"},{"text":" ","type":"text"},{"text":"data fields change, such as the user’s name.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Identifiable"},{"text":" leaves the duration and scope of the identity unspecified.","type":"text"},{"text":" ","type":"text"},{"text":"Identities can have any of the following characteristics:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Guaranteed always unique, like UUIDs.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Persistently unique per environment, like database record keys."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Unique for the lifetime of a process, like global incrementing integers."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Unique for the lifetime of an object, like object identifiers."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Unique within the current collection, like collection indices."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"It’s up to both the conformer and the receiver of the protocol to document"},{"type":"text","text":" "},{"text":"the nature of the identity.","type":"text"}],"type":"paragraph"},{"anchor":"Conforming-to-the-Identifiable-Protocol","type":"heading","level":1,"text":"Conforming to the Identifiable Protocol"},{"type":"paragraph","inlineContent":[{"code":"Identifiable","type":"codeVoice"},{"type":"text","text":" provides a default implementation for class types (using"},{"type":"text","text":" "},{"code":"ObjectIdentifier","type":"codeVoice"},{"type":"text","text":"), which is only guaranteed to remain unique for the"},{"type":"text","text":" "},{"type":"text","text":"lifetime of an object. If an object has a stronger notion of identity, it"},{"type":"text","text":" "},{"type":"text","text":"may be appropriate to provide a custom implementation."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Comparable"],"title":"Equality and Ordering","generated":true,"anchor":"Equality-and-Ordering"}],"abstract":[{"type":"text","text":"A class of types whose instances hold the value of an entity with stable"},{"type":"text","text":" "},{"type":"text","text":"identity."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Distributed\/DistributedActor"],"title":"Inherited By","type":