EnumeratedSequence"}],"title":"EnumeratedSequence","abstract":[{"type":"text","text":"An enumeration of the elements of a sequence or collection."}]},"doc://com.apple.Swift/documentation/Swift/IndexingIterator":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/IndexingIterator","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/swift\/indexingiterator","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IndexingIterator","kind":"identifier"}],"navigatorTitle":[{"text":"IndexingIterator","kind":"identifier"}],"title":"IndexingIterator","abstract":[{"type":"text","text":"A type that iterates over a collection using its indices."}]}}}