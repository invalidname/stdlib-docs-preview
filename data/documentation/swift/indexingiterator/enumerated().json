er":"doc:\/\/com.apple.Swift\/documentation\/Swift\/IndexingIterator","kind":"symbol","url":"\/documentation\/swift\/indexingiterator"},"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"navigatorTitle":[{"kind":"identifier","text":"EnumeratedSequence"}],"title":"EnumeratedSequence","type":"topic","abstract":[{"text":"An enumeration of the elements of a sequence or collection.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"EnumeratedSequence"}],"role":"symbol","url":"\/documentation\/swift\/enumeratedsequence","kind":"symbol"}}}