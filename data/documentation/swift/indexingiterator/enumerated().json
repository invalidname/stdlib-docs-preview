ifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/IndexingIterator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IndexingIterator"}],"role":"symbol","title":"IndexingIterator"},"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","type":"topic","title":"EnumeratedSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnumeratedSequence","kind":"identifier"}],"navigatorTitle":[{"text":"EnumeratedSequence","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"An enumeration of the elements of a sequence or collection."}],"role":"symbol","url":"\/documentation\/swift\/enumeratedsequence"}}}