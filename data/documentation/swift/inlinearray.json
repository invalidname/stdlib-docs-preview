},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type, and spell the type with the"},{"type":"text","text":" "},{"type":"text","text":"shorthand "},{"type":"codeVoice","code":"[count of Element]"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let a: InlineArray<3, Int> = [1, 2, 3]","let b: InlineArray<_, Int> = [1, 2, 3]","let c: InlineArray<3, _>   = [1, 2, 3]","let d: InlineArray         = [1, 2, 3]","","let e: [3 of Int]          = [1, 2, 3]","let f: [_ of Int]          = [1, 2, 3]","let g: [3 of _]            = [1, 2, 3]","let h: [_ of _]            = [1, 2, 3]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also use one of the type’s initializers to create a new value."}]},{"type":"heading","text":"Accessing Elements","anchor":"Accessing-Elements","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Just as with "},{"type":"codeVoice","code":"Array"},{"type":"text","text":", you can read and modify an element in an "},{"type":"codeVoice","code":"InlineArray"},{"type":"text","text":" "},{"type":"text","text":"using a subscript. Unless you use the memory-unsafe "},{"type":"codeVoice","code":"unchecked"},{"type":"text","text":" subscript,"},{"type":"text","text":" "},{"type":"text","text":"any index you provide is subject to bounds checking; an invalid index"},{"type":"text","text":" "},{"type":"text","text":"triggers a runtime error in your program."}]},{"type":"codeListing","syntax":"swift","code":["var values: [3 of Double] = [1, 1.5, 2]","print(values[0])  \/\/ Prints \"1.0\"","values[1] -= 0.25","print(values[1])  \/\/ Prints \"1.25\"","values[3] = 42.0  \/\/ Fatal error: Index out of bounds"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use the "},{"type":"codeVoice","code":"indices"},{"type":"text","text":" property to iterate over all elements in order."}]},{"type":"codeListing","syntax":"swift","code":["for index in