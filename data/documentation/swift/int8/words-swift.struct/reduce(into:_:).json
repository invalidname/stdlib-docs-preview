 of the sequence.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the sequence is exhausted, the accumulating value is returned to"},{"type":"text","text":" "},{"type":"text","text":"the caller."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the sequence has no elements, "},{"type":"codeVoice","code":"updateAccumulatingResult"},{"type":"text","text":" is never"},{"type":"text","text":" "},{"type":"text","text":"executed and "},{"type":"codeVoice","code":"initialResult"},{"type":"text","text":" is the result of the call to"},{"type":"text","text":" "},{"type":"codeVoice","code":"reduce(into:_:)"},{"type":"text","text":"."}]},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":"), where "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" is the length of the sequence."}],"type":"paragraph"}],"name":"Complexity"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Sequence/Element":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Element"}],"title":"Element","type":"topic","abstract":[{"type":"text","text":"A type representing the sequence’s elements."}],"kind":"symbol","required":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence\/Element","url":"\/documentation\/swift\/sequence\/element","role":"symbol"},"doc://com.apple.Swift/documentation/Swift/Int8/Words-swift.struct/reduce(into:_:)":{"title":"reduce(into:_:)","type":"topic","abstract":[{"type":"text","text":"Returns the result of combining the elements of the sequence using the"},{"text":" ","type":"text"},{"text":"given closure.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int8\/Words-swift.struct\/reduc