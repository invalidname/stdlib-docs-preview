":"codeListing","code":["let descendingStudents = students.sorted(by: >)","print(descendingStudents)","\/\/ Prints \"[\"Peter\", \"Kweku\", \"Kofi\", \"Akosua\", \"Abena\"]\""],"syntax":"swift"},{"inlineContent":[{"text":"The sorting algorithm is guaranteed to be stable. A stable sort","type":"text"},{"text":" ","type":"text"},{"text":"preserves the relative order of elements that compare as equal.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" log ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"), where "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":" is the length of the sequence."}],"type":"paragraph"}],"style":"note","name":"Complexity","type":"aside"}]}],"variants":[{"paths":["\/documentation\/swift\/int8\/words-swift.struct\/sorted()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"Returns the elements of the sequence, sorted.","type":"text"}],"references":{"doc://com.apple.Swift/documentation/Swift/Int8":{"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"Int8","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int8","abstract":[{"type":"text","text":"An 8-bit signed integer value"},{"type":"text","text":" "},{"text":"type.","type":"text"}],"title":"Int8","url":"\/documentation\/swift\/int8","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Int8","kind":"identifier"}],"role":"symbol"},"doc://com.apple.Swift/documentation/Swift/Int8/Words-swift.struct/sorted()":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int8\/Words-swift.struct\/sorted()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sorted","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Element","kind"