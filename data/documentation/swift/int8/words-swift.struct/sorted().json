","inlineContent":[{"text":"The sorting algorithm is guaranteed to be stable. A stable sort","type":"text"},{"text":" ","type":"text"},{"text":"preserves the relative order of elements that compare as equal.","type":"text"}]},{"name":"Complexity","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" is the length of the sequence."}],"type":"paragraph"}]}]}],"abstract":[{"type":"text","text":"Returns the elements of the sequence, sorted."}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Int8","doc:\/\/com.apple.Swift\/documentation\/Swift\/Int8\/Words-swift.struct"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/swift\/int8\/words-swift.struct\/sorted()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Int8/Words-swift.struct":{"navigatorTitle":[{"text":"Words","kind":"identifier"}],"type":"topic","title":"Int8.Words","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int8\/Words-swift.struct","abstract":[{"type":"text","text":"A type that represents the words of this integer."}],"url":"\/documentation\/swift\/int8\/words-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Words","kind":"identifier"}],"kind":"symbol","role":"symbol"},"Swift-PageImage-card.png":{"variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png"}],"alt":"An orange Swift logo on a gradient background.","type":"image","identifier":"Swift-PageImage-card.png"},"doc:/