" or "},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/Int8":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int8","role":"symbol","title":"Int8","navigatorTitle":[{"kind":"identifier","text":"Int8"}],"url":"\/documentation\/swift\/int8","abstract":[{"type":"text","text":"An 8-bit signed integer value"},{"type":"text","text":" "},{"type":"text","text":"type."}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Int8"}]}}}