-swift.struct\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/Dictionary\/Values-swift.struct\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/DropWhileSequence\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/EmptyCollection\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/FlattenSequence\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/IndexingIterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/IteratorSequence","doc:\/\/com.apple.Swift\/documentation\/Swift\/JoinedSequence\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyDropWhileSequence\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyFilterSequence\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyMapSequence\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyPrefixWhileSequence\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/PrefixSequence\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/Set\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/StrideThroughIterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/StrideToIterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF16View\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UnicodeScalarView\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnfoldSequence","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeBufferPointer\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawBufferPointer\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/Zip2Sequence\/Iterator"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IteratorProtocol","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:St7ElementQa","text":"Element","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/IteratorProtocol\/Element"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"IteratorProtocol"},{"type":"text","text":" protocol is tightly linked with the "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":" "},{"type":"text","text":"protocol. Sequences provide access to their elements by creating an"},{"type":"text","text":" "},{"type":"text","text":"iterator, which keeps track of its iteration process and returns one"},{"type":"text","text":" "},{"type":"text","text":"element at a time as it advances through the sequence."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Whenever you use a "},{"type":"codeVoice","code":"for"},{"type":"text","text":"-"},{"type":"codeVoice","code":"in"},{"type":"text","text":" loop with an array, set, or any other"},{"type":"text","text":" "},{"type":"text","text":"collection or sequence, you’re using that type’s iterator. Swift uses a"},{"type":"text","text":" "},{"type":"text","text":"sequence’s or collection’s iterator internally to enable the "},{"type":"codeVoice","code":"for"},{"type":"text","text":"-"},{"type":"codeVoice","code":"in"},{"type":"text","text":" "},{"type":"text","text":"loop language construct."}]},{"type":"paragraph","inlineContent":[{"text":"Using a sequence’s iterator directly gives you access to the same elements","type":"text"},{"text":" ","type":"text"},{"text":"in the same order as iterating over that sequence using a ","type":"text"},{"type":"codeVoice","code":"for"},{"text":"-","type":"text"},{"type":"codeVoice","code":"in"},{"text":" loop.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you might typically use a ","type":"text"},{"type":"codeVoice","code":"for"},{"text":"-","type":"text"},{"type":"codeVoice","code":"in"},{"text":" loop to print each of","type":"text"},{"text":" ","type":"text"},{"text":"the elements in an array.","type":"text"}]},{"type":"codeListing","code":["let animals = [\"Antelope\", \"Butterfly\", \"Camel\", \"Dolphin\"]","for animal in animals {","    print(animal)","}","\/\/ Prints \"Antelope\"","\/\/ Prints \"Butterfly\"","\/\/ Prints \"Camel\"","\/\/ Prints \"Dolphin\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Behind the scenes, Swift uses the "},{"code":"animals","type":"codeVoice"},{"type":"text","text":" array’s iterator to loop over"},{"type":"text","text":" "},{"type":"text","text":"the contents of the array."}]},{"syntax":"swift","type":"codeListing","code":["var animalIterator = animals.makeIterator()","while let animal = animalIterator.next() {","    print(animal)","}","\/\/ Prints \"Antelope\"","\/\/ Prints \"Butterfly\"","\/\/ Prints \"Camel\"","\/\/ Prints \"Dolphin\""]},{"inlineContent":[{"text":"The call to ","type":"text"},{"code":"animals.makeIterator()","type":"codeVoice"},{"text":" returns an instance of the array’s","type":"text"},{"text":" ","type":"text"},{"text":"iterator. Next, the ","type":"text"},{"code":"while","type":"codeVoice"},{"text":" loop calls the iterator’s ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"repeatedly, binding each element that is returned to "},{"code":"animal","type":"codeVoice"},{"text":" and exiting","type":"text"},{"type":"text","text":" "},{"type":"text","text":"when the "},{"type":"codeVoice","code":"next()"},{"text":" method returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Using Iterators Directly","anchor":"Using-Iterators-Directly","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"You rarely need to use iterators directly, because a "},{"type":"codeVoice","code":"for"},{"type":"text","text":"-"},{"type":"codeVoice","code":"in"},{"type":"text","text":" loop is the"},{"type":"text","text":" "},{"type":"text","text":"more idiomatic approach to traversing a sequence in Swift. Some"},{"type":"text","text":" "},{"text":"algorithms, however, may call for direct iterator use.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"One example is the ","type":"text"},{"code":"reduce1(_:)","type":"codeVoice"},{"text":" method. Similar to the ","type":"text"},{"code":"reduce(_:_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"method defined in the standard library, which takes an initial value and a","type":"text"},{"type":"text","text":" "},{"text":"combining closure, ","type":"text"},{"code":"reduce1(_:)","type":"codeVoice"},{"type":"text","text":" uses the first element of the sequence as"},{"text":" ","type":"text"},{"type":"text","text":"the initial value."}]},{"inlineContent":[{"text":"Here’s an implementation of the ","type":"text"},{"type":"codeVoice","code":"reduce1(_:)"},{"text":" method. The sequence’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"iterator is used directly to retrieve the initial value before looping"},{"text":" ","type":"text"},{"type":"text","text":"over the rest of the sequence."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension Sequence {","    func reduce1(","        _ nextPartialResult: (Element, Element) -> Element","    ) -> Element?","    {","        var i = makeIterator()","        guard var accumulated = i.next() else {","            return nil","        }","","        while let element = i.next() {","            accumulated = nextPartialResult(accumulated, element)","        }","        return accumulated","    }","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"reduce1(_:)","type":"codeVoice"},{"text":" method makes certain kinds of sequence operations","type":"text"},{"text":" ","type":"text"},{"text":"simpler. Here’s how to find the longest string in a sequence, using the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"animals"},{"text":" array introduced earlier as an example:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let longestAnimal = animals.reduce1 { current, element in","    if current.count > element.count {","        return current","    } else {","        return element","    }","}","print(longestAnimal)","\/\/ Prints Optional(\"Butterfly\")"]},{"anchor":"Using-Multiple-Iterators","level":1,"type":"heading","text":"Using Multiple Iterators"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Whenever you use multiple iterators (or "},{"type":"codeVoice","code":"for"},{"text":"-","type":"text"},{"type":"codeVoice","code":"in"},{"text":" loops) over a single","type":"text"},{"text":" ","type":"text"},{"text":"sequence, be sure you know that the specific sequence supports repeated","type":"text"},{"text":" ","type":"text"},{"text":"iteration, either because you know its concrete type or because the","type":"text"},{"text":" ","type":"text"},{"text":"sequence is also constrained to the ","type":"text"},{"type":"codeVoice","code":"Collection"},{"type":"text","text":" protocol."}]},{"type":"paragraph","inlineContent":[{"text":"Obtain each separate iterator from separate calls to the sequence’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"makeIterator()"},{"type":"text","text":" method rather than by copying. Copying an iterator is"},{"type":"text","text":" "},{"type":"text","text":"safe, but advancing one copy of an iterator by calling its "},{"type":"codeVoice","code":"next()"},{"text":" method","type":"text"},{"type":"text","text":" "},{"type":"text","text":"may invalidate other copies of that iterator. "},{"type":"codeVoice","code":"for"},{"type":"text","text":"-"},{"type":"codeVoice","code":"in"},{"text":" loops are safe in","type":"text"},{"text":" ","type":"text"},{"text":"this regard.","type":"text"}]},{"text":"Adding IteratorProtocol Conformance to Your Type","type":"heading","level":1,"anchor":"Adding-IteratorProtocol-Conformance-to-Your-Type"},{"inlineContent":[{"text":"Implementing an iterator that conforms to ","type":"text"},{"type":"codeVoice","code":"IteratorProtocol"},{"text":" is simple.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Declare a "},{"type":"codeVoice","code":"next()"},{"text":" method that advances one step in the related sequence","type":"text"},{"text":" ","type":"text"},{"text":"and returns the current element. When the sequence has been exhausted, the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"next()"},{"type":"text","text":" method returns "},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, consider a custom "},{"code":"Countdown","type":"codeVoice"},{"type":"text","text":" sequence. You can initialize the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Countdown"},{"type":"text","text":" sequence with a starting integer and then iterate over the"},{"type":"text","text":" "},{"type":"text","text":"count down to zero. The "},{"type":"codeVoice","code":"Countdown"},{"type":"text","text":" structure’s definition is short: It"},{"type":"text","text":" "},{"type":"text","text":"contains only the starting count and the "},{"type":"codeVoice","code":"makeIterator()"},{"type":"text","text":" method required"},{"type":"text","text":" "},{"type":"text","text":"by the "},{"type":"codeVoice","code":"Sequence"},{"text":" protocol.","type":"text"}]},{"type":"codeListing","code":["struct Countdown: Sequence {","    let start: Int","","    func makeIterator() -> CountdownIterator {","        return CountdownIterator(self)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"makeIterator()","type":"codeVoice"},{"text":" method returns another custom type, an iterator named","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"CountdownIterator"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"CountdownIterator"},{"text":" type keeps track of both the","type":"text"},{"text":" ","type":"text"},{"code":"Countdown","type":"codeVoice"},{"type":"text","text":" sequence that it’s iterating and the number of times it has"},{"type":"text","text":" "},{"type":"text","text":"returned a value."}]},{"type":"codeListing","code":["struct CountdownIterator: IteratorProtocol {","    let countdown: Countdown","    var times = 0","","    init(_ countdown: Countdown) {","        self.countdown = countdown","    }","","    mutating func next() -> Int? {","        let nextNumber = countdown.start - times","        guard nextNumber > 0","            else { return nil }","","        times += 1","        return nextNumber","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each time the ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" method is called on a ","type":"text"},{"type":"codeVoice","code":"CountdownIterator"},{"type":"text","text":" instance,"},{"type":"text","text":" "},{"type":"text","text":"it calculates the new next value, checks to see whether it has reached"},{"type":"text","text":" "},{"type":"text","text":"zero, and then returns either the number, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if the iterator is"},{"type":"text","text":" "},{"type":"text","text":"finished returning elements of the sequence."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Creating and iterating over a "},{"type":"codeVoice","code":"Countdown"},{"text":" sequence uses a","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"CountdownIterator"},{"type":"text","text":" to handle the iteration."}]},{"code":["let threeTwoOne = Countdown(start: 3)","for count in threeTwoOne {","    print(\"\\(count)...\")","}","\/\/ Prints \"3...\"","\/\/ Prints \"2...\"","\/\/ Prints \"1...\""],"syntax":"swift","type":"codeListing"}]}],"variants":[{"paths":["\/documentation\/swift\/iteratorprotocol"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/IteratorProtocol"},"references":{"doc://com.apple.Swift/documentation/Swift/FlattenSequence/Iterator":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Iterator","kind":"identifier"}],"title":"FlattenSequence.Iterator","conformance":{"constraints":[{"code":"Base","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Sequence","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Base.Element","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Sequence","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"abstract":[],"url":"\/documentation\/swift\/flattensequence\/iterator","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/FlattenSequence\/Iterator","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/StrideToIterator":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/StrideToIterator","abstract":[{"text":"An iterator for a ","type":"text"},{"code":"StrideTo","type":"codeVoice"},{"text":" instance.","type":"text"}],"role":"symbol","conformance":{"constraints":[{"type":"codeVoice","code":"Element"},{"type":"text","text":" confor