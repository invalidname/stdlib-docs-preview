eratedSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnumeratedSequence","kind":"identifier"}],"abstract":[{"type":"text","text":"An enumeration of the elements of a sequence or collection."}]},"doc://com.apple.Swift/documentation/Swift/JoinedSequence":{"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"JoinedSequence"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JoinedSequence"}],"abstract":[{"type":"text","text":"A sequence that presents the elements of a base sequence of sequences"},{"type":"text","text":" "},{"type":"text","text":"concatenated using a given separator."}],"type":"topic","title":"JoinedSequence","url":"\/documentation\/swift\/joinedsequence","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/JoinedSequence"}}}