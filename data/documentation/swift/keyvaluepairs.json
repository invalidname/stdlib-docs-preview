{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs","interfaceLanguage":"swift"},"metadata":{"title":"KeyValuePairs","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyValuePairs"}],"symbolKind":"struct","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"KeyValuePairs"}],"modules":[{"name":"Swift"}],"externalID":"s:s13KeyValuePairsV","platforms":[{"beta":false,"introducedAt":"8.0","deprecated":false,"name":"iOS","unavailable":false},{"beta":false,"introducedAt":"8.0","deprecated":false,"name":"iPadOS","unavailable":false},{"beta":false,"introducedAt":"13.0","deprecated":false,"name":"Mac Catalyst","unavailable":false},{"beta":false,"introducedAt":"10.10","deprecated":false,"name":"macOS","unavailable":false},{"beta":false,"introducedAt":"9.0","deprecated":false,"name":"tvOS","unavailable":false},{"beta":false,"introducedAt":"1.0","deprecated":false,"name":"visionOS","unavailable":false},{"beta":false,"introducedAt":"2.0","deprecated":false,"name":"watchOS","unavailable":false}]},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"A lightweight collection of key-value pairs.","type":"text"}],"seeAlsoSections":[{"title":"Special-Use Collections","generated":true,"anchor":"Special-Use-Collections","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/repeatElement(_:count:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/CollectionOfOne","doc:\/\/com.apple.Swift\/documentation\/Swift\/EmptyCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/DictionaryLiteral"]}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyValuePairs","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Key","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Use a ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" instance when you need an ordered collection of","type":"text"},{"text":" ","type":"text"},{"text":"key-value pairs and don’t require the fast key lookup that the","type":"text"},{"text":" ","type":"text"},{"code":"Dictionary","type":"codeVoice"},{"text":" type provides. Unlike key-value pairs in a true dictionary,","type":"text"},{"text":" ","type":"text"},{"text":"neither the key nor the value of a ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" instance must","type":"text"},{"text":" ","type":"text"},{"text":"conform to the ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" protocol.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You initialize a ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" instance using a Swift dictionary","type":"text"},{"text":" ","type":"text"},{"text":"literal. Besides maintaining the order of the original dictionary literal,","type":"text"},{"text":" ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" also allows duplicates keys. For example:","type":"text"}]},{"type":"codeListing","code":["let recordTimes: KeyValuePairs = [\"Florence Griffith-Joyner\": 10.49,","                                      \"Evelyn Ashford\": 10.76,","                                      \"Evelyn Ashford\": 10.79,","                                      \"Marlies Gohr\": 10.81]","print(recordTimes.first!)","\/\/ Prints \"(key: \"Florence Griffith-Joyner\", value: 10.49)\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Some operations that are efficient on a dictionary are slower when using","type":"text"},{"text":" ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":". In particular, to find the value matching a key, you","type":"text"},{"text":" ","type":"text"},{"text":"must search through every element of the collection. The call to","type":"text"},{"text":" ","type":"text"},{"code":"firstIndex(where:)","type":"codeVoice"},{"text":" in the following example must traverse the whole","type":"text"},{"text":" ","type":"text"},{"text":"collection to find the element that matches the predicate:","type":"text"}]},{"type":"codeListing","code":["let runner = \"Marlies Gohr\"","if let index = recordTimes.firstIndex(where: { $0.0 == runner }) {","    let time = recordTimes[index].1","    print(\"\\(runner) set a 100m record of \\(time) seconds.\")","} else {","    print(\"\\(runner) couldn't be found in the records.\")","}","\/\/ Prints \"Marlies Gohr set a 100m record of 10.81 seconds.\""],"syntax":"swift"},{"text":"Key-Value Pairs as a Function Parameter","type":"heading","anchor":"Key-Value-Pairs-as-a-Function-Parameter","level":2},{"type":"paragraph","inlineContent":[{"text":"When calling a function with a ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" parameter, you can pass","type":"text"},{"text":" ","type":"text"},{"text":"a Swift dictionary literal without causing a ","type":"text"},{"code":"Dictionary","type":"codeVoice"},{"text":" to be created.","type":"text"},{"text":" ","type":"text"},{"text":"This capability can be especially important when the order of elements in","type":"text"},{"text":" ","type":"text"},{"text":"the literal is significant.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, you could create an ","type":"text"},{"code":"IntPairs","type":"codeVoice"},{"text":" structure that holds a list of","type":"text"},{"text":" ","type":"text"},{"text":"two-integer tuples and use an initializer that accepts a","type":"text"},{"text":" ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" instance.","type":"text"}]},{"type":"codeListing","code":["struct IntPairs {","    var elements: [(Int, Int)]","","    init(_ elements: KeyValuePairs<Int, Int>) {","        self.elements = Array(elements)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"When you’re ready to create a new ","type":"text"},{"code":"IntPairs","type":"codeVoice"},{"text":" instance, use a dictionary","type":"text"},{"text":" ","type":"text"},{"text":"literal as the parameter to the ","type":"text"},{"code":"IntPairs","type":"codeVoice"},{"text":" initializer. The","type":"text"},{"text":" ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" instance preserves the order of the elements as","type":"text"},{"text":" ","type":"text"},{"text":"passed.","type":"text"}]},{"type":"codeListing","code":["let pairs = IntPairs([1: 2, 1: 1, 3: 4, 2: 1])","print(pairs.elements)","\/\/ Prints \"[(1, 2), (1, 1), (3, 4), (2, 1)]\""],"syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/keyvaluepairs"]}],"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/init(dictionaryLiteral:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/span"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/BidirectionalCollection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/Collection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/CustomDebugStringConvertible-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/CustomStri