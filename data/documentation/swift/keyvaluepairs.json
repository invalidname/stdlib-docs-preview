{"abstract":[{"type":"text","text":"A lightweight collection of key-value pairs."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"kind":"symbol","metadata":{"externalID":"s:s13KeyValuePairsV","title":"KeyValuePairs","symbolKind":"struct","platforms":[{"unavailable":false,"introducedAt":"8.0","beta":false,"deprecated":false,"name":"iOS"},{"unavailable":false,"introducedAt":"8.0","beta":false,"deprecated":false,"name":"iPadOS"},{"unavailable":false,"introducedAt":"13.0","beta":false,"deprecated":false,"name":"Mac Catalyst"},{"unavailable":false,"introducedAt":"10.10","beta":false,"deprecated":false,"name":"macOS"},{"unavailable":false,"introducedAt":"9.0","beta":false,"deprecated":false,"name":"tvOS"},{"unavailable":false,"introducedAt":"1.0","beta":false,"deprecated":false,"name":"visionOS"},{"unavailable":false,"introducedAt":"2.0","beta":false,"deprecated":false,"name":"watchOS"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyValuePairs","kind":"identifier"}],"roleHeading":"Structure","navigatorTitle":[{"text":"KeyValuePairs","kind":"identifier"}],"role":"symbol","modules":[{"name":"Swift"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Escapable","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral","doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomAccessCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"],"type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyValuePairs","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Key","kind":"genericParameter"},{"text":", ","kind":"text"},{"kind":"genericParameter","text":"Value"},{"text":">","kind":"text"}]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" instance when you need an ordered collection of"},{"type":"text","text":" "},{"type":"text","text":"key-value pairs and don’t require the fast key lookup that the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":" type provides. Unlike key-value pairs in a true dictionary,"},{"type":"text","text":" "},{"type":"text","text":"neither the key nor the value of a "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" instance must"},{"text":" ","type":"text"},{"type":"text","text":"conform to the "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" protocol."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You initialize a "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" instance using a Swift dictionary"},{"type":"text","text":" "},{"type":"text","text":"literal. Besides maintaining the order of the original dictionary literal,"},{"type":"text","text":" "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" also allows duplicates keys. For example:"}]},{"code":["let recordTimes: KeyValuePairs = [\"Florence Griffith-Joyner\": 10.49,","                                      \"Evelyn Ashford\": 10.76,","                                      \"Evelyn Ashford\": 10.79,","                                      \"Marlies Gohr\": 10.81]","print(recordTimes.first!)","\/\/ Prints \"(key: \"Florence Griffith-Joyner\", value: 10.49)\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some operations that are efficient on a dictionary are slower when using"},{"type":"text","text":" "},{"code":"KeyValuePairs","type":"codeVoice"},{"type":"text","text":". In particular, to find the value matching a key, you"},{"type":"text","text":" "},{"type":"text","text":"must search through every element of the collection. The call to"},{"type":"text","text":" "},{"code":"firstIndex(where:)","type":"codeVoice"},{"type":"text","text":" in the following example must traverse the whole"},{"type":"text","text":" "},{"type":"text","text":"collection to find the element that matches the predicate:"}]},{"code":["let runner = \"Marlies Gohr\"","if let index = recordTimes.firstIndex(where: { $0.0 == runner }) {","    let time = recordTimes[index].1","    print(\"\\(runner) set a 100m record of \\(time) seconds.\")","} else {","    print(\"\\(runner) couldn't be found in the records.\")","}","\/\/ Prints \"Marlies Gohr set a 100m record of 10.81 seconds.\""],"type":"codeListing","syntax":"swift"},{"text":"Key-Value Pairs as a Function Parameter","level":2,"anchor":"Key-Value-Pairs-as-a-Function-Parameter","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When calling a function with a "},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" parameter, you can pass","type":"text"},{"text":" ","type":"text"},{"text":"a Swift dictionary literal without causing a ","type":"text"},{"code":"Dictionary","type":"codeVoice"},{"text":" to be created.","type":"text"},{"text":" ","type":"text"},{"text":"This capability can be especially important when the order of elements in","type":"text"},{"text":" ","type":"text"},{"text":"the literal is significant.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, you could create an ","type":"text"},{"code":"IntPairs","type":"codeVoice"},{"text":" structure that holds a list of","type":"text"},{"text":" ","type":"text"},{"text":"two-integer tuples and use an initializer that accepts a","type":"text"},{"text":" ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" instance.","type":"text"}]},{"syntax":"swift","code":["struct IntPairs {","    var elements: [(Int, Int)]","","    init(_ elements: KeyValuePairs<Int, Int>) {","        self.elements = Array(elements)","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"When you’re ready to create a new ","type":"text"},{"code":"IntPairs","type":"codeVoice"},{"text":" instance, use a dictionary","type":"text"},{"text":" ","type":"text"},{"text":"literal as the parameter to the ","type":"text"},{"code":"IntPairs","type":"codeVoice"},{"text":" initializer. The","type":"text"},{"text":" ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" instance preserves the order of the elements as","type":"text"},{"text":" ","type":"text"},{"text":"passed.","type":"text"}]},{"syntax":"swift","code":["let pairs = IntPairs([1: 2, 1: 1, 3: 4, 2: 1])","print(pairs.elements)","\/\/ Prints \"[(1, 2), (1, 1), (3, 4), (2, 1)]\""],"type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/keyvaluepairs"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/repeatElement(_:count:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/CollectionOfOne","doc:\/\/com.apple.Swift\/documentation\/Swift\/EmptyCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/DictionaryLiteral"],"generated":true,"anchor":"Special-Use-Collections","title":