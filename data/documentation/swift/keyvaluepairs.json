xt"},{"text":"Value","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" instance when you need an ordered collection of"},{"type":"text","text":" "},{"type":"text","text":"key-value pairs and don’t require the fast key lookup that the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":" type provides. Unlike key-value pairs in a true dictionary,"},{"type":"text","text":" "},{"type":"text","text":"neither the key nor the value of a "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" instance must"},{"type":"text","text":" "},{"type":"text","text":"conform to the "},{"code":"Hashable","type":"codeVoice"},{"text":" protocol.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You initialize a "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" instance using a Swift dictionary"},{"type":"text","text":" "},{"type":"text","text":"literal. Besides maintaining the order of the original dictionary literal,"},{"text":" ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"type":"text","text":" also allows duplicates keys. For example:"}]},{"syntax":"swift","type":"codeListing","code":["let recordTimes: KeyValuePairs = [\"Florence Griffith-Joyner\": 10.49,","                                      \"Evelyn Ashford\": 10.76,","                                      \"Evelyn Ashford\": 10.79,","                                      \"Marlies Gohr\": 10.81]","print(recordTimes.first!)","\/\/ Prints \"(key: \"Florence Griffith-Joyner\", value: 10.49)\""]},{"inlineContent":[{"type":"text","text":"Some operations that are efficient on a dictionary are slower when using"},{"type":"text","text":" "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":". In particular, to find the value matching a key, you"},{"type":"text","text":" "},{"type":"text","text":"must search through every element of the collection. The call to"},{"type":"text","text":" "},{"type":"codeVoice","code":"firstIndex(where:)"},{"type":"text","text":" in the following example must traverse the whole"},{"type":"text","text":" "},{"type":"text","text":"collection to find the element that matches the predicate:"}],"type":"paragraph"},{"code":["let runner = \"Marlies Gohr\"","if let index = recordTimes.firstIndex(where: { $0.0 == runner }) {","    let time = recordTimes[index].1","    print(\"\\(runner) set a 100m record of \\(time) seconds.\")","} else {","    print(\"\\(runner) couldn't be found in the records.\")","}","\/\/ Prints \"Marlies Gohr set a 100m record of 10.81 seconds.\""],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Key-Value Pairs as a Function Parameter","type":"heading","anchor":"Key-Value-Pairs-as-a-Function-Parameter"},{"inlineContent":[{"type":"text","text":"When calling a function with a "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" parameter, you can pass"},{"type":"text","text":" "},{"type":"text","text":"a Swift dictionary literal without causing a "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":" to be created."},{"type":"text","text":" "},{"type":"text","text":"This capability can be especially important when the order of elements in"},{"type":"text","text":" "},{"type":"text","text":"the literal is significant."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, you could create an "},{"type":"codeVoice","code":"IntPairs"},{"type":"text","text":" structure that holds a list of"},{"type":"text","text":" "},{"type":"text","text":"two-integer tuples and use an initializer that accepts a"},{"type":"text","text":" "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" instance."}],"type":"paragraph"},{"code":["struct IntPairs {","    var elements: [(Int, Int)]","","    init(_ elements: KeyValuePairs<Int, Int>) {","        self.elements = Array(elements)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"When you’re ready to create a new "},{"type":"codeVoice","code":"IntPairs"},{"type":"text","text":" instance, use a dictionary"},{"type":"text","text":" "},{"type":"text","text":"literal as the parameter to the "},{"type":"codeVoice","code":"IntPairs"},{"type":"text","text":" initializer. The"},{"type":"text","text":" "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" instance preserves the order of the elements as"},{"type":"text","text":" "},{"type":"text","text":"passed."}],"type":"paragraph"},{"code":["let pairs = IntPairs([1: 2, 1: 1, 3: 4, 2: 1])","print(pairs.elements)","\/\/ Prints \"[(1, 2), (1, 1), (3, 4), (2, 1)]\""],"syntax":"swift","type":"codeListing"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/init(dictionaryLiteral:)"],"anchor":"Initializers"},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/span"],"generated":true},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/BidirectionalCollection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/Collection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/CustomDebugStringConvertible-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/CustomStringConvertible-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/RandomAccessCollection-Implementations","doc:\/\/co