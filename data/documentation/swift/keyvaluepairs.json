{"seeAlsoSections":[{"title":"Special-Use Collections","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/repeatElement(_:count:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/CollectionOfOne","doc:\/\/com.apple.Swift\/documentation\/Swift\/EmptyCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/DictionaryLiteral"],"generated":true,"anchor":"Special-Use-Collections"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"A lightweight collection of key-value pairs.","type":"text"}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral","doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomAccessCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyValuePairs"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Key"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"Use a ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" instance when you need an ordered collection of","type":"text"},{"text":" ","type":"text"},{"text":"key-value pairs and don’t require the fast key lookup that the","type":"text"},{"text":" ","type":"text"},{"code":"Dictionary","type":"codeVoice"},{"text":" type provides. Unlike key-value pairs in a true dictionary,","type":"text"},{"text":" ","type":"text"},{"text":"neither the key nor the value of a ","type":"text"},{"type":"codeVoice","code":"KeyValuePairs"},{"text":" instance must","type":"text"},{"text":" ","type":"text"},{"text":"conform to the ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" protocol.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You initialize a ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" instance using a Swift dictionary","type":"text"},{"text":" ","type":"text"},{"text":"literal. Besides maintaining the order of the original dictionary literal,","type":"text"},{"text":" ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" also allows duplicates keys. For example:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let recordTimes: KeyValuePairs = [\"Florence Griffith-Joyner\": 10.49,","                                      \"Evelyn Ashford\": 10.76,","                                      \"Evelyn Ashford\": 10.79,","                                      \"Marlies Gohr\": 10.81]","print(recordTimes.first!)","\/\/ Prints \"(key: \"Florence Griffith-Joyner\", value: 10.49)\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Some operations that are efficient on a dictionary are slower when using","type":"text"},{"text":" ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":". In particular, to find the value matching a key, you","type":"text"},{"type":"text","text":" "},{"type":"text","text":"must search through every element of the collection. The call to"},{"type":"text","text":" "},{"code":"firstIndex(where:)","type":"codeVoice"},{"type":"text","text":" in the following example must traverse the whole"},{"type":"text","text":" "},{"type":"text","text":"collection to find the element that matches the predicate:"}]},{"code":["let runner = \"Marlies Gohr\"","if let index = recordTimes.firstIndex(where: { $0.0 == runner }) {","    let time = recordTimes[index].1","    print(\"\\(runner) set a 100m record of \\(time) seconds.\")","} else {","    print(\"\\(runner) couldn't be found in the records.\")","}","\/\/ Prints \"Marlies Gohr set a 100m record of 10.81 seconds.\""],"type":"codeListing","syntax":"swift"},{"text":"Key-Value Pairs as a Function Parameter","anchor":"Key-Value-Pairs-as-a-Function-Parameter","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When calling a function with a "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" parameter, you can pass"},{"type":"text","text":" "},{"type":"text","text":"a Swift dictionary literal without causing a "},{"code":"Dictionary","type":"codeVoice"},{"text":" to be created.","type":"text"},{"text":" ","type":"text"},{"text":"This capability can be especially important when the order of elements in","type":"text"},{"text":" ","type":"text"},{"text":"the literal is significant.","type":"text"}]},{"inlineContent":[{"type":"text","text":"For example, you could create an "},{"type":"codeVoice","code":"IntPairs"},{"type":"text","text":" structure that holds a list of"},{"type":"text","text":" "},{"type":"text","text":"two-integer tuples and use an initializer that accepts a"},{"type":"text","text":" "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" instance."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct IntPairs {","    var elements: [(Int, Int)]","","    init(_ elements: KeyValuePairs<Int, Int>) {","        self.elements = Array(elements)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you’re ready to create a new "},{"type":"codeVoice","code":"IntPairs"},{"text":" instance, use a dictionary","type":"text"},{"text":" ","type":"text"},{"text":"literal as the parameter to the ","type":"text"},{"code":"IntPairs","type":"codeVoice"},{"type":"text","text":" initializer. The"},{"type":"text","text":" "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" instance preserves the order of the elements as"},{"type":"text","text":" "},{"type":"text","text":"passed."}]},{"type":"codeListing","code":["let pairs = IntPairs([1: 2, 1: 1, 3: 4, 2: 1])","print(pairs.elements)","\/\/ Prints \"[(1, 2), (1, 1), (3, 4), (2, 1)]\""],"syntax":"swift"}],"kind":"content"}],"metadata":{"symbolKind":"struct","title":"KeyValuePairs","navigatorTitle":[{"text":"KeyValuePairs","kind":"identifier"}],"platforms":[{"deprecated":false,"introducedAt":"8.0","beta":false,"name":"iOS","unavailable":false},{"deprecated":false,"introducedAt":"8.0","beta":false,"name":"iPadOS","unavailable":false},{"deprecated":false,"introducedAt":"13.0","beta":false,"name":"Mac Catalyst","unavailable":false},{"deprecated":false,"introducedAt":"10.10","beta":false,"name":"macOS","unavailable":false},{"name":"tvOS","introducedAt":"9.0","unavailable":false,"beta":false,"deprecated":false},{"name":"visionOS","introducedAt":"1.0","unavailable":false,"beta":false,"deprecated":false},{"name":"watchOS","introducedAt":"2.0","unavailable":false,"beta":false,"deprecated":false}],"externalID":"s:s13KeyValuePairsV","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyValuePairs"}],"modules":[{"name":"Standard Library"}],"roleHeading":"Structure"},"kind":"symbol","topicSections":[{"title":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/init(dictionaryLiteral:)"],"generated":true,"anchor":"Initializer