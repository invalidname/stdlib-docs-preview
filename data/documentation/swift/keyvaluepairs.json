ction-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/CustomDebugStringConvertible-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/CustomStringConvertible-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/RandomAccessCollection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/Sequence-Implementations"]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByDictionaryLiteral","doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomAccessCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"]}],"seeAlsoSections":[{"title":"Special-Use Collections","generated":true,"anchor":"Special-Use-Collections","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/repeatElement(_:count:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/CollectionOfOne","doc:\/\/com.apple.Swift\/documentation\/Swift\/EmptyCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/DictionaryLiteral"]}],"kind":"symbol","abstract":[{"type":"text","text":"A lightweight collection of key-value pairs."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyValuePairs"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Key"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" instance when you need an ordered collection of"},{"type":"text","text":" "},{"type":"text","text":"key-value pairs and don’t require the fast key lookup that the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":" type provides. Unlike key-value pairs in a true dictionary,"},{"type":"text","text":" "},{"type":"text","text":"neither the key nor the value of a "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" instance must"},{"type":"text","text":" "},{"type":"text","text":"conform to the "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" protocol."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You initialize a "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" instance using a Swift dictionary"},{"type":"text","text":" "},{"type":"text","text":"literal. Besides maintaining the order of the original dictionary literal,"},{"type":"text","text":" "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" also allows duplicates keys. For example:"}],"type":"paragraph"},{"type":"codeListing","code":["let recordTimes: KeyValuePairs = [\"Florence Griffith-Joyner\": 10.49,","                                      \"Evelyn Ashford\": 10.76,","                                      \"Evelyn Ashford\": 10.79,","                                      \"Marlies Gohr\": 10.81]","print(recordTimes.first!)","\/\/ Prints \"(key: \"Florence Griffith-Joyner\", value: 10.49)\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Some operations that are efficient on a dictionary are slower when using"},{"type":"text","text":" "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":". In particular, to find the value matching a key, you"},{"type":"text","text":" "},{"type":"text","text":"must search through every element of the collection. The call to"},{"type":"text","text":" "},{"type":"codeVoice","code":"firstIndex(where:)"},{"text":" in the following example must traverse the whole","type":"text"},{"text":" ","type":"text"},{"text":"collection to find the element that matches the predicate:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let runner = \"Marlies Gohr\"","if let index = recordTimes.firstIndex(where: { $0.0 == runner }) {","    let time = recordTimes[index].1","    print(\"\\(runner) set a 100m record of \\(time) seconds.\")","} else {","    print(\"\\(runner) couldn't be found in the records.\")","}","\/\/ Prints \"Marlies Gohr set a 100m record of 10.81 seconds.\""],"type":"codeListing"},{"text":"Key-Value Pairs as a Function Parameter","type":"heading","anchor":"Key-Value-Pairs-as-a-Function-Parameter","level":2},{"inlineContent":[{"text":"When calling a function with a ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" parameter, you can pass","type":"text"},{"text":" ","type":"text"},{"text":"a Swift dictionary literal without causing a ","type":"text"},{"code":"Dictionary","type":"codeVoice"},{"text":" to be created.","type":"text"},{"text":" ","type":"text"},{"text":"This capability can be especially important when the order of elements in","type":"text"},{"text":" ","type":"text"},{"text":"the literal is significant.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, you could create an ","type":"text"},{"code":"IntPairs","type":"codeVoice"},{"text":" structure that holds a list of","type":"text"},{"text":" ","type":"text"},{"text":"two-integer tuples and use an initializer that accepts a","type":"text"},{"text":" ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" instance.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct IntPairs {","    var elements: [(Int, Int)]","","    init(_ elements: KeyValuePairs<Int, Int>) {","        self.elements = Array(elements)","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"When you’re ready to create a new ","type":"text"},{"code":"IntPairs","type":"codeVoice"},{"text":" instance, use a dictionary","type":"text"},{"text":" ","type":"text"},{"text":"literal as the parameter to the ","type":"text"},{"code":"IntPairs","type":"codeVoice"},{"type":"text","text":" initializer. The"},{"type":"text","text":" "},{"type":"codeVoice","code":"KeyValuePairs"},{"type":"text","text":" instance preserves the order of the elements as"},{"type":"text","text":" "},{"type":"text","text":"passed."}]},{"type":"codeListing","code":["let pairs = IntPairs([1: 2, 1: 1, 3: 4, 2: 1])","print(pairs.elements)","\/\/ Prints \"[(1, 2), (1, 1), (3, 4), (2, 1)]\""],"syntax":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/KeyValuePairs/init(dictionaryLiteral:)":{"abstract":[{"text":"Creates a new ","type":"text"},{"code":"KeyValuePairs","type":"codeVoice"},{"text":" instance from the given dictionary","type":"text"},{"text":" ","type":"text"},{"text":"literal.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/KeyValuePairs\/init(dictionaryLiteral:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"dictionaryLiteral","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Key","preciseIdentifier":"s:s13KeyValuePairsV0A0xmfp","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Value","preciseIdentifier":"s:s13KeyValuePairsV0B0q_mfp","kind":"typeIdentifier"},{"text":")...)","kind":"text"}],"title":"init(dictionaryLiteral:)","url":"\/documentation\/swift\/keyvaluepairs\/init(dictionaryliteral:)","kind":"symbol","role":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/Swift/KeyValu