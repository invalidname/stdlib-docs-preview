pe":"text","text":"the sequence."}],"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enumerated","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:s18EnumeratedSequenceV","text":"EnumeratedSequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"kind":"text","text":">"}]},"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"navigatorTitle":[{"kind":"identifier","text":"EnumeratedSequence"}],"url":"\/documentation\/swift\/enumeratedsequence","abstract":[{"text":"An enumeration of the elements of a sequence or collection.","type":"text"}],"kind":"symbol","title":"EnumeratedSequence","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EnumeratedSequence"}]},"Swift-PageImage-card.png":{"identifier":"Swift-PageImage-card.png","variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png","traits":["2x","dark"]}],"type":"image","alt":"An orange Swift logo on a gradient background."}}}