":">"},{"type":"text","text":") to the "},{"type":"codeVoice","code":"sorted(by:)"},{"text":" method.","type":"text"}]},{"code":["let descendingStudents = students.sorted(by: >)","print(descendingStudents)","\/\/ Prints \"[\"Peter\", \"Kweku\", \"Kofi\", \"Akosua\", \"Abena\"]\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The sorting algorithm is guaranteed to be stable. A stable sort","type":"text"},{"text":" ","type":"text"},{"text":"preserves the relative order of elements that compare as equal.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" is the length of the sequence."}],"type":"paragraph"}],"name":"Complexity","type":"aside","style":"note"}],"kind":"content"}],"abstract":[{"type":"text","text":"Returns the elements of the sequence, sorted."}],"metadata":{"role":"symbol","platforms":[{"introducedAt":"8.0","unavailable":false,"beta":false,"name":"iOS","deprecated":false},{"introducedAt":"8.0","unavailable":false,"beta":false,"name":"iPadOS","deprecated":false},{"deprecated":false,"name":"Mac Catalyst","introducedAt":"13.0","unavailable":false,"beta":false},{"deprecated":false,"name":"macOS","introducedAt":"10.10","unavailable":false,"beta":false},{"unavailable":false,"name":"tvOS","beta":false,"introducedAt":"9.0","deprecated":false},{"introducedAt":"1.0","unavailable":false,"beta":false,"name":"visionOS","deprecated":false},{"deprecated":false,"name":"watchOS","introducedAt":"2.0","unavailable":false,"beta":false}],"conformance":{"constraints":[{"type":"codeVoice","code":"Element"},{"text":" conforms to ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[