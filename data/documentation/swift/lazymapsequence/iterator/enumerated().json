{"text":" whose elements consist of those in a ","type":"text"},{"code":"Base","type":"codeVoice"},{"type":"text","text":" "},{"code":"Sequence","type":"codeVoice"},{"text":" passed through a transform function returning ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"These elements are computed lazily, each time they’re read, by","type":"text"},{"text":" ","type":"text"},{"text":"calling the transform function on a base element.","type":"text"}],"url":"\/documentation\/swift\/lazymapsequence","title":"LazyMapSequence","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyMapSequence","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"LazyMapSequence","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/LazyMapSequence/Iterator":{"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"abstract":[],"title":"LazyMapSequence.Iterator","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}],"navigatorTitle":[{"text":"Iterator","kind":"identifier"}],"url":"\/documentation\/swift\/lazymapsequence\/iterator","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyMapSequence\/Iterator"},"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"navigatorTitle":[{"kind":"identifier","text":"EnumeratedSequence"}],"url":"\/documentation\/swift\/enumeratedsequence","abstract":[{"text":"An enumeration of the elements of a sequence or collection.","type":"text"}],"kind":"symbol","title":"EnumeratedSequence","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/docume