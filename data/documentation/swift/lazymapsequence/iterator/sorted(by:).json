"kind":"identifier"}],"title":"Bool","abstract":[{"text":"A value type whose instances are either ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/LazyMapSequence":{"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"LazyMapSequence"}],"abstract":[{"text":"A ","type":"text"},{"code":"Sequence","type":"codeVoice"},{"text":" whose elements consist of those in a ","type":"text"},{"type":"codeVoice","code":"Base"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sequence"},{"text":" passed through a transform function returning ","type":"text"},{"type":"codeVoice","code":"Element"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"These elements are computed lazily, each time they’re read, by","type":"text"},{"type":"text","text":" "},{"text":"calling the transform function on a base element.","type":"text"}],"type":"topic","title":"LazyMapSequence","role":"symbol","kind":"symbol","url":"\/documentation\/swift\/lazymapsequence","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyMapSequence","navigatorTitle":[{"text":"LazyMapSequence","kind":"identifier"}]}}}