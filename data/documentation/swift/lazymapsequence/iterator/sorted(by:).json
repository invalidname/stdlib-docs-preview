r":"doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyMapSequence\/Iterator","role":"symbol","abstract":[],"type":"topic","title":"LazyMapSequence.Iterator","navigatorTitle":[{"kind":"identifier","text":"Iterator"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sequence"},{"text":".","type":"text"}]},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/LazyMapSequence":{"title":"LazyMapSequence","url":"\/documentation\/swift\/lazymapsequence","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyMapSequence","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":" whose elements consist of those in a "},{"type":"codeVoice","code":"Base"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":" passed through a transform function returning "},{"type":"codeVoice","code":"Element"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"These elements are computed lazily, each time they’re read, by"},{"type":"text","text":" "},{"type":"text","text":"calling the transform function on a base element."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LazyMapSequence","kind":"identifier"}],"navigatorTitle":[{"text":"LazyMapSequence","kind":"identifier"}],"type":"topic"}}}