d"},{"text":" ","kind":"text"},{"text":"Bool","kind":"identifier"}],"navigatorTitle":[{"text":"Bool","kind":"identifier"}],"url":"\/documentation\/swift\/bool","abstract":[{"type":"text","text":"A value type whose instances are either "},{"type":"codeVoice","code":"true"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","role":"symbol","type":"topic","kind":"symbol"}}}