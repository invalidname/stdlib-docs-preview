xWhileSequence","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"LazyPrefixWhileSequence"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyPrefixWhileSequence","url":"\/documentation\/swift\/lazyprefixwhilesequence","abstract":[{"text":"A sequence whose elements consist of the initial consecutive elements of","type":"text"},{"text":" ","type":"text"},{"text":"some base sequence that satisfy a given predicate.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"LazyPrefixWhileSequence","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift":{"role":"collection","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","type":"topic","kind":"symbol"}}}