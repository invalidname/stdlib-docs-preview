":">"},{"type":"text","text":") to the "},{"type":"codeVoice","code":"sorted(by:)"},{"text":" method.","type":"text"}]},{"syntax":"swift","code":["let descendingStudents = students.sorted(by: >)","print(descendingStudents)","\/\/ Prints \"[\"Peter\", \"Kweku\", \"Kofi\", \"Akosua\", \"Abena\"]\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sorting algorithm is guaranteed to be stable. A stable sort"},{"type":"text","text":" "},{"type":"text","text":"preserves the relative order of elements that compare as equal."}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" is the length of the sequence."}],"type":"paragraph"}]}],"kind":"content"}],"abstract":[{"text":"Returns the elements of the sequence, sorted.","type":"text"}],"metadata":{"platforms":[{"unavailable":false,"beta":false,"introducedAt":"8.0","name":"iOS","deprecated":false},{"unavailable":false,"beta":false,"introducedAt":"8.0","name":"iPadOS","deprecated":false},{"unavailable":false,"beta":false,"introducedAt":"13.0","name":"Mac Catalyst","deprecated":false},{"unavailable":false,"beta":false,"introducedAt":"10.10","name":"macOS","deprecated":false},{"unavailable":false,"beta":false,"introducedAt":"9.0","name":"tvOS","deprecated":false},{"unavailable":false,"beta":false,"introducedAt":"1.0","name":"visionOS","deprecated":false},{"unavailable":false,"beta":false,"introducedAt":"2.0","name":"watchOS","deprecated":false}],"externalID":"s:STsSL7ElementRpzrlE6sortedSayABGyF::SYNTHESIZED::s:s23LazyPrefixWhileSequenceV8IteratorV","symbolKind":"method","title":"sorted()","roleHeading":"Instance Method","modules":[{"name":"Swift"}],"exte