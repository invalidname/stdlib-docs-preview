"code":"true"},{"type":"text","text":" or "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"Bool"}],"url":"\/documentation\/swift\/bool","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Bool","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/LazyPrefixWhileSequence/Iterator/sorted(by:)":{"type":"topic","role":"symbol","kind":"symbol","abstract":[{"text":"Returns the elements of the sequence, sorted using the given predicate as","type":"text"},{"text":" ","type":"text"},{"text":"the comparison between elements.","type":"text"}],"url":"\/documentation\/swift\/lazyprefixwhilesequence\/iterator\/sorted(by:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sorted"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyPrefixWhileSequence\/Iterator\/sorted(by:)","title":"sorted(by:)"},"doc://com.apple.Swift/documentation/Swift/LazyPrefixWhileSequence":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyPrefixWhileSequence","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LazyPrefixWhileSequence","kind":"identifier"}],"title":"LazyPrefixWhileSequence","navigatorTitle":[{"text":"LazyPref