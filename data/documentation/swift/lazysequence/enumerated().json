re"},{"type":"text","text":" "},{"type":"text","text":"implemented lazily."}],"kind":"symbol","title":"LazySequence","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"LazySequence","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequence","navigatorTitle":[{"text":"LazySequence","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swift\/lazysequence"},"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"abstract":[{"text":"An enumeration of the elements of a sequence or collection.","type":"text"}],"type":"topic","kind":"symbol","title":"EnumeratedSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnumeratedSequence","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","navigatorTitle":[{"text":"EnumeratedSequence","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swift\/enumeratedsequence"}}}