" and "},{"type":"codeVoice","code":"filter"},{"type":"text","text":" are"},{"text":" ","type":"text"},{"type":"text","text":"implemented lazily."}],"url":"\/documentation\/swift\/lazysequence","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"LazySequence","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"LazySequence"}]}}}