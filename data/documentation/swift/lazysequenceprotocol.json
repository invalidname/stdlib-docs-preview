{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequenceProtocol"},"topicSections":[{"title":"Associated Types","anchor":"Associated-Types","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequenceProtocol\/Elements-swift.associatedtype"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequenceProtocol\/elements-6570c","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequenceProtocol\/lazy-2u2ey","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequenceProtocol\/lazy-4q4ln"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequenceProtocol\/compactMap(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequenceProtocol\/drop(while:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequenceProtocol\/filter(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequenceProtocol\/flatMap(_:)-11y2e","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequenceProtocol\/flatMap(_:)-9blrr","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequenceProtocol\/joined()","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequenceProtocol\/map(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequenceProtocol\/prefix(while:)"]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"seeAlsoSections":[{"anchor":"Lazy-Collections","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyCollectionProtocol"],"generated":true,"title":"Lazy Collections"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/lazysequenceprotocol"]}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"]},{"type":"inheritedBy","kind":"relationships","title":"Inherited By","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyCollectionProtocol"]},{"type":"conformingTypes","kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyDropWhileSequence","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyFilterSequence","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyMapSequence","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazyPrefixWhileSequence","doc:\/\/com.apple.Swift\/documentation\/Swift\/LazySequence","doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Slice"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"LazySequenceProtocol"},{"kind":"text","text":" : "},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lazy sequences can be used to avoid needless storage allocation"},{"type":"text","text":" "},{"type":"text","text":"and computation, because they use an underlying sequence for"},{"type":"text","text":" "},{"type":"text","text":"storage and compute their elements on demand. For example, "},{"type":"codeVoice","code":"doubled"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"text","text":"this code sample is a sequence containing the values "},{"type":"codeVoice","code":"2"},{"type":"text","text":", "},{"type":"codeVoice","code":"4"},{"type":"text","text":", and "},{"type":"codeVoice","code":"6"},{"type":"text","text":"."}]},{"type":"codeListing","code":["let doubled = [1, 2, 3].lazy.map { $0 * 2 }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each time an element of the lazy sequence "},{"type":"codeVoice","code":"doubled"},{"type":"text","text":" is accessed, the"},{"type":"text","text":" "},{"type":"text","text":"closure accesses and transforms an element of the underlying array."}]},{"inlineContent":[{"type":"text","text":"Sequence operations that take closure arguments, such as "},{"type":"codeVoice","code":"map(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"filter(_:)"},{"type":"text","text":", are normally eager: They use the closure immediately and"},{"type":"text","text":" "},{"type":"text","text":"return a new array. When you use the "},{"type":"codeVoice","code":"lazy"},{"type":"text","text":" property, you give the standard"},{"type":"text","text":" "},{"type":"text","text":"library explicit permission to store the closure and the sequence"},{"type":"text","text":" "},{"type":"text","text":"in the result, and defer computation until it is needed."}],"type":"paragraph"},{"text":"Adding New Lazy Operations","type":"heading","level":2,"anchor":"Adding-New-Lazy-Operations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add a new lazy sequence operation, extend this protocol with"},{"type":"text","text":" "},{"type":"text","text":"a method that returns a lazy wrapper that itself conforms to"},{"type":"text","text":" "},{"type":"codeVoice","code":"LazySequenceProtocol"},{"type":"text","text":".  For example, an eager "},{"type":"codeVoice","code":"scan(_:_:)"},{"type":"text","text":" "},{"type":"text","text":"method is defined as follows:"}]},{"type":"codeListing","code":["extension Sequence {","    \/\/\/ Returns an array containing the results of","    \/\/\/","    \/\/\/   p.reduce(initial, nextPartialResult)","    \/\/\/","    \/\/\/ for each prefix `p` of `self`, in order from shortest to","    \/\/\/ longest. For example:","    \/\/\/","    \/\/\/     (1..<6).scan(0, +) \/\/ [0, 1, 3, 6, 10, 15]","    \/\/\/","    \/\/\/ - Complexity: O(n)","    func scan<Result>(","        _ initial: Result,","        _ nextPartialResult: (Result, Element) -> Result","    ) -> [Result] {","        var result = [initial]","        for x in self {","            result.append(nextPartialResult(result.last!, x))","        }","        return result","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can build a sequence type that lazily computes the elements in the"},{"type":"text","text":" "},{"type":"text","text":"result of a scan:"}]},{"type":"codeListing","code":["struct LazyScanSequence<Base: Sequence, Result>","    : LazySequenceProtocol","{","    let initial: Result","    let base: Base","    let nextPartialResult:","        (Result, Base.Element) -> Result","","    struct Iterator: IteratorProtocol {","        var base: Base.Iterator","        var nextElement: Result?","        let nextPartialResult:","            (Result, Base.Element) -> Result","        ","        mutating func next() -> Result? {","            return nextElement.map { result in","                nextElement = base.next().map {","                    nextPartialResult(result, $0)","                }","                return result","            }","        }","    }","    ","    func makeIterator() -> Iterator {","        return Iterator(","            base: base.makeIterator(),","            nextElement: initial as Result?,","            nextPartialResult: nextPartialResult)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Finally, you can give all lazy sequences a lazy "},{"type":"codeVoice","code":"scan(_:_:)"},{"type":"text","text":" method:"}]},{"type":"codeListing","code":["extension LazySequenceProtocol {","    func scan<Result>(","        _ initial: Result,","        _ nextPartialResult: @escaping (Result, Element) -> Result","    ) -> LazyScanSequence<Self, Result> {","        return LazyScanSequence(","            initial: initial, base: self, nextPartialResult: nextPartialResult)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With this type and extension method, you can call "},{"type":"codeVoice","code":".lazy.scan(_:_:)"},{"type":"text","text":" on any"},{"type":"text","text":" "},{"type":"text","text":"sequence to create a lazily computed scan. The resulting "},{"type":"codeVoice","code":"LazyScanSequence"},{"type":"text","text":" "},{"type":"text","text":"is itself lazy, too, so further sequence operations also defer computation."}]},{"inlineContent":[{"type":"text","text":"The explicit permission to implement operations lazily applies"},{"type":"text","text":" "},{"type":"text","text":"only in contexts where the sequence is statically known to conform to"},{"type":"text","text":" "},{"type":"codeVoice","code":"LazySequenceProtocol"},{"type":"text","text":". In the following example, because the extension"},{"type":"text","text":" "},{"type":"text","text":"applies only to "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":", side-effects such as the accumulation of"},{"type":"text","text":" "},{"type":"codeVoice","code":"result"},{"type":"text","text":" are never unexpectedly dropped or deferred:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension Sequence where Element == Int {","    func sum() -> Int {","        var result = 0","        _ = self.map { result += $0 }","        return result","    }","}"]},{"inlineContent":[{"type":"text","text":"Don’t actually use "},{"type":"codeVoice","code":"map"},{"type":"text","text":" for this purpose, however, because it creates"},{"type":"text","text":" "},{"type":"text","text":"and discards the resulting array. Instead, use "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" for summing"},{"type":"text","text":" "},{"type":"text","text":"operations, or "},{"type":"codeVoice","code":"forEach"},{"type":"text","text":" or a "},{"type":"codeVoice","code":"for"},{"type":"text","text":"-"},{"type":"codeVoice","code":"in"},{"type":"text","text":" loop for operations with side"},{"type":"text","text":" "},{"type":"text","text":"effects."}],"type":"paragraph"}]}],"kind":"symbol","metadata":{"roleHeading":"Protocol","modules":[{"name":"Standard Library"}],"role":"symbol","externalID":"s:s20LazySequenceProtocolP","title":"LazySequenceProtocol","symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"LazySequenceProtocol"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"LazySequenceProtocol"}],"platforms":[{"introducedAt":"8.0","unavailable":false,"beta":false,"deprecated":false,"name":"iOS"},{"introducedAt":"8.0","unavailable":false,"beta":false,"deprecated":false,"name":"iPadOS"},{"introducedAt":"13.0","unavailable":false,"beta":false,"deprecated":false,"name":"Mac Catalyst"},{"beta":false,"name":"macOS","deprecated":false,"unavailable":false,"introducedAt":"10.10"},{"beta":false,"name":"tvOS","deprecated":false,"unavailable":false,"introducedAt":"9.0"},{"beta":false,"name":"visionOS","deprecated":false,"unavailable":false,"introducedAt":"1.0"},{"beta":false,"name":"watchOS","deprecated":false,"unavailable":false,"introducedAt":"2.0"}]},"abstract":[{"type":"text","text":"A sequence on which normally-eager sequence operations are implemented"},{"type":"text","text":" "},{"type":"text","text":"lazily."}],"references":{"doc://com.apple.Swift/documentation/Swift/Slice":{"url":"\/documentation\/swift\/slice","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Slice"}],"abstract":[{"type":"text","text":"A view into a subsequence of elements of another collection."}],"navigatorTitle":[{"kind":"identifier","text":"Slice"}],"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/S