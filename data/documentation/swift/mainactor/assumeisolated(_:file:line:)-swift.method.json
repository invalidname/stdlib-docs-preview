"text","text":"The return value of the "},{"type":"codeVoice","code":"operation"}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"You call this method to "},{"inlineContent":[{"type":"text","text":"assume and verify"}],"type":"emphasis"},{"type":"text","text":" that the currently"},{"type":"text","text":" "},{"type":"text","text":"executing synchronous function is actually executing on the serial"},{"type":"text","text":" "},{"type":"text","text":"executor of this actor."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If that is the case, the operation is invoked with an "},{"type":"codeVoice","code":"isolated"},{"type":"text","text":" version"},{"type":"text","text":" "},{"type":"text","text":"of the actor, allowing synchronous access to actor local state without"},{"type":"text","text":" "},{"type":"text","text":"hopping through asynchronous boundaries."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the current context is not running on the actor’s serial executor, or"},{"type":"text","text":" "},{"type":"text","text":"if the actor is a reference to a remote actor, this method will crash"},{"type":"text","text":" "},{"type":"text","text":"with a fatal error (similar to "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MainActor\/preconditionIsolated(_:file:line:)","isActive":true},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that this check is performed against the passed in actor’s serial"},{"type":"text","text":" "},{"type":"text","text":"executor, meaning that if another actor uses the same serial executor–by"},{"type":"text","text":" "},{"type":"text","text":"using that actor’s "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/unownedExecutor","isActive":true},{"text":" as its own","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/unownedExecutor","isActive":true},{"type":"text","text":"–this check will succeed, as from a concurrency"},{"type":"text","text":" "},{"type":"text","text":"safety perspective, the serial executor guarantees mutual exclusion of"},{"type":"text","text":" "},{"type":"text","text":"those two actors."}]},{"type":"paragraph","inlineContent":[{"text":"This method can only be used from synchronous functions, as asynchronous","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"functions should instead perform a normal method call to the actor, which"},{"type":"text","text":" "},{"type":"text","text":"will hop task execution to the target actor if necessary."}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Because this check is performed against the actor’s serial executor,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"if another actor uses the same serial executor–by using"},{"text":" ","type":"text"},{"type":"text","text":"another actor’s executor as its own "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/unownedExecutor"},{"type":"text","text":" "},{"type":"text","text":"–this check will succeed.  Fom a concurrency safety perspective,"},{"type":"text","text":" "},{"type":"text","text":"the serial executor guarantees mutual exclusion of those two actors."}]}]},{"type":"aside","name":"Throws","style":"note","content":[{"inlineContent":[{"type":"text","text":"The error thrown by the operation, if it threw"}],"type":"paragraph"}]}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MainActor\/assumeIsolated(_:file:line:)-swift.method","interfaceLanguage":"swift"},"metadata":{"role":"symbol","roleHeading":"Instance Method","modules":[{"relatedModules":[],"name":"Swift"}],