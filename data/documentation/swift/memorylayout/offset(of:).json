ext":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"offset"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"key"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s14PartialKeyPathC","text":"PartialKeyPath","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialKeyPath"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s12MemoryLayoutO1Txmfp","text":"T"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int"},{"kind":"text","text":"?"}]}]},{"kind":"parameters","parameters":[{"name":"key","content":[{"inlineContent":[{"type":"text","text":"A key path referring to storage that can be accessed"},{"type":"text","text":" "},{"type":"text","text":"through a value of type "},{"type":"codeVoice","code":"T"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The offset in bytes from a pointer to a value of type "},{"type":"codeVoice","code":"T"},{"text":" to a","type":"text"},{"type":"text","text":" "},{"text":"pointer to the storage referenced by ","type":"text"},{"code":"key","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if no such offset","type":"text"},{"text":" ","type":"text"},{"text":"is available for the storage referenced by ","type":"text"},{"code":"key","type":"codeVoice"},{"type":"text","text":". If the value is"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":", it can be because "},{"code":"key","type":"codeVoice"},{"type":"text","text":" is computed, has observers, requires"},{"type":"text","text":" "},{"type":"text","text":"reabstraction, or overlaps storage with other properties."}]}],"kind":"content"},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"You can use this method to find the distance in bytes that can be added","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to a pointer of type "},{"type":"codeVoice","code":"T"},{"text":" to get a pointer to the property referenced by","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"key"},{"type":"text","text":". The offset is available only if the given key refers to inline,"},{"type":"text","text":" "},{"type":"text","text":"directly addressable storage within the in-memory representation of "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"If the return value of this method is non-","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", then accessing the value","type":"text"},{"text":" ","type":"text"},{"text":"by key path or by an offset pointer are equivalent. For example, for a","type":"text"},{"text":" ","type":"text"},{"text":"variable ","type":"text"},{"code":"root","type":"codeVoice"},{"type":"text","text":" of type "},{"type":"codeVoice","code":"T"},{"type":"text","text":", a key path "},{"type":"codeVoice","code":"key"},{"type":"text","text":" of type"},{"type":"text","text":" "},{"type":"codeVoice","code":"WritableKeyPath<T, U>"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"value"},{"type":"text","text":" of type "},{"type":"codeVoice","code":"U"},{"text":":","type":"text"}]},{"type":"codeListing","code":["\/\/ Mutation through the key path","root[keyPath: key] = value","","\/\/ Mutation through the offset pointer","withUnsafeMutableBytes(of: &root) { bytes in","    let offset = MemoryLayout<T>.offset(of: key)!","    let rawPointerToValue = bytes.baseAddress! + offset","    let pointerToValue = rawPointerToValue.assumingMemoryBound(to: U.self)","    pointerToValue.pointee = value","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A property has inline, directly addressable storage when it is a stored"},{"text":" ","type":"text"},{"text":"property for which no additional work is required to extract or set the","type":"text"},{"text":" ","type":"text"},{"text":"value. Properties are not directly accessible if they trigger any","type":"text"},{"text":" ","type":"text"},{"code":"didSet","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"willSet","type":"codeVoice"},{"text":" accessors, perform any representation changes such","type":"text"},{"text":" ","type":"text"},{"text":"as bridging or closure reabstraction, or mask the value out of","type":"text"},{"text":" ","type":"text"},{"text":"overlapping storage as for packed bitfields. In addition, because class","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"instance properties are always stored out-of-line, their positions are"},{"type":"text","text":" "},{"type":"text","text":"not accessible using "},{"type":"codeVoice","code":"offset(of:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, in the "},{"type":"codeVoice","code":"ProductCategory"},{"type":"text","text":" type defined here, only"},{"type":"text","text":" "},{"type":"codeVoice","code":"\\.updateCounter"},{"type":"text","text":", "},{"type":"codeVoice","code":"\\.identifier"},{"type":"text","text":", and "},{"type":"codeVoice","code":"\\.identifier.name"},{"type":"text","text":" refer to"},{"type":"text","text":" "},{"type":"text","text":"properties with inline, directly addressable storage:"}]},{"type":"codeListing","code":["struct ProductCategory {","    struct Identifier {","        var name: String              \/\/ addressable","    }","","    var identifier: Identifier        \/\/ addressable","    var updateCounter: Int            \/\/ addressable","    var products: [Product] {         \/\/ not addressable: didSet handler","        didSet { updateCounter += 1 }","    }","    var productCount: Int {           \/\/ not addressable: computed property","        return products.count","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When using "},{"type":"codeVoice","code":"offset(of:)"},{"type":"text","text":" with a type imported from a library, don’t"},{"type":"text","text":" "},{"type":"text","text":"assume that future versions of the library will have the same behavior."},{"type":"text","text":" "},{"type":"text","text":"If a property is converted from a stored property to a computed"},{"type":"text","text":" "},{"type":"text","text":"property, the result of "},{"type":"codeVoice","code":"offset(of:)"},{"type":"text","text":" changes to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". That kind of"},{"type":"text","text":" "},{"type":"text","text":"conversion is nonbreaking in other contexts, but would trigger a runtime"},{"type":"text","text":" "},{"type":"text","text":"error if the result of "},{"type":"codeVoice","code":"offset(of:)"},{"type":"text","text":" is force-unwrapped."}]}]}],"abstract":[{"text":"Returns the offset of an inline stored property within a type’s in-memory","type":"text"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/MemoryLayout"]]},"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/MemoryLayout/offset(of:)":{"abstract":[{"text":"Returns the 