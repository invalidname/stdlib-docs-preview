{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/MemoryLayout"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"offset","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"key","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"PartialKeyPath","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialKeyPath","preciseIdentifier":"s:s14PartialKeyPathC"},{"text":"<","kind":"text"},{"text":"T","kind":"typeIdentifier","preciseIdentifier":"s:s12MemoryLayoutO1Txmfp"},{"text":">) -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","preciseIdentifier":"s:Si"},{"text":"?","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A key path referring to storage that can be accessed"},{"type":"text","text":" "},{"type":"text","text":"through a value of type "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}]}],"name":"key"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The offset in bytes from a pointer to a value of type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" to a"},{"type":"text","text":" "},{"type":"text","text":"pointer to the storage referenced by "},{"type":"codeVoice","code":"key"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if no such offset"},{"type":"text","text":" "},{"type":"text","text":"is available for the storage referenced by "},{"type":"codeVoice","code":"key"},{"type":"text","text":". If the value is"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", it can be because "},{"type":"codeVoice","code":"key"},{"type":"text","text":" is computed, has observers, requires"},{"type":"text","text":" "},{"type":"text","text":"reabstraction, or overlaps storage with other properties."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"You can use this method to find the distance in bytes that can be added"},{"type":"text","text":" "},{"type":"text","text":"to a pointer of type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" to get a pointer to the property referenced by"},{"type":"text","text":" "},{"type":"codeVoice","code":"key"},{"type":"text","text":". The offset is available only if the given key refers to inline,"},{"type":"text","text":" "},{"type":"text","text":"directly addressable storage within the in-memory representation of "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the return value of this method is non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":", then accessing the value"},{"type":"text","text":" "},{"type":"text","text":"by key path or by an offset pointer are equivalent. For example, for a"},{"type":"text","text":" "},{"type":"text","text":"variable "},{"type":"codeVoice","code":"root"},{"type":"text","text":" of type "},{"type":"codeVoice","code":"T"},{"type":"text","text":", a key path "},{"type":"codeVoice","code":"key"},{"type":"text","text":" of type"},{"type":"text","text":" "},{"type":"codeVoice","code":"WritableKeyPath<T, U>"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"value"},{"type":"text","text":" of type "},{"type":"codeVoice","code":"U"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ Mutation through the key path","root[keyPath: key] = value","","\/\/ Mutation through the offset pointer","withUnsafeMutableBytes(of: &root) { bytes in","    let offset = MemoryLayout<T>.offset(of: key)!","    let rawPointerToValue = bytes.baseAddress! + offset","    let pointerToValue = rawPointerToValue.assumingMemoryBound(to: U.self)","    pointerToValue.pointee = value","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"A property has inline, directly addressable storage when it is a stored","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"property for which no additional work is required to extract or set the"},{"type":"text","text":" "},{"type":"text","text":"value. Properties are not directly accessible if they trigger any"},{"type":"text","text":" "},{"type":"codeVoice","code":"didSet"},{"type":"text","text":" or "},{"type":"codeVoice","code":"willSet"},{"type":"text","text":" accessors, perform any representation changes such"},{"type":"text","text":" "},{"type":"text","text":"as bridging or closure reabstraction, or mask the value out of"},{"type":"text","text":" "},{"type":"text","text":"overlapping storage as for packed bitfields. In addition, because class"},{"type":"text","text":" "},{"type":"text","text":"instance properties are always stored out-of-line, their positions are"},{"type":"text","text":" "},{"type":"text","text":"not accessible using "},{"code":"offset(of:)","type":"codeVoice"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"For example, in the "},{"type":"codeVoice","code":"ProductCategory"},{"type":"text","text":" type defined here, only"},{"type":"text","text":" "},{"type":"codeVoice","code":"\\.updateCounter"},{"type":"text","text":", "},{"type":"codeVoice","code":"\\.identifier"},{"type":"text","text":", and "},{"code":"\\.identifier.name","type":"codeVoice"},{"type":"text","text":" refer to"},{"type":"text","text":" "},{"type":"text","text":"properties with inline, directly addressable storage:"}],"type":"paragraph"},{"code":["struct ProductCategory {","    struct Identifier {","        var name: String              \/\/ addressable","    }","","    var identifier: Identifier        \/\/ addressable","    var updateCounter: Int            \/\/ addressable","    var products: [Product] {         \/\/ not addressable: didSet handler","        didSet { updateCounter += 1 }","    }","    var productCount: Int {           \/\/ not addressable: computed property","        return products.count","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"When using "},{"type":"codeVoice","code":"offset(of:)"},{"type":"text","text":" with a type imported from a library, don’t"},{"type":"text","text":" "},{"type":"text","text":"assume that future versions of the library will have the same behavior."},{"type":"text","text":" "},{"type":"text","text":"If a property is converted from a stored property to a computed"},{"type":"text","text":" "},{"type":"text","text":"property, the result of "},{"type":"codeVoice","code":"offset(of:)"},{"type":"text","text":" changes to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". That kind of"},{"type":"text","text":" "},{"type":"text","text":"conversion is nonbreaking in other contexts, but would trigger a runtime"},{"type":"text","text":" "},{"type":"text","text":"error if the result of "},{"type":"codeVoice","code":"offset(of:)"},{"type":"text","text":" is force-unwrapped."}],"type":"paragraph"}]}],"metadata":{"extendedModule":"Swift","externalID":"s:s12MemoryLayoutO6offset2ofSiSgs14PartialKeyPathCyxG_tFZ","modules":[{"name":"Swift"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"offset"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s14PartialKeyPathC","kind":"typeIdentifier","text":"PartialK