{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/MemoryLayout"]]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MemoryLayout\/offset(of:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"metadata":{"roleHeading":"Type Method","extendedModule":"Swift","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"offset","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s14PartialKeyPathC","text":"PartialKeyPath","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s12MemoryLayoutO1Txmfp","text":"T","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":[{"beta":false,"deprecated":false,"unavailable":false,"name":"iOS","introducedAt":"8.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"iPadOS","introducedAt":"8.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"Mac Catalyst","introducedAt":"13.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"macOS","introducedAt":"10.10"},{"beta":false,"deprecated":false,"unavailable":false,"name":"tvOS","introducedAt":"9.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"watchOS","introducedAt":"2.0"}],"modules":[{"name":"Swift"}],"title":"offset(of:)","externalID":"s:s12MemoryLayoutO6offset2ofSiSgs14PartialKeyPathCyxG_tFZ","symbolKind":"method","role":"symbol"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/memorylayout\/offset(of:)"]}],"abstract":[{"text":"Returns the offset of an inline stored property within a type’s in-memory","type":"text"},{"text":" ","type":"text"},{"text":"representation.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"offset","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"key","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s14PartialKeyPathC","text":"PartialKeyPath","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialKeyPath","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:s12MemoryLayoutO1Txmfp","text":"T","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"key","content":[{"type":"paragraph","inlineContent":[{"text":"A key path referring to storage that can be accessed","type":"text"},{"text":" ","type":"text"},{"text":"through a value of type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The offset in bytes from a pointer to a value of type ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" to a","type":"text"},{"text":" ","type":"text"},{"text":"pointer to the storage referenced by ","type":"text"},{"type":"codeVoice","code":"key"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if no such offset","type":"text"},{"text":" ","type":"text"},{"text":"is available for the storage referenced by ","type":"text"},{"type":"codeVoice","code":"key"},{"text":". If the value is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", it can be because ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" is computed, has observers, requires","type":"text"},{"text":" ","type":"text"},{"text":"reabstraction, or overlaps storage with other properties.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"You can use this method to find the distance in bytes that can be added","type":"text"},{"text":" ","type":"text"},{"text":"to a pointer of type ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" to get a pointer to the property referenced by","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"key"},{"text":". The offset is available only if the given key refers to inline,","type":"text"},{"text":" ","type":"text"},{"text":"directly addressable storage within the in-memory representation of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the return value of this method is non-","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", then accessing the value","type":"text"},{"text":" ","type":"text"},{"text":"by key path or by an offset pointer are equivalent. For example, for a","type":"text"},{"text":" ","type":"text"},{"text":"variable ","type":"text"},{"type":"codeVoice","code":"root"},{"text":" of type ","type":"text"},{"type":"codeVoice","code":"T"},{"text":", a key path ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" of type","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WritableKeyPath<T, U>"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"value"},{"text":" of type ","type":"text"},{"type":"codeVoice","code":"U"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Mutation through the key path","root[keyPath: key] = value","","\/\/ Mutation through the offset pointer","withUnsafeMutableBytes(of: &root) { bytes in","    let offset = MemoryLayout<T>.offset(of: key)!","    let rawPointerToValue = bytes.baseAddress! + offset","    let pointerToValue = rawPointerToValue.assumingMemoryBound(to: U.self)","    pointerToValue.pointee = value","}"],"type":"codeListing"},{"inlineContent":[{"text":"A property has inline, directly addressable storage when it is a stored","type":"text"},{"text":" ","type":"text"},{"text":"property for which no additional work is required to extract or set the","type":"text"},{"text":" ","type":"text"},{"text":"value. Properties are not directly accessible if they trigger any","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"didSet"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"willSet"},{"text":" accessors, perform any representation changes such","type":"text"},{"text":" ","type":"text"},{"text":"as bridging or closure reabstraction, or mask the value out of","type":"text"},{"text":" ","type":"text"},{"text":"overlapping storage as for packed bitfields. In addition, because class","type":"text"},{"text":" ","type":"text"},{"text":"instance properties are always stored out-of-line, their positions are","type":"text"},{"text":" ","type":"text"},{"text":"not accessible using ","type":"text"},{"type":"codeVoice","code":"offset(of:)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, in the ","type":"text"},{"type":"codeVoice","code":"ProductCategory"},{"text":" type defined here, only","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\\.updateCounter"},{"text":", ","type":"text"},{"type":"codeVoice","code":"\\.identifier"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"\\.identifier.name"},{"text":" refer to","type":"text"},{"text":" ","type":"text"},{"text":"properties with inline, directly addressable storage:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ProductCategory {","    struct Identifier {","        var name: String              \/\/ addressable","    }","","    var identifier: Identifier        \/\/ addressable","    var updateCounter: Int            \/\/ addressable","    var products: [Product] {         \/\/ not addressable: didSet handler","        didSet { updateCounter += 1 }","    }","    var productCount: Int {           \/\/ not addressable: computed property","        return products.count","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"When using ","type":"text"},{"type":"codeVoice","code":"offset(of:)"},{"text":" with a type imported from a library, don’t","type":"text"},{"text":" ","type":"text"},{"text":"assume that future versions of the library will have the same behavior.","type":"text"},{"text":" ","type":"text"},{"text":"If a property is converted from a stored property to a computed","type":"text"},{"text":" ","type":"text"},{"text":"property, the result of ","type":"text"},{"type":"codeVoice","code":"offset(of:)"},{"text":" changes to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". That kind of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"conversion is nonbreaking in other contexts, but would trigger a runtime"},{"type":"text","text":" "},{"text":"error if the result of ","type":"text"},{"code":"offset(of:)","type":"codeVoice"},{"text":" is force-unwrapped.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/MemoryLayout":{"abstract":[{"type":"text","text":"The memory layout of a type, describing its size, stride, and alignment."}],"type":"topic","kind":"symbol","url":"\/documentation\/swift\/memorylayout","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MemoryLayout","title":"MemoryLayout","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MemoryLayout"}],"navigatorTitle":[{"kind":"identi