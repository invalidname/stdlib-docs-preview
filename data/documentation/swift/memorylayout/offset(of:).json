be because ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" is computed, has observers, requires","type":"text"},{"text":" ","type":"text"},{"text":"reabstraction, or overlaps storage with other properties.","type":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"You can use this method to find the distance in bytes that can be added","type":"text"},{"text":" ","type":"text"},{"text":"to a pointer of type ","type":"text"},{"code":"T","type":"codeVoice"},{"type":"text","text":" to get a pointer to the property referenced by"},{"text":" ","type":"text"},{"code":"key","type":"codeVoice"},{"type":"text","text":". The offset is available only if the given key refers to inline,"},{"text":" ","type":"text"},{"text":"directly addressable storage within the in-memory representation of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the return value of this method is non-","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", then accessing the value","type":"text"},{"text":" ","type":"text"},{"text":"by key path or by an offset pointer are equivalent. For example, for a","type":"text"},{"text":" ","type":"text"},{"text":"variable ","type":"text"},{"type":"codeVoice","code":"root"},{"text":" of type ","type":"text"},{"type":"codeVoice","code":"T"},{"text":", a key path ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" of type","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WritableKeyPath<T, U>"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"value"},{"text":" of type ","type":"text"},{"type":"codeVoice","code":"U"},{"text":":","type":"text"}]},{"code":["\/\/ Mutation through the key path","root[keyPath: key] = value","","\/\/ Mutation through the offset pointer","withUnsafeMutableBytes(of: &root) { bytes in","    let offset = MemoryLayout<T>.offset(of: key)!","    let rawPointerToValue = bytes.baseAddress! + offset","    let pointerToValue = rawPointerToValue.assumingMemoryBound(to: U.self)","    pointerToValue.pointee = value","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A property has inline, directly addressable storage when it is a stored"},{"type":"text","text":" "},{"type":"text","text":"property for which no additional work is required to extract or set the"},{"type":"text","text":" "},{"type":"text","text":"value. Properties are not directly accessible if they trigger any"},{"type":"text","text":" "},{"type":"codeVoice","code":"didSet"},{"type":"text","text":" or "},{"type":"codeVoice","code":"willSet"},{"type":"text","text":" accessors, perform any representation changes such"},{"type":"text","text":" "},{"type":"text","text":"as bridging or closure reabstraction, or mask the value out of"},{"type":"text","text":" "},{"type":"text","text":"overlapping storage as for packed bitfields. In addition, because class"},{"type":"text","text":" "},{"type":"text","text":"instance properties are always stored out-of-line, their positions are"},{"type":"text","text":" "},{"type":"text","text":"not accessible using "},{"type":"codeVoice","code":"offset(of:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, in the "},{"type":"codeVoice","code":"ProductCategory"},{"type":"text","text":" type defined here, only"},{"type":"text","text":" "},{"type":"codeVoice","code":"\\.updateCounter"},{"type":"text","text":", "},{"type":"codeVoice","code":"\\.identifier"},{"type":"text","text":", and "},{"type":"codeVoice","code":"\\.identifier.name"},{"type":"text","text":" refer to"},{"type":"text","text":" "},{"type":"text","text":"properties with inline, directly addressable storage:"}]},{"type":"codeListing","syntax":"swift","code":["struct ProductCategory {","    struct Identifier {","        var name: String              \/\/ addressable","    }","","    var identifier: Identifier        \/\/ addressable","    var updateCounter: Int            \/\/ addressable","    var products: [Product] {         \/\/ not addressable: didSet handler","        didSet { updateCounter += 1 }","    }","    var productCount: Int {           \/\/ not addressable: computed property","        return products.count","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When using "},{"type":"codeVoice","code":"offset(of:)"},{"type":"text","text":" with a type imported from a library, don’t"},{"type":"text","text":" "},{"type":"text","text":"assume that future versions of the library will have the same behavior."},{"type":"text","text":" "},{"type":"text","text":"If a property is converted from a stored property to a computed"},{"text":" ","type":"text"},{"text":"property, the result of ","type":"text"},{"code":"offset(of:)","type":"codeVoice"},{"text":" changes to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". That kind of","type":"text"},{"text":" ","type":"text"},{"text":"conversion is nonbreaking in other contexts, but would trigger a runtime","type":"text"},{"text":" ","type":"text"},{"text":"error if the result of ","type":"text"},{"code":"offset(of:)","type":"codeVoice"},{"text":" is force-unwrapped.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/MemoryLayout"]]},"metadata":{"roleHeading":"Type Method","modules":[{"name":"Standard Library"}],"title":"offset(of:)","externalID":"s:s12MemoryLayoutO6offset2ofSiSgs14PartialKeyPathCyxG_tFZ","symbolKind":"method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"offset","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s1