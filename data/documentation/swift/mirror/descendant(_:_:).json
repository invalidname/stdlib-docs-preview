{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Mirror"]]},"abstract":[{"text":"Returns a specific descendant of the reflected subject, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if no","type":"text"},{"text":" ","type":"text"},{"text":"such descendant exists.","type":"text"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Mirror\/descendant(_:_:)"},"seeAlsoSections":[{"generated":true,"title":"Querying Descendants","anchor":"Querying-Descendants","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/MirrorPath"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"descendant"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"first"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s10MirrorPathP","text":"MirrorPath","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MirrorPath"},{"kind":"text","text":", "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"rest"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:s10MirrorPathP","text":"MirrorPath","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MirrorPath"},{"kind":"text","text":"...) -> "},{"kind":"keyword","text":"Any"},{"kind":"text","text":"?"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"first","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The first mirror path component to access."}]}]},{"name":"rest","content":[{"type":"paragraph","inlineContent":[{"text":"Any remaining mirror path components.","type":"text"}]}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"inlineContent":[{"text":"The descendant of this mirror specified by the given mirror","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"path components if such a descendant exists; otherwise, "},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Pass a variadic list of string and integer arguments. Each string"},{"type":"text","text":" "},{"type":"text","text":"argument selects the first child with a matching label. Each integer"},{"type":"text","text":" "},{"type":"text","text":"argument selects the child at that offset. For example, passing"},{"type":"text","text":" "},{"type":"codeVoice","code":"1, \"two\", 3"},{"type":"text","text":" as arguments to "},{"type":"codeVoice","code":"myMirror.descendant(_:_:)"},{"type":"text","text":" is equivalent"},{"type":"text","text":" "},{"type":"text","text":"to:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var result: Any? = nil","let children = myMirror.children","if let i0 = children.index(","    children.startIndex, offsetBy: 1, limitedBy: children.endIndex),","    i0 != children.endIndex","{","    let grandChildren = Mirror(reflecting: children[i0].value).children","    if let i1 = grandChildren.firstIndex(where: { $0.label == \"two\" }) {","        let greatGrandChildren =","            Mirror(reflecting: grandChildren[i1].value).children","        if let i2 = greatGrandChildren.index(","            greatGrandChildren.startIndex,","            offsetBy: 3,","            limitedBy: greatGrandChildren.endIndex),","            i2 != greatGrandChildren.endIndex","        {","            \/\/ Success!","            result = greatGrandChildren[i2].value","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"This function is suitable for exploring the structure of a mirror in a"},{"type":"text","text":" "},{"type":"text","text":"REPL or playground, but is not intended to be efficient. The efficiency"},{"type":"text","text":" "},{"type":"text","text":"of finding each element in the argument list depends on the argument"},{"type":"text","text":" "},{"type":"text","text":"type and the capabilities of the each level of the mirror’s "},{"type":"codeVoice","code":"children"},{"type":"text","text":" "},{"type":"text","text":"collections. Each string argument requires a linear search, and unless"},{"type":"text","text":" "},{"type":"text","text":"the underlying collection supports random-access traversal, each integer"},{"type":"text","text":" "},{"type":"text","text":"argument also requires a linear operation."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Instance Method","title":"descendant(_:_:)","externalID":"s:s6MirrorV10descendantyypSgs0A4Path_p_sAE_pdtF","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"descendant","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:s10MirrorPathP","text":"MirrorPath","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:s10MirrorPathP","text":"MirrorPath","kind":"typeIdentifier"},{"text":"...) -> ","kind":"text"},{"text":"Any","kind":"keyword"},{"text":"?","kind":"text"}],"role":"symbol","symbolKind":"method","extendedModule":"Swift","modules":[{"name":"Swift"}],"platforms":[{"beta":false,"deprecated":false,"introducedAt":"8.0","unavailable":false,"name":"iOS"},{"beta":false,"deprecated":false,"introducedAt":"8.0","unavailable":false,"name":"iPadOS"},{"beta":false,"deprecated":false,"introducedAt":"13.0","unavailable":false,"name":"Mac Catalyst"},{"beta":false,"deprecated":false,"introducedAt":"10.10","unavailable":false,"name":"macOS"},{"beta":false,"deprecated":false,"introducedAt":"9.0","unavailable":false,"name":"tvOS"},{"beta":false,"deprecated":false,"