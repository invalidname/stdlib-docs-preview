dex(of: \"Maxime\") {","    students[i] = \"Max\"","}","print(students)","\/\/ Prints \"[\"Ben\", \"Ivy\", \"Jordell\", \"Max\"]\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"In addition to changing the value of an individual element, you can also","type":"text"},{"text":" ","type":"text"},{"text":"change the values of a slice of elements in a mutable collection. For","type":"text"},{"text":" ","type":"text"},{"text":"example, you can sort ","type":"text"},{"inlineContent":[{"text":"part","type":"text"}],"type":"emphasis"},{"text":" of a mutable collection by calling the","type":"text"},{"text":" ","type":"text"},{"text":"mutable ","type":"text"},{"type":"codeVoice","code":"sort()"},{"text":" method on a subscripted subsequence. Here’s an","type":"text"},{"text":" ","type":"text"},{"text":"example that sorts the first half of an array of integers:","type":"text"}]},{"code":["var numbers = [15, 40, 10, 30, 60, 25, 5, 100]","numbers[0..<4].sort()","print(numbers)","\/\/ Prints \"[10, 15, 30, 40, 60, 25, 5, 100]\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"MutableCollection"},{"text":" protocol allows changing the values of a","type":"text"},{"text":" ","type":"text"},{"text":"collection’s elements but not the length of the collection itself. For","type":"text"},{"text":" ","type":"text"},{"text":"operations that require adding or removing elements, see the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RangeReplaceableCollection"},{"text":" protocol instead.","type":"text"}]},{"level":1,"anchor":"Conforming-to-the-MutableCollection-Protocol","type":"heading","text":"Conforming to the MutableCollection Protocol"},{"type":"paragraph","inlineContent":[{"text":"To add conformance to the ","type":"text"},{"type":"codeVoice","code":"MutableCollection"},{"text":" protocol to your own","type":"text"},{"text":" ","type"