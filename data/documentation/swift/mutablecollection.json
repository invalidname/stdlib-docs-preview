ocumentation\/Swift"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"MutableCollection","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MutableCollection\/Element","text":"Element","preciseIdentifier":"s:SM7ElementQa"},{"text":"> : ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","text":"Collection","preciseIdentifier":"s:Sl"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection\/SubSequence","text":"SubSequence","preciseIdentifier":"s:Sl11SubSequenceQa"},{"text":" : ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/MutableCollection","text":"MutableCollection","preciseIdentifier":"s:SM"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Collections that conform to "},{"type":"codeVoice","code":"MutableCollection"},{"type":"text","text":" gain the ability to"},{"type":"text","text":" "},{"type":"text","text":"change the value of their elements. This example shows how you can"},{"type":"text","text":" "},{"type":"text","text":"modify one of the names in an array of students."}]},{"type":"codeListing","code":["var students = [\"Ben\", \"Ivy\", \"Jordell\", \"Maxime\"]","if let i = students.firstIndex(of: \"Maxime\") {","    students[i] = \"Max\"","}","print(students)","\/\/ Prints \"[\"Ben\", \"Ivy\", \"Jordell\", \"Max\"]\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"In addition to changing the value of an individual element, you can also"},{"type":"text","text":" "},{"type":"text","text":"change the values of a slice of elements in a mutable collection. For"},{"type":"text","text":" "},{"type":"text","text":"example, you can sort "},{"inlineContent":[{"type":"text","text":"part"}],"type":"emphasis"},{"type":"text","text":" of a mutable collection by calling the"},{"type":"text","text":" "},{"type":"text","text":"mutable "},{"type":"codeVoice","code":"sort()"},{"type":"text","text":" method on a subscripted subsequence. Here’s an"},{"type":"text","text":" "},{"type":"text","text":"example that sorts the first half of an array of integers:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var numbers = [15, 40, 10, 30, 60, 25, 5, 100]","numbers[0..<4].sort()","print(numbers)","\/\/ Prints \"[10, 15, 30, 40, 60, 25, 5, 100]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"MutableCollection"},{"type":"text","text":" protocol allows changing the values of a"},{"type":"text","text":" "},{"type":"text","text":"collection’s elements but not the length of the collection itself. For"},{"type":"text","text":" "},{"type":"text","text":"operations that require adding or removing elements, see the"},{"type":"text","text":" "},{"type":"codeVoice","code":"RangeReplaceableCollection"},{"type":"text","text":" protocol instead."}]},{"text":"Conforming to the MutableCollection Protocol","anchor":"Conforming-to-the-MutableCollection-Protocol","type":"heading","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add conformance to the "},{"type":"codeVoice","code":"MutableCollection"},{"type":"text","text":" protocol to your own"},{"type":"text","text":" "},{"type":"text","text":"custom collection, upgrade your type’s subscript to support both read"},{"type":"text","text":" "},{"type":"text","text":"and write access."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A value stored into a subscript of a "},{"type":"codeVoice","code":"MutableCollection"},{"type":"text","text":" instance must"},{"type":"text","text":" "},{"type":"text","text":"subsequently be accessible at that same position. That is, for a mutable"},{"type":"text","text":" "},{"type":"text","text":"collection instance "},{"type":"codeVoice","code":"a"},{"type":"text","text":", index "},{"type":"codeVoice","code":"i"},{"type":"text","text":", and value "},{"type":"codeVoice","code":"x"},{"type":"text","text":", the two sets of"},{"type":"text","text":" "},{"type":"text","text":"assignments in the following code sample must be equivalent:"}]},{"type":"codeListing","syntax":"swift","code":["a[i] = x","let y = a[i]","","\/\/ Must be equivalent to:","a[i] = x","let y = x"]}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"title":"Collection Mutability","anchor":"Collection-Mutability","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/RangeReplaceableCollection"]}],"references":{"doc://com.apple.Swift/documentation/Swift/CollectionOfOne":{"abstract":[{"type":"text","text":"A collection containing a single element."}],"title":"CollectionOfOne","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CollectionOfOne"}],"navigatorTitle":[{"kind":"identifier","text":"CollectionOfOne"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CollectionOfOne","role":"symbol","url":"\/documentation\/swift\/collectionofone","conformance":{"constraints":[{"code":"Element","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Copyable","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Escapable"},{"text":".","type":"text"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"kind":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/