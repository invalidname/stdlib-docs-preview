apple.Swift\/documentation\/Swift\/MutableCollection"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Collections that conform to "},{"type":"codeVoice","code":"MutableCollection"},{"type":"text","text":" gain the ability to"},{"type":"text","text":" "},{"type":"text","text":"change the value of their elements. This example shows how you can"},{"type":"text","text":" "},{"type":"text","text":"modify one of the names in an array of students."}]},{"type":"codeListing","syntax":"swift","code":["var students = [\"Ben\", \"Ivy\", \"Jordell\", \"Maxime\"]","if let i = students.firstIndex(of: \"Maxime\") {","    students[i] = \"Max\"","}","print(students)","\/\/ Prints \"[\"Ben\", \"Ivy\", \"Jordell\", \"Max\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to changing the value of an individual element, you can also"},{"type":"text","text":" "},{"type":"text","text":"change the values of a slice of elements in a mutable collection. For"},{"type":"text","text":" "},{"type":"text","text":"example, you can sort "},{"type":"emphasis","inlineContent":[{"text":"part","type":"text"}]},{"text":" of a mutable collection by calling the","type":"text"},{"text":" ","type":"text"},{"text":"mutable ","type":"text"},{"code":"sort()","type":"codeVoice"},{"text":" method on a subscripted subsequence. Here’s an","type":"text"},{"text":" ","type":"text"},{"text":"example that sorts the first half of an array of integers:","type":"text"}]},{"code":["var numbers = [15, 40, 10, 30, 60, 25, 5, 100]","numbers[0..<4].sort()","print(numbers)","\/\/ Prints \"[10, 15, 30, 40, 60, 25, 5, 100]\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"MutableCollection","type":"codeVoice"},{"text":" protocol allows changing the values of a","type":"text"},{"text":" ","type":"text"},{"text":"collection’s elements but