\"","}","print(students)","\/\/ Prints \"[\"Ben\", \"Ivy\", \"Jordell\", \"Max\"]\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to changing the value of an individual element, you can also"},{"type":"text","text":" "},{"type":"text","text":"change the values of a slice of elements in a mutable collection. For"},{"type":"text","text":" "},{"type":"text","text":"example, you can sort "},{"inlineContent":[{"type":"text","text":"part"}],"type":"emphasis"},{"type":"text","text":" of a mutable collection by calling the"},{"type":"text","text":" "},{"type":"text","text":"mutable "},{"type":"codeVoice","code":"sort()"},{"text":" method on a subscripted subsequence. Here’s an","type":"text"},{"type":"text","text":" "},{"type":"text","text":"example that sorts the first half of an array of integers:"}]},{"syntax":"swift","code":["var numbers = [15, 40, 10, 30, 60, 25, 5, 100]","numbers[0..<4].sort()","print(numbers)","\/\/ Prints \"[10, 15, 30, 40, 60, 25, 5, 100]\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"MutableCollection"},{"type":"text","text":" protocol allows changing the values of a"},{"type":"text","text":" "},{"type":"text","text":"collection’s elements but not the length of the collection itself. For"},{"type":"text","text":" "},{"type":"text","text":"operations that require adding or removing elements, see the"},{"type":"text","text":" "},{"type":"codeVoice","code":"RangeReplaceableCollection"},{"type":"text","text":" protocol instead."}]},{"type":"heading","anchor":"Conforming-to-the-MutableCollection-Protocol","level":1,"text":"Conforming to the MutableCollection Protocol"},{"inlineContent":[{"type":"text","text":"To add conformance to the "},{"type":"codeVoice","code":"MutableCollection"},{"type":"text","text":" protocol to your own"},{"type":"text","text":" "},{"type":"text","text":"custom collection, upgrade your type’s subscript to support both read"},{"type":"text","text":" "},{"type":"text","text":"and write access."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A value stored into a subscript of a "},{"type":"codeVoice","code":"MutableCollection"},{"type":"text","text":" instance must"},{"type":"text","text":" "},{"type":"text","text":"subsequently be accessible at that same position. That is, for a mutable"},{"type":"text","text":" "},{"type":"text","text":"collection instance "},{"type":"codeVoice","code":"a"},{"type":"text","text":", index "},{"type":"codeVoice","code":"i"},{"type":"text","text":", and value "},{"code":"x","type":"codeVoice"},{"type":"text","text":", the two sets of"},{"type":"text","text":" "},{"text":"assignments in the following code sample must be equivalent:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["a[i] = x","let y = a[i]","","\/\/ Must be equivalent to:","a[i] = x","let y = x"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"references":{"doc://com.apple.Swift/documentation/Swift/Collection":{"url":"\/documentation\/swift\/collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","title":"Collection","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Collection"}],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Collection"}],"abstract":[{"type":"text","text":"A sequence whose elements can be traversed multiple times,"},{"type":"text","text":" "},{"type":"text","text":"nondestructively, and accessed by an indexed subscript."}],"role":"symbol"},"doc://com.apple.Swift/documentation/Swift/Sequence":{"url":"\/documentation\/swift\/sequence","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sequence"}],"fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"Sequence","kind":"identifier"}],"type":"topic","role":