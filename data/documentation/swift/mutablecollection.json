0, 25, 5, 100]\""]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"MutableCollection","type":"codeVoice"},{"text":" protocol allows changing the values of a","type":"text"},{"text":" ","type":"text"},{"text":"collection’s elements but not the length of the collection itself. For","type":"text"},{"text":" ","type":"text"},{"text":"operations that require adding or removing elements, see the","type":"text"},{"text":" ","type":"text"},{"code":"RangeReplaceableCollection","type":"codeVoice"},{"text":" protocol instead.","type":"text"}]},{"type":"heading","text":"Conforming to the MutableCollection Protocol","anchor":"Conforming-to-the-MutableCollection-Protocol","level":1},{"type":"paragraph","inlineContent":[{"text":"To add conformance to the ","type":"text"},{"code":"MutableCollection","type":"codeVoice"},{"text":" protocol to your own","type":"text"},{"text":" ","type":"text"},{"text":"custom collection, upgrade your type’s subscript to support both read","type":"text"},{"text":" ","type":"text"},{"text":"and write access.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A value stored into a subscript of a ","type":"text"},{"code":"MutableCollection","type":"codeVoice"},{"text":" instance must","type":"text"},{"text":" ","type":"text"},{"text":"subsequently be accessible at that same position. That is, for a mutable","type":"text"},{"text":" ","type":"text"},{"text":"collection instance ","type":"text"},{"code":"a","type":"codeVoice"},{"text":", index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":", and value ","type":"text"},{"code":"x","type":"codeVoice"},{"text":", the two sets of","type":"text"},{"text":" ","type":"text"},{"text":"assignments in the following code sample must be equivalent:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["a[i] = x","let y = a[i]","","\/\/ Must be equivalent to:","a[i] = x","let y = x"]}],"kind":"content"}],"relationshipsSections":[{"type":"inheritsFrom","kin