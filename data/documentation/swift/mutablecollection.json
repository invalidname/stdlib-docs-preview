ollection"},{"type":"text","text":" protocol allows changing the values of a"},{"type":"text","text":" "},{"type":"text","text":"collection’s elements but not the length of the collection itself. For"},{"type":"text","text":" "},{"type":"text","text":"operations that require adding or removing elements, see the"},{"type":"text","text":" "},{"type":"codeVoice","code":"RangeReplaceableCollection"},{"type":"text","text":" protocol instead."}],"type":"paragraph"},{"level":1,"type":"heading","anchor":"Conforming-to-the-MutableCollection-Protocol","text":"Conforming to the MutableCollection Protocol"},{"inlineContent":[{"type":"text","text":"To add conformance to the "},{"type":"codeVoice","code":"MutableCollection"},{"type":"text","text":" protocol to your own"},{"type":"text","text":" "},{"type":"text","text":"custom collection, upgrade your type’s subscript to support both read"},{"type":"text","text":" "},{"type":"text","text":"and write access."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A value stored into a subscript of a "},{"type":"codeVoice","code":"MutableCollection"},{"type":"text","text":" instance must"},{"type":"text","text":" "},{"type":"text","text":"subsequently be accessible at that same position. That is, for a mutable"},{"type":"text","text":" "},{"type":"text","text":"collection instance "},{"type":"codeVoice","code":"a"},{"type":"text","text":", index "},{"type":"codeVoice","code":"i"},{"type":"text","text":", and value "},{"type":"codeVoice","code":"x"},{"type":"text","text":", the two sets of"},{"type":"text","text":" "},{"type":"text","text":"assignments in the following code sample must be equivalent:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["a[i] = x","let y = a[i]","","\/\/ Must be equivalent to:","a[i] = x","let y = x"]}]}],"sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableCollection"}],"navigatorTitle":[{"