{"abstract":[{"type":"text","text":"Make responsive apps that update the presentation when underlying data changes."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"title":"Related frameworks","generated":true,"anchor":"Related-frameworks","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Distributed-collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexBuilder-collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Synchronization-collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/CompatibilitySpan-collection"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Observation-collection","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swift\/observation-collection"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Observable-conformance","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable"],"title":"Observable conformance"},{"anchor":"Fine-tuning","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationIgnored()","doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationTracked()"],"title":"Fine-tuning"},{"anchor":"Change-tracking","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Observation\/withObservationTracking(_:onChange:)","doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationRegistrar"],"title":"Change tracking"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"inlineContent":[{"text":"Observation provides a robust, type-safe, and performant implementation of the","type":"text"},{"text":" ","type":"text"},{"text":"observer design pattern in Swift. This pattern allows an observable object to","type":"text"},{"text":" ","type":"text"},{"text":"maintain a list of observers and notify them of specific or general state","type":"text"},{"text":" ","type":"text"},{"text":"changes. This has the advantages of not directly coupling objects together and","type":"text"},{"text":" ","type":"text"},{"text":"allowing implicit distribution of updates across potential multiple observers.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The Observation frameworks provides the following capabilities:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Marking a type as observable"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Tracking changes within an instance of an observable type"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Observing and utilizing those changes elsewhere, such as in an app’s user"},{"type":"text","text":" "},{"type":"text","text":"interface"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To declare a type as observable, attach the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()"},{"type":"text","text":" macro"},{"type":"text","text":" "},{"type":"text","text":"to the type declaration. This macro declares and implements conformance to the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable"},{"type":"text","text":" protocol to the type at compile time."}]},{"type":"codeListing","code":["@Observable","class Car {","    var name: String = \"\"","    var needsRepairs: Bool = false","    ","    init(name: String, needsRepairs: Bool = false) {","        self.name = name","        self.needsRepairs = needsRepairs","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To track changes, use the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/withObservationTracking(_:onChange:)","isActive":true},{"type":"text","text":" function."},{"type":"text","text":" "},{"type":"text","text":"For example, in the following code, the function calls the "},{"type":"codeVoice","code":"onChange"},{"type":"text","text":" closure"},{"type":"text","text":" "},{"type":"text","text":"when a car’s name changes. However, it doesn’t call the closure when a car’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"needsRepair"},{"type":"text","text":" flag changes. That’s because the function only tracks properties"},{"type":"text","text":" "},{"type":"text","text":"read in its "},{"type":"codeVoice","code":"apply"},{"type":"text","text":" closure, and the closure doesn’t read the "},{"type":"codeVoice","code":"needsRepair"},{"type":"text","text":" "},{"type":"text","text":"property."}]},{"type":"codeListing","code":["func render() {","    withObservationTracking {","        for car in cars {","            print(car.name)","        }","    } onChange: {","        print(\"Schedule renderer.\")","    }","}"],"syntax":"swift"}]}],"metadata":{"title":"Observation","modules":[{"name":"Standard Library"}],"role":"collectionGroup","roleHeading":"API Collection"},"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/Distributed-collection":{"title":"Distributed","url":"\/documentation\/swift\/distributed-collection","role":"collectionGroup","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Distributed-collection","type":"topic","kind":"article","abstract":[{"text":"Build systems that run distributed code across multiple processes and devices.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/CompatibilitySpan-collection":{"abstract":[],"url":"\/documentation\/swift\/compatibilityspan-collection","kind":"article","type":"topic","role":"collectionGroup","title":"CompatibilitySpan","identifier":"doc:\/\/com.apple.Swift\/documentation\/S