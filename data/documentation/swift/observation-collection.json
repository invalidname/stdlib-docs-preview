{"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"anchor":"Related-frameworks","generated":true,"title":"Related frameworks","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Distributed-collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexBuilder-collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Synchronization-collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/CompatibilitySpan-collection"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Observation provides a robust, type-safe, and performant implementation of the","type":"text"},{"text":" ","type":"text"},{"text":"observer design pattern in Swift. This pattern allows an observable object to","type":"text"},{"text":" ","type":"text"},{"text":"maintain a list of observers and notify them of specific or general state","type":"text"},{"text":" ","type":"text"},{"text":"changes. This has the advantages of not directly coupling objects together and","type":"text"},{"text":" ","type":"text"},{"text":"allowing implicit distribution of updates across potential multiple observers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Observation frameworks provides the following capabilities:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Marking a type as observable","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Tracking changes within an instance of an observable type","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Observing and utilizing those changes elsewhere, such as in an app’s user","type":"text"},{"text":" ","type":"text"},{"text":"interface","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"To declare a type as observable, attach the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","type":"reference","isActive":true},{"text":" macro","type":"text"},{"text":" ","type":"text"},{"text":"to the type declaration. This macro declares and implements conformance to the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable","type":"reference","isActive":true},{"text":" protocol to the type at compile time.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Observable","class Car {","    var name: String = \"\"","    var needsRepairs: Bool = false","    ","    init(name: String, needsRepairs: Bool = false) {","        self.name = name","        self.needsRepairs = needsRepairs","    }","}"]},{"inlineContent":[{"text":"To track changes, use the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/withObservationTracking(_:onChange:)","type":"reference"},{"text":" function.","type":"text"},{"text":" ","type":"text"},{"text":"For example, in the following code, the function calls the ","type":"text"},{"code":"onChange","type":"codeVoice"},{"text":" closure","type":"text"},{"text":" ","type":"text"},{"text":"when a car’s name changes. However, it doesn’t call the closure when a car’s","type":"text"},{"text":" ","type":"text"},{"code":"needsRepair","type":"codeVoice"},{"text":" flag changes. That’s because the function only tracks properties","type":"text"},{"text":" ","type":"text"},{"text":"read in its ","type":"text"},{"code":"apply","type":"codeVoice"},{"text":" closure, and the closure doesn’t read the ","type":"text"},{"code":"needsRepair","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func render() {","    withObservationTracking {","        for car in cars {","            print(car.name)","        }","    } onChange: {","        print(\"Schedule renderer.\")","    }","}"],"type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"kind":"article","sections":[],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Observation","modules":[{"name":"Standard Library"}]},"topicSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable"],"anchor":"Observable-conformance","title":"Observable conformance"},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationIgnored()","doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationTracked()"],"anchor":"Fine-tuning","title":"Fine-tuning"},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Observation\/withObservationTracking(_:onChange:)","doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationRegistrar"],"anchor":"Change-tracking","title":"Change tracking"}],"abstract":[{"text":"Make responsive apps that update the presentation when underlying data changes.","type":"text"}],"variants":[{"paths":["\/documentation\/swift\/observation-collection"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Observation-collection","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Observation/Observable":{"navigatorTitle":[{"text":"Observable","kind":"identifier"}],"url":"\/documentation\/observation\/observable","type":"topic","kind":"symbol","role":"symbol","abstract":[{"text":"A type that emits notifications to observers when underlying data changes.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable","title":"Observable","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Observable","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Observation/ObservationTracked()":{"title":"ObservationTracked()","type":"topic","abstract":[{"text":"Sy