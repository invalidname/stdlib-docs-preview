{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Observation-collection"},"metadata":{"roleHeading":"API Collection","title":"Observation","modules":[{"name":"Swift"}],"role":"collectionGroup"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Observation provides a robust, type-safe, and performant implementation of the"},{"type":"text","text":" "},{"type":"text","text":"observer design pattern in Swift. This pattern allows an observable object to"},{"type":"text","text":" "},{"type":"text","text":"maintain a list of observers and notify them of specific or general state"},{"type":"text","text":" "},{"type":"text","text":"changes. This has the advantages of not directly coupling objects together and"},{"type":"text","text":" "},{"text":"allowing implicit distribution of updates across potential multiple observers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The Observation frameworks provides the following capabilities:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Marking a type as observable","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Tracking changes within an instance of an observable type","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Observing and utilizing those changes elsewhere, such as in an app’s user"},{"type":"text","text":" "},{"type":"text","text":"interface"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"To declare a type as observable, attach the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()"},{"type":"text","text":" macro"},{"type":"text","text":" "},{"text":"to the type declaration. This macro declares and implements conformance to the","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable","isActive":true,"type":"reference"},{"type":"text","text":" protocol to the type at compile time."}]},{"syntax":"swift","type":"codeListing","code":["@Observable","class Car {","    var name: String = \"\"","    var needsRepairs: Bool = false","    ","    init(name: String, needsRepairs: Bool = false) {","        self.name = name","        self.needsRepairs = needsRepairs","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"To track changes, use the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/withObservationTracking(_:onChange:)"},{"type":"text","text":" function."},{"text":" ","type":"text"},{"type":"text","text":"For example, in the following code, the function calls the "},{"code":"onChange","type":"codeVoice"},{"text":" closure","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"when a car’s name changes. However, it doesn’t call the closure when a car’s"},{"type":"text","text":" "},{"code":"needsRepair","type":"codeVoice"},{"type":"text","text":" flag changes. That’s because the function only tracks properties"},{"type":"text","text":" "},{"text":"read in its ","type":"text"},{"code":"apply","type":"codeVoice"},{"text":" closure, and the closure doesn’t read the ","type":"text"},{"code":"needsRepair","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property.","type":"text"}]},{"syntax":"swift","code":["func render() {","    withObservationTracking {","        for car in cars {","            print(car.name)","        }","    } onChange: {","        print(\"Schedule renderer.\")","    }","}"],"type":"codeListing"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","abstract":[{"text":"Make responsive apps that update the presentation when underlying data changes.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"topicSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable"],"anchor":"Observable-conformance","title":"Observable conformance"},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationIgnored()","doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationTracked()"],"anchor":"Fine-tuning","title":"Fine-tuning"},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Observation\/withObservationTracking(_:onChange:)","doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationRegistrar"],"anchor":"Change-tracking","title":"Change tracking"}],"references":{"doc://com.apple.Swift/documentation/Observation/ObservationRegistrar":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationRegistrar","kind":"symbol","url":"\/documentation\/observation\/observationregistrar","role":"symbol","type":"topic","title":"ObservationRegistrar","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ObservationRegistrar"}],"navigatorTitle":[{"kind":"identifier","text":"ObservationRegistrar"}],"abstract":[{"text":"Provides storage for tracking and access to data changes.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift":{"kind":"symbol","type":"topic","role":"collection","title":"Swift","images":[{"type":"card","identifier":"Swift-PageImage-card.png"}],"abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Observation/withObservationTracking(_:onChange:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/withObservationTracking(_:onChange:)","abstract":[{"type":"text","text":"Tracks access to properties."}],"fragments":[{"kind":"keyw