{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"metadata":{"modules":[{"name":"Swift"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Observation"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Observation-collection"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Observation provides a robust, type-safe, and performant implementation of the","type":"text"},{"text":" ","type":"text"},{"text":"observer design pattern in Swift. This pattern allows an observable object to","type":"text"},{"text":" ","type":"text"},{"text":"maintain a list of observers and notify them of specific or general state","type":"text"},{"text":" ","type":"text"},{"text":"changes. This has the advantages of not directly coupling objects together and","type":"text"},{"text":" ","type":"text"},{"text":"allowing implicit distribution of updates across potential multiple observers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The Observation frameworks provides the following capabilities:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Marking a type as observable"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Tracking changes within an instance of an observable type"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Observing and utilizing those changes elsewhere, such as in an app’s user"},{"type":"text","text":" "},{"type":"text","text":"interface"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"To declare a type as observable, attach the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()"},{"text":" macro","type":"text"},{"text":" ","type":"text"},{"text":"to the type declaration. This macro declares and implements conformance to the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable"},{"text":" protocol to the type at compile time.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Observable","class Car {","    var name: String = \"\"","    var needsRepairs: Bool = false","    ","    init(name: String, needsRepairs: Bool = false) {","        self.name = name","        self.needsRepairs = needsRepairs","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"To track changes, use the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/withObservationTracking(_:onChange:)"},{"text":" function.","type":"text"},{"text":" ","type":"text"},{"text":"For example, in the following code, the function calls the ","type":"text"},{"code":"onChange","type":"codeVoice"},{"text":" closure","type":"text"},{"text":" ","type":"text"},{"text":"when a car’s name changes. However, it doesn’t call the closure when a car’s","type":"text"},{"text":" ","type":"text"},{"code":"needsRepair","type":"codeVoice"},{"text":" flag changes. That’s because the function only tracks properties","type":"text"},{"text":" ","type":"text"},{"text":"read in its ","type":"text"},{"code":"apply","type":"codeVoice"},{"text":" closure, and the closure doesn’t read the ","type":"text"},{"code":"needsRepair","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func render() {","    withObservationTracking {","        for car in cars {","            print(car.name)","        }","    } onChange: {","        print(\"Schedule renderer.\")","    }","}"]}]}],"variants":[{"paths":["\/documentation\/swift\/observation-collection"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"article","abstract":[{"type":"text","text":"Make responsive apps that update the presentation when underlying data changes."}],"topicSections":[{"anchor":"Observable-conformance","title":"Observable conformance","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable()","doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable"]},{"anchor":"Fine-tuning","title":"Fine-tuning","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationIgnored()","doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationTracked()"]},{"anchor":"Change-tracking","title":"Change tracking","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Observation\/withObservationTracking(_:onChange:)","doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationRegistrar"]}],"references":{"doc://com.apple.Swift/documentation/Observation/ObservationRegistrar":{"role":"symbol","title":"ObservationRegistrar","url":"\/documentation\/observation\/observationregistrar","abstract":[{"type":"text","text":"Provides storage for tracking and access to data changes."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationRegistrar","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ObservationRegistrar","kind":"identifier"}],"navigatorTitle":[{"text":"ObservationRegistrar","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/Observation/Observable":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Observable"}],"abstract":[{"type":"text","text":"A type that emits notifications to observers when underlying data changes."}],"title":"Observable","navigatorTitle":[{"kind":"identifier","text":"Observable"}],"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/Observable","url":"\/documentation\/observation\/observable"},"doc://com.apple.Swift/documentation/Observation/withObservationTracking(_:onChange:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/withObservationTracking(_:onChange:)","url":"\/documentation\/observation\/withobservationtracking(_:onchange:)","abstract":[{"text":"Tracks access to properties.","type":"text"}],"role":"symbol","title":"withObservationTracking(_:onChange:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withObservationTracking"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">(() -> "},{"kind":"typeIdentifier","text":"T","preciseIdentifier":"s:11Observation04withA8Tracking_8onChangexxyXE_yyYbcyXKtlF1TL_xmfp"},{"kind":"text","text":", "},{"kind":"externalParam","text":"onChange"},{"kind":"text","text":": "},{"kind":"attribute","text":"@autoclosure"},{"kind":"text","text":" () -> "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"T","preciseIdentifier":"s:11Observation04withA8Tracking_8onChangexxyXE_yyYbcyXKtlF1TL_xmfp"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Observation/ObservationTracked()":{"role":"symbol","title":"ObservationTracked()","url":"\/documentation\/observation\/observationtracked()","abstract":[{"type":"text","text":"Synthesizes a property for accessors."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Observation\/ObservationTracked()","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"ObservationTracked"},{"kind":"text","text":"()"}],"kind":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/Swift":{"type":"topic","kind":"symbol","url":"\/documentation\/swift","role":"collection","title":"Swift","identifier":"doc:\/\/com.apple.Swift\