:2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Use this equal-to operator ("},{"type":"codeVoice","code":"=="},{"type":"text","text":") to compare any two optional instances of"},{"type":"text","text":" "},{"type":"text","text":"a type that conforms to the "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" protocol. The comparison returns"},{"type":"text","text":" "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if both arguments are "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" or if the two arguments wrap values"},{"type":"text","text":" "},{"type":"text","text":"that are equal. Conversely, the comparison returns "},{"type":"codeVoice","code":"false"},{"type":"text","text":" if only one of"},{"type":"text","text":" "},{"type":"text","text":"the arguments is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" or if the two arguments wrap values that are not"},{"type":"text","text":" "},{"type":"text","text":"equal."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let group1 = [1, 2, 3, 4, 5]","let group2 = [1, 3, 5, 7, 9]","if group1.first == group2.first {","    print(\"The two groups start the same.\")","}","\/\/ Prints \"The two groups start the same.\""]},{"inlineContent":[{"type":"text","text":"You can also use this operator to compare a non-optional value to an"},{"type":"text","text":" "},{"type":"text","text":"optional that wraps the same type. The non-optional value is wrapped as an"},{"type":"text","text":" "},{"type":"text","text":"optional before the comparison is made. In the following example, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"numberToMatch"},{"type":"text","text":" constant is wrapped as an optional before comparing to the"},{"type":"text","text":" "},{"type":"text","text":"optional "},{"type":"codeVoice","code":"numberFromString"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let numberToMatch: Int = 23","let numberFromString: Int? = Int(\"23\")      \/\/ Optional(23)","if numberToMatch == numberFromString {","    print(\"It's a match!\")","}","\/\/ Prints \"It's a match!\""]},{"inlineContent":[{"type":"text","text":"An instance that is expressed as a literal can also be used with this"},{"type":"text","text":" "},{"type":"text","text":"operator. In the next example, an integer literal is compared with the"},{"type":"text","text":" "},{"type":"text","text":"optional integer "},{"type":"codeVoice","code":"numberFromString"},{"type":"text","text":". The literal "},{"type":"codeVoice","code":"23"},{"type":"text","text":" is inferred as an"},{"type":"text","text":" "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" instance and then wrapped as an optional before the comparison is"},{"type":"text","text":" "},{"type":"text","text":"performed."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if 23 == numberFromString {","    print(\"It's a match!\")","}","\/\/ Prints \"It's a match!\""]}]}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/Optional/!=(_:_:)-1bazb":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Optional\/!=(_:_:)-1bazb","url":"\/documentation\/swift\/optional\/!=(_:_:)-1bazb","abstract":[{"type":"text","text":"Returns a Boolean value indicating whether two values are not equal."}],"role":"symbol","type":"topic","title":"!=(_:_:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/Bool":{"abstract