ussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Use this equal-to operator (","type":"text"},{"type":"codeVoice","code":"=="},{"text":") to compare any two optional instances of","type":"text"},{"text":" ","type":"text"},{"text":"a type that conforms to the ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" protocol. The comparison returns","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if both arguments are ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" or if the two arguments wrap values","type":"text"},{"text":" ","type":"text"},{"text":"that are equal. Conversely, the comparison returns ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" if only one of","type":"text"},{"text":" ","type":"text"},{"text":"the arguments is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" or if the two arguments wrap values that are not","type":"text"},{"text":" ","type":"text"},{"text":"equal.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let group1 = [1, 2, 3, 4, 5]","let group2 = [1, 3, 5, 7, 9]","if group1.first == group2.first {","    print(\"The two groups start the same.\")","}","\/\/ Prints \"The two groups start the same.\""],"type":"codeListing"},{"inlineContent":[{"text":"You can also use this operator to compare a non-optional value to an","type":"text"},{"text":" ","type":"text"},{"text":"optional that wraps the same type. The non-optional value is wrapped as an","type":"text"},{"text":" ","type":"text"},{"text":"optional before the comparison is made. In the following example, the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"numberToMatch"},{"text":" constant is wrapped as an optional before comparing to the","type":"text"},{"text":" ","type":"text"},{"text":"optional ","type":"text"},{"type":"codeVoice","code":"numberFromString"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let numberToMatch: Int = 23","let numberFromString: Int? = Int(\"23\")      \/\/ Optional(23)","if numberToMatch == numberFromString {","    print(\"It's a match!\")","}","\/\/ Prints \"It's a match!\""],"type":"codeListing"},{"inlineContent":[{"text":"An instance that is expressed as a literal can also be used with this","type":"text"},{"text":" ","type":"text"},{"text":"operator. In the next example, an integer literal is compared with the","type":"text"},{"text":" ","type":"text"},{"text":"optional integer ","type":"text"},{"type":"codeVoice","code":"numberFromString"},{"text":". The literal ","type":"text"},{"type":"codeVoice","code":"23"},{"text":" is inferred as an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" instance and then wrapped as an optional before the comparison is","type":"text"},{"text":" ","type":"text"},{"text":"performed.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["if 23 == numberFromString {","    print(\"It's a match!\")","}","\/\/ Prints \"It's a match!\""],"type":"codeListing"}],"kind":"content"}],"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/Optional/==(_:_:)-m6x":{"kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"=="},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"Wrapped","kind":"typeIdentifier","preciseIdentifier":"s:SqsSQRzlE7Wrappedxmfp"},{"text":"?, ","kind":"text"},{"text":"Wrapped","kind":"typeIdentifier","preciseIdentifier":"s:SqsSQRzlE7Wrappedxmfp"},{"text":"?) -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Wrapped"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":".","type":"text