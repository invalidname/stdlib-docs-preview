:[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Use this equal-to operator (","type":"text"},{"code":"==","type":"codeVoice"},{"text":") to compare any two optional instances of","type":"text"},{"text":" ","type":"text"},{"text":"a type that conforms to the ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" protocol. The comparison returns","type":"text"},{"text":" ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if both arguments are ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" or if the two arguments wrap values","type":"text"},{"text":" ","type":"text"},{"text":"that are equal. Conversely, the comparison returns ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" if only one of","type":"text"},{"text":" ","type":"text"},{"text":"the arguments is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" or if the two arguments wrap values that are not","type":"text"},{"text":" ","type":"text"},{"text":"equal.","type":"text"}],"type":"paragraph"},{"code":["let group1 = [1, 2, 3, 4, 5]","let group2 = [1, 3, 5, 7, 9]","if group1.first == group2.first {","    print(\"The two groups start the same.\")","}","\/\/ Prints \"The two groups start the same.\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"You can also use this operator to compare a non-optional value to an","type":"text"},{"text":" ","type":"text"},{"text":"optional that wraps the same type. The non-optional value is wrapped as an","type":"text"},{"text":" ","type":"text"},{"text":"optional before the comparison is made. In the following example, the","type":"text"},{"text":" ","type":"text"},{"code":"numberToMatch","type":"codeVoice"},{"text":" constant is wrapped as an optional before comparing to the","type":"text"},{"text":" ","type":"text"},{"text":"optional ","type":"text"},{"type":"codeVoice","code":"numberFromString"},{"text":":","type":"text"}]},{"syn