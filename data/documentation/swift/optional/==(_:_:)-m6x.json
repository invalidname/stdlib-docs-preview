ntent":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Use this equal-to operator (","type":"text"},{"type":"codeVoice","code":"=="},{"text":") to compare any two optional instances of","type":"text"},{"text":" ","type":"text"},{"text":"a type that conforms to the ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" protocol. The comparison returns"},{"type":"text","text":" "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if both arguments are "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" or if the two arguments wrap values"},{"type":"text","text":" "},{"type":"text","text":"that are equal. Conversely, the comparison returns "},{"type":"codeVoice","code":"false"},{"type":"text","text":" if only one of"},{"type":"text","text":" "},{"type":"text","text":"the arguments is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" or if the two arguments wrap values that are not"},{"type":"text","text":" "},{"type":"text","text":"equal."}]},{"code":["let group1 = [1, 2, 3, 4, 5]","let group2 = [1, 3, 5, 7, 9]","if group1.first == group2.first {","    print(\"The two groups start the same.\")","}","\/\/ Prints \"The two groups start the same.\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can also use this operator to compare a non-optional value to an"},{"type":"text","text":" "},{"type":"text","text":"optional that wraps the same type. The non-optional value is wrapped as an"},{"type":"text","text":" "},{"type":"text","text":"optional before the comparison is made. In the following example, the"},{"type":"text","text":" "},{"code":"numberToMatch","type":"codeVoice"},{"type":"text","text":" constant is wrapped as an optional before comparing to the"},{"type":"text","text":" "},{"type":"text","text":"optional "},{"code":"numberFromString","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let numberToMatch: Int = 23","let numberFromString: Int? = Int(\"23\")      \/\/ Optional(23)","if numberToMatch == numberFromString {","    print(\"It's a match!\")","}","\/\/ Prints \"It's a match!\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"An instance that is expressed as a literal can also be used with this"},{"type":"text","text":" "},{"text":"operator. In the next example, an integer literal is compared with the","type":"text"},{"text":" ","type":"text"},{"text":"optional integer ","type":"text"},{"code":"numberFromString","type":"codeVoice"},{"text":". The literal ","type":"text"},{"code":"23","type":"codeVoice"},{"text":" is inferred as an","type":"text"},{"text":" ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" instance and then wrapped as an optional before the comparison is","type":"text"},{"text":" ","type":"text"},{"text":"performed.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["if 23 == numberFromString {","    print(\"It's a match!\")","}","\/\/ Prints \"It's a match!\""]}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Optional/!=(_:_:)-9vqn3":{"type":"topic","role":"symbol","abstract":[{"text":"Returns a Boolean value indicating whether two values are not equal.","type":"text"}],"title":"!=(_:_:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Optional\/!=(_:_:)-9vqn3","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"text":"borrowing","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"borrowing","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"ki