{"relationshipsSections":[{"kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral","doc:\/\/com.apple.Swift\/documentation\/Swift\/RawRepresentable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SetAlgebra"],"title":"Inherits From"},{"kind":"relationships","type":"conformingTypes","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Runtime\/Backtrace\/SymbolicationOptions","doc:\/\/com.apple.Swift\/documentation\/Runtime\/SectionCharacteristics"],"title":"Conforming Types"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"generated":true,"anchor":"Sets","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Set"],"title":"Sets"}],"abstract":[{"text":"A type that presents a mathematical set interface to a bit set.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/optionset"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"OptionSet"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RawRepresentable","text":"RawRepresentable","preciseIdentifier":"s:SY"},{"kind":"text","text":", "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SetAlgebra","text":"SetAlgebra","preciseIdentifier":"s:s10SetAlgebraP"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You use the "},{"type":"codeVoice","code":"OptionSet"},{"type":"text","text":" protocol to represent bitset types, where"},{"type":"text","text":" "},{"type":"text","text":"individual bits represent members of a set. Adopting this protocol in"},{"type":"text","text":" "},{"type":"text","text":"your custom types lets you perform set-related operations such as"},{"type":"text","text":" "},{"type":"text","text":"membership tests, unions, and intersections on those types. What’s more,"},{"type":"text","text":" "},{"type":"text","text":"when implemented using specific criteria, adoption of this protocol"},{"type":"text","text":" "},{"type":"text","text":"requires no extra work on your part."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When creating an option set, include a "},{"code":"rawValue","type":"codeVoice"},{"type":"text","text":" property in your type"},{"type":"text","text":" "},{"type":"text","text":"declaration. For your type to automatically receive default implementations"},{"type":"text","text":" "},{"type":"text","text":"for set-related operations, the "},{"type":"codeVoice","code":"rawValue"},{"type":"text","text":" property must be of a type that"},{"type":"text","text":" "},{"type":"text","text":"conforms to the "},{"code":"FixedWidthInteger","type":"codeVoice"},{"type":"text","text":" protocol, such as "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" or "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Next, create unique options as static properties of your custom type using"},{"type":"text","text":" "},{"type":"text","text":"unique powers of two (1, 2, 4, 8, 16, and so forth) for each individual"},{"type":"text","text":" "},{"type":"text","text":"property’s raw value so that each property can be represented by a single"},{"type":"text","text":" "},{"type":"text","text":"bit of the type’s raw value."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, consider a custom type called "},{"code":"ShippingOptions","type":"codeVoice"},{"type":"text","text":" that is an"},{"type":"text","text":" "},{"type":"text","text":"option set of the possible ways to ship a customer’s purchase."},{"type":"text","text":" "},{"code":"ShippingOptions","type":"codeVoice"},{"type":"text","text":" includes a "},{"code":"rawValue","type":"codeVoice"},{"type":"text","text":" property of type "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" that stores"},{"type":"text","text":" "},{"type":"text","text":"the bit mask of available shipping options. The static members "},{"code":"nextDay","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"secondDay"},{"type":"text","text":", "},{"code":"priority","type":"codeVoice"},{"type":"text","text":", and "},{"code":"standard","type":"codeVoice"},{"type":"text","text":" are unique, individual options."}]},{"code":["struct ShippingOptions: OptionSet {","    let rawValue: Int","","    static let nextDay    = ShippingOptions(rawValue: 1 << 0)","    static let secondDay  = ShippingOptions(rawValue: 1 << 1)","    static let priority   = ShippingOptions(rawValue: 1 << 2)","    static let standard   = ShippingOptions(rawValue: 1 << 3)","","    static let express: ShippingOptions = [.nextDay, .secondDay]","    static let all: ShippingOptions = [.express, .priority, .standard]","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare additional preconfigured option set values as static properties"},{"type":"text","text":" "},{"type":"text","text":"initialized with an array literal containing other option values. In the"},{"type":"text","text":" "},{"type":"text","text":"example, because the "},{"type":"codeVoice","code":"express"},{"type":"text","text":" static property is assigned an array"},{"type":"text","text":" "},{"type":"text","text":"literal with the "},{"type":"codeVoice","code":"nextDay"},{"type":"text","text":" and "},{"code":"secondDay","type":"codeVoice"},{"type":"text","text":" options, it will contain those"},{"type":"text","text":" "},{"type":"text","text":"two elements."}]},{"type":"heading","anchor":"Using-an-Option-Set-Type","level":1,"text":"Using an Option Set Type"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you need to create an instance of an option set, assign one of the"},{"type":"text","text":" "},{"type":"text","text":"type’s static members to your variable or constant. Alternatively, to"},{"type":"text","text":" "},{"type":"text","text":"create an option set instance with multiple members, assign an array"},{"type":"text","text":" "},{"type":"text","text":"literal with multiple static members of the option set. To create an empty"},{"type":"text","text":" "},{"type":"text","text":"instance, assign an empty array literal to your variable."}]},{"code":["let singleOption: ShippingOptions = .priority","let multipleOptions: ShippingOptions = [.nextDay, .secondDay, .priority]","let noOptions: ShippingOptions = []"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use set-related operations to check for membership and to add or remove"},{"type":"text","text":" "},{"type":"text","text":"members from an instance of your custom option set type. The following"},{"type":"text","text":" "},{"type":"text","text":"example shows how you can determine free shipping options based on a"},{"type":"text","text":" "},{"type":"text","text":"customer’s purchase price:"}]},{"code":["let purchasePrice = 87.55","","var freeOptions: ShippingOptions = []","if purchasePrice > 50 {","    freeOptions.insert(.priority)","}","","if freeOptions.contains(.priority) {","    print(\"You've earned free priority shipping!\")","} else {","    print(\"Add more to your cart for free priority shipping!\")","}","\/\/ Prints \"You've earned free priority shipping!\""],"type":"codeListing","syntax":"swift"}]}],"topicSections":[{"abstract":[{"text":"When creating your own option set, implement this initializer with a fixed-width","type":"text"},{"text":" ","type":"text"},{"text":"integer, like ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":", as the ","type":"text"},{"code":"RawValue","type":"codeVoice"},{"text":" type.","type":"text"}],"anchor":"Required-Initializer","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/OptionSet\/init(rawValue:)"],"title":"Required Initializer"},{"title":"Element","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/OptionSet\/Element"],"anchor":"Element"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"sections":[],"metadata":{"modules":[{"name":"Standard Library"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"OptionSet"}],"externalID":"s:s9OptionSetP","platforms":[{"deprecated":false,"name":"iOS","unavailable":false,"beta":false,"introducedAt":"8.0"},{"deprecated":false,"name":"iPadOS","unavailable":false,"beta":false,"introducedAt":"8.0"},{"deprecated":false,"name":"Mac Catalyst","unavailable":false,"beta":false,"introducedAt":"13.0"},{"deprecated":false,"name":"macOS","unavailable":false,"beta":false,"introducedAt":"10.10"},{"deprecated":false,"name":"tvOS","unavailable":false,"beta":false,"introducedAt":"9.0"},{"deprecated":false,"name":"visionOS","unavailable":false,"beta":false,"introducedAt":"1.0"},{"deprecated":false,"name":"watchOS","unavailable":false,"beta":false,"introducedAt":"2.0"}],"role":"symbol","symbolKind":"protocol","roleHeading":"Protocol","title":"OptionSet","navigatorTitle":[{"kind":"identifier","text":"OptionSet"}]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/OptionSet","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift/ExpressibleByArrayLiteral":{"abstract":[{"text":"A type that can be initialized using an array literal.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ExpressibleByArrayLiteral"}],"url":"\/documentation\/swift\/expressiblebyarrayliteral","title":"ExpressibleByArrayLiteral","type":"topic","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExpressibleByArrayLiteral"}]},"doc://com.apple.Swift/documentation/Swift/OptionSet/Element":{"type":"topic","url":"\/documentation\/swift\/optionset\/element","title":"Element","kind":"symbol","abstract":[{"type":"text","text":"The element type of the option set."}],"role":"symbol","required":true,"fragments":[{"text":"associatedtype","kind":"keyword"},{"kind":"text","text":" "},{"text":"Element","kind":"identifier"},{"kind":"text","text":" = "},{"kind":"typeIdentifier","text":"Self"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/OptionSet\/Element"},"doc://com.apple.Swift/documentation/Swift/Equatable":{"role":"symbol","title":"Equatable","kind":"symbol","abstract":[{"text":"A type that can be compared for value equality.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","navigatorTitle":[{"kind":"identifier","text":"Equatable"}],"url":"\/documentation\/swift\/equatable","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Equatable"}]},"doc://com.apple.Swift/documentation/Swift/SetAlgebra":{"role":"symbol","title":"SetAlgebra","url":"\/documentation\/swift\/setalgebra","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SetAlgebra","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SetAlgebra","kind":"identifier"}],"navigatorTitle":[{"text":"SetAlgebra","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that provides mathematical set operations."}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/Set":{"type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Set","kind":"identifier"}],"abstract":[{"type":"text","text":"An unordered collection of unique elements."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Set","title":"Set","url":"\/documentation\/swift\/set","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Set","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Runtime/SectionCharacteristics":{"navigatorTitle":[{"kind":"identifier","text":"SectionCharacteristics"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Runtime\/SectionCharacteristics","url":"\/documentation\/runtime\/sectioncharacteristics","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SectionCharacteristics"}],"title":"SectionCharacteristics","role":"symbol","abstract":[]},"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","url":"\/documentation\/swift","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"title":"Standard Library","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"role":"collection"},"doc://com.apple.Swift/documentation/Swift/RawRepresentable":{"abstract":[{"text":"A type that can be converted to and from an associated raw value.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RawRepresentable","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/swift\/rawrepresentable","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RawRepresentable"}],"title":"RawRepresentable","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RawRepresentable"},"doc://com.apple.Swift/documentation/Swift/OptionSet/init(rawValue:)":{"role":"symbol","title":"init(rawValue:)","url":"\/documentation\/swift\/optionset\/init(rawvalue:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/OptionSet\/init(rawValue:)","required":t