ext":"Element"},{"kind":"text","text":" = "},{"kind":"typeIdentifier","text":"Self"}],"required":true,"url":"\/documentation\/swift\/optionset\/element","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/OptionSet\/Element"},"Swift-PageImage-card.png":{"variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png","traits":["2x","dark"]}],"type":"image","identifier":"Swift-PageImage-card.png","alt":"An orange Swift logo on a gradient background."},"doc://com.apple.Swift/documentation/Swift/ExpressibleByArrayLiteral":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ExpressibleByArrayLiteral"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral","title":"ExpressibleByArrayLiteral","url":"\/documentation\/swift\/expressiblebyarrayliteral","abstract":[{"text":"A type that can be initialized using an array literal.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"ExpressibleByArrayLiteral","kind":"identifier"}]},"doc://com.apple.Swift/documentation/_RegexParser/SyntaxOptions":{"title":"SyntaxOptions","abstract":[],"identifier":"doc:\/\/com.apple.Swift\/documentation\/_RegexParser\/SyntaxOptions","url":"\/documentation\/_regexparser\/syntaxoptions","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SyntaxOptions","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"SyntaxOptions","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/Equatable":{"navigatorTitle":[{"kind":"identifier","text":"Equatable"}],"url":"\/documentation\/swift\/equatable","abstract":[{"type":"text","text":"A type that can be compared for value equality."}],"kind":"symbol","title":"Equatable","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swif