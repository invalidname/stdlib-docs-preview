{"topicSections":[{"anchor":"Required-Initializer","title":"Required Initializer","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/OptionSet\/init(rawValue:)"],"abstract":[{"text":"When creating your own option set, implement this initializer with a fixed-width","type":"text"},{"type":"text","text":" "},{"type":"text","text":"integer, like "},{"code":"Int","type":"codeVoice"},{"text":", as the ","type":"text"},{"code":"RawValue","type":"codeVoice"},{"text":" type.","type":"text"}]},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/OptionSet\/Element"],"anchor":"Element","title":"Element"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OptionSet","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"RawRepresentable","preciseIdentifier":"s:SY","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RawRepresentable"},{"text":", ","kind":"text"},{"text":"SetAlgebra","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SetAlgebra","preciseIdentifier":"s:s10SetAlgebraP"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"You use the ","type":"text"},{"code":"OptionSet","type":"codeVoice"},{"type":"text","text":" protocol to represent bitset types, where"},{"type":"text","text":" "},{"text":"individual bits represent members of a set. Adopting this protocol in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"your custom types lets you perform set-related operations such as"},{"type":"text","text":" "},{"type":"text","text":"membership tests, unions, and intersections on those types. What’s more,"},{"type":"text","text":" "},{"type":"text","text":"when implemented using specific criteria, adoption of this protocol"},{"type":"text","text":" "},{"type":"text","text":"requires no extra work on your part."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When creating an option set, include a "},{"type":"codeVoice","code":"rawValue"},{"type":"text","text":" property in your type"},{"type":"text","text":" "},{"type":"text","text":"declaration. For your type to automatically receive default implementations"},{"type":"text","text":" "},{"type":"text","text":"for set-related operations, the "},{"type":"codeVoice","code":"rawValue"},{"type":"text","text":" property must be of a type that"},{"type":"text","text":" "},{"type":"text","text":"conforms to the "},{"code":"FixedWidthInteger","type":"codeVoice"},{"text":" protocol, such as ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"UInt8","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Next, create unique options as static properties of your custom type using","type":"text"},{"text":" ","type":"text"},{"text":"unique powers of two (1, 2, 4, 8, 16, and so forth) for each individual","type":"text"},{"text":" ","type":"text"},{"text":"property’s raw value so that each property can be represented by a single","type":"text"},{"text":" ","type":"text"},{"text":"bit of the type’s raw value.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, consider a custom type called "},{"code":"ShippingOptions","type":"codeVoice"},{"type":"text","text":" that is an"},{"type":"text","text":" "},{"type":"text","text":"option set of the possible ways to ship a customer’s purchase."},{"type":"text","text":" "},{"code":"ShippingOptions","type":"codeVoice"},{"type":"text","text":" includes a "},{"type":"codeVoice","code":"rawValue"},{"text":" property of type ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" that stores","type":"text"},{"text":" ","type":"text"},{"text":"the bit mask of available shipping options. The static members ","type":"text"},{"code":"nextDay","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"secondDay","type":"codeVoice"},{"text":", ","type":"text"},{"code":"priority","type":"codeVoice"},{"type":"text","text":", and "},{"code":"standard","type":"codeVoice"},{"type":"text","text":" are unique, individual options."}]},{"type":"codeListing","syntax":"swift","code":["struct ShippingOptions: OptionSet {","    let rawValue: Int","","    static let nextDay    = ShippingOptions(rawValue: 1 << 0)","    static let secondDay  = ShippingOptions(rawValue: 1 << 1)","    static let priority   = ShippingOptions(rawValue: 1 << 2)","    static let standard   = ShippingOptions(rawValue: 1 << 3)","","    static let express: ShippingOptions = [.nextDay, .secondDay]","    static let all: ShippingOptions = [.express, .priority, .standard]","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare additional preconfigured option set values as static properties"},{"type":"text","text":" "},{"type":"text","text":"initialized with an array literal containing other option values. In the"},{"type":"text","text":" "},{"type":"text","text":"example, because the "},{"code":"express","type":"codeVoice"},{"type":"text","text":" static property is assigned an array"},{"type":"text","text":" "},{"type":"text","text":"literal with the "},{"code":"nextDay","type":"codeVoice"},{"type":"text","text":" and "},{"code":"secondDay","type":"codeVoice"},{"type":"text","text":" options, it will contain those"},{"type":"text","text":" "},{"type":"text","text":"two elements."}]},{"type":"heading","text":"Using an Option Set Type","level":1,"anchor":"Using-an-Option-Set-Type"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you need to create an instance of an option set, assign one of the"},{"type":"text","text":" "},{"type":"text","text":"type’s static members to your variable or constant. Alternatively, to"},{"type":"text","text":" "},{"type":"text","text":"create an option set instance with multiple members, assign an array"},{"type":"text","text":" "},{"type":"text","text":"literal with multiple static members of the option set. To create an empty"},{"type":"text","text":" "},{"type":"text","text":"instance, assign an empty array literal to your variable."}]},{"type":"codeListing","syntax":"swift","code":["let singleOption: ShippingOptions = .priority","let multipleOptions: ShippingOptions = [.nextDay, .secondDay, .priority]","let noOptions: ShippingOptions = []"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use set-related operations to check for membership and to add or remove"},{"type":"text","text":" "},{"type":"text","text":"members from an instance of your custom option set type. The following"},{"type":"text","text":" "},{"text":"example shows how you can determine free shipping options based on a","type":"text"},{"text":" ","type":"text"},{"text":"customer’s purchase price:","type":"text"}]},{"code":["let purchasePrice = 87.55","","var freeOptions: ShippingOptions = []","if purchasePrice > 50 {","    freeOptions.insert(.priority)","}","","if freeOptions.contains(.priority) {","    print(\"You've earned free priority shipping!\")","} else {","    print(\"Add more to your cart for free priority shipping!\")","}","\/\/ Prints \"You've earned free priority shipping!\""],"type":"codeListing","syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"metadata":{"title":"OptionSet","roleHeading":"Protocol","platforms":[{"deprecated":false,"introducedAt":"8.0","name":"iOS","beta":false,"unavailable":false},{"deprecated":false,"introducedAt":"8.0","name":"iPadOS","beta":false,"unavailable":false},{"deprecated":false,"introducedAt":"13.0","name":"Mac Catalyst","beta":false,"unavailable":false},{"deprecated":false,"introducedAt":"10.10","name":"macOS","beta":false,"unavailable":false},{"deprecated":false,"introducedAt":"9.0","name":"tvOS","beta":false,"unavailable":false},{"deprecated":false,"introducedAt":"1.0","name":"visionOS","beta":false,"unavailable":false},{"deprecated":false,"introducedAt":"2.0","name":"watchOS","beta":false,"unavailable":false}],"role":"symbol","externalID":"s:s9OptionSetP","modules":[{"name":"Swift"}],"symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"OptionSet"}],"navigatorTitle":[{"kind":"identifier","text":"OptionSet"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/OptionSet"},"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByArrayLiteral","doc:\/\/com.apple.Swift\/documentation\/Swift\/RawRepresentable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SetAlgebra"],"title":"Inherits From"},{"type":"conformingTypes","kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Runtime\/Backtrace\/SymbolicationOptions","doc:\/\/com.apple.Swift\/documentation\/Runtime\/SectionCharacteristics","doc:\/\/com.apple.Swift\/documentation\/_RegexParser\/SyntaxOptions"],"title":"Conforming Types"}],"seeAlsoSections":[{"generated":true,"anchor":"Sets","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Set"],"title":"Sets"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/optionset"]}],"abstract":[{"text":"A type that presents a mathematical set interface to a bit set.","type":"text"}],"references":{"doc://com.apple.Swift/documentation/Swift/ExpressibleByArrayLiteral":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A type that can be initialized using an array literal."}],"title":"ExpressibleByArrayLiteral","url":"\/documentation\/swift\/expressiblebyarrayliteral"