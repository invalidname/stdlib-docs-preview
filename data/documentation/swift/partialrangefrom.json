:"paragraph","inlineContent":[{"text":"You create ","type":"text"},{"code":"PartialRangeFrom","type":"codeVoice"},{"text":" instances by using the postfix range operator","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(postfix "},{"type":"codeVoice","code":"..."},{"type":"text","text":")."}]},{"type":"codeListing","syntax":"swift","code":["let atLeastFive = 5..."]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use a partial range to quickly check if a value is contained in a"},{"type":"text","text":" "},{"type":"text","text":"particular range of values. For example:"}]},{"code":["atLeastFive.contains(4)","\/\/ false","atLeastFive.contains(5)","\/\/ true","atLeastFive.contains(6)","\/\/ true"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"You can use a partial range of a collection’s indices to represent the"},{"type":"text","text":" "},{"type":"text","text":"range from the partial range’s lower bound up to the end of the"},{"type":"text","text":" "},{"type":"text","text":"collection."}],"type":"paragraph"},{"code":["let numbers = [10, 20, 30, 40, 50, 60, 70]","print(numbers[3...])","\/\/ Prints \"[40, 50, 60, 70]\""],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Using-a-Partial-Range-as-a-Sequence","text":"Using a Partial Range as a Sequence","type":"heading"},{"inlineContent":[{"type":"text","text":"When a partial range uses integers as its lower and upper bounds, or any"},{"text":" ","type":"text"},{"text":"other type that conforms to the ","type":"text"},{"code":"Strideable","type":"codeVoice"},{"text":" protocol with an integer","type":"text"},{"text":" ","type":"text"},{"text":"stride, you can use that range in a ","type":"text"},{"code":"for","type":"codeVoice"},{"text":"-","type":"text"},{"code":"in","type":"codeVoice"},{"text":" loop or with any sequence","type":"text"},{"text":" ","type":"text"},{"text":"method that doesn’t require that the sequence is finite. The elements of","type":"text"},{"text":" ","type":"text"},{"text":"a partial range are the consecutive values from its lower bound continuing","type":"text"},{"text":" ","type":"text"},{"text":"upward indefinitely.","type":"text"}],"type":"paragraph"},{"code":["func isTheMagicNumber(_ x: Int) -> Bool {","    return x == 3","}","","for x in 1... {","    if isTheMagicNumber(x) {","        print(\"\\(x) is the magic number!\")","        break","    } else {","        print(\"\\(x) wasn't it...\")","    }","}","\/\/ \"1 wasn't it...\"","\/\/ \"2 wasn't it...\"","\/\/ \"3 is the magic number!\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Because a ","type":"text"},{"code":"PartialRangeFrom","type":"codeVoice"},{"text":" sequence counts upward indefinitely, do not","type":"text"},{"text":" ","type":"text"},{"text":"use one with methods that read the entire sequence before returning, such","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"code":"map(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"filter(_:)","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"suffix(_:)","type":"codeVoice"},{"text":". It is safe to use operations","type":"text"},{"text":" ","type":"text"},{"text":"that put an upper limit on the number of elements they access, such as","type":"text"},{"text":" ","type":"text"},{"code":"prefix(_:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"dropFirst(_:)","type":"codeVoice"},{"text":", and operations that you can guarantee","type":"text"},{"text":" ","type":"text"},{"text":"will terminate, such as passing a closure you know will eventually return","type":"text"},{"text":" ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"first(where:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"In the following example, the ","type":"text"},{"code":"asciiTable","type":"codeVoice"},{"text":" sequence is made by zipping","type":"text"},{"text":" ","type":"text"},{"text":"together the characters in the ","type":"text"},{"code":"alphabet","type":"codeVoice"},{"text":" string with a partial range","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"starting at 65, the ASCII value of the capital letter A. Iterating over"},{"type":"text","text":" "},{"type":"text","text":"two zipped sequences continues only as long as the shorter of the two"},{"type":"text","text":" "},{"type":"text","text":"sequences, so the iteration stops at the end of "},{"type":"codeVoice","code":"alphabet"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["let alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"","let asciiTable = zip(65..., alphabet)","for (code, letter) in asciiTable {","    print(code, letter)","}","\/\/ \"65 A\"","\/\/ \"66 B\"","\/\/ \"67 C\"","\/\/ ...","\/\/ \"89 Y\"","\/\/ \"90 Z\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The behavior of incrementing indefinitely is determined by the type of"},{"type":"text","text":" "},{"type":"codeVoice","code":"Bound"},{"type":"text","text":". For example, iterating over an instance of"},{"type":"text","text":" "},{"type":"codeVoice","code":"PartialRangeFrom<Int>"},{"text":" traps when the sequence’s next value would be","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"above "},{"type":"codeVoice","code":"Int.max"},{"type":"text","text":"."}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom"},"references":{"doc://com.apple.Swift/documentation/Swift/Comparable":{"abstract":[{"type":"text","text":"A type that can be compared using the relational operators "},{"code":"<","type":"codeVoice"},{"text":", ","type":"text"},{"code":"<=","type":"codeVoice"},{"text":", ","type":"text"},{"code":">=","type":"codeVoice"},{"type":"text","text":","},{"type":"te