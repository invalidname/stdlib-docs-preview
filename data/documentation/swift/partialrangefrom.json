type":"text"},{"code":"Strideable","type":"codeVoice"},{"text":" protocol with an integer","type":"text"},{"text":" ","type":"text"},{"text":"stride, you can use that range in a ","type":"text"},{"code":"for","type":"codeVoice"},{"text":"-","type":"text"},{"code":"in","type":"codeVoice"},{"text":" loop or with any sequence","type":"text"},{"text":" ","type":"text"},{"text":"method that doesn’t require that the sequence is finite. The elements of","type":"text"},{"text":" ","type":"text"},{"text":"a partial range are the consecutive values from its lower bound continuing","type":"text"},{"text":" ","type":"text"},{"text":"upward indefinitely.","type":"text"}]},{"code":["func isTheMagicNumber(_ x: Int) -> Bool {","    return x == 3","}","","for x in 1... {","    if isTheMagicNumber(x) {","        print(\"\\(x) is the magic number!\")","        break","    } else {","        print(\"\\(x) wasn't it...\")","    }","}","\/\/ \"1 wasn't it...\"","\/\/ \"2 wasn't it...\"","\/\/ \"3 is the magic number!\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because a "},{"type":"codeVoice","code":"PartialRangeFrom"},{"type":"text","text":" sequence counts upward indefinitely, do not"},{"type":"text","text":" "},{"text":"use one with methods that read the entire sequence before returning, such","type":"text"},{"type":"text","text":" "},{"text":"as ","type":"text"},{"code":"map(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"filter(_:)","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"suffix(_:)","type":"codeVoice"},{"text":". It is safe to use operations","type":"text"},{"text":" ","type":"text"},{"text":"that put an upper limit on the number of elements they access, such as","type":"text"},{"text":" ","type":"text"},{"code":"prefix(_:)","type":"codeVoice"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"dropFirst(_:)"},{"type":"text","text":", and operations that you can guarantee"},{"type":"text","text":" "},{"type":"text","text":"will terminate, such as passing a closure you know will eventually return"},{"type":"text","text":" "},{"type":"codeVoice","code":"true"},{"type":"text","text":" to "},{"type":"codeVoice","code":"first(where:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the following example, the "},{"type":"codeVoice","code":"asciiTable"},{"type":"text","text":" sequence is made by zipping"},{"type":"text","text":" "},{"type":"text","text":"together the characters in the "},{"type":"codeVoice","code":"alphabet"},{"type":"text","text":" string with a partial range"},{"type":"text","text":" "},{"type":"text","text":"starting at 65, the ASCII value of the capital letter A. Iterating over"},{"type":"text","text":" "},{"type":"text","text":"two zipped sequences continues only as long as the shorter of the two"},{"type":"text","text":" "},{"type":"text","text":"sequences, so the iteration stops at the end of "},{"type":"codeVoice","code":"alphabet"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"","let asciiTable = zip(65..., alphabet)","for (code, letter) in asciiTable {","    print(code, letter)","}","\/\/ \"65 A\"","\/\/ \"66 B\"","\/\/ \"67 C\"","\/\/ ...","\/\/ \"89 Y\"","\/\/ \"90 Z\""]},{"type":"paragraph","inlineContent":[{"text":"The behavior of incrementing indefinitely is determined by the type of","type":"text"},{"text":" ","type":"text"},{"code":"Bound","type":"codeVoice"},{"text":". For example, iterating over an instance of","type":"text"},{"text":" ","type":"text"},{"code":"PartialRangeFrom<Int>","type":"codeVoice"},{"text":" traps when the sequence’s next value would be","type":"text"},{"text":" ","type":"text"},{"text":"above ","type":"text"},{"code":"Int.max","type":"codeVoice"},{"text":".","type":"text"}]}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"topicS