 use a partial range of a collection’s indices to represent the"},{"type":"text","text":" "},{"type":"text","text":"range from the partial range’s lower bound up to the end of the"},{"type":"text","text":" "},{"type":"text","text":"collection."}],"type":"paragraph"},{"code":["let numbers = [10, 20, 30, 40, 50, 60, 70]","print(numbers[3...])","\/\/ Prints \"[40, 50, 60, 70]\""],"type":"codeListing","syntax":"swift"},{"anchor":"Using-a-Partial-Range-as-a-Sequence","text":"Using a Partial Range as a Sequence","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When a partial range uses integers as its lower and upper bounds, or any"},{"type":"text","text":" "},{"type":"text","text":"other type that conforms to the "},{"type":"codeVoice","code":"Strideable"},{"type":"text","text":" protocol with an integer"},{"type":"text","text":" "},{"type":"text","text":"stride, you can use that range in a "},{"type":"codeVoice","code":"for"},{"type":"text","text":"-"},{"type":"codeVoice","code":"in"},{"type":"text","text":" loop or with any sequence"},{"type":"text","text":" "},{"type":"text","text":"method that doesn’t require that the sequence is finite. The elements of"},{"type":"text","text":" "},{"type":"text","text":"a partial range are the consecutive values from its lower bound continuing"},{"type":"text","text":" "},{"type":"text","text":"upward indefinitely."}],"type":"paragraph"},{"syntax":"swift","code":["func isTheMagicNumber(_ x: Int) -> Bool {","    return x == 3","}","","for x in 1... {","    if isTheMagicNumber(x) {","        print(\"\\(x) is the magic number!\")","        break","    } else {","        print(\"\\(x) wasn't it...\")","    }","}","\/\/ \"1 wasn't it...\"","\/\/ \"2 wasn't it...\"","\/\/ \"3 is the magic number!\""],"type":"codeListing"},{"inlineContent":[{"text":"Because a ","type":"text"},{"code":"PartialRangeFrom","type":"codeVoice"},{"type":"text","text":" sequence counts upward indefinitely, do not"},{"type":"text","text":" "},{"type":"text","text":"use one with methods that read the entire sequence before returning, such"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"map(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"filter(_:)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"suffix(_:)"},{"type":"text","text":". It is safe to use operations"},{"type":"text","text":" "},{"text":"that put an upper limit on the number of elements they access, such as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"prefix(_:)"},{"type":"text","text":" or "},{"code":"dropFirst(_:)","type":"codeVoice"},{"type":"text","text":", and operations that you can guarantee"},{"type":"text","text":" "},{"type":"text","text":"will terminate, such as passing a closure you know will eventually return"},{"type":"text","text":" "},{"code":"true","type":"codeVoice"},{"type":"text","text":" to "},{"code":"first(where:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the following example, the "},{"code":"asciiTable","type":"codeVoice"},{"type":"text","text":" sequence is made by zipping"},{"type":"text","text":" "},{"type":"text","text":"together the characters in the "},{"type":"codeVoice","code":"alphabet"},{"type":"text","text":" string with a partial range"},{"type":"text","text":" "},{"type":"text","text":"starting at 65, the ASCII value of the capital letter A. Iterating over"},{"type":"text","text":" "},{"type":"text","text":"two zipped sequences continues only as long as the shorter of the two"},{"type":"text","text":" "},{"type":"text","text":"sequences, so the iteration stops at the end of "},{"type":"codeVoice","code":"alphabet"},{"type":"text","text":"."}]},{"syntax":"swift","code":["let alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"","let asciiTable = zip(65..., alphabet)","for (code, letter) in asciiTable {","    print(code, letter)","}","\/\/ \"65 A\"","\/\/ \"66 B\"","\/\/ \"67 C\"","\/\/ ...","\/\/ \"89 Y\"","\/\/ \"90 Z\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The behavior of incrementing indefinitely is determined by the type of"},{"type":"text","text":" "},{"type":"codeVoice","code":"Bound"},{"type":"text","text":". For example, iterating over an instance of"},{"type":"text","text":" "},{"type":"codeVoice","code":"PartialRangeFrom<Int>"},{"type":"text","text":" traps when the sequence’s next value would be"},{"type":"text","text":" "},{"type":"text","text":"above "},{"type":"codeVoice","code":"Int.max"},{"type":"text","text":"."}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom\/init(_:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom\/lowerBound"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom\/Decodable-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom\/Encodable-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom\/RangeExpression-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom\/Sequence-Implementations"]}],"references":{"doc://com.apple.Swift/documentation/Swift/ConvertibleToBytes":{"url":"\/documentation\/swift\/convertibletobytes","navigatorTitle":[{"kind":"identifier","text":"ConvertibleToBytes"}],"kind":"symbol","conformance":{"constraints":[{"type":"