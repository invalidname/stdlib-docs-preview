{"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Decodable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Encodable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Escapable","doc:\/\/com.apple.Swift\/documentation\/Swift\/RangeExpression","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"],"type":"conformsTo"}],"metadata":{"role":"symbol","title":"PartialRangeFrom","symbolKind":"struct","navigatorTitle":[{"text":"PartialRangeFrom","kind":"identifier"}],"platforms":[{"name":"iOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"8.0"},{"name":"iPadOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"8.0"},{"name":"Mac Catalyst","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"13.0"},{"name":"macOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"10.10"},{"name":"tvOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"9.0"},{"name":"visionOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"1.0"},{"name":"watchOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"2.0"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PartialRangeFrom","kind":"identifier"}],"externalID":"s:s16PartialRangeFromV","modules":[{"name":"Swift"}],"roleHeading":"Structure"},"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom\/init(_:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom\/lowerBound"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom\/Decodable-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom\/Encodable-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom\/RangeExpression-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom\/Sequence-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PartialRangeFrom"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Bound"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Bound"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Comparable","preciseIdentifier":"s:SL"}]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You create "},{"type":"codeVoice","code":"PartialRangeFrom"},{"type":"text","text":" instances by using the postfix range operator"},{"type":"text","text":" "},{"type":"text","text":"(postfix "},{"type":"codeVoice","code":"..."},{"type":"text","text":")."}]},{"type":"codeListing","syntax":"swift","code":["let atLeastFive = 5..."]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use a partial range to quickly check if a value is contained in a"},{"type":"text","text":" "},{"type":"text","text":"particular range of values. For example:"}]},{"type":"codeListing","syntax":"swift","code":["atLeastFive.contains(4)","\/\/ false","atLeastFive.contains(5)","\/\/ true","atLeastFive.contains(6)","\/\/ true"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use a partial range of a collection’s indices to represent the"},{"type":"text","text":" "},{"type":"text","text":"range from the partial range’s lower bound up to the end of the"},{"type":"text","text":" "},{"type":"text","text":"collection."}]},{"type":"codeListing","syntax":"swift","code":["let numbers = [10, 20, 30, 40, 50, 60, 70]","print(numbers[3...])","\/\/ Prints \"[40, 50, 60, 70]\""]},{"type":"heading","level":2,"text":"Using a Partial Range as a Sequence","anchor":"Using-a-Partial-Range-as-a-Sequence"},{"type":"paragraph","inlineContent":[{"text":"When a partial range uses integers as its lower and upper bounds, or any","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"other type that conforms to the "},{"type":"codeVoice","code":"Strideable"},{"type":"text","text":" protocol with an integer"},{"text":" ","type":"text"},{"text":"stride, you can use that range in a ","type":"text"},{"code":"for","type":"codeVoice"},{"text":"-","type":"text"},{"code":"in","type":"codeVoice"},{"text":" loop or with any sequence","type":"text"},{"text":" ","type":"text"},{"text":"method that doesn’t require that the sequence is finite. The elements of","type":"text"},{"text":" ","type":"text"},{"text":"a partial range are the consecutive values from its lower bound continuing","type":"text"},{"text":" ","type":"text"},{"text":"upward indefinitely.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func isTheMagicNumber(_ x: Int) -> Bool {","    return x == 3","}","","for x in 1... {","    if isTheMagicNumber(x) {","        print(\"\\(x) is the magic number!\")","        break","    } else {","        print(\"\\(x) wasn't it...\")","    }","}","\/\/ \"1 wasn't it...\"","\/\/ \"2 wasn't it...\"","\/\/ \"3 is the magic number!\""]},{"type":"paragraph","inlineContent":[{"text":"Because a ","type":"text"},{"type":"codeVoice","code":"PartialRangeFrom"},{"text":" sequence counts upward indefinitely, do not","type":"text"},{"text":" ","type":"text"},{"text":"use one with methods that read the entire sequence before returning, such","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"type":"codeVoice","code":"map(_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"filter(_:)"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"suffix(_:)"},{"text":". It is safe to use operations","type":"text"},{"text":" ","type":"text"},{"text":"that put an upper limit on the number of elements they access, such as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"prefix(_:)"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"dropFirst(_:)"},{"text":", and operations that you can guarantee","type":"text"},{"type":"text","text":" "},{"type":"text","text":"will terminate, such as passing a closure you know will eventually return"},{"type":"text","text":" "},{"type":"codeVoice","code":"true"},{"type":"text","text":" to "},{"type":"codeVoice","code":"first(where:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the following example, the "},{"type":"codeVoice","code":"asciiTable"},{"type":"text","text":" sequence is made by zipping"},{"type":"text","text":" "},{"type":"text","text":"together the characters in the "},{"type":"codeVoice","code":"alphabet"},{"type":"text","text":" string with a partial range"},{"type":"text","text":" "},{"type":"text","text":"starting at 65, the ASCII value of the capital letter A. Iterating over"},{"type":"text","text":" "},{"type":"text","text":"two zipped sequences continues only as long as the shorter of the two"},{"type":"text","text":" "},{"type":"text","text":"sequences, so the iteration stops at the end of "},{"type":"codeVoice","code":"alphabet"},{"type":"text","text":"."}]},{"type":"codeListing","code":["let alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"","let asciiTable = zip(65..., alphabet)","for (code, letter) in asciiTable {","    print(code, letter)","}","\/\/ \"65 A\"","\/\/ \"66 B\"","\/\/ \"67 C\"","\/\/ ...","\/\/ \"89 Y\"","\/\/ \"90 Z\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The behavior of incrementing indefinitely is determined by the type of"},{"type":"text","text":" "},{"type":"codeVoice","code":"Bound"},{"type":"text","text":". For example, iterating over an instance of"},{"type":"text","text":" "},{"type":"codeVoice","code":"PartialRangeFrom<Int>"},{"type":"text","text":" traps when the sequence’s next value would be"},{"type":"text","text":" "},{"text":"above ","type":"text"},{"type":"codeVoice","code":"Int.max"},{"type":"text","text":"."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/partialrangefrom"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"abstract":[{"text":"A partial interval extending upward from a lower bound.","type":"text"}],"seeAlsoSections":[{"generated":true,"title":"Range Expressions","anchor":"Range-Expressions","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeUpTo","doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeThrough","doc:\/\/com.apple.Swift\/documentation\/Swift\/RangeExpression","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnboundedRange_"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/Escapable":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Escapable","title":"Escapable","navigatorTitle":[{"kind":"identifier","text":"Escapable"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Bound"},{"type":"text","text":" conforms to "},{"type