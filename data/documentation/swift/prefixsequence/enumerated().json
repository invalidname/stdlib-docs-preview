eratedSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnumeratedSequence","kind":"identifier"}],"abstract":[{"type":"text","text":"An enumeration of the elements of a sequence or collection."}]},"doc://com.apple.Swift/documentation/Swift/PrefixSequence":{"url":"\/documentation\/swift\/prefixsequence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PrefixSequence"}],"kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/PrefixSequence","title":"PrefixSequence","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PrefixSequence"}],"abstract":[{"type":"text","text":"A sequence that only consumes up to "},{"type":"codeVoice","code":"n"},{"type":"text","text":" elements from an underlying"},{"type":"text","text":" "},{"type":"codeVoice","code":"Base"},{"type":"text","text":" iterator."}],"type":"topic"}}}