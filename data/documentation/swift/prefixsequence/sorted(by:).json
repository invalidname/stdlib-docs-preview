":"true","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","title":"Bool","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Bool"}]},"doc://com.apple.Swift/documentation/Swift/PrefixSequence/sorted(by:)":{"kind":"symbol","abstract":[{"type":"text","text":"Returns the elements of the sequence, sorted using the given predicate as"},{"type":"text","text":" "},{"type":"text","text":"the comparison between elements."}],"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sorted","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":", ","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":"]","kind":"text"}],"url":"\/documentation\/swift\/prefixsequence\/sorted(by:)","title":"sorted(by:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/PrefixSequence\/sorted(by:)"},"doc://com.apple.Swift/documentation/Swift/Sequence/Element":{"abstract":[{"text":"A type representing the sequence’s elements.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"url":"\/documentation\/swift\/sequence\/element","title":"Element","requir