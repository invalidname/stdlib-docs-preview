{"metadata":{"platforms":[{"beta":false,"unavailable":false,"deprecated":false,"name":"iOS","introducedAt":"8.0"},{"beta":false,"unavailable":false,"deprecated":false,"introducedAt":"8.0","name":"iPadOS"},{"beta":false,"unavailable":false,"deprecated":false,"introducedAt":"13.0","name":"Mac Catalyst"},{"beta":false,"unavailable":false,"deprecated":false,"name":"macOS","introducedAt":"10.10"},{"beta":false,"unavailable":false,"deprecated":false,"name":"tvOS","introducedAt":"9.0"},{"beta":false,"unavailable":false,"deprecated":false,"name":"visionOS","introducedAt":"1.0"},{"beta":false,"unavailable":false,"deprecated":false,"name":"watchOS","introducedAt":"2.0"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"identifier"}],"roleHeading":"Protocol","title":"RandomNumberGenerator","externalID":"s:SG","navigatorTitle":[{"text":"RandomNumberGenerator","kind":"identifier"}],"role":"symbol","symbolKind":"protocol","modules":[{"name":"Standard Library"}]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you call methods that use random data, such as creating new random"},{"type":"text","text":" "},{"type":"text","text":"values or shuffling a collection, you can pass a "},{"type":"codeVoice","code":"RandomNumberGenerator"},{"type":"text","text":" "},{"type":"text","text":"type to be used as the source for randomness. When you don’t pass a"},{"type":"text","text":" "},{"type":"text","text":"generator, the default "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":" type is used."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When providing new APIs that use randomness, provide a version that accepts"},{"type":"text","text":" "},{"type":"text","text":"a generator conforming to the "},{"type":"codeVoice","code":"RandomNumberGenerator"},{"type":"text","text":" protocol as well as a"},{"type":"text","text":" "},{"type":"text","text":"version that uses the default system generator. For example, this "},{"type":"codeVoice","code":"Weekday"},{"type":"text","text":" "},{"type":"text","text":"enumeration provides static methods that return a random day of the week:"}]},{"syntax":"swift","type":"codeListing","code":["enum Weekday: CaseIterable {","    case sunday, monday, tuesday, wednesday, thursday, friday, saturday","","    static func random<G: RandomNumberGenerator>(using generator: inout G) -> Weekday {","        return Weekday.allCases.randomElement(using: &generator)!","    }","","    static func random() -> Weekday {","        var g = SystemRandomNumberGenerator()","        return Weekday.random(using: &g)","    }","}"]},{"type":"heading","anchor":"Conforming-to-the-RandomNumberGenerator-Protocol","text":"Conforming to the RandomNumberGenerator Protocol","level":1},{"inlineContent":[{"type":"text","text":"A custom "},{"type":"codeVoice","code":"RandomNumberGenerator"},{"type":"text","text":" type can have different characteristics"},{"type":"text","text":" "},{"type":"text","text":"than the default "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":" type. For example, a"},{"type":"text","text":" "},{"type":"text","text":"seedable generator can be used to generate a repeatable sequence of random"},{"type":"text","text":" "},{"type":"text","text":"values for testing purposes."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To make a custom type conform to the "},{"type":"codeVoice","code":"RandomNumberGenerator"},{"type":"text","text":" protocol,"},{"type":"text","text":" "},{"type":"text","text":"implement the required "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" method. Each call to "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" must produce"},{"type":"text","text":" "},{"type":"text","text":"a uniform and independent random value."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Types that conform to "},{"type":"codeVoice","code":"RandomNumberGenerator"},{"type":"text","text":" should specifically document"},{"type":"text","text":" "},{"type":"text","text":"the thread safety and quality of the generator."}]}],"kind":"content"}],"relationshipsSections":[{"type":"conformingTypes","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/SystemRandomNumberGenerator"],"kind":"relationships","title":"Conforming Types"}],"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomNumberGenerator","interfaceLanguage":"swift"},"topicSections":[{"title":"Generating Random Binary Data","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomNumberGenerator\/next()","doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomNumberGenerator\/next(upperBound:)"],"anchor":"Generating-Random-Binary-Data"}],"abstract":[{"type":"text","text":"A type that provides uniformly distributed random data."}],"seeAlsoSections":[{"generated":true,"title":"Random Number Generators","anchor":"Random-Number-Generators","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/SystemRandomNumberGenerator"]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"variants":[{"paths":["\/documentation\/swift\/randomnumbergenerator"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/RandomNumberGenerator":{"url":"\/documentation\/swift\/randomnumbergenerator","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RandomNumberGenerator"}],"kin