tion\/Swift\/SystemRandomNumberGenerator"],"title":"Random Number Generators","generated":true,"anchor":"Random-Number-Generators"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RandomNumberGenerator"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you call methods that use random data, such as creating new random"},{"type":"text","text":" "},{"type":"text","text":"values or shuffling a collection, you can pass a "},{"type":"codeVoice","code":"RandomNumberGenerator"},{"type":"text","text":" "},{"type":"text","text":"type to be used as the source for randomness. When you don’t pass a"},{"type":"text","text":" "},{"type":"text","text":"generator, the default "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":" type is used."}]},{"inlineContent":[{"type":"text","text":"When providing new APIs that use randomness, provide a version that accepts"},{"type":"text","text":" "},{"type":"text","text":"a generator conforming to the "},{"type":"codeVoice","code":"RandomNumberGenerator"},{"type":"text","text":" protocol as well as a"},{"type":"text","text":" "},{"type":"text","text":"version that uses the default system generator. For example, this "},{"type":"codeVoice","code":"Weekday"},{"type":"text","text":" "},{"type":"text","text":"enumeration provides static methods that return a random day of the week:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["enum Weekday: CaseIterable {","    case sunday, monday, tuesday, wednesday, thursday, friday, saturday","","    static func random<G: RandomNumberGenerator>(using generator: inout G) -> Weekday {","        return Weekday.allCases.randomElement(using: &generator)!","    }","","    static func random() -> Weekday {","        var g = SystemRandomNumberGenerator()","        return Weekday.random(using: &g)","    }","}"]},{"type":"heading","level":1,"text":"Conforming to the RandomNumberGenerator Protocol","anchor":"Conforming-to-the-RandomNumberGenerator-Protocol"},{"inlineContent":[{"type":"text","text":"A custom "},{"type":"codeVoice","code":"RandomNumberGenerator"},{"type":"text","text":" type can have different characteristics"},{"type":"text","text":" "},{"type":"text","text":"than the default "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":" type. For example, a"},{"type":"text","text":" "},{"type":"text","text":"seedable generator can be used to generate a repeatable sequence of random"},{"type":"text","text":" "},{"type":"text","text":"values for testing purposes."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To make a custom type conform to the "},{"type":"codeVoice","code":"RandomNumberGenerator"},{"type":"text","text":" protocol,"},{"type":"text","text":" "},{"type":"text","text":"implement the required "},{"code":"next()","type":"codeVoice"},{"type":"text","text":" method. Each call to "},{"code":"next()","type":"codeVoice"},{"type":"text","text":" must produce"},{"type":"text","text":" "},{"type":"text","text":"a uniform and independent random value."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Types that conform to "},{"type":"codeVoice","code":"RandomNumberGenerator"},{"type":"text","text":" should specifically document"},{"type":"text","text":" "},{"type":"text","text":"the thread safety and quality of the generator."}]}]}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift":{"type":"topic","kind":"symbol","url":"\/documentation\/swift","role":"collection","title":"Swift","identifier":"doc:\/\/com.apple.Swift\