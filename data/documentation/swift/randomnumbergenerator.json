{"topicSections":[{"anchor":"Generating-Random-Binary-Data","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomNumberGenerator\/next()","doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomNumberGenerator\/next(upperBound:)"],"title":"Generating Random Binary Data"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"When you call methods that use random data, such as creating new random"},{"type":"text","text":" "},{"type":"text","text":"values or shuffling a collection, you can pass a "},{"code":"RandomNumberGenerator","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"type to be used as the source for randomness. When you don’t pass a"},{"type":"text","text":" "},{"type":"text","text":"generator, the default "},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"type":"text","text":" type is used."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When providing new APIs that use randomness, provide a version that accepts"},{"type":"text","text":" "},{"type":"text","text":"a generator conforming to the "},{"type":"codeVoice","code":"RandomNumberGenerator"},{"type":"text","text":" protocol as well as a"},{"type":"text","text":" "},{"type":"text","text":"version that uses the default system generator. For example, this "},{"type":"codeVoice","code":"Weekday"},{"type":"text","text":" "},{"type":"text","text":"enumeration provides static methods that return a random day of the week:"}]},{"code":["enum Weekday: CaseIterable {","    case sunday, monday, tuesday, wednesday, thursday, friday, saturday","","    static func random<G: RandomNumberGenerator>(using generator: inout G) -> Weekday {","        return Weekday.allCases.randomElement(using: &generator)!","    }","","    static func random() -> Weekday {","        var g = SystemRandomNumberGenerator()","        return Weekday.random(using: &g)","    }","}"],"type":"codeListing","syntax":"swift"},{"level":1,"anchor":"Conforming-to-the-RandomNumberGenerator-Protocol","text":"Conforming to the RandomNumberGenerator Protocol","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A custom "},{"type":"codeVoice","code":"RandomNumberGenerator"},{"type":"text","text":" type can have different characteristics"},{"type":"text","text":" "},{"type":"text","text":"than the default "},{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":" type. For example, a"},{"type":"text","text":" "},{"type":"text","text":"seedable generator can be used to generate a repeatable sequence of random"},{"type":"text","text":" "},{"type":"text","text":"values for testing purposes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To make a custom type conform to the "},{"type":"codeVoice","code":"RandomNumberGenerator"},{"text":" protocol,","type":"text"},{"text":" ","type":"text"},{"text":"implement the required ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" method. Each call to ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" must produce","type":"text"},{"text":" ","type":"text"},{"text":"a uniform and independent random value.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Types that conform to "},{"type":"codeVoice","code":"RandomNumberGenerator"},{"type":"text","text":" should specifically document"},{"type":"text","text":" "},{"type":"text","text":"the thread safety and quality of the generator."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomNum