{"metadata":{"roleHeading":"Protocol","modules":[{"name":"Swift"}],"role":"symbol","title":"RandomNumberGenerator","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RandomNumberGenerator"}],"symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"RandomNumberGenerator"}],"externalID":"s:SG","platforms":[{"introducedAt":"8.0","beta":false,"name":"iOS","deprecated":false,"unavailable":false},{"introducedAt":"8.0","beta":false,"name":"iPadOS","deprecated":false,"unavailable":false},{"introducedAt":"13.0","beta":false,"name":"Mac Catalyst","deprecated":false,"unavailable":false},{"introducedAt":"10.10","beta":false,"name":"macOS","deprecated":false,"unavailable":false},{"introducedAt":"9.0","beta":false,"name":"tvOS","deprecated":false,"unavailable":false},{"introducedAt":"1.0","beta":false,"name":"visionOS","deprecated":false,"unavailable":false},{"introducedAt":"2.0","beta":false,"name":"watchOS","deprecated":false,"unavailable":false}]},"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomNumberGenerator","interfaceLanguage":"swift"},"abstract":[{"text":"A type that provides uniformly distributed random data.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"When you call methods that use random data, such as creating new random","type":"text"},{"text":" ","type":"text"},{"text":"values or shuffling a collection, you can pass a ","type":"text"},{"code":"RandomNumberGenerator","type":"codeVoice"},{"text":" ","type":"text"},{"text":"type to be used as the source for randomness. When you don’t pass a","type":"text"},{"text":" ","type":"text"},{"text":"generator, the default ","type":"text"},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"text":" type is used.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When providing new APIs that use randomness, provide a version that accepts","type":"text"},{"text":" ","type":"text"},{"text":"a generator conforming to the ","type":"text"},{"code":"RandomNumberGenerator","type":"codeVoice"},{"text":" protocol as well as a","type":"text"},{"text":" ","type":"text"},{"text":"version that uses the default system generator. For example, this ","type":"text"},{"code":"Weekday","type":"codeVoice"},{"text":" ","type":"text"},{"text":"enumeration provides static methods that return a random day of the week:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["enum Weekday: CaseIterable {","    case sunday, monday, tuesday, wednesday, thursday, friday, saturday","","    static func random<G: RandomNumberGenerator>(using generator: inout G) -> Weekday {","        return Weekday.allCases.randomElement(using: &generator)!","    }","","    static func random() -> Weekday {","        var g = SystemRandomNumberGenerator()","        return Weekday.random(using: &g)","    }","}"],"type":"codeListing"},{"level":1,"text":"Conforming to the RandomNumberGenerator Protocol","anchor":"Conforming-to-the-RandomNumberGenerator-Protocol","type":"heading"},{"inlineContent":[{"text":"A custom ","type":"text"},{"code":"RandomNumberGenerator","type":"codeVoice"},{"text":" type can have different characteristics","type":"text"},{"text":" ","type":"text"},{"text":"than the default ","type":"text"},{"code":"SystemRandomNumberGenerator","type":"codeVoice"},{"text":" type. For example, a","type":"text"},{"text":" ","type":"text"},{"text":"seedable generator can be used to generate a repeatable sequence of random","type":"text"},{"text":" ","type":"text"},{"text":"values for testing purposes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To make a custom type conform to the ","type":"text"},{"code":"RandomNumberGenerator","type":"codeVoice"},{"text":" protocol,","type":"text"},{"text":" ","type":"text"},{"text":"implement the required ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" method. Each call to ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" must produce","type":"text"},{"text":" ","type":"text"},{"text":"a uniform and independent random value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Types that conform to ","type":"text"},{"code":"RandomNumberGenerator","type":"codeVoice"},{"text":" should specifically document","type":"text"},{"text":" ","type":"text"},{"text":"the thread safety and quality of the generator.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/randomnumbergenerator"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/SystemRandomNumberGenerator"],"generated":true,"title":"Random Number Generators","anchor":"Random-Number-Generators"}],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/StdlibUnittest\/LinearCongruentialGenerator","doc:\/\/com.apple.Swift\/documentation\/Swift\/SystemRandomNumberGenerator"],"kind":"relationships","title":"Conforming Types","type":"conformingTypes"}],"topicSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomNumberGenerator\/next()","doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomNumberGenerator\/next(upperBound:)"],"title":"Generating Random Binary Data","anchor":"Generating-Random-Binary-Data"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"references":{"Swift-PageImage-card.png":{"identifier":"Swift-PageImage-card.png","variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","light"]},{"url":"\/im