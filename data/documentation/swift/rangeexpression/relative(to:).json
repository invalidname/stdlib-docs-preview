 "},{"type":"codeVoice","code":"4"},{"type":"text","text":" into a half-open range,"},{"type":"text","text":" "},{"type":"text","text":"using an array instance to add the range’s lower bound."}],"type":"paragraph"},{"syntax":"swift","code":["let numbers = [10, 20, 30, 40, 50, 60, 70]","let upToFour = ..<4","","let r1 = upToFour.relative(to: numbers)","\/\/ r1 == 0..<4"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"r1"},{"type":"text","text":" range is bounded on the lower end by "},{"type":"codeVoice","code":"0"},{"type":"text","text":" because that is the"},{"type":"text","text":" "},{"type":"text","text":"starting index of the "},{"type":"codeVoice","code":"numbers"},{"type":"text","text":" array. When the collection passed to"},{"type":"text","text":" "},{"type":"codeVoice","code":"relative(to:)"},{"type":"text","text":" starts with a different index, that index is used as the"},{"type":"text","text":" "},{"type":"text","text":"lower bound instead. The next example creates a slice of "},{"type":"codeVoice","code":"numbers"},{"type":"text","text":" "},{"type":"text","text":"starting at index "},{"type":"codeVoice","code":"2"},{"type":"text","text":", and then uses the slice with "},{"type":"codeVoice","code":"relative(to:)"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"convert "},{"type":"codeVoice","code":"upToFour"},{"type":"text","text":" to a concrete range."}],"type":"paragraph"},{"syntax":"swift","code":["let numbersSuffix = numbers[2...]","\/\/ numbersSuffix == [30, 40, 50, 60, 70]","","let r2 = upToFour.relative(to: numbersSuffix)","\/\/ r2 == 2..<4"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use this method only if you need the concrete range it produces. To"},{"type":"text","text":" "},{"type":"text","text":"access a slice of a collection using a range expression, use the"},{"type":"text","text":" "},{"type":"text","text":"collection’s generic subscript that uses a range expression as its"},{"type":"text","text":" "},{"type":"text","text":"parameter."}],"type":"paragraph"},{"syntax":"swift","code":["let numbersPrefix = numbers[upToFour]","\/\/ numbersPrefix == [10, 20, 30, 40]"],"type":"codeListing"}]}],"metadata":{"required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"relative","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","preciseIdentifier":"s:SX8relative2toSny5BoundQzGqd___tSlRd__5IndexQyd__ADRSlF1CL_qd__mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Range","preciseIdentifier":"s:Sn","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Bound","preciseIdentifier":"s:SX5BoundQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"symbolKind":"method","roleHeading":"Instance Method","modules":[{"name":"Swift"}],"role":"symbol","platforms":[{"name":"iOS","deprecated":false,"introducedAt":"8.0","unavailable":false,"beta":false},{"name":"iPadOS","deprecated":false,"introducedAt":"8.0","unavailable":false,"beta":false},{"name":"Mac Catalyst","deprecated":false,"introducedAt":"13.0","unavailable":false,"beta":false},{"name":"macOS","deprecated":false,"introducedAt":"10.10","unavailable":false,"beta":false},{"name":"tvOS","deprecated":false,"introducedAt":"9.0","unavailable":false,"beta":false},{"name":"visionOS","deprecated":false,"introducedAt":"1.0","unavailable":false,"beta":false},{"name":"watchOS","deprecated":false,"introducedAt":"2.0","unavailable":false,"beta":false}],"title":"relative(to:)","externalID":"s:SX8relative2toSny5BoundQzGqd___tSlRd__5IndexQyd__ADRSlF"},"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/Collection":{"title":"Collection","abstract":[{"type":"text","text":"A sequence whose elements can be traversed multiple times,"},{"type":"text","text":" 