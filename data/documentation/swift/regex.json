atch.2)\")","}","\/\/ Key: color","\/\/ Value: 161 103 230"],"type":"codeListing"},{"inlineContent":[{"text":"When you import the ","type":"text"},{"code":"RegexBuilder","type":"codeVoice"},{"text":" module, you can also create ","type":"text"},{"code":"Regex","type":"codeVoice"},{"text":" ","type":"text"},{"text":"instances using a clear and flexible declarative syntax. Using this","type":"text"},{"text":" ","type":"text"},{"text":"style, you can combine, capture, and transform regexes, ","type":"text"},{"type":"codeVoice","code":"RegexBuilder"},{"type":"text","text":" "},{"type":"text","text":"types, and custom parsers."}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"Prior to Swift 6,"},{"type":"text","text":" "},{"type":"text","text":"you might need to write "},{"type":"codeVoice","code":"#\/myregex\/#"},{"type":"text","text":" instead of "},{"type":"codeVoice","code":"\/myregex\/"},{"text":" ","type":"text"},{"text":"when you make a regular expression using a literal.","type":"text"},{"type":"text","text":" "},{"text":"For more information,","type":"text"},{"text":" ","type":"text"},{"text":"see ","type":"text"},{"identifier":"https:\/\/docs.swift.org\/swift-book\/documentation\/the-swift-programming-language\/lexicalstructure\/#Regular-Expression-Literals","isActive":true,"type":"reference"},{"text":" in  ","type":"text"},{"inlineContent":[{"isActive":true,"identifier":"https:\/\/docs.swift.org\/swift-book\/","type":"reference"}],"type":"emphasis"},{"text":".","type":"text"}]}],"style":"note","type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/regex"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"abstract":[{"type":"text","text":"A regular expression."}],"seeAlsoSections":[{"title":"Regular Expressions","identifiers":["doc:\/\/com.apple.Swift\/documen