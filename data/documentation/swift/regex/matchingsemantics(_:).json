{"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"matchingSemantics","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"semanticLevel","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"RegexSemanticLevel","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexSemanticLevel","kind":"typeIdentifier","preciseIdentifier":"s:17_StringProcessing18RegexSemanticLevelV"},{"text":") -> ","kind":"text"},{"text":"Regex","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Regex","kind":"typeIdentifier","preciseIdentifier":"s:17_StringProcessing5RegexV"},{"text":"<","kind":"text"},{"text":"RegexOutput","kind":"typeIdentifier","preciseIdentifier":"s:17_StringProcessing5RegexV0C6Outputa"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"name":"semanticLevel","content":[{"type":"paragraph","inlineContent":[{"text":"The semantics to use during matching.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"inlineContent":[{"text":"The modified regular expression.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"When matching with grapheme cluster semantics (the default),","type":"text"},{"text":" ","type":"text"},{"text":"metacharacters like ","type":"text"},{"type":"codeVoice","code":"."},{"text":" and ","type":"text"},{"type":"codeVoice","code":"\\w"},{"text":", custom character classes, and character","type":"text"},{"text":" ","type":"text"},{"text":"class instances like ","type":"text"},{"code":".any","type":"codeVoice"},{"text":" match a grapheme cluster when possible,","type":"text"},{"text":" ","type":"text"},{"text":"corresponding with the default string representation. In addition,","type":"text"},{"text":" ","type":"text"},{"text":"matching with grapheme cluster semantics compares characters using their","type":"text"},{"text":" ","type":"text"},{"text":"canonical representation, corresponding with how strings comparison works.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When matching with Unicode scalar semantics, metacharacters and character"},{"type":"text","text":" "},{"text":"classes always match a single Unicode scalar value, even if that scalar","type":"text"},{"text":" ","type":"text"},{"text":"comprises part of a grapheme cluster.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"These semantic levels can lead to different results, especially when","type":"text"},{"text":" ","type":"text"},{"text":"working with strings that have decomposed characters. In the following","type":"text"},{"text":" ","type":"text"},{"text":"example, ","type":"text"},{"code":"queRegex","type":"codeVoice"},{"text":" matches any 3-character string that begins with ","type":"text"},{"code":"\"q\"","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let composed = \"qué\"","let decomposed = \"que\\u{301}\"","","let queRegex = \/^q..$\/","","print(composed.contains(queRegex))","\/\/ Prints \"true\"","print(decomposed.contains(queRegex))","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"text":"When using Unicode scalar semantics, however, the regular expression only","type":"text"},{"text":" ","type":"text"},{"text":"matches the composed version of the string, because each ","type":"text"},{"code":".","type":"codeVoice"},{"text":" matches a","type":"text"},{"text":" ","type":"text"},{"text":"single Unicode scalar value.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let queRegexScalar = queRegex.matchingSemantics(.unicodeScalar)","print(composed.contains(queRegexScalar))","\/\/ Prints \"true\"","print(decomposed.contains(queRegexScalar))","\/\/ Prints \"false\""],"type":"codeListing"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Regex"]]},"metadata":{"modules":[{"relatedModules":[],"name":"Swift"}],"title":"matchingSemantics(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"matchingSemantics","kind":"identifier"},{"text":"(","kind":"text"},{"text":"RegexSemanticLevel","preciseIdentifier":"s:17_StringProcessing18RegexSemanticLevelV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Regex","preciseIdentifier":"s:17_StringProcessing5RegexV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:17_StringProcessing5RegexV0C6Outputa","text":"RegexOutput","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","externalID":"s:17_StringProcessing5RegexV17matchingSemanticsyACyxGAA0C13SemanticLevelVF","platforms":[{"introducedAt":"8.0","name":"iOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"8.0","name":"iPadOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"13.0","name":"Mac Catalyst","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"10.10","name":"macOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"9.0","name":"tvOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"1.0","name":"visionOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"2.0","name":"watchOS","deprecated":false,"unavailable":false,"beta":false}],"extendedModule":"_StringProcessing","roleHeading":"Instance Method","symbolKind":"method"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/regex\/matchingsemantics(_:)"]}],"abstract":[{"text":"Returns a regular expression that matches with t