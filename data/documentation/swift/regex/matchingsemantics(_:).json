{"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Regex"]]},"abstract":[{"text":"Returns a regular expression that matches with the specified semantic","type":"text"},{"text":" ","type":"text"},{"text":"level.","type":"text"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Regex\/matchingSemantics(_:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"matchingSemantics"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"semanticLevel"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"RegexSemanticLevel","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexSemanticLevel","preciseIdentifier":"s:17_StringProcessing18RegexSemanticLevelV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Regex","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Regex","preciseIdentifier":"s:17_StringProcessing5RegexV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"RegexOutput","preciseIdentifier":"s:17_StringProcessing5RegexV0C6Outputa"},{"kind":"text","text":">"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"semanticLevel","content":[{"inlineContent":[{"text":"The semantics to use during matching.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The modified regular expression.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"When matching with grapheme cluster semantics (the default),","type":"text"},{"text":" ","type":"text"},{"text":"metacharacters like ","type":"text"},{"code":".","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"\\w","type":"codeVoice"},{"text":", custom character classes, and character","type":"text"},{"text":" ","type":"text"},{"text":"class instances like ","type":"text"},{"type":"codeVoice","code":".any"},{"text":" match a grapheme cluster when possible,","type":"text"},{"text":" ","type":"text"},{"text":"corresponding with the default string representation. In addition,","type":"text"},{"text":" ","type":"text"},{"text":"matching with grapheme cluster semantics compares characters using their","type":"text"},{"text":" ","type":"text"},{"text":"canonical representation, corresponding with how strings comparison works.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When matching with Unicode scalar semantics, metacharacters and character","type":"text"},{"text":" ","type":"text"},{"text":"classes always match a single Unicode scalar value, even if that scalar","type":"text"},{"type":"text","text":" "},{"type":"text","text":"comprises part of a grapheme cluster."}]},{"type":"paragraph","inlineContent":[{"text":"These semantic levels can lead to different results, especially when","type":"text"},{"text":" ","type":"text"},{"text":"working with strings that have decomposed characters. In the following","type":"text"},{"text":" ","type":"text"},{"text":"example, ","type":"text"},{"type":"codeVoice","code":"queRegex"},{"text":" matches any 3-character string that begins with ","type":"text"},{"code":"\"q\"","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let composed = \"qué\"","let decomposed = \"que\\u{301}\"","","let queRegex = \/^q..$\/","","print(composed.contains(queRegex))","\/\/ Prints \"true\"","print(decomposed.contains(queRegex))","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"text":"When using Unicode scalar semantics, however, the regular expression only","type":"text"},{"text":" ","type":"text"},{"text":"matches the composed version of the string, because each ","type":"text"},{"code":".","type":"codeVoice"},{"text":" matches a","type":"text"},{"text":" ","type":"text"},{"text":"single Unicode scalar value.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let queRegexScalar = queRegex.matchingSemantics(.unicodeScalar)","print(composed.contains(queRegexScalar))","\/\/ Prints \"true\"","print(decomposed.contains(queRegexScalar))","\/\/ Prints \"false\""]}],"kind":"content"}],"metadata":{"platforms":[{"deprecated":false,"unavailable":false,"introducedAt":"8.0","beta":false,"name":"iOS"},{"deprecated":false,"unavailable":false,"introducedAt":"8.0","beta":false,"name":"iPadOS"},{"deprecated":false,"name":"Mac Catalyst","introducedAt":"13.0","unavailable":false,"beta":false},{"name":"macOS","beta":false,"introducedAt":"10.10","deprecated":false,"unavailable":false},{"deprecated":false,"unavailable":false,"introducedAt":"9.0","beta":false,"name":"tvOS"},{"deprecated":false,"unavailable":false,"introducedAt":"1.0","beta":false,"name":"visionOS"},{"unavailable":false,"name":"watchOS","deprecated":false,"introducedAt":"2.0","beta":false}],"roleHeading":"Instance Method","externalID":"s:17_StringProcessing5RegexV17matchingSemanticsyACyxGAA0C13SemanticLevelVF","symbolKind":"method","title":"matchingSemantics(_:)","modules":[{"relatedModules":[],"name":"Swift"}],"extendedModule":"_StringProcessing","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"matchingSemantics","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:17_StringProcessing18RegexSemanticLevelV","text":"RegexSemanticLevel","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:17_StringProcessing5RegexV","text":"Regex","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:17_StringProcessing5RegexV0C6Outputa","text":"RegexOutput","kind":"typeId