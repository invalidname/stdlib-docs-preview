xSemanticLevel","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexSemanticLevel"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:17_StringProcessing5RegexV","kind":"typeIdentifier","text":"Regex","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Regex"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"RegexOutput","preciseIdentifier":"s:17_StringProcessing5RegexV0C6Outputa"},{"kind":"text","text":">"}]}]},{"kind":"parameters","parameters":[{"name":"semanticLevel","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The semantics to use during matching."}]}]}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modified regular expression."}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When matching with grapheme cluster semantics (the default),"},{"type":"text","text":" "},{"type":"text","text":"metacharacters like "},{"type":"codeVoice","code":"."},{"type":"text","text":" and "},{"type":"codeVoice","code":"\\w"},{"type":"text","text":", custom character classes, and character"},{"type":"text","text":" "},{"type":"text","text":"class instances like "},{"type":"codeVoice","code":".any"},{"type":"text","text":" match a grapheme cluster when possible,"},{"type":"text","text":" "},{"type":"text","text":"corresponding with the default string representation. In addition,"},{"type":"text","text":" "},{"type":"text","text":"matching with grapheme cluster semantics compares characters using their"},{"type":"text","text":" "},{"type":"text","text":"canonical representation, corresponding with how strings comparison works."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When matching with Unicode scalar semantics, metacharacters and character"},{"type":"text","text":" "},{"type":"text","text":"classes always match a single Unicode scalar value, even if that scalar"},{"type":"text","text":" "},{"type":"text","text":"comprises part of a grapheme cluster."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These semantic levels can lead to different results, especially when"},{"type":"text","text":" "},{"type":"text","text":"working with strings that have decomposed characters. In the following"},{"type":"text","text":" "},{"type":"text","text":"example, "},{"code":"queRegex","type":"codeVoice"},{"type":"text","text":" matches any 3-character string that begins with "},{"code":"\"q\"","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["let composed = \"qué\"","let decomposed = \"que\\u{301}\"","","let queRegex = \/^q..$\/","","print(composed.contains(queRegex))","\/\/ Prints \"true\"","print(decomposed.contains(queRegex))","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"When using Unicode scalar semantics, however, the regular expression only"},{"type":"text","text":" "},{"type":"text","text":"matches the composed version of the string, because each "},{"code":".","type":"codeVoice"},{"type":"text","text":" matches a"},{"type":"text","text":" "},{"type":"text","text":"single Unicode scalar value."}],"type":"paragraph"},{"syntax":"swift","code":["let queRegexScalar = queRegex.matchingSemantics(.unicodeScalar)","print(composed.contains(queRegexScalar))","\/\/ Prints \"true\"","print(decomposed.contains(queRegexScalar))","\/\/ Prints \"false\""],"type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Regex"]]},"abstract":[{"type":"text","text":"Returns a regular expression that matches with the specified semantic"},{"type":"text","text":" "},{"type":"text","text":"level."}],"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Regex\/matchingSema