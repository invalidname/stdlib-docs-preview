{"abstract":[{"type":"text","text":"Returns a regular expression that matches with the specified semantic"},{"type":"text","text":" "},{"type":"text","text":"level."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"matchingSemantics"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"semanticLevel"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"RegexSemanticLevel","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexSemanticLevel","preciseIdentifier":"s:17_StringProcessing18RegexSemanticLevelV"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Regex","kind":"typeIdentifier","text":"Regex","preciseIdentifier":"s:17_StringProcessing5RegexV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:17_StringProcessing5RegexV0C6Outputa","text":"RegexOutput"},{"kind":"text","text":">"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The semantics to use during matching.","type":"text"}],"type":"paragraph"}],"name":"semanticLevel"}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"inlineContent":[{"type":"text","text":"The modified regular expression."}],"type":"paragraph"}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"When matching with grapheme cluster semantics (the default),"},{"type":"text","text":" "},{"type":"text","text":"metacharacters like "},{"type":"codeVoice","code":"."},{"type":"text","text":" and "},{"type":"codeVoice","code":"\\w"},{"type":"text","text":", custom character classes, and character"},{"type":"text","text":" "},{"type":"text","text":"class instances like "},{"type":"codeVoice","code":".any"},{"type":"text","text":" match a grapheme cluster when possible,"},{"type":"text","text":" "},{"type":"text","text":"corresponding with the default string representation. In addition,"},{"type":"text","text":" "},{"type":"text","text":"matching with grapheme cluster semantics compares characters using their"},{"type":"text","text":" "},{"type":"text","text":"canonical representation, corresponding with how strings comparison works."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When matching with Unicode scalar semantics, metacharacters and character"},{"type":"text","text":" "},{"type":"text","text":"classes always match a single Unicode scalar value, even if that scalar"},{"type":"text","text":" "},{"type":"text","text":"comprises part of a grapheme cluster."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"These semantic levels can lead to different results, especially when"},{"type":"text","text":" "},{"type":"text","text":"working with strings that have decomposed characters. In the following"},{"type":"text","text":" "},{"type":"text","text":"example, "},{"type":"codeVoice","code":"queRegex"},{"type":"text","text":" matches any 3-character string that begins with "},{"type":"codeVoice","code":"\"q\""},{"type":"text","text":"."}]},{"code":["let composed = \"qué\"","let decomposed = \"que\\u{301}\"","","let queRegex = \/^q..$\/","","print(composed.contains(queRegex))","\/\/ Prints \"true\"","print(decomposed.contains(queRegex))","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When using Unicode scalar semantics, however, the regular expression only"},{"type":"text","text":" "},{"type":"text","text":"matches the composed version of the string, because each "},{"code":".","type":"codeVoice"},{"type":"text","text":" matches a"},{"type":"text","text":" "},{"type":"text","text":"single Unicode scalar value."}]},{"code":["let queRegexScalar = queRegex.matchingSemantics(.unicodeScalar)","print(composed.contains(queRegexScalar))","\/\/ Prints \"true\"","print(decomposed.contains(queRegexScalar))","\/\/ Prints \"false\""],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"metadata":{"modules":[{"name":"Swift","relatedModules":[]}],"externalID":"s:17_StringProcessing5RegexV17matchingSemanticsyACyxGAA0C13SemanticLevelVF","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"matchingSemantics"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:17_StringProcessing18RegexSemanticLevelV","text":"RegexSemanticLevel"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Regex","preciseIdentifier":"s:17_StringProcessing5RegexV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"RegexOutput","preciseIdentifier":"s:17_StringProcessing5RegexV0C6Outputa"},{"kind":"text","text":">"}],"title":"matchingSemantics(_:)","extendedModule":"_StringProcessing","symbolKind":"method","role":"symbol","platforms":[{"unavailable":false,"name":"iOS","deprecated":false,"introducedAt":"8.0","beta":false},{"unavailable":false,"name":"iPadOS","deprecated":false,"introducedAt":"8.0","beta":false},{"unavailable":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"13.0","beta":false},{"unavailable":false,"name":"macOS","deprecated":false,"introducedAt":"10.10","beta":false},{"unavailable":false,"name":"tvOS","deprecated":false,"introducedAt":"9.0","beta":false},{"unavailable":false,"name":"visionOS","deprecated":false,"introducedAt":"1.0","beta":false},{"unavailable":false,"name":"watchOS","deprecated":false,"introducedAt":"2.0","beta":false}]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Regex"]]},"kind":"symbol","identifier":{"url":"do