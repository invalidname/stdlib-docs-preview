{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Regex"]]},"abstract":[{"type":"text","text":"Returns a regular expression that matches with the specified semantic"},{"type":"text","text":" "},{"type":"text","text":"level."}],"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Regex\/matchingSemantics(_:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"matchingSemantics"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"semanticLevel"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17_StringProcessing18RegexSemanticLevelV","text":"RegexSemanticLevel","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexSemanticLevel"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:17_StringProcessing5RegexV","text":"Regex","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Regex"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"RegexOutput","preciseIdentifier":"s:17_StringProcessing5RegexV0C6Outputa"},{"kind":"text","text":">"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The semantics to use during matching."}]}],"name":"semanticLevel"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modified regular expression."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When matching with grapheme cluster semantics (the default),"},{"type":"text","text":" "},{"type":"text","text":"metacharacters like "},{"type":"codeVoice","code":"."},{"type":"text","text":" and "},{"type":"codeVoice","code":"\\w"},{"type":"text","text":", custom character classes, and character"},{"type":"text","text":" "},{"type":"text","text":"class instances like "},{"type":"codeVoice","code":".any"},{"type":"text","text":" match a grapheme cluster when possible,"},{"type":"text","text":" "},{"type":"text","text":"corresponding with the default string representation. In addition,"},{"type":"text","text":" "},{"type":"text","text":"matching with grapheme cluster semantics compares characters using their"},{"type":"text","text":" "},{"type":"text","text":"canonical representation, corresponding with how strings comparison works."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When matching with Unicode scalar semantics, metacharacters and character"},{"type":"text","text":" "},{"type":"text","text":"classes always match a single Unicode scalar value, even if that scalar"},{"type":"text","text":" "},{"type":"text","text":"comprises part of a grapheme cluster."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These semantic levels can lead to different results, especially when"},{"type":"text","text":" "},{"type":"text","text":"working with strings that have decomposed characters. In the following"},{"type":"text","text":" "},{"type":"text","text":"example, "},{"type":"codeVoice","code":"queRegex"},{"type":"text","text":" matches any 3-character string that begins with "},{"type":"codeVoice","code":"\"q\""},{"type":"text","text":"."}]},{"type":"codeListing","code":["let composed = \"qué\"","let decomposed = \"que\\u{301}\"","","let queRegex = \/^q..$\/","","print(composed.contains(queRegex))","\/\/ Prints \"true\"","print(decomposed.contains(queRegex))","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When using Unicode scalar semantics, however, the regular expression only"},{"type":"text","text":" "},{"type":"text","text":"matches the composed version of the string, because each "},{"type":"codeVoice","code":"."},{"type":"text","text":" matches a"},{"type":"text","text":" "},{"type":"text","text":"single Unicode scalar value."}]},{"type":"codeListing","code":["let queRegexScalar = queRegex.matchingSemantics(.unicodeScalar)","print(composed.contains(queRegexScalar))","\/\/ Prints \"true\"","print(decomposed.contains(queRegexScalar))","\/\/ Prints \"false\""],"syntax":"swift"}],"kind":"content"}],"metadata":{"roleHeading":"Instance Method","title":"matchingSemantics(_:)","externalID":"s:17_StringProcessing5RegexV17matchingSemanticsyACyxGAA0C13SemanticLevelVF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"matchingSemantics","kind":"identifier"},{"text":"(","kind":"text"},{"text":"RegexSemanticLevel","kind":"typeIdentifier","preciseIdentifier":"s:17_StringProcessing18RegexSemanticLevelV"},{"text":") -> ","kind":"text"},{"text":"Regex","kind":"typeIdentifier","preciseIdentifier":"s:17_StringProcessing5RegexV"},{"text":"<","kind":"text"},{"text":"RegexOutput","kind":"typeIdentifier","preciseIdentifier":"s:17_StringProcessing5RegexV0C6Outputa"},{"text":">","kind":"text"}],"role":"symbol","symbolKind":"method","extendedModule":"_StringProcessing","modules":[{"relatedModules":[],"name":"Swift"}],"platforms":[{"introducedAt":"8.0","deprecated":false,"name":"iOS","unavailable":false,"beta":false},{"introducedAt":"8.0","deprecated":false,"name":"iPadOS","unavailable":false,"beta":false},{"introducedAt":"13.0","deprecated":false,"name":"Mac Catalyst","unavailable":false,"beta":false},{"introducedAt":"10.10","deprecated":false,"name":"macOS","unavailable":false,"beta":false},{"introducedAt":"9.0","deprecated":false,"name":"tvOS","unavailable":false,"beta":false},{"introducedAt":"1.0","deprecated":false,"name":"visionOS","unavailable":false,"beta":false},{"intr