{"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Regular expressions, also known as regexes,","type":"text"},{"text":" ","type":"text"},{"text":"are a powerful tool for matching patterns in text.","type":"text"},{"text":" ","type":"text"},{"text":"Swift supports several ways to create a regular expression,","type":"text"},{"text":" ","type":"text"},{"text":"including from a string, as a literal, and using this DSL.","type":"text"},{"text":" ","type":"text"},{"text":"For example:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let word = OneOrMore(.word)","let emailPattern = Regex {","    Capture {","        ZeroOrMore {","            word","            \".\"","        }","        word","    }","    \"@\"","    Capture {","        word","        OneOrMore {","            \".\"","            word","        }","    }","}","","let text = \"My email is my.name@example.com.\"","if let match = text.firstMatch(of: emailPattern) {","    let (wholeMatch, name, domain) = match.output","    \/\/ wholeMatch is \"my.name@example.com\"","    \/\/ name is \"my.name\"","    \/\/ domain is \"example.com\"","}"],"type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/regexbuilder-collection"]}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"abstract":[{"type":"text","text":"Use an expressive domain-specific language to build regular expressions,"},{"text":" ","type":"text"},{"type":"text","text":"for operations like searching and replacing in text."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RegexBuilder-collection"},"metadata":{"title":"RegexBuilder","roleHeading":"API Collection","modules":[{"name":"Swift"}],"role":"collectionGroup"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"topicSections":[{"