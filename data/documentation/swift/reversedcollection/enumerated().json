e":"topic","kind":"symbol","url":"\/documentation\/swift","role":"collection","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"abstract":[{"text":"An enumeration of the elements of a sequence or collection.","type":"text"}],"type":"topic","kind":"symbol","title":"EnumeratedSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnumeratedSequence","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","navigatorTitle":[{"text":"EnumeratedSequence","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swift\/enumeratedsequence"}}}