{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index\/base","interfaceLanguage":"swift"},"sections":[],"metadata":{"fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"base","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Base","kind":"typeIdentifier","preciseIdentifier":"s:s18ReversedCollectionV4Basexmfp"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"}],"symbolKind":"property","platforms":[{"unavailable":false,"name":"iOS","deprecated":false,"introducedAt":"8.0","beta":false},{"unavailable":false,"name":"iPadOS","deprecated":false,"introducedAt":"8.0","beta":false},{"unavailable":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"13.0","beta":false},{"unavailable":false,"name":"macOS","deprecated":false,"introducedAt":"10.10","beta":false},{"unavailable":false,"name":"tvOS","deprecated":false,"introducedAt":"9.0","beta":false},{"unavailable":false,"name":"visionOS","deprecated":false,"introducedAt":"1.0","beta":false},{"unavailable":false,"name":"watchOS","deprecated":false,"introducedAt":"2.0","beta":false}],"title":"base","externalID":"s:s18ReversedCollectionV5IndexV4baseACQzvp","roleHeading":"Instance Property","modules":[{"name":"Standard Library"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"base","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Base","kind":"typeIdentifier","preciseIdentifier":"s:s18ReversedCollectionV4Basexmfp"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection\/Index","text":"Index"}]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To find the position that corresponds with this index in the original,"},{"type":"text","text":" "},{"type":"text","text":"underlying collection, use that collection’s "},{"code":"index(before:)","type":"codeVoice"},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"with the "},{"code":"base","type":"codeVoice"},{"type":"text","text":" property."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example declares a function that returns the index of the"},{"type":"text","text":" "},{"type":"text","text":"last even number in the passed array, if one is found. First, the"},{"type":"text","text":" "},{"type":"text","text":"function finds the position of the last even number as a "},{"code":"ReversedIndex","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"in a reversed view of the array of numbers. Next, the function calls the"},{"type":"text","text":" "},{"type":"text","text":"array’s "},{"code":"index(before:)","type":"codeVoice"},{"type":"text","text":" method to return the correct position in the"},{"type":"text","text":" "},{"type":"text","text":"passed array."}]},{"type":"codeListing","syntax":"swift","code":["func indexOfLastEven(_ numbers: [Int]) -> Int? {","    let reversedNumbers = numbers.reversed()","    guard let i = reversedNumbers.firstIndex(where: { $0 % 2 == 0 })","        else { return nil }","","    return numbers.index(before: i.base)","}","","let numbers = [10, 20, 13, 19, 30, 52, 17, 40, 51]","if let lastEven = indexOfLastEven(numbers) {","    print(\"Last even number: \\(numbers[lastEven])\")","}","\/\/ Prints \"Last even number: 40\""]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/reversedcollection\/index\/base"]}],"kind":"symbol","abstract":[{"type":"text","text":"The position after this position in the underlying collection."}],"references":{"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","url":"\/documentation\/swift","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"title":"Standard Library","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"role":"collection"},"doc://com.apple.Swift/documentation/Swift/Collection/Index":{"url":"\/documentation\/swift\/collection\/index","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection\/Index","title":"Index","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Index"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A type that represents a position in the collection."}],"required":true,"role":"symbol"},"doc://com.apple.Swift/documentation/Swift/ReversedCollection/Index/base":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index\/base","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"base"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18ReversedCollectionV4Basexmfp","text":"Base"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"}],"title":"base","url":"\/documentation\/swift\/reversedcollection\/index\/base","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The position after this position in the underlying collection."}]},"doc://com.apple.Swift/documentation/Swift/ReversedCollection/Index":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Index"}],"title":"ReversedCollection.Index","navigatorTitle":[{"kind":"identifier","text":"Index"}],"url":"\/documentation\/swift\/reversedcollection\/index","conformance":{"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"BidirectionalCollection"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"An index that traverses the same positions as an underlying index,"},{"type":"text","text":" "},{"type":"text","text":"with inverted traversal direction."}]},"doc://com.apple.Swift/documentation/Swift/ReversedCollection":{"url":"\/documentation\/swift\/reversedcollection","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ReversedCollection"}],"abstract":[{"type":"text","text":"A collection that presents the elements of its base collection"},{"type":"text","text":" "},{"type":"text","text":"in reverse order."}],"navigatorTitle":[{"text":"ReversedCollection","kind":"identifier"}],"type":"topic","title":"ReversedCollection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection"}}}