{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index\/base"},"metadata":{"externalID":"s:s18ReversedCollectionV5IndexV4baseACQzvp","title":"base","platforms":[{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"8.0","name":"iOS"},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"8.0","name":"iPadOS"},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"13.0","name":"Mac Catalyst"},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"10.10","name":"macOS"},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"9.0","name":"tvOS"},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"1.0","name":"visionOS"},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"2.0","name":"watchOS"}],"symbolKind":"property","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"base"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Base","preciseIdentifier":"s:s18ReversedCollectionV4Basexmfp"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"}],"modules":[{"name":"Swift"}],"role":"symbol"},"variants":[{"paths":["\/documentation\/swift\/reversedcollection\/index\/base"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index"]]},"abstract":[{"text":"The position after this position in the underlying collection.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"base","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Base","kind":"typeIdentifier","preciseIdentifier":"s:s18ReversedCollectionV4Basexmfp"},{"text":".","kind":"text"},{"text":"Index","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection\/Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"}]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"To find the position that corresponds with this index in the original,"},{"type":"text","text":" "},{"type":"text","text":"underlying collection, use that collection’s "},{"type":"codeVoice","code":"index(before:)"},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"with the "},{"type":"codeVoice","code":"base"},{"type":"text","text":" property."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example declares a function that returns the index of the"},{"type":"text","text":" "},{"type":"text","text":"last even number in the passed array, if one is found. First, the"},{"type":"text","text":" "},{"type":"text","text":"function finds the position of the last even number as a "},{"type":"codeVoice","code":"ReversedIndex"},{"type":"text","text":" "},{"type":"text","text":"in a reversed view of the array of numbers. Next, the function calls the"},{"type":"text","text":" "},{"type":"text","text":"array’s "},{"type":"codeVoice","code":"index(before:)"},{"type":"text","text":" method to return the correct position in the"},{"type":"text","text":" "},{"type":"text","text":"passed array."}],"type":"paragraph"},{"code":["func indexOfLastEven(_ numbers: [Int]) -> Int? {","    let reversedNumbers = numbers.reversed()","    guard let i = reversedNumbers.firstIndex(where: { $0 % 2 == 0 })","        else { return nil }","","    return numbers.index(before: i.base)","}","","let numbers = [10, 20, 13, 19, 30, 52, 17, 40, 51]","if let lastEven = indexOfLastEven(numbers) {","    print(\"Last even number: \\(numbers[lastEven])\")","}","\/\/ Prints \"Last even number: 40\""],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/ReversedCollection":{"role":"symbol","type":"topic","url":"\/documentation\/swift\/reversedcollection","title":"ReversedCollection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ReversedCollection","kind":"identifier"}],"abstract":[{"type":"text","text":"A collection that presents the elements of its base collection"},{"type":"text","text":" "},{"type":"text","text":"in reverse order."}],"kind":"symbol","navigatorTitle":[{"text":"ReversedCollection","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/ReversedCollection/Index/base":{"type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"base"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s18ReversedCollectionV4Basexmfp","text":"Base","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index\/base","url":"\/documentation\/swift\/reversedcollection\/index\/base","kind":"symbol","title":"base","abstract":[{"type":"text","text":"The position after this position in the underlying collection."}]},"doc://com.apple.Swift/documentation/Swift/Collection/Index":{"type":"topic","role":"symbol","url":"\/documentation\/swift\/collection\/index","required":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection\/Index","kind":"symbol","title":"Index","abstract":[{"type":"text","text":"A type that represents a position in the collection."}],"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","