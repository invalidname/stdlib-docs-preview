reciseIdentifier":"s:Sl5IndexQa"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To find the position that corresponds with this index in the original,"},{"type":"text","text":" "},{"type":"text","text":"underlying collection, use that collection’s "},{"type":"codeVoice","code":"index(before:)"},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"with the "},{"type":"codeVoice","code":"base"},{"type":"text","text":" property."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example declares a function that returns the index of the"},{"type":"text","text":" "},{"type":"text","text":"last even number in the passed array, if one is found. First, the"},{"type":"text","text":" "},{"type":"text","text":"function finds the position of the last even number as a "},{"type":"codeVoice","code":"ReversedIndex"},{"type":"text","text":" "},{"type":"text","text":"in a reversed view of the array of numbers. Next, the function calls the"},{"type":"text","text":" "},{"type":"text","text":"array’s "},{"type":"codeVoice","code":"index(before:)"},{"type":"text","text":" method to return the correct position in the"},{"type":"text","text":" "},{"type":"text","text":"passed array."}]},{"type":"codeListing","code":["func indexOfLastEven(_ numbers: [Int]) -> Int? {","    let reversedNumbers = numbers.reversed()","    guard let i = reversedNumbers.firstIndex(where: { $0 % 2 == 0 })","        else { return nil }","","    return numbers.index(before: i.base)","}","","let numbers = [10, 20, 13, 19, 30, 52, 17, 40, 51]","if let lastEven = indexOfLastEven(numbers) {","    print(\"Last even number: \\(numbers[lastEven])\")","}","\/\/ Prints \"Last even number: 40\""],"syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/reversedcollection\/index\/base"]}],"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"The position after this position in the underlying collection."}],"references":{"doc://com.apple.Swift/documentation/Swift/ReversedCollection/Index/base":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index\/base","type":"topic","role":"symbol","url":"\/documentation\/swift\/reversedcollection\/index\/base","kind":"symbol","title":"base","abstract":[{"type":"text","text":"The position after this position in the underlying collection."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"base","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s18ReversedCollectionV4Basexmfp","text":"Base","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"}]},"doc://com.apple.Swift/documentation/Swift/Collection/Index":{"abstract":[{"type":"text","text":"A type that represents a position in the collection."}],"required":true,"kind":"symbol","type":"topic","url":"\/documentation\/swift\/collection\/index","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection\/Index","title":"Index","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Index","kind":"identifier"},{"text":" : ","kind":"text"},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"role":"symbol"},"doc://com.apple.Swift/documentation/Swift/ReversedCollection":{"abstract":[{"type":"text","text":"A collection that presents the elements of its base collection"},{"type":"text","text":" "},{"type":"text","text":"in reverse order."}],"type":"topic","kind":"symbol","title":"ReversedCollection","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ReversedCollection"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection","navigatorTitle":[{"kind":"identifier","text":"ReversedCollection"}],"role":"symbol","url":"\/documentation\/swift\/reversedcollection"},"doc://com.apple.Swift/documentation/Swift":{"type":"topic","kind":"symbol","url":"\/documentation\/swift","role":"collection","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/ReversedCollection/Index":{"url":"\/documentation\/swift\/reversedcollection\/index","kind":"symbol","abstract":[{"type":"text","text":"An index that traverses the same positions as an underlying index,"},{"type":"text","text":" "},{"type":"text","text":"with inverted traversal direction."}],"navigatorTitle":[{"kind":"identifier","text":"Index"}],"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Index"}],"conformance":{"constraints":[{"code":"Base","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"BidirectionalCollection","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"title":"ReversedCollection.Index"}}}