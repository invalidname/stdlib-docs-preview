{"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index"]]},"kind":"symbol","metadata":{"fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"base","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18ReversedCollectionV4Basexmfp","text":"Base"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"}],"roleHeading":"Instance Property","externalID":"s:s18ReversedCollectionV5IndexV4baseACQzvp","modules":[{"name":"Standard Library"}],"platforms":[{"unavailable":false,"deprecated":false,"beta":false,"introducedAt":"8.0","name":"iOS"},{"unavailable":false,"deprecated":false,"beta":false,"introducedAt":"8.0","name":"iPadOS"},{"unavailable":false,"deprecated":false,"beta":false,"introducedAt":"13.0","name":"Mac Catalyst"},{"unavailable":false,"deprecated":false,"beta":false,"introducedAt":"10.10","name":"macOS"},{"unavailable":false,"deprecated":false,"beta":false,"introducedAt":"9.0","name":"tvOS"},{"unavailable":false,"deprecated":false,"beta":false,"introducedAt":"1.0","name":"visionOS"},{"introducedAt":"2.0","unavailable":false,"beta":false,"deprecated":false,"name":"watchOS"}],"symbolKind":"property","role":"symbol","title":"base"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"The position after this position in the underlying collection.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"base","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Base","preciseIdentifier":"s:s18ReversedCollectionV4Basexmfp","kind":"typeIdentifier"},{"text":".","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection\/Index","preciseIdentifier":"s:Sl5IndexQa","text":"Index"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"To find the position that corresponds with this index in the original,","type":"text"},{"text":" ","type":"text"},{"text":"underlying collection, use that collection’s ","type":"text"},{"code":"index(before:)","type":"codeVoice"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"with the ","type":"text"},{"code":"base","type":"codeVoice"},{"text":" property.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example declares a function that returns the index of the","type":"text"},{"text":" ","type":"text"},{"text":"last even number in the passed array, if one is found. First, the","type":"text"},{"text":" ","type":"text"},{"text":"function finds the position of the last even number as a ","type":"text"},{"code":"ReversedIndex","type":"codeVoice"},{"text":" ","type":"text"},{"text":"in a reversed view of the array of numbers. Next, the function calls the","type":"text"},{"text":" ","type":"text"},{"text":"array’s ","type":"text"},{"code":"index(before:)","type":"codeVoice"},{"text":" method to return the correct position in the","type":"text"},{"text":" ","type":"text"},{"text":"passed array.","type":"text"}],"type":"paragraph"},{"code":["func indexOfLastEven(_ numbers: [Int]) -> Int? {","    let reversedNumbers = numbers.reversed()","    guard let i = reversedNumbers.firstIndex(where: { $0 % 2 == 0 })","        else { return nil }","","    return numbers.index(before: i.base)","}","","let numbers = [10, 20, 13, 19, 30, 52, 17, 40, 51]","if let lastEven = indexOfLastEven(numbers) {","    print(\"Last even number: \\(numbers[lastEven])\")","}","\/\/ Prints \"Last even number: 40\""],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/reversedcollection\/index\/base"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index\/base","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift/ReversedCollection/Index":{"type":"topic","abstract":[{"type":"text","text":"An index that traverses the same positions as an underlying index,"},{"type":"text","text":" "},{"type":"text","text":"with inverted traversal direction."}],"kind":"symbol","title":"ReversedCollection.Index","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index","role":"symbol","conformance":{"constraints":[{"code":"Base","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"BidirectionalCollection"},{"text":".","type":"text"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"url":"\/documentation\/swift\/reversedcollection\/index","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Index","kind":"identifier"}],"navigatorTitle":[{"text":"Index","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/Collection/Index":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection\/Index","role":"symbol","title":"Index","required":true,"url":"\/documentation\/swift\/collection\/index","abstract":[{"text":"A type that represents a position in the collection.","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Index"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}]},"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"url":"\/documentatio