{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"To find the position that corresponds with this index in the original,","type":"text"},{"text":" ","type":"text"},{"text":"underlying collection, use that collection’s ","type":"text"},{"code":"index(before:)","type":"codeVoice"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"with the "},{"type":"codeVoice","code":"base"},{"type":"text","text":" property."}]},{"inlineContent":[{"text":"The following example declares a function that returns the index of the","type":"text"},{"text":" ","type":"text"},{"text":"last even number in the passed array, if one is found. First, the","type":"text"},{"text":" ","type":"text"},{"text":"function finds the position of the last even number as a ","type":"text"},{"code":"ReversedIndex","type":"codeVoice"},{"text":" ","type":"text"},{"text":"in a reversed view of the array of numbers. Next, the function calls the","type":"text"},{"text":" ","type":"text"},{"text":"array’s ","type":"text"},{"code":"index(before:)","type":"codeVoice"},{"text":" method to return the correct position in the","type":"text"},{"text":" ","type":"text"},{"text":"passed array.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func indexOfLastEven(_ numbers: [Int]) -> Int? {","    let reversedNumbers = numbers.reversed()","    guard let i = reversedNumbers.firstIndex(where: { $0 % 2 == 0 })","        else { return nil }","","    return numbers.index(before: i.base)","}","","let numbers = [10, 20, 13, 19, 30, 52, 17, 40, 51]","if let lastEven = indexOfLastEven(numbers) {","    print(\"Last even number: \\(numbers[lastEven])\")","}","\/\/ Prints \"Last even number: 40\""]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index"]]},"variants":[{"paths":["\/documentation\/swift\/reversedcollection\/index\/base"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift":{"title":"Swift","type":"topic","abstract":[{"type":"text","text":"Build apps using a powerful open language."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","url":"\/documentation\/swift","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/ReversedCollection/Index/base":{"title":"base","type":"topic","abstract":[{"text":"The position after this position in the underlying collection.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index\/base","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"base","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s18ReversedCollectionV4Basexmfp","kind":"typeIdentifier","text":"Base"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"}],"role":"symbol","url":"\/documentation\/swift\/reversedcollection\/index\/base","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/ReversedCollection":{"title":"ReversedCollection","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection","navigatorTitle":[{"kind":"identifier","text":"ReversedCollection"}],"role":"symbol","abstract":[{"type":"text","text":"A collection that presents the elements of its base collection"},{"type":"text","text":" "},{"type":"text","text":"in reverse order."}],"kind":"symbol","url":"\/documentation\/swift\/reversedcollection","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ReversedCollection"}]},"doc://com.apple.Swift/documentation/Swift/Collection/Index":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Index"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"abstract":[{"type":"text","text":"A type that represents a position in the collection."}],"kind":"symbol","required":true,"role":"symbol","url":"\/documentation\/swift\/collection\/index","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection\/Index","title":"Index"},"doc://com.apple.Swift/documentation/Swift/ReversedCollection/Index":{"navigatorTitle":[{"text":"Index","kind":"identifier"}],"conformance":{"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"BidirectionalCollection"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"title":"ReversedCollection.Index","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Index","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index","abstract":[{"type":"text","text":"An index that traverses the same positions as an underlying index,"},{"type":"text","text":" "},{"type":"text","text":"with inverted traversal direction."}],"kind":"symbol","url":"\/documentation\/swift\/reversedcollection\/index","role":"symbol"}}}