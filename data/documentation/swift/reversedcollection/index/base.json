{"metadata":{"role":"symbol","title":"base","roleHeading":"Instance Property","modules":[{"name":"Standard Library"}],"symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"base","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18ReversedCollectionV4Basexmfp","text":"Base"},{"kind":"text","text":"."},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"}],"externalID":"s:s18ReversedCollectionV5IndexV4baseACQzvp","platforms":[{"introducedAt":"8.0","deprecated":false,"name":"iOS","unavailable":false,"beta":false},{"name":"iPadOS","deprecated":false,"unavailable":false,"introducedAt":"8.0","beta":false},{"introducedAt":"13.0","name":"Mac Catalyst","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"10.10","name":"macOS","deprecated":false,"unavailable":false,"beta":false},{"beta":false,"introducedAt":"9.0","unavailable":false,"name":"tvOS","deprecated":false},{"beta":false,"unavailable":false,"deprecated":false,"name":"visionOS","introducedAt":"1.0"},{"beta":false,"unavailable":false,"deprecated":false,"name":"watchOS","introducedAt":"2.0"}]},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"base","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Base","kind":"typeIdentifier","preciseIdentifier":"s:s18ReversedCollectionV4Basexmfp"},{"text":".","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection\/Index","kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"text":"To find the position that corresponds with this index in the original,","type":"text"},{"text":" ","type":"text"},{"text":"underlying collection, use that collection’s ","type":"text"},{"type":"codeVoice","code":"index(before:)"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"with the ","type":"text"},{"type":"codeVoice","code":"base"},{"type":"text","text":" property."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example declares a function that returns the index of the"},{"type":"text","text":" "},{"type":"text","text":"last even number in the passed array, if one is found. First, the"},{"type":"text","text":" "},{"type":"text","text":"function finds the position of the last even number as a "},{"type":"codeVoice","code":"ReversedIndex"},{"type":"text","text":" "},{"type":"text","text":"in a reversed view of the array of numbers. Next, the function calls the"},{"type":"text","text":" "},{"text":"array’s ","type":"text"},{"type":"codeVoice","code":"index(before:)"},{"text":" method to return the correct position in the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"passed array."}],"type":"paragraph"},{"code":["func indexOfLastEven(_ numbers: [Int]) -> Int? {","    let reversedNumbers = numbers.reversed()","    guard let i = reversedNumbers.firstIndex(where: { $0 % 2 == 0 })","        else { return nil }","","    return numbers.index(before: i.base)","}","","let numbers = [10, 20, 13, 19, 30, 52, 17, 40, 51]","if let lastEven = indexOfLastEven(numbers) {","    print(\"Last even number: \\(numbers[lastEven])\")","}","\/\/ Prints \"Last even number: 40\""],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/reversedcollection\/index\/base"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index\/base","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The position after this position in the underlying collection."}],"kind":"symbol","sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/ReversedCollection":{"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swift\/reversedcollection","navigatorTitle":[{"kind":"identifier","text":"ReversedCollection"}],"title":"ReversedCollection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ReversedCollection","kind":"identifier"}],"abstract":[{"text":"A collection that presents the elements of its base collection","type":"text"},{"text":" ","type":"text"},{"text":"in reverse order.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/ReversedCollection/Index":{"kind":"symbol","abstract":[{"type":"text","text":"An index that traverses the same positions as an underlying index,"},{"type":"text","text":" "},{"text":"with inverted traversal direction.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Index","kind":"identifier"}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Base","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"BidirectionalCollection","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"title":"ReversedCollection.Index","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index","type":"topic","role":"symbol","url":"\/documentation\/swift\/reversedcollection\/index","navigatorTitle":[{"text":"Index","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"ki