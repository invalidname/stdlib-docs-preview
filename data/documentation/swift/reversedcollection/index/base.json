{"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index\/base","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"abstract":[{"text":"The position after this position in the underlying collection.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/reversedcollection\/index\/base"]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Index"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"base","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Base","kind":"typeIdentifier","preciseIdentifier":"s:s18ReversedCollectionV4Basexmfp"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection\/Index"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"To find the position that corresponds with this index in the original,","type":"text"},{"text":" ","type":"text"},{"text":"underlying collection, use that collection’s ","type":"text"},{"code":"index(before:)","type":"codeVoice"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"with the ","type":"text"},{"code":"base","type":"codeVoice"},{"text":" property.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example declares a function that returns the index of the"},{"type":"text","text":" "},{"type":"text","text":"last even number in the passed array, if one is found. First, the"},{"type":"text","text":" "},{"type":"text","text":"function finds the position of the last even number as a "},{"type":"codeVoice","code":"ReversedIndex"},{"type":"text","text":" "},{"type":"text","text":"in a reversed view of the array of numbers. Next, the function calls the"},{"type":"text","text":" "},{"type":"text","text":"array’s "},{"type":"codeVoice","code":"index(before:)"},{"type":"text","text":" method to return the correct position in the"},{"type":"text","text":" "},{"type":"text","text":"passed array."}],"type":"paragraph"},{"code":["func indexOfLastEven(_ numbers: [Int]) -> Int? {","    let reversedNumbers = numbers.reversed()","    guard let i = reversedNumbers.firstIndex(where: { $0 % 2 == 0 })","        else { return nil }","","    return numbers.index(before: i.base)","}","","let numbers = [10, 20, 13, 19, 30, 52, 17, 40, 51]","if let lastEven = indexOfLastEven(numbers) {","    print(\"Last even number: \\(numbers[lastEven])\")","}","\/\/ Prints \"Last even number: 40\""],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"metadata":{"role":"symbol","modules":[{"name":"Swift"}],"symbolKind":"property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"base"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18ReversedCollectionV4Basexmfp","text":"Base"},{"kind":"text","text":"."},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"}],"title":"base","externalID":"s:s18ReversedCollectionV5IndexV4baseACQzvp","platforms":[{"unavailable":false,"introducedAt":"8.0","name":"iOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"8.0","name":"iPadOS","deprecated":false,"beta":false},{"name":"Mac Catalyst","deprecated":false,"introducedAt":"13.0","unavailable":false,"beta":false},{"name":"macOS","deprecated":false,"introducedAt":"10.10","unavailable":false,"beta":false},{"name":"tvOS","deprecated":false,"introducedAt":"9.0","unavailable":false,"beta":false},{"name":"visionOS","deprecated":false,