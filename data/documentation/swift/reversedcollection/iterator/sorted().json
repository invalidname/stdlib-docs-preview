 \"Abena\"]\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sorting algorithm is guaranteed to be stable. A stable sort"},{"type":"text","text":" "},{"type":"text","text":"preserves the relative order of elements that compare as equal."}]},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" is the length of the sequence."}],"type":"paragraph"}],"type":"aside","name":"Complexity"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/reversedcollection\/iterator\/sorted()"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Returns the elements of the sequence, sorted.","type":"text"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Iterator\/sorted()","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift/Sequence/Element":{"type":"topic","kind":"symbol","required":true,"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Element"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence\/Element","role":"symbol","abstract":[{"type":"text","text":"A type representing the sequence’s elements."}],"url":"\/documentation\/swift\/sequence\/element","title":"Element"},"doc://com.apple.Swift/documentation/Swift/ReversedCollection":{"title":"ReversedCollection","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection","navigatorTitle":[{"kind":"identifier","text":"ReversedCollection"}],"role":"symbol","abstract":[{"type":"text","text":"A collection that presents the elements of its