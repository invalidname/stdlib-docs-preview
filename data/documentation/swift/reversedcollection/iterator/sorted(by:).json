ments of its base collection"},{"type":"text","text":" "},{"type":"text","text":"in reverse order."}],"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection","title":"ReversedCollection"},"doc://com.apple.Swift/documentation/Swift/ReversedCollection/Iterator":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"BidirectionalCollection"},{"type":"text","text":"."}]},"url":"\/documentation\/swift\/reversedcollection\/iterator","navigatorTitle":[{"text":"Iterator","kind":"identifier"}],"type":"topic","abstract":[],"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ReversedCollection\/Iterator","title":"ReversedCollection.Iterator"}}}