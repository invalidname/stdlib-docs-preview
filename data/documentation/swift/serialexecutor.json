{"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Executor","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExecutorJob","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskExecutor","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnownedJob","doc:\/\/com.apple.Swift\/documentation\/Swift\/JobPriority","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnownedSerialExecutor","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnownedTaskExecutor","doc:\/\/com.apple.Swift\/documentation\/Swift\/globalConcurrentExecutor","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskExecutorPreference(_:isolation:operation:)"],"generated":true,"title":"Executors","anchor":"Executors"}],"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SerialExecutor","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Executor","kind":"typeIdentifier","preciseIdentifier":"s:ScF","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Executor"}]}]},{"kind":"content","content":[{"text":"Custom Actor Executors","anchor":"Custom-Actor-Executors","type":"heading","level":3},{"inlineContent":[{"text":"By default, all actor types execute tasks on a shared global concurrent pool.","type":"text"},{"text":" ","type":"text"},{"text":"The global pool does not guarantee any thread (or dispatch queue) affinity,","type":"text"},{"text":" ","type":"text"},{"text":"so actors are free to use different threads as they execute tasks.","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"The runtime may perform various optimizations to minimize un-necessary"},{"type":"text","text":" "},{"type":"text","text":"thread switching."}],"type":"paragraph"}],"type":"aside","style":"note"},{"type":"paragraph","inlineContent":[{"text":"Sometimes it is important to be able to customize the execution behavior","type":"text"},{"text":" ","type":"text"},{"text":"of an actor. For example, when an actor is known to perform heavy blocking","type":"text"},{"text":" ","type":"text"},{"text":"operations (such as IO), and we would like to keep this work ","type":"text"},{"inlineContent":[{"type":"text","text":"off"}],"type":"emphasis"},{"text":" the global","type":"text"},{"text":" ","type":"text"},{"text":"shared pool, as blocking it may prevent other actors from being responsive.","type":"text"}]},{"inlineContent":[{"text":"You can implement a custom executor, by conforming a type to the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor"},{"text":" protocol, and implementing the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/enqueue(_:)-7sypu"},{"text":" method.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Once implemented, you can configure an actor to use such executor by","type":"text"},{"text":" ","type":"text"},{"text":"implementing the actor’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/unownedExecutor","isActive":true},{"text":" computed property.","type":"text"},{"text":" ","type":"text"},{"text":"For example, you could accept an executor in the actor’s initializer,","type":"text"},{"text":" ","type":"text"},{"text":"store it as a variable (in order to retain it for the duration of the","type":"text"},{"text":" ","type":"text"},{"text":"actor’s lifetime), and return it from the ","type":"text"},{"type":"codeVoice","code":"unownedExecutor"},{"text":" computed","type":"text"},{"text":" ","type":"text"},{"text":"property like this:","type":"text"}],"type":"paragraph"},{"code":["actor MyActor {","  let myExecutor: MyExecutor","","  \/\/ accepts an executor to run this actor on.","  init(executor: MyExecutor) {","    self.myExecutor = executor","  }","","  nonisolated var unownedExecutor: UnownedSerialExecutor {","    self.myExecutor.asUnownedSerialExecutor()","  }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"It is also possible to use a form of shared executor, either created as a","type":"text"},{"text":" ","type":"text"},{"text":"global or static property, which you can then re-use for every MyActor","type":"text"},{"text":" ","type":"text"},{"text":"instance:","type":"text"}]},{"type":"codeListing","code":["actor MyActor {","  \/\/ Serial executor reused by *all* instances of MyActor!","  static let sharedMyActorsExecutor = MyExecutor() \/\/ implements SerialExecutor","","","  nonisolated var unownedExecutor: UnownedSerialExecutor {","    Self.sharedMyActorsExecutor.asUnownedSerialExecutor()","  }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"In the example above, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"all"}]},{"type":"text","text":" “MyActor” instances would be using the same"},{"type":"text","text":" "},{"text":"serial executor, which would result in only one of such actors ever being","type":"text"},{"type":"text","text":" "},{"type":"text","text":"run at the same time. This may be useful if some of your code has some"},{"type":"text","text":" "},{"type":"text","text":"“specific thread” requirement when interoperating with non-Swift runtimes"},{"type":"text","text":" "},{"type":"text","text":"for example."}]},{"type":"paragraph","inlineContent":[{"text":"Since the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnownedSerialExecutor"},{"text":" returned by the ","type":"text"},{"code":"unownedExecutor","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property ","type":"text"},{"inlineContent":[{"text":"does not","type":"text"}],"type":"emphasis"},{"text":" retain the executor, you must make sure the lifetime of","type":"text"},{"text":" ","type":"text"},{"text":"it extends beyond the lifetime of any actor or task using it, as otherwise","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"it may attempt to enqueue work on a released executor object, causing a crash."},{"type":"text","text":" "},{"text":"The executor returned by unownedExecutor ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"must","type":"text"}]},{"type":"text","text":" always be the same object,"},{"type":"text","text":" "},{"type":"text","text":"and returning different executors can lead to unexpected behavior."}]},{"type":"paragraph","inlineContent":[{"text":"Alternatively, you can also use existing serial executor implementations,","type":"text"},{"type":"text","text":" "},{"text":"such as Dispatch’s ","type":"text"},{"code":"DispatchSerialQueue","type":"codeVoice"},{"text":" or others.","type":"text"}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"SerialExecutor","kind":"identifier"}],"navigatorTitle":[{"text":"SerialExecutor","kind":"identifier"}],"roleHeading":"Protocol","title":"SerialExecutor","platforms":[{"introducedAt":"8.0","beta":false,"deprecated":false,"unavailable":false,"name":"iOS"},{"introducedAt":"8.0","beta":false,"deprecated":false,"unavailable":false,"name":"iPadOS"},{"introducedAt":"13.0","beta":false,"deprecated":false,"unavailable":false,"name":"Mac Catalyst"},{"introducedAt":"10.10","beta":false,"deprecated":false,"unavailable":false,"name":"macOS"},{"introducedAt":"9.0","beta":false,"deprecated":false,"unavailable":false,"name":"tvOS"},{"introducedAt":"1.0","beta":false,"deprecated":false,"unavailable":false,"name":"visionOS"},{"introducedAt":"2.0","beta":false,"deprecated":false,"unavailable":fa