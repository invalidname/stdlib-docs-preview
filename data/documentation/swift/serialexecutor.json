{"seeAlsoSections":[{"title":"Executors","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Executor","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExecutorJob","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskExecutor","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnownedJob","doc:\/\/com.apple.Swift\/documentation\/Swift\/JobPriority","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnownedSerialExecutor","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnownedTaskExecutor","doc:\/\/com.apple.Swift\/documentation\/Swift\/globalConcurrentExecutor","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskExecutorPreference(_:isolation:operation:)"],"anchor":"Executors"}],"kind":"symbol","abstract":[{"text":"A service that executes jobs.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SerialExecutor"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Executor","preciseIdentifier":"s:ScF","text":"Executor"}]}],"kind":"declarations"},{"content":[{"level":3,"type":"heading","text":"Custom Actor Executors","anchor":"Custom-Actor-Executors"},{"inlineContent":[{"type":"text","text":"By default, all actor types execute tasks on a shared global concurrent pool."},{"type":"text","text":" "},{"type":"text","text":"The global pool does not guarantee any thread (or dispatch queue) affinity,"},{"type":"text","text":" "},{"text":"so actors are free to use different threads as they execute tasks.","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The runtime may perform various optimizations to minimize un-necessary"},{"type":"text","text":" "},{"type":"text","text":"thread switching."}]}],"type":"aside","style":"note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sometimes it is important to be able to customize the execution behavior"},{"type":"text","text":" "},{"type":"text","text":"of an actor. For example, when an actor is known to perform heavy blocking"},{"type":"text","text":" "},{"type":"text","text":"operations (such as IO), and we would like to keep this work "},{"inlineContent":[{"type":"text","text":"off"}],"type":"emphasis"},{"type":"text","text":" the global"},{"type":"text","text":" "},{"type":"text","text":"shared pool, as blocking it may prevent other actors from being responsive."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can implement a custom executor, by conforming a type to the"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor","isActive":true,"type":"reference"},{"text":" protocol, and implementing the ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/enqueue(_:)-7sypu","isActive":true},{"text":" method.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Once implemented, you can configure an actor to use such executor by"},{"type":"text","text":" "},{"type":"text","text":"implementing the actor’s "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/unownedExecutor","isActive":true},{"type":"text","text":" computed property."},{"type":"text","text":" "},{"type":"text","text":"For example, you could accept an executor in the actor’s initializer,"},{"type":"text","text":" "},{"type":"text","text":"store it as a variable (in order to retain it for the duration of the"},{"type":"text","text":" "},{"type":"text","text":"actor’s lifetime), and return it from the "},{"code":"unownedExecutor","type":"codeVoice"},{"type":"text","text":" computed"},{"type":"text","text":" "},{"type":"text","text":"property like this:"}],"type":"paragraph"},{"code":["actor MyActor {","  let myExecutor: MyExecutor","","  \/\/ accepts an executor to run this actor on.","  init(executor: MyExecutor) {","    self.myExecutor = executor","  }","","  nonisolated var unownedExecutor: UnownedSerialExecutor {","    self.myExecutor.asUnownedSerialExecutor()","  }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"It is also possible to use a form of shared executor, either created as a"},{"type":"text","text":" "},{"type":"text","text":"global or static property, which you can then re-use for every MyActor"},{"type":"text","text":" "},{"type":"text","text":"instance:"}],"type":"paragraph"},{"syntax":"swift","code":["actor MyActor {","  \/\/ Serial executor reused by *all* instances of MyActor!","  static let sharedMyActorsExecutor = MyExecutor() \/\/ implements SerialExecutor","","","  nonisolated var unownedExecutor: UnownedSerialExecutor {","    Self.sharedMyActorsExecutor.asUnownedSerialExecutor()","  }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"In the example above, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"all"}]},{"type":"text","text":" “MyActor” instances would be using the same"},{"type":"text","text":" "},{"type":"text","text":"serial executor, which would result in only one of such actors ever being"},{"type":"text","text":" "},{"type":"text","text":"run at the same time. This may be useful if some of your code has some"},{"type":"text","text":" "},{"type":"text","text":"“specific thread” requirement when interoperating with non-Swift runtimes"},{"type":"text","text":" "},{"type":"text","text":"for example."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnownedSerialExecutor","type":"reference","isActive":true},{"type":"text","text":" returned by the "},{"type":"codeVoice","code":"unownedExecutor"},{"type":"text","text":" "},{"type":"text","text":"property "},{"type":"emphasis","inlineContent":[{"type":"text","text":"does not"}]},{"type":"text","text":" retain the executor, you must make sure the lifetime of"},{"type":"text","text":" "},{"type":"text","text":"it extends beyond the lifetime of any actor or task using it, as otherwise"},{"type":"text","text":" "},{"type":"text","text":"it may attempt to enqueue work on a released executor object, causing a crash."},{"type":"text","text":" "},{"type":"text","text":"The executor returned by unownedExecutor "},{"type":"emphasis","inlineContent":[{"text":"must","type":"text"}]},{"type":"text","text":" always be the same object,"},{"type":"text","text":" "},{"type":"text","text":"and returning different executors can lead to unexpected behavior."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alternatively, you can also use existing serial executor implementations,"},{"type":"text","text":" "},{"type":"text","text":"such as Dispatch’s "},{"code":"DispatchSerialQueue","type":"codeVoice"},{"type":"text","text":" or others."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/serialexecutor"]}],"sections":[],"metadata":{"role":"symbol","symbolKind":"protocol","title":"SerialExecutor","externalID":"s:Scf","roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SerialExecutor","kind":"identifier"}],"modules":[{"relatedModules":[],"name":"Swift"}],"navigatorTitle":[{"text":"SerialExecutor","kind":"identifier"}],"platforms":[{"name":"iOS","beta":false,"deprecated":false,"introducedAt":"8.0","unavailable":false},{"beta":false,"unavailable":false,"name":"iPadOS","introducedAt":"8.0","deprecated":false},{"name":"Mac Catalyst","beta":false,"deprecated":false,"introducedAt":"13.0","unavailable":false},{"beta":false,"unavailable":false,"name":"macOS","introducedAt":"10.10","deprecated":false},{"name":"tvOS","beta":false,"deprecated":false,"introduce