{"defaultImplementationsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/checkIsolated()-76lg2"],"anchor":"SerialExecutor-Implementations","title":"SerialExecutor Implementations"}],"kind":"symbol","metadata":{"roleHeading":"Instance Method","role":"symbol","modules":[{"relatedModules":[],"name":"Swift"}],"platforms":[{"unavailable":false,"introducedAt":"8.0","deprecated":false,"beta":false,"name":"iOS"},{"deprecated":false,"beta":false,"name":"iPadOS","unavailable":false,"introducedAt":"8.0"},{"deprecated":false,"beta":false,"name":"Mac Catalyst","unavailable":false,"introducedAt":"13.0"},{"deprecated":false,"beta":false,"name":"macOS","unavailable":false,"introducedAt":"10.10"},{"deprecated":false,"beta":false,"name":"tvOS","unavailable":false,"introducedAt":"9.0"},{"deprecated":false,"beta":false,"name":"visionOS","unavailable":false,"introducedAt":"1.0"},{"deprecated":false,"beta":false,"name":"watchOS","unavailable":false,"introducedAt":"2.0"}],"title":"checkIsolated()","externalID":"s:Scf13checkIsolatedyyF","required":true,"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkIsolated","kind":"identifier"},{"text":"()","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Last resort “fallback” isolation check, called when the concurrency runtime","type":"text"},{"text":" ","type":"text"},{"text":"is comparing executors e.g. during ","type":"text"},{"code":"assumeIsolated()","type":"codeVoice"},{"text":" and is unable to prove","type":"text"},{"text":" ","type":"text"},{"text":"serial equivalence between the expected (this object), and the current executor.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/checkIsolated()","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/serialexecutor\/checkisolated()"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkIsolated","kind":"identifier"},{"text":"()","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"During executor comparison, the Swift concurrency runtime attempts to compare"},{"type":"text","text":" "},{"type":"text","text":"current and expected executors in a few ways (including “complex” equality"},{"text":" ","type":"text"},{"text":"between executors (see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/isSameExclusiveExecutionContext(other:)"},{"type":"text","text":"), and if all"},{"text":" ","type":"text"},{"text":"those checks fail, this method is invoked on the expected executor.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method MUST crash if it is unable to prove that the current execution"},{"type":"text","text":" "},{"type":"text","text":"context belongs to this executor. At this point usual executor comparison would"},{"type":"text","text":" "},{"type":"text","text":"have already failed, though the executor may have some external tracking of"},{"type":"text","text":" "},{"text":"threads it owns, and may be able to prove isolation nevertheless.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A default implementation is provided that unconditionally crashes the"},{"type":"text","text":" "},{"type":"text","text":"program, and prevents calling code from proceeding with potentially"},{"type":"text","text":" "},{"type":"text","text":"not thread-safe execution."}],"type":"paragraph"},{"type":"aside","style":"warning","content":[{"inlineContent":[{"text":"This method must crash and halt program execution if unable","type":"text"},{"text":" ","type":"text"},{"text":"to prove the isolation of the calling context.","type":"text"}],"type":"paragraph"}],"name":"Warning"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/SerialExecutor/isSameExclusiveExecutionContext(other:)":{"kind":"symbol","abstract":[{"text":"If this executor has complex equality semantics, and the runtime needs to","type":"text"},{"text":" ","type":"text"},{"text":"compare two executors, it will first attempt the usual pointer-based","type":"text"},{"text":" ","type":"text"},{"text":"equality \/ check, \/ and if it fails it will compare the types of both","type":"text"},{"text":" ","type":"text"},{"text":"executors, if they are the same, \/ it will finally invoke this method,","type":"text"},{"text":" ","type":"text"},{"text":"in an","type":"text"},{"text":" ","type":"text"},{"text":"attempt to let the executor itself decide \/ if this and the ","type":"text"},{"code":"other","type":"codeVoice"},{"text":" ","type":"text"},{"text":"executor represent the same serial, exclusive, isolation context.","type":"text"}],"url":"\/documentation\/swift\/serialexecutor\/issameexclusiveexecutioncontext(other:)","title":"isSameExclusiveExecutionContext(other:)","defaultImplementations":2,"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/isSameExclusiveExecutionContext(other:)","required":true,"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isSameExclusiveExecutionContext","kind":"identifier"},{"text":"(","kind":"text"},{"text":"other","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]},"doc://com.apple.Swift/documentation/Swift/SerialExecutor":{"nav