{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor"]]},"abstract":[{"type":"text","text":"Last resort “fallback” isolation check, called when the concurrency runtime"},{"type":"text","text":" "},{"type":"text","text":"is comparing executors e.g. during "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/assumeIsolated(_:file:line:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and is unable to prove serial equivalence between the expected"},{"type":"text","text":" "},{"type":"text","text":"(this object), and the current executor."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/checkIsolated()"},"variants":[{"paths":["\/documentation\/swift\/serialexecutor\/checkisolated()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Method","platforms":[{"unavailable":false,"name":"iOS","beta":false,"introducedAt":"8.0","deprecated":false},{"unavailable":false,"name":"iPadOS","beta":false,"introducedAt":"8.0","deprecated":false},{"unavailable":false,"name":"Mac Catalyst","beta":false,"introducedAt":"13.0","deprecated":false},{"unavailable":false,"name":"macOS","beta":false,"introducedAt":"10.10","deprecated":false},{"unavailable":false,"name":"tvOS","beta":false,"introducedAt":"9.0","deprecated":false},{"unavailable":false,"name":"visionOS","beta":false,"introducedAt":"1.0","deprecated":false},{"unavailable":false,"name":"watchOS","beta":false,"introducedAt":"2.0","deprecated":false}],"modules":[{"name":"Swift","relatedModules":[]}],"symbolKind":"method","required":true,"externalID":"s:Scf13checkIsolatedyyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkIsolated","kind":"identifier"},{"text":"()","kind":"text"}],"title":"checkIsolated()","role":"symbol"},"defaultImplementationsSections":[{"title":"SerialExecutor Implementations","anchor":"SerialExecutor-Implementations","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/checkIsolated()-76lg2"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"checkIsolated","kind":"identifier"},{"text":"()","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"During executor comparison, the Swift concurrency runtime attempts to compare","type":"text"},{"text":" ","type":"text"},{"text":"current and expected executors in a few ways (including “complex” equality","type":"text"},{"text":" ","type":"text"},{"text":"between executors (see ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/isSameExclusiveExecutionContext(other:)","type":"reference","isActive":true},{"type":"text","text":"), and if all"},{"type":"text","text":" "},{"type":"text","text":"those checks fail, this method is invoked on the expected executor."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This method MUST crash if it is unable to prove that the current execution","type":"text"},{"type":"text","text":" "},{"type":"text","text":"context belongs to this executor. At this point usual executor comparison would"},{"type":"text","text":" "},{"type":"text","text":"have already failed, though the executor may have some external tracking of"},{"type":"text","text":" "},{"type":"text","text":"threads it owns, and may be able to prove isolation nevertheless."}]},{"inlineContent":[{"type":"text","text":"A default implementation is provided that unconditionally crashes the"},{"type":"text","text":" "},{"type":"text","text":"program, and prevents calling code from proceeding with potentially"},{"type":"text","text":" "},{"text":"not thread-safe execution.","type":"text"}],"type":"paragraph"},{"name":"Warning","type":"aside","content":[{"inlineContent":[{"type":"text","text":"This method must crash and halt program execution if unable"},{"text":" ","type":"text"},{"type":"text","text":"to prove the isolation of the calling context."}],"type":"paragraph"}],"style":"warning"}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/SerialExecutor/isSameExclusiveExecutionContext(other:)":{"title":"isSameExclusiveExecutionContext(other:)","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"isSameExclusiveExecutionContext"},{"text":"(","kind":"text"},{"text":"other","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"defaultImplementations":2,"url":"\/documentation\/swift\/serialexecutor\/issameexclusiveexecutioncontext(other:)","abstract":[{"type":"text","text":"If this executor has complex equality semantics, and the runtime needs to"},{"type":"text","text":" "},{"type":"text","text":"compare two executors, it will first attempt the usual pointer-based"},{"type":"text","text":" "},{"type":"text","text":"equality \/ check, \/ and if it fails it will compare the types of both"},{"type":"text","text":" "},{"type":"text","text":"executors, if they are the same, \/ it will finally invoke this method,"},{"type":"text","text":" "},{"type":"text","text":"in an"},{"type":"text","text":" "},{"type":"text","text":"attempt to let the executor itself decide \/ if this and the "},{"type":"codeVoice","code":"other"},{"text":" ","type":"text"},{"type":"text","text":"executor represent the same serial, exclusive, isolation context."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/isSameExclusiveExecutionContext(other:)","required":true,"role":"symbol","type":"topic","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/SerialExecutor":{"title":"SerialExecutor","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SerialExecutor"}],"abstract":[{"type":"text","text":"A service that executes jobs."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor","url":"\/documentation\/swift\/serialexecutor","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"SerialExecutor","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/SerialExecutor/checkIsolated()":{"title":"checkIsolated()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkIsolated","kind":"identifier"},{"text":"()","kind":"text"}],"defaultImplementations":1,"url":"\/documentation\/swift\/serialexecutor\/checkisolated()","abstract":[{"type":"text","text":"Last resort “fallback” isolation check, called when the concurrency runtime"},{"type":"text","text":" "},{"type":"text","text":"is comparing executors e.g. during "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor\/assumeIsolated(_:file:line:)"},{"type":"text","text":" "},{"type":"text","text":"and is unable to prove serial equivalence between the expected"},{"type":"text","text":" "},{"type":"text","text":"(this object), and the current executor."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/checkIsolated()","required":true,"role":"symbol","type":"topic","kind":"symbol"},"doc://com.ap