{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor"]]},"kind":"symbol","sections":[],"metadata":{"required":true,"role":"symbol","externalID":"s:Scf13checkIsolatedyyF","platforms":[{"introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false,"name":"iOS"},{"introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false,"name":"iPadOS"},{"introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false,"name":"Mac Catalyst"},{"introducedAt":"10.10","deprecated":false,"unavailable":false,"beta":false,"name":"macOS"},{"introducedAt":"9.0","deprecated":false,"unavailable":false,"beta":false,"name":"tvOS"},{"introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false,"name":"visionOS"},{"introducedAt":"2.0","deprecated":false,"unavailable":false,"beta":false,"name":"watchOS"}],"modules":[{"relatedModules":[],"name":"Swift"}],"title":"checkIsolated()","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkIsolated","kind":"identifier"},{"text":"()","kind":"text"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/serialexecutor\/checkisolated()"]}],"abstract":[{"text":"Last resort “fallback” isolation check, called when the concurrency runtime","type":"text"},{"text":" ","type":"text"},{"text":"is comparing executors e.g. during ","type":"text"},{"type":"codeVoice","code":"assumeIsolated()"},{"text":" and is unable to prove","type":"text"},{"text":" ","type":"text"},{"text":"serial equivalence between the expected (this object), and the current executor.","type":"text"}],"defaultImplementationsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/checkIsolated()-76lg2"],"anchor":"SerialExecutor-Implementations","title":"SerialExecutor Implementations"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkIsolated"},{"kind":"text","text":"()"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"During executor comparison, the Swift concurrency runtime attempts to compare"},{"type":"text","text":" "},{"type":"text","text":"current and expected executors in a few ways (including “complex” equality"},{"text":" ","type":"text"},{"text":"between executors (see ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/isSameExclusiveExecutionContext(other:)","type":"reference","isActive":true},{"text":"), and if all","type":"text"},{"text":" ","type":"text"},{"text":"those checks fail, this method is invoked on the expected executor.","type":"text"}]},{"inlineContent":[{"text":"This method MUST crash if it is unable to prove that the current execution","type":"text"},{"text":" ","type":"text"},{"text":"context belongs to this executor. At this point usual executor comparison would","type":"text"},{"text":" ","type":"text"},{"text":"have already failed, though the executor may have some external tracking of","type":"text"},{"text":" ","type":"text"},{"text":"threads it owns, and may be able to prove isolation nevertheless.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A default implementation is provided that unconditionally crashes the","type":"text"},{"text":" ","type":"text"},{"text":"program, and prevents calling code from proceeding with potentially","type":"text"},{"text":" ","type":"text"},{"text":"not thread-safe execution.","type":"text"}],"type":"paragraph"},{"style":"warning","name":"Warning","content":[{"inlineContent":[{"type":"text","text":"This method must crash and halt program execution if unable"},{"type":"text","text":" "},{"type":"text","text":"to prove the isolation of the calling context."}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/checkIsolated()"},"references":{"doc://com.apple.Swift/documentation/Swift/SerialExecutor/checkIsolated()":{"defaultImplementations":1,"type":"topic","kind":"symbol","abstract":[{"text":"Last resort “fallback” isolation check, called when the concurrency runtime","type":"text"},{"text":" ","type":"text"},{"text":"is comparing executors e.g. during ","type":"text"},{"code":"assumeIsolated()","type":"codeVoice"},{"text":" and is unable to prove","type":"text"},{"text":" ","type":"text"},{"text":"serial equivalence between the expected (this object), and the current executor.","type":"text"}],"title":"checkIsolated()","url":"\/documentation\/swift\/serialexecutor\/checkisolated()","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkIsolated"},{"kind":"text","text":"()"}],"required":true,"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/checkIsolated()"},"doc://com.apple.Swift/documentation/Swift/SerialExecutor/isSameExclusiveExecutionContext(other:)":{"role":"symbol","type":"topic","title":"isSameExclusiveExecutionContext(other:)","required":true,"abstract":[{"text":"If this executor has complex equality semantics, and the runtime needs to","type":"text"},{"text":" ","type":"text"},{"text":"compare two executors, it will first attempt the usual pointer-based","type":"text"},{"text":" ","type":"text"},{"text":"equality \/ check, \/ and if it fails it will compare the types of both","type":"text"},{"type":"text","text":" "},{"text":"executors, if they are the same, \/ it will finally invoke this method,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in an"},{"text":" ","type":"text"},{"text":"attempt to let the executor itself decide \/ if this and the ","type":"text"},{"type":"codeVoice","code":"other"},{"type":"text","text":" "},{"text":"executor represent the same serial, exclusive, isolation context.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isSameExclusiveExecutionContext","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"other"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/isSameExclusiveExecutionContext(other:)","url":"\/documentation\/swift\/serialexecutor\/issameexclusiveexecutioncontext(other:)","kind":"symbol","defaultImplementations":2},"doc://com.apple.Swift/documentation/Swift/SerialExecutor":{"type":"topic","title":"SerialExecutor","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SerialExecutor"}],"kind":"symbol","abstract":[{"text":"A service that executes jobs.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor","url":"\/documentation\/swift\/serialexecutor","navigatorTitle":[{"kind":"identifier","text":"SerialExecutor"}]},"doc://com.apple.Swift/documentation/Swift/SerialExecutor/checkIsolated()-76lg2":{"url":"\/documentation\/swift\/serialexecutor\/checkisolated()-76lg2","title":"checkIsolated()","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SerialExecutor\/checkIsolated()-76lg2","abstract":[],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkIsolated"},{"kind":"text","text":"()"}],"type":"topic","role":"symbol"},"Swift-PageImage-card.png":{"identifier":"Swift-PageImage-card.png","type":"image","alt":"An orange Swift logo on a gradient backgroun