]},{"type":"text","text":" is the length of "},{"type":"codeVoice","code":"newElements"},{"type":"text","text":". If the call to this method simply"},{"type":"text","text":" "},{"type":"text","text":"appends the contents of "},{"type":"codeVoice","code":"newElements"},{"type":"text","text":" to the collection, the complexity"},{"type":"text","text":" "},{"type":"text","text":"is O("},{"type":"emphasis","inlineContent":[{"text":"m","type":"text"}]},{"type":"text","text":")."}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/slice\/replacesubrange(_:with:)-9le44"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Slice\/replaceSubrange(_:with:)-9le44","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift/Sequence/Element":{"role":"symbol","title":"Element","url":"\/documentation\/swift\/sequence\/element","abstract":[{"type":"text","text":"A type representing the sequence’s elements."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence\/Element","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"required":true,"kind":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/Swift/Slice/replaceSubrange(_:with:)-9le44":{"role":"symbol","title":"replaceSubrange(_:with:)","url":"\/documentation\/swift\/slice\/replacesubrange(_:with:)-9le44","abstract":[{"text":"Replaces the specified subrange of elements with the given collection.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Slice\/replaceSubrange(_:with:)-9le44","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replaceSubrange","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"R","preciseIden