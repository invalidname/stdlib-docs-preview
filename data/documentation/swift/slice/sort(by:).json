{"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Slice\/sort(by:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/slice\/sort(by:)"]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Slice"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Sorts the collection in place, using the given predicate as the","type":"text"},{"text":" ","type":"text"},{"text":"comparison between elements.","type":"text"}],"metadata":{"externalID":"s:SMsSkRzrlE4sort2byySb7ElementSTQz_ADtKXE_tKF::SYNTHESIZED::s:s5SliceV","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Self"},{"text":" conforms to ","type":"text"},{"code":"RandomAccessCollection","type":"codeVoice"},{"text":".","type":"text"}]},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sort"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"by"},{"kind":"text","text":": ("},{"text":"Element","preciseIdentifier":"s:Sk7ElementQa","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"Element","preciseIdentifier":"s:Sk7ElementQa","kind":"typeIdentifier"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":") "},{"text":"rethrows","kind":"keyword"}],"platforms":[{"name":"iOS","introducedAt":"8.0","beta":false,"unavailable":false,"deprecated":false},{"name":"iPadOS","introducedAt":"8.0","beta":false,"unavailable":false,"deprecated":false},{"introducedAt":"13.0","unavailable":false,"beta":false,"deprecated":false,"name":"Mac Catalyst"},{"introducedAt":"10.10","unavailable":false,"beta":false,"deprecated":false,"name":"macOS"},{"introducedAt":"9.0","unavailable":false,"beta":false,"deprecated":false,"name":"tvOS"},{"introducedAt":"1.0","unavailable":false,"beta":false,"deprecated":false,"name":"visionOS"},{"introducedAt":"2.0","unavailable":false,"beta":false,"deprecated":false,"name":"watchOS"}],"extendedModule":"Swift","symbolKind":"method","roleHeading":"Instance Method","title":"sort(by:)","modules":[{"name":"Standard Library"}],"role":"symbol"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"sort"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":" "},{"text":"areInIncreasingOrder","kind":"internalParam"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Element","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomAccessCollection\/Element","preciseIdentifier":"s:Sk7ElementQa"},{"text":", ","kind":"text"},{"kind":"typeIdentifier","text":"Element","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomAccessCollection\/Element","preciseIdentifier":"s:Sk7ElementQa"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool"},{"text":") ","kind":"text"},{"kind":"keyword","text":"rethrows"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"A predicate that returns ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if its","type":"text"},{"type":"text","text":" "},{"text":"first argument should be ordered before its second argument;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise, ","type":"text"},{"type":"codeVoice","code":"false"},{"type":"text","text":". If "},{"code":"areInIncreasingOrder","type":"codeVoice"},{"text":" throws an error during","type":"text"},{"text":" ","type":"text"},{"text":"the sort, the elements may be in a different order, but none will be","type":"text"},{"type":"text","text":" "},{"text":"lost.","type":"text"}],"type":"paragraph"}],"name":"areInIncreasingOrder"}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"When you want to sort a collection of elements that don’t conform to","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":" protocol, pass a closure to this method that returns","type":"text"},{"text":" ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" when the first element should be ordered before the second.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In the following example, the closure provides an ordering for an array"},{"text":" ","type":"text"},{"type":"text","text":"of a custom enumeration that describes an HTTP response. The predicate"},{"text":" ","type":"text"},{"text":"orders errors before successes and sorts the error responses by their","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"error code."}],"type":"paragraph"},{"syntax":"swift","code":["enum HTTPResponse {","    case ok","    case error(Int)","}","","var responses: [HTTPResponse] = [.error(500), .ok, .ok, .error(404), .error(403)]","responses.sort {","    switch ($0, $1) {","    \/\/ Order errors by code","    case let (.error(aCode), .error(bCode)):","        return aCode < bCode","","    \/\/ All successes are equivalent, so none is before any other","    case (.ok, .ok): return false","","    \/\/ Order errors before successes","    case (.error, .ok): return true","    case (.ok, .error): return false","    }","}","print(responses)","\/\/ Prints \"[.error(403), .error(404), .error(500), .ok, .ok]\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Alternatively, use this method to sort a collection of elements that do"},{"text":" ","type":"text"},{"text":"conform to ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":" when you want the sort to be descending instead","type":"text"},{"text":" ","type":"text"},{"text":"of ascending. Pass the greater-than operator (","type":"text"},{"code":">","type":"codeVoice"},{"text":") operator as the","type":"text"},{"text":" ","type":"text"},{"text":"predicate.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var students = [\"Kofi\", \"Abena\", \"Peter\", \"Kweku\", \"Akosua\"]","students.sort(by: >)","print(students)","\/\/ Prints \"[\"Peter\", \"Kweku\", \"Kofi\", \"Akosua\", \"Abena\"]\""],"type":"codeListing"},{"inlineContent":[{"code":"areInIncreasingOrder","type":"codeVoice"},{"text":" must be a ","type":"text"},{"inlineContent":[{"type":"text","text":"strict weak ordering"}],"type":"emphasis"},{"type":"text","text":" over the"},{"text":" ","type":"text"},{"text":"elements. That is, for any elements ","type":"text"},{"type":"codeVoice","code":"a"},{"type":"text","text":", "},{"type":"codeVoice","code":"b"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"c"},{"text":", the following","type":"text"},{"type":"text","text":" "},{"type":"text","text":"conditions must hold:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"areInIncreasingOrder(a, a)"},{"type":"text","text":" is always "},{"type":"codeVoice","code":"false"},{"text":". (Irreflexivity)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"areInIncreasingOrder(a, b)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"areInIncreasingOrder(b, c)"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"both "},{"type":"codeVoice","code":"true"},{"text":", then ","type":"text"},{"type":"codeVoice","code":"areInIncreasingOrder(a, c)"},{"text":" is also ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"(Transitive comparability)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Two elements are ","type":"text"},{"inlineContent":[{"text":"incomparable","type":"text"}],"type":"emphasis"},{"text":" if neither is ordered before the other","type":"text"},{"text":" ","type":"text"},{"text":"according to the predicate. If ","type":"text"},{"type":"codeVoice","code":"a"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"b"},{"text":" are incomparable, and ","type":"text"},{"type":"codeVoice","code":"b"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"c"},{"text":" are incomparable, then ","type":"text"},{"type":"codeVoice","code":"a"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"c"},{"text":" are also incomparable.","type":"text"},{"text":" ","type":"text"},{"text":"(Transitive incomparability)","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The sorting algorithm is guaranteed to be stable. A stable sort","type":"text"},{"text":" ","type":"text"},{"text":"preserves the relative order of elements for which","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"areInIncreasingOrder"},{"text":" does not establish an order.","type":"text"}]},{"name":"Complexity","style":"note","type":"aside","content":[{"inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":" log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":" is the length of the collection.","type":"text"}],"type":"paragraph"}]}]}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","url":"\/documentation\/swift","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"title":"Standard Library","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"role":"collection"},"doc://com.apple.Swift/documentation/Swift/RandomAccessCollection/Element":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomAccessCollection\/Element","type":"topic","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"title":"Element","url":"\/documentation\/swift\/randomaccesscollection\/element","required":true,"role":"symbol","kind":"symbol","abstract":[]},"doc://com.apple.Swift/documentation/Swift/Bool":{"role":"symbol","title":"Bool","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","abstract":[{"type":"text","text":"A value type whose instances are either "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"Bool"}],"url":"\/documentation\/swift\/bool","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Bool","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/Slice/sort(by:)":{"abstract":[{"type":"text","text":"Sorts the collection in place, using the given predicate as the"},{"type":"text","text":" "},{"type":"text","text":"comparison between elements."}],"title":"sort(by:)","url":"\/documentation\/swift\/slice\/sort(by:)","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"RandomAccessCollection","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"typ