"type":"text"},{"text":" ","type":"text"},{"text":"to begin writing bytes from the value. The default is zero.","type":"text"}]}],"name":"offset"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The type to use for the newly constructed instance. The memory","type":"text"},{"text":" ","type":"text"},{"text":"must be initialized to a value of a type that is layout compatible","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"type"},{"text":".","type":"text"}]}],"name":"type"}],"kind":"parameters"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" to be stored must be a trivial type. The memory must also be"},{"type":"text","text":" "},{"type":"text","text":"uninitialized, initialized to "},{"type":"codeVoice","code":"T"},{"type":"text","text":", or initialized to another trivial"},{"type":"text","text":" "},{"type":"text","text":"type that is layout compatible with "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The memory written to must not extend beyond"},{"type":"text","text":" "},{"type":"text","text":"the memory region represented by the buffer pointer slice—that is,"},{"type":"text","text":" "},{"type":"codeVoice","code":"offset + MemoryLayout<T>.size"},{"type":"text","text":" must be less than or equal"},{"type":"text","text":" "},{"type":"text","text":"to the slice’s "},{"type":"codeVoice","code":"count"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After calling "},{"type":"codeVoice","code":"storeBytes(of:toByteOffset:as:)"},{"type":"text","text":", the memory is"},{"type":"text","text":" "},{"type":"text","text":"initialized to the raw bytes of "},{"type":"codeVoice","code":"value"},{"type":"text","text":". If the memory is bound to a"},{"type":"text","text":" "},{"type":"text","text":"type "},{"type":"codeVoice","code":"U"},{"type":"text","text":" that is layout compatible with "},{"type":"codeVoice","code":"T"},{"type":"text","text":", then it contains a value of"},{"type":"text","text":" "},{"type":"text","text":"type "},{"type":"codeVoice","code":"U"},{"type":"text","text":". Calling "},{"type":"codeVoice","code":"storeBytes(of:toByteOffset:as:)"},{"type":"text","text":" does not change the"},{"type":"text","text":" "},{"type":"text","text":"bound type of the memory."}]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"A trivial type can be copied with just a bit-for-bit copy without","type":"text"},{"text":" ","type":"text"},{"text":"any indirection or reference-counting operations. Generally, native","type":"text"},{"text":" ","type":"text"},{"text":"Swift types that do not contain strong or weak references or other","type":"text"},{"text":" ","type":"text"},{"text":"forms of indirection are trivial, as are imported C structs and enums.","type":"text"}]}],"type":"aside","style":"note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need to store into memory a copy of a value of a type that isn’t"},{"type":"text","text":" "},{"type":"text","text":"trivial, you cannot use the "},{"type":"codeVoice","code":"storeBytes(of:toByteOffset:as:)"},{"type":"text","text":" method."},{"type":"text","text":" "},{"type":"text","text":"Instead, you must know either initialize the memory or,"},{"type":"text","text":" "},{"type":"text","text":"if you know the memory was already bound to "},{"type":"codeVoice","code":"type"},{"type":"text","text":", assign to the memory."}]}],"kind":"content"}],"metadata":{"roleHeading":"Instance Method","title":"storeBytes(of:toByteOffset:as:)","externalID":"s:s5SliceVsSwRszrlE10storeBytes2of12toByteOffset2asyqd___Siqd__mtlF","conformance":{"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" is 