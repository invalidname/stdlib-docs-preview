sultL_qd_1_mfp"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:s5SliceV17withMemoryRebound2to_qd_1_qd__m_qd_1_SRyqd__Gqd_0_YKXEtqd_0_YKSRyqd_2_GRszs5ErrorRd_0_Ri_d__Ri_d_1_r2_lF1EL_qd_0_mfp","text":"E","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s5SliceV17withMemoryRebound2to_qd_1_qd__m_qd_1_SRyqd__Gqd_0_YKXEtqd_0_YKSRyqd_2_GRszs5ErrorRd_0_Ri_d__Ri_d_1_r2_lF6ResultL_qd_1_mfp","text":"Result","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"UnsafeBufferPointer","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeBufferPointer","preciseIdentifier":"s:SR"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Error","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP"},{"text":", ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ~Copyable, ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":" : ~Copyable","kind":"text"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The type to temporarily bind the memory referenced by this","type":"text"},{"type":"text","text":" "},{"text":"buffer slice. The type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" must be layout compatible","type":"text"},{"type":"text","text":" "},{"type":"text","text":"with the pointer’s "},{"code":"Element","type":"codeVoice"},{"text":" type.","type":"text"}]}],"name":"type"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A closure that takes a typed buffer to the","type":"text"},{"text":" ","type":"text"},{"text":"same memory as this buffer slice, only bound to type ","type":"text"},{"type":"codeVoice","code":"T"},{"text":". The buffer","type":"text"},{"text":" ","type":"text"},{"text":"parameter contains a number of complete instances of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" based","type":"text"},{"text":" ","type":"text"},{"text":"on the capacity of the original buffer and the stride of ","type":"text"},{"type":"codeVoice","code":"Element"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The closure’s buffer argument is valid only for the duration of the","type":"text"},{"text":" ","type":"text"},{"text":"closure’s execution. If ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" has a return value, that value","type":"text"},{"text":" ","type":"text"},{"text":"is also used as the return value for the ","type":"text"},{"type":"codeVoice","code":"withMemoryRebound(to:_:)"},{"text":" ","type":"text"},{"text":"method.","type":"text"}]}],"name":"body"}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"code":"body","type":"codeVoice"},{"type":"text","text":" closure parameter."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Use this method when you have a buffer slice of memory bound to one type"},{"type":"text","text":" "},{"type":"text","text":"and you need to access that memory as a buffer of another type. Accessing"},{"type":"text","text":" "},{"type":"text","text":"memory as type "},{"code":"T","type":"codeVoice"},{"type":"text","text":" requires that the memory be bound to that type. A"},{"type":"text","text":" "},{"type":"text","text":"memory location may only be bound to one type at a time, so accessing"},{"type":"text","text":" "},{"type":"text","text":"the same memory as an unrelated type without first rebinding the memory"},{"type":"text","text":" "},{"type":"text","text":"is undefined."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The number of instances of "},{"code":"T","type":"codeVoice"},{"text":" referenced by the rebound buffer may be","type":"text"},{"type":"text","text":" "},{"text":"different than the number of instances of ","type":"text"},{"code":"Element","type":"codeVoice"},{"type":"text","text":" referenced by the"},{"type":"text","text":" "},{"type":"text","text":"original buffer slice. The number of instances of "},{"code":"T","type":"codeVoice"},{"type":"text","text":" will be calculated"},{"text":" ","type":"text"},{"text":"at runtime.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Any instance of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" within the re-bound region may be initialized or","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"uninitialized. Every instance of "},{"code":"Pointee","type":"codeVoice"},{"text":" overlapping with a given","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"instance of "},{"type":"codeVoice","code":"T"},{"text":" should have the same initialization state (i.e.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"initialized or uninitialized.) Accessing a "},{"type":"codeVoice","code":"T"},{"type":"text","text":" whose underlying"},{"type":"text","text":" "},{"type":"codeVoice","code":"Pointee"},{"type":"text","text":" storage is in a mixed initialization state shall be"},{"type":"text","text":" "},{"type":"text","text":"undefined behaviour."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because this range of memory is no longer bound to its "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type"},{"type":"text","text":" "},{"type":"text","text":"while the "},{"code":"body","type":"codeVoice"},{"type":"text","text":" closure executes, do not access memory using the"},{"type":"text","text":" "},{"type":"text","text":"original buffer slice from within "},{"code":"body","type":"codeVoice"},{"type":"text","text":". Instead,"},{"type":"text","text":" "},{"type":"text","text":"use the "},{"code":"body","type":"codeVoice"},{"text":" closure’s buffer argument to access the values","type":"text"},{"text":" ","type":"text"},{"text":"in memory as instances of type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"After executing ","type":"text"},{"code":"body","type":"codeVoice"},{"text":", this method rebinds memory back to the original","type":"text"},{"text":" ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" type.","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only use this method to rebind the buffer slice’s memory to a type"},{"type":"text","text":" "},{"type":"text","text":"that is layout compatible with the currently bound "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type."},{"type":"text","text":" "},{"type":"text","text":"The stride of the temporary type ("},{"type":"codeVoice","code":"T"},{"type":"text","text":") may be an integer multiple"},{"type":"text","text":" "},{"type":"text","text":"or a whole fraction of "},{"type":"codeVoice","code":"Element"},{"type":"text","text":"’s stride."},{"type":"text","text":" "},{"type":"text","text":"To bind a region of memory to a type that does not match these"},{"type":"text","text":" "},{"type":"text","text":"requirements, convert the buffer to a raw buffer and use the"},{"type":"text","text":" "},{"type":"codeVoice","code":"withMemoryRebound(to:)"},{"type":"text","text":" method on the raw buffer."},{"type":"text","text":" "},{"type":"text","text":"If "},{"type":"codeVoice","code":"T"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" have different alignments, this buffer slice"},{"type":"text","text":" "},{"type":"text","text":"must be aligned with the larger of the two alignments."}]}],"style":"note","type":"aside"}]}],"variants":[{"paths":["\/documentation\/swift\/slice\/withmemoryrebound(to:_:)-ibp7"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Executes the given closure while temporarily binding the memory referenced"},{"type":"text","text":" "},{"type":"text","text":"by this buffer slice to the given type."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Slice"]]},"metadata":{"platforms":[{"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iPadOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"13.0","name":"Mac Catalyst","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"10.10","name":"macOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"9.0","name":"tvOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"1.0","name":"visionOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"2.0","name":"watchOS","deprecated":false}],"conformance":{"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Collection"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"externalID":"s:s5SliceV17withMemoryRebound2to_qd_1_qd__m_qd_1_SRyqd__Gqd_0_YKXEtqd_0_YKSRyqd_2_GRszs5ErrorRd_0_Ri_d__Ri_d_1_r2_lF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withMemoryRebound"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":"