orms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"start","content":[{"inlineContent":[{"type":"text","text":"The starting value to use for the sequence. If the sequence"},{"type":"text","text":" "},{"type":"text","text":"contains any values, the first one is "},{"type":"codeVoice","code":"start"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"end","content":[{"inlineContent":[{"type":"text","text":"An end value to limit the sequence. "},{"type":"codeVoice","code":"end"},{"type":"text","text":" is an element of"},{"type":"text","text":" "},{"type":"text","text":"the resulting sequence if and only if it can be produced from "},{"type":"codeVoice","code":"start"},{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"using steps of "},{"type":"codeVoice","code":"stride"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"stride","content":[{"inlineContent":[{"type":"text","text":"The amount to step by with each iteration. A positive "},{"type":"codeVoice","code":"stride"},{"type":"text","text":" "},{"type":"text","text":"iterates upward; a negative "},{"type":"codeVoice","code":"stride"},{"type":"text","text":" iterates downward."}],"type":"paragraph"}]}]},{"content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"A sequence from "},{"code":"start","type":"codeVoice"},{"type":"text","text":" toward, and possibly including, "},{"code":"end","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Each value in the sequence is separated by "},{"type":"codeVoice","code":"stride"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"You can use this function to stride over values of any type that conforms"},{"type":"text","text":" "},{"type":"text","text":"to the "},{"code":"Strideable","type":"codeVoice"},{"type":"text","text":" protocol, such as integers or floating-point types."},{"type":"text","text":" "},{"type":"text","text":"Starting with "},{"type":"codeVoice","code":"start"},{"type":"text","text":", each successive value of the sequence adds "},{"type":"codeVoice","code":"stride"},{"type":"text","text":" "},{"type":"text","text":"until the next value would be beyond "},{"type":"codeVoice","code":"end"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["for radians in stride(from: 0.0, through: .pi * 2, by: .pi \/ 2) {","    let degrees = Int(radians * 180 \/ .pi)","    print(\"Degrees: \\(degrees), radians: \\(radians)\")","}","\/\/ Degrees: 0, radians: 0.0","\/\/ Degrees: 90, radians: 1.5707963267949","\/\/ Degrees: 180, radians: 3.14159265358979","\/\/ Degrees: 270, radians: 4.71238898038469","\/\/ Degrees: 360, radians: 6.28318530717959"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"You can use "},{"type":"codeVoice","code":"stride(from:through:by:)"},{"type":"text","text":" to create a sequence that strides"},{"type":"text","text":" "},{"type":"text","text":"upward or downward. Pass a negative value as "},{"type":"codeVoice","code":"stride"},{"type":"text","text":" to create a sequence"},{"type":"text","text":" "},{"type":"text","text":"from a higher start to a lower end:"}],"type":"paragraph"},{"code":["for countdown in stride(from: 3, through: 1, by: -1) {","    print(\"\\(countdown)...\")","}","\/\/ 3...","\/\/ 2...","\/\/ 1..."],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The value you pass as "},{"type":"codeVoice","code":"end"},{"type":"text","text":" is not guaranteed to be included in the"},{"type":"text","text":" "},{"type":"text","text":"sequence. If stepping from "},{"type":"codeVoice","code":"start"},{"type":"text","text":" by "},{"type":"codeVoice","code":"stride"},{"type":"text","text":" does not produce "},{"type":"codeVoice","code":"end"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the last value in the sequence will be one step before going beyond "},{"type":"codeVoice","code":"end"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["for multipleOfThree in stride(from: 3, through: 10, by: 3) {","    print(multipleOfThree)","}","\/\/ 3","\/\/ 6","\/\/ 9"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"If you pass a value as "},{"type":"codeVoice","code":"stride"},{"type":"text","text":" that moves away from "},{"type":"codeVoice","code":"end"},{"type":"text","text":", the sequence"},{"type":"text","text":" "},{"type":"text","text":"contains no values."}],"type":"paragraph"},{"code":["for x in stride(from: 0, through: 10, by: -1) {","    print(x)","}","\/\/ Nothing is printed."],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"seeAlsoSections":[{"anchor":"Strides","generated":true,"title":"Strides","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/stride(from:to:by:)"]}],"abstract":[{"type":"text","text":"Returns a sequence from a starting value toward, and possibly including, an end"},{"type":"text","text":" "},{"type":"text","text":"value, stepping by the specified amount."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/stride(from:through:by:)"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/stride(from:through:by:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"metadata":{"role":"symbol","modules":[{"name":"Swift"}],"symbolKind":"func","roleHeading":"Function","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stride","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s6stride4from7through2by