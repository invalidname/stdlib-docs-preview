cePosition","type":"codeVoice"},{"text":" represents the start of an","type":"text"},{"text":" ","type":"text"},{"text":"extended grapheme cluster—the element type of a string—then the","type":"text"},{"text":" ","type":"text"},{"text":"initializer succeeds.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example converts the position of the Unicode scalar ","type":"text"},{"code":"\"e\"","type":"codeVoice"},{"text":" ","type":"text"},{"text":"into its corresponding position in the string. The character at that","type":"text"},{"text":" ","type":"text"},{"text":"position is the composed ","type":"text"},{"code":"\"é\"","type":"codeVoice"},{"text":" character.","type":"text"}],"type":"paragraph"},{"code":["let cafe = \"Cafe\\u{0301}\"","print(cafe)","\/\/ Prints \"Café\"","","let scalarsIndex = cafe.unicodeScalars.firstIndex(of: \"e\")!","let stringIndex = String.Index(scalarsIndex, within: cafe)!","","print(cafe[...stringIndex])","\/\/ Prints \"Café\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"If the index passed as ","type":"text"},{"code":"sourcePosition","type":"codeVoice"},{"text":" doesn’t have an exact","type":"text"},{"text":" ","type":"text"},{"text":"corresponding position in ","type":"text"},{"code":"target","type":"codeVoice"},{"text":", the result of the initializer is","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". For example, an attempt to convert the position of the combining","type":"text"},{"text":" ","type":"text"},{"text":"acute accent (","type":"text"},{"code":"\"\\u{0301}\"","type":"codeVoice"},{"text":") fails. Combining Unicode scalars do not have","type":"text"},{"text":" ","type":"text"},{"text":"their own position in a string.","type":"text"}],"type":"paragraph"},{"code":["let nextScalarsIndex = cafe.unicodeScalars.index(after: scalarsIndex)","let nextStringIndex = String.Index(nextScalarsIndex, within: cafe)","","print(nextStringIndex)","\/\/ Prints \"nil\""],"type":"codeListing","syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/swift\/string\/index\/init(_:within:)-2u3iq"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/String","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index"]]},"metadata":{"title":"init(_:within:)","externalID":"s:SS5IndexV_6withinABSgAB_SStcfc","symbolKind":"init","platforms":[{"name":"iOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"8.0"},{"name":"iPadOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"8.0"},{"name":"Mac Catalyst","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"13.0"},{"name":"macOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"10.10"},{"name":"tvOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"9.0"},{"name":"visionOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"1.0"},{"name":"watchOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"2.0"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:SS5IndexV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"within"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":")"}],"roleHeading":"Initializer","extendedModule":"Swift","modules":[{"name":"Swift"}],"role":"symbol"},"abstract":[{"type":"text","text":"Creates an index in the given string that corresponds exactly to the"},{"type":"text","text":" "},{"type":"text","text":"specified position."}],"references":{"doc://com.apple.Swift/documentation/Swift/String":{"navigatorTitle":[{"kind":"identifier","text":"String"}]