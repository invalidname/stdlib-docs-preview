ift\/String\/Index","kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:SS5IndexV"},{"text":", ","kind":"text"},{"text":"within","kind":"externalParam"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"target"},{"kind":"text","text":": "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String","kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"sourcePosition","content":[{"inlineContent":[{"text":"A position in a view of the ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" parameter.","type":"text"},{"text":" ","type":"text"},{"code":"sourcePosition","type":"codeVoice"},{"text":" must be a valid index of at least one of the views","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"target","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"target","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The string referenced by the resulting index."}]}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"If the index passed as "},{"type":"codeVoice","code":"sourcePosition"},{"type":"text","text":" represents the start of an"},{"type":"text","text":" "},{"type":"text","text":"extended grapheme cluster—the element type of a string—then the"},{"type":"text","text":" "},{"type":"text","text":"initializer succeeds."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example converts the position of the Unicode scalar "},{"code":"\"e\"","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"into its corresponding position in the string. The character at that"},{"type":"text","text":" "},{"type":"text","text":"position is the composed "},{"code":"\"é\"","type":"codeVoice"},{"text":" character.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let cafe = \"Cafe\\u{0301}\"","print(cafe)","\/\/ Prints \"Café\"","","let scalarsIndex = cafe.unicodeScalars.firstIndex(of: \"e\")!","let stringIndex = String.Index(scalarsIndex, within: cafe)!","","print(cafe[...stringIndex])","\/\/ Prints \"Café\""],"type":"codeListing"},{"inlineContent":[{"text":"If the index passed as ","type":"text"},{"code":"sourcePosition","type":"codeVoice"},{"text":" doesn’t have an exact","type":"text"},{"text":" ","type":"text"},{"text":"corresponding position in ","type":"text"},{"code":"target","type":"codeVoice"},{"text":", the result of the initializer is","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". For example, an attempt to convert the position of the combining","type":"text"},{"text":" ","type":"text"},{"text":"acute accent (","type":"text"},{"code":"\"\\u{0301}\"","type":"codeVoice"},{"text":") fails. Combining Unicode scalars do not have","type":"text"},{"text":" ","type":"text"},{"text":"their own position in a string.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let nextScalarsIndex = cafe.unicodeScalars.index(after: scalarsIndex)","let nextStringIndex = String.Index(nextScalarsIndex, within: cafe)","","print(nextStringIndex)","\/\/ Prints \"nil\""],"type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"Creates an index in the given string that corresponds exactly to the","type":"text"},{"text":" ","type":"text"},{"text":"specified position.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/String","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index\/init(_:within:)-2u3iq"},"references":{"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title