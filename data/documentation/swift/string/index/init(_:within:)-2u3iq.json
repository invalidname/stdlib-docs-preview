n the","type":"text"},{"text":" ","type":"text"},{"text":"initializer succeeds.","type":"text"}]},{"inlineContent":[{"text":"The following example converts the position of the Unicode scalar ","type":"text"},{"code":"\"e\"","type":"codeVoice"},{"text":" ","type":"text"},{"text":"into its corresponding position in the string. The character at that","type":"text"},{"text":" ","type":"text"},{"text":"position is the composed ","type":"text"},{"code":"\"é\"","type":"codeVoice"},{"text":" character.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let cafe = \"Cafe\\u{0301}\"","print(cafe)","\/\/ Prints \"Café\"","","let scalarsIndex = cafe.unicodeScalars.firstIndex(of: \"e\")!","let stringIndex = String.Index(scalarsIndex, within: cafe)!","","print(cafe[...stringIndex])","\/\/ Prints \"Café\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If the index passed as "},{"type":"codeVoice","code":"sourcePosition"},{"type":"text","text":" doesn’t have an exact"},{"type":"text","text":" "},{"type":"text","text":"corresponding position in "},{"type":"codeVoice","code":"target"},{"type":"text","text":", the result of the initializer is"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". For example, an attempt to convert the position of the combining"},{"type":"text","text":" "},{"type":"text","text":"acute accent ("},{"type":"codeVoice","code":"\"\\u{0301}\""},{"type":"text","text":") fails. Combining Unicode scalars do not have"},{"type":"text","text":" "},{"type":"text","text":"their own position in a string."}],"type":"paragraph"},{"syntax":"swift","code":["let nextScalarsIndex = cafe.unicodeScalars.index(after: scalarsIndex)","let nextStringIndex = String.Index(nextScalarsIndex, within: cafe)","","print(nextStringIndex)","\/\/ Prints \"nil\""],"type":"codeListing"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index\/init(_:within:)-2u3iq","interfaceLanguage