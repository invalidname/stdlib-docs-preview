{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index\/init(_:within:)-2u3iq"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"?(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"sourcePosition","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String","text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":".","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS5IndexV","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index","text":"Index"},{"kind":"text","text":", "},{"kind":"externalParam","text":"within"},{"kind":"text","text":" "},{"kind":"internalParam","text":"target"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String","text":"String"},{"kind":"text","text":")"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"A position in a view of the ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" parameter.","type":"text"},{"text":" ","type":"text"},{"code":"sourcePosition","type":"codeVoice"},{"text":" must be a valid index of at least one of the views","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"target","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"sourcePosition"},{"content":[{"inlineContent":[{"text":"The string referenced by the resulting index.","type":"text"}],"type":"paragraph"}],"name":"target"}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"If the index passed as ","type":"text"},{"code":"sourcePosition","type":"codeVoice"},{"text":" represents the start of an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"extended grapheme cluster—the element type of a string—then the"},{"type":"text","text":" "},{"type":"text","text":"initializer succeeds."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example converts the position of the Unicode scalar "},{"code":"\"e\"","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"into its corresponding position in the string. The character at that"},{"type":"text","text":" "},{"type":"text","text":"position is the composed "},{"code":"\"é\"","type":"codeVoice"},{"type":"text","text":" character."}],"type":"paragraph"},{"syntax":"swift","code":["let cafe = \"Cafe\\u{0301}\"","print(cafe)","\/\/ Prints \"Café\"","","let scalarsIndex = cafe.unicodeScalars.firstIndex(of: \"e\")!","let stringIndex = String.Index(scalarsIndex, within: cafe)!","","print(cafe[...stringIndex])","\/\/ Prints \"Café\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If the index passed as "},{"code":"sourcePosition","type":"codeVoice"},{"type":"text","text":" doesn’t have an exact"},{"type":"text","text":" "},{"type":"text","text":"corresponding position in "},{"code":"target","type":"codeVoice"},{"type":"text","text":", the result of the initializer is"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":". For example, an attempt to convert the position of the combining"},{"type":"text","text":" "},{"type":"text","text":"acute accent ("},{"code":"\"\\u{0301}\"","type":"codeVoice"},{"type":"text","text":") fails. Combining Unicode scalars do not have"},{"type":"text","text":" "},{"type":"text","text":"their own position in a string."}],"type":"paragraph"},{"syntax":"swift","code":["let nextScalarsIndex = cafe.unicodeScalars.index(after: scalarsIndex)","let nextStringIndex = String.Index(nextScalarsIndex, within: cafe)","","print(nextStringIndex)","\/\/ Prints \"nil\""],"type":"codeListing"}],"kind":"content"}],"vari