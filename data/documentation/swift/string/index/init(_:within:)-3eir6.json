 the resulting index."}],"type":"paragraph"}],"name":"target"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the index passed as "},{"code":"sourcePosition","type":"codeVoice"},{"type":"text","text":" represents the start of an"},{"type":"text","text":" "},{"type":"text","text":"extended grapheme cluster—the element type of a string—then the"},{"type":"text","text":" "},{"type":"text","text":"initializer succeeds."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example converts the position of the Unicode scalar "},{"code":"\"e\"","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"into its corresponding position in the string. The character at that"},{"type":"text","text":" "},{"type":"text","text":"position is the composed "},{"code":"\"é\"","type":"codeVoice"},{"type":"text","text":" character."}]},{"code":["let cafe = \"Cafe\\u{0301}\"","print(cafe)","\/\/ Prints \"Café\"","","let scalarsIndex = cafe.unicodeScalars.firstIndex(of: \"e\")!","let stringIndex = String.Index(scalarsIndex, within: cafe)!","","print(cafe[...stringIndex])","\/\/ Prints \"Café\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the index passed as "},{"code":"sourcePosition","type":"codeVoice"},{"type":"text","text":" doesn’t have an exact"},{"type":"text","text":" "},{"type":"text","text":"corresponding position in "},{"code":"target","type":"codeVoice"},{"type":"text","text":", the result of the initializer is"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"text":". For example, an attempt to convert the position of the combining","type":"text"},{"text":" ","type":"text"},{"text":"acute accent (","type":"text"},{"type":"codeVoice","code":"\"\\u{0301}\""},{"text":") fails. Combining Unicode scalars do not have","type":"text"},{"text":" ","type":"text"},