{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index\/init(_:within:)-3eir6","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Creates an index in the given string that corresponds exactly to the"},{"type":"text","text":" "},{"type":"text","text":"specified position."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"?<","kind":"text"},{"kind":"genericParameter","text":"S"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"sourcePosition","kind":"internalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String","preciseIdentifier":"s:SS","text":"String"},{"text":".","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index","preciseIdentifier":"s:SS5IndexV","text":"Index"},{"text":", ","kind":"text"},{"text":"within","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"target","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS5IndexV_6withinABSgAB_xtcSyRzlufc1SL_xmfp","text":"S","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sy","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/StringProtocol","text":"StringProtocol","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"sourcePosition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A position in a view of the "},{"type":"codeVoice","code":"target"},{"type":"text","text":" parameter."},{"type":"text","text":" "},{"type":"codeVoice","code":"sourcePosition"},{"type":"text","text":" must be a valid index of at least one of the views"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"target"},{"type":"text","text":"."}]}]},{"name":"target","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The string referenced by the resulting index."}]}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"If the index passed as "},{"type":"codeVoice","code":"sourcePosition"},{"type":"text","text":" represents the start of an"},{"type":"text","text":" "},{"type":"text","text":"extended grapheme cluster—the element type of a string—then the"},{"type":"text","text":" "},{"type":"text","text":"initializer succeeds."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example converts the position of the Unicode scalar "},{"type":"codeVoice","code":"\"e\""},{"type":"text","text":" "},{"type":"text","text":"into its corresponding position in the string. The character at that"},{"type":"text","text":" "},{"type":"text","text":"position is the composed "},{"type":"codeVoice","code":"\"é\""},{"type":"text","text":" character."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let cafe = \"Cafe\\u{0301}\"","print(cafe)","\/\/ Prints \"Café\"","","let scalarsIndex = cafe.unicodeScalars.firstIndex(of: \"e\")!","let stringIndex = String.Index(scalarsIndex, within: cafe)!","","print(cafe[...stringIndex])","\/\/ Prints \"Café\""]},{"inlineContent":[{"type":"text","text":"If the index passed as "},{"type":"codeVoice","code":"sourcePosition"},{"type":"text","text":" doesn’t have an exact"},{"type":"text","text":" "},{"type":"text","text":"corresponding position in "},{"type":"codeVoice","code":"target"},{"type":"text","text":", the result of the initializer is"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". For example, an attempt to convert the position of the combining"},{"type":"text","text":" "},{"type":"text","text":"acute accent ("},{"type":"codeVoice","code":"\"\\u{0301}\""},{"type":"text","text":") fails. Combining Unicode scalars do not have"},{"type":"text","text":" "},{"type":"text","text":"their own position in a string."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let nextScalarsIndex = cafe.unicodeScalars.index(after: scalarsIndex)","let nextStringIndex = String.Index(nextScalarsIndex, within: cafe)","","print(nextStringIndex)","\/\/ Prints \"nil\""]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/string\/index\/init(_:within:)-3eir6"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/String","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index"]]},"metadata":{"role":"symbol","roleHeading":"Initializer","modules":[{"name":"Standard Library"}],"title":"init(_:within:)","externalID":"s:SS5IndexV_6withinABSgAB_xtcSyRzlufc","extendedModule":"Swift","platforms":[{"introducedAt":"8.0","name":"iOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"8.0","name":"iPadOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"13.0","name":"Mac Catalyst","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"10.10","deprecated":false,"unavailable":false,"name":"macOS","beta":false},{"introducedAt":"9.0","deprecated":false,"unavailable":false,"name":"tvOS","beta":false},{"introducedAt":"1.0","deprecated":false,"unavailable":false,"name":"visionOS","beta":false},{"introducedAt":"2.0","deprecated":false,"unavailable":false,"name":"watchOS","beta":false}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"."},{"kind":"typeIdentifier","tex