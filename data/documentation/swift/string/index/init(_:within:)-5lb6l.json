{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/String","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index"]]},"abstract":[{"text":"Creates an index in the given UTF-8 view that corresponds exactly to the","type":"text"},{"text":" ","type":"text"},{"text":"specified ","type":"text"},{"code":"UTF16View","type":"codeVoice"},{"text":" position.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"idx"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:SS5IndexV","text":"Index","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index"},{"kind":"text","text":", "},{"kind":"externalParam","text":"within"},{"kind":"text","text":" "},{"kind":"internalParam","text":"target"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:SS8UTF8ViewV","text":"UTF8View","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View"},{"kind":"text","text":")"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"idx","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A position in a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or one of its views."}]}]},{"name":"target","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"UTF8View"},{"type":"text","text":" in which to find the new position."}]}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example finds the position of a space in a string’s "},{"code":"utf16","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"view and then converts that position to an index in the string’s"},{"type":"text","text":" "},{"code":"utf8","type":"codeVoice"},{"type":"text","text":" view."}]},{"code":["let cafe = \"Café 🍵\"","","let utf16Index = cafe.utf16.firstIndex(of: 32)!","let utf8Index = String.UTF8View.Index(utf16Index, within: cafe.utf8)!","","print(Array(cafe.utf8[..<utf8Index]))","\/\/ Prints \"[67, 97, 102, 195, 169]\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the position passed in "},{"code":"utf16Index","type":"codeVoice"},{"type":"text","text":" doesn’t have an exact"},{"type":"text","text":" "},{"type":"text","text":"corresponding position in "},{"code":"utf8","type":"codeVoice"},{"type":"text","text":", the result of the initializer is"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":". For example, because UTF-8 and UTF-16 represent high Unicode code"},{"type":"text","text":" "},{"type":"text","text":"points differently, an attempt to convert the position of the trailing"},{"type":"text","text":" "},{"type":"text","text":"surrogate of a UTF-16 surrogate pair fails."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The next example attempts to convert the indices of the two UTF-16 code"},{"type":"text","text":" "},{"type":"text","text":"points that represent the teacup emoji ("},{"code":"\"🍵\"","type":"codeVoice"},{"type":"text","text":"). The index of the lead"},{"type":"text","text":" "},{"type":"text","text":"surrogate is successfully converted to a position in "},{"code":"utf8","type":"codeVoice"},{"type":"text","text":", but the"},{"type":"text","text":" "},{"type":"text","text":"index of the trailing surrogate is not."}]},{"code":["let emojiHigh = cafe.utf16.index(after: utf16Index)","print(String.UTF8View.Index(emojiHigh, within: cafe.utf8))","\/\/ Prints \"Optional(String.Index(...))\"","","let emojiLow = cafe.utf16.index(after: emojiHigh)","print(String.UTF8View.Index(emojiLow, within: cafe.utf8))","\/\/ Prints \"nil\""],"type":"codeListing","syntax":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index\/init(_:within:)-5lb6l","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/string\/index\/init(_:within:)-5lb6l"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"roleHeading":"Initializer","externalID":"s:SS5IndexV_6withinABSgAB_SS8UTF8ViewVtcfc","symbolKind":"init","title":"init(_:within:)","extendedModule":"Swift","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:SS5IndexV"},{"text":", ","kind":"text"},{"text":"within","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":".","kind":"text"},{"text":"UTF8View","kind":"typeIdentifier","preciseIdentifier":"s:SS8UTF8ViewV"},{"text":")","kind":"text"}],"modules":[{"name":"Swift"}],"platforms":[{"deprecated":false,"unavailable":false,"introducedAt":"8.0","name":"iOS","beta":false},{"deprecated":false,"unavailable":false,"introducedAt":"8.0","name":"iPadOS","beta":false},{"deprecated":false,"unavailable":false,"introducedAt":"13.0","name":"Mac Catalyst","beta":false},{"deprecated":false,"unavailable":false,"introducedAt":"10.10","name":"macOS","beta":false},{"deprecated":false,"unavailable":false,"introducedAt":"9.0","name":"tvO