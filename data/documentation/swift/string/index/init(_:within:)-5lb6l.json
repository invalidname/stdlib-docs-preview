16.index(after: emojiHigh)","print(String.UTF8View.Index(emojiLow, within: cafe.utf8))","\/\/ Prints \"nil\""],"syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/swift\/string\/index\/init(_:within:)-5lb6l"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Creates an index in the given UTF-8 view that corresponds exactly to the"},{"type":"text","text":" "},{"type":"text","text":"specified "},{"type":"codeVoice","code":"UTF16View"},{"type":"text","text":" position."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/String","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index"]]},"kind":"symbol","sections":[],"metadata":{"extendedModule":"Swift","externalID":"s:SS5IndexV_6withinABSgAB_SS8UTF8ViewVtcfc","modules":[{"name":"Swift"}],"role":"symbol","symbolKind":"init","title":"init(_:within:)","platforms":[{"name":"iOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"8.0"},{"name":"iPadOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"8.0"},{"name":"Mac Catalyst","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"13.0"},{"name":"macOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"10.10"},{"name":"tvOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"9.0"},{"name":"visionOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"1.0"},{"name":"watchOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"2.0"}],"roleHeading":"Initializer","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:SS5IndexV","text":"Index"},{"kind":"text","text":", "},{"kind":"externalParam","text":"within"},{"kind":"text","text":": "},{"