{"text":" ","type":"text"},{"text":"surrogate is successfully converted to a position in ","type":"text"},{"code":"utf8","type":"codeVoice"},{"text":", but the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"index of the trailing surrogate is not."}]},{"type":"codeListing","syntax":"swift","code":["let emojiHigh = cafe.utf16.index(after: utf16Index)","print(String.UTF8View.Index(emojiHigh, within: cafe.utf8))","\/\/ Prints \"Optional(String.Index(...))\"","","let emojiLow = cafe.utf16.index(after: emojiHigh)","print(String.UTF8View.Index(emojiLow, within: cafe.utf8))","\/\/ Prints \"nil\""]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/string\/index\/init(_:within:)-5lb6l"]}],"kind":"symbol","metadata":{"extendedModule":"Swift","role":"symbol","title":"init(_:within:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:SS5IndexV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"within"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"UTF8View","preciseIdentifier":"s:SS8UTF8ViewV"},{"kind":"text","text":")"}],"modules":[{"name":"Standard Library"}],"externalID":"s:SS5IndexV_6withinABSgAB_SS8UTF8ViewVtcfc","symbolKind":"init","roleHeading":"Initializer","platforms":[{"deprecated":false,"introducedAt":"8.0","beta":false,"unavailable":false,"name":"iOS"},{"deprecated":false,"introducedAt":"8.0","beta":false,"unavailable":false,"name":"iPadOS"},{"deprecated":false,"introducedAt":"13.0","beta":false,"unavailable":false,"name":"Mac Catalyst"},{"deprecated":false,"introducedAt":"10.10","beta":false,"unavailable":false,"name":"macOS"},{"deprecated":false,"introducedAt":"9.0","beta":false,"unavai