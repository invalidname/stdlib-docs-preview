{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","abstract":[{"type":"text","text":"Creates an index in the given UTF-8 view that corresponds exactly to the"},{"text":" ","type":"text"},{"type":"text","text":"specified "},{"code":"UTF16View","type":"codeVoice"},{"text":" position.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/string\/index\/init(_:within:)-5lb6l"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"?("},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"text":"idx","kind":"internalParam"},{"kind":"text","text":": "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String","preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"."},{"text":"Index","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index","kind":"typeIdentifier","preciseIdentifier":"s:SS5IndexV"},{"text":", ","kind":"text"},{"text":"within","kind":"externalParam"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"target"},{"kind":"text","text":": "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String","kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"."},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View","kind":"typeIdentifier","text":"UTF8View","preciseIdentifier":"s:SS8UTF8ViewV"},{"kind":"text","text":")"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"idx","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A position in a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or one of its views."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"UTF8View","type":"codeVoice"},{"type":"text","text":" in which to find the new position."}]}],"name":"target"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example finds the position of a space in a string’s "},{"type":"codeVoice","code":"utf16"},{"type":"text","text":" "},{"text":"view and then converts that position to an index in the string’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"utf8"},{"text":" view.","type":"text"}]},{"type":"codeListing","code":["let cafe = \"Café 🍵\"","","let utf16Index = cafe.utf16.firstIndex(of: 32)!","let utf8Index = String.UTF8View.Index(utf16Index, within: cafe.utf8)!","","print(Array(cafe.utf8[..<utf8Index]))","\/\/ Prints \"[67, 97, 102, 195, 169]\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the position passed in "},{"type":"codeVoice","code":"utf16Index"},{"type":"text","text":" doesn’t have an exact"},{"type":"text","text":" "},{"type":"text","text":"corresponding position in "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":", the result of the initializer is"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". For example, because UTF-8 and UTF-16 represent high Unicode code"},{"type":"text","text":" "},{"type":"text","text":"points differently, an attempt to convert the position of the trailing"},{"text":" ","type":"text"},{"type":"text","text":"surrogate of a UTF-16 surrogate pair fails."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The next example attempts to convert the indices of the two UTF-16 code"},{"type":"text","text":" "},{"type":"text","text":"points that represent the teacup emoji ("},{"type":"codeVoice","code":"\"🍵\""},{"type":"text","text":"). The index of the lead"},{"text":" ","type":"text"},{"text":"surrogate is successfully converted to a position in ","type":"text"},{"type":"codeVoice","code":"utf8"},{"type":"text","text":", but the"},{"type":"text","text":" "},{"type":"text","text":"index of the trailing surrogate is not."}]},{"syntax":"swift","type":"codeListing","code":["let emojiHigh = cafe.utf16.index(after: utf16Index)","print(String.UTF8View.Index(emojiHigh, within: cafe.utf8))","\/\/ Prints \"Optional(String.Index(...))\"","","let emojiLow = cafe.utf16.index(after: emojiHigh)","print(String.UTF8View.Index(emojiLow, within: cafe.utf8))","\/\/ Prints \"nil\""]}],"kind":"content"}],"sections":[],"metadata":{"externalID":"s:SS5IndexV_6withinABSgAB_SS8UTF8ViewVtcfc","fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:SS5IndexV","text":"Index","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"within"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"."},{"preciseIdentifier":"s:SS8UTF8ViewV","kind":"typeIdentifier","text":"UTF8View"},{"kind":"text","text":")"}],"platforms":[{"introducedAt":"8.0","beta":false,"name":"iOS","unavailable":false,"deprecated":false},{"introducedAt":"8.0","beta":false,"name":"iPadOS","unavailable":false,"deprecated":false},{"introducedAt":"13.0","beta":false,"name":"Mac Catalyst","unavailable":false,"deprecated":false},{"unavailable":false,"beta":false,"deprecated":false,"name":"macOS","introducedAt":"10.10"},{"deprecated":false,"unavailable":false,"beta":false,"name":"tvOS","introducedAt":"9.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"visionOS","introducedAt":"1.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"watchOS","introducedAt":"2.0"}],"role":"symbol","symbolKind":"init","roleHeading":"Initializer","modules":[{"name":"Swift"}],"extendedModule":"Swift","title":"init(_:within:)"},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index\/init(_:within:)-5lb6l","interfaceLanguage