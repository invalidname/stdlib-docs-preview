":"codeVoice"},{"text":", the result of the initializer is","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". For example, because UTF-8 and UTF-16 represent high Unicode code","type":"text"},{"text":" ","type":"text"},{"text":"points differently, an attempt to convert the position of the trailing","type":"text"},{"text":" ","type":"text"},{"text":"surrogate of a UTF-16 surrogate pair fails.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The next example attempts to convert the indices of the two UTF-16 code","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"points that represent the teacup emoji ("},{"type":"codeVoice","code":"\"🍵\""},{"type":"text","text":"). The index of the lead"},{"type":"text","text":" "},{"text":"surrogate is successfully converted to a position in ","type":"text"},{"code":"utf8","type":"codeVoice"},{"text":", but the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"index of the trailing surrogate is not."}],"type":"paragraph"},{"type":"codeListing","code":["let emojiHigh = cafe.utf16.index(after: utf16Index)","print(String.UTF8View.Index(emojiHigh, within: cafe.utf8))","\/\/ Prints \"Optional(String.Index(...))\"","","let emojiLow = cafe.utf16.index(after: emojiHigh)","print(String.UTF8View.Index(emojiLow, within: cafe.utf8))","\/\/ Prints \"nil\""],"syntax":"swift"}],"kind":"content"}],"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Creates an index in the given UTF-8 view that corresponds exactly to the"},{"type":"text","text":" "},{"type":"text","text":"specified "},{"code":"UTF16View","type":"codeVoice"},{"type":"text","text":" position."}],"variants":[{"paths":["\/documentation\/swift\/string\/index\/init(_:within:)-5lb6l"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index\/init(_:within:)-5lb6l","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,