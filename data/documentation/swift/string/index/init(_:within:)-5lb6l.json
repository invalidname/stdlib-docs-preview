ew"},{"text":" position.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/swift\/string\/index\/init(_:within:)-5lb6l"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"idx"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:SS5IndexV","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index"},{"kind":"text","text":", "},{"kind":"externalParam","text":"within"},{"kind":"text","text":" "},{"kind":"internalParam","text":"target"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"UTF8View","preciseIdentifier":"s:SS8UTF8ViewV","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View"},{"kind":"text","text":")"}]}],"kind":"declarations"},{"parameters":[{"name":"idx","content":[{"inlineContent":[{"text":"A position in a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" or one of its views.","type":"text"}],"type":"paragraph"}]},{"name":"target","content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"UTF8View","type":"codeVoice"},{"text":" in which to find the new position.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"text":"The following example finds the position of a space in a string’s ","type":"text"},{"code":"utf16","type":"codeVoice"},{"text":" ","type":"text"},{"text":"view and then converts that position to an index in the string’s","type":"text"},{"text":" ","type":"text"},{"code":"utf8","type":"codeVoice"},{"text":" view.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let cafe = \"Café 🍵\"","","let utf16Index = cafe.utf16.firstIndex(of: 32)!","let utf8Index = String.UTF8View.Index(utf16Index, within: cafe.utf8)!","","print(Array(cafe.utf8[..<utf8Index]))","\/\/ Prints \"[67, 97, 102, 195, 169]\""],"type":"codeListing"},{"inlineContent":[{"text":"If the position passed in ","type":"text"},{"code":"utf16Index","type":"codeVoice"},{"text":" doesn’t have an exact","type":"text"},{"text":" ","type":"text"},{"text":"corresponding position in ","type":"text"},{"code":"utf8","type":"codeVoice"},{"text":", the result of the initializer is","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". For example, because UTF-8 and UTF-16 represent high Unicode code","type":"text"},{"text":" ","type":"text"},{"text":"points differently, an attempt to convert the position of the trailing","type":"text"},{"text":" ","type":"text"},{"text":"surrogate of a UTF-16 surrogate pair fails.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The next example attempts to convert the indices of the two UTF-16 code","type":"text"},{"text":" ","type":"text"},{"text":"points that represent the teacup emoji (","type":"text"},{"code":"\"🍵\"","type":"codeVoice"},{"text":"). The index of the lead","type":"text"},{"text":" ","type":"text"},{"text":"surrogate is successfully converted to a position in ","type":"text"},{"code":"utf8","type":"codeVoice"},{"text":", but the","type":"text"},{"text":" ","type":"text"},{"text":"index of the trailing surrogate is not.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let emojiHigh = cafe.utf16.index(after: utf16Index)","print(String.UTF8View.Index(emojiHigh, within: cafe.utf8))","\/\/ Prints \"Optional(String.Index(...))\"","","let emojiLow = cafe.utf16.index(after: emojiHigh)","print(String.UTF8View.Index(emojiLow, within: cafe.utf8))","\/\/ Prints \"nil\""],"type":"codeListing"}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/String":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"String"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String","kind":"symbol","abstract":[{"text":"A Unicode string value that is a collection of characters.","type":"text"}],"title":"String","role":"symbol","navigatorTitle":[{"text":"String","kind":"identifier"}],"url":"\/documentation\/swift\/string"},"doc://com.apple.Swift/documentation/Swift/String/Index":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Index"}],"title":"String.Index","navigatorTitle":[{"kind":"identifier","text":"Index"}],"url":"\/documentation\/swift\/string\/index","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A position of a character or code unit in a string."}]},"doc://com.apple.Swift/documentation/Swift/String/UTF8View":{"abstract":[{"type":"text","text":"A view of a string’s contents as a collection of UTF-8 code units."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UTF8View"}],"type":"topic","url":"\/documentation\/swift\/string\/utf8view","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"UTF8View"}],"title":"String.UTF8View","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View"},"doc://com.apple.Swift/documentation/Swift/String/Index/init(_:within:)-5lb6l":{"type":"topic","kind":"symbol","role":"symbol","abstract":[{"text":"Creates an index in the given UTF-8 view that corresponds exactly to the","ty