om.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/String"]]},"seeAlsoSections":[{"generated":true,"title":"Related String Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring","doc:\/\/com.apple.Swift\/documentation\/Swift\/StringProtocol","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/CharacterView","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UnicodeScalarView","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Output"],"anchor":"Related-String-Types"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF16View","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF16View\/customPlaygroundQuickLook"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF16View\/isTriviallyIdentical(to:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF16View\/BidirectionalCollection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF16View\/Collection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF16View\/CustomDebugStringConvertible-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF16View\/CustomReflectable-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF16View\/CustomStringConvertible-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF16View\/Sequence-Implementations"],"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UTF16View","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"You can access a string’s view of UTF-16 code units by using its "},{"type":"codeVoice","code":"utf16"},{"type":"text","text":" "},{"type":"text","text":"property. A string’s UTF-16 view encodes the string’s Unicode scalar"},{"type":"text","text":" "},{"type":"text","text":"values as 16-bit integers."}],"type":"paragraph"},{"code":["let flowers = \"Flowers 💐\"","for v in flowers.utf16 {","    print(v)","}","\/\/ 70","\/\/ 108","\/\/ 111","\/\/ 119","\/\/ 101","\/\/ 114","\/\/ 115","\/\/ 32","\/\/ 55357","\/\/ 56464"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Unicode scalar values that make up a string’s contents can be up to 21"},{"type":"text","text":" "},{"type":"text","text":"bits long. The longer scalar values may need two "},{"type":"codeVoice","code":"UInt16"},{"type":"text","text":" values for"},{"type":"text","text":" "},{"type":"text","text":"storage. Those “pairs” of code units are called "},{"type":"emphasis","inlineContent":[{"type":"text","text":"surrogate pairs"}]},{"type":"text","text":"."}],"type":"paragraph"},{"code":["let flowermoji = \"💐\"","for v in flowermoji.unicodeScalars {","    print(v, v.value)","}","\/\/ 💐 128144","","for v in flowermoji.utf16 {","    print(v)","}","\/\/ 55357","\/\/ 56464"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"To convert a "},{"type":"codeVoice","code":"String.UTF16View"},{"type":"text","text":" instance back into a string, use the"},{"type":"text","text":" "},{"type":"codeVoice","code":"String"},{"type":"text","text":" type’s "},{"type":"codeVoice","code":"init(_:)"},{"type":"text","text":" initializer."}],"type":"paragraph"},{"code":["let favemoji = \"My favorite emoji is 🎉\"","if let i = favemoji.utf16.firstIndex(where: { $0 >= 128 }) {","    let asciiPrefix = String(favemoji.utf16[..<i])!","    print(asciiPrefix)","}","\/\/ Prints \"My favorite emoji is \""],"syntax":"swift","type":"codeListing"},{"level":1,"text":"UTF16View Elements Match NSString Characters","type":"heading","anchor":"UTF16View-Elements-Match-NSString-Characters"},{"inlineContent":[{"type":"text","text":"The UTF-16 code units of a string’s "},{"type":"codeVoice","code":"utf16"},{"type":"text","text":" view match the elements"},{"type":"text","text":" "},{"type":"text","text":"accessed through indexed "},{"type":"codeVoice","code":"NSString"},{"type":"text","text":" APIs."}],"type":"paragraph"},{"code":["print(flowers.utf16.count)","\/\/ Prints \"10\"","","let nsflowers = flowers as NSString","print(nsflowers.length)","\/\/ Prints \"10\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"NSString"},{"type":"text","text":", however, "},{"type":"codeVoice","code":"String.UTF16View"},{"type":"text","text":" does not use integer"},{"type":"text","text":" "},{"type":"text","text":"indices. If you need to access a specific position in a UTF-16 view, use"},{"type":"text","text":" "},{"type":"text","text":"Swift’s index manipulation methods. The following example accesses the"},{"type":"text","text":" "},{"type":"text","text":"fourth code unit in both the "},{"type":"codeVoice","code":"flowers"},{"type":"text","text":" and "},{"type":"codeVoice","code":"nsflowers"},{"type":"text","text":" strings:"}],"type":"paragraph"},{"code":["print(nsflowers.character(at: 3))","\/\/ Prints \"119\"","","let i = flowers.utf16.index(flowers.utf16.startIndex, offsetBy: 3)","print(flowers.utf16[i])","\/\/ Prints \"119\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Although the Swift overlay updates many Objective-C methods to return"},{"type":"text","text":" "},{"type":"text","text":"native Swift indices and index ranges, some still return instances of"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSRange"},{"type":"text","text":". To convert an "},{"type":"codeVoice","code":"NSRange"},{"type":"text","text":" instance to a range of"},{"type":"text","text":" "},{"type":"codeVoice","code":"String.Index"},{"type":"text","text":", use the "},{"type":"codeVoice","code":"Range(_:in:)"},{"type":"text","text":" initializer, which takes an"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSRange"},{"type":"text","text":" and a string as arguments."}],"type":"paragraph"},{"code":["let snowy = \"❄️ Let it snow! ☃️\"","let nsrange = NSRange(location: 3, length: 12)","if let range = Range(nsrange, in: snowy) {","    print(snowy[range])","}","\/\/ Prints \"Let it snow!\""],"syntax":"swift","type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/string\/utf16view"]}],"references":{"doc://com.apple.Swift/documentation/Swift":{"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","title":"Swift","url":"\/documentation\/swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"images":[{"identifier":"Swift-PageImage-card.png","type":"card"}],"kind":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/Swift/String/CharacterView":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CharacterView"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/CharacterView","title":"String.CharacterView","url":"\/documentation\/swift\/string\/characterview","abstract":[{"type":"text","text":"A view of a string’s contents as a collection of characters."}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier