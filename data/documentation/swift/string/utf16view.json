{"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Escapable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UTF16View"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"text":"You can access a string’s view of UTF-16 code units by using its ","type":"text"},{"code":"utf16","type":"codeVoice"},{"text":" ","type":"text"},{"text":"property. A string’s UTF-16 view encodes the string’s Unicode scalar","type":"text"},{"text":" ","type":"text"},{"text":"values as 16-bit integers.","type":"text"}],"type":"paragraph"},{"code":["let flowers = \"Flowers 💐\"","for v in flowers.utf16 {","    print(v)","}","\/\/ 70","\/\/ 108","\/\/ 111","\/\/ 119","\/\/ 101","\/\/ 114","\/\/ 115","\/\/ 32","\/\/ 55357","\/\/ 56464"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Unicode scalar values that make up a string’s contents can be up to 21"},{"type":"text","text":" "},{"type":"text","text":"bits long. The longer scalar values may need two "},{"type":"codeVoice","code":"UInt16"},{"type":"text","text":" values for"},{"type":"text","text":" "},{"type":"text","text":"storage. Those “pairs” of code units are called "},{"inlineContent":[{"type":"text","text":"surrogate pairs"}],"type":"emphasis"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["let flowermoji = \"💐\"","for v in flowermoji.unicodeScalars {","    print(v, v.value)","}","\/\/ 💐 128144","","for v in flowermoji.utf16 {","    print(v)","}","\/\/ 55357","\/\/ 56464"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"To convert a ","type":"text"},{"code":"String.UTF16View","type":"codeVoice"},{"text":" instance back into a string, use the","type":"text"},{"text":" ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" type’s ","type":"text"},{"code":"init(_:)","type":"codeVoice"},{"text":" initializer.","type":"text"}],"type":"paragraph"},{"code":["let favemoji = \"My favorite emoji is 🎉\"","if let i = favemoji.utf16.firstIndex(where: { $0 >= 128 }) {","    let asciiPrefix = String(favemoji.utf16[..<i])!","    print(asciiPrefix)","}","\/\/ Prints \"My favorite emoji is \""],"type":"codeListing","syntax":"swift"},{"level":1,"anchor":"UTF16View-Elements-Match-NSString-Characters","type":"heading","text":"UTF16View Elements Match NSString Characters"},{"inlineContent":[{"text":"The UTF-16 code units of a string’s ","type":"text"},{"type":"codeVoice","code":"utf16"},{"text":" view match the elements","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"accessed through indexed "},{"code":"NSString","type":"codeVoice"},{"type":"text","text":" APIs."}],"type":"paragraph"},{"code":["print(flowers.utf16.count)","\/\/ Prints \"10\"","","let nsflowers = flowers as NSString","print(nsflowers.length)","\/\/ Prints \"10\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"NSString"},{"type":"text","text":", however, "},{"type":"codeVoice","code":"String.UTF16View"},{"type":"text","text":" does not use integer"},{"type":"text","text":" "},{"type":"text","text":"indices. If you need to access a specific position in a UTF-16 view, use"},{"type":"text","text":" "},{"type":"text","text":"Swift’s index manipulation methods. The following example accesses the"},{"type":"text","text":" "},{"type":"text","text":"fourth code unit in both the "},{"type":"codeVoice","code":"flowers"},{"type":"text","text":" and "},{"type":"codeVoice","code":"nsflowers"},{"type":"text","text":" strings:"}],"type":"paragraph"},{"code":["print(nsflowers.character(at: 3))","\/\/ Prints \"119\"","","let i = flowers.utf16.index(flowers.utf16.startIndex, offsetBy: 3)","print(flowers.utf16[i])","\/\/ Prints \"119\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Although the Swift overlay updates many Objective-C methods to return"},{"type":"text","text":" "},{"text":"native Swift indices and index ranges, some still return instances of","type":"text"},{"text":" ","type":"text"},{"code":"NSRange","type":"codeVoice"},{"text":". To convert an ","type":"text"},{"code":"NSRange","type":"codeVoice"},{"text":" instance to a range of","type":"text"},{"text":" ","type":"text"},{"code":"String.Index","type":"codeVoice"},{"text":", use the ","type":"text"},{"code":"Range(_:in:)","type":"codeVoice"},{"text":" initializer, which takes an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NSRange"},{"text":" and a string as arguments.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let snowy = \"❄️ Let it snow! ☃️\"","let nsrange = NSRange(location: 3, length: 12)","if let range = Range(nsrange, in: snowy) {","    print(snowy[range])","}","\/\/ Prints \"Let it snow!\""]}],"kind":"content"}],"topicSections":[{"anchor":"Instance-Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF16View\/customPlaygroundQuickLook"],"title":"Instance Properties","generated":true},{"anchor":