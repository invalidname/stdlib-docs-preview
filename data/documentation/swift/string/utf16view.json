{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UTF16View"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"You can access a string’s view of UTF-16 code units by using its "},{"code":"utf16","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"property. A string’s UTF-16 view encodes the string’s Unicode scalar"},{"type":"text","text":" "},{"type":"text","text":"values as 16-bit integers."}],"type":"paragraph"},{"syntax":"swift","code":["let flowers = \"Flowers 💐\"","for v in flowers.utf16 {","    print(v)","}","\/\/ 70","\/\/ 108","\/\/ 111","\/\/ 119","\/\/ 101","\/\/ 114","\/\/ 115","\/\/ 32","\/\/ 55357","\/\/ 56464"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Unicode scalar values that make up a string’s contents can be up to 21"},{"type":"text","text":" "},{"type":"text","text":"bits long. The longer scalar values may need two "},{"code":"UInt16","type":"codeVoice"},{"type":"text","text":" values for"},{"type":"text","text":" "},{"type":"text","text":"storage. Those “pairs” of code units are called "},{"type":"emphasis","inlineContent":[{"text":"surrogate pairs","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["let flowermoji = \"💐\"","for v in flowermoji.unicodeScalars {","    print(v, v.value)","}","\/\/ 💐 128144","","for v in flowermoji.utf16 {","    print(v)","}","\/\/ 55357","\/\/ 56464"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"To convert a "},{"code":"String.UTF16View","type":"codeVoice"},{"type":"text","text":" instance back into a string, use the"},{"type":"text","text":" "},{"code":"String","type":"codeVoice"},{"type":"text","text":" type’s "},{"code":"init(_:)","type":"codeVoice"},{"type":"text","text":" initializer."}],"type":"paragraph"},{"syntax":"swift","code":["let favemoji = \"My favorite emoji is 🎉\"","if let i = favemoji.utf16.firstIndex(where: { $0 >= 128 }) {","    let asciiPrefix = String(favemoji.utf16[..<i])!","    print(asciiPrefix)","}","\/\/ Prints \"My favorite emoji is \""],"type":"codeListing"},{"level":1,"anchor":"UTF16View-Elements-Match-NSString-Characters","text":"UTF16View Elements Match NSString Characters","type":"heading"},{"inlineContent":[{"type":"text","text":"The UTF-16 code units of a string’s "},{"code":"utf16","type":"codeVoice"},{"type":"text","text":" view match the elements"},{"type":"text","text":" "},{"type":"text","text":"accessed through indexed "},{"code":"NSString","type":"codeVoice"},{"type":"text","text":" APIs."}],"type":"paragraph"},{"syntax":"swift","code":["print(flowers.utf16.count)","\/\/ Prints \"10\"","","let nsflowers = flowers as NSString","print(nsflowers.length)","\/\/ Prints \"10\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Unlike "},{"code":"NSString","type":"codeVoice"},{"type":"text","text":", however, "},{"code":"String.UTF16View","type":"codeVoice"},{"type":"text","text":" does not use integer"},{"type":"text","text":" "},{"type":"text","text":"indices. If you need to access a specific position in a UTF-16 view, use"},{"type":"text","text":" "},{"type":"text","text":"Swift’s index manipulation methods. The following example accesses the"},{"type":"text","text":" "},{"type":"text","text":"fourth code unit in both the "},{"code":"flowers","type":"codeVoice"},{"type":"text","text":" and "},{"code":"nsflowers","type":"codeVoice"},{"type":"text","text":" strings:"}],"type":"paragraph"},{"syntax":"swift","code":["print(nsflowers.character(at: 3))","\/\/ Prints \"119\"","","let i = flowers.utf16.index(flowers.utf16.startIndex, offsetBy: 3)","print(flowers.utf16[i])","\/\/ Prints \"119\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Although the Swift overlay updates many Objective-C methods to return"},{"type":"text","text":" "},{"type":"text","text":"native Swift indices and index ranges, some still return instances of"},{"type":"text","text":" "},{"code":"NSRange","type":"codeVoice"},{"type":"text","text":". To convert an "},{"code":"NSRange","type":"codeVoice"},{"type":"text","text":" instance to a range of"},{"type":"text","text":" "},{"code":"String.Index","type":"codeVoice"},{"type":"text","text":", use the "},{"code":"Range(_:in:)","type":"codeVoice"},{"type":"text","text":" initializer, which takes an"},{"type":"text","text":" "},{"code":"NSRange","type":"codeVoice"},{"type":"text","text":" and a string as arguments."}],"type":"paragraph"},{"syntax":"swift","code":["let snowy = \"❄️ Let it snow! ☃️\"","let nsrange = NSRange(location: 3, length: 12)","if let range = Range(nsrange, in: snowy) {","    print(snowy[range])","}","\/\/ Prints \"Let it snow!\""],"type":"codeListing"}]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Escapable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"],"title":"Conforms To","type":"conformsTo"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"String.UTF16View","externalID":"s:SS9UTF16ViewV","symbolKind":"struct","platforms":[{"deprecated":false,"unavailable":false,"introducedAt":"8.0","name":"iOS","beta"