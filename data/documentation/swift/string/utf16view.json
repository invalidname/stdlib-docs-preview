,"\/\/ 115","\/\/ 32","\/\/ 55357","\/\/ 56464"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unicode scalar values that make up a string’s contents can be up to 21"},{"type":"text","text":" "},{"type":"text","text":"bits long. The longer scalar values may need two "},{"code":"UInt16","type":"codeVoice"},{"type":"text","text":" values for"},{"type":"text","text":" "},{"type":"text","text":"storage. Those “pairs” of code units are called "},{"type":"emphasis","inlineContent":[{"type":"text","text":"surrogate pairs"}]},{"type":"text","text":"."}]},{"code":["let flowermoji = \"💐\"","for v in flowermoji.unicodeScalars {","    print(v, v.value)","}","\/\/ 💐 128144","","for v in flowermoji.utf16 {","    print(v)","}","\/\/ 55357","\/\/ 56464"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To convert a "},{"code":"String.UTF16View","type":"codeVoice"},{"type":"text","text":" instance back into a string, use the"},{"type":"text","text":" "},{"code":"String","type":"codeVoice"},{"type":"text","text":" type’s "},{"code":"init(_:)","type":"codeVoice"},{"type":"text","text":" initializer."}]},{"code":["let favemoji = \"My favorite emoji is 🎉\"","if let i = favemoji.utf16.firstIndex(where: { $0 >= 128 }) {","    let asciiPrefix = String(favemoji.utf16[..<i])!","    print(asciiPrefix)","}","\/\/ Prints \"My favorite emoji is \""],"type":"codeListing","syntax":"swift"},{"anchor":"UTF16View-Elements-Match-NSString-Characters","type":"heading","text":"UTF16View Elements Match NSString Characters","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"The UTF-16 code units of a string’s "},{"code":"utf16","type":"codeVoice"},{"type":"text","text":" view match the elements"},{"type":"text","text":" "},{"type":"text","text":"accessed through indexed "},{"code":"NSString","type":"codeVoice"},{"type":"text","text":" APIs."}]},{"code":["print(flowers.utf16.count)","\/\/ Prints \"10\"","","let nsflowers = flowers as NSString","print(nsflowers.length)","\/\/ Prints \"10\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Unlike ","type":"text"},{"type":"codeVoice","code":"NSString"},{"text":", however, ","type":"text"},{"type":"codeVoice","code":"String.UTF16View"},{"text":" does not use integer","type":"text"},{"text":" ","type":"text"},{"text":"indices. If you need to access a specific position in a UTF-16 view, use","type":"text"},{"text":" ","type":"text"},{"text":"Swift’s index manipulation methods. The following example accesses the","type":"text"},{"text":" ","type":"text"},{"text":"fourth code unit in both the ","type":"text"},{"type":"codeVoice","code":"flowers"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"nsflowers"},{"text":" strings:","type":"text"}],"type":"paragraph"},{"code":["print(nsflowers.character(at: 3))","\/\/ Prints \"119\"","","let i = flowers.utf16.index(flowers.utf16.startIndex, offsetBy: 3)","print(flowers.utf16[i])","\/\/ Prints \"119\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Although the Swift overlay updates many Objective-C methods to return","type":"text"},{"text":" ","type":"text"},{"text":"native Swift indices and index ranges, some still return instances of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NSRange"},{"text":". To convert an ","type":"text"},{"type":"codeVoice","code":"NSRange"},{"text":" instance to a range of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"String.Index"},{"text":", use the ","type":"text"},{"type":"codeVoice","code":"Range(_:in:)"},{"text":" initializer, which takes an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NSRange"},{"text":" and a string as arguments.","type":"text"}],"type":"paragraph"},{"code":["let snowy = \"❄️ Let it snow! ☃️\"","let nsrange = NSRange(location: 3, length: 12)","if let range = Range(nsrange, in: snowy) {",