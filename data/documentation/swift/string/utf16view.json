" "},{"type":"text","text":"storage. Those “pairs” of code units are called "},{"type":"emphasis","inlineContent":[{"type":"text","text":"surrogate pairs"}]},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let flowermoji = \"💐\"","for v in flowermoji.unicodeScalars {","    print(v, v.value)","}","\/\/ 💐 128144","","for v in flowermoji.utf16 {","    print(v)","}","\/\/ 55357","\/\/ 56464"]},{"inlineContent":[{"type":"text","text":"To convert a "},{"type":"codeVoice","code":"String.UTF16View"},{"type":"text","text":" instance back into a string, use the"},{"type":"text","text":" "},{"type":"codeVoice","code":"String"},{"type":"text","text":" type’s "},{"type":"codeVoice","code":"init(_:)"},{"text":" initializer.","type":"text"}],"type":"paragraph"},{"code":["let favemoji = \"My favorite emoji is 🎉\"","if let i = favemoji.utf16.firstIndex(where: { $0 >= 128 }) {","    let asciiPrefix = String(favemoji.utf16[..<i])!","    print(asciiPrefix)","}","\/\/ Prints \"My favorite emoji is \""],"syntax":"swift","type":"codeListing"},{"type":"heading","text":"UTF16View Elements Match NSString Characters","level":1,"anchor":"UTF16View-Elements-Match-NSString-Characters"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The UTF-16 code units of a string’s "},{"type":"codeVoice","code":"utf16"},{"type":"text","text":" view match the elements"},{"type":"text","text":" "},{"text":"accessed through indexed ","type":"text"},{"code":"NSString","type":"codeVoice"},{"type":"text","text":" APIs."}]},{"code":["print(flowers.utf16.count)","\/\/ Prints \"10\"","","let nsflowers = flowers as NSString","print(nsflowers.length)","\/\/ Prints \"10\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"NSString"},{"text":", however, ","type":"text"},{"code":"String.UTF16View","type":"codeVoice"},{"text":" does not use integer","type":"text"},{"text":" ","type":"text"},{"text":"indices. If you need to access a specific position in a UTF-16 view, use","type":"text"},{"text":" ","type":"text"},{"text":"Swift’s index manipulation methods. The following example accesses the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"fourth code unit in both the "},{"type":"codeVoice","code":"flowers"},{"text":" and ","type":"text"},{"code":"nsflowers","type":"codeVoice"},{"text":" strings:","type":"text"}]},{"code":["print(nsflowers.character(at: 3))","\/\/ Prints \"119\"","","let i = flowers.utf16.index(flowers.utf16.startIndex, offsetBy: 3)","print(flowers.utf16[i])","\/\/ Prints \"119\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Although the Swift overlay updates many Objective-C methods to return","type":"text"},{"text":" ","type":"text"},{"text":"native Swift indices and index ranges, some still return instances of","type":"text"},{"text":" ","type":"text"},{"code":"NSRange","type":"codeVoice"},{"type":"text","text":". To convert an "},{"type":"codeVoice","code":"NSRange"},{"text":" instance to a range of","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"String.Index"},{"type":"text","text":", use the "},{"type":"codeVoice","code":"Range(_:in:)"},{"type":"text","text":" initializer, which takes an"},{"type":"text","text":" "},{"type":"codeVoice","code":"NSRange"},{"type":"text","text":" and a string as arguments."}]},{"syntax":"swift","code":["let snowy = \"❄️ Let it snow! ☃️\"","let nsrange = NSRange(location: 3, length: 12)","if let range = Range(nsrange, in: snowy) {","    print(snowy[range])","}","\/\/ Prints \"Let it snow!\""],"type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/String"]]},"sections":[],"kind":"symbol","metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UTF16V