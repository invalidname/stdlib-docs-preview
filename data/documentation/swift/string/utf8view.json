{"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UTF8View","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"You can access a string’s view of UTF-8 code units by using its "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":" "},{"type":"text","text":"property. A string’s UTF-8 view encodes the string’s Unicode scalar"},{"type":"text","text":" "},{"type":"text","text":"values as 8-bit integers."}],"type":"paragraph"},{"syntax":"swift","code":["let flowers = \"Flowers 💐\"","for v in flowers.utf8 {","    print(v)","}","\/\/ 70","\/\/ 108","\/\/ 111","\/\/ 119","\/\/ 101","\/\/ 114","\/\/ 115","\/\/ 32","\/\/ 240","\/\/ 159","\/\/ 146","\/\/ 144"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A string’s Unicode scalar values can be up to 21 bits in length. To"},{"type":"text","text":" "},{"type":"text","text":"represent those scalar values using 8-bit integers, more than one UTF-8"},{"type":"text","text":" "},{"type":"text","text":"code unit is often required."}],"type":"paragraph"},{"syntax":"swift","code":["let flowermoji = \"💐\"","for v in flowermoji.unicodeScalars {","    print(v, v.value)","}","\/\/ 💐 128144","","for v in flowermoji.utf8 {","    print(v)","}","\/\/ 240","\/\/ 159","\/\/ 146","\/\/ 144"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"In the encoded representation of a Unicode scalar value, each UTF-8 code"},{"type":"text","text":" "},{"type":"text","text":"unit after the first is called a "},{"type":"emphasis","inlineContent":[{"text":"continuation byte","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"text":"UTF8View Elements Match Encoded C Strings","anchor":"UTF8View-Elements-Match-Encoded-C-Strings","level":1,"type":"heading"},{"inlineContent":[{"type":"text","text":"Swift streamlines interoperation with C string APIs by letting you pass a"},{"type":"text","text":" "},{"type":"codeVoice","code":"String"},{"type":"text","text":" instance to a function as an "},{"type":"codeVoice","code":"Int8"},{"type":"text","text":" or "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":" pointer. When you"},{"type":"text","text":" "},{"type":"text","text":"call a C function using a "},{"type":"codeVoice","code":"String"},{"type":"text","text":", Swift automatically creates a buffer"},{"type":"text","text":" "},{"type":"text","text":"of UTF-8 code units and passes a pointer to that buffer. The code units"},{"type":"text","text":" "},{"type":"text","text":"of that buffer match the code units in the string’s "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":" view."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example uses the C "},{"type":"codeVoice","code":"strncmp"},{"type":"text","text":" function to compare the"},{"type":"text","text":" "},{"type":"text","text":"beginning of two Swift strings. The "},{"type":"codeVoice","code":"strncmp"},{"type":"text","text":" function takes two"},{"type":"text","text":" "},{"type":"codeVoice","code":"const char*"},{"type":"text","text":" pointers and an integer specifying the number of characters"},{"type":"text","text":" "},{"type":"text","text":"to compare. Because the strings are identical up to the 14th character,"},{"type":"text","text":" "},{"type":"text","text":"comparing only those characters results in a return value of "},{"type":"codeVoice","code":"0"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["let s1 = \"They call me 'Bell'\"","let s2 = \"They call me 'Stacey'\"","","print(strncmp(s1, s2, 14))","\/\/ Prints \"0\"","print(String(s1.utf8.prefix(14))!)","\/\/ Prints \"They call me '\""],"type":"codeListing"},{"inlineContent":[{"text":"Extending the compared character count to 15 includes the differing","type":"text"},{"text":" ","type":"text"},{"text":"characters, so a nonzero result is returned.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["print(strncmp(s1, s2, 15))","\/\/ Prints \"-17\"","print(String(s1.utf8.prefix(15))!)","\/\/ Prints \"They call me 'B\""],"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Related-String-Types","generated":true,"title":"Related String Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring","doc:\/\/com.apple.Swift\/documentation\/Swift\/StringProtocol","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/CharacterView","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UnicodeScalarView","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF16View","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Output"]}],"abstract":[{"type":"text","text":"A view of a string’s contents as a collection of UTF-8 code units."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Escapable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype","doc:\/\/com.ap