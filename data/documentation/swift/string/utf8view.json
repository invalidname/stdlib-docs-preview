ndableMetatype","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UTF8View","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"You can access a string’s view of UTF-8 code units by using its "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":" "},{"text":"property. A string’s UTF-8 view encodes the string’s Unicode scalar","type":"text"},{"text":" ","type":"text"},{"text":"values as 8-bit integers.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let flowers = \"Flowers 💐\"","for v in flowers.utf8 {","    print(v)","}","\/\/ 70","\/\/ 108","\/\/ 111","\/\/ 119","\/\/ 101","\/\/ 114","\/\/ 115","\/\/ 32","\/\/ 240","\/\/ 159","\/\/ 146","\/\/ 144"],"syntax":"swift"},{"inlineContent":[{"text":"A string’s Unicode scalar values can be up to 21 bits in length. To","type":"text"},{"text":" ","type":"text"},{"text":"represent those scalar values using 8-bit integers, more than one UTF-8","type":"text"},{"text":" ","type":"text"},{"text":"code unit is often required.","type":"text"}],"type":"paragraph"},{"code":["let flowermoji = \"💐\"","for v in flowermoji.unicodeScalars {","    print(v, v.value)","}","\/\/ 💐 128144","","for v in flowermoji.utf8 {","    print(v)","}","\/\/ 240","\/\/ 159","\/\/ 146","\/\/ 144"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"In the encoded representation of a Unicode scalar value, each UTF-8 code"},{"type":"text","text":" "},{"type":"text","text":"unit after the first is called a "},{"inlineContent":[{"text":"continuation byte","type":"text"}],"type":"emphasis"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","anchor":"UTF8View-Elements-Match-Encoded-C-Strings","text":"UTF8View Elements Match Encoded C Strings","level":1},{"inlineContent":[{"type":"text","text":"Swift streamlines interoperation with C string APIs by letting you pass a"},{"type":"text","text":" "},{"type":"codeVoice","code":"String"},{"type":"text","text":" instance to a function as an "},{"type":"codeVoice","code":"Int8"},{"type":"text","text":" or "},{"code":"UInt8","type":"codeVoice"},{"type":"text","text":" pointer. When you"},{"text":" ","type":"text"},{"type":"text","text":"call a C function using a "},{"code":"String","type":"codeVoice"},{"text":", Swift automatically creates a buffer","type":"text"},{"text":" ","type":"text"},{"text":"of UTF-8 code units and passes a pointer to that buffer. The code units","type":"text"},{"text":" ","type":"text"},{"text":"of that buffer match the code units in the string’s ","type":"text"},{"code":"utf8","type":"codeVoice"},{"text":" view.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example uses the C ","type":"text"},{"code":"strncmp","type":"codeVoice"},{"text":" function to compare the","type":"text"},{"text":" ","type":"text"},{"text":"beginning of two Swift strings. The ","type":"text"},{"code":"strncmp","type":"codeVoice"},{"text":" function takes two","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"const char*"},{"text":" pointers and an integer specifying the number of characters","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to compare. Because the strings are identical up to the 14th character,"},{"text":" ","type":"text"},{"text":"comparing only those characters results in a return value of ","type":"text"},{"code":"0","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let s1 = \"They call me 'Bell'\"","let s2 = \"They call me 'Stacey'\"","","print(strncmp(s1, s2, 14))","\/\/ Prints \"0\"","print(String(s1.utf8.prefix(14))!)","\/\/ Prints \"They call me '\""],"syntax":"swift"},{"inlineContent":[{"text":"Extending the compared character count to 15 includes the differing","type":"text"},{"text":" ","type":"text"},{"text":"characters, so a nonzero result is returned.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["print(strncmp(s1, s2, 15))","\/\/ Prints \"-17\"","print(String(s1.utf8.prefix(15))!)","\/\/ Prints \"They call me 'B\""],"syntax":"swift"}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/String/UTF8View/isTriviallyIdentical(to:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isTriviallyIdentical","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": `Self`","kind":"text"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic","abstract":[{"text":"Returns a boolean value indicating whether this UTF8 view","type":"text"},{"text":" ","type":"text"},{"text":"is trivially identical to ","type":"text"},{"type":"codeVoice","code":"other"},{"text":".","type":"text"}],"title":"isTriviallyIdentical(to:)","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View\/isTriviallyIdentical(to:)","url":"\/documentation\/swift\/string\/utf8view\/istriviallyidentical(to:)","role":"symbol"},"doc://com.apple.Swift/documentation/Swift/CustomStringConvertible":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"CustomStringConvertible","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"CustomStringConvertible","kind":"identifier"}],"abstract":[{"text":"A type with a customized textual representation.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","kind":"symbol","title":"CustomStringConvertible","url":"\/documentation\/sw