"swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UTF8View","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"You can access a string’s view of UTF-8 code units by using its ","type":"text"},{"type":"codeVoice","code":"utf8"},{"text":" ","type":"text"},{"text":"property. A string’s UTF-8 view encodes the string’s Unicode scalar","type":"text"},{"text":" ","type":"text"},{"text":"values as 8-bit integers.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let flowers = \"Flowers 💐\"","for v in flowers.utf8 {","    print(v)","}","\/\/ 70","\/\/ 108","\/\/ 111","\/\/ 119","\/\/ 101","\/\/ 114","\/\/ 115","\/\/ 32","\/\/ 240","\/\/ 159","\/\/ 146","\/\/ 144"]},{"type":"paragraph","inlineContent":[{"text":"A string’s Unicode scalar values can be up to 21 bits in length. To","type":"text"},{"text":" ","type":"text"},{"text":"represent those scalar values using 8-bit integers, more than one UTF-8","type":"text"},{"text":" ","type":"text"},{"text":"code unit is often required.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let flowermoji = \"💐\"","for v in flowermoji.unicodeScalars {","    print(v, v.value)","}","\/\/ 💐 128144","","for v in flowermoji.utf8 {","    print(v)","}","\/\/ 240","\/\/ 159","\/\/ 146","\/\/ 144"]},{"type":"paragraph","inlineContent":[{"text":"In the encoded representation of a Unicode scalar value, each UTF-8 code","type":"text"},{"text":" ","type":"text"},{"text":"unit after the first is called a ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"continuation byte"}]},{"text":".","type":"text"}]},{"type":"heading","anchor":"UTF8View-Elements-Match-Encoded-C-Strings","level":1,"text":"UTF8View Elements Match Encoded C Strings"},{"type":"paragraph","inlineContent":[{"text":"Swift streamlines interoperation with C string APIs by letting you pass a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" instance to a function as an ","type":"text"},{"type":"codeVoice","code":"Int8"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"UInt8"},{"text":" pointer. When you","type":"text"},{"text":" ","type":"text"},{"text":"call a C function using a ","type":"text"},{"type":"codeVoice","code":"String"},{"text":", Swift automatically creates a buffer","type":"text"},{"text":" ","type":"text"},{"text":"of UTF-8 code units and passes a pointer to that buffer. The code units","type":"text"},{"text":" ","type":"text"},{"text":"of that buffer match the code units in the string’s ","type":"text"},{"type":"codeVoice","code":"utf8"},{"text":" view.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example uses the C ","type":"text"},{"type":"codeVoice","code":"strncmp"},{"text":" function to compare the","type":"text"},{"text":" ","type":"text"},{"text":"beginning of two Swift strings. The ","type":"text"},{"type":"codeVoice","code":"strncmp"},{"text":" function takes two","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"const char*"},{"text":" pointers and an integer specifying the number of characters","type":"text"},{"text":" ","type":"text"},{"text":"to compare. Because the strings are identical up to the 14th character,","type":"text"},{"text":" ","type":"text"},{"text":"comparing only those characters results in a return value of ","type":"text"},{"type":"codeVoice","code":"0"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let s1 = \"They call me 'Bell'\"","let s2 = \"They call me 'Stacey'\"","","print(strncmp(s1, s2, 14))","\/\/ Prints \"0\"","print(String(s1.utf8.prefix(14))!)","\/\/ Prints \"They call me '\""]},{"type":"paragraph","inlineContent":[{"text":"Extending the compared character count to 15 includes the differing","type":"text"},{"text":" ","type":"text"},{"text":"characters, so a nonzero result is returned.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["print(strncmp(s1, s2, 15))","\/\/ Prints \"-17\"","print(String(s1.utf8.prefix(15))!)","\/\/ Prints \"They call me 'B\""]}]}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/String/UTF8View/customPlaygroundQuickLook":{"role":"symbol","title":"customPlaygroundQuickLook","url":"\/documentation\/swift\/string\/utf8view\/customplaygroundquicklook","abstract":[],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View\/customPlaygroundQuickLook","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customPlaygroundQuickLook","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s20_PlaygroundQuickLookO","text":"_PlaygroundQuickLook","kind":"typeIdentifier"}],"kind":"symbol","type":"topic"},"doc://com.apple.Swift/documentation/Swift/String/UTF8View/Sequence-Implementations":{"abstract":[],"type":"topic","kind":"article","title":"Sequence Implementations","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View\/Sequence-Implementations","role":"collectionGroup","url":"\/documentation\/swift\/string\/utf8view\/sequence-implementations"},"doc://com.apple.Swift/documentation/Swift/String/UTF8View/CustomDebugStringConvertible-Implementations":{"abstract":[],"type":"topic","url":"\/documentation\/swift\/string\/utf8view\/customdebugstringconvertible-implementations","kind":"article","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View\/CustomDebugStringConvertible-Implementations","title":"CustomDebugStringConvertible Implementations","role":"collectionGroup"},"doc://com.apple.Swift/documentation/Swift/Collection":{"abstract":[{"type":"text","text":"A sequence whose elements can be traversed multiple times,"},{"text":" ","type":"text"},{