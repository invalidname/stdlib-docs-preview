{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View","interfaceLanguage":"swift"},"sections":[],"metadata":{"modules":[{"name":"Swift"}],"roleHeading":"Structure","role":"symbol","title":"String.UTF8View","platforms":[{"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iPadOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"13.0","name":"Mac Catalyst","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"10.10","name":"macOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"9.0","name":"tvOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"1.0","name":"visionOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"2.0","name":"watchOS","deprecated":false}],"symbolKind":"struct","extendedModule":"Swift","externalID":"s:SS8UTF8ViewV","navigatorTitle":[{"kind":"identifier","text":"UTF8View"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UTF8View"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View\/customPlaygroundQuickLook","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View\/span"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View\/isTriviallyIdentical(to:)"],"anchor":"Instance-Methods","title":"Instance Methods"},{"generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View\/BidirectionalCollection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View\/Collection-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View\/CustomDebugStringConvertible-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View\/CustomReflectable-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View\/CustomStringConvertible-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View\/Sequence-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"abstract":[{"text":"A view of a string’s contents as a collection of UTF-8 code units.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/String"]]},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Escapable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"],"kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UTF8View","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"You can access a string’s view of UTF-8 code units by using its "},{"type":"codeVoice","code":"utf8"},{"type":"text","text":" "},{"type":"text","text":"property. A string’s UTF-8 view encodes the string’s Unicode scalar"},{"type":"text","text":" "},{"type":"text","text":"values as 8-bit integers."}],"type":"paragraph"},{"syntax":"swift","code":["let flowers = \"Flowers 💐\"","for v in flowers.utf8 {","    print(v)","}","\/\/ 70","\/\/ 108","\/\/ 111","\/\/ 119","\/\/ 101","\/\/ 114","\/\/ 115","\/\/ 32","\/\/ 240","\/\/ 159","\/\/ 146","\/\/ 144"],"type":"codeListing"},{"inlineContent":[{"text":"A string’s Unicode scalar values can be up to 21 bits in length. To","type":"text"},{"text":" ","type":"text"},{"text":"represent those scalar values using 8-bit integers, more than one UTF-8","type":"text"},{"text":" ","type":"text"},{"text":"code unit is often required.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let flowermoji = \"💐\"","for v in flowermoji.unicodeScalars {","    print(v, v.value)","}","\/\/ 💐 128144","","for v in flowermoji.utf8 {","    print(v)","}","\/\/ 240","\/\/ 159","\/\/ 146","\/\/ 144"],"type":"codeListing"},{"inlineContent":[{"text":"In the encoded representation of a Unicode scalar value, each UTF-8 code","type":"text"},{"text":" ","type":"text"},{"text":"unit after the first is called a ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"continuation byte"}]},{"text":".","type":"text"}],"type":"paragraph"},{"text":"UTF8View Elements Match Encoded C Strings","anchor":"UTF8View-Elements-Match-Encoded-C-Strings","level":1,"type":"heading"},{"inlineContent":[{"text":"Swift streamlines interoperation with C string APIs by letting you pass a","type":"text"},{"text":" ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" instance to a function as an ","type":"text"},{"code":"Int8","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"UInt8","type":"codeVoice"},{"text":" pointer. When you","type":"text"},{"text":" ","type":"text"},{"text":"call a C function using a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", Swift automatically creates a buffer","type":"text"},{"text":" ","type":"text"},{"text":"of UTF-8 code units and passes a pointer to that buffer. The code units","type":"text"},{"text":" ","type":"text"},{"text":"of that buffer match the code units in the string’s ","type":"text"},{"code":"utf8","type":"codeVoice"},{"text":" view.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example uses the C ","type":"text"},{"code":"strncmp","type":"codeVoice"},{"text":" function to compare the","type":"text"},{"text":" ","type":"text"},{"text":"beginning of two Swift strings. The ","type":"text"},{"code":"strncmp","type":"codeVoice"},{"text":" function takes two","type":"text"},{"text":" ","type":"text"},{"code":"const char*","type":"codeVoice"},{"text":" pointers and an integer specifying the number of characters","type":"text"},{"text":" ","type":"text"},{"text":"to compare. Because the strings are identical up to the 14th character,","type":"text"},{"text":" ","type":"text"},{"text":"comparing only those characters results in a return value of ","type":"text"},{"code":"0","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let s1 = \"They call me 'Bell'\"","let s2 = \"They call me 'Stacey'\"","","print(strncmp(s1, s2, 14))","\/\/ Prints \"0\"","print(String(s1.utf8.prefix(14))!)","\/\/ Prints \"They call me '\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Extending the compared character count to 15 includes the differing"},{"type":"text","text":" "},{"type":"text","text":"characters, so a nonzero result is returned."}],"type":"paragraph"},{"syntax":"swift","code":["print(strncmp(s1, s2, 15))","\/\/ Prints \"-17\"","print(String(s1.utf8.prefix(15))!)","\/\/ Prints \"They call me 'B\""],"type":"codeListing"}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring","doc:\/\/com.apple.Swift\/documentation\/Swift\/StringProtocol","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index","