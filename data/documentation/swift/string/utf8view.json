{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF8View"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomReflectable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"],"kind":"relationships","type":"conformsTo"}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring","doc:\/\/com.apple.Swift\/documentation\/Swift\/StringProtocol","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Index","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/CharacterView","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UnicodeScalarView","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/UTF16View","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Iterator","doc:\/\/com.apple.Swift\/documentation\/Swift\/String\/Output"],"title":"Related String Types","generated":true,"anchor":"Related-String-Types"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UTF8View","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"inlineContent":[{"text":"You can access a string’s view of UTF-8 code units by using its ","type":"text"},{"type":"codeVoice","code":"utf8"},{"text":" ","type":"text"},{"text":"property. A string’s UTF-8 view encodes the string’s Unicode scalar","type":"text"},{"text":" ","type":"text"},{"text":"values as 8-bit integers.","type":"text"}],"type":"paragraph"},{"code":["let flowers = \"Flowers 💐\"","for v in flowers.utf8 {","    print(v)","}","\/\/ 70","\/\/ 108","\/\/ 111","\/\/ 119","\/\/ 101","\/\/ 114","\/\/ 115","\/\/ 32","\/\/ 240","\/\/ 159","\/\/ 146","\/\/ 144"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A string’s Unicode scalar values can be up to 21 bits in length. To","type":"text"},{"text":" ","type":"text"},{"text":"represent those scalar values using 8-bit integers, more than one UTF-8","type":"text"},{"text":" ","type":"text"},{"text":"code unit is often required.","type":"text"}],"type":"paragraph"},{"code":["let flowermoji = \"💐\"","for v in flowermoji.unicodeScalars {","    print(v, v.value)","}","\/\/ 💐 128144","","for v in flowermoji.utf8 {","    print(v)","}","\/\/ 240","\/\/ 159","\/\/ 146","\/\/ 144"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"In the encoded representation of a Unicode scalar value, each UTF-8 code","type":"text"},{"text":" ","type":"text"},{"text":"unit after the first is called a ","type":"text"},{"inlineContent":[{"text":"continuation byte","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","text":"UTF8View Elements Match Encoded C Strings","anchor":"UTF8View-Elements-Match-Encoded-C-Strings","level":1},{"inlineContent":[{"text":"Swift streamlines interoperation with C string APIs by letting you pass a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" instance to a function as an ","type":"text"},{"type":"codeVoice","code":"Int8"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"UInt8"},{"text":" pointer. When you","type":"text"},{"text":" ","type":"text"},{"text":"call a C function using a ","type":"text"},{"type":"codeVoice","code":"String"},{"text":", Swift automatically creates a buffer","type":"text"},{"text":" ","type":"text"},{"text":"of UTF-8 code units and passes a pointer to that buffer. The code units","type":"text"},{"text":" ","type":"text"},{"text":"of that buffer match the code units in the string’s ","type":"text"},{"type":"codeVoice","code":"utf8"},{"text":" view.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example uses the C ","type":"text"},{"type":"codeVoice","code":"strncmp"},{"text":" function to compare the","type":"text"},{"text":" ","type":"text"},{"text":"beginning of two Swift strings. The ","type":"text"},{"type":"codeVoice","code":"strncmp"},{"text":" function takes two","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"const char*"},{"text":" pointers and an integer specifying the number of characters","type":"text"},{"text":" ","type":"text"},{"text":"to compare. Because the strings are identical up to the 14th character,","type":"text"},{"text":" ","type":"text"},{"text":"comparing only those characters results in a return value of ","type":"text"},{"code":"0","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let s1 = \"They call me 'Bell'\"","let s2 = \"They call me 'Stacey'\"","","print(strncmp(s1, s2, 14))","\/\/ Prints \"0\"","print(String(s1.utf8.prefix(14))!)","\/\/ Prints \"They call me '\""],"type":"codeListing"},{"inlineContent":[{"text":"Extending the compared character count to 15 includes the differing","type":"text"},{"text":" ","type":"text"},{"text":"characters, so a nonzero result is returned.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["print(strncmp(s1, s2, 15))","\/\/ Prints \"-17\"","print(String(s1.utf8.prefix(15))!)","\/\/ Prints \"They call me 'B\""],"type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/String"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/document