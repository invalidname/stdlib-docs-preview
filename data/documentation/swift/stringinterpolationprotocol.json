/Swift\/ExpressibleByStringInterpolation","doc:\/\/com.apple.Swift\/documentation\/Swift\/DefaultStringInterpolation"],"generated":true,"title":"String Literals","anchor":"String-Literals"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/StringInterpolationProtocol","interfaceLanguage":"swift"},"topicSections":[{"title":"Associated Types","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/StringInterpolationProtocol\/StringLiteralType"],"anchor":"Associated-Types"},{"title":"Initializers","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/StringInterpolationProtocol\/init(literalCapacity:interpolationCount:)"],"anchor":"Initializers"},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/StringInterpolationProtocol\/appendLiteral(_:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"StringInterpolationProtocol"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"ExpressibleByStringInterpolation"},{"type":"text","text":" type has an associated"},{"type":"text","text":" "},{"type":"codeVoice","code":"StringInterpolation"},{"type":"text","text":" type which conforms to "},{"type":"codeVoice","code":"StringInterpolationProtocol"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Swift converts an expression like "},{"type":"codeVoice","code":"\"The time is \\(time).\" as MyString"},{"type":"text","text":" into"},{"type":"text","text":" "},{"type":"text","text":"a series of statements similar to:"}],"type":"paragraph"},{"code":["var interpolation = MyString.StringInterpolation(literalCapacity: 13, ","                                                 interpolationCount: 1)","","interpolation.appendLiteral(\"The time is \")","interpolation.appendInterpolation(time)","interpolation.appendLiteral(\".\")","","MyString(stringInterpolation: interpolation)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"StringInterpolation"},{"type":"text","text":" type is responsible for collecting the segments"},{"type":"text","text":" "},{"type":"text","text":"passed to its "},{"type":"codeVoice","code":"appendLiteral(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"appendInterpolation"},{"type":"text","text":" methods and"},{"type":"text","text":" "},{"type":"text","text":"assembling them into a whole, converting as necessary. Once all of the"},{"type":"text","text":" "},{"type":"text","text":"segments are appended, the interpolation is passed to an"},{"type":"text","text":" "},{"type":"codeVoice","code":"init(stringInterpolation:)"},{"type":"text","text":" initializer on the type being created, which"},{"type":"text","text":" "},{"type":"text","text":"must extract the accumulated data from the "},{"type":"codeVoice","code":"StringInterpolation"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In simple cases, you can use "},{"type":"codeVoice","code":"DefaultStringInterpolation"},{"type":"text","text":" as the"},{"type":"text","text":" "},{"type":"text","text":"interpolation type for types that conform to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"ExpressibleByStringLiteral"},{"type":"text","text":" protocol. To use the default interpolation,"},{"type":"text","text":" "},{"type":"text","text":"conform a type to "},{"type":"codeVoice","code":"ExpressibleByStringInterpolation"},{"type":"text","text":" and implement"},{"type":"text","text":" "},{"type":"codeVoice","code":"init(stringLiteral: String)"},{"type":"text","text":". Values in interpolations are converted to"},{"type":"text","text":" "},{"type":"text","text":"strings, and then passed to that initializer just like any other string"},{"type":"text","text":" "},{"type":"text","text":"literal."}],"type":"paragraph"},{"type":"heading","text":"Handling String Interpolations","anchor":"Handling-String-Interpolations","level":1},{"inlineContent":[{"type":"text","text":"With a custom interpolation type, each interpolated segment is translated"},{"type":"text","text":" "},{"type":"text","text":"into a call to a special "},{"type":"codeVoice","code":"appendInterpolation"},{"type":"text","text":" method. The contents of"},{"type":"text","text":" "},{"type":"text","text":"the interpolation’s parentheses are treated as the call’s argument list."},{"type":"text","text":" "},{"type":"text","text":"That argument list can include multiple arguments and argument labels."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following examples show how string interpolations are translated into"},{"type":"text","text":" "},{"type":"text","text":"calls to "},{"type":"codeVoice","code":"appendInterpolation"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\\(x)"},{"type":"text","text":" translates to "},{"type":"codeVoice","code":"appendInterpolation(x)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\\(x, y)"},{"type":"text","text":" translates to "},{"type":"codeVoice","code":"appendInterpolation(x, y)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\\(foo: x)"},{"type":"text","text":" translates to "},{"type":"codeVoice","code":"appendInterpolation(foo: x)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\\(x, foo: y)"},{"type":"text","text":" translates to "},{"type":"codeVoice","code":"appendInterpolation(x, foo: y)"}]}]}]},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"appendInterpolation"},{"type":"text","text":" methods in your custom type must be mutating"},{"type":"text","text":" "},{"type":"text","text":"instance methods that return "},{"type":"codeVoice","code":"Void"},{"type":"text","text":". This code shows a custom interpolation"},{"type":"text","text":" "},{"type":"text","text":"type’s declaration of an "},{"type":"codeVoice","code":"appendInterpolation"},{"type":"text","text":" method that provides special"},{"type":"text","text":" "},{"type":"text","text":"validation for user input:"}],"type":"paragraph"},{"code":["extension MyString.StringInterpolation {","    mutating func appendInterpolation(validating input: String) {","        \/\/ Perform validation of `input` and store for later use","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"To use this interpolation method, create a string literal with an"},{"type":"text","text":" "},{"type":"text","text":"interpolation using the "},{"type":"codeVoice","code":"validating"},{"type":"text","text":" parameter label."}],"type":"paragraph"},{"code":["let userInput = readLine() ?? \"\"","let myString = \"The user typed '\\(validating: userInput)'.\" as MyString"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"appendInterpolation"},{"type":"text","text":" methods support virtually all features of methods:"},{"type":"text","text":" "},{"type":"text","text":"they can have any number of parameters, can specify labels for any or all"},{"type":"text","text":" "},{"type":"text","text":"of their parameters, can provide default values, can have variadic"},{"type":"text","text":" "},{"type":"text","text":"parameters, and can have parameters with generic types. Most importantly,"},{"type":"text","text":" "},{"type":"text","text":"they can be overloaded, so a type that conforms to"},{"type":"text","text":" "},{"type":"codeVoice","code":"StringInterpolationProtocol"},{"type":"text","text":" can provide several different"},{"type":"text","text":" "},{"type":"codeVoice","code":"appendInterpolation"},{"type":"text","text":" methods with different behaviors. An"},{"type":"text","text":" "},{"type":"codeVoice","code":"appendInterpolation"},{"type":"text","text":" method can also throw; when a user writes a literal"},{"type":"text","text":" "},{"type":"text","text":"with one of these interpolations, they must mark the string literal with"},{"type":"text","text":" "},{"type":"codeVoice","code":"try"},{"type":"text","text":" or one of its variants."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/stringinterpolationprotocol"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/ExpressibleByUnicodeScalarLiteral":{"title":"ExpressibleByUnicodeScalarLiteral","abstract":[{"text":"A type that can be initialized with a string literal containing a single","type":"text"},{"text":" ","type":"text"},{"text":"Unicode scalar value.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByUnicodeScalarLiteral","url":"\/documentation\/swift\/expressiblebyunicodescalarliteral","type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ExpressibleByUnicodeScalarLiteral","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"ExpressibleByUnicodeScalarLiteral","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/StringInterpolationProtocol":{"navigatorTitle":[{"kind":"identifier","text":"StringInterpolationProtocol"}],"url":"\/documentation\/swift\/stringinterpolationprotocol","abstract":[{"type":"text","text":"Represents the contents of a string literal with interpolations while it’s"},{"type":"text","text":" "},{"type":"text","text":"being built up."}],"kind":"symbol","title":"StringInterpolationProtocol","role":"symbol","identifier":"doc:\/\/com.app