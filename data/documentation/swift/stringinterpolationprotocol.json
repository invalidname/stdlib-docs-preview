{"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"title":"String Literals","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByStringLiteral","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByExtendedGraphemeClusterLiteral","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByUnicodeScalarLiteral","doc:\/\/com.apple.Swift\/documentation\/Swift\/ExpressibleByStringInterpolation","doc:\/\/com.apple.Swift\/documentation\/Swift\/DefaultStringInterpolation"],"generated":true,"anchor":"String-Literals"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StringInterpolationProtocol","kind":"identifier"}]}]},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"ExpressibleByStringInterpolation"},{"text":" type has an associated","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"StringInterpolation"},{"text":" type which conforms to ","type":"text"},{"type":"codeVoice","code":"StringInterpolationProtocol"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Swift converts an expression like ","type":"text"},{"type":"codeVoice","code":"\"The time is \\(time).\" as MyString"},{"text":" into","type":"text"},{"text":" ","type":"text"},{"text":"a series of statements similar to:","type":"text"}]},{"type":"codeListing","code":["var interpolation = MyString.StringInterpolation(literalCapacity: 13, ","                                                 interpolationCount: 1)","","interpolation.appendLiteral(\"The time is \")","interpolation.appendInterpolation(time)","interpolation.appendLiteral(\".\")","","MyString(stringInterpolation: interpolation)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"StringInterpolation"},{"text":" type is responsible for collecting the segments","type":"text"},{"text":" ","type":"text"},{"text":"passed to its ","type":"text"},{"type":"codeVoice","code":"appendLiteral(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"appendInterpolation"},{"type":"text","text":" methods and"},{"type":"text","text":" "},{"type":"text","text":"assembling them into a whole, converting as necessary. Once all of the"},{"type":"text","text":" "},{"type":"text","text":"segments are appended, the interpolation is passed to an"},{"type":"text","text":" "},{"type":"codeVoice","code":"init(stringInterpolation:)"},{"type":"text","text":" initializer on the type being created, which"},{"type":"text","text":" "},{"type":"text","text":"must extract the accumulated data from the "},{"type":"codeVoice","code":"StringInterpolation"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In simple cases, you can use "},{"type":"codeVoice","code":"DefaultStringInterpolation"},{"type":"text","text":" as the"},{"type":"text","text":" "},{"type":"text","text":"interpolation type for types that conform to the"},{"type":"text","text":" "},{"code":"ExpressibleByStringLiteral","type":"codeVoice"},{"type":"text","text":" protocol. To use the default interpolation,"},{"type":"text","text":" "},{"type":"text","text":"conform a type to "},{"code":"ExpressibleByStringInterpolation","type":"codeVoice"},{"type":"text","text":" and implement"},{"type":"text","text":" "},{"code":"init(stringLiteral: String)","type":"codeVoice"},{"type":"text","text":". Values in interpolations are converted to"},{"type":"text","text":" "},{"type":"text","text":"strings, and then passed to that initializer just like any other string"},{"type":"text","text":" "},{"type":"text","text":"literal."}]},{"type":"heading","text":"Handling String Interpolations","anchor":"Handling-String-Interpolations","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"With a custom interpolation type, each interpolated segment is translated"},{"type":"text","text":" "},{"type":"text","text":"into a call to a special "},{"code":"appendInterpolation","type":"codeVoice"},{"text":" method. The contents of","type":"text"},{"text":" ","type":"text"},{"text":"the interpolation’s parentheses are treated as the call’s argument list.","type":"text"},{"text":" ","type":"text"},{"text":"That argument list can include multiple arguments and argument labels.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following examples show how string interpolations are translated into"},{"type":"text","text":" "},{"type":"text","text":"calls to "},{"type":"codeVoice","code":"appendInterpolation"},{"type":"text","text":":"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\\(x)"},{"type":"text","text":" translates to "},{"type":"codeVoice","code":"appendInterpolation(x)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"\\(x, y)"},{"type":"text","text":" translates to "},{"type":"codeVoice","code":"appendInterpolation(x, y)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"\\(foo: x)"},{"text":" translates to ","type":"text"},{"code":"appendInterpolation(foo: x)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"\\(x, foo: y)","type":"codeVoice"},{"text":" translates to ","type":"text"},{"code":"appendInterpolation(x, foo: y)","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"appendInterpolation"},{"type":"text","text":" methods in your custom type must be mutating"},{"type":"text","text":" "},{"type":"text","text":"instance methods that return "},{"type":"codeVoice","code":"Void"},{"type":"text","text":". This code shows a custom interpolation"},{"type":"text","text":" "},{"type":"text","text":"type’s declaration of an "},{"type":"codeVoice","code":"appendInterpolation"},{"text":" method that provides special","type":"text"},{"type":"text","text":" "},{"type":"text","text":"validation for user input:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension MyString.StringInterpolation {","    mutating func appendInterpolation(validating input: String) {","        \/\/ Perform validation of `input` and store for later use","    }","}"]},{"inlineContent":[{"type":"text","text":"To use this interpolation method, create a string literal with an"},{"type":"text","text":" "},{"type":"text","text":"interpolation using the "},{"type":"codeVoice","code":"validating"},{"type":"text","text":" parameter label."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let userInput = readLine() ?? \"\"","let myString = \"The user typed '\\(validating: userInput)'.\" as MyString"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"appendInterpolation"},{"type":"text","text":" methods support virtually all features of methods:"},{"type":"text","text":" "},{"type":"text","text":"they can have any number of parameters, can specify labels for any or all"},{"text":" ","type":"text"},{"text":"of their parameters, can provide default values, can have variadic","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"parameters, and can have parameters with generic types. Most importantly,"},{"type":"text","text":" "},{"type":"text","text":"they can be overloaded, so a type that conforms to"},{"type":"text","text":" "},{"type":"codeVoice","code":"StringInterpolationProtocol"},{"type":"text","text":" can provide several different"},{"type":"text","text":" "},{"type":"codeVoice","code":"appendInterpolation"},{"type":"text","text":" methods with different behaviors. An"},{"text":" ","type":"text"},{"type":"codeVoice","code":"appendInterpolation"},{"type":"text","text":" method can also throw; when a user writes a literal"},{"type":"text","text":" "},{"type":"text","text":"with one of these interpolations, they must mark the string literal with"},{"type":"text","text":" "},{"type":"codeVoice","code":"try"},{"type":"text","text":" or one of its variants."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"kind":"symbol","sections":[],"metadata":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StringInterpolationProtocol","kind":"identifier"}],"title":"StringInterpolationProtocol","roleHeading":"Protocol","externalID":"s:s27StringInterpolationProtocolP","platforms":[{"introducedAt":"8.0","name":"iOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"8.0","name":"iPadOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"13.0","name":"Mac Catalyst","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"10.10","name":"macOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"9.0","name":"tvOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"1.0","name":"visionOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"2.0","name":"watchOS","beta":false,"deprecated":false,"unavailable":false}],"symbolKind":"protocol","navigatorTitle":[{"text":"StringInterpolationProtocol","kind":"identifier"}],"modules":[{"name":"Standard Library"}]},"topicSections":[{"title":"Associated Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/StringInterpolationProtocol\/StringLiteralType"],"generated":true,"anchor":"Associated-Types"},{"title":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/StringInterpolationProtocol\/init(literalCapacity:interpolationCount:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/StringInterpolationProtocol\/append