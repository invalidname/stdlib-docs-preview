literalCapacity: 13, ","                                                 interpolationCount: 1)","","interpolation.appendLiteral(\"The time is \")","interpolation.appendInterpolation(time)","interpolation.appendLiteral(\".\")","","MyString(stringInterpolation: interpolation)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"code":"StringInterpolation","type":"codeVoice"},{"type":"text","text":" type is responsible for collecting the segments"},{"type":"text","text":" "},{"type":"text","text":"passed to its "},{"code":"appendLiteral(_:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"appendInterpolation","type":"codeVoice"},{"type":"text","text":" methods and"},{"type":"text","text":" "},{"type":"text","text":"assembling them into a whole, converting as necessary. Once all of the"},{"type":"text","text":" "},{"type":"text","text":"segments are appended, the interpolation is passed to an"},{"type":"text","text":" "},{"code":"init(stringInterpolation:)","type":"codeVoice"},{"type":"text","text":" initializer on the type being created, which"},{"type":"text","text":" "},{"type":"text","text":"must extract the accumulated data from the "},{"code":"StringInterpolation","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In simple cases, you can use "},{"type":"codeVoice","code":"DefaultStringInterpolation"},{"type":"text","text":" as the"},{"type":"text","text":" "},{"type":"text","text":"interpolation type for types that conform to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"ExpressibleByStringLiteral"},{"type":"text","text":" protocol. To use the default interpolation,"},{"type":"text","text":" "},{"type":"text","text":"conform a type to "},{"type":"codeVoice","code":"ExpressibleByStringInterpolation"},{"type":"text","text":" and implement"},{"type":"text","text":" "},{"type":"codeVoice","code":"init(stringLiteral: String)"},{"type":"text","t