},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" is the length of the sequence."}]}],"style":"note","type":"aside","name":"Complexity"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/substring\/unicodescalarview\/reduce(into:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"Swift-PageImage-card.png":{"alt":"An orange Swift logo on a gradient background.","type":"image","identifier":"Swift-PageImage-card.png","variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png","traits":["2x","dark"]}]},"doc://com.apple.Swift/documentation/Swift/Substring/UnicodeScalarView/reduce(into:_:)":{"url":"\/documentation\/swift\/substring\/unicodescalarview\/reduce(into:_:)","title":"reduce(into:_:)","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring\/UnicodeScalarView\/reduce(into:_:)","abstract":[{"text":"Returns the result of combining the elements of the sequence using the","type":"text"},{"text":" ","type":"text"},{"text":"given closure.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reduce"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"E"},{"kind":"text","text":">("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:STsE6reduce4into_qd__qd__n_yqd__z_7ElementQztqd_0_YKXEtqd_0_YKs5ErrorRd_0_r0_lF6ResultL_qd__mfp","text":"Result"},{"kind":"text","text":", ("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"partialResult"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"