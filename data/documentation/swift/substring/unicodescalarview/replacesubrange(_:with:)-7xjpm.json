t":" ","type":"text"},{"text":"removed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In this example, three elements in the middle of an array of integers are","type":"text"},{"text":" ","type":"text"},{"text":"replaced by the five elements of a ","type":"text"},{"code":"Repeated<Int>","type":"codeVoice"},{"text":" instance.","type":"text"}],"type":"paragraph"},{"code":[" var nums = [10, 20, 30, 40, 50]"," nums.replaceSubrange(1...3, with: repeatElement(1, count: 5))"," print(nums)"," \/\/ Prints \"[10, 1, 1, 1, 1, 1, 50]\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"If you pass a zero-length range as the ","type":"text"},{"code":"subrange","type":"codeVoice"},{"text":" parameter, this method","type":"text"},{"text":" ","type":"text"},{"text":"inserts the elements of ","type":"text"},{"code":"newElements","type":"codeVoice"},{"text":" at ","type":"text"},{"code":"subrange.startIndex","type":"codeVoice"},{"text":". Calling","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"insert(contentsOf:at:)","type":"codeVoice"},{"text":" method instead is preferred.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Likewise, if you pass a zero-length collection as the ","type":"text"},{"type":"codeVoice","code":"newElements"},{"text":" ","type":"text"},{"text":"parameter, this method removes the elements in the given subrange","type":"text"},{"text":" ","type":"text"},{"text":"without replacement. Calling the ","type":"text"},{"type":"codeVoice","code":"removeSubrange(_:)"},{"text":" method instead is","type":"text"},{"text":" ","type":"text"},{"text":"preferred.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Calling this method may invalidate any existing indices for use with this","type":"text"},{"text":" ","type":"text"},{"text":"collection.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is length of this collection and","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":" is the length of ","type":"text"},{"code":"newElements","type":"codeVoice"},{"text":". If the call to this method simply","type":"text"},{"text":" ","type":"text"},{"text":"appends the contents of ","type":"text"},{"code":"newElements","type":"codeVoice"},{"text":" to the collection, the complexity","type":"text"},{"text":" ","type":"text"},{"text":"is O(","type":"text"},{"inlineContent":[{"text":"m","type":"text"}],"type":"emphasis"},{"text":").","type":"text"}],"type":"paragraph"}],"name":"Complexity","style":"note"}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/Substring/UnicodeScalarView/replaceSubrange(_:with:)-7xjpm":{"url":"\/documentation\/swift\/substring\/unicodescalarview\/replacesubrange(_:with:)-7xjpm","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring\/UnicodeScalarView\/replaceSubrange(_:with:)-7xjpm","abstract":[{"type":"text","text":"Replaces the specified subrange of elements with the given collection."}],"title":"replaceSubrange(_:with:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"replaceSubrange"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"R"},{"text":">(","kind":"text"},{"text":"R","kind":"typeIdentifier","preciseIdentifier":"s:SmsE15replaceSubrange_4withyqd_0__qd__ntSlRd__SXRd_0_7ElementQyd__ACRtz5BoundQyd_0_5IndexRtzr0_lF1RL_qd_0_mfp"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"with"},{"kind":"text"