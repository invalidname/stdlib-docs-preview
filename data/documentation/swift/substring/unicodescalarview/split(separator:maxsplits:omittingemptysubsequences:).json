sequences"},{"text":" ","type":"text"},{"text":"parameter, so the returned array contains empty strings where spaces","type":"text"},{"text":" ","type":"text"},{"text":"were repeated.","type":"text"}],"type":"paragraph"},{"code":["print(line.split(separator: \" \", omittingEmptySubsequences: false))","\/\/ Prints \"[\"BLANCHE:\", \"\", \"\", \"I\", \"don\\'t\", \"want\", \"realism.\", \"I\", \"want\", \"magic!\"]\""],"type":"codeListing","syntax":"swift"},{"content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), where "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" is the length of the collection."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Complexity"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/substring\/unicodescalarview\/split(separator:maxsplits:omittingemptysubsequences:)"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring\/UnicodeScalarView\/split(separator:maxSplits:omittingEmptySubsequences:)","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift/Substring/UnicodeScalarView/split(separator:maxSplits:omittingEmptySubsequences:)":{"abstract":[{"type":"text","text":"Returns the longest possible subsequences of the collection, in order,"},{"type":"text","text":" "},{"type":"text","text":"around elements equal to the given element."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring\/UnicodeScalarView\/split(separator:maxSplits:omittingEmptySubsequences:)","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Element","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":"."}]},"fragments":[{"kind":"keyword","