,{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" represents a","type":"text"},{"text":" ","type":"text"},{"text":"consecutive integer starting at zero and ","type":"text"},{"inlineContent":[{"type":"text","text":"x"}],"type":"emphasis"},{"text":" represents an element of","type":"text"},{"text":" ","type":"text"},{"text":"the sequence.","type":"text"}],"title":"enumerated()","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring\/UTF16View\/enumerated()","kind":"symbol","url":"\/documentation\/swift\/substring\/utf16view\/enumerated()"},"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"navigatorTitle":[{"kind":"identifier","text":"EnumeratedSequence"}],"title":"EnumeratedSequence","type":"topic","abstract":[{"text":"An enumeration of the elements of a sequence or collection.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"EnumeratedSequence"}],"role":"symbol","url":"\/documentation\/swift\/enumeratedsequence","kind":"symbol"}}}