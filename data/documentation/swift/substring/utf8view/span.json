text":"}"},{"type":"text","text":" "},{"type":"text","text":"This second option has linear time complexity, as expected."}],"type":"paragraph"}],"name":"Note"},{"type":"paragraph","inlineContent":[{"text":"Returns: a ","type":"text"},{"code":"Span","type":"codeVoice"},{"text":" over the UTF8 code units of this Substring.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Complexity: O(1) for native UTF8 Strings, O(n) for bridged UTF16 Strings.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/swift\/substring\/utf8view\/span"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring\/UTF8View\/span","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift/Substring/UTF8View/span":{"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"span","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Span","kind":"typeIdentifier","preciseIdentifier":"s:s4SpanV"},{"text":"<","kind":"text"},{"text":"UTF8","kind":"typeIdentifier","preciseIdentifier":"s:s4UTF8a"},{"text":".","kind":"text"},{"text":"CodeUnit","kind":"typeIdentifier","preciseIdentifier":"s:s7UnicodeO4UTF8O8CodeUnita"},{"text":">","kind":"text"}],"url":"\/documentation\/swift\/substring\/utf8view\/span","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring\/UTF8View\/span","type":"topic","title":"span","abstract":[{"text":"A span over the UTF8 code units that make up this substring.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/Span":{"abstract":[{"type":"codeVoice","code":"Span<Element>"},{"type":"text","text":" represents a contiguous region of memory"},{"type":"text","text":" "},{"type":"text","text":"which contains initialized instances of "},{"type":"codeVoice","code":"Element"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"Span","kind":"identifier"}],"type":"topic","title":"Span","kind":"sym