type":"text","text":"var nativeString = consume string"},{"type":"text","text":" "},{"type":"text","text":"nativeString.makeContiguousUTF8()"},{"type":"text","text":" "},{"type":"text","text":"for word in nativeString.split(separator: “ “) {"},{"type":"text","text":" "},{"type":"text","text":"useSpan(word.span)"},{"type":"text","text":" "},{"type":"text","text":"}"},{"type":"text","text":" "},{"type":"text","text":"This second option has linear time complexity, as expected."}],"type":"paragraph"}],"name":"Note"},{"inlineContent":[{"type":"text","text":"Returns: a "},{"code":"Span","type":"codeVoice"},{"text":" over the UTF8 code units of this Substring.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Complexity: O(1) for native UTF8 Strings, O(n) for bridged UTF16 Strings.","type":"text"}]}],"kind":"content"}],"abstract":[{"type":"text","text":"A span over the UTF8 code units that make up this substring."}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring\/UTF8View\/span","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/substring\/utf8view\/span"]}],"metadata":{"role":"symbol","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"span"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4SpanV","text":"Span"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s4UTF8a","text":"UTF8"},{"kind":"text","text":"."},{"text":"CodeUnit","preciseIdentifier":"s:s7UnicodeO4UTF8O8CodeUnita","kind":"typeIdentifier"},{"text":">","kind":"text"}],"roleHeading":"Instance Property","title":"span","externalID":"s:Ss8UTF8ViewV4spans4SpanVys5UInt8VGvp","extendedModule":"Swift","platforms":[{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"8.0","name":"iOS"},{"beta":false,"introducedAt":"8.0","deprecated":false,"name":"iP