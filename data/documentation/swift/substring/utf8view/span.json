,"type":"text"}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"Returns: a "},{"code":"Span","type":"codeVoice"},{"type":"text","text":" over the UTF8 code units of this Substring."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Complexity: O(1) for native UTF8 Strings, O(n) for bridged UTF16 Strings."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring","doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring\/UTF8View"]]},"variants":[{"paths":["\/documentation\/swift\/substring\/utf8view\/span"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift":{"title":"Swift","type":"topic","abstract":[{"type":"text","text":"Build apps using a powerful open language."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","url":"\/documentation\/swift","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/Substring/UTF8View":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"UTF8View","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Substring\/UTF8View","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"UTF8View"}],"abstract":[],"title":"Substring.UTF8View","url":"\/documentation\/swift\/substring\/utf8view"},"doc://com.apple.Swift/documentation/Swift/Span":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Span"}],"navigatorTitle":[{"kind":"identifier","text":"Span"}],"type":"topic","abstract":[{"type":"codeVoice","code":"Span<Element>"},{"type":"text","text":" represents a contiguous region of memory"},{"type":"text","text":" "},{"type":"text","text":"which contains initialized instances of "},{"type":"codeVoice","code":"Element"},{"type":"text","text":"."}