sion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BitwiseCopyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomNumberGenerator","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemRandomNumberGenerator"}]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"When you generate random values, shuffle a collection, or perform another","type":"text"},{"text":" ","type":"text"},{"text":"operation that depends on random data, this type is the generator used by","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"default. For example, the two method calls in this example are equivalent:"}]},{"type":"codeListing","code":["let x = Int.random(in: 1...100)","var g = SystemRandomNumberGenerator()","let y = Int.random(in: 1...100, using: &g)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SystemRandomNumberGenerator"},{"type":"text","text":" is automatically seeded, is safe to use in"},{"type":"text","text":" "},{"type":"text","text":"multiple threads, and uses a cryptographically secure algorithm whenever"},{"type":"text","text":" "},{"type":"text","text":"possible."}]},{"text":"Platform Implementation of `SystemRandomNumberGenerator`","anchor":"Platform-Implementation-of-SystemRandomNumberGenerator","type":"heading","level":1},{"type":"paragraph","inlineContent":[{"text":"While the system generator is automatically seeded and thread-safe on every","type":"text"},{"type":"text","text":" "},{"type":"text","text":"platform, the cryptographic quality of the stream of random data produced by"},{"type":"text","text":" "},{"text":"the generator may vary. For more detail, see the documentation for the APIs","type":"text"},{"text":" ","type":"text"},{"text":"used by each platform.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Apple platforms use ","type":"text"},{"type":"codeVoice","code":"arc4random_buf(3)"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Linux platforms use "},{"type":"codeVoice","code":"getrandom(2)"},{"type":"text","text":" when available; otherwise, they read"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"\/dev\/urandom"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Windows uses "},{"type":"codeVoice","code":"BCryptGenRandom"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Embedded Swift supplies its own implementation rather than using the one"},{"type":"text","text":" "},{"type":"text","text":"above. On Linux it calls "},{"type":"codeVoice","code":"arc4random_buf(3)"},{"type":"text","text":" where the C library has it and"},{"type":"text","text":" "},{"type":"codeVoice","code":"getrandom(2)"},{"type":"text","text":" where it doesn’t, and under the Embedded Swift platform"},{"type":"text","text":" "},{"type":"text","text":"abstraction layer it calls the platform’s "},{"type":"codeVoice","code":"_swift_generateRandom"},{"type":"text","text":"."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/systemrandomnumbergenerator"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"The system’s default source of random data."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Sw