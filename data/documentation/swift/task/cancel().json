{"metadata":{"role":"symbol","extendedModule":"_Concurrency","title":"cancel()","symbolKind":"method","platforms":[{"name":"iOS","beta":false,"introducedAt":"8.0","unavailable":false,"deprecated":false},{"unavailable":false,"beta":false,"name":"iPadOS","introducedAt":"8.0","deprecated":false},{"unavailable":false,"introducedAt":"13.0","beta":false,"deprecated":false,"name":"Mac Catalyst"},{"unavailable":false,"introducedAt":"10.10","beta":false,"deprecated":false,"name":"macOS"},{"deprecated":false,"introducedAt":"9.0","unavailable":false,"name":"tvOS","beta":false},{"deprecated":false,"introducedAt":"1.0","unavailable":false,"name":"visionOS","beta":false},{"name":"watchOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"2.0"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"()","kind":"text"}],"modules":[{"relatedModules":[],"name":"Swift"}],"externalID":"s:ScT6cancelyyF","roleHeading":"Instance Method","conformance":{"constraints":[{"type":"codeVoice","code":"Success"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Failure"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Error"},{"text":".","type":"text"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]}},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"cancel"},{"text":"()","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancelling a task has three primary effects:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"It flags the task as canceled.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It causes any active cancellation handlers on the task to run, once."}]}]},{"content":[{"inlineContent":[{"text":"It cancels any child tasks and task groups of the task, including","type":"text"},{"text":" ","type":"text"},{"text":"those created in the future. If those tasks have cancellation handlers,","type":"text"},{"text":" ","type":"text"},{"text":"they also are triggered.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Task cancellation is cooperative and idempotent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Cancelling a task does not automatically cause arbitrary functions on the task"},{"type":"text","text":" "},{"type":"text","text":"to stop running or throw errors. A function "},{"type":"emphasis","inlineContent":[{"text":"may","type":"text"}]},{"type":"text","text":" choose to react"},{"type":"text","text":" "},{"type":"text","text":"to cancellation by ending its work early, and it is conventional to"},{"type":"text","text":" "},{"type":"text","text":"signal that to callers by throwing "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":". However,"},{"type":"text","text":" "},{"type":"text","text":"a function that doesn’t specifically check for cancellation will"},{"text":" ","type":"text"},{"text":"run to completion normally, even if the task it is running on is","type":"text"},{"text":" ","type":"text"},{"text":"canceled. However, that function might still end early if it calls","type":"text"},{"type":"text","text":" "},{"type":"text","text":"other code that handles cancellation by throwing and that function doesn’t"},{"type":"text","text":" "},{"type":"text","text":"handle the error."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"It’s safe to cancel a task from any task or thread. It’s safe for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"multiple tasks or threads to cancel the same task at the same"},{"type":"text","text":" "},{"text":"time. Cancelling a task that has already been canceled has no","type":"text"},{"text":" ","type":"text"},{"text":"additional effect.","type":"text"}]},{"inlineContent":[{"code":"cancel","type":"codeVoice"},{"text":" may need to acquire locks and synchronously run","type":"text"},{"text":" ","type":"text"},{"text":"arbitrary cancellation-handler code associated with the","type":"text"},{"text":" ","type":"text"},{"text":"canceled task. To reduce the risk of deadlock, it is","type":"text"},{"text":" ","type":"text"},{"text":"recommended that callers release any locks they might be","type":"text"},{"text":" ","type":"text"},{"text":"holding before they call cancel.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the task has already run past the last point where it could have"},{"type":"text","text":" "},{"type":"text","text":"performed a cancellation check, cancelling it may have no observable effects."}],"type":"paragraph"},{"name":"See Also","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"Task.checkCancellation()"}]}]},{"name":"See Also","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"withTaskCancellationHandler(operation:onCancel:isolation:)","type":"codeVoice"}]}]}]}],"variants":[{"paths":["\/documentation\/swift\/task\/cancel()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task"]]},"abstract":[{"text":"Cancels this task.","type":"text"}],"seeAlsoSections":[{"anchor":"Canceling-Tasks","title":"Canceling Tasks","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentat