troducedAt":"13.0"},{"beta":false,"name":"macOS","unavailable":false,"deprecated":false,"introducedAt":"10.10"},{"beta":false,"name":"tvOS","unavailable":false,"deprecated":false,"introducedAt":"9.0"},{"beta":false,"name":"visionOS","unavailable":false,"deprecated":false,"introducedAt":"1.0"},{"beta":false,"name":"watchOS","unavailable":false,"deprecated":false,"introducedAt":"2.0"}],"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancel"},{"kind":"text","text":"()"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"()","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Cancelling a task has three primary effects:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"It flags the task as canceled.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"It causes any active cancellation handlers on the task to run, once.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"It cancels any child tasks and task groups of the task, including","type":"text"},{"text":" ","type":"text"},{"text":"those created in the future. If those tasks have cancellation handlers,","type":"text"},{"text":" ","type":"text"},{"text":"they also are triggered.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Task cancellation is cooperative and idempotent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Cancelling a task does not automatically cause arbitrary functions on the task","type":"text"},{"text":" ","type":"text"},{"text":"to stop running or throw errors. A function ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"may"}]},{"text":" choose to react","type":"text"},{"text":" ","type":"text"},{"text":"to cancellation by ending its work early, and it is conventional to","type":"text"},{"text":" ","type":"text"},{"text":"signal that to callers by throwing ","type":"text"},{"type":"codeVoice","code":"CancellationError"},{"text":". However,","type":"text"},{"text":" ","type":"text"},{"text":"a function that doesn’t specifically check for cancellation will","type":"text"},{"text":" ","type":"text"},{"text":"run to completion normally, even if the task it is running on is","type":"text"},{"text":" ","type":"text"},{"text":"canceled. However, that function might still end early if it calls","type":"text"},{"text":" ","type":"text"},{"text":"other code that handles cancellation by throwing and that function doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"handle the error.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It’s safe to cancel a task from any task or thread. It’s safe for","type":"text"},{"text":" ","type":"text"},{"text":"multiple tasks or threads to cancel the same task at the same","type":"text"},{"text":" ","type":"text"},{"text":"time. Cancelling a task that has already been canceled has no","type":"text"},{"text":" ","type":"text"},{"text":"additional effect.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"cancel"},{"text":" may need to acquire locks and synchronously run","type":"text"},{"text":" ","type":"text"},{"text":"arbitrary cancellation-handler code associated with the","type":"text"},{"text":" ","type":"text"},{"text":"canceled task. To reduce the risk of deadlock, it is","type":"text"},{"text":" ","type":"text"},{"text":"recommended that callers release any locks they might be","type":"text"},{"text":" ","type":"text"},{"text":"holding before they call cancel.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the task has already run past the last point where it could have","type":"text"},{"text":" ","type":"text"},{"text":"performed a cancellation check, cancelling it may have no observable effects.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"Task.checkCancellation()","type":"codeVoice"}]}],"name":"See Also","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"withTaskCancellationHandler(operation:onCancel:isolation:)","type":"codeVoice"}]}],"name":"See Also","type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/task\/cancel()"]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://com.apple.Swift/documentation/Swift/Task":{"title":"Task","url":"\/documentation\/swift\/task","navigatorTitle":[{"text":"Task","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Task","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","abstract":[{"text":"A unit of asynchronous work.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/Task/checkCancellation()":{"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Success"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Never"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Failure"},{"text":" is ","type":"text"},{"code":"Never","type":"codeVoice"},{"text":".","type":"text"}]},"type":"topic","url":"\/documentation\/swift\/task\/checkcancellation()","title":"checkCancellation()","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","abstract":[{"type":"text","text":"Throws an error if