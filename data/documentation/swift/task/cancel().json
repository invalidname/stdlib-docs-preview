{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel()","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/task\/cancel()"]}],"metadata":{"platforms":[{"deprecated":false,"unavailable":false,"beta":false,"name":"iOS","introducedAt":"8.0"},{"deprecated":false,"unavailable":false,"introducedAt":"8.0","beta":false,"name":"iPadOS"},{"deprecated":false,"unavailable":false,"beta":false,"name":"Mac Catalyst","introducedAt":"13.0"},{"deprecated":false,"unavailable":false,"introducedAt":"10.10","beta":false,"name":"macOS"},{"deprecated":false,"unavailable":false,"introducedAt":"9.0","beta":false,"name":"tvOS"},{"deprecated":false,"unavailable":false,"beta":false,"name":"visionOS","introducedAt":"1.0"},{"deprecated":false,"unavailable":false,"introducedAt":"2.0","beta":false,"name":"watchOS"}],"modules":[{"relatedModules":[],"name":"Swift"}],"externalID":"s:ScT6cancelyyF","extendedModule":"_Concurrency","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Success"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Failure"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Error"},{"text":".","type":"text"}]},"roleHeading":"Instance Method","symbolKind":"method","role":"symbol","title":"cancel()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancel"},{"kind":"text","text":"()"}]},"sections":[],"abstract":[{"type":"text","text":"Cancels this task."}],"seeAlsoSections":[{"title":"Canceling Tasks","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:isolation:)"],"generated":true,"anchor":"Canceling-Tasks"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancel"},{"kind":"text","text":"()"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Cancelling a task has three primary effects:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"It flags the task as canceled."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"It causes any active cancellation handlers on the task to run, once.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"It cancels any child tasks and task groups of the task, including","type":"text"},{"type":"text","text":" "},{"text":"those created in the future. If those tasks have cancellation handlers,","type":"text"},{"type":"text","text":" "},{"text":"they also are triggered.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Task cancellation is cooperative and idempotent."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Cancelling a task does not automatically cause arbitrary functions on the task","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to stop running or throw errors. A function "},{"type":"emphasis","inlineContent":[{"text":"may","type":"text"}]},{"type":"text","text":" choose to react"},{"type":"text","text":" "},{"type":"text","text":"to cancellation by ending its work early, and it is conventional to"},{"type":"text","text":" "},{"type":"text","text":"signal that to callers by throwing "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":". However,"},{"type":"text","text":" "},{"type":"text","text":"a function that doesn’t specifically check for cancellation will"},{"type":"text","text":" "},{"type":"text","text":"run to completion normally, even if the task it is running on is"},{"type":"text","text":" "},{"type":"text","text":"canceled. However, that function might still end early if it calls"},{"type":"text","text":" "},{"type":"text","text":"other code that handles cancellation by throwing and that function doesn’t"},{"type":"text","text":" "},{"type":"text","text":"handle the error."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It’s safe to cancel a task from any task or thread. It’s safe for"},{"type":"text","text":" "},{"type":"text","text":"multiple tasks or threads to cancel the same task at the same"},{"type":"text","text":" "},{"type":"text","text":"time. Cancelling a task that has already been canceled has no"},{"type":"text","text":" "},{"type":"text","text":"additional effect."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cancel"},{"type":"text","text":" may need to acquire locks and synchronously run"},{"type":"text","text":" "},{"type":"text","text":"arbitrary cancellation-handler code associated with the"},{"type":"text","text":" "},{"type":"text","text":"canceled task. To reduce the risk of deadlock, it is"},{"type":"text","text":" "},{"type":"text","text":"recommended that callers release any locks they might be"},{"type":"text","text":" "},{"type":"text","text":"holding before they call cancel."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the task has already run past the last point where it could have"},{"type":"text","text":" "},{"type":"text","text":"performed a cancellation check, cancelling it may have no observable effects."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"Task.checkCancellation()"}]}],"type":"aside","style":"note","name":"See Also"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:isolation:)"}]}],"type":"aside","style":"note","name":"See Also"}]}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/Task/isCancelled-swift.type.property":{"url":"\/documentation\/swift\/task\/iscancelled-swift.type.property","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Success","type":"codeVoice"},{"type":"text","text":" is "},{"code":"Never","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Failure","type":"codeVoice"},{"type":"text","text":" is "},{"code":"Never","type":"codeVoice"},{"type":"text","text":"."}]},"abstract":[{"type":"text","text":"A Boolean value that indicates whether the task should stop executing."}],"role":"symbol","title":"isCancelled","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isCancelled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/withTaskCancellationHandler(operation:onCancel:isolation:)":{"url":"\/documentation\/swift\/withtaskcancellationhandler(operation:oncancel:isolation:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:isolation:)","abstract":[{"type":"text","tex