{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task"]]},"variants":[{"paths":["\/documentation\/swift\/task\/cancel()"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:isolation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-8zlgh","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-2lzl8","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/hasActiveCancellationShield"],"generated":true,"anchor":"Task-Cancellation","title":"Task Cancellation"}],"kind":"symbol","abstract":[{"type":"text","text":"Cancels this task."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancelling a task has three primary effects:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"It flags the task as canceled."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"It causes any active cancellation handlers on the task to run, once."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"It cancels any child tasks and task groups of the task, including"},{"type":"text","text":" "},{"type":"text","text":"those created in the future. If those tasks have cancellation handlers,"},{"type":"text","text":" "},{"type":"text","text":"they also are triggered."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Task cancellation is cooperative and idempotent."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancelling a task does not automatically cause arbitrary functions on the task"},{"type":"text","text":" "},{"type":"text","text":"to stop running or throw errors. A function "},{"type":"emphasis","inlineContent":[{"type":"text","text":"may"}]},{"type":"text","text":" choose to react"},{"type":"text","text":" "},{"type":"text","text":"to cancellation by ending its work early, and it is conventional to"},{"type":"text","text":" "},{"type":"text","text":"signal that to callers by throwing "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":". However,"},{"type":"text","text":" "},{"type":"text","text":"a function that doesn’t specifically check for cancellation will"},{"type":"text","text":" "},{"type":"text","text":"run to completion normally, even if the task it is running on is"},{"type":"text","text":" "},{"type":"text","text":"canceled. However, that function might still end early if it calls"},{"type":"text","text":" "},{"type":"text","text":"other code that handles cancellation by throwing and that function doesn’t"},{"type":"text","text":" "},{"type":"text","text":"handle the error."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It’s safe to cancel a task from any task or thread. It’s safe for"},{"type":"text","text":" "},{"type":"text","text":"multiple tasks or threads to cancel the same task at the same"},{"type":"text","text":" "},{"type":"text","text":"time. Cancelling a task that has already been canceled has no"},{"type":"text","text":" "},{"type":"text","text":"additional effect."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cancel"},{"type":"text","text":" may need to acquire locks and synchronously run"},{"type":"text","text":" "},{"type":"text","text":"arbitrary cancellation-handler code associated with the"},{"type":"text","text":" "},{"type":"text","text":"canceled task. To reduce the risk of deadlock, it is"},{"type":"text","text":" "},{"type":"text","text":"recommended that callers release any locks they might be"},{"type":"text","text":" "},{"type":"text","text":"holding before they call cancel."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the task has already run past the last point where it could have"},{"type":"text","text":" "},{"type":"text","text":"performed a cancellation check, cancelling it may have no observable effects."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"Task.checkCancellation()"}]}],"style":"note","name":"See Also","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:isolation:)"}]}],"style":"note","name":"See Also","type":"aside"}],"kind":"content"}],"metadata":{"platforms":[{"beta":false,"introducedAt":"8.0","deprecated":false,"unavailable":false,"name":"iOS"},{"deprecated":false,"beta":false,"introducedAt":"8.0","name":"iPadOS","unavailable":false},{"deprecated":false,"beta":false,"introducedAt":"13.0","name":"Mac Catalyst","unavailable":false},{"deprecated":false,"beta":false,"introducedAt":"10.10","name":"macOS","unavailable":false},{"deprecated":false,"beta":false,"introducedAt":"9.0","name":"tvOS","unavailable":false},{"beta":false,"deprecated":false,"name":"visionOS","introducedAt":"1.0","unavailable":false},{"beta":false,"deprecated":false,"name":"watchOS","introducedAt":"2.0","unavailable":false}],"externalID":"s:ScT6cancelyyF","role":"symbol","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keywo