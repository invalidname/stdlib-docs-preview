{"abstract":[{"type":"text","text":"Cancels this task."}],"kind":"symbol","seeAlsoSections":[{"anchor":"Task-Cancellation","generated":true,"title":"Task Cancellation","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:isolation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-8zlgh","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-2lzl8","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/hasActiveCancellationShield"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel()","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"Swift","relatedModules":[]}],"title":"cancel()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancel"},{"kind":"text","text":"()"}],"role":"symbol","externalID":"s:ScT6cancelyyF","platforms":[{"name":"iOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"8.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"iPadOS","introducedAt":"8.0"},{"unavailable":false,"introducedAt":"13.0","beta":false,"name":"Mac Catalyst","deprecated":false},{"unavailable":false,"introducedAt":"10.10","beta":false,"name":"macOS","deprecated":false},{"name":"tvOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"9.0"},{"unavailable":false,"introducedAt":"1.0","beta":false,"name":"visionOS","deprecated":false},{"unavailable":false,"introducedAt":"2.0","beta":false,"name":"watchOS","deprecated":false}],"conformance":{"constraints":[{"code":"Success","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Failure"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Error"},{"type":"text","text":"."}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"extendedModule":"_Concurrency","roleHeading":"Instance Method","symbolKind":"method"},"variants":[{"paths":["\/documentation\/swift\/task\/cancel()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"()","kind":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancelling a task has three primary effects:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"It flags the task as canceled.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"It causes any active cancellation handlers on the task to run, once."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"It cancels any child tasks and task groups of the task, including"},{"type":"text","text":" "},{"type":"text","text":"those created in the future. If those tasks have cancellation handlers,"},{"type":"text","text":" "},{"type":"text","text":"they also are triggered."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Task cancellation is cooperative and idempotent.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Cancelling a task does not automatically cause arbitrary functions on the task","type":"text"},{"text":" ","type":"text"},{"text":"to stop running or throw errors. A function ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"may","type":"text"}]},{"text":" choose to react","type":"text"},{"text":" ","type":"text"},{"text":"to cancellation by ending its work early, and it is conventional to","type":"text"},{"text":" ","type":"text"},{"text":"signal that to callers by throwing ","type":"text"},{"type":"codeVoice","code":"CancellationError"},{"text":". However,","type":"text"},{"text":" ","type":"text"},{"text":"a function that doesn’t specifically check for cancellation will","type":"text"},{"text":" ","type":"text"},{"text":"run to completion normally, even if the task it is running on is","type":"text"},{"text":" ","type":"text"},{"text":"canceled. However, that function might still end early if it calls","type":"text"},{"text":" ","type":"text"},{"text":"other code that handles cancellation by throwing and that function doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"handle the error.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It’s safe to cancel a task from any task or thread. It’s safe for","type":"text"},{"text":" ","type":"text"},{"text":"multiple tasks or threads to cancel the same task at the same","type":"text"},{"text":" ","type":"text"},{"text":"time. Cancelling a task that has already been canceled has no","type":"text"},{"text":" ","type":"text"},{"text":"additional effect.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"cancel","type":"codeVoice"},{"text":" may need to acquire locks and synchronously run","type":"text"},{"text":" ","type":"text"},{"text":"arbitrary cancellation-handler code associated with the","type":"text"},{"text":" ","type":"text"},{"text":"canceled task. To reduce the risk of deadlock, it is","type":"text"},{"text":" ","type":"text"},{"text":"recommended that callers release any locks they might be","type":"text"},{"text":" ","type":"text"},{"text":"holding before they call cancel.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the task has already run past the last point where it could have","type":"text"},{"text":" ","type":"text"},{"text":"performed a cancellation check, cancelling it may have no observable effects.","type":"text"}]},{"content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"Task.checkCancellation()"}],"type":"paragraph"}],"type":"aside","name":"See Also","style":"note"},{"name":"See Also","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"withTaskCancellationHandler(operation:onCancel:isolation:)","type":"codeVoice"}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/Task/checkCancellation()":{"kind":"symbol","abstract":[{"type":"text","text":"Throws an error if the task was canceled."}],"title":"checkCancellation()","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"checkCancellation","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"throws","kind":"keyword"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Success"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Never"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Failure"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Never"},{"text":".","type":"text"}]},"type":"topic","url":"\/documentation\/swift\/task\/checkcancellation()","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()"},"doc://com.apple.Swift/documentation/Swift/Task/isCancelled-swift.type.property":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/d