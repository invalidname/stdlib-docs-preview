},{"deprecated":false,"introducedAt":"1.0","beta":false,"name":"visionOS","unavailable":false},{"deprecated":false,"introducedAt":"2.0","beta":false,"name":"watchOS","unavailable":false}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"()","kind":"text"}],"modules":[{"name":"Swift","relatedModules":[]}],"roleHeading":"Instance Method","symbolKind":"method"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"Cancelling a task has three primary effects:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It flags the task as canceled."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It causes any active cancellation handlers on the task to run, once."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It cancels any child tasks and task groups of the task, including"},{"type":"text","text":" "},{"type":"text","text":"those created in the future. If those tasks have cancellation handlers,"},{"type":"text","text":" "},{"type":"text","text":"they also are triggered."}]}]}]},{"inlineContent":[{"type":"text","text":"Task cancellation is cooperative and idempotent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Cancelling a task does not automatically cause arbitrary functions on the task"},{"type":"text","text":" "},{"type":"text","text":"to stop running or throw errors. A function "},{"type":"emphasis","inlineContent":[{"type":"text","text":"may"}]},{"type":"text","text":" choose to react"},{"type":"text","text":" "},{"type":"text","text":"to cancellation by ending its work early, and it is conventional to"},{"type":"text","text":" "},{"type":"text","text":"signal that to callers by throwing "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":". However,"},{"type":"text","text":" "},{"type":"text","text":"a function that doesn’t specifically check for cancellation will"},{"type":"text","text":" "},{"type":"text","text":"run to completion normally, even if the task it is running on is"},{"type":"text","text":" "},{"type":"text","text":"canceled. However, that function might still end early if it calls"},{"type":"text","text":" "},{"type":"text","text":"other code that handles cancellation by throwing and that function doesn’t"},{"type":"text","text":" "},{"type":"text","text":"handle the error."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It’s safe to cancel a task from any task or thread. It’s safe for"},{"type":"text","text":" "},{"type":"text","text":"multiple tasks or threads to cancel the same task at the same"},{"type":"text","text":" "},{"type":"text","text":"time. Cancelling a task that has already been canceled has no"},{"type":"text","text":" "},{"type":"text","text":"additional effect."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"cancel"},{"type":"text","text":" may need to acquire locks and synchronously run"},{"type":"text","text":" "},{"type":"text","text":"arbitrary cancellation-handler code associated with the"},{"type":"text","text":" "},{"type":"text","text":"canceled task. To reduce the risk of deadlock, it is"},{"type":"text","text":" "},{"type":"text","text":"recommended that callers release any locks they might be"},{"type":"text","text":" "},{"type":"text","text":"holding before they call cancel."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the task has already run past the last point where it could have"},{"type":"text","text":" "},{"type":"text","text":"performed a cancellation check, cancelling it may have no observable effects."}],"type":"paragraph"},{"style":"note","name":"See Also","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"Task.checkCancellation()"}]}]},{"style":"note","name":"See Also","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:isolation:)"}]}]}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel()"},"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/Task/isCancelled-swift.property":{"title":"isCancelled","abstract":[{"text":"A Boolean value that indicates whether the task should stop executing.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.property","conformance":{"constraints":[{"type":"codeVoice","code":"Success"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Failure"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Error"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"url":"\/documentation\/swift\/task\/iscancelled-swift.property","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isCancelled","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/withTaskCancellationHandler(operation:onCancel:isolation:)":{"url":"\/docu