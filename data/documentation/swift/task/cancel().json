{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/task\/cancel()"]}],"metadata":{"modules":[{"name":"Swift","relatedModules":[]}],"role":"symbol","platforms":[{"name":"iOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"8.0"},{"name":"iPadOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"8.0"},{"name":"Mac Catalyst","unavailable":false,"beta":false,"introducedAt":"13.0","deprecated":false},{"name":"macOS","unavailable":false,"beta":false,"introducedAt":"10.10","deprecated":false},{"name":"tvOS","unavailable":false,"beta":false,"introducedAt":"9.0","deprecated":false},{"name":"visionOS","unavailable":false,"beta":false,"introducedAt":"1.0","deprecated":false},{"name":"watchOS","unavailable":false,"beta":false,"introducedAt":"2.0","deprecated":false}],"externalID":"s:ScT6cancelyyF","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancel"},{"kind":"text","text":"()"}],"title":"cancel()","roleHeading":"Instance Method","extendedModule":"_Concurrency","conformance":{"constraints":[{"type":"codeVoice","code":"Success"},{"type":"text","text":" conforms to "},{"code":"Sendable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Failure","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Error","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]}},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancel"},{"kind":"text","text":"()"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Cancelling a task has three primary effects:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"It flags the task as canceled."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It causes any active cancellation handlers on the task to run, once."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"It cancels any child tasks and task groups of the task, including"},{"type":"text","text":" "},{"text":"those created in the future. If those tasks have cancellation handlers,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"they also are triggered."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Task cancellation is cooperative and idempotent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Cancelling a task does not automatically cause arbitrary functions on the task"},{"type":"text","text":" "},{"type":"text","text":"to stop running or throw errors. A function "},{"inlineContent":[{"text":"may","type":"text"}],"type":"emphasis"},{"type":"text","text":" choose to react"},{"type":"text","text":" "},{"type":"text","text":"to cancellation by ending its work early, and it is conventional to"},{"type":"text","text":" "},{"text":"signal that to callers by throwing ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":". However,","type":"text"},{"text":" ","type":"text"},{"text":"a function that doesn’t specifically check for cancellation will","type":"text"},{"text":" ","type":"text"},{"text":"run to completion normally, even if the task it is running on is","type":"text"},{"type":"text","text":" "},{"text":"canceled. However, that function might still end early if it calls","type":"text"},{"type":"text","text":" "},{"text":"other code that handles cancellation by throwing and that function doesn’t","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"handle the error."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It’s safe to cancel a task from any task or thread. It’s safe for"},{"type":"text","text":" "},{"type":"text","text":"multiple tasks or threads to cancel the same task at the same"},{"type":"text","text":" "},{"text":"time. Cancelling a task that has already been canceled has no","type":"text"},{"text":" ","type":"text"},{"text":"additional effect.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"code":"cancel","type":"codeVoice"},{"text":" may need to acquire locks and synchronously run","type":"text"},{"text":" ","type":"text"},{"text":"arbitrary cancellation-handler code associated with the","type":"text"},{"text":" ","type":"text"},{"text":"canceled task. To reduce the risk of deadlock, it is","type":"text"},{"text":" ","type":"text"},{"text":"recommended that callers release any locks they might be","type":"text"},{"type":"text","text":" "},{"text":"holding before they call cancel.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the task has already run past the last point where it could have"},{"type":"text","text":" "},{"type":"text","text":"performed a cancellation check, cancelling it may have no observable effects."}]},{"name":"See Also","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"Task.checkCancellation()","type":"codeVoice"}]}],"style":"note"},{"name":"See Also","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"withTaskCancellationHandler(operation:onCancel:isolation:)","type":"codeVoice"}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Cancels this task.","type":"text"}],"seeAlsoSections":[{"generated":true,"title":"Task Cancellation","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel(reason:)","doc:\/\/com.apple.Swift\/docum