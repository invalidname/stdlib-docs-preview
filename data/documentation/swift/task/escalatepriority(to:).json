{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task"]]},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"escalatePriority","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"newPriority","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority","text":"TaskPriority","kind":"typeIdentifier","preciseIdentifier":"s:ScP"},{"text":")","kind":"text"}],"platforms":["macOS"]}]},{"parameters":[{"name":"task","content":[{"inlineContent":[{"type":"text","text":"The task which to escalate the priority of"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The new priority the task should continue executing on","type":"text"}],"type":"paragraph"}],"name":"newPriority"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"content":[{"inlineContent":[{"text":"This API should rarely be used, and instead you can rely on","type":"text"},{"text":" ","type":"text"},{"text":"structured concurrency and implicit priority escalation which happens","type":"text"},{"text":" ","type":"text"},{"text":"when a higher priority task awaits on a result of a lower priority task.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"I.e. using ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" on the target task usually is the correct way to","type":"text"},{"text":" ","type":"text"},{"text":"escalate the target task to the current priority of the calling task,","type":"text"},{"text":" ","type":"text"},{"text":"especially because in such setup if the waiting task gets escalated,","type":"text"},{"text":" ","type":"text"},{"text":"the waited on task would be escalated automatically as well.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Warning","style":"warning"},{"type":"paragraph","inlineContent":[{"text":"The concurrency runtime is free to interpret and handle escalation","type":"text"},{"text":" ","type":"text"},{"text":"depending on platform characteristics.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Priority escalation is propagated to child tasks of the waited-on task,"},{"type":"text","text":" "},{"type":"text","text":"and will trigger any priority escalation handlers, if any were registered."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Escalation can only "},{"type":"emphasis","inlineContent":[{"type":"text","text":"increase"}]},{"type":"text","text":" the priority of a task, and"},{"type":"text","text":" "},{"type":"text","text":"de-escalating priority is not supported."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method can be called from any task or thread."}]}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/escalatePriority(to:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/task\/escalatepriority(to:)"]}],"abstract":[{"text":"Manually escalate the task ","type":"text"},{"code":"priority","type":"codeVoice"},{"text":" of this task to the ","type":"text"},{"code":"newPriority","type":"codeVoice"},{"text":".","type":"text"}],"sections":[],"metadata":{"extendedModule":"_Concurrency","roleHeading":"Instance Method","modules":[{"name":"Swift","relatedModules":[]}],"platforms":[{"unavailable":false,"deprecated":false,"beta":false,"name":"iOS","introducedAt":"8.0"},{"unavailable":false,"deprecated":false,"beta":false,"name":"iPadOS","introducedAt":"8.0"},{"unavailable":false,"deprecated":false,"beta":false,"name":"Mac Catalyst","introducedAt":"13.0"},{"unavailable":false,"dep