{"abstract":[{"type":"text","text":"Manually escalate the task "},{"type":"codeVoice","code":"priority"},{"type":"text","text":" of this task to the "},{"type":"codeVoice","code":"newPriority"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"escalatePriority","kind":"identifier"},{"kind":"text","text":"("},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"newPriority","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority","text":"TaskPriority","kind":"typeIdentifier","preciseIdentifier":"s:ScP"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The task which to escalate the priority of","type":"text"}],"type":"paragraph"}],"name":"task"},{"content":[{"inlineContent":[{"text":"The new priority the task should continue executing on","type":"text"}],"type":"paragraph"}],"name":"newPriority"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"aside","name":"Warning","content":[{"inlineContent":[{"type":"text","text":"This API should rarely be used, and instead you can rely on"},{"type":"text","text":" "},{"type":"text","text":"structured concurrency and implicit priority escalation which happens"},{"type":"text","text":" "},{"type":"text","text":"when a higher priority task awaits on a result of a lower priority task."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"I.e. using "},{"type":"codeVoice","code":"await"},{"type":"text","text":" on the target task usually is the correct way to"},{"type":"text","text":" "},{"type":"text","text":"escalate the target task to the current priority of the calling task,"},{"type":"text","text":" "},{"type":"text","text":"espec