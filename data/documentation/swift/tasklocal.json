{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"metadata":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TaskLocal","kind":"identifier"}],"navigatorTitle":[{"text":"TaskLocal","kind":"identifier"}],"platforms":[{"name":"iOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"8.0"},{"name":"iPadOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"8.0"},{"name":"Mac Catalyst","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"13.0"},{"name":"macOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"10.10"},{"name":"tvOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"9.0"},{"name":"visionOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"1.0"},{"name":"watchOS","deprecated":false,"unavailable":false,"beta":false,"introducedAt":"2.0"}],"externalID":"s:12_Concurrency9TaskLocalC","role":"symbol","roleHeading":"Class","title":"TaskLocal","modules":[{"name":"Swift","relatedModules":[]}],"symbolKind":"class"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal"},"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal()"],"title":"Task-Local Storage","anchor":"Task-Local-Storage","generated":true}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TaskLocal"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","text":"Sendable"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"A task-local value is a value that can be bound and read in the context of a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","isActive":true},{"type":"text","text":". It is implicitly carried with the task, and is accessible by any"},{"type":"text","text":" "},{"type":"text","text":"child tasks it creates (such as TaskGroup or "},{"code":"async let","type":"codeVoice"},{"type":"text","text":" created tasks)."}],"type":"paragraph"},{"text":"Task-local declarations","level":3,"type":"heading","anchor":"Task-local-declarations"},{"inlineContent":[{"type":"text","text":"Task locals must be declared as static properties or global properties, like this:"}],"type":"paragraph"},{"code":["enum Example {","    @TaskLocal","    static var traceID: TraceID?","}","","\/\/ Global task local properties are supported since Swift 6.0:","@TaskLocal","var contextualNumber: Int = 12"],"type":"codeListing","syntax":"swift"},{"text":"Default values","level":3,"type":"heading","anchor":"Default-values"},{"inlineContent":[{"type":"text","text":"Reading a task local value when no value was bound to it results in returning"},{"type":"text","text":" "},{"type":"text","text":"its default value. For a task local declared as optional (such as e.g. "},{"code":"TraceID?","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"this defaults to nil, however a different default value may be defined at declaration"},{"type":"text","text":" "},{"type":"text","text":"site of the task local, like this:"}],"type":"paragraph"},{"code":["enum Example { ","    @TaskLocal","    static var traceID: TraceID = TraceID.default","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The default value is returned whenever the task-local is read"},{"type":"text","text":" "},{"type":"text","text":"from a context which either: has no task available to read the value from"},{"type":"text","text":" "},{"type":"text","text":"(e.g. a synchronous function, called without any asynchronous function in its call stack),"},{"type":"text","text":" "},{"type":"text","text":"or no value was bound within the scope of the current task or any of its parent tasks."}],"type":"paragraph"},{"text":"Reading task-local values","level":3,"type":"heading","anchor":"Reading-task-local-values"},{"inlineContent":[{"type":"text","text":"Reading task local values is simple and looks the same as-if reading a normal"},{"type":"text","text":" "},{"type":"text","text":"static property:"}],"type":"paragraph"},{"code":["guard let traceID = Example.traceID else {","  print(\"no trace id\")","  return","}","print(traceID)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"It is possible to perform task-local value reads from either asynchronous"},{"type":"text","text":" "},{"type":"text","text":"or synchronous functions."}],"type":"paragraph"},{"text":"Binding task-local values","level":3,"type":"heading","anchor":"Binding-task-local-values"},{"inlineContent":[{"type":"text","text":"Task local values cannot be "},{"code":"set","type":"codeVoice"},{"type":"text","text":" directly and must instead be bound using"},{"type":"text","text":" "},{"type":"text","text":"the scoped "},{"code":"$traceID.withValue() { ... }","type":"codeVoice"},{"type":"text","text":" operation. The value is only bound"},{"type":"text","text":" "},{"type":"text","text":"for the duration of that scope, and is available to any child tasks which"},{"type":"text","text":" "},{"type":"text","text":"are created within that scope."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Detached tasks do not inherit task-local values, however tasks created using"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"Task { ... }","type":"codeVoice"},{"type":"text","text":" initializer do inherit task-locals by copying them to the"},{"type":"text","text":" "},{"type":"text","text":"new asynchronous task, even though it is an un-structured task."}],"type":"paragraph"},{"text":"Using task local values outside of tasks","level":3,"type":"heading","anchor":"Using-task-local-values-outside-of-tasks"},{"inlineContent":[{"type":"text","text":"It is possible to bind and read task local values outside of tasks."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This comes in handy within synchronous functions which are not guaranteed"},{"type":"text","text":" "},{"type":"text","text":"to be called from within a task. When binding a task-local value from"},{"type":"text","text":" "},{"type":"text","text":"outside of a task, the runtime will set a thread-local in which the same"},{"type":"text","text":" "},{"type":"text","text":"storage mechanism as used within tasks will be used. This means that you"},{"type":"text","text":" "},{"type":"text","text":"can reliably bind and read task local values without having to worry"},{"type":"text","text":" "},{"type":"text","text":"about the specific calling context, e.g.:"}],"type":"paragraph"},{"code":["func enter() {","    Example.$traceID.withValue(\"1234\") {","        read() \/\/ always \"1234\", regardless if enter() was called from inside a task or not:","    }    ","}","","func read() -> String {","    if let value = Self.traceID {","        \"\\(value)\" ","    } else { ","        \"<no value>\"","    }","}","","\/\/ 1) Call `enter` from non-Task code","\/\/    e.g. synchronous main() or non-Task thread (e.g. a plain pthread)","enter()","","\/\/ 2) Call 'enter' from Task","Task { ","    enter()","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"In either cases listed above, the binding and reading of the task-local value works as expected."}],"type":"paragraph"},{"text":"Examples","level":3,"type":"heading","anchor":"Examples"},{"code":["enum Example {","    @TaskLocal","    static var traceID: TraceID?","}","","func read() -> String {","    if let value = Self.traceID {","        \"\\(value)\" ","    } else { ","        \"<no value>\"","    }","}","","await Example.$traceID.withValue(1234) { \/\/ bind the value","  print(\"traceID: \\(Example.traceID)\") \/\/ traceID: 1234","  read() \/\/ traceID: 1234","","  async let id = read() \/\/ async let child task, traceID: 1234","","  await withTaskGroup(of: String.self) { group in ","      group.addTask { read() } \/\/ task group child task, traceID: 1234","      return await group.next()!","  }","","  Task { \/\/ unstructured tasks do inherit task locals by copying","    read() \/\/ traceID: 1234","  }","","  Task.detached { \/\/ detached tasks do not inherit task-local values","    read() \/\/ traceID: nil","  }","}"],"type":"codeListing","syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal()"}]}],"type":"aside","style":"note","name":"See Also"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/tasklocal"]}],"sections":[],"kind":"symbol","abstract":[{"text":"Wrapper type that defines a task-local value key.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/init(wrappedValue:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/com.apple.Swift\/docume