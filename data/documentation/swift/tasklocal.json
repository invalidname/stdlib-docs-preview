{"metadata":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"TaskLocal","kind":"identifier"}],"roleHeading":"Class","modules":[{"name":"Swift","relatedModules":[]}],"externalID":"s:12_Concurrency9TaskLocalC","platforms":[{"name":"iOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"8.0"},{"name":"iPadOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"8.0"},{"name":"Mac Catalyst","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"13.0"},{"name":"macOS","beta":false,"deprecated":false,"unavailable":false,"introducedAt":"10.10"},{"beta":false,"introducedAt":"9.0","deprecated":false,"unavailable":false,"name":"tvOS"},{"beta":false,"introducedAt":"1.0","deprecated":false,"unavailable":false,"name":"visionOS"},{"beta":false,"introducedAt":"2.0","deprecated":false,"unavailable":false,"name":"watchOS"}],"symbolKind":"class","navigatorTitle":[{"kind":"identifier","text":"TaskLocal"}],"role":"symbol","title":"TaskLocal"},"kind":"symbol","sections":[],"seeAlsoSections":[{"generated":true,"title":"Task-Local Storage","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal()"],"anchor":"Task-Local-Storage"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/tasklocal"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/init(wrappedValue:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/description","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/projectedValue","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/wrappedValue"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/get()","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/withValue(_:operation:file:line:)-79atg","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/withValue(_:operation:file:line:)-ozih","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/withValue(_:operation:file:line:)-wunp","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/withValue(_:operation:isolation:file:line:)"],"anchor":"Instance-Methods"}],"abstract":[{"type":"text","text":"Wrapper type that defines a task-local value key."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TaskLocal"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A task-local value is a value that can be bound and read in the context of a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task"},{"type":"text","text":". It is implicitly carried with the task, and is accessible by any"},{"type":"text","text":" "},{"type":"text","text":"child tasks it creates (such as TaskGroup or "},{"type":"codeVoice","code":"async let"},{"type":"text","text":" created tasks)."}]},{"anchor":"Task-local-declarations","text":"Task-local declarations","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Task locals must be declared as static properties or global properties, like this:"}]},{"type":"codeListing","syntax":"swift","code":["enum Example {","    @TaskLocal","    static var traceID: TraceID?","}","","\/\/ Global task local properties are supported since Swift 6.0:","@TaskLocal","var contextualNumber: Int = 12"]},{"anchor":"Default-values","text":"Default values","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reading a task local value when no value was bound to it results in returning"},{"type":"text","text":" "},{"type":"text","text":"its default value. For a task local declared as optional (such as e.g. "},{"type":"codeVoice","code":"TraceID?"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"this defaults to nil, however a different default value may be defined at declaration"},{"type":"text","text":" "},{"type":"text","text":"site of the task local, like this:"}]},{"type":"codeListing","syntax":"swift","code":["enum Example { ","    @TaskLocal","    static var traceID: TraceID = TraceID.default","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default value is returned whenever the task-local is read"},{"type":"text","text":" "},{"type":"text","text":"from a context which either: has no task available to read the value from"},{"type":"text","text":" "},{"type":"text","text":"(e.g. a synchronous function, called without any asynchronous function in its call stack),"},{"type":"text","text":" "},{"type":"text","text":"or no value was bound within the scope of the current task or any of its parent tasks."}]},{"anchor":"Reading-task-local-values","text":"Reading task-local values","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reading task local values is simple and looks the same as-if reading a normal"},{"type":"text","text":" "},{"type":"text","text":"static property:"}]},{"type":"codeListing","syntax":"swift","code":["guard let traceID = Example.traceID else {","  print(\"no trace id\")","  return","}","print(traceID)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to perform task-local value reads from either asynchronous"},{"type":"text","text":" "},{"type":"text","text":"or synchronous functions."}]},{"anchor":"Binding-task-local-values","text":"Binding task-local values","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Task local values cannot be "},{"type":"codeVoice","code":"set"},{"type":"text","text":" directly and must instead be bound using"},{"type":"text","text":" "},{"type":"text","text":"the scoped "},{"type":"codeVoice","code":"$traceID.withValue() { ... }"},{"type":"text","text":" operation. The value is only bound"},{"type":"text","text":" "},{"type":"text","text":"for the duration of that scope, and is available to any child tasks which"},{"type":"text","text":" "},{"type":"text","text":"are created within that scope."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Detached tasks do not inherit task-local values, however tasks created using"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"Task { ... }"},{"type":"text","text":" initializer do inherit task-locals by copying them to the"},{"type":"text","text":" "},{"type":"text","text":"new asynchronous task, even though it is an un-structured task."}]},{"anchor":"Using-task-local-values-outside-of-tasks","text":"Using task local values outside of tasks","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to bind and read task local values outside of tasks."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This comes in handy within synchronous functions which are not guaranteed"},{"type":"text","text":" "},{"type":"text","text":"to be called from within a task. When binding a task-local value from"},{"type":"text","text":" "},{"type":"text","text":"outside of a task, the runtime will set a thread-local in which the same"},{"type":"text","text":" "},{"type":"text","text":"storage mechanism as used within tasks will be used. This means that you"},{"type":"text","text":" "},{"type":"text","text":"can reliably bind and read task local values without having to worry"},{"type":"text","text":" "},{"type":"text","text":"about the specific calling context, e.g.:"}]},{"type":"codeListing","syntax":"swift","code":["func enter() {","    Example.$traceID.withValue(\"1234\") {","        read() \/\/ always \"1234\", regardless if enter() was called from inside a task or not:","    }    ","}","","func read() -> String {","    if let value = Self.traceID {","        \"\\(value)\" ","    } else { ","        \"<no value>\"","    }","}","","\/\/ 1) Call `enter` from non-Task code","\/\/    e.g. synchronous main() or non-Task thread (e.g. a plain pthread)","enter()","","\/\/ 2) Call 'enter' from Task","Task { ","    enter()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In either cases listed above, the binding and reading of the task-local value works as expected."}]},{"type":"heading","level":3,"anchor":"Task-local-values-without-tasks","text":"Task local values, without tasks"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a task local value is bound in a context executing outside of a task (e.g. on a plain old Thread),"},{"type":"text","text":" "},{"type":"text","text":"the task local will fall-back to managing a thread-local value for the scope of the "},{"type":"codeVoice","code":"withValue"},{"type":"text","text":" function."},{"type":"text","text":" "},{"type":"text","text":"In other words, this task locals work as expected even if used in a context without an active swift concurrency task."}]},{"type":"heading","level":3,"anchor":"Examples","text":"Examples"},{"type":"codeListing","syntax":"swift","code":["enum Example {","    @TaskLocal","    static var traceID: TraceID?","}","","func read() -> String {","    if let value = Self.traceID {","        \"\\(value)\" ","    } else { ","        \"<no value>\"","    }","}","","await Example.$traceID.withValue(1234) { \/\/ bind the value","  print(\"traceID: \\(Example.traceID)\") \/\/ traceID: 1234","  read() \/\/ traceID: 1234","","  async let id = read() \/\/ async let child task, traceID: 1234","","  await withTaskGroup(of: String.self) { group in ","      group.addTask { read() } \/\/ task group child task, traceID: 1234","      return await group.next()!","  }","","  Task { \/\/ unstructured tasks do inherit task locals by copying","    read() \/\/ traceID: 1234","  }","","  Task.detached { \/\/ detached tasks do not inherit task-local values","    read() \/\/ traceID: nil","  }","}"]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal()"}]}],"type":"aside","name":"See Also"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"references":{"doc://com.apple.Swift/documentation/Swift/Sendable":{"type":"topic","url":"\/documentation\/swift\/sendable","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"Sendable","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Sendable"}],"title":"Sendable","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","role":"symbol","abstract":[{"type":"text","text":"A thread-safe type whose values can be shared across arbitrary isolation"},{"type":"text","text":" "},{"type":"text","text":"domains without introducing a risk of data races."}]},"doc://com.apple.Swift/documentation/Swift/SendableMetatype":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype","url":"\/documentation\/swift\/sendablemetatype","abstract":[{"type":"text","text":"A type whose metatype can be shared across arbitrary isolation domains"},{"type":"text","text":" "},{"type":"text","text":"without introducing a risk of data races."}],"title":"SendableMetatype","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SendableMetatype"}],"navigatorTitle":[{"kind":"identifier","text":"SendableMetatype"}],"role":"symbol","type":"topic","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/TaskLocal/withValue(_:operation:file:line:)-ozih":{"abstract":[{"type":"text","text":"Binds the task-local to the specific value for the duration of the asynchronous operation."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withValue"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:12_Concurrency9TaskLocalC5Valuexmfp"},{"kind":"text","text":", "},{"kind":"externalParam","text":"operation"},{"kind":"text","text":": "},{"kind":"keyword","text":"nonisolated(nonsending)"},{"kind":"text","text":", "},{"kind":"externalParam","text":"file"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"text":"line","kind":"externalParam"},{"kind":"text","text":": "},{"text":"UInt","kind":"typeIdentifier","preciseIdentifier":"s:Su"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"R","preciseId