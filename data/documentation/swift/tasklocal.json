{"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/init(wrappedValue:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/description","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/projectedValue","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/wrappedValue"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/get()","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/withValue(_:operation:file:line:)-79atg","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/withValue(_:operation:file:line:)-ozih","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/withValue(_:operation:file:line:)-wunp","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/withValue(_:operation:isolation:file:line:)"]}],"seeAlsoSections":[{"title":"Task-Local Storage","anchor":"Task-Local-Storage","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal()"]}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal"},"abstract":[{"type":"text","text":"Wrapper type that defines a task-local value key."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TaskLocal","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A task-local value is a value that can be bound and read in the context of a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task"},{"type":"text","text":". It is implicitly carried with the task, and is accessible by any"},{"text":" ","type":"text"},{"text":"child tasks it creates (such as TaskGroup or ","type":"text"},{"code":"async let","type":"codeVoice"},{"text":" created tasks).","type":"text"}]},{"type":"heading","text":"Task-local declarations","anchor":"Task-local-declarations","level":3},{"type":"paragraph","inlineContent":[{"text":"Task locals must be declared as static properties or global properties, like this:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["enum Example {","    @TaskLocal","    static var traceID: TraceID?","}","","\/\/ Global task local properties are supported since Swift 6.0:","@TaskLocal","var contextualNumber: Int = 12"]},{"type":"heading","level":3,"text":"Default values","anchor":"Default-values"},{"type":"paragraph","inlineContent":[{"text":"Reading a task local value when no value was bound to it results in returning","type":"text"},{"type":"text","text":" "},{"type":"text","text":"its default value. For a task local declared as optional (such as e.g. "},{"type":"codeVoice","code":"TraceID?"},{"type":"text","text":"),"},{"type":"text","text":" "},{"text":"this defaults to nil, however a different default value may be defined at declaration","type":"text"},{"text":" ","type":"text"},{"text":"site of the task local, like this:","type":"text"}]},{"code":["enum Example { ","    @TaskLocal","    static var traceID: TraceID = TraceID.default","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default value is returned whenever the task-local is read"},{"type":"text","text":" "},{"type":"text","text":"from a context which either: has no task available to read the value from"},{"type":"text","text":" "},{"type":"text","text":"(e.g. a synchronous function, called without any asynchronous function in its call stack),"},{"type":"text","text":" "},{"type":"text","text":"or no value was bound within the scope of the current task or any of its parent tasks."}]},{"type":"heading","text":"Reading task-local values","anchor":"Reading-task-local-values","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reading task local values is simple and looks the same as-if reading a normal"},{"type":"text","text":" "},{"type":"text","text":"static property:"}]},{"code":["guard let traceID = Example.traceID else {","  print(\"no trace id\")","  return","}","print(traceID)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to perform task-local value reads from either asynchronous"},{"text":" ","type":"text"},{"text":"or synchronous functions.","type":"text"}]},{"level":3,"anchor":"Binding-task-local-values","type":"heading","text":"Binding task-local values"},{"inlineContent":[{"text":"Task local values cannot be ","type":"text"},{"code":"set","type":"codeVoice"},{"text":" directly and must instead be bound using","type":"text"},{"text":" ","type":"text"},{"text":"the scoped ","type":"text"},{"code":"$traceID.withValue() { ... }","type":"codeVoice"},{"text":" operation. The value is only bound","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for the duration of that scope, and is available to any child tasks which"},{"type":"text","text":" "},{"text":"are created within that scope.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Detached tasks do not inherit task-local values, however tasks created using","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the "},{"code":"Task { ... }","type":"codeVoice"},{"type":"text","text":" initializer do inherit task-locals by copying them to the"},{"type":"text","text":" "},{"type":"text","text":"new asynchronous task, even though it is an un-structured task."}],"type":"paragraph"},{"level":3,"anchor":"Using-task-local-values-outside-of-tasks","type":"heading","text":"Using task local values outside of tasks"},{"inlineContent":[{"type":"text","text":"It is possible to bind and read task local values outside of tasks."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This comes in handy within synchronous functions which are not guaranteed"},{"type":"text","text":" "},{"type":"text","text":"to be called from within a task. When binding a task-local value from"},{"type":"text","text":" "},{"type":"text","text":"outside of a task, the runtime will set a thread-local in which the same"},{"type":"text","text":" "},{"type":"text","text":"storage mechanism as used within tasks will be used. This means that you"},{"type":"text","text":" "},{"type":"text","text":"can reliably bind and read task local values without having to worry"},{"type":"text","text":" "},{"text":"about the specific calling context, e.g.:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func enter() {","    Example.$traceID.withValue(\"1234\") {","        read() \/\/ always \"1234\", regardless if enter() was called from inside a task or not:","    }    ","}","","func read() -> String {","    if let value = Self.traceID {","        \"\\(value)\" ","    } else { ","        \"<no value>\"","    }","}","","\/\/ 1) Call `enter` from non-Task code","\/\/    e.g. synchronous main() or non-Task thread (e.g. a plain pthread)","enter()","","\/\/ 2) Call 'enter' from Task","Task { ","    enter()","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"In either cases listed above, the binding and reading of the task-local value works as expected.","type":"text"}]},{"text":"Task local values, without tasks","type":"heading","anchor":"Task-local-values-without-tasks","level":3},{"inlineContent":[{"text":"If a task local value is bound in a context executing outside of a task (e.g. on a plain old Thread),","type":"text"},{"text":" ","type":"text"},{"text":"the task local will fall-back to managing a thread-local value for the scope of the ","type":"text"},{"type":"codeVoice","code":"withValue"},{"text":" function.","type":"text"},{"text":" ","type":"text"},{"text":"In other words, this task locals work as expected even if used in a context without an active swift concurrency task.","type":"text"}],"type":"paragraph"},{"text":"Examples","type":"heading","anchor":"Examples","level":3},{"code":["enum Example {","    @TaskLocal","    static var traceID: TraceID?","}","","func read() -> String {","    if let value = Self.traceID {","        \"\\(value)\" ","    } else { ","        \"<no value>\"","    }","}","","await Example.$traceID.withValue(1234) { \/\/ bind the value","  print(\"traceID: \\(Example.traceID)\") \/\/ traceID: 1234","  read() \/\/ traceID: 1234","","  async let id = read() \/\/ async let child task, traceID: 1234","","  await withTaskGroup(of: String.self) { group in ","      group.addTask { read() } \/\/ task group child task, traceID: 1234","      return await group.next()!","  }","","  Task { \/\/ unstructured tasks do inherit task locals by copying","    read() \/\/ traceID: 1234","  }","","  Task.detached { \/\/ detached tasks do not inherit task-local values","    read() \/\/ traceID: nil","  }","}"],"type":"codeListing","syntax":"swift"},{"name":"See Also","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal()","type":"reference"}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"metadata":{"title":"TaskLocal","navigatorTitle":[{"text":"TaskLocal","kind":"identifier"}],"platforms":[{"unavailable":false,"name":"iOS","beta":false,"deprecated":false,"introducedAt":"8.0"},{"unavailable":false,"name":"iPadOS","beta":false,"deprecated":false,"introducedAt":"8.0"},{"unavailable":false,"name":"Mac Catalyst","beta":false,"deprecated":false,"introducedAt":"13.0"},{"unavailable":false,"name":"macOS","beta":false,"deprecated":false,"introducedAt":"10.10"},{"beta":false,"deprecated":false,"name":"tvOS","introducedAt":"9.0","unavailable":false},{"beta":false,"deprecated":false,"name":"visionOS","introducedAt":"1.0","unavailable":false},{"beta":false,"deprecated":false,"name":"watchOS","introducedAt":"2.0","unavailable":false}],"roleHeading":"Class","externalID":"s:12_Concurrency9TaskLocalC","modules":[{"relatedModules":[],"name":"Swift"}],"role":"symbol","symbolKind":"class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"TaskLocal","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"variants":[{"paths":["\/documentation\/swift\/tasklocal"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/TaskLocal/projectedValue":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskLocal\/projectedValue","title":"projectedValue","role":"symbol","url":"\/documentation\/swift\/tasklocal\/projectedvalue","abstract":[],"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"projectedValue","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency9T