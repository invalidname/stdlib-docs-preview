{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"The priority of a task."}],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Comparable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Decodable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Encodable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Escapable","doc:\/\/com.apple.Swift\/documentation\/Swift\/RawRepresentable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"],"generated":true,"anchor":"Tasks","title":"Tasks"}],"metadata":{"title":"TaskPriority","platforms":[{"beta":false,"introducedAt":"8.0","name":"iOS","deprecated":false,"unavailable":false},{"beta":false,"introducedAt":"8.0","name":"iPadOS","deprecated":false,"unavailable":false},{"beta":false,"introducedAt":"13.0","name":"Mac Catalyst","deprecated":false,"unavailable":false},{"beta":false,"introducedAt":"10.10","name":"macOS","deprecated":false,"unavailable":false},{"beta":false,"introducedAt":"9.0","name":"tvOS","deprecated":false,"unavailable":false},{"beta":false,"introducedAt":"1.0","name":"visionOS","deprecated":false,"unavailable":false},{"beta":false,"introducedAt":"2.0","name":"watchOS","deprecated":false,"unavailable":false}],"externalID":"s:ScP","modules":[{"relatedModules":[],"name":"Swift"}],"role":"symbol","roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"TaskPriority"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TaskPriority","kind":"identifier"}]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TaskPriority","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The executor determines how priority information affects the way tasks are scheduled."},{"type":"text","text":" "},{"type":"text","text":"The behavior varies depending on the executor currently being used."},{"type":"text","text":" "},{"type":"text","text":"Typically, executors attempt to run tasks with a higher priority"},{"type":"text","text":" "},{"type":"text","text":"before tasks with a lower priority."},{"type":"text","text":" "},{"type":"text","text":"However, the semantics of how priority is treated are left up to each"},{"type":"text","text":" "},{"type":"text","text":"platform and "},{"type":"codeVoice","code":"Executor"},{"type":"text","text":" implementation."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Child tasks automatically inherit their parent task’s priority."},{"text":" ","type":"text"},{"type":"text","text":"Detached tasks created by "},{"code":"detach(priority:operation:)","type":"codeVoice"},{"type":"text","text":" don’t inherit task priority"},{"text":" ","type":"text"},{"type":"text","text":"because they aren’t attached to the current task."}]},{"inlineContent":[{"text":"In some situations the priority of a task is elevated —","type":"text"},{"text":" ","type":"text"},{"text":"that is, the task is treated as it if had a higher priority,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"without actually changing the priority of the task:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If a task runs on behalf of an actor,"},{"type":"text","text":" "},{"type":"text","text":"and a new higher-priority task is enqueued to the actor,"},{"type":"text","text":" "},{"text":"then the actor’s current task is temporarily elevated","type":"text"},{"text":" ","type":"text"},{"text":"to the priority of the enqueued task.","type":"text"},{"text":" ","type":"text"},{"text":"This priority elevation allows the new task","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to be processed at the priority it was enqueued with."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If a higher-priority task accesses the "},{"type":"codeVoice","code":"value"},{"type":"text","text":" property,"},{"type":"text","text":" "},{"text":"then the priority of this task increases until the task completes.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"In both cases, priority elevation helps you prevent a low-priority task","type":"text"},{"type":"text","text":" "},{"text":"from blocking the execution of a high priority task,","type":"text"},{"type":"text","text":" "},{"text":"which is also known as ","type":"text"},{"inlineContent":[{"text":"priority inversion","type":"text"}],"type":"emphasis"},{"type":"text","text":"."}]}],"kind":"c