S"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TaskPriority"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The executor determines how priority information affects the way tasks are scheduled."},{"type":"text","text":" "},{"type":"text","text":"The behavior varies depending on the executor currently being used."},{"type":"text","text":" "},{"type":"text","text":"Typically, executors attempt to run tasks with a higher priority"},{"text":" ","type":"text"},{"text":"before tasks with a lower priority.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"However, the semantics of how priority is treated are left up to each"},{"text":" ","type":"text"},{"text":"platform and ","type":"text"},{"code":"Executor","type":"codeVoice"},{"text":" implementation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Child tasks automatically inherit their parent task’s priority.","type":"text"},{"text":" ","type":"text"},{"text":"Detached tasks created by ","type":"text"},{"code":"detach(priority:operation:)","type":"codeVoice"},{"text":" don’t inherit task priority","type":"text"},{"text":" ","type":"text"},{"text":"because they aren’t attached to the current task.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In some situations the priority of a task is elevated —","type":"text"},{"text":" ","type":"text"},{"text":"that is, the task is treated as it if had a higher priority,","type":"text"},{"text":" ","type":"text"},{"text":"without actually changing the priority of the task:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If a task runs on behalf of an actor,"},{"text":" ","type":"text"},{"text":"and a new higher-priority task is enqueued to the actor,","type":"text"},{"text":" ","type":"text"},{"text":"then the actor’s current task is temporarily elevated","type":"text"},{"type":"text","text":" "},{"text":"to the priority of the enqueued task.","type":"text"},{"text":" ","type":"text"},{"text":"This priority elevation allows the new task","type":"text"},{"text":" ","type":"text"},{"text":"to be processed at the priority it was enqueued with.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If a higher-priority task accesses the ","type":"text"},{"code":"value","type":"codeVoice"},{"text":" property,","type":"text"},{"text":" ","type":"text"},{"text":"then the priority of this task increases until the task completes.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"In both cases, priority elevation helps you prevent a low-priority task","type":"text"},{"type":"text","text":" "},{"type":"text","text":"from blocking the execution of a high priority task,"},{"type":"text","text":" "},{"type":"text","text":"which is also known as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"priority inversion"}]},{"type":"text","text":"."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"The priority of a task."}],"metadata":{"title":"TaskPriority","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TaskPriority","kind":"identifier"}],"symbolKind":"struct","roleHeading":"Structure","navigatorTitle":[{"text":"TaskPriority","kind":"identifier"}],"modules":[{"name":"Swift","relatedModules":[]}],"externalID":"s:ScP","platforms":[{"deprecated":false,"unavailable":false,"beta":false,"name":"iOS","introducedAt":"8.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"iPadOS","introducedAt":"8.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"Mac Catalyst","introducedAt":"13.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"macOS","introducedAt":"10.10"},{"deprecated":false,"unavailable":false,"b