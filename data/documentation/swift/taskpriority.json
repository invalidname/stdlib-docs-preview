{"seeAlsoSections":[{"title":"Tasks","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"],"generated":true,"anchor":"Tasks"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TaskPriority"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The executor determines how priority information affects the way tasks are scheduled."},{"type":"text","text":" "},{"type":"text","text":"The behavior varies depending on the executor currently being used."},{"type":"text","text":" "},{"type":"text","text":"Typically, executors attempt to run tasks with a higher priority"},{"type":"text","text":" "},{"type":"text","text":"before tasks with a lower priority."},{"type":"text","text":" "},{"type":"text","text":"However, the semantics of how priority is treated are left up to each"},{"type":"text","text":" "},{"type":"text","text":"platform and "},{"type":"codeVoice","code":"Executor"},{"type":"text","text":" implementation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Child tasks automatically inherit their parent task’s priority."},{"type":"text","text":" "},{"type":"text","text":"Detached tasks created by "},{"type":"codeVoice","code":"detach(priority:operation:)"},{"type":"text","text":" don’t inherit task priority"},{"type":"text","text":" "},{"type":"text","text":"because they aren’t attached to the current task."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In some situations the priority of a task is elevated —"},{"type":"text","text":" "},{"type":"text","text":"that is, the task is treated as it if had a higher priority,"},{"type":"text","text":" "},{"type":"text","text":"without actually changing the priority of the task:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If a task runs on behalf of an actor,"},{"type":"text","text":" "},{"type":"text","text":"and a new higher-priority task is enqueued to the actor,"},{"type":"text","text":" "},{"type":"text","text":"then the actor’s current task is temporarily elevated"},{"type":"text","text":" "},{"type":"text","text":"to the priority of the enqueued task."},{"type":"text","text":" "},{"type":"text","text":"This priority elevation allows the new task"},{"type":"text","text":" "},{"type":"text","text":"to be processed at the priority it was enqueued with."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If a higher-priority task accesses the "},{"type":"codeVoice","code":"value"},{"type":"text","text":" property,"},{"type":"text","text":" "},{"type":"text","text":"then the priority of this task increases until the task completes."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In both cases, priority elevation helps you prevent a low-priority task"},{"type":"text","text":" "},{"type":"text","text":"from blocking the execution of a high priority task,"},{"type":"text","text":" "},{"type":"text","text":"which is also known as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"priority inversion"}]},{"type":"text","text":"."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/taskpriority"]}],"topicSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/!=(_:_:)"],"generated":true,"title":"Operators","anchor":"Operators"},{"title":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/init(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/init(rawValue:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/rawValue-swift.property"],"generated":true,"anchor":"Instance-Properties"},{"title":"Type Aliases","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/RawValue-swift.typealias"],"generated":true,"anchor":"Type-Aliases"},{"title":"Type Properties","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/background","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/default","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/high","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/low","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/medium","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/unspecified","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/userInitiated","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/userInteractive","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/utility"],"generated":true,"anchor":"Type-Properties"},{"title":"Default Implementations","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/Comparable-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/CustomStringConvertible-Implementations","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskP