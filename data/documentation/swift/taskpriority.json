lse,"introducedAt":"2.0","unavailable":false,"beta":false}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TaskPriority","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The executor determines how priority information affects the way tasks are scheduled."},{"type":"text","text":" "},{"type":"text","text":"The behavior varies depending on the executor currently being used."},{"type":"text","text":" "},{"type":"text","text":"Typically, executors attempt to run tasks with a higher priority"},{"type":"text","text":" "},{"type":"text","text":"before tasks with a lower priority."},{"type":"text","text":" "},{"type":"text","text":"However, the semantics of how priority is treated are left up to each"},{"type":"text","text":" "},{"type":"text","text":"platform and "},{"type":"codeVoice","code":"Executor"},{"type":"text","text":" implementation."}]},{"type":"paragraph","inlineContent":[{"text":"Child tasks automatically inherit their parent task’s priority.","type":"text"},{"text":" ","type":"text"},{"text":"Detached tasks created by ","type":"text"},{"type":"codeVoice","code":"detach(priority:operation:)"},{"text":" don’t inherit task priority","type":"text"},{"text":" ","type":"text"},{"text":"because they aren’t attached to the current task.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In some situations the priority of a task is elevated —","type":"text"},{"text":" ","type":"text"},{"text":"that is, the task is treated as it if had a higher priority,","type":"text"},{"text":" ","type":"text"},{"text":"without actually changing the priority of the task:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If a task runs on behalf of an actor,"},{"text":" ","type":"text"},{"type":"text","text":"and a new higher-priority task is enqueued to the actor,"},{"text":" ","type":"text"},{"text":"then the actor’s current task is temporarily elevated","type":"text"},{"text":" ","type":"text"},{"text":"to the priority of the enqueued task.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"This priority elevation allows the new task"},{"text":" ","type":"text"},{"type":"text","text":"to be processed at the priority it was enqueued with."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If a higher-priority task calls the "},{"code":"get()","type":"codeVoice"},{"type":"text","text":" method,"},{"type":"text","text":" "},{"type":"text","text":"then the priority of this task increases until the task completes."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"In both cases, priority elevation helps you prevent a low-priority task","type":"text"},{"text":" ","type":"text"},{"text":"from blocking the execution of a high priority task,","type":"text"},{"text":" ","type":"text"},{"text":"which is also known as ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"priority inversion","type":"text"}]},{"text":".","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/!=(_:_:)"],"title":"Operators","anchor":"Operators"},{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/init(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/init(rawValue:)"],"generated":true},{"generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority\/rawValue-swift.property"],"title":"Instance Properties","anchor":"Instance-Properties"},{