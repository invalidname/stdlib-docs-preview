isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"],"generated":true,"anchor":"Tasks","title":"Tasks"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TaskPriority","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"The executor determines how priority information affects the way tasks are scheduled.","type":"text"},{"text":" ","type":"text"},{"text":"The behavior varies depending on the executor currently being used.","type":"text"},{"text":" ","type":"text"},{"text":"Typically, executors attempt to run tasks with a higher priority","type":"text"},{"text":" ","type":"text"},{"text":"before tasks with a lower priority.","type":"text"},{"text":" ","type":"text"},{"text":"However, the semantics of how priority is treated are left up to each","type":"text"},{"text":" ","type":"text"},{"text":"platform and ","type":"text"},{"code":"Executor","type":"codeVoice"},{"text":" implementation.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Child tasks automatically inherit their parent task’s priority.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Detached tasks created by "},{"type":"codeVoice","code":"detach(priority:operation:)"},{"type":"text","text":" don’t inherit task priority"},{"type":"text","text":" "},{"type":"text","text":"because they aren’t attached to the current task."}]},{"inlineContent":[{"type":"text","text":"In some situations the priority of a task is elevated —"},{"type":"text","text":" "},{"type":"text","text":"that is, the task is treated as it if had a higher priority,"},{"type":"text","text":" "},{"type":"text","text":"without actually changing the priority of the task:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"If a task runs on behalf of an actor,","type":"text"},{"text":" ","type":"text"},{"text":"and a new higher-priority task is enqueued to the actor,","type":"text"},{"text":" ","type":"text"},{"text":"then the actor’s current task is temporarily elevated","type":"text"},{"text":" ","type":"text"},{"text":"to the priority of the enqueued task.","type":"text"},{"text":" ","type":"text"},{"text":"This priority elevation allows the new task","type":"text"},{"text":" ","type":"text"},{"text":"to be processed at the priority it was enqueued with.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If a higher-priority task accesses the ","type":"text"},{"type":"codeVoice","code":"value"},{"type":"text","text":" property,"},{"type":"text","text":" "},{"type":"text","text":"then the priority of this task increases until the task completes."}]}]}]},{"inlineContent":[{"type":"text","text":"In both cases, priority elevation helps you prevent a low-priority task"},{"type":"text","text":" "},{"type":"text","text":"from blocking the execution of a high priority task,"},{"type":"text","text":" "},{"type":"text","text":"which is also known as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"priority inversion"}]},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"The priority of a task."}],"references":{"doc://com.apple.Swift/documentation/Swift/withDiscardingTaskGroup(returning:isolation:body:)":{"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swift\/withdiscardingtaskgroup(returning:isolation:body:)","title":"withDiscardingTaskGroup(returning:isolation:body:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withDiscardingTaskGroup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"GroupResult","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"returning","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency23withDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdE0VzYaXEtYalF0E6ResultL_xmfp","kind":"typeIdentifier","text":"GroupResult"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"isolation"},{"kind":"text","text":": "},{"text":"isolated","kind":"keyword"},{"text":" (","kind":"text"},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ScA","text":"Actor","kind":"typeIdentifier"},{"text":")?, ","kind":"text"},{"text":"body","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency19DiscardingTaskGroupV","text":"DiscardingTaskGroup","kind":"typeIdentifier"},{"kind":"text","text":") "},{"text":"async","kind":"keyword"},{"kind":"text","text":" -> "},{"text":"GroupResult","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency23withDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdE0VzYaXEtYalF0E6ResultL_xmfp"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"kind":"text","text":" -> "},{"text":"GroupResult","preci