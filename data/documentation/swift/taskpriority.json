{"metadata":{"platforms":[{"deprecated":false,"introducedAt":"8.0","name":"iOS","beta":false,"unavailable":false},{"name":"iPadOS","introducedAt":"8.0","unavailable":false,"beta":false,"deprecated":false},{"deprecated":false,"introducedAt":"13.0","name":"Mac Catalyst","beta":false,"unavailable":false},{"name":"macOS","introducedAt":"10.10","unavailable":false,"beta":false,"deprecated":false},{"name":"tvOS","introducedAt":"9.0","unavailable":false,"beta":false,"deprecated":false},{"deprecated":false,"introducedAt":"1.0","name":"visionOS","beta":false,"unavailable":false},{"name":"watchOS","introducedAt":"2.0","unavailable":false,"beta":false,"deprecated":false}],"navigatorTitle":[{"text":"TaskPriority","kind":"identifier"}],"title":"TaskPriority","externalID":"s:ScP","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TaskPriority","kind":"identifier"}],"symbolKind":"struct","modules":[{"name":"Swift","relatedModules":[]}],"role":"symbol","roleHeading":"Structure"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"kind":"symbol","abstract":[{"type":"text","text":"The priority of a task."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TaskPriority"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The executor determines how priority information affects the way tasks are scheduled.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The behavior varies depending on the executor currently being used."},{"type":"text","text":" "},{"type":"text","text":"Typically, executors attempt to run tasks with a higher priority"},{"type":"text","text":" "},{"type":"text","text":"before tasks with a lower priority."},{"type":"text","text":" "},{"type":"text","text":"However, the semantics of how priority is treated are left up to each"},{"type":"text","text":" "},{"type":"text","text":"platform and "},{"code":"Executor","type":"codeVoice"},{"type":"text","text":" implementation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Child tasks automatically inherit their parent task’s priority."},{"text":" ","type":"text"},{"text":"Detached tasks created by ","type":"text"},{"type":"codeVoice","code":"detach(priority:operation:)"},{"text":" don’t inherit task priority","type":"text"},{"text":" ","type":"text"},{"text":"because they aren’t attached to the current task.","type":"text"}]},{"inlineContent":[{"text":"In some situations the priority of a task is elevated —","type":"text"},{"type":"text","text":" "},{"type":"text","text":"that is, the task is treated as it if had a higher priority,"},{"type":"text","text":" "},{"type":"text","text":"without actually changing the priority of the task:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"If a task runs on behalf of an actor,","type":"text"},{"text":" ","type":"text"},{"text":"and a new higher-priority task is enqueued to the actor,","type":"text"},{"text":" ","type":"text"},{"text":"then the actor’s current task is temporarily elevated","type":"text"},{"text":" ","type":"text"},{"text":"to the priority of the enqueued task.","type":"text"},{"text":" ","type":"text"},{"text":"This priority elevation allows the new task","type":"text"},{"text":" ","type":"text"},{"text":"to be processed at the priority it was enqueued with.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If a higher-priority task calls the ","type":"text"},{"type":"codeVoice","code":"get()"},{"type":"text","text":" method,"},{"text":" ","type":"text"},{"type":"text","text":"then the priority of this task increases until the task completes."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"In both cases, priority elevation helps you prevent a low-priority task"},{"type":"text","text":" "},{"type":"text","text":"from blocking the execution of a high priority task,"},{"type":"text","text":" "},{"type":"text","text":"which is also known as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"priority inversion"}]},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/taskpriority"]}],"seeAlsoSections":[{"title":"Tasks","anchor":"Tasks","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Comparable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Decodable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Encodable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Escapable","doc:\/\/com.apple.Swift\/documentation\/Swift\/RawRepresentable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendab