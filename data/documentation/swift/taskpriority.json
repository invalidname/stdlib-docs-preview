{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/taskpriority"]}],"abstract":[{"text":"The priority of a task.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority","interfaceLanguage":"swift"},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Comparable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Decodable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Encodable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Equatable","doc:\/\/com.apple.Swift\/documentation\/Swift\/RawRepresentable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"title":"Conforms To","type":"conformsTo"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"],"title":"Tasks","anchor":"Tasks"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TaskPriority"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"text":"The executor determines how priority information affects the way tasks are scheduled.","type":"text"},{"text":" ","type":"text"},{"text":"The behavior varies depending on the executor currently being used.","type":"text"},{"text":" ","type":"text"},{"text":"Typically, executors attempt to run tasks with a higher priority","type":"text"},{"text":" ","type":"text"},{"text":"before tasks with a lower priority.","type":"text"},{"text":" ","type":"text"},{"text":"However, the semantics of how priority is treated are left up to each","type":"text"},{"text":" ","type":"text"},{"text":"platform and ","type":"text"},{"type":"codeVoice","code":"Executor"},{"text":" implementation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Child tasks automatically inherit their parent task’s priority.","type":"text"},{"text":" ","type":"text"},{"text":"Detached tasks created by ","type":"text"},{"type":"codeVoice","code":"detach(priority:operation:)"},{"text":" don’t inherit task priority","type":"text"},{"text":" ","type":"text"},{"text":"because they aren’t attached to the current task.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In some situations the priority of a task is elevated —","type":"text"},{"text":" ","type":"text"},{"text":"that is, the task is treated as it if had a higher priority,","type":"text"},{"text":" ","type":"text"},{"text":"without actually changing the priority of the task:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"If a task runs on behalf of an actor,","type":"text"},{"text":" ","type":"text"},{"text":"and a new higher-priority task is enqueued to the actor,","type":"text"},{"text":" ","type":"text"},{"text":"then the actor’s current task is temporarily elevated","type":"text"},{"text":" ","type":"text"},{"text":"to the priority of the enqueued task.","type":"text"},{"text":" ","type":"text"},{"text":"This priority elevation allows the new task","type":"text"},{"text":" ","type":"text"},{"text":"to be processed at the priority it was enqueued with.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If a higher-priority task accesses the ","type":"text"},{"type":"codeVoice","code":"value"},{"text":" property,","type":"text"},{"text":" ","type":"text"},{"text":"then the priority of this task increases until the task completes.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"In both cases, priority elevation helps you prevent a low-priority task","type":"text"},{"text":" ","type":"text"},{"text":"from blocking the execution of a high priority task,","type":"text"},{"text":" ","type":"text"},{"text":"which is also known as ","type":"text"},{"inlineContent":[{"text":"priority inversion","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"}]}],"metadata":{"symbolKind":"struct","platforms":[{"introducedAt":"8.0","beta":false,"unavailable":false,"name":"iOS","deprecated":false},{"introducedAt":"8.0","beta":false,"unavailable":false,"name":"iPadOS","deprecated":false},{"introducedAt":"13.0","beta":false,"unavailable":false,"name":"Mac Catalyst","deprecated":false},{"introducedAt":"10.10","beta":false,"unavailable":false,"name":"macOS","deprecated":false},{"introducedAt":"9.0","beta":false,"unavailable":false,"name":"tvOS","deprecated":false},{"introducedAt":"1.0","beta":false,"unavailable":false,"name":"visionOS","deprecated":false},{"introducedAt":"2.0","beta":false,"unavailable":false,"name":"watchOS","deprecated":false}],"externalID":"s:ScP","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TaskPriority"}],"navigatorTitle":[{"k