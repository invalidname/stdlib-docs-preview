:" "},{"text":"TextOutputStream","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"You can send the output of the standard library’s ","type":"text"},{"code":"print(_:to:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"dump(_:to:)"},{"type":"text","text":" functions to an instance of a type that conforms to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"TextOutputStream"},{"type":"text","text":" protocol instead of to standard output. Swift’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"String"},{"type":"text","text":" type conforms to "},{"type":"codeVoice","code":"TextOutputStream"},{"type":"text","text":" already, so you can capture"},{"type":"text","text":" "},{"type":"text","text":"the output from "},{"type":"codeVoice","code":"print(_:to:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"dump(_:to:)"},{"type":"text","text":" in a string instead of"},{"type":"text","text":" "},{"type":"text","text":"logging it to standard output."}]},{"syntax":"swift","type":"codeListing","code":["var s = \"\"","for n in 1...5 {","    print(n, terminator: \"\", to: &s)","}","\/\/ s == \"12345\""]},{"anchor":"Conforming-to-the-TextOutputStream-Protocol","type":"heading","level":1,"text":"Conforming to the TextOutputStream Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To make your custom type conform to the "},{"type":"codeVoice","code":"TextOutputStream"},{"type":"text","text":" protocol,"},{"type":"text","text":" "},{"type":"text","text":"implement the required "},{"type":"codeVoice","code":"write(_:)"},{"type":"text","text":" method. Functions that use a"},{"type":"text","text":" "},{"type":"codeVoice","code":"TextOutputStream"},{"type":"text","text":" target may call "},{"type":"codeVoice","code":"write(_:)"},{"type":"text","text":" multiple times per writing"},{"type":"text","text":" "},{"type":"text","text":"operation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As an example, here’s an implementation of an output stream that converts"},{"type":"text","text":" "},{"type":"text","text":"any input to its plain ASCII representation before sending it to standard"},{"type":"text","text":" "},{"type":"text","text":"output."}]},{"syntax":"swift","type":"codeListing","code":["struct ASCIILogger: TextOutputStream {","    mutating func write(_ string: String) {","        let ascii = string.unicodeScalars.lazy.map { scalar in","            scalar == \"\\n\"","              ? \"\\n\"","              : scalar.escaped(asASCII: true)","        }","        print(ascii.joined(separator: \"\"), terminator: \"\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ASCIILogger"},{"type":"text","text":" type’s "},{"type":"codeVoice","code":"write(_:)"},{"type":"text","text":" method processes its string input by"},{"type":"text","text":" "},{"type":"text","text":"escaping each Unicode scalar, with the exception of "},{"type":"codeVoice","code":"\"\\n\""},{"type":"text","text":" line returns."},{"type":"text","text":" "},{"type":"text","text":"By sending the output of the "},{"type":"codeVoice","code":"print(_:to:)"},{"type":"text","text":" function to an instance of"},{"type":"text","text":" "},{"type":"codeVoice","code":"ASCIILogger"},{"type":"text","text":", you invoke its "},{"type":"codeVoice","code":"write(_:)"},{"type":"text","text":" method."}]},{"syntax":"swift","type":"codeListing","code":["let s = \"Hearts ♡ and Diamonds ♢\"","print(s)","\/\/ Prints \"Hearts ♡ and Diamonds ♢\"","","var asciiLogger = ASCIILogger()","print(s, to: &asciiLogger)","\/\/ Prints \"Hearts \\u{2661} and Diamonds \\u{2662}\""]}]}],"relationshipsSections":[{"title":"Inherited By","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift