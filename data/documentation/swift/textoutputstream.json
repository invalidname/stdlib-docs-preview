{"metadata":{"externalID":"s:s16TextOutputStreamP","navigatorTitle":[{"text":"TextOutputStream","kind":"identifier"}],"title":"TextOutputStream","role":"symbol","roleHeading":"Protocol","modules":[{"name":"Swift"}],"platforms":[{"introducedAt":"8.0","unavailable":false,"name":"iOS","deprecated":false,"beta":false},{"introducedAt":"8.0","unavailable":false,"name":"iPadOS","deprecated":false,"beta":false},{"introducedAt":"13.0","unavailable":false,"name":"Mac Catalyst","deprecated":false,"beta":false},{"introducedAt":"10.10","unavailable":false,"name":"macOS","deprecated":false,"beta":false},{"introducedAt":"9.0","unavailable":false,"name":"tvOS","deprecated":false,"beta":false},{"introducedAt":"1.0","unavailable":false,"name":"visionOS","deprecated":false,"beta":false},{"introducedAt":"2.0","unavailable":false,"name":"watchOS","deprecated":false,"beta":false}],"symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextOutputStream","kind":"identifier"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"title":"Streams","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TextOutputStreamable"],"generated":true,"anchor":"Streams"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TextOutputStream","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextOutputStream","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"You can send the output of the standard library’s ","type":"text"},{"type":"codeVoice","code":"print(_:to:)"},{"text":" and","type":"text"},{"type":"text","text":" "},{"code":"dump(_:to:)","type":"codeVoice"},{"type":"text","text":" functions to an instance of a type that conforms to the"},{"type":"text","text":" "},{"code":"TextOutputStream","type":"codeVoice"},{"type":"text","text":" protocol instead of to standard output. Swift’s"},{"type":"text","text":" "},{"code":"String","type":"codeVoice"},{"type":"text","text":" type conforms to "},{"code":"TextOutputStream","type":"codeVoice"},{"type":"text","text":" already, so you can capture"},{"type":"text","text":" "},{"type":"text","text":"the output from "},{"code":"print(_:to:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"dump(_:to:)","type":"codeVoice"},{"type":"text","text":" in a string instead of"},{"type":"text","text":" "},{"type":"text","text":"logging it to standard output."}]},{"syntax":"swift","type":"codeListing","code":["var s = \"\"","for n in 1...5 {","    print(n, terminator: \"\", to: &s)","}","\/\/ s == \"12345\""]},{"anchor":"Conforming-to-the-TextOutputStream-Protocol","type":"heading","text":"Conforming to the TextOutputStream Protocol","level":1},{"type":"paragraph","inlineContent":[{"text":"To make your custom type conform to the ","type":"text"},{"code":"TextOutputStream","type":"codeVoice"},{"text":" protocol,","type":"text"},{"text":" ","type":"text"},{"text":"implement the required ","type":"text"},{"code":"write(_:)","type":"codeVoice"},{"text":" method. Functions that use a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"TextOutputStream"},{"type":"text","text":" target may call "},{"type":"codeVoice","code":"write(_:)"},{"type":"text","text":" multiple times per writing"},{"type":"text","text":" "},{"type":"text","text":"operation."}]},{"type":"paragraph","inlineContent":[{"text":"As an example, here’s an implementation of an output stream that converts","type":"text"},{"text":" ","type":"text"},{"text":"any input to its plain ASCII representation before sending it to standard","type":"text"},{"text":" ","type":"text"},{"text":"output.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ASCIILogger: TextOutputStream {","    mutating func write(_ string: String) {","        let ascii = string.unicodeScalars.lazy.map { scalar in","            scalar == \"\\n\"","              ? \"\\n\"","              : scalar.escaped(asASCII: true)","        }","        print(ascii.joined(separator: \"\"), terminator: \"\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"ASCIILogger","type":"codeVoice"},{"type":"text","text":" type’s "},{"code":"write(_:)","type":"codeVoice"},{"type":"text","text":" method processes its string input by"},{"type":"text","text":" "},{"type":"text","text":"escaping each Unicode scalar, with the exception of "},{"code":"\"\\n\"","type":"codeVoice"},{"type":"text","text":" line returns."},{"type":"text","text":" "},{"type":"text","text":"By sending the output of the "},{"code":"print(_:to:)","type":"codeVoice"},{"type":"text","text":" function to an instance of"},{"type":"text","text":" "},{"code":"ASCIILogger","type":"codeVoice"},{"type":"text","text":", you invoke its "},{"code":"write(_:)","type":"codeVoice"},{"type":"text","text":" method."}]},{"type":"codeListing","syntax":"swift","code":["let s = \"Hearts ♡ and Diamonds ♢\"","print(s)","\/\/ Prints \"Hearts ♡ and Diamonds ♢\"","","var asciiLogger = ASCIILogger()","print(s, to: &asciiLogger)","\/\/ Prints \"Hearts \\u{2661} and Diamonds \\u{2662}\""]}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"A type that can be the target of text-streaming operations."}],"topicSections":[{"title":"Instance Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/TextOutputStream\/write(_:)"],"generated":true,"anchor":"Instance-Methods"}],"variants":[{"paths":["\/documentation\/swift\/textoutputstream"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"title":"Inherited By","type":"inheritedBy","identifiers":["doc:\/\/com.apple.Swift\