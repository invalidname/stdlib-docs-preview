eration:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addImmediateTaskUnlessCancelled(name:priority:executorPreference:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTask(executorPreference:priority:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTask(name:executorPreference:priority:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTask(name:priority:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTask(priority:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTaskUnlessCancelled(executorPreference:priority:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTaskUnlessCancelled(name:executorPreference:priority:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTaskUnlessCancelled(name:priority:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTaskUnlessCancelled(priority:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/cancelAll()"],"generated":true,"title":"Instance Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ThrowingDiscardingTaskGroup"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP","text":"Error"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"To create a discarding task group,","type":"text"},{"text":" ","type":"text"},{"text":"call the ","type":"text"},{"code":"withDiscardingTaskGroup(returning:body:)","type":"codeVoice"},{"text":" method.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Don’t use a task group from outside the task where you created it.","type":"text"},{"text":" ","type":"text"},{"text":"In most cases,","type":"text"},{"text":" ","type":"text"},{"text":"the Swift type system prevents a task group from escaping like that","type":"text"},{"text":" ","type":"text"},{"text":"because adding a child task to a task group is a mutating operation,","type":"text"},{"text":" ","type":"text"},{"text":"and mutation operations can’t be performed","type":"text"},{"text":" ","type":"text"},{"text":"from a concurrent execution context like a child task.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Refer to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference"},{"text":" documentation for detailed discussion of semantics shared between all task groups.","type":"text"}]},{"type":"heading","text":"Discarding behavior","level":3,"anchor":"Discarding-behavior"},{"type":"paragraph","inlineContent":[{"text":"A discarding task group eagerly discards and releases its child tasks as","type":"text"},{"text":" ","type":"text"},{"text":"soon as they complete. This allows for the efficient releasing of memory used","type":"text"},{"text":" ","type":"text"},{"text":"by those tasks, which are not retained for future ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" calls, as would","type":"text"},{"text":" ","type":"text"},{"text":"be the case with a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference"},{"text":".","type":"text"}]},{"type":"heading","text":"Cancellation behavior","level":3,"anchor":"Cancellation-behavior"},{"type":"paragraph","inlineContent":[{"text":"A throwing discarding task group becomes canceled in one of the following ways:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"when ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/cancelAll()"},{"text":" is invoked on it,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"when an error is thrown out of the ","type":"text"},{"code":"withThrowingDiscardingTaskGroup { ... }","type":"codeVoice"},{"text":" closure,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"when the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task"},{"text":" running this task group is canceled.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"But also, and uniquely in ","type":"text"},{"inlineContent":[{"type":"text","text":"discarding"}],"type":"emphasis"},{"text":" task groups:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"when ","type":"text"},{"inlineContent":[{"text":"any","type":"text"}],"type":"emphasis"},{"text":" of its child tasks throws.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The group becoming canceled automatically, and cancelling all of its child tasks,","type":"text"},{"text":" ","type":"text"},{"text":"whenever ","type":"text"},{"inlineContent":[{"type":"text","text":"any"}],"type":"emphasis"},{"text":" child task throws an error is a behavior unique to discarding task groups,","type":"text"},{"text":" ","type":"text"},{"text":"because achieving such semantics is not possible otherwise, due to the missing ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"on discarding groups. Accumulating task groups can implement this by manually polling ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and deciding to ","type":"text"},{"code":"cancelAll()","type":"codeVoice"},{"text":" when they decide an error should cause the group to become canceled,","type":"text"},{"text":" ","type":"text"},{"text":"however a discarding group cannot poll child tasks for results and therefore assumes that child","type":"text"},{"text":" ","type":"text"},{"text":"task throws are an indication of a group wide failure. In order to avoid such behavior,","type":"text"},{"text":" ","type":"text"},{"text":"use a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","type":"reference"},{"text":" instead of a throwing one, or catch specific errors in","type":"text"},{"text":" ","type":"text"},{"text":"operations submitted using ","type":"text"},{"code":"addTask","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Since a ","type":"text"},{"code":"ThrowingDiscardingTaskGroup","type":"codeVoice"},{"text":" is a structured concurrency primitive, cancellation is","type":"text"},{"text":" ","type":"text"},{"text":"automatically propagated through all of its child-tasks (and their child","type":"text"},{"text":" ","type":"text"},{"text":"tasks).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A canceled task group can still keep adding tasks, however they will start","type":"text"},{"text":" ","type":"text"},{"text":"being immediately canceled, and may act accordingly to this. To avoid adding","type":"text"},{"text":" ","type":"text"},{"text":"new tasks to an already canceled task group, use ","type":"text"},{"code":"addTaskUnlessCancelled(priority:body:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"rather than the plain ","type":"text"},{"code":"addTask(priority:body:)","type":"codeVoice"},{"text":" which adds tasks unconditionally.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For information about the language-level concurrency model that ","type":"text"},{"code":"DiscardingTaskGroup","type":"codeVoice"},{"text":" is part of,","type":"text"},{"text":" ","type":"text"},{"text":"see ","type":"text"},{"isActive":true,"identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html","type":"reference"},{"text":" in ","type":"text"},{"isActive":true,"identifier":"https:\/\/docs.swift.org\/swift-book\/","type":"reference"},{"text":".","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup"}],"type":"paragraph"}],"type":"aside","name":"See Also","style":"note"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup"}],"type":"paragraph"}],"type":"aside","name":"See Also","style":"note"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup"}],"type":"paragraph"}],"type":"aside","name":"See Also","style":"note"}]}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ThrowingDiscardingTaskGroup","kind":"identifier"}],"navigatorTitle":[{"text":"ThrowingDiscardingTaskGroup","kind":"identifier"}],"platforms":[{"introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false,"name":"iOS"},{"deprecated":false,"unavailable":false,"name":"iPadOS","introducedAt":"8.0","beta":false},{"deprecated":false,"unavailable":false,"name":"Mac Catalyst","introducedAt":"13.0","beta":false},{"introducedAt":"10.10","deprecated":