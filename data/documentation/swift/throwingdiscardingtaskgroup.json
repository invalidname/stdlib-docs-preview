{"metadata":{"modules":[{"relatedModules":[],"name":"Swift"}],"externalID":"s:12_Concurrency27ThrowingDiscardingTaskGroupV","title":"ThrowingDiscardingTaskGroup","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ThrowingDiscardingTaskGroup"}],"platforms":[{"beta":false,"deprecated":false,"unavailable":false,"name":"iOS","introducedAt":"8.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"iPadOS","introducedAt":"8.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"Mac Catalyst","introducedAt":"13.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"macOS","introducedAt":"10.10"},{"beta":false,"deprecated":false,"unavailable":false,"name":"tvOS","introducedAt":"9.0"},{"unavailable":false,"name":"visionOS","deprecated":false,"introducedAt":"1.0","beta":false},{"unavailable":false,"name":"watchOS","deprecated":false,"introducedAt":"2.0","beta":false}],"navigatorTitle":[{"kind":"identifier","text":"ThrowingDiscardingTaskGroup"}],"symbolKind":"struct","role":"symbol","roleHeading":"Structure"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority","doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"],"generated":true,"title":"Tasks","anchor":"Tasks"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ThrowingDiscardingTaskGroup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"To create a discarding task group,","type":"text"},{"text":" ","type":"text"},{"text":"call the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)","type":"reference"},{"text":" method.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Don’t use a task group from outside the task where you created it.","type":"text"},{"text":" ","type":"text"},{"text":"In most cases,","type":"text"},{"text":" ","type":"text"},{"text":"the Swift type system prevents a task group from escaping like that","type":"text"},{"text":" ","type":"text"},{"text":"because adding a child task to a task group is a mutating operation,","type":"text"},{"text":" ","type":"text"},{"text":"and mutation operations can’t be performed","type":"text"},{"text":" ","type":"text"},{"text":"from a concurrent execution context like a child task.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Refer to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference"},{"text":" documentation for detailed discussion of semantics shared between all task groups.","type":"text"}]},{"type":"heading","text":"Discarding behavior","anchor":"Discarding-behavior","level":3},{"type":"paragraph","inlineContent":[{"text":"A discarding task group eagerly discards and releases its child tasks as","type":"text"},{"text":" ","type":"text"},{"text":"soon as they complete. This allows for the efficient releasing of memory used","type":"text"},{"text":" ","type":"text"},{"text":"by those tasks, which are not retained for future ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" calls, as would","type":"text"},{"text":" ","type":"text"},{"text":"be the case with a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference"},{"text":".","type":"text"}]},{"type":"heading","text":"Cancellation behavior","anchor":"Cancellation-behavior","level":3},{"type":"paragraph","inlineContent":[{"text":"A throwing discarding task group becomes canceled in one of the following ways:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"when ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/cancelAll()","isActive":true,"type":"reference"},{"text":" is invoked on it,","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"when an error is thrown out of the "},{"type":"codeVoice","code":"withThrowingDiscardingTaskGroup { ... }"},{"type":"text","text":" closure,"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"when the ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","isActive":true},{"text":" running this task group is canceled.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"But also, and uniquely in "},{"inlineContent":[{"text":"discarding","type":"text"}],"type":"emphasis"},{"text":" task groups:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"when ","type":"text"},{"inlineContent":[{"type":"text","text":"any"}],"type":"emphasis"},{"text":" of its child tasks throws.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The group becoming canceled automatically, and cancelling all of its child tasks,","type":"text"},{"text":" ","type":"text"},{"text":"whenever ","type":"text"},{"inlineContent":[{"type":"text","text":"any"}],"type":"emphasis"},{"text":" child task throws an error is a behavior unique to discarding task groups,","type":"text"},{"text":" ","type":"text"},{"text":"because achieving such semantics is not possible otherwise, due to the missing ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"on discarding groups. Accumulating task groups can implement this by manually polling ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and deciding to ","type":"text"},{"code":"cancelAll()","type":"codeVoice"},{"text":" when they decide an error should cause the group to become canceled,","type":"text"},{"text":" ","type":"text"},{"text":"however a discarding group cannot poll child tasks for results and therefore assumes that child","type":"text"},{"text":" ","type":"text"},{"text":"task throws are an indication of a group wide failure. In order to avoid such behavior,","type":"text"},{"text":" ","type":"text"},{"text":"use a ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","isActive":true,"type":"reference"},{"text":" instead of a throwing one, or catch specific errors in","type":"text"},{"text":" ","type":"text"},{"text":"operations submitted using ","type":"text"},{"code":"addTask","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Since a ","type":"text"},{"code":"ThrowingDiscardingTaskGroup","type":"codeVoice"},{"text":" is a structured concurrency primitive, cancellation is","type":"text"},{"text":" ","type":"text"},{"text":"automatically propagated through all of its child-tasks (and their child","type":"text"},{"text":" ","type":"text"},{"text":"tasks).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A canceled task group can still keep adding tasks, however they will start","type":"text"},{"text":" ","type":"text"},{"text":"being immediately canceled, and may act accordingly to this. To avoid adding","type":"text"},{"text":" ","type":"text"},{"text":"new tasks to an already canceled task group, use ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTaskUnlessCancelled(priority:operation:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"rather than the plain ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTask(priority:operation:)","isActive":true,"type":"reference"},{"text":" which adds tasks unconditionally.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For information about the language-level concurrency model that ","type":"text"},{"code":"DiscardingTaskGroup","type":"codeVoice"},{"text":" is part of,","type":"text"},{"text":" ","type":"text"},{"text":"see ","type":"text"},{"identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html","isActive":true,"type":"reference"},{"text":" in ","type":"text"},{"identifier":"https:\/\/docs.swift.org\/swift-book\/","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"name":"See Also","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference","isActive":true}],"type":"paragraph"}],"type":"aside","style":"note"},{"name":"See Also","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","type":"reference","isActive":true}],"type":"paragraph"}],"type":"aside","style":"note"},{"name":"See Also","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","type":"reference","isActive":true}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/throwingdiscardingtaskgroup"]}],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BitwiseCopyable"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"abstract":[{"type":"text","text":"A throwing discarding group that contains dynamically created child tasks."}],"topicSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/isCancelled","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/isEmpty"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addImmediateTask(name:priority:executorPreference:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addImmediateTaskUnlessCancelled(name:priority:executorPreference:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTask(executorPreference:priority:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTask(name:executorPreference:priority:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTask(name:priority:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTask(prio