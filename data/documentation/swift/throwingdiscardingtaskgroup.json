t\/ThrowingDiscardingTaskGroup\/addTaskUnlessCancelled(priority:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/cancelAll()"],"anchor":"Instance-Methods"}],"metadata":{"platforms":[{"deprecated":false,"unavailable":false,"introducedAt":"8.0","beta":false,"name":"iOS"},{"deprecated":false,"unavailable":false,"introducedAt":"8.0","beta":false,"name":"iPadOS"},{"deprecated":false,"unavailable":false,"introducedAt":"13.0","beta":false,"name":"Mac Catalyst"},{"deprecated":false,"unavailable":false,"introducedAt":"10.10","beta":false,"name":"macOS"},{"deprecated":false,"unavailable":false,"introducedAt":"9.0","beta":false,"name":"tvOS"},{"deprecated":false,"unavailable":false,"introducedAt":"1.0","beta":false,"name":"visionOS"},{"deprecated":false,"unavailable":false,"introducedAt":"2.0","beta":false,"name":"watchOS"}],"modules":[{"name":"Swift","relatedModules":[]}],"externalID":"s:12_Concurrency27ThrowingDiscardingTaskGroupV","roleHeading":"Structure","symbolKind":"struct","role":"symbol","title":"ThrowingDiscardingTaskGroup","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ThrowingDiscardingTaskGroup","kind":"identifier"}],"navigatorTitle":[{"text":"ThrowingDiscardingTaskGroup","kind":"identifier"}]},"sections":[],"abstract":[{"type":"text","text":"A throwing discarding group that contains dynamically created child tasks."}],"seeAlsoSections":[{"title":"Tasks","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority","doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"],"anchor":"Tasks"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ThrowingDiscardingTaskGroup"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Error","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"To create a discarding task group,","type":"text"},{"text":" ","type":"text"},{"text":"call the ","type":"text"},{"code":"withDiscardingTaskGroup(returning:body:)","type":"codeVoice"},{"text":" method.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Don’t use a task group from outside the task where you created it.","type":"text"},{"text":" ","type":"text"},{"text":"In most cases,","type":"text"},{"text":" ","type":"text"},{"text":"the Swift type system prevents a task group from escaping like that","type":"text"},{"text":" ","type":"text"},{"text":"because adding a child task to a task group is a mutating operation,","type":"text"},{"text":" ","type":"text"},{"text":"and mutation operations can’t be performed","type":"text"},{"text":" ","type":"text"},{"text":"from a concurrent execution context like a child task.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Refer to ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","isActive":true,"type":"reference"},{"text":" documentation for detailed discussion of semantics shared between all task groups.","type":"text"}]},{"type":"heading","level":3,"text":"Discarding behavior","anchor":"Discarding-behavior"},{"type":"paragraph","inlineContent":[{"text":"A discarding task group eagerly discards and releases its child tasks as","type":"text"},{"text":" ","type":"text"},{"text":"soon as they complete. This allows for the efficient releasing of memory used","type":"text"},{"text":" ","type":"text"},{"text":"by those tasks, which are not retained for future ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" calls, as would","type":"text"},{"text":" ","type":"text"},{"text":"be the case with a ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","level":3,"text":"Cancellation behavior","anchor":"Cancellation-behavior"},{"type":"paragraph","inlineContent":[{"text":"A throwing discarding task group becomes canceled in one of the following ways:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"when ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/cancelAll()","isActive":true,"type":"reference"},{"text":" is invoked on it,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"when an error is thrown out of the ","type":"text"},{"code":"withThrowingDiscardingTaskGroup { ... }","type":"codeVoice"},{"text":" closure,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"when the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","isActive":true,"type":"reference"},{"text":" running this task group is canceled.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"But also, and uniquely in ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"discarding","type":"text"}]},{"text":" task groups:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"when ","type":"text"},{"inlineContent":[{"type":"text","text":"any"}],"type":"emphasis"},{"text":" of its child tasks throws.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The group becoming canceled automatically, and cancelling all of its child tasks,","type":"text"},{"text":" ","type":"text"},{"text":"whenever ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"any","type":"text"}]},{"text":" child task throws an error is a behavior unique to discarding task groups,","type":"text"},{"text":" ","type":"text"},{"text":"because achieving such semantics is not possible otherwise, due to the missing ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"on discarding groups. Accumulating task groups can implement this by manually polling ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and deciding to ","type":"text"},{"code":"cancelAll()","type":"codeVoice"},{"text":" when they decide an error should cause the group to become canceled,","type":"text"},{"text":" ","type":"text"},{"text":"however a discarding group cannot poll child tasks for results and therefore assumes that child","type":"text"},{"text":" ","type":"text"},{"text":"task throws are an indication of a group wide failure. In order to avoid such behavior,","type":"text"},{"text":" ","type":"text"},{"text":"use a ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","isActive":true,"type":"reference"},{"text":" instead of a throwing one, or catch specific errors in","type":"text"},{"text":" ","type":"text"},{"text":"operations submitted using ","type":"text"},{"code":"addTask","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Since a ","type":"text"},{"code":"ThrowingDiscardingTaskGroup","type":"codeVoice"},{"text":" is a structured concurrency primitive, cancellation is","type":"text"},{"text":" ","type":"text"},{"text":"automatically propagated through all of its child-tasks (and their child","type":"text"},{"text":" ","type":"text"},{"text":"tasks).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A canceled task group can still keep adding tasks, however they will start","type":"text"},{"text":" ","type":"text"},{"text":"being immediately canceled, and may act accordingly to this. To avoid adding","type":"text"},{"text":" ","type":"text"},{"text":"new tasks to an already canceled task group, use ","type":"text"},{"code":"addTaskUnlessCancelled(priority:body:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"rather than the plain ","type":"text"},{"code":"addTask(priority:body:)","type":"codeVoice"},{"text":" which adds tasks unconditionally.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For information about the language-level concurrency model that ","type":"text"},{"code":"DiscardingTaskGroup","type":"codeVoice"},{"text":" is part of,","type":"text"},{"text":" ","type":"text"},{"text":"see ","type":"text"},{"identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html","isActive":true,"type":"reference"},{"text":" in ","type":"text"},{"identifier":"https:\/\/docs.swift.org\/swift-book\/","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup"}]}],"style":"note"},{"type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup"}]}],"style":"note"},{"type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup"}]}],"style":"note"}],"kind":"content"}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/ThrowingDiscardingTaskGroup/isEmpty":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/isEmpty","url":"\/documentation\/swift\/throwingdiscardingtaskgroup\/isempty","abstract":[{"type":"text","text":"A Boolean value that indicates whether the group has any remaining tasks."}],"role":"symbol","title":"isEmpty","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEmpty"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/ThrowingDiscardingTaskGroup/addTask(executorPreference:priority:operation:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTask(executorPreference:priority:operation:)","url":"\/documentation\/swift\/throwingdiscardingtaskgroup\/addtask(executorpreference:priority:operation:)","conformance":{"constraints":[{"type":"codeVoice","code":"Failure"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Error"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"abstract":[{"type":"text","text":"Adds a child task to the group."}],"role":"symbol","title":"addTask(executorPreference:prior