{"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BitwiseCopyable"]}],"seeAlsoSections":[{"title":"Tasks","generated":true,"anchor":"Tasks","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority","doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"ThrowingDiscardingTaskGroup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"To create a discarding task group,","type":"text"},{"text":" ","type":"text"},{"text":"call the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)"},{"text":" method.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Don’t use a task group from outside the task where you created it.","type":"text"},{"text":" ","type":"text"},{"text":"In most cases,","type":"text"},{"text":" ","type":"text"},{"text":"the Swift type system prevents a task group from escaping like that","type":"text"},{"text":" ","type":"text"},{"text":"because adding a child task to a task group is a mutating operation,","type":"text"},{"text":" ","type":"text"},{"text":"and mutation operations can’t be performed","type":"text"},{"text":" ","type":"text"},{"text":"from a concurrent execution context like a child task.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Refer to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup"},{"text":" documentation for detailed discussion of semantics shared between all task groups.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Discarding behavior","anchor":"Discarding-behavior","type":"heading"},{"inlineContent":[{"text":"A discarding task group eagerly discards and releases its child tasks as","type":"text"},{"text":" ","type":"text"},{"text":"soon as they complete. This allows for the efficient releasing of memory used","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"by those tasks, which are not retained for future "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" calls, as would"},{"type":"text","text":" "},{"type":"text","text":"be the case with a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","anchor":"Cancellation-behavior","text":"Cancellation behavior","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A throwing discarding task group becomes canceled in one of the following ways:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"when "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/cancelAll()"},{"type":"text","text":" is invoked on it,"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"when an error is thrown out of the "},{"code":"withThrowingDiscardingTaskGroup { ... }","type":"codeVoice"},{"type":"text","text":" closure,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"when the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","isActive":true,"type":"reference"},{"text":" running this task group is canceled.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"But also, and uniquely in "},{"type":"emphasis","inlineContent":[{"text":"discarding","type":"text"}]},{"type":"text","text":" task groups:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"when ","type":"text"},{"inlineContent":[{"text":"any","type":"text"}],"type":"emphasis"},{"text":" of its child tasks throws.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The group becoming canceled automatically, and cancelling all of its child tasks,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"whenever "},{"type":"emphasis","inlineContent":[{"type":"text","text":"any"}]},{"type":"text","text":" child task throws an error is a behavior unique to discarding task groups,"},{"type":"text","text":" "},{"type":"text","text":"because achieving such semantics is not possible otherwise, due to the missing "},{"type":"codeVoice","code":"next()"},{"text":" method","type":"text"},{"type":"text","text":" "},{"type":"text","text":"on discarding groups. Accumulating task groups can implement this by manually polling "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" "},{"text":"and deciding to ","type":"text"},{"code":"cancelAll()","type":"codeVoice"},{"type":"text","text":" when they decide an error should cause the group to become canceled,"},{"type":"text","text":" "},{"text":"however a discarding group cannot poll child tasks for results and therefore assumes that child","type":"text"},{"type":"text","text":" "},{"text":"task throws are an indication of a group wide failure. In order to avoid such behavior,","type":"text"},{"text":" ","type":"text"},{"text":"use a ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","isActive":true,"type":"reference"},{"text":" instead of a throwing one, or catch specific errors in","type":"text"},{"text":" ","type":"text"},{"text":"operations submitted using ","type":"text"},{"type":"codeVoice","code":"addTask"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Since a ","type":"text"},{"code":"ThrowingDiscardingTaskGroup","type":"codeVoice"},{"text":" is a structured concurrency primitive, cancellation is","type":"text"},{"text":" ","type":"text"},{"text":"automatically propagated through all of its child-tasks (and their child","type":"text"},{"type":"text","text":" "},{"text":"tasks).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A canceled task group can still keep adding tasks, however they will start"},{"type":"text","text":" "},{"text":"being immediately canceled, and may act accordingly to this. To avoid adding","type":"text"},{"type":"text","text":" "},{"type":"text","text":"new tasks to an already canceled task group, use "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTaskUnlessCancelled(priority:operation:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"text":"rather than the plain ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/addTask(priority:operation:)","isActive":true},{"text":" which adds tasks unconditionally.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For information about the language-level concurrency model that "},{"type":"codeVoice","code":"DiscardingTaskGroup"},{"type":"text","text":" is part of,"},{"text":" ","type":"text"},{"type":"text","text":"see "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.swift.org\/swift-book\/LanguageGuide\/Concurrency.html"},{"type":"text","text":" in "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.swift.org\/swift-book\/"},{"type":"text","text":"."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","isActive":true,"type":"reference"}]}],"name":"See Also","style":"note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","isActive":true,"type":"reference"}]}],"name":"See Also","style":"note"},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup"}],"type":"paragraph"}],"name":"See Also"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/throwingdiscardingtaskgroup"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"ThrowingDiscardingTaskGroup"}],"externalID":"s:12_Concur