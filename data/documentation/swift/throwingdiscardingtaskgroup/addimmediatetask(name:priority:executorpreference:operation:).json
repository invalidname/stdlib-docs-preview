xt","text":"The priority of the operation task."},{"type":"text","text":" "},{"type":"text","text":"Omit this parameter or pass "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to inherit the task group’s base priority."}]}],"name":"priority"},{"content":[{"inlineContent":[{"type":"text","text":"The task executor that the child task should be started on and keep using."},{"type":"text","text":" "},{"type":"text","text":"Explicitly passing "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" as the executor preference is equivalent to"},{"type":"text","text":" "},{"type":"text","text":"calling the "},{"type":"codeVoice","code":"addImmediateTask"},{"type":"text","text":" method without a preference, and effectively"},{"type":"text","text":" "},{"type":"text","text":"means to inherit the outer context’s executor preference."},{"type":"text","text":" "},{"type":"text","text":"You can also pass the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/globalConcurrentExecutor"},{"type":"text","text":" global executor explicitly."}],"type":"paragraph"}],"name":"taskExecutor"},{"content":[{"inlineContent":[{"type":"text","text":"The operation to execute as part of the task group."}],"type":"paragraph"}],"name":"operation"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This function "},{"inlineContent":[{"type":"text","text":"starts"}],"type":"emphasis"},{"type":"text","text":" the created task on the calling context."},{"text":" ","type":"text"},{"type":"text","text":"The task will continue executing on the caller’s context until it suspends,"},{"text":" ","type":"text"},{"text":"and after suspension will resume on the adequate executor. For a nonisolated","type":"text"},{"type":"text","text":" "},{"text":"operation this means running on the global concurrent pool, and on an isolated","type"