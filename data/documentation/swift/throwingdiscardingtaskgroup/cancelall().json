{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup\/cancelAll()","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancelAll"},{"kind":"text","text":"()"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"If you add a task to a group after canceling the group,"},{"type":"text","text":" "},{"type":"text","text":"that task is canceled immediately after being added to the group."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Immediately canceled child tasks should therefore cooperatively check for and"},{"type":"text","text":" "},{"type":"text","text":"react  to cancellation, e.g. by throwing an "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" at their"},{"type":"text","text":" "},{"type":"text","text":"earliest convenience, or otherwise handling the cancellation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"There are no restrictions on where you can call this method."},{"type":"text","text":" "},{"type":"text","text":"Code inside a child task or even another task can cancel a group,"},{"type":"text","text":" "},{"type":"text","text":"however one should be very careful to not keep a reference to the"},{"type":"text","text":" "},{"type":"text","text":"group longer than the "},{"type":"codeVoice","code":"with...TaskGroup(...) { ... }"},{"type":"text","text":" method body is executing."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"Task.isCancelled","type":"codeVoice"}]}],"style":"note","name":"See Also","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"ThrowingDiscardingTaskGroup.isCancelled","ty