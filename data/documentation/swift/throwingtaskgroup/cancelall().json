{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:Scg9cancelAllyyF","platforms":[{"name":"iOS","introducedAt":"8.0","beta":false,"unavailable":false,"deprecated":false},{"introducedAt":"8.0","name":"iPadOS","beta":false,"unavailable":false,"deprecated":false},{"introducedAt":"13.0","name":"Mac Catalyst","beta":false,"unavailable":false,"deprecated":false},{"deprecated":false,"name":"macOS","introducedAt":"10.10","unavailable":false,"beta":false},{"name":"tvOS","introducedAt":"9.0","beta":false,"unavailable":false,"deprecated":false},{"introducedAt":"1.0","name":"visionOS","beta":false,"unavailable":false,"deprecated":false},{"name":"watchOS","introducedAt":"2.0","beta":false,"unavailable":false,"deprecated":false}],"modules":[{"name":"Swift","relatedModules":[]}],"role":"symbol","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancelAll","kind":"identifier"},{"text":"()","kind":"text"}],"title":"cancelAll()","roleHeading":"Instance Method"},"kind":"symbol","seeAlsoSections":[{"title":"Canceling Tasks","generated":true,"anchor":"Canceling-Tasks","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/isCancelled"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"cancelAll","kind":"identifier"},{"text":"()","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"text":"If you add a task to a group after canceling the group,","type":"text"},{"text":" ","type":"text"},{"text":"that task is canceled immediately after being added to the group.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Immediately canceled child tasks should therefore cooperatively check for and","type":"text"},{"text":" ","type":"text"},{"text":"react  to cancellation, e.g. by throwing an ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" at their","type":"text"},{"text":" ","type":"text"},{"text":"earliest convenience, or otherwise handling the cancellation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"There are no restrictions on where you can call this method.","type":"text"},{"text":" ","type":"text"},{"text":"Code inside a child task or even another task can cancel a group,","type":"text"},{"text":" ","type":"text"},{"text":"however one should be very careful to not keep a reference to the","type":"text"},{"text":" ","type":"text"},{"text":"group longer than the ","type":"text"},{"code":"with...TaskGroup(...) { ... }","type":"codeVoice"},{"text":" method body is executing.","type":"text"}],"type":"paragraph"},{"style":"note","name":"See Also","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"Task.isCancelled","type":"codeVoice"}],"type":"paragraph"}],"type":"aside"},{"type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"ThrowingTaskGroup.isCancelled","type":"codeVoice"}],"type":"paragraph"}],"style":"note","name":"See Also"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/throwingtaskgroup\/cancelall()"]}],"abstract":[{"text":"Cancel all of the remaining tasks in the group.","type":"text"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/cancelAll()","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup"]]},"references":{"doc://com.apple.Swift/documentation/Swift/ThrowingTaskGroup/cancelAll()":{"role":"symbol","title":"cancelAll()","url":"\/documentation\/swift\/throwingtaskgroup\/cancelall()","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/cancelAll()","type":"topic","fragments":[{"kind":"keyword