{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/Iterator","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncIteratorProtocol"],"type":"conformsTo","kind":"relationships"}],"seeAlsoSections":[{"title":"Supporting Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/Element","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/AsyncIterator"],"generated":true,"anchor":"Supporting-Types"}],"abstract":[{"text":"A type that provides an iteration interface","type":"text"},{"text":" ","type":"text"},{"text":"over the results of tasks added to the group.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"The elements returned by this iterator","type":"text"},{"text":" ","type":"text"},{"text":"appear in the order that the tasks ","type":"text"},{"inlineContent":[{"text":"completed","type":"text"}],"type":"emphasis"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"not in the order that those tasks were added to the task group.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This iterator terminates after all tasks have completed successfully,","type":"text"},{"text":" ","type":"text"},{"text":"or after any task completes by throwing an error.","type":"text"},{"text":" ","type":"text"},{"text":"If a task completes by throwing an error,","type":"text"},{"text":" ","type":"text"},{"text":"it doesn’t return any further task results.","type":"text"},{"text":" ","type":"text"},{"text":"After iterating over the resul