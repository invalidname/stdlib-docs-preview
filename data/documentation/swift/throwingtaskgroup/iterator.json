erating over the results of each task,"},{"type":"text","text":" "},{"type":"text","text":"it’s valid to make a new iterator for the task group,"},{"type":"text","text":" "},{"type":"text","text":"which you can use to iterate over the results of new tasks you add to the group."},{"type":"text","text":" "},{"type":"text","text":"You can also make a new iterator to resume iteration"},{"type":"text","text":" "},{"type":"text","text":"after a child task throws an error."},{"type":"text","text":" "},{"type":"text","text":"For example:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["group.addTask { 1 }","group.addTask { throw SomeError }","group.addTask { 2 }","","do {","    \/\/ Assuming the child tasks complete in order, this prints \"1\"","    \/\/ and then throws an error.","    for try await r in group { print(r) }","} catch {","    \/\/ Resolve the error.","}","","\/\/ Assuming the child tasks complete in order, this prints \"2\".","for try await r in group { print(r) }"]},{"style":"note","type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"ThrowingTaskGroup.next()"}]}]}]}],"variants":[{"paths":["\/documentation\/swift\/throwingtaskgroup\/iterator"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A type that provides an iteration interface","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"over the results of tasks added to the group."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/AsyncIteratorProtocol"],"title":"Conforms To","type":"conformsTo"}],"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/ThrowingTaskGroup":{"kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","url":"\/documentation\/swift\/throwingtaskgroup","role":"symbol","type":