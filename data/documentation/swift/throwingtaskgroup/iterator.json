:"text"},{"text":" ","type":"text"},{"text":"not in the order that those tasks were added to the task group.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This iterator terminates after all tasks have completed successfully,","type":"text"},{"text":" ","type":"text"},{"text":"or after any task completes by throwing an error.","type":"text"},{"text":" ","type":"text"},{"text":"If a task completes by throwing an error,","type":"text"},{"text":" ","type":"text"},{"text":"it doesn’t return any further task results.","type":"text"},{"text":" ","type":"text"},{"text":"After iterating over the results of each task,","type":"text"},{"text":" ","type":"text"},{"text":"it’s valid to make a new iterator for the task group,","type":"text"},{"text":" ","type":"text"},{"text":"which you can use to iterate over the results of new tasks you add to the group.","type":"text"},{"text":" ","type":"text"},{"text":"You can also make a new iterator to resume iteration","type":"text"},{"text":" ","type":"text"},{"text":"after a child task throws an error.","type":"text"},{"text":" ","type":"text"},{"text":"For example:","type":"text"}],"type":"paragraph"},{"code":["group.addTask { 1 }","group.addTask { throw SomeError }","group.addTask { 2 }","","do {","    \/\/ Assuming the child tasks complete in order, this prints \"1\"","    \/\/ and then throws an error.","    for try await r in group { print(r) }","} catch {","    \/\/ Resolve the error.","}","","\/\/ Assuming the child tasks complete in order, this prints \"2\".","for try await r in group { print(r) }"],"type":"codeListing","syntax":"swift"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":"ThrowingTaskGroup.next()","type":"codeVoice"}],"type":"paragraph"}],"style":"note","name":"See Also","type":"aside"}]}],"variants":[{"paths":["\/documentation\/swift\/throwingtaskgroup\/iterator"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Throwin