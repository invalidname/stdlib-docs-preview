{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@backDeployed(before: macOS 15.0, iOS 18.0, watchOS 11.0, tvOS 18.0, visionOS 2.0)\n","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"next","kind":"identifier"},{"text":"(","kind":"text"},{"text":"isolation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"isolated","kind":"keyword"},{"text":" (","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor","text":"Actor","kind":"typeIdentifier","preciseIdentifier":"s:ScA"},{"text":")? = #isolation) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"ChildTaskResult","kind":"typeIdentifier","preciseIdentifier":"s:Scg15ChildTaskResultxmfp"},{"text":"?","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"The value returned by the next child task that completes."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The values returned by successive calls to this method"},{"type":"text","text":" "},{"type":"text","text":"appear in the order that the tasks "},{"type":"emphasis","inlineContent":[{"type":"text","text":"completed"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"not in the order that those tasks were added to the task group."},{"type":"text","text":" "},{"type":"text","text":"For example:"}],"type":"paragraph"},{"syntax":"swift","code":["group.addTask { 1 }","group.addTask { 2 }","","print(await group.next())","\/\/ Prints either \"2\" or \"1\"."],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If there aren’t any pending tasks in the task group,"},{"type":"text","text":" "},{"type":"text","text":"this method returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which lets you write the following"},{"type":"text","text":" "},{"type":"text","text":"to wait for a single task to complete:"}],"type":"paragraph"},{"syntax":"swift","code":["if let first = try await group.next() {","   return first","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"It also lets you write code like the following"},{"type":"text","text":" "},{"type":"text","text":"to wait for all the child tasks to complete,"},{"type":"text","text":" "},{"type":"text","text":"collecting the values they returned:"}],"type":"paragraph"},{"syntax":"swift","code":["while let first = try await group.next() {","   collected += value","}","return collected"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Awaiting on an empty group"},{"type":"text","text":" "},{"type":"text","text":"immediately returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" without suspending."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can also use a "},{"type":"codeVoice","code":"for"},{"type":"text","text":"-"},{"type":"codeVoice","code":"await"},{"type":"text","text":"-"},{"type":"codeVoice","code":"in"},{"type":"text","text":" loop to collect results of a task group:"}],"type":"paragraph"},{"syntax":"swift","code":["for try await value in group {","    collected += value","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If the next child task throws an error"},{"type":"text","text":" "},{"type":"text","text":"and you propagate that error from this method"},{"type":"text","text":" "},{"type":"text","text":"out of the body of a call to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"ThrowingTaskGroup.withThrowingTaskGroup(of:returning:body:)"},{"type":"text","text":" method,"},{"type":"text","text":" "},{"type":"text","text":"then all remaining child tasks in that group are implicitly canceled."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Don’t call this method from outside the task"},{"type":"text","text":" "},{"type":"text","text":"where this task group was created."},{"type":"text","text":" "},{"type":"text","text":"In most cases, the Swift type system prevents this mistake;"},{"type":"text","text":" "},{"type":"text","text":"for example, because the "},{"type":"codeVoice","code":"add(priority:operation:)"},{"type":"text","text":" method is mutating,"},{"type":"text","text":" "},{"type":"text","text":"that method can’t be called from a concurrent execution context like a child task."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The error thrown by the next child task that completes."}]}],"name":"Throws","style":"note","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"nextResult()"}]}],"name":"See Also","style":"note","type":"aside"}]}],"variants":[{"paths":["\/documentation\/swift\/throwingtaskgroup\/next(isolation:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"title":"Accessing Individual Results","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/next()","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/nextResult(isolation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/isEmpty","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/waitForAll(isolation:)"],"anchor":"Accessing-Individual-Results"}],"metadata":{"title":"next(isolation:)","symbolKind":"method","modules":[{"name":"Swift","relatedModules":[]}],"roleHeading":"Instance Method","platforms