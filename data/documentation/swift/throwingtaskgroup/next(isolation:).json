{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup"]]},"abstract":[{"type":"text","text":"Wait for the next child task to complete,"},{"type":"text","text":" "},{"type":"text","text":"and return the value it returned or rethrow the error it threw."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"text","text":"@backDeployed(before: macOS 15.0, iOS 18.0, watchOS 11.0, tvOS 18.0, visionOS 2.0)\n"},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"next"},{"kind":"text","text":"("},{"kind":"externalParam","text":"isolation"},{"kind":"text","text":": "},{"kind":"keyword","text":"isolated"},{"kind":"text","text":" ("},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor","preciseIdentifier":"s:ScA","kind":"typeIdentifier","text":"Actor"},{"kind":"text","text":")? = #isolation) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:Scg15ChildTaskResultxmfp","kind":"typeIdentifier","text":"ChildTaskResult"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The value returned by the next child task that completes."}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The values returned by successive calls to this method"},{"type":"text","text":" "},{"type":"text","text":"appear in the order that the tasks "},{"type":"emphasis","inlineContent":[{"type":"text","text":"completed"}]},{"type":"text","text":","},{"type":"text","text":" "},{"text":"not in the order that those tasks were added to the task group.","type":"text"},{"text":" ","type":"text"},{"text":"For example:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["group.addTask { 1 }","group.addTask { 2 }","","print(await group.next())","\/\/ Prints either \"2\" or \"1\"."]},{"inlineContent":[{"type":"text","text":"If there aren’t any pending tasks in the task group,"},{"type":"text","text":" "},{"type":"text","text":"this method returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which lets you write the following"},{"type":"text","text":" "},{"type":"text","text":"to wait for a single task to complete:"}],"type":"paragraph"},{"type":"codeListing","code":["if let first = try await group.next() {","   return first","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"It also lets you write code like the following"},{"type":"text","text":" "},{"type":"text","text":"to wait for all the child tasks to complete,"},{"type":"text","text":" "},{"type":"text","text":"collecting the values they returned:"}],"type":"paragraph"},{"type":"codeListing","code":["while let first = try await group.next() {","   collected += value","}","return collected"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Awaiting on an empty group"},{"type":"text","text":" "},{"type":"text","text":"immediately returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" without suspending."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can also use a "},{"type":"codeVoice","code":"for"},{"type":"text","text":"-"},{"type":"codeVoice","code":"await"},{"type":"text","text":"-"},{"type":"codeVoice","code":"in"},{"type":"text","text":" loop to collect results of a task group:"}],"type":"paragraph"},{"type":"codeListing","code":["for try await value in group {","    collected += value","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the next child task throws an error"},{"type":"text","text":" "},{"type":"text","text":"and you propagate that error from this method"},{"type":"text","text":" "},{"type":"text","text":"out of the body of a call to the"},{"type":"text","text":" "},{"code":"ThrowingTaskGroup.withThrowingTaskGroup(of:returning:body:)","type":"codeVoice"},{"type":"text","text":" method,"},{"type":"text","text":" "},{"type":"text","text":"then all remaining child tasks in that group are implicitly canceled."}]},{"inlineContent":[{"type":"text","text":"Don’t call this method from outside the task"},{"type":"text","text":" "},{"type":"text","text":"where this task group was created."},{"type":"text","text":" "},{"type":"text","text":"In most cases, the Swift type system prevents this mistake;"},{"type":"text","text":" "},{"text":"for example, because the ","type":"text"},{"code":"add(priority:operation:)","type":"codeVoice"},{"text":" method is mutating,","type":"text"},{"text":" ","type":"text"},{"text":"that method can’t be called from a concurrent execution context like a child task.","type":"text"}],"type":"paragraph"},{"name":"Throws","content":[{"inlineContent":[{"text":"The error thrown by the next child task that completes.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"},{"name":"See Also","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"nextResult()","type":"codeVoice"}],"type":"paragraph"}],"style":"note","type":"aside"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/throwingtaskgroup\/next(isolation:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/next(isolation:)"},"metadata":{"title":"next(isolation:)","symbolKind":"method","platforms":[{"beta":false,"deprecated":false,"introducedAt":"8.0","name":"iOS","unavai