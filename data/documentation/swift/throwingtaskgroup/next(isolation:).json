s either \"2\" or \"1\"."]},{"type":"paragraph","inlineContent":[{"text":"If there aren’t any pending tasks in the task group,","type":"text"},{"text":" ","type":"text"},{"text":"this method returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which lets you write the following","type":"text"},{"text":" ","type":"text"},{"text":"to wait for a single task to complete:","type":"text"}]},{"code":["if let first = try await group.next() {","   return first","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"It also lets you write code like the following","type":"text"},{"text":" ","type":"text"},{"text":"to wait for all the child tasks to complete,","type":"text"},{"text":" ","type":"text"},{"text":"collecting the values they returned:","type":"text"}],"type":"paragraph"},{"code":["while let first = try await group.next() {","   collected += value","}","return collected"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Awaiting on an empty group"},{"type":"text","text":" "},{"type":"text","text":"immediately returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" without suspending."}]},{"type":"paragraph","inlineContent":[{"text":"You can also use a ","type":"text"},{"code":"for","type":"codeVoice"},{"text":"-","type":"text"},{"code":"await","type":"codeVoice"},{"text":"-","type":"text"},{"type":"codeVoice","code":"in"},{"text":" loop to collect results of a task group:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["for try await value in group {","    collected += value","}"]},{"inlineContent":[{"text":"If the next child task throws an error","type":"text"},{"text":" ","type":"text"},{"text":"and you propagate that error from this method","type":"text"},{"text":" ","type":"text"},{"text":"out of the body of a call to the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ThrowingTaskGroup.withThrowingTaskGroup(of:returning:body:)"},{"text":" method,","type":"text"},{"text":" ","type":"text"},{"text":"then all remaining child tasks in that group are implicitly canceled.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Don’t call this method from outside the task","type":"text"},{"text":" ","type":"text"},{"text":"where this task group was created.","type":"text"},{"text":" ","type":"text"},{"text":"In most cases, the Swift type system prevents this mistake;","type":"text"},{"text":" ","type":"text"},{"text":"for example, because the ","type":"text"},{"code":"add(priority:operation:)","type":"codeVoice"},{"text":" method is mutating,","type":"text"},{"text":" ","type":"text"},{"text":"that method can’t be called from a concurrent execution context like a child task.","type":"text"}]},{"content":[{"inlineContent":[{"text":"The error thrown by the next child task that completes.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"},{"style":"note","type":"aside","name":"See Also","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"nextResult()"}],"type":"paragraph"}]}]}],"sections":[],"variants":[{"paths":["\/documentation\/swift\/throwingtaskgroup\/next(isolation:)"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Accessing Individual Results","anchor":"Accessing-Individual-Results","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/next()","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/nextResult(isolation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/isEmpty","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup\/waitForAll(isolation:)"]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup"]]},"schemaVersion":{"minor":3,"patch":0,"major":