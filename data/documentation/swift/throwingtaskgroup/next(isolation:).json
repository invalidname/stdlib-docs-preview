ing","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The values returned by successive calls to this method","type":"text"},{"text":" ","type":"text"},{"text":"appear in the order that the tasks ","type":"text"},{"inlineContent":[{"text":"completed","type":"text"}],"type":"emphasis"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"not in the order that those tasks were added to the task group.","type":"text"},{"text":" ","type":"text"},{"text":"For example:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["group.addTask { 1 }","group.addTask { 2 }","","print(await group.next())","\/\/ Prints either \"2\" or \"1\"."]},{"type":"paragraph","inlineContent":[{"text":"If there aren’t any pending tasks in the task group,","type":"text"},{"text":" ","type":"text"},{"text":"this method returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which lets you write the following","type":"text"},{"text":" ","type":"text"},{"text":"to wait for a single task to complete:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if let first = try await group.next() {","   return first","}"]},{"type":"paragraph","inlineContent":[{"text":"It also lets you write code like the following","type":"text"},{"text":" ","type":"text"},{"text":"to wait for all the child tasks to complete,","type":"text"},{"text":" ","type":"text"},{"text":"collecting the values they returned:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["while let first = try await group.next() {","   collected += value","}","return collected"]},{"type":"paragraph","inlineContent":[{"text":"Awaiting on an empty group","type":"text"},{"text":" ","type":"text"},{"text":"immediately returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" without suspending.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can also use a ","t