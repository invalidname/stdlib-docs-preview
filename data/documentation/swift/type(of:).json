{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"abstract":[{"text":"Returns the dynamic type of a value.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Mirror","doc:\/\/com.apple.Swift\/documentation\/Swift\/ObjectIdentifier","doc:\/\/com.apple.Swift\/documentation\/Swift\/==(_:_:)-958in","doc:\/\/com.apple.Swift\/documentation\/Swift\/!=(_:_:)-18co7"],"title":"Querying Runtime Values","generated":true,"anchor":"Querying-Runtime-Values"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"type"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Metatype"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"value"},{"kind":"text","text":": "},{"kind":"keyword","text":"borrowing"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4type2ofq_x_tRi_zRi0_zr0_lF1TL_xmfp","text":"T"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4type2ofq_x_tRi_zRi0_zr0_lF8MetatypeL_q_mfp","text":"Metatype"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : ~Copyable, "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : ~Escapable"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value for which to find the dynamic type."}]}],"name":"value"}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"The dynamic type, which is a metatype instance."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"You can use the "},{"code":"type(of:)","type":"codeVoice"},{"type":"text","text":" function to find the dynamic type of a value,"},{"type":"text","text":" "},{"type":"text","text":"particularly when the dynamic type is different from the static type. The"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"static type"}]},{"type":"text","text":" of a value is the known, compile-time type of the value. The"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"dynamic type"}]},{"type":"text","text":" of a value is the value’s actual type at run-time, which"},{"type":"text","text":" "},{"type":"text","text":"can be a subtype of its concrete type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In the following code, the "},{"code":"count","type":"codeVoice"},{"type":"text","text":" variable has the same static and dynamic"},{"type":"text","text":" "},{"type":"text","text":"type: "},{"code":"Int","type":"codeVoice"},{"type":"text","text":". When "},{"code":"count","type":"codeVoice"},{"type":"text","text":" is passed to the "},{"code":"printInfo(_:)","type":"codeVoice"},{"type":"text","text":" function,"},{"type":"text","text":" "},{"type":"text","text":"however, the "},{"code":"value","type":"codeVoice"},{"type":"text","text":" parameter has a static type of "},{"code":"Any","type":"codeVoice"},{"type":"text","text":" (the type"},{"type":"text","text":" "},{"type":"text","text":"declared for the parameter) and a dynamic type of "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["func printInfo(_ value: Any) {","    let t = type(of: value)","    print(\"'\\(value)' of type '\\(t)'\")","}","","let count: Int = 5","printInfo(count)","\/\/ '5' of type 'Int'"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The dynamic type returned from "},{"code":"type(of:)","type":"codeVoice"},{"type":"text","text":" is a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"concrete metatype"}]},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"T.Type","type":"codeVoice"},{"type":"text","text":") for a class, structure, enumeration, or other nonprotocol type"},{"type":"text","text":" "},{"code":"T","type":"codeVoice"},{"type":"text","text":", or an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"existential metatype"}]},{"type":"text","text":" ("},{"code":"P.Type","type":"codeVoice"},{"type":"text","text":") for a protocol or protocol"},{"type":"text","text":" "},{"type":"text","text":"composition "},{"code":"P","type":"codeVoice"},{"type":"text","text":". When the static type of the value passed to "},{"code":"type(of:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is constrained to a class or protocol, you can use that metatype to access"},{"type":"text","text":" "},{"type":"text","text":"initializers or other static members of the class or protocol."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, the parameter passed as "},{"code":"value","type":"codeVoice"},{"type":"text","text":" to the "},{"code":"printSmileyInfo(_:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"function in the example below is an instance of the "},{"code":"Smiley","type":"codeVoice"},{"type":"text","text":" class or one"},{"type":"text","text":" "},{"type":"text","text":"of its subclasses. The function uses "},{"code":"type(of:)","type":"codeVoice"},{"type":"text","text":" to find the dynamic type"},{"type":"text","text":" "},{"type":"text","text":"of "},{"code":"value","type":"codeVoice"},{"type":"text","text":", which itself is an instance of the "},{"code":"Smiley.Type","type":"codeVoice"},{"type":"text","text":" metatype."}],"type":"paragraph"},{"syntax":"swift","code":["class Smiley {","    class var text: String {","        return \":)\"","    }","}","","class EmojiSmiley: Smiley {","     override class var text: String {","        return \"😀\"","    }","}","","func printSmileyInfo(_ value: Smiley) {","    let smileyType = type(of: value)","    print(\"Smile!\", smileyType.text)","}","","let emojiSmiley = EmojiSmiley()","printSmileyInfo(emojiSmiley)","\/\/ Smile! 😀"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"In this example, accessing the "},{"code":"text","type":"codeVoice"},{"type":"text","text":" property of the "},{"code":"smileyType","type":"codeVoice"},{"type":"text","text":" metatype"},{"type":"text","text":" "},{"type":"text","text":"retrieves the overridden value from the "},{"code":"EmojiSmiley","type":"codeVoice"},{"type":"text","text":" subclass, instead of"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"Smiley","type":"codeVoice"},{"type":"text","text":" class’s original definition."}],"type":"paragraph"},{"level":1,"anchor":"Finding-the-Dynamic-Type-in-a-Generic-Context","text":"Finding the Dynamic Type in a Generic Context","type":"heading"},{"inlineContent":[{"type":"text","text":"Normally, you don’t need to be aware of the difference between concrete and"},{"type":"text","text":" "},{"type":"text","text":"existential metatypes, but calling "},{"code":"type(of:)","type":"codeVoice"},{"type":"text","text":" can yield unexpected"},{"type":"text","text":" "},{"type":"text","text":"results in a generic context with a type parameter bound to a protocol. In"},{"type":"text","text":" "},{"type":"text","text":"a case like this, where a generic parameter "},{"code":"T","type":"codeVoice"},{"type":"text","text":" is bound to a protocol"},{"type":"text","text":" "},{"code":"P","type":"codeVoice"},{"type":"text","text":", the type parameter is not statically known to be a protocol type in"},{"type":"text","text":" "},{"type":"text","text":"the body of the generic function. As a result, "},{"code":"type(of:)","type":"codeVoice"},{"type":"text","text":" can only"},{"type":"text","text":" "},{"type":"text","text":"produce the concrete metatype "},{"code":"P.Protocol","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example defines a "},{"code":"printGenericInfo(_:)","type":"codeVoice"},{"type":"text","text":" function that takes"},{"type":"text","text":" "},{"type":"text","text":"a generic parameter and declares the "},{"code":"String","type":"codeVoice"},{"type":"text","text":" type’s conformance to a new"},{"type":"text","text":" "},{"type":"text","text":"protocol "},{"code":"P","type":"codeVoice"},{"type":"text","text":". When "},{"code":"printGenericInfo(_:)","type":"codeVoice"},{"type":"text","text":" is called with a string that has"},{"type":"text","text":" "},{"code":"P","type":"codeVoice"},{"type":"text","text":" as its static type, the call to "},{"code":"type(of:)","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"P.self","type":"codeVoice"},{"type":"text","text":" instead"},{"type":"text","text":" "},{"type":"text","text":"of "},{"code":"String.self","type":"codeVoice"},{"type":"text","text":" (the dynamic type inside the parameter)."}],"type":"paragraph"},{"syntax":"swift","code":["func printGenericInfo<T>(_ value: T) {","    let t = type(of: value)","    print(\"'\\(value)' of type '\\(t)'\")","}","","protocol P {}","extension String: P {}","","let stringAsP: P = \"Hello!\"","printGenericInfo(stringAsP)","\/\/ 'Hello!' of type 'P'"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This unexpected result occurs because the call to "},{"code":"type(of: value)","type":"codeVoice"},{"type":"text","text":" inside"},{"type":"text","text":" "},{"code":"printGenericInfo(_:)","type":"codeVoice"},{"type":"text","text":" must return a metatype that is an instance of"},{"type":"text","text":" "},{"code":"T.Type","type":"codeVoice"},{"type":"text","text":", but "},{"code":"String.self","type":"codeVoice"},{"type":"text","text":" (the expected dynamic type) is not an instance"},{"type":"text","text":" "},{"type":"text","text":"of "},{"code":"P.Type","type":"codeVoice"},{"type":"text","text":" (the concrete metatype of "},{"code":"value","type":"codeVoice"},{"type":"text","text":"). To get the dynamic type"},{"type":"text","text":" "},{"type":"text","text":"inside "},{"code":"value","type":"codeVoice"},{"type":"text","text":" in this generic context, cast the parameter to "},{"code":"Any","type":"codeVoice"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"calling "},{"code":"type(of:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["func betterPrintGenericInfo<T>(_ value: T) {","    let t = type(of: value as Any)","    print(\"'\\(value)' of type '\\(t)'\")","}","","betterPrintGenericInfo(stringAsP)","\/\/ 'Hello!' of type 'String'"],"type":"codeListing"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/type(of:)"},"variants":[{"paths":["\/documentation\/swift\/type(of:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Function","externalID":"s:s4type2ofq_x_tRi_zRi0_zr0_lF","symbolKind":"func","title":"type(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"type","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Metatype","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"borrowing","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:s4type2ofq_x_tRi_zRi0_zr0_lF1TL_xmfp","text":"T","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4type2ofq_x_tRi_zRi0_zr0_l