{"kind":"symbol","metadata":{"roleHeading":"Function","platforms":[{"introducedAt":"8.0","name":"iOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"8.0","name":"iPadOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"13.0","name":"Mac Catalyst","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"10.10","name":"macOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"9.0","name":"tvOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"1.0","name":"visionOS","deprecated":false,"unavailable":false,"beta":false},{"unavailable":false,"name":"watchOS","introducedAt":"2.0","deprecated":false,"beta":false}],"symbolKind":"func","role":"symbol","title":"type(of:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"type"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":", ","kind":"text"},{"kind":"genericParameter","text":"Metatype"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"keyword","text":"borrowing"},{"kind":"text","text":" "},{"text":"T","preciseIdentifier":"s:s4type2ofq_x_tRi_zRi0_zr0_lF1TL_xmfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Metatype","preciseIdentifier":"s:s4type2ofq_x_tRi_zRi0_zr0_lF8MetatypeL_q_mfp","kind":"typeIdentifier"}],"externalID":"s:s4type2ofq_x_tRi_zRi0_zr0_lF","modules":[{"name":"Swift"}]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/type(of:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"sections":[],"abstract":[{"text":"Returns the dynamic type of a value.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/type(of:)"]}],"seeAlsoSections":[{"generated":true,"anchor":"Querying-Runtime-Values","title":"Querying Runtime Values","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Mirror","doc:\/\/com.apple.Swift\/documentation\/Swift\/ObjectIdentifier","doc:\/\/com.apple.Swift\/documentation\/Swift\/==(_:_:)-958in","doc:\/\/com.apple.Swift\/documentation\/Swift\/!=(_:_:)-18co7"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"type"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"text":", ","kind":"text"},{"text":"Metatype","kind":"genericParameter"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"text":" ","kind":"text"},{"text":"value","kind":"internalParam"},{"kind":"text","text":": "},{"text":"borrowing","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:s4type2ofq_x_tRi_zRi0_zr0_lF1TL_xmfp","text":"T","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4type2ofq_x_tRi_zRi0_zr0_lF8MetatypeL_q_mfp","text":"Metatype","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ~Copyable, ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ~Escapable","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The value for which to find the dynamic type."}],"type":"paragraph"}],"name":"value"}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"inlineContent":[{"type":"text","text":"The dynamic type, which is a metatype instance."}],"type":"paragraph"}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"You can use the ","type":"text"},{"type":"codeVoice","code":"type(of:)"},{"text":" function to find the dynamic type of a value,","type":"text"},{"text":" ","type":"text"},{"text":"particularly when the dynamic type is different from the static type. The","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"static type","type":"text"}],"type":"emphasis"},{"text":" of a value is the known, compile-time type of the value. The","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"dynamic type","type":"text"}],"type":"emphasis"},{"text":" of a value is the value’s actual type at run-time, which","type":"text"},{"text":" ","type":"text"},{"text":"can be a subtype of its concrete type.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In the following code, the "},{"type":"codeVoice","code":"count"},{"type":"text","text":" variable has the same static and dynamic"},{"type":"text","text":" "},{"type":"text","text":"type: "},{"type":"codeVoice","code":"Int"},{"type":"text","text":". When "},{"type":"codeVoice","code":"count"},{"type":"text","text":" is passed to the "},{"type":"codeVoice","code":"printInfo(_:)"},{"type":"text","text":" function,"},{"type":"text","text":" "},{"type":"text","text":"however, the "},{"code":"value","type":"codeVoice"},{"text":" parameter has a static type of ","type":"text"},{"code":"Any","type":"codeVoice"},{"text":" (the type","type":"text"},{"type":"text","text":" "},{"type":"text","text":"declared for the parameter) and a dynamic type of "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["func printInfo(_ value: Any) {","    let t = type(of: value)","    print(\"'\\(value)' of type '\\(t)'\")","}","","let count: Int = 5","printInfo(count)","\/\/ '5' of type 'Int'"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The dynamic type returned from "},{"type":"codeVoice","code":"type(of:)"},{"type":"text","text":" is a "},{"type":"emphasis","inlineContent":[{"text":"concrete metatype","type":"text"}]},{"type":"text","text":" "},{"text":"(","type":"text"},{"code":"T.Type","type":"codeVoice"},{"text":") for a class, structure, enumeration, or other nonprotocol type","type":"text"},{"text":" ","type":"text"},{"code":"T","type":"codeVoice"},{"text":", or an ","type":"text"},{"inlineContent":[{"text":"existential metatype","type":"text"}],"type":"emphasis"},{"text":" (","type":"text"},{"code":"P.Type","type":"codeVoice"},{"type":"text","text":") for a protocol or protocol"},{"type":"text","text":" "},{"type":"text","text":"composition "},{"type":"codeVoice","code":"P"},{"type":"text","text":". When the static type of the value passed to "},{"type":"codeVoice","code":"type(of:)"},{"type":"text","text":" "},{"type":"text","text":"is constrained to a class or protocol, you can use that metatype to access"},{"type":"text","text":" "},{"type":"text","text":"initializers or other static members of the class or protocol."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, the parameter passed as "},{"code":"value","type":"codeVoice"},{"type":"text","text":" to the "},{"code":"printSmileyInfo(_:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"function in the example below is an instance of the "},{"code":"Smiley","type":"codeVoice"},{"type":"text","text":" class or one"},{"type":"text","text":" "},{"type":"text","text":"of its subclasses. The function uses "},{"type":"codeVoice","code":"type(of:)"},{"text":" to find the dynamic type","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"type":"codeVoice","code":"value"},{"text":", which itself is an instance of the ","type":"text"},{"type":"codeVoice","code":"Smiley.Type"},{"type":"text","text":" metatype."}]},{"type":"codeListing","syntax":"swift","code":["class Smiley {","    class var text: String {","        return \":)\"","    }","}","","class EmojiSmiley: Smiley {","     override class var text: String {","        return \"😀\"","    }","}","","func printSmileyInfo(_ value: Smiley) {","    let smileyType = type(of: value)","    print(\"Smile!\", smileyType.text)","}","","let emojiSmiley = EmojiSmiley()","printSmileyInfo(emojiSmiley)","\/\/ Smile! 😀"]},{"inlineContent":[{"type":"text","text":"In this example, accessing the "},{"type":"codeVoice","code":"text"},{"type":"text","text":" property of the "},{"code":"smileyType","type":"codeVoice"},{"type":"text","text":" metatype"},{"type":"text","text":" "},{"type":"text","text":"retrieves the overridden value from the "},{"type":"codeVoice","code":"EmojiSmiley"},{"type":"text","text":" subclass, instead of"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"Smiley"},{"type":"text","text":" class’s original definition."}],"type":"paragraph"},{"text":"Finding the Dynamic Type in a Generic Context","type":"heading","level":1,"anchor":"Finding-the-Dynamic-Type-in-a-Generic-Context"},{"type":"paragraph","inlineContent":[{"text":"Normally, you don’t need to be aware of the difference between concrete and","type":"text"},{"text":" ","type":"text"},{"text":"existential metatypes, but calling ","type":"text"},{"type":"codeVoice","code":"type(of:)"},{"type":"text","text":" can yield unexpected"},{"text":" ","type":"text"},{"type":"text","text":"results in a generic context with a type parameter bound to a protocol. In"},{"type":"text","text":" "},{"type":"text","text":"a case like this, where a generic parameter "},{"code":"T","type":"codeVoice"},{"type":"text","text":" is bound to a protocol"},{"type":"text","text":" "},{"type":"codeVoice","code":"P"},{"type":"text","text":", the type parameter is not statically known to be a protocol type in"},{"text":" ","type":"text"},{"type":"text","text":"the body of the generic function. As a result, "},{"type":"codeVoice","code":"type(of:)"},{"type":"text","text":" can only"},{"type":"text","text":" "},{"type":"text","text":"produce the concrete metatype "},{"type":"codeVoice","code":"P.Protocol"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example defines a "},{"type":"codeVoice","code":"printGenericInfo(_:)"},{"type":"text","text":" function that takes"},{"type":"text","text":" "},{"type":"text","text":"a generic parameter and declares the "},{"type":"codeVoice","code":"String"},{"type":"text","text":" type’s conformance to a new"},{"type":"text","text":" "},{"type":"text","text":"protocol "},{"code":"P","type":"codeVoice"},{"type":"text","text":". When "},{"code":"printGenericInfo(_:)","type":"codeVoice"},{"type":"text","text":" is called with a string that has"},{"type":"text","text":" "},{"type":"codeVoice","code":"P"},{"type":"text","text":" as its static type, the call to "},{"type":"codeVoice","code":"type(of:)"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"P.self"},{"type":"text","text":" instead"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"String.self"},{"type":"text","text":" (the dynamic type inside the parameter)."}]},{"code":["func printGenericInfo<T>(_ value: T) {","    let t = type(of: value)","    print(\"'\\(value)' of type '\\(t)'\")","}","","protocol P {}","extension String: P {}","","let stringAsP: P = \"Hello!\"","printGenericInfo(stringAsP)","\/\/ 'Hello!' of type 'P'"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This unexpected result occurs because the call to ","type":"text"},{"code":"type(of: value)","type":"codeVoice"},{"text":" inside","type":"text"},{"text":" ","type":"text"},{"code":"printGenericInfo(_:)","type":"codeVoice"},{"text":" must return a metatype that is an instance of","type":"text"},{"text":" ","type":"text"},{"code":"T.Type","type":"codeVoice"},{"text":", but ","type":"text"},{"code":"String.self","type":"codeVoice"},{"text":" (the expected dynamic type) is not an instance","type":"text"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"P.Type"},{"type":"text","text":" (the concrete metatype of "},{"type":"codeVoice","code":"value"},{"type":"text","text":"). To get the dynamic type"},{"type":"text","text":" "},{"text":"inside ","type":"text"},{"type":"codeVoice","code":"value"},{"type":"text","text":" in this generic context, cast the parameter to "},{"type":"codeVoice","code":"Any"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"calling "},{"type":"codeVoice","code":"type(of:)"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","code":["func betterPrintGenericInfo<T>(_ value: T) {","    let t = type(of: value as Any)","    print(\"'\\(value)' of type '\\(t)'\")","}","","betterPrintGenericInfo(stringAsP)","\/\/ 'Hello!' of type 'String'"],"syntax":"swift"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.apple.Swift/documentation/Swift/type(of:)":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"type","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Metatype","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"borrowing","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:s4type2ofq_x_tRi_zRi0_zr0_lF1TL_xmfp","text":"T","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:s4type2ofq_x_tRi_zRi0_zr0_lF8MetatypeL_q_mfp","text":"Metatype"}],"kind":"symbol","abstract":[{"type":"text","text":"Returns the dynamic type of a value."}],"url":"\/documentation\/swift\/type(of:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/type(of:)","role":"symbol","title":"type(of:)"},"doc://com.apple.Swift/documentation/Swift/!=(_:_:)-18co7":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"!=","kind":"identifier"},{"text":" ","kind":"text"},{"text":"((), ()) -> ","kind":"text"},{"text":"Bo