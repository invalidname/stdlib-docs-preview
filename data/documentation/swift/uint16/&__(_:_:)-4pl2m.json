; otherwise, masking is performed using a","type":"text"},{"text":" ","type":"text"},{"text":"modulo operation.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/UInt16":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt16","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UInt16"}],"title":"UInt16","navigatorTitle":[{"kind":"identifier","text":"UInt16"}],"url":"\/documentation\/swift\/uint16","role":"symbol","kind":"symbol","abstract":[{"text":"A 16-bit unsigned integer value","type":"text"},{"type":"text","text":" "},{"type":"text","text":"type."}]},"doc://com.apple.Swift/documentation/Swift/BinaryInteger":{"role":"symbol","title":"BinaryInteger","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BinaryInteger","abstract":[{"type":"text","text":"An integer type with a binary representation."}],"navigatorTitle":[{"text":"BinaryInteger","kind":"identifier"}],"url":"\/documentation\/swift\/binaryinteger","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryInteger","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","url":"\/documentation\/swift","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"title":"Standard Library","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"role":"collection"},"doc://com.apple.Swift/documentation/Swift/UInt16/&__(_:_:)-4pl2m":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt16\/&__(_:_:)-4pl2m","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"&>>","kind":"identifier"},{"kind":"text","text":" "},{"text":"<","kind":"text"},{"text":"Other","kind":"gene