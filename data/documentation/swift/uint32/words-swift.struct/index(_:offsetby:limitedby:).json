reater than ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" to have any","type":"text"},{"text":" ","type":"text"},{"text":"effect. Likewise, if ","type":"text"},{"type":"codeVoice","code":"distance < 0"},{"text":", ","type":"text"},{"type":"codeVoice","code":"limit"},{"text":" should be less than ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" ","type":"text"},{"text":"to have any effect.","type":"text"}]}],"name":"limit"}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"An index offset by "},{"code":"distance","type":"codeVoice"},{"type":"text","text":" from the index "},{"code":"i","type":"codeVoice"},{"type":"text","text":", unless that"},{"type":"text","text":" "},{"type":"text","text":"index would be beyond "},{"code":"limit","type":"codeVoice"},{"type":"text","text":" in the direction of movement. In that"},{"type":"text","text":" "},{"type":"text","text":"case, the method returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The following example obtains an index advanced four positions from an"},{"type":"text","text":" "},{"type":"text","text":"array’s starting index and then prints the element at that position. The"},{"type":"text","text":" "},{"type":"text","text":"operation doesn’t require going beyond the limiting "},{"code":"numbers.endIndex","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"value, so it succeeds."}],"type":"paragraph"},{"syntax":"swift","code":["let numbers = [10, 20, 30, 40, 50]","let i = numbers.index(numbers.startIndex, offsetBy: 4)","print(numbers[i])","\/\/ Prints \"50\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The next example attempts to retrieve an index ten positions from"},{"type":"