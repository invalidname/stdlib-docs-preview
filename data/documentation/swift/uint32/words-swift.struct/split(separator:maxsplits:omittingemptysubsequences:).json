EmptySubsequences"},{"type":"text","text":" "},{"type":"text","text":"parameter, so the returned array contains empty strings where spaces"},{"type":"text","text":" "},{"type":"text","text":"were repeated."}]},{"type":"codeListing","code":["print(line.split(separator: \" \", omittingEmptySubsequences: false))","\/\/ Prints \"[\"BLANCHE:\", \"\", \"\", \"I\", \"don\\'t\", \"want\", \"realism.\", \"I\", \"want\", \"magic!\"]\""],"syntax":"swift"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" is the length of the collection."}]}],"type":"aside","style":"note"}]}],"variants":[{"paths":["\/documentation\/swift\/uint32\/words-swift.struct\/split(separator:maxsplits:omittingemptysubsequences:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt32\/Words-swift.struct\/split(separator:maxSplits:omittingEmptySubsequences:)"},"references":{"doc://com.apple.Swift/documentation/Swift/Int":{"type":"topic","abstract":[{"text":"A signed integer value type.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","role":"symbol","title":"Int","navigatorTitle":[{"text":"Int","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/swift\/int","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Int","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/UInt32/Words-swift.struct/split(separator:maxSplits:omittingEmptySubsequences:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt32\/Words-swift.struct\/split(separator:maxSplits:omittingEmptySubsequences:)","role":"symbol","title":"split(separator:maxSplits:omittingEmptySubsequences:)","conformance":{"availabilityPre