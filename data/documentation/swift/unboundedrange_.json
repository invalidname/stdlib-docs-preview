{"topicSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/UnboundedRange_\/...(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnboundedRange"],"title":"Creating an Unbounded Range","anchor":"Creating-an-Unbounded-Range"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"UnboundedRange_"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use the unbounded range operator ("},{"code":"...","type":"codeVoice"},{"type":"text","text":") to create a slice of a"},{"text":" ","type":"text"},{"text":"collection that contains all of the collection’s elements. Slicing with an","type":"text"},{"type":"text","text":" "},{"text":"unbounded range is essentially a conversion of a collection instance into","type":"text"},{"text":" ","type":"text"},{"text":"its slice type.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, the following code declares ","type":"text"},{"type":"codeVoice","code":"countLetterChanges(_:_:)"},{"text":", a","type":"text"},{"text":" ","type":"text"},{"text":"function that finds the number of changes required to change one","type":"text"},{"text":" ","type":"text"},{"text":"word or phrase into another. The function uses a recursive approach to","type":"text"},{"text":" ","type":"text"},{"text":"perform the same comparisons on smaller and smaller pieces of the original","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"strings. In order to use recursion without making copies of the strings at"},{"type":"text","text":" "},{"text":"each step, ","type":"text"},{"type":"codeVoice","code":"countLetterChanges(_:_:)"},{"text":" uses ","type":"text"},{"code":"Substring","type":"codeVoice"},{"text":", a string’s slice","type":"text"},{"type":"text","text":" "},{"text":"type, for its parameters.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func countLetterChanges(_ s1: Substring, _ s2: Substring) -> Int {","    if s1.isEmpty { return s2.count }","    if s2.isEmpty { return s1.count }","","    let cost = s1.first == s2.first ? 0 : 1","","    return min(","        countLetterChanges(s1.dropFirst(), s2) + 1,","        countLetterChanges(s1, s2.dropFirst()) + 1,","        countLetterChanges(s1.dropFirst(), s2.dropFirst()) + cost)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To call "},{"type":"codeVoice","code":"countLetterChanges(_:_:)"},{"type":"text","text":" with two strings, use an unbounded"},{"type":"text","text":" "},{"type":"text","text":"range in each string’s subscript."}]},{"syntax":"swift","code":["let word1 = \"grizzly\"","let word2 = \"grisly\"","let changes = countLetterChanges(word1[...], word2[...])","\/\/ changes == 2"],"type":"codeListing"}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BitwiseCopyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"abstract":[{"text":"A range expression that represents the entire range of a collection.","type":"text"}],"metadata":{"role":"symbol","platforms":[{"introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false,"name":"iOS"},{"introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false,"name":"iPadOS"},{"introducedAt":"13.0","name":"Mac Catalyst","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"10.10","name":"macOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"9.0","name":"tvOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false,"name":"visionOS"},{"introduc