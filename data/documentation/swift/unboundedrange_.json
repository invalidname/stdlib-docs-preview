{"variants":[{"paths":["\/documentation\/swift\/unboundedrange_"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnboundedRange_","kind":"identifier"}],"symbolKind":"enum","navigatorTitle":[{"text":"UnboundedRange_","kind":"identifier"}],"platforms":[{"introducedAt":"8.0","name":"iOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"8.0","name":"iPadOS","unavailable":false,"beta":false,"deprecated":false},{"beta":false,"deprecated":false,"name":"Mac Catalyst","introducedAt":"13.0","unavailable":false},{"beta":false,"deprecated":false,"name":"macOS","introducedAt":"10.10","unavailable":false},{"beta":false,"deprecated":false,"name":"tvOS","introducedAt":"9.0","unavailable":false},{"beta":false,"deprecated":false,"name":"visionOS","introducedAt":"1.0","unavailable":false},{"beta":false,"deprecated":false,"name":"watchOS","introducedAt":"2.0","unavailable":false}],"modules":[{"name":"Swift"}],"roleHeading":"Enumeration","role":"symbol","title":"UnboundedRange_","externalID":"s:s15UnboundedRange_O"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"abstract":[{"type":"text","text":"A range expression that represents the entire range of a collection."}],"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnboundedRange_","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Creating-an-Unbounded-Range","title":"Creating an Unbounded Range","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/UnboundedRange_\/...(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnboundedRange"]}],"seeAlsoSections":[{"generated":true,"title":"Range Expressions","anchor":"Range-Expressions","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeUpTo","doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeThrough","doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom","doc:\/\/com.apple.Swift\/documentation\/Swift\/RangeExpression"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnboundedRange_"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"You can use the unbounded range operator (","type":"text"},{"type":"codeVoice","code":"..."},{"text":") to create a slice of a","type":"text"},{"text":" ","type":"text"},{"text":"collection that contains all of the collection’s elements. Slicing with an","type":"text"},{"text":" ","type":"text"},{"text":"unbounded range is essentially a conversion of a collection instance into","type":"text"},{"text":" ","type":"text"},{"text":"its slice type.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, the following code declares ","type":"text"},{"type":"codeVoice","code":"countLetterChanges(_:_:)"},{"text":", a","type":"text"},{"text":" ","type":"text"},{"text":"function that finds the number of changes required to change one","type":"text"},{"text":" ","type":"text"},{"text":"word or phrase into another. The function uses a recursive approach to","type":"text"},{"text":" ","type":"text"},{"text":"perform the same comparisons on smaller and smaller pieces of the original","type":"text"},{"text":" ","type":"text"},{"text":"strings. In order to use recursion without making copies of the strings at","type":"text"},{"text":" ","type":"text"},{"text":"each step, ","type":"text"},{"type":"codeVoice","code":"countLetterChanges(_:_:)"},{"text":" uses ","type":"text"},{"type":"codeVoice","code":"Substring"},{"text":", a string’s slice","type":"text"},{"text":" ","type":"text"},{"text":"type, for its parameters.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["func countLetterChanges(_ s1: Substring, _ s2: Substring) -> Int {","    if s1.isEmpty { return s2.count }","    if s2.isEmpty { return s1.count }","","    let cost = s1.first == s2.first ? 0 : 1","","    return min(","        countLetterChanges(s1.dropFirst(), s2) + 1,","        countLetterChanges(s1, s2.dropFirst()) + 1,","        countLetterChanges(s1.dropFirst(), s2.dropFirst()) + cost)","}"],"syntax":"swift"},{"inlineContent":[{"text":"To call ","type":"text"},{"type":"codeVoice","code":"countLetterChanges(_:_:)"},{"text":" with two strings, use an unbounded","type":"text"},{"text":" ","type":"text"},{"text":"range in each string’s subscript.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let word1 = \"grizzly\"","let word2 = \"grisly\"","let changes = countLetterChanges(word1[...], word2[...])","\/\/ changes == 2"],"syntax":"swift"}]}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/BitwiseCopyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable"]}],"references":{"doc://com.apple.Swift/documentation/Swift/PartialRangeFrom":{"navigatorTitle":[{"text":"PartialRangeFrom","kind":"identifier"}],"url":"\/documentation\/swift\/partialrangefrom","abstract":[{"type":"text","text":"A partial interval extending upward from a lower bound."}],"kind":"symbol","title":"PartialRangeFrom","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeFrom","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PartialRangeFrom","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/PartialRangeUpTo":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/PartialRangeUpTo","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"PartialRangeUpTo","kind":"identifier"}],"type":"