inal example passes ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for the ","type":"text"},{"code":"omittingEmptySubsequences","type":"codeVoice"},{"text":" ","type":"text"},{"text":"parameter, so the returned array contains empty strings where spaces","type":"text"},{"text":" ","type":"text"},{"text":"were repeated.","type":"text"}]},{"code":["print(line.split(separator: \" \", omittingEmptySubsequences: false)","          .map(String.init))","\/\/ Prints \"[\"BLANCHE:\", \"\", \"\", \"I\", \"don\\'t\", \"want\", \"realism.\", \"I\", \"want\", \"magic!\"]\""],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" is the length of the sequence."}],"type":"paragraph"}]}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnfoldSequence"]]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnfoldSequence\/split(separator:maxSplits:omittingEmptySubsequences:)","interfaceLanguage":"swift"},"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/UnfoldSequence":{"kind":"symbol","abstract":[{"text":"A sequence whose elements are produced via repeated applications of a","type":"text"},{"text":" ","type":"text"},{"text":"closure to some mutable state.","type":"text"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"UnfoldSequence","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnfoldSequence","kind":"identifier"}],"url":"\/documentation\/swift\/unfoldsequence","title":"UnfoldSequence","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnfoldSequence"},"doc://com.apple.Sw