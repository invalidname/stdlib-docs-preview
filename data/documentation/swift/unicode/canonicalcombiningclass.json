"],"kind":"relationships"}],"seeAlsoSections":[{"generated":true,"anchor":"Unicode-Scalar-Classifications","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/GeneralCategory","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/NumericType"],"title":"Unicode Scalar Classifications"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/CanonicalCombiningClass"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CanonicalCombiningClass","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Canonical combining classes are used by the ordering algorithm to","type":"text"},{"text":" ","type":"text"},{"text":"determine if two sequences of combining marks should be considered","type":"text"},{"text":" ","type":"text"},{"text":"canonically equivalent (that is, identical in interpretation). Two","type":"text"},{"text":" ","type":"text"},{"text":"sequences are canonically equivalent if they are equal when sorting the","type":"text"},{"text":" ","type":"text"},{"text":"scalars in ascending order by their combining class.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, consider the sequence ","type":"text"},{"type":"codeVoice","code":"\"\\u{0041}\\u{0301}\\u{0316}\""},{"text":" (LATIN","type":"text"},{"text":" ","type":"text"},{"text":"CAPITAL LETTER A, COMBINING ACUTE ACCENT, COMBINING GRAVE ACCENT BELOW).","type":"text"},{"text":" ","type":"text"},{"text":"The combining classes of these scalars have the numeric values 0, 230, and","type":"text"},{"text":" ","type":"text"},{"text":"220, respectively. Sorting these scalars by their combining classes yields","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"\"\\u{0041}\\u{0316}\\u{0301}\""},{"text":", so two strings that differ only by the","type":"text"},{"text":" ","type":"text"},{"text":"ordering of those scalars would compare as equal:","type":"text"}]},{"type":"codeListing","code":["let aboveBeforeBelow = \"\\u{0041}\\u{0301}\\u{0316}\"","let belowBeforeAbove = \"\\u{0041}\\u{0316}\\u{0301}\"","print(aboveBeforeBelow == belowBeforeAbove)","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"heading","level":1,"text":"Named and Unnamed Combining Classes","anchor":"Named-and-Unnamed-Combining-Classes"},{"type":"paragraph","inlineContent":[{"text":"Canonical combining classes are defined in the Unicode Standard as","type":"text"},{"text":" ","type":"text"},{"text":"integers in the range ","type":"text"},{"type":"codeVoice","code":"0...254"},{"text":". For convenience, the standard assigns","type":"text"},{"text":" ","type":"text"},{"text":"symbolic names to a subset of these combining classes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"CanonicalCombiningClass"},{"text":" type conforms to ","type":"text"},{"type":"codeVoice","code":"RawRepresentable"},{"text":" with a","type":"text"},{"text":" ","type":"text"},{"text":"raw value of type ","type":"text"},{"type":"codeVoice","code":"UInt8"},{"text":". You can create instances of the type by using","type":"text"},{"text":" ","type":"text"},{"text":"the static members named after the symbolic names, or by using the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"init(rawValue:)"},{"text":" initializer.","type":"text"}]},{"type":"codeListing","code":["let overlayClass = Unicode.CanonicalCombiningClass(rawValue: 1)","let overlayClassIsOverlay = overlayClass == .overlay","\/\/ overlayClassIsOverlay == true"],"syntax":"swift"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/unicode\/canonicalcombiningclass"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"