ode":"CanonicalCombiningClass"},{"type":"text","text":" type conforms to "},{"type":"codeVoice","code":"RawRepresentable"},{"type":"text","text":" with a"},{"text":" ","type":"text"},{"text":"raw value of type ","type":"text"},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":". You can create instances of the type by using"},{"type":"text","text":" "},{"type":"text","text":"the static members named after the symbolic names, or by using the"},{"text":" ","type":"text"},{"type":"codeVoice","code":"init(rawValue:)"},{"type":"text","text":" initializer."}]},{"type":"codeListing","code":["let overlayClass = Unicode.CanonicalCombiningClass(rawValue: 1)","let overlayClassIsOverlay = overlayClass == .overlay","\/\/ overlayClassIsOverlay == true"],"syntax":"swift"}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"The classification of a scalar used in the Canonical Ordering Algorithm"},{"type":"text","text":" "},{"type":"text","text":"defined by the Unicode Standard."}],"variants":[{"paths":["\/documentation\/swift\/unicode\/canonicalcombiningclass"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Unicode/CanonicalCombiningClass/Comparable-Implementations":{"role":"collectionGroup","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/CanonicalCombiningClass\/Comparable-Implementations","title":"Comparable Implementations","abstract":[],"url":"\/documentation\/swift\/unicode\/canonicalcombiningclass\/comparable-implementations","type":"topic","kind":"article"},"doc://com.apple.Swift/documentation/Swift/Unicode/CanonicalCombiningClass/kanaVoicing":{"type":"topic","url":"\/documentation\/swift\/unicode\/canonicalcombiningclass\/kanavoicing","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kanaVoicing","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Unicode","kind":"typeIdentifier