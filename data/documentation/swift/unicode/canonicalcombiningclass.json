{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/CanonicalCombiningClass","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"CanonicalCombiningClass","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"inlineContent":[{"text":"Canonical combining classes are used by the ordering algorithm to","type":"text"},{"text":" ","type":"text"},{"text":"determine if two sequences of combining marks should be considered","type":"text"},{"text":" ","type":"text"},{"text":"canonically equivalent (that is, identical in interpretation). Two","type":"text"},{"text":" ","type":"text"},{"text":"sequences are canonically equivalent if they are equal when sorting the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"scalars in ascending order by their combining class."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, consider the sequence "},{"code":"\"\\u{0041}\\u{0301}\\u{0316}\"","type":"codeVoice"},{"text":" (LATIN","type":"text"},{"type":"text","text":" "},{"text":"CAPITAL LETTER A, COMBINING ACUTE ACCENT, COMBINING GRAVE ACCENT BELOW).","type":"text"},{"type":"text","text":" "},{"text":"The combining classes of these scalars have the numeric values 0, 230, and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"220, respectively. Sorting these scalars by their combining classes yields"},{"text":" ","type":"text"},{"code":"\"\\u{0041}\\u{0316}\\u{0301}\"","type":"codeVoice"},{"text":", so two strings that differ only by the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"ordering of those scalars would compare as equal:"}]},{"code":["let aboveBeforeBelow = \"\\u{0041}\\u{0301}\\u{0316}\"","let belowBeforeAbove = \"\\u{0041}\\u{0316}\\u{0301}\"","print(aboveBeforeBelow == belowBeforeAbove)","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Named and Unnamed Combining Classes","anchor":"Named-and-Unnamed-Combining-Classes","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"Canonical combining classes are defined in the Unicode Standard as"},{"type":"text","text":" "},{"type":"text","text":"integers in the range "},{"type":"codeVoice","code":"0...254"},{"text":". For convenience, the standard assigns","type":"text"},{"type":"text","text":" "},{"text":"symbolic names to a subset of these combining classes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"CanonicalCombiningClass","type":"codeVoice"},{"type":"text","text":" type conforms to "},{"code":"RawRepresentable","type":"codeVoice"},{"type":"text","text":" with a"},{"type":"text","text":" "},{"text":"raw value of type ","type":"text"},{"code":"UInt8","type":"codeVoice"},{"type":"text","text":". You can create instances of the type by using"},{"text":" ","type":"text"},{"text":"the static members named after the symbolic names, or by using the","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"init(rawValue:)"},{"text":" initializer.","type":"text"}]},{"syntax":"swift","code":["let overlayClass = Unicode.CanonicalCombiningClass(rawValue: 1)","let overlayClassIsOverlay = overlayClass == .overlay","\/\/ overlayClassIsOverlay == true"],"type":"codeListing"}]}],"sections":[],"variants":[{"paths":["\/documentation\/swift\/unicode\/canonicalcombiningclass"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode"]]},"metadata":{"symbolKind":"struct","platforms":[{"introducedAt":"8.0","beta":false,"unavailable":false,"name":"iOS","deprecated":fals