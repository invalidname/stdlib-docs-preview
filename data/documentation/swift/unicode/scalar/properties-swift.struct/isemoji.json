{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/Scalar\/Properties-swift.struct\/isEmoji"},"kind":"symbol","abstract":[{"text":"A Boolean value indicating whether the scalar has an emoji","type":"text"},{"text":" ","type":"text"},{"text":"presentation, whether or not it is the default.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEmoji","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"This property is true for scalars that are rendered as emoji by default","type":"text"},{"text":" ","type":"text"},{"text":"and also for scalars that have a non-default emoji rendering when followed","type":"text"},{"text":" ","type":"text"},{"text":"by U+FE0F VARIATION SELECTOR-16. This includes some scalars that are not","type":"text"},{"text":" ","type":"text"},{"text":"typically considered to be emoji:","type":"text"}],"type":"paragraph"},{"code":["let scalars: [Unicode.Scalar] = [\"😎\", \"$\", \"0\"]","for s in scalars {","    print(s, \"-->\", s.properties.isEmoji)","}","\/\/ 😎 --> true","\/\/ $ --> false","\/\/ 0 --> true"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The final result is true because the ASCII digits have non-default emoji","type":"text"},{"text":" ","type":"text"},{"text":"presentations; some platforms render these with an alternate appearance.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Because of this behavior, testing ","type":"text"},{"code":"isEmoji","type":"codeVoice"},{"text":" alone on a single scalar is","type":"text"},{"text":" ","type":"text"},{"text":"insufficient to determine if a unit of text is rendered as an emoji; a","type":"text"},{"text":" ","type":"text"},{"text":"correct test requires inspecting multiple scalars in a ","type":"text"},{"code":"Character","type":"codeVoice"},{"text":". In","type":"text"},{"text":" ","type":"text"},{"text":"addition to checking whether the base scalar has ","type":"text"},{"code":"isEmoji == true","type":"codeVoice"},{"text":", you","type":"text"},{"text":" ","type":"text"},{"text":"must also check its default presentation (see ","type":"text"},{"code":"isEmojiPresentation","type":"codeVoice"},{"text":") and","type":"text"},{"text":" ","type":"text"},{"text":"determine whether it is followed by a variation selector that would modify","type":"text"},{"text":" ","type":"text"},{"text":"the presentation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This property corresponds to the “Emoji” property in the","type":"text"},{"text":" ","type":"text"},{"identifier":"http:\/\/www.unicode.org\/versions\/latest\/","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/Scalar","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/Scalar\/Properties-swift.struct"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/unicode\/scalar\/properties-swift.struct\/isemoji"]}],"metadata":{"roleHeading":"Instance Property","platforms":[{"deprecated":false,"introducedAt":"8.0","unavailable":false,"beta":false,"name":"iOS"},{"deprecated":false,"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iPadOS"},{"deprecated":false,"introducedAt":"13.0","unav