,{"text":" ","type":"text"},{"text":"correct test requires inspecting multiple scalars in a ","type":"text"},{"type":"codeVoice","code":"Character"},{"text":". In","type":"text"},{"text":" ","type":"text"},{"text":"addition to checking whether the base scalar has ","type":"text"},{"type":"codeVoice","code":"isEmoji == true"},{"text":", you","type":"text"},{"text":" ","type":"text"},{"text":"must also check its default presentation (see ","type":"text"},{"type":"codeVoice","code":"isEmojiPresentation"},{"text":") and","type":"text"},{"text":" ","type":"text"},{"text":"determine whether it is followed by a variation selector that would modify","type":"text"},{"text":" ","type":"text"},{"text":"the presentation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This property corresponds to the “Emoji” property in the","type":"text"},{"text":" ","type":"text"},{"identifier":"http:\/\/www.unicode.org\/versions\/latest\/","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/Scalar","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/Scalar\/Properties-swift.struct"]]},"sections":[],"kind":"symbol","metadata":{"modules":[{"name":"Swift"}],"title":"isEmoji","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEmoji"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol","externalID":"s:s7UnicodeO6ScalarV10PropertiesV7isEmojiSbvp","platforms":[{"name":"iOS","introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false},{"name":"iPadOS","introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false},{"name":"Mac Catalyst","introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false},{"name":"macOS","introducedAt":"10.10",