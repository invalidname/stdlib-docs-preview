{"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/Scalar\/Properties-swift.struct\/isEmoji","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEmoji"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"This property is true for scalars that are rendered as emoji by default"},{"type":"text","text":" "},{"type":"text","text":"and also for scalars that have a non-default emoji rendering when followed"},{"type":"text","text":" "},{"type":"text","text":"by U+FE0F VARIATION SELECTOR-16. This includes some scalars that are not"},{"type":"text","text":" "},{"type":"text","text":"typically considered to be emoji:"}],"type":"paragraph"},{"syntax":"swift","code":["let scalars: [Unicode.Scalar] = [\"😎\", \"$\", \"0\"]","for s in scalars {","    print(s, \"-->\", s.properties.isEmoji)","}","\/\/ 😎 --> true","\/\/ $ --> false","\/\/ 0 --> true"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The final result is true because the ASCII digits have non-default emoji"},{"type":"text","text":" "},{"type":"text","text":"presentations; some platforms render these with an alternate appearance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because of this behavior, testing "},{"type":"codeVoice","code":"isEmoji"},{"type":"text","text":" alone on a single scalar is"},{"type":"text","text":" "},{"type":"text","text":"insufficient to determine if a unit of text is rendered as an emoji; a"},{"type":"text","text":" "},{"type":"text","text":"correct test requires inspecting multiple scalars in a "},{"type":"codeVoice","code":"Character"},{"type":"text","text":". In"},{"type":"text","text":" "},{"type":"text","text":"addition to checking whether the base scalar has "},{"type":"codeVoice","code":"isEmoji == true"},{"type":"text","text":", you"},{"type":"text","text":" "},{"type":"text","text":"must also check its default presentation (see "},{"type":"codeVoice","code":"isEmojiPresentation"},{"type":"text","text":") and"},{"type":"text","text":" "},{"type":"text","text":"determine whether it is followed by a variation selector that would modify"},{"type":"text","text":" "},{"type":"text","text":"the presentation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This property corresponds to the “Emoji” property in the"},{"type":"text","text":" "},{"type":"reference","identifier":"http:\/\/www.unicode.org\/versions\/latest\/","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"metadata":{"role":"symbol","roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEmoji","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"symbolKind":"property","title":"isEmoji","modules":[{"name":"Swift"}],"extendedModule":"Swift","externalID":"s:s7UnicodeO6ScalarV10PropertiesV7isEmojiSbvp","platforms":[{"introducedAt":"8.0","deprecated":false,"unavailable":false,"name":"iOS","beta":false},{"introducedAt":"8.0","deprecated":false,"unavailable":false,"name":"iPadOS","beta":false},{"introducedAt":"13.0","deprecated":false,"unavailable":false,"name":"Mac Catalyst","beta":false},{"introducedAt":"10.10","deprecated":false,"unavailable":false,"name":"macOS","beta":false},{"introducedAt":"9.0","deprecated":false,"unavailable":false,"name":"tvOS","beta":false},{"introducedAt":"1.0","deprecated":false,"unavailable":false,"name":"vision