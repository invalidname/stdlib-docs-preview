{"metadata":{"platforms":[{"beta":false,"introducedAt":"8.0","deprecated":false,"name":"iOS","unavailable":false},{"beta":false,"introducedAt":"8.0","deprecated":false,"name":"iPadOS","unavailable":false},{"beta":false,"introducedAt":"13.0","deprecated":false,"name":"Mac Catalyst","unavailable":false},{"beta":false,"introducedAt":"10.10","deprecated":false,"name":"macOS","unavailable":false},{"beta":false,"introducedAt":"9.0","deprecated":false,"name":"tvOS","unavailable":false},{"introducedAt":"1.0","unavailable":false,"beta":false,"name":"visionOS","deprecated":false},{"beta":false,"introducedAt":"2.0","deprecated":false,"name":"watchOS","unavailable":false}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"isJoinControl","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"roleHeading":"Instance Property","title":"isJoinControl","externalID":"s:s7UnicodeO6ScalarV10PropertiesV13isJoinControlSbvp","role":"symbol","extendedModule":"Swift","modules":[{"name":"Standard Library"}],"symbolKind":"property"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isJoinControl","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are two scalars for which this property is "},{"type":"codeVoice","code":"true"},{"type":"text","text":":"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When U+200C ZERO WIDTH NON-JOINER is inserted between two characters, it"},{"text":" ","type":"text"},{"type":"text","text":"directs the rendering engine to render them separately\/disconnected when"},{"text":" ","type":"text"},{"type":"text","text":"it might otherwise render them as a ligature. For example, a rendering"},{"text":" ","type":"text"},{"text":"engine might display “fl” in English as a connected glyph; inserting the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"zero width non-joiner would force them to be rendered as disconnected"},{"type":"text","text":" "},{"type":"text","text":"glyphs."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"When U+200D ZERO WIDTH JOINER is inserted between two characters, it"},{"text":" ","type":"text"},{"text":"directs the rendering engine to render them as a connected glyph when it","type":"text"},{"type":"text","text":" "},{"text":"would otherwise render them independently. The zero width joiner is also","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"used to construct complex emoji from sequences of base emoji characters."},{"text":" ","type":"text"},{"type":"text","text":"For example, the various “family” emoji are encoded as sequences of man,"},{"type":"text","text":" "},{"type":"text","text":"woman, or child emoji that are interleaved with zero width joiners."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"This property corresponds to the “Join_Control” property in the","type":"text"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"http:\/\/www.unicode.org\/versions\/latest\/"},{"type":"text","text":"."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/unicode\/scalar\/properties-swift.struct\/isjoincontrol"]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/Scalar\/