{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/Scalar","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/Scalar\/Properties-swift.struct"]]},"abstract":[{"text":"A Boolean value indicating whether the scalar is a format control","type":"text"},{"text":" ","type":"text"},{"text":"character that has a specific function in controlling cursive joining and","type":"text"},{"text":" ","type":"text"},{"text":"ligation.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/Scalar\/Properties-swift.struct\/isJoinControl","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isJoinControl","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"There are two scalars for which this property is "},{"code":"true","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"When U+200C ZERO WIDTH NON-JOINER is inserted between two characters, it","type":"text"},{"text":" ","type":"text"},{"text":"directs the rendering engine to render them separately\/disconnected when","type":"text"},{"text":" ","type":"text"},{"text":"it might otherwise render them as a ligature. For example, a rendering","type":"text"},{"text":" ","type":"text"},{"text":"engine might display “fl”