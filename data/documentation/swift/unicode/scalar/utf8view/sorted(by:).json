nicode","kind":"identifier"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"Unicode","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode","abstract":[{"type":"text","text":"A namespace for Unicode utilities."}]},"Swift-PageImage-card.png":{"type":"image","identifier":"Swift-PageImage-card.png","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png"}],"alt":"An orange Swift logo on a gradient background."},"doc://com.apple.Swift/documentation/Swift/Bool":{"abstract":[{"text":"A value type whose instances are either ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}],"navigatorTitle":[{"text":"Bool","kind":"identifier"}],"type":"topic","title":"Bool","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Bool","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","url":"\/documentation\/swift\/bool","role":"symbol"},"doc://com.apple.Swift/documentation/Swift/Sequence/Element":{"abstract":[{"text":"A type representing the sequence’s elements.","type":"text"}],"type":"topic","title":"Element","kind":"symbol","required":true,"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence\/Element","url":"\/documentation\/swift\/sequence\/element","role":"symbol"},"doc://com.apple.Swift/documentation/Swift/Unicode/Scalar/UTF8View/sorted(by:)":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Returns the elements of the sequence, sorted using the given predicate as"},{"type":"text","text":" "},{"text":"th