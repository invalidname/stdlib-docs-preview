ntent":[{"inlineContent":[{"text":"An iterator of code units to be decoded. ","type":"text"},{"type":"codeVoice","code":"input"},{"type":"text","text":" must be"},{"text":" ","type":"text"},{"type":"text","text":"the same iterator instance in repeated calls to this method. Do not"},{"type":"text","text":" "},{"text":"advance the iterator or any copies of the iterator outside this","type":"text"},{"text":" ","type":"text"},{"text":"method.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UnicodeDecodingResult"},{"type":"text","text":" instance, representing the next"},{"type":"text","text":" "},{"type":"text","text":"Unicode scalar, an indication of an error, or an indication that the"},{"type":"text","text":" "},{"type":"text","text":"UTF sequence has been fully decoded."}]}]},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To decode a code unit sequence completely, call this method repeatedly"},{"type":"text","text":" "},{"text":"until it returns ","type":"text"},{"code":"UnicodeDecodingResult.emptyInput","type":"codeVoice"},{"text":". Checking that the","type":"text"},{"type":"text","text":" "},{"text":"iterator was exhausted is not sufficient, because the decoder can store","type":"text"},{"type":"text","text":" "},{"type":"text","text":"buffered data from the input iterator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because of buffering, it is impossible to find the corresponding position"},{"type":"text","text":" "},{"type":"text","text":"in the iterator for a given returned "},{"type":"codeVoice","code":"Unicode.Scalar"},{"type":"text","text":" or an error."}]},{"type":"paragraph","inlineContent":[{"text":"The following example decodes the UTF-16 encoded bytes of a string into an","type":"text"},{"text":" ","type":"text"},{"text":"array of ","type":"text"},{"type":"codeVoice","code":"Unicode.Scalar"},{"type":"text","text":" instances. This is a demonstration only—if"},{"type":"text","text":" "},{"type":"text","text":"you need the Unicode scalar representation of a string, use its"},{"type":"text","text":" "},{"code":"unicodeScalars","type":"codeVoice"},{"type":"text","text":" view."}]},{"type":"codeListing","syntax":"swift","code":["let str = \"✨Unicode✨\"","print(Array(str.utf16))","\/\/ Prints \"[10024, 85, 110, 105, 99, 111, 100, 101, 10024]\"","","var codeUnitIterator = str.utf16.makeIterator()","var scalars: [Unicode.Scalar] = []","var utf16Decoder = UTF16()","Decode: while true {","    switch utf16Decoder.decode(&codeUnitIterator) {","    case .scalarValue(let v): scalars.append(v)","    case .emptyInput: break Decode","    case .error:","        print(\"Decoding error\")","        break Decode","    }","}","print(scalars)","\/\/ Prints \"[\"\\u{2728}\", \"U\", \"n\", \"i\", \"c\", \"o\", \"d\", \"e\", \"\\u{2728}\"]\""]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/unicode\/utf16\/decode(_:)-swift.method"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF16\/decode(_:)-swift.method","interfaceLanguage":"swift"},"metadata":{"title":"decode(_:)","symbolKind":"method","platforms":[{"introducedAt":"8.0","unavailable":false,"deprecated":false,"beta":false,"name":"iOS"},{"introducedAt":"8.0","unavailable":false,"deprecated":false,"beta":false,"name":"iPadOS"},{"introducedAt":"13.0","unavailable":false,"deprecated":false,"beta":false,"name":"Mac Catalyst"},{"introducedAt":"10.10","unavailable":false,"deprecated":false,"beta":false,"name":"macOS"},{"introducedAt":"9.0","unavailable":false,"deprecated":false,"beta":false,"name":"tvOS"},{"introducedAt":"1.0","una