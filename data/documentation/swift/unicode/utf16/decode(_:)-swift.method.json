,"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF16"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"decode","kind":"identifier"},{"text":"<","kind":"text"},{"text":"I","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"input","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"I","kind":"typeIdentifier","preciseIdentifier":"s:s7UnicodeO5UTF16O6decodeys0A14DecodingResultOxzStRzs6UInt16V7ElementRtzlF1IL_xmfp"},{"text":") -> ","kind":"text"},{"text":"UnicodeDecodingResult","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnicodeDecodingResult","kind":"typeIdentifier","preciseIdentifier":"s:s21UnicodeDecodingResultO"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"I","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"IteratorProtocol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/IteratorProtocol","kind":"typeIdentifier","preciseIdentifier":"s:St"},{"text":", ","kind":"text"},{"text":"I","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/IteratorProtocol\/Element","kind":"typeIdentifier","preciseIdentifier":"s:St7ElementQa"},{"text":" == ","kind":"text"},{"text":"UInt16","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt16","kind":"typeIdentifier","preciseIdentifier":"s:s6UInt16V"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"input","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An iterator of code units to be decoded. "},{"type":"codeVoice","code":"input"},{"type":"text","text":" must be"},{"type":"text","text":" "},{"type":"text","text":"the same iterator instance in repeated calls to this method. Do not"},{"type":"text","text":" "},{"type":"text","text":"advance the iterator or any copies of the iterator outside this"},{"type":"text","text":" "},{"type":"text","text":"method."}]}]}]},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UnicodeDecodingResult"},{"type":"text","text":" instance, representing the next"},{"type":"text","text":" "},{"type":"text","text":"Unicode scalar, an indication of an error, or an indication that the"},{"type":"text","text":" "},{"type":"text","text":"UTF sequence has been fully decoded."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To decode a code unit sequence completely, call this method repeatedly"},{"type":"text","text":" "},{"type":"text","text":"until it returns "},{"type":"codeVoice","code":"UnicodeDecodingResult.emptyInput"},{"type":"text","text":". Checking that the"},{"type":"text","text":" "},{"type":"text","text":"iterator was exhausted is not sufficient, because the decoder can store"},{"type":"text","text":" "},{"type":"text","text":"buffered data from the input iterator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because of buffering, it is impossible to find the corresponding position"},{"type":"text","text":" "},{"type":"text","text":"in the iterator for a given returned "},{"type":"codeVoice","code":"Unicode.Scalar"},{"type":"text","text":" or an error."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example decodes the UTF-16 encoded bytes of a string into an"},{"type":"text","text":" "},{"type":"text","text":"array of "},{"type":"codeVoice","code":"Unicode.Scalar"},{"type":"text","text":" instances. This is a demonstration only—if"},{"type":"text","text":" "},{"type":"text","text":"you need the Unicode scalar representation of a string, use its"},{"type":"text","text":" "},{"type":"codeVoice","code":"unicodeScalars"},{"type":"text","text":" view."}]},{"type":"codeListing","syntax":"swift","code":["let str = \"✨Unicode✨\"","print(Array(str.utf16))","\/\/ Prints \"[10024, 85, 110, 105, 99, 111, 100, 101, 10024]\"","","var codeUnitIterator = str.utf16.makeIterator()","var scalars: [Unicode.Scalar] = []","var utf16Decoder = UTF16()","Decode: while true {","    switch utf16Decoder.decode(&codeUnitIterator) {","    case .scalarValue(let v): scalars.append(v)","    case .emptyInput: break Decode","    case .error:","        print(\"Decoding error\")","        break Decode","    }","}","print(scalars)","\/\/ Prints \"[\"\\u{2728}\", \"U\", \"n\", \"i\", \"c\", \"o\", \"d\", \"e\", \"\\u{2728}\"]\""]}],"kind":"content"}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/UnicodeDecodingResult":{"url":"\/documentation\/swift\/unicodedecodingresult","kind":"symbol","abstract":[{"type":"text","text":"The result of one Unicode decoding step."}],"navigatorTitle":[{"text":"UnicodeDecodingResult","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnicodeDecodingResult","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnicodeDecodingResult","kind":"identifier"}],"title":"UnicodeDecodingResult"},"doc://com.apple.Swift/documentation/Swift/Unicode/UTF16/decode(_:)-swift.method":{"url":"\/documentation\/swift\/unicode\/utf16\/decode(_:)-swift.method","kind":"symbol","abstract":[{"type":"text","text":"Starts or continues decoding a UTF-16 sequence."}],"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF16\/decode(_:)-swift.method","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":