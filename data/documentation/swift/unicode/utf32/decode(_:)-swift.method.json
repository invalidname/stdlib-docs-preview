text":" "},{"type":"text","text":"method."}]}],"name":"input"}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UnicodeDecodingResult"},{"type":"text","text":" instance, representing the next"},{"type":"text","text":" "},{"type":"text","text":"Unicode scalar, an indication of an error, or an indication that the"},{"type":"text","text":" "},{"type":"text","text":"UTF sequence has been fully decoded."}]}],"kind":"content"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To decode a code unit sequence completely, call this method repeatedly"},{"type":"text","text":" "},{"type":"text","text":"until it returns "},{"type":"codeVoice","code":"UnicodeDecodingResult.emptyInput"},{"type":"text","text":". Checking that the"},{"type":"text","text":" "},{"type":"text","text":"iterator was exhausted is not sufficient, because the decoder can store"},{"type":"text","text":" "},{"type":"text","text":"buffered data from the input iterator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because of buffering, it is impossible to find the corresponding position"},{"type":"text","text":" "},{"type":"text","text":"in the iterator for a given returned "},{"type":"codeVoice","code":"Unicode.Scalar"},{"type":"text","text":" or an error."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example decodes the UTF-16 encoded bytes of a string"},{"type":"text","text":" "},{"type":"text","text":"into an array of "},{"type":"codeVoice","code":"Unicode.Scalar"},{"type":"text","text":" instances. This is a demonstration"},{"type":"text","text":" "},{"type":"text","text":"only—if you need the Unicode scalar representation of a string, use"},{"type":"text","text":" "},{"type":"text","text":"its "},{"type":"codeVoice","code":"unicodeScalars"},{"type":"text","text":" view."}]},{"type":"codeListing","code":["\/\/ UTF-32 representation of \"✨Unicode✨\"","let codeUnits: [UTF32.CodeUnit] =","        [10024, 85, 110, 105, 99, 111, 100, 101, 10024]","","var codeUnitIterator = codeUnits.makeIterator()","var scalars: [Unicode.Scalar] = []","var utf32Decoder = UTF32()","Decode: while true {","    switch utf32Decoder.decode(&codeUnitIterator) {","    case .scalarValue(let v): scalars.append(v)","    case .emptyInput: break Decode","    case .error:","        print(\"Decoding error\")","        break Decode","    }","}","print(scalars)","\/\/ Prints \"[\"\\u{2728}\", \"U\", \"n\", \"i\", \"c\", \"o\", \"d\", \"e\", \"\\u{2728}\"]\""],"syntax":"swift"}],"kind":"content"}],"sections":[],"abstract":[{"text":"Starts or continues decoding a UTF-32 sequence.","type":"text"}],"variants":[{"paths":["\/documentation\/swift\/unicode\/utf32\/decode(_:)-swift.method"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Unicode":{"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Unicode","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"Unicode","kind":"identifier"}],"abstract":[{"type":"text","text":"A namespace for Unicode utilities."}],"type":"topic","title":"Unicode","url":"\/documentation\/swift\/unicode","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode"},"doc://com.apple.Swift/documentation/Swift/IteratorProtocol":{"navigatorTitle":[{"text":"IteratorProtocol","kind":"identifier"}],"role":"symbol","type":"topic","title":"IteratorProtocol","abstract":[{"type":"text","text":"A type that supplies the values of a sequence one at a time."}],"kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/IteratorProtocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IteratorProtocol","kind":"identifier"}],"url":"\/docume