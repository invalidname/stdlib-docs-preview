e"},{"type":"text","text":" "},{"type":"text","text":"the same iterator instance in repeated calls to this method. Do not"},{"type":"text","text":" "},{"type":"text","text":"advance the iterator or any copies of the iterator outside this"},{"type":"text","text":" "},{"type":"text","text":"method."}]}]}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"UnicodeDecodingResult","type":"codeVoice"},{"text":" instance, representing the next","type":"text"},{"text":" ","type":"text"},{"text":"Unicode scalar, an indication of an error, or an indication that the","type":"text"},{"text":" ","type":"text"},{"text":"UTF sequence has been fully decoded.","type":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"To decode a code unit sequence completely, call this method repeatedly","type":"text"},{"text":" ","type":"text"},{"text":"until it returns ","type":"text"},{"code":"UnicodeDecodingResult.emptyInput","type":"codeVoice"},{"text":". Checking that the","type":"text"},{"text":" ","type":"text"},{"text":"iterator was exhausted is not sufficient, because the decoder can store","type":"text"},{"text":" ","type":"text"},{"text":"buffered data from the input iterator.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because of buffering, it is impossible to find the corresponding position","type":"text"},{"text":" ","type":"text"},{"text":"in the iterator for a given returned ","type":"text"},{"code":"Unicode.Scalar","type":"codeVoice"},{"text":" or an error.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example decodes the UTF-16 encoded bytes of a string","type":"text"},{"text":" ","type":"text"},{"text":"into an array of ","type":"text"},{"code":"Unicode.Scalar","type":"codeVoice"},{"text":" instances. This is a demonstration","type":"text"},{"text":" ","type":"text"},{"text":"only—if you need the Unicode scalar representation of a string, use","type":"text"},{"text":" ","type":"text"},{"text":"its ","type":"text"},{"code":"unicodeScalars","type":"codeVoice"},{"text":" view.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ UTF-32 representation of \"✨Unicode✨\"","let codeUnits: [UTF32.CodeUnit] =","        [10024, 85, 110, 105, 99, 111, 100, 101, 10024]","","var codeUnitIterator = codeUnits.makeIterator()","var scalars: [Unicode.Scalar] = []","var utf32Decoder = UTF32()","Decode: while true {","    switch utf32Decoder.decode(&codeUnitIterator) {","    case .scalarValue(let v): scalars.append(v)","    case .emptyInput: break Decode","    case .error:","        print(\"Decoding error\")","        break Decode","    }","}","print(scalars)","\/\/ Prints \"[\"\\u{2728}\", \"U\", \"n\", \"i\", \"c\", \"o\", \"d\", \"e\", \"\\u{2728}\"]\""]}]}],"references":{"doc://com.apple.Swift/documentation/Swift/IteratorProtocol":{"abstract":[{"text":"A type that supplies the values of a sequence one at a time.","type":"text"}],"title":"IteratorProtocol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/IteratorProtocol","url":"\/documentation\/swift\/iteratorprotocol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"IteratorProtocol"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"IteratorProtocol"}]},"doc://com.apple.Swift/documentation/Swift/UInt32":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt32","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UInt32"}],"url":"\/documentation\/swift\/uint32","type":"topic","abstract":[{"text":"A 32-bit unsigned integer value","type":"text"},{"text":" ","type":"text"},{"text":"type.","type":"text"}],"role":"symbol","navigatorTitle"