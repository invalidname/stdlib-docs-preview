t"},{"type":"text","text":" "},{"type":"text","text":"Unicode scalar, an indication of an error, or an indication that the"},{"type":"text","text":" "},{"type":"text","text":"UTF sequence has been fully decoded."}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To decode a code unit sequence completely, call this method repeatedly"},{"type":"text","text":" "},{"type":"text","text":"until it returns "},{"type":"codeVoice","code":"UnicodeDecodingResult.emptyInput"},{"type":"text","text":". Checking that the"},{"type":"text","text":" "},{"type":"text","text":"iterator was exhausted is not sufficient, because the decoder can store"},{"type":"text","text":" "},{"type":"text","text":"buffered data from the input iterator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because of buffering, it is impossible to find the corresponding position"},{"type":"text","text":" "},{"type":"text","text":"in the iterator for a given returned "},{"type":"codeVoice","code":"Unicode.Scalar"},{"type":"text","text":" or an error."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example decodes the UTF-16 encoded bytes of a string"},{"type":"text","text":" "},{"type":"text","text":"into an array of "},{"type":"codeVoice","code":"Unicode.Scalar"},{"type":"text","text":" instances. This is a demonstration"},{"type":"text","text":" "},{"type":"text","text":"only—if you need the Unicode scalar representation of a string, use"},{"type":"text","text":" "},{"type":"text","text":"its "},{"type":"codeVoice","code":"unicodeScalars"},{"type":"text","text":" view."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ UTF-32 representation of \"✨Unicode✨\"","let codeUnits: [UTF32.CodeUnit] =","        [10024, 85, 110, 105, 99, 111, 100, 101, 10024]","","var codeUnitIterator = codeUnits.makeIterator()","var scalars: [Unicode.Scalar] = []","var utf32Decoder = UTF32()","Decode: while true {","    switch utf32Decoder.decode(&codeUnitIterator) {","    case .scalarValue(let v): scalars.append(v)","    case .emptyInput: break Decode","    case .error:","        print(\"Decoding error\")","        break Decode","    }","}","print(scalars)","\/\/ Prints \"[\"\\u{2728}\", \"U\", \"n\", \"i\", \"c\", \"o\", \"d\", \"e\", \"\\u{2728}\"]\""]}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF32\/decode(_:)-swift.method","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Starts or continues decoding a UTF-32 sequence."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF32"]]},"variants":[{"paths":["\/documentation\/swift\/unicode\/utf32\/decode(_:)-swift.method"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/IteratorProtocol/Element":{"type":"topic","kind":"symbol","title":"Element","role":"symbol","required":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/IteratorProtocol\/Element","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Element"}],"url":"\/documentation\/swift\/iteratorprotocol\/element","abstract":[{"text":"The type of element traversed by the iterator.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/UInt32":{"title":"UInt32","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UInt32","kind":"identifier"}],"url":"\/documentation\/swift\/uint32","kind":"symbol","abstract":[{"type":"text","text":"A 32-bit unsigned integer value"},{"type":"text","text":" "},{"type":"text","text":"type."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt32","role":"symbol","navigatorTitle":[{"text":"UInt32"