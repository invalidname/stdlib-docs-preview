t"},{"text":"its ","type":"text"},{"code":"unicodeScalars","type":"codeVoice"},{"text":" view.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ UTF-32 representation of \"✨Unicode✨\"","let codeUnits: [UTF32.CodeUnit] =","        [10024, 85, 110, 105, 99, 111, 100, 101, 10024]","","var codeUnitIterator = codeUnits.makeIterator()","var scalars: [Unicode.Scalar] = []","var utf32Decoder = UTF32()","Decode: while true {","    switch utf32Decoder.decode(&codeUnitIterator) {","    case .scalarValue(let v): scalars.append(v)","    case .emptyInput: break Decode","    case .error:","        print(\"Decoding error\")","        break Decode","    }","}","print(scalars)","\/\/ Prints \"[\"\\u{2728}\", \"U\", \"n\", \"i\", \"c\", \"o\", \"d\", \"e\", \"\\u{2728}\"]\""]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF32\/decode(_:)-swift.method"},"sections":[],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/Unicode":{"url":"\/documentation\/swift\/unicode","type":"topic","kind":"symbol","title":"Unicode","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Unicode","kind":"identifier"}],"abstract":[{"type":"text","text":"A namespace for Unicode utilities."}],"navigatorTitle":[{"text":"Unicode","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode","role":"symbol"},"doc://com.apple.Swift/documentation/Swift/IteratorProtocol":{"title":"IteratorProtocol","url":"\/documentation\/swift\/iteratorprotocol","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IteratorProtocol","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/IteratorProtocol","role":"symbol","abstract":[{"text":"A type that supplies the values of a sequence one at a time.","type":"text"}],"navigatorTitle":[{"text":"IteratorProtocol"