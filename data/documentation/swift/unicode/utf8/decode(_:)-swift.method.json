cation that the","type":"text"},{"type":"text","text":" "},{"text":"UTF sequence has been fully decoded.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"To decode a code unit sequence completely, call this method repeatedly","type":"text"},{"text":" ","type":"text"},{"text":"until it returns ","type":"text"},{"type":"codeVoice","code":"UnicodeDecodingResult.emptyInput"},{"text":". Checking that the","type":"text"},{"text":" ","type":"text"},{"text":"iterator was exhausted is not sufficient, because the decoder can store","type":"text"},{"text":" ","type":"text"},{"text":"buffered data from the input iterator.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Because of buffering, it is impossible to find the corresponding position","type":"text"},{"text":" ","type":"text"},{"text":"in the iterator for a given returned ","type":"text"},{"type":"codeVoice","code":"Unicode.Scalar"},{"text":" or an error.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example decodes the UTF-8 encoded bytes of a string into an","type":"text"},{"type":"text","text":" "},{"type":"text","text":"array of "},{"type":"codeVoice","code":"Unicode.Scalar"},{"type":"text","text":" instances. This is a demonstration only—if"},{"type":"text","text":" "},{"type":"text","text":"you need the Unicode scalar representation of a string, use its"},{"type":"text","text":" "},{"code":"unicodeScalars","type":"codeVoice"},{"type":"text","text":" view."}],"type":"paragraph"},{"syntax":"swift","code":["let str = \"✨Unicode✨\"","print(Array(str.utf8))","\/\/ Prints \"[226, 156, 168, 85, 110, 105, 99, 111, 100, 101, 226, 156, 168]\"","","var bytesIterator = str.utf8.makeIterator()","var scalars: [Unicode.Scalar] = []","var utf8Decoder = UTF8()","Decode: while true {","    switch utf8Decoder.decode(&bytesIterator) {","    case .scalarValue(let v): scalars.append(v)","    case .emptyInput: break Decode","    case .error:","        print(\"Decoding error\")","        break Decode","    }","}","print(scalars)","\/\/ Prints \"[\"\\u{2728}\", \"U\", \"n\", \"i\", \"c\", \"o\", \"d\", \"e\", \"\\u{2728}\"]\""],"type":"codeListing"}],"kind":"content"}],"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Starts or continues decoding a UTF-8 sequence."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/unicode\/utf8\/decode(_:)-swift.method"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF8\/decode(_:)-swift.method","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF8"]]},"references":{"doc://com.apple.Swift/documentation/Swift/Unicode/UTF8":{"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF8","abstract":[],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"UTF8"}],"kind":"symbol","type":"topic","title":"Unicode.UTF8","url":"\/documentation\/swift\/unicode\/utf8","navigatorTitle":[{"kind":"identifier","text":"UTF8"}]},"doc://com.apple.Swift/documentation/Swift/IteratorProtocol":{"kind":"symbol","title":"IteratorProtocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IteratorProtocol","kind":"identifier"}],"url":"\/documentation\/swift\/iteratorprotocol","navigatorTitle":[{"text":"IteratorProtocol","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that supplies the values of a sequence one at a time."}],"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/IteratorProtocol","role":"symbol"},"doc://com.apple.Swift/documentation/Swift/IteratorProtocol/Element":{"ident