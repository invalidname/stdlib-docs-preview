},{"type":"text","text":"Unicode scalar, an indication of an error, or an indication that the"},{"type":"text","text":" "},{"type":"text","text":"UTF sequence has been fully decoded."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"To decode a code unit sequence completely, call this method repeatedly"},{"type":"text","text":" "},{"type":"text","text":"until it returns "},{"code":"UnicodeDecodingResult.emptyInput","type":"codeVoice"},{"type":"text","text":". Checking that the"},{"type":"text","text":" "},{"type":"text","text":"iterator was exhausted is not sufficient, because the decoder can store"},{"type":"text","text":" "},{"type":"text","text":"buffered data from the input iterator."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because of buffering, it is impossible to find the corresponding position"},{"type":"text","text":" "},{"type":"text","text":"in the iterator for a given returned "},{"code":"Unicode.Scalar","type":"codeVoice"},{"type":"text","text":" or an error."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example decodes the UTF-8 encoded bytes of a string into an"},{"type":"text","text":" "},{"type":"text","text":"array of "},{"code":"Unicode.Scalar","type":"codeVoice"},{"type":"text","text":" instances. This is a demonstration only—if"},{"type":"text","text":" "},{"type":"text","text":"you need the Unicode scalar representation of a string, use its"},{"type":"text","text":" "},{"code":"unicodeScalars","type":"codeVoice"},{"type":"text","text":" view."}],"type":"paragraph"},{"code":["let str = \"✨Unicode✨\"","print(Array(str.utf8))","\/\/ Prints \"[226, 156, 168, 85, 110, 105, 99, 111, 100, 101, 226, 156, 168]\"","","var bytesIterator = str.utf8.makeIterator()","var scalars: [Unicode.Scalar] = []","var utf8Decoder = UTF8()","Decode: while true {","    switch utf8Decoder.decode(&bytesIterator) {","    case .scalarValue(let v): scalars.append(v)","    case .emptyInput: break Decode","    case .error:","        print(\"Decoding error\")","        break Decode","    }","}","print(scalars)","\/\/ Prints \"[\"\\u{2728}\", \"U\", \"n\", \"i\", \"c\", \"o\", \"d\", \"e\", \"\\u{2728}\"]\""],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF8\/decode(_:)-swift.method","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/unicode\/utf8\/decode(_:)-swift.method"]}],"abstract":[{"text":"Starts or continues decoding a UTF-8 sequence.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF8"]]},"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/Unicode/UTF8":{"title":"Unicode.UTF8","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode\/UTF8","navigatorTitle":[{"text":"UTF8","kind":"identifier"}],"role":"symbol","abstract":[],"kind":"symbol","url":"\/documentation\/swift\/unicode\/utf8","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UTF8","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/Unicode":{"title":"Unicode","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A namespace for Unicode utilities."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Unicode","url":"\/documentation\/swift\/unicode","role":"symbol","navigatorTitle":[{"text":"Unicode","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Unicode","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift":{"title":"Swift","type":"topic","abstract":[{"type":"text","text":"Build apps using a powerful open language."}],"id