:"text"},{"type":"text","text":" "},{"type":"text","text":"the same iterator instance in repeated calls to this method. Do not"},{"type":"text","text":" "},{"type":"text","text":"advance the iterator or any copies of the iterator outside this"},{"type":"text","text":" "},{"text":"method.","type":"text"}],"type":"paragraph"}],"name":"input"}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UnicodeDecodingResult"},{"type":"text","text":" instance, representing the next"},{"type":"text","text":" "},{"text":"Unicode scalar, an indication of an error, or an indication that the","type":"text"},{"type":"text","text":" "},{"text":"UTF sequence has been fully decoded.","type":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"To decode a code unit sequence completely, call this method repeatedly","type":"text"},{"type":"text","text":" "},{"text":"until it returns ","type":"text"},{"type":"codeVoice","code":"UnicodeDecodingResult.emptyInput"},{"type":"text","text":". Checking that the"},{"type":"text","text":" "},{"type":"text","text":"iterator was exhausted is not sufficient, because the decoder can store"},{"type":"text","text":" "},{"type":"text","text":"buffered data from the input iterator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because of buffering, it is impossible to find the corresponding position"},{"type":"text","text":" "},{"type":"text","text":"in the iterator for a given returned "},{"type":"codeVoice","code":"Unicode.Scalar"},{"type":"text","text":" or an error."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example decodes the UTF-8 encoded bytes of a string into an"},{"text":" ","type":"text"},{"text":"array of ","type":"text"},{"code":"Unicode.Scalar","type":"codeVoice"},{"text":" instances:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let str = \"✨Unicode✨\"","print(Array(str.utf8))","\/\/ Prints \"[226, 156, 168, 85, 110, 105, 99, 111, 100, 101, 226, 156, 168]\"","","var bytesIterator = str.utf8.makeIterator()","var scalars: [Unicode.Scalar] = []","var utf8Decoder = UTF8()","Decode: while true {","    switch utf8Decoder.decode(&bytesIterator) {","    case .scalarValue(let v): scalars.append(v)","    case .emptyInput: break Decode","    case .error:","        print(\"Decoding error\")","        break Decode","    }","}","print(scalars)","\/\/ Prints \"[\"\\u{2728}\", \"U\", \"n\", \"i\", \"c\", \"o\", \"d\", \"e\", \"\\u{2728}\"]\""]}]}],"references":{"doc://com.apple.Swift/documentation/Swift":{"role":"collection","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","type":"topic","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/IteratorProtocol":{"title":"IteratorProtocol","url":"\/documentation\/swift\/iteratorprotocol","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IteratorProtocol","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/IteratorProtocol","role":"symbol","abstract":[{"text":"A type that supplies the values of a sequence one at a time.","type":"text"}],"navigatorTitle":[{"text":"IteratorProtocol","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/UnicodeCodec/decode(_:)":{"title":"decode(_:)","role":"symbol","kind":"symbol","required":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnicodeCodec\/decode(_:)","url":"\/documentation\/swift\/unicodecodec\/decode(_:)","abstract":[{"text":"Starts or continues decoding a code unit sequence into Unicode scalar","type":"text"},{"text":" ","type":"text"},{"te