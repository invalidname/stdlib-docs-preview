{"kind":"symbol","abstract":[{"text":"Replaces the specified range of elements by moving the contents of an","type":"text"},{"text":" ","type":"text"},{"text":"output span into their place. On return, the span is left empty.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@export(implementation)"},{"kind":"text","text":" "},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"replaceSubrange"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"subrange"},{"kind":"text","text":": "},{"text":"Range","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Range","preciseIdentifier":"s:Sn"},{"kind":"text","text":"<"},{"text":"Int","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"moving"},{"kind":"text","text":" "},{"kind":"internalParam","text":"items"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"text":"OutputSpan","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/CompatibilitySpan\/OutputSpan","preciseIdentifier":"s:s10OutputSpanV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s11UniqueArrayVsRi_zrlE7Elementxmfp","text":"Element"},{"kind":"text","text":">)"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"subrange","content":[{"inlineContent":[{"text":"The subrange of the array to replace. The bounds of","type":"text"},{"text":" ","type":"text"},{"text":"the range must be valid indices in the array.","type":"text"}],"type":"paragraph"}]},{"name":"items","content":[{"inlineContent":[{"text":"An output span whose contents are to be moved into the array.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"text":"This method has the effect of removing the specified range of elements","type":"text"},{"text":" ","type":"text"},{"text":"from the array and inserting the new elements starting at the same","type":"text"},{"text":" ","type":"text"},{"text":"location. The number of new elements need not match the number of elements","type":"text"},{"text":" ","type":"text"},{"text":"being removed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the array does not have sufficient capacity to perform the replacement,","type":"text"},{"text":" ","type":"text"},{"text":"then this reallocates the array’s storage to extend its capacity, using a","type":"text"},{"text":" ","type":"text"},{"text":"geometric growth rate.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If you pass a zero-length range as the ","type":"text"},{"code":"subrange","type":"codeVoice"},{"text":" parameter, this method","type":"text"},{"text":" ","type":"text"},{"text":"inserts the elements of ","type":"text"},{"code":"newElements","type":"codeVoice"},{"text":" at ","type":"text"},{"code":"subrange.lowerBound","type":"codeVoice"},{"text":". Calling","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"insert(moving:at:)"},{"type":"text","text":" method instead is preferred in this case."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Likewise, if you pass a zero-length buffer as the "},{"type":"codeVoice","code":"newElements"},{"type":"text","text":" "},{"type":"text","text":"parameter, this method removes the elements in the given subrange"},{"type":"text","text":" "},{"type":"text","text":"without replacement. Calling the "},{"type":"codeVoice","code":"removeSubrange(_:)"},{"type":"text","text":" method instead is"},{"type":"text","text":" "},{"type":"text","text":"preferred in this case."}]},{"type":"aside","name":"Complexity","style":"note","content":[{"inlineContent":[{"text":"O(","type":"text"},{"code":"self.count","type":"codeVoice"},{"type":"text","text":" + "},{"type":"codeVoice","code":"items.count"},{"type":"text","text":")"}],"type":"paragraph"}]}],"kind":"content"}],"metadata":{"platforms":[{"deprecated":false,"introducedAt":"8.0","beta":false,"unavailable":false,"name":"iOS"},{"deprecated":false,"introducedAt":"8.0","beta":false,"unavailable":false,"name":"iPadOS"},{"deprecated":false,"introducedAt":"13.0","beta":false,"unavailable":false,"name":"Mac Catalyst"},{"deprecated":false,"introducedAt":"10.10","beta":false,"unavailable":false,"name":"macOS"},{"deprecated":false,"introducedAt":"9.0","beta":false,"unavailable":false,"name":"tvOS"},{"deprecated":false,"introducedAt":"1.0","beta":false,"unavailable":false,"name":"visionOS"},{"deprecated":false,"introducedAt":"2.0","beta":false,"unavailable":false,"name":"watchOS"}],"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"replaceSubrange"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:Sn","text":"Range"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"moving"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:s10OutputSpanV","text":"OutputSpan"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:s11UniqueArrayVsRi_zrlE7Elementxmfp","text":"Element"},{"kind":"text","text":">)"}],"title":"replaceSubrange(_:moving:)","role":"symbol","modules":[{"name":"Standard Library"}],"extendedModule":"Swift","externalID":"s:s11UniqueArrayVsRi_zrlE15replaceSubrange_6movingySnySiG_s10OutputSpanVyxGztF","symb