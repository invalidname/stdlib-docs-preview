{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnownedJob"]]},"abstract":[{"type":"text","text":"Run this job isolated to the passed task executor."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runSynchronously","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"executor","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"UnownedTaskExecutor","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnownedTaskExecutor","preciseIdentifier":"s:12_Concurrency19UnownedTaskExecutorV"},{"text":")","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"name":"executor","content":[{"inlineContent":[{"text":"The task executor this job will be run on.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"This operation runs the job on the calling thread and ","type":"text"},{"inlineContent":[{"text":"blocks","type":"text"}],"type":"emphasis"},{"text":" until the job completes.","type":"text"},{"text":" ","type":"text"},{"text":"The intended use of this method is for an executor to determine when and where it","type":"text"},{"text":" ","type":"text"},{"text":"wants to run the job and then call this method on it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The passed in executor reference is used to establish the executor context for the job,","type":"text"},{"text":" ","type":"text"},{"text":"and should be the same executor as the one semantically calling the ","type":"text"},{"type":"codeVoice","code":"runSynchronously"},{"text":" method.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This operation consu