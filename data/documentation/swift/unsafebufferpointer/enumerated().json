nd":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A nonowning collection interface to a buffer of"},{"type":"text","text":" "},{"type":"text","text":"elements stored contiguously in memory."}],"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeBufferPointer","title":"UnsafeBufferPointer"},"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"role":"symbol","type":"topic","title":"EnumeratedSequence","url":"\/documentation\/swift\/enumeratedsequence","kind":"symbol","navigatorTitle":[{"text":"EnumeratedSequence","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnumeratedSequence","kind":"identifier"}],"abstract":[{"type":"text","text":"An enumeration of the elements of a sequence or collection."}]}}}