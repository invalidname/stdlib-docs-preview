tifier"},{"text":" : ","kind":"text"},{"text":"Error","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ~Copyable, ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":" : ~Copyable","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The type to temporarily bind the memory referenced by this"},{"type":"text","text":" "},{"type":"text","text":"buffer. The type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" must be layout compatible"},{"type":"text","text":" "},{"type":"text","text":"with the pointer’s "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type."}]}],"name":"type"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that takes a  typed buffer to the"},{"type":"text","text":" "},{"type":"text","text":"same memory as this buffer, only bound to type "},{"type":"codeVoice","code":"T"},{"type":"text","text":". The buffer"},{"type":"text","text":" "},{"type":"text","text":"parameter contains a number of complete instances of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" based"},{"type":"text","text":" "},{"type":"text","text":"on the capacity of the original buffer and the stride of "},{"type":"codeVoice","code":"Element"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The closure’s buffer argument is valid only for the duration of the"},{"type":"text","text":" "},{"type":"text","text":"closure’s execution. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" has a return value, that value"},{"type":"text","text":" "},{"type":"text","text":"is also used as the return value for the "},{"type":"codeVoice","code":"withMemoryRebound(to:_:)"},{"type":"text","text":" "},{"type":"text","text":"method."}]}],"name":"body"}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure parameter."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Use this method when you have a buffer of memory bound to one type and"},{"type":"text","text":" "},{"type":"text","text":"you need to access that memory as a buffer of another type. Accessing"},{"type":"text","text":" "},{"type":"text","text":"memory as type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" requires that the memory be bound to that type. A"},{"type":"text","text":" "},{"type":"text","text":"memory location may only be bound to one type at a time, so accessing"},{"type":"text","text":" "},{"type":"text","text":"the same memory as an unrelated type without first rebinding the memory"},{"type":"text","text":" "},{"type":"text","text":"is undefined."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The number of instances of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" referenced by the rebound buffer may be"},{"type":"text","text":" "},{"type":"text","text":"different than the number of instances of "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" referenced by the"},{"type":"text","text":" "},{"type":"text","text":"original buffer. The number of instances of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" will be calculated"},{"type":"text","text":" "},{"type":"text","text":"at runtime."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Any instance of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" within the re-bound region may be initialized or"},{"type":"text","text":" "},{"type":"text","text":"uninitialized. Every instance of "},{"type":"codeVoice","code":"Pointee"},{"type":"text","text":" overlapping with a given"},{"type":"text","text":" "},{"type":"text","text":"instance of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" should have the same initialization state (i.e."},{"type":"text","text":" "},{"type":"text","text":"initialized or uninitialized.) Accessing a "},{"type":"codeVoice","code":"T"},{"type":"text","text":" whose underlying"},{"type":"text","text":" "},{"type":"codeVoice","code":"Pointee"},{"type":"text","text":" storage is in a mixed initialization state shall be"},{"type":"text","text":" "},{"type":"text","text":"undefined behaviour."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because this buffer’s memory is no longer bound to its "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type"},{"type":"text","text":" "},{"type":"text","text":"while the "},{"code":"body","type":"codeVoice"},{"type":"text","text":" closure executes, do not access memory using the"},{"type":"text","text":" "},{"type":"text","text":"original buffer from within "},{"type":"codeVoice","code":"body"},{"text":". Instead, use the ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" closure’s","type":"text"},{"text":" ","type":"text"},{"text":"buffer argument to access the values in memory as instances of type","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"T"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"After executing ","type":"text"},{"code":"body","type":"codeVoice"},{"text":", this method rebinds memory back to the original","type":"text"},{"text":" ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" type.","type":"text"}]},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Only use this method to rebind the buffer’s memory to a type","type":"text"},{"type":"text","text":" "},{"text":"that is layout compatible with the currently bound ","type":"text"},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type."},{"text":" ","type":"text"},{"type":"text","text":"The stride of the temporary type ("},{"type":"codeVoice","code":"T"},{"type":"text","text":") may be an integer multiple"},{"type":"text","text":" "},{"type":"text","text":"or a whole fraction of "},{"code":"Element","type":"codeVoice"},{"text":"‘s stride.","type":"text"},{"text":" ","type":"text"},{"text":"To bind a region of memory to a type that does not match these","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"requirements, convert the buffer to a raw buffer and use the"},{"type":"text","text":" "},{"type":"text","text":"raw buffer’s "},{"code":"withMemoryRebound(to:)","type":"codeVoice"},{"type":"text","text":" method."},{"text":" ","type":"text"},{"text":"If ","type":"text"},{"type":"codeVoice","code":"T"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"text":" have different alignments, this buffer’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"baseAddress"},{"type":"text","text":" must be aligned with the larger of the two alignments."}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/unsafebufferpointer\/withmemoryrebound(to:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Error":{"title":"Error","abstract":[{"text":"A type representing an error value that can be thrown.","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Error","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Error"}],"url":"\/documentation\/swift\/error","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error"},"doc://com.apple.Swift/documentation/Swift/UnsafeBufferPointer":{"title":"UnsafeBufferPointer","abstract":[{"type"