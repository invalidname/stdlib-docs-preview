type":"text","text":". The buffer"},{"type":"text","text":" "},{"text":"parameter contains a number of complete instances of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" based","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"on the capacity of the original buffer and the stride of "},{"type":"codeVoice","code":"Element"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The closure’s buffer argument is valid only for the duration of the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"closure’s execution. If "},{"type":"codeVoice","code":"body"},{"text":" has a return value, that value","type":"text"},{"type":"text","text":" "},{"type":"text","text":"is also used as the return value for the "},{"type":"codeVoice","code":"withMemoryRebound(to:_:)"},{"type":"text","text":" "},{"type":"text","text":"method."}]},{"type":"termList","items":[{"term":{"inlineContent":[{"type":"text","text":"buffer"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The buffer temporarily bound to "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}]}]}}]}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure parameter."}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method when you have a buffer of memory bound to one type and"},{"type":"text","text":" "},{"type":"text","text":"you need to access that memory as a buffer of another type. Accessing"},{"type":"text","text":" "},{"type":"text","text":"memory as type "},{"code":"T","type":"codeVoice"},{"type":"text","text":" requires that the memory be bound to that type. A"},{"type":"text","text":" "},{"type":"text","text":"memory location may only be bound to one type at a time, so accessing"},{"type":"text","text":" "},{"type":"text","text":"the same memory as an unrelated type without first rebinding the memory"},{"type":"text","text":" "},{"type":"text","text":"is undefined."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The number of instances of "},{"code":"T","type":"codeVoice"},{"type":"text","text":" referenced by the rebound buffer may be"},{"type":"text","text":" "},{"type":"text","text":"different than the number of instances of "},{"code":"Element","type":"codeVoice"},{"text":" referenced by the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"original buffer. The number of instances of "},{"code":"T","type":"codeVoice"},{"type":"text","text":" will be calculated"},{"type":"text","text":" "},{"type":"text","text":"at runtime."}]},{"inlineContent":[{"type":"text","text":"Any instance of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" within the re-bound region may be initialized or"},{"type":"text","text":" "},{"type":"text","text":"uninitialized. Every instance of "},{"type":"codeVoice","code":"Pointee"},{"type":"text","text":" overlapping with a given"},{"type":"text","text":" "},{"text":"instance of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" should have the same initialization state (i.e.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"initialized or uninitialized.) Accessing a "},{"type":"codeVoice","code":"T"},{"type":"text","text":" whose underlying"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Pointee"},{"text":" storage is in a mixed initialization state shall be","type":"text"},{"text":" ","type":"text"},{"text":"undefined behaviour.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Because this buffer’s memory is no longer bound to its ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" type","type":"text"},{"text":" ","type":"text"},{"text":"while the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" closure executes, do not access memory using the","type":"text"},{"text":" ","type":"text"},{"text":"original buffer from within ","type":"text"},{"code":"body","type":"codeVoice"},{"text":". Instead, use the ","type":"text"},{"code":"body","type":"codeVoice"},{"type":"text","text":" closure’s"},{"type":"text","text":" "},{"type":"text","text":"buffer argument to access the values in memory as instances of type"},{"type":"text","text":" "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"After executing "},{"type":"codeVoice","code":"body"},{"type":"text","text":", this method rebinds memory back to the original"},{"type":"text","text":" "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only use this method to rebind the buffer’s memory to a type"},{"type":"text","text":" "},{"type":"text","text":"that is layout compatible with the currently bound "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type."},{"type":"text","text":" "},{"type":"text","text":"The stride of the temporary type ("},{"type":"codeVoice","code":"T"},{"type":"text","text":") may be an integer multiple"},{"type":"text","text":" "},{"type":"text","text":"or a whole fraction of "},{"type":"codeVoice","code":"Element"},{"type":"text","text":"‘s stride."},{"type":"text","text":" "},{"text":"To bind a region of memory to a type that does not match these","type":"text"},{"text":" ","type":"text"},{"text":"requirements, convert the buffer to a raw buffer and use the","type":"text"},{"text":" ","type":"text"},{"text":"raw buffer’s ","type":"text"},{"type":"codeVoice","code":"withMemoryRebound(to:)"},{"text":" method.","type":"text"},{"text":" ","type":"text"},{"text":"If ","type":"text"},{"type":"codeVoice","code":"T"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" have different alignments, this buffer’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"baseAddress"},{"type":"text","text":" must be aligned with the larger of the two alignments."}]}],"style":"note","type":"aside","name":"Note"}]}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withMemoryRebound"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"E"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":">("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SRsRi_zrlE17withMemoryRebound2to_qd_1_qd__m_qd_1_SRyqd__Gqd_0_YKXEtqd_0_YKs5ErrorRd_0_Ri_d__Ri_d_1_r1_lF1TL_qd__mfp","kind":"typeIdentifier","text":"T"},{"kind":"text","text":".Type, ("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"buffer"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SR","kind":"typeIdentifier","text":"UnsafeBufferPointer"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SRsRi_zrlE17withMemoryRebound2to_qd_1_qd__m_qd_1_SRyqd__Gqd_0_YKXEtqd_0_YKs5ErrorRd_0_Ri_d__Ri_d_1_r1_lF1TL_qd__mfp","kind":"typeIdentifier","text":"T"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SRsRi_zrlE17withMemoryRebound2to_qd_1_qd__m_qd_1_SRyqd__Gqd_0_YKXEtqd_0_YKs5ErrorRd_0_Ri_d__Ri_d_1_r1_lF1EL_qd_0_mfp","kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:SRsRi_zrlE17withMemoryRebound2to_qd_1_qd__m_qd_1_SRyqd__Gqd_0_YKXEtqd_0_YKs5ErrorRd_0_Ri_d__Ri_d_1_r1_lF6ResultL_qd_1_mfp","kind":"typeIdentifier","text":"Result"},{"kind":"text","text":") "},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{