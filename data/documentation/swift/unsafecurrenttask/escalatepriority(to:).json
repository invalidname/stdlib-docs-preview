{"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Escalate the task "},{"type":"codeVoice","code":"priority"},{"type":"text","text":" of the passed in task to the "},{"type":"codeVoice","code":"newPriority"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/swift\/unsafecurrenttask\/escalatepriority(to:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"escalatePriority"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"newPriority"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority","text":"TaskPriority","preciseIdentifier":"s:ScP"},{"kind":"text","text":")"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"task","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The task which to escalate the priority of"}]}]},{"name":"newPriority","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new priority the task should continue executing on"}]}]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This API should rarely be used, and instead you can rely on"},{"type":"text","text":" "},{"type":"text","text":"structured concurrency and implicit priority escalation which happens"},{"type":"text","text":" "},{"type":"text","text":"when a higher priority task awaits on a result of a lower priority task."}]},{"inlineContent":[{"text":"I.e. using ","type":"text"},{"typ