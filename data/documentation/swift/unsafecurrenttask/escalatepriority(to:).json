{"kind":"symbol","abstract":[{"type":"text","text":"Escalate the task "},{"type":"codeVoice","code":"priority"},{"type":"text","text":" of the passed in task to the "},{"type":"codeVoice","code":"newPriority"},{"type":"text","text":"."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask\/escalatePriority(to:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"escalatePriority"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"newPriority"},{"kind":"text","text":": "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority","text":"TaskPriority","kind":"typeIdentifier","preciseIdentifier":"s:ScP"},{"kind":"text","text":")"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The task which to escalate the priority of"}]}],"name":"task"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new priority the task should continue executing on"}]}],"name":"newPriority"}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"style":"warning","type":"aside","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This API should rarely be used, and instead you can rely on"},{"type":"text","text":" "},{"type":"text","text":"structured concurrency and implicit priority escalation which happens"},{"type":"text","text":" "},{"type":"text","text":"when a higher priority task awaits on a result of a lower priority task."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"I.e. using "},{"type":"codeVoice","code":"await"},{"type":"text","text":" on the target task usually is the correct way to"},{"type":"text","text":" "},{"text":"escalate the target task to the current priority of the calling task,","type":"text"},{"text":" ","type":"text"},{"text":"especially because in such setup if the waiting task gets escalated,","type":"text"},{"text":" ","type":"text"},{"text":"the waited on task would be escalated automatically as well.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The concurrency runtime is free to interpret and handle escalation"},{"type":"text","text":" "},{"type":"text","text":"depending on platform characteristics."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Priority escalation is propagated to child tasks of the waited-on task,"},{"type":"text","text":" "},{"type":"text","text":"and will trigger any priority escalation handlers, if any were registered."}]},{"inlineContent":[{"type":"text","text":"Escalation can only "},{"type":"emphasis","inlineContent":[{"type":"text","text":"increase"}]},{"type":"text","text":" the priority of a task, and"},{"type":"text","text":" "},{"type":"text","text":"de-escalating priority is not supported."}],"type":"paragraph"},{"inlineContent":[{"text":"This method can be called from any task or thread.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/unsafecurrenttask\/escalatepriority(to:)"]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"]]},"metadata":{"modules":[{"name":"Swift","relatedModules":[]}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"escalatePriority","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TaskPriority","kind":"typeIdentifier","preciseIdentifier":"s:ScP"},{"text":")","kind":"text"}],"role":"symbol","roleHe