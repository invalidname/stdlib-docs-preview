{"abstract":[{"type":"text","text":"A Boolean value that indicates whether the current task was canceled."}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","metadata":{"symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isCancelled"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"title":"isCancelled","roleHeading":"Instance Property","platforms":[{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"8.0","name":"iOS"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"8.0","name":"iPadOS"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"13.0","name":"Mac Catalyst"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"10.10","name":"macOS"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"9.0","name":"tvOS"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"1.0","name":"visionOS"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"2.0","name":"watchOS"}],"modules":[{"relatedModules":[],"name":"Swift"}],"externalID":"s:Sct11isCancelledSbvp","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"]]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask\/isCancelled","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isCancelled","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"After the value of this property becomes ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", it remains ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" indefinitely.","type":"text"},{"text":" ","type":"text"},{"text":"There is no way to uncancel a task.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This property returns the actual cancellation state of the task, regardless of whether","type":"text"},{"text":" ","type":"text"},{"text":"a cancellation shield is active. Use ","type":"text"},{"code":"Task\/isCancelled","type":"codeVoice"},{"text":" (the static property)","type":"text"},{"text":" ","type":"text"},{"text":"if you need cancellation checking that respects active shields.","type":"text"}]},{"type":"heading","text":"Instance property isCancelled ignores Task Cancellation Shields","anchor":"Instance-property-isCancelled-ignores-Task-Cancellation-Shields","level":3},{"type":"paragraph","inlineContent":[{"text":"Instance properties ","type":"text"},{"code":"task.isCancelled","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"unsafeCurrentTask.isCancelled","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are not contextual and therefore do not respect cancellation shields. If a task","type":"text"},{"text":" ","type":"text"},{"text":"was cancelled and is executing","type":"text"},{"text":" ","type":"text"},{"text":"with an active cancellation shield, these properties will return the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"actual","type":"text"}]},{"text":" ","type":"text"},{"text":"cancellation status of the task.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It is possible to determine if a shield is active and then actively determine","type":"text"},{"text":" ","type":"text"},{"text":"that the cancelled status should be temporarily ignored by using this pair of APIs:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["withUnsafeCurrentTask { unsafeTask in","  if unsafeTask.hasActiveCancellationShield {","    false","  } else {","    unsafeTask.isCancelled","  }","}"]},{"type":"paragraph","inlineContent":[{"text":"Which is equivalent to the contextually aware static ","type":"text"},{"code":"Task.isCancelled","type":"codeVoice"},{"text":" property:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Contextually aware, and equivalent to the snippet using UnsafeCurrentTask:","Task.isCancelled"]},{"type":"paragraph","inlineContent":[{"text":"Prefer using ","type":"text"},{"code":"Task.isCancelled","type":"codeVoice"},{"text":" (the static property) in most situations when checking","type":"text"},{"text":" ","type":"text"},{"text":"the cancellation status from inside the task.","type":"text"}]},{"type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"Task\/isCancelled","type":"codeVoice"}]}],"style":"note"},{"type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","type":"reference"}]}],"style":"note"},{"type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/hasActiveCancellationShield","type":"reference"}]}],"style":"note"},{"type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"withTaskCancellationShield(operation:)","type":"codeVoice"}]}],"style":"note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/unsafecurrenttask\/iscancelled"]}],"references":{"doc://com.apple.Swift/documentation/Swift/Bool":{"naviga