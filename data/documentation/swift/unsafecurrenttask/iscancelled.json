xt","text":"After the value of this property becomes "},{"type":"codeVoice","code":"true"},{"type":"text","text":", it remains "},{"type":"codeVoice","code":"true"},{"type":"text","text":" indefinitely."},{"type":"text","text":" "},{"type":"text","text":"There is no way to uncancel a task."}]},{"type":"paragraph","inlineContent":[{"text":"This property returns the actual cancellation state of the task, regardless of whether","type":"text"},{"text":" ","type":"text"},{"text":"a cancellation shield is active. Use ","type":"text"},{"type":"codeVoice","code":"Task\/isCancelled"},{"text":" (the static property)","type":"text"},{"text":" ","type":"text"},{"text":"if you need cancellation checking that respects active shields.","type":"text"}]},{"type":"heading","anchor":"Instance-property-isCancelled-ignores-Task-Cancellation-Shields","level":3,"text":"Instance property isCancelled ignores Task Cancellation Shields"},{"type":"paragraph","inlineContent":[{"text":"Instance properties ","type":"text"},{"code":"task.isCancelled","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"unsafeCurrentTask.isCancelled","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are not contextual and therefore do not respect cancellation shields. If a task","type":"text"},{"text":" ","type":"text"},{"text":"was cancelled and is executing","type":"text"},{"text":" ","type":"text"},{"text":"with an active cancellation shield, these properties will return the ","type":"text"},{"inlineContent":[{"text":"actual","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"cancellation status of the task.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to determine if a shield is active and then actively determine"},{"type":"text","text":" "},{"type":"text","text":"that the cancelled status should be temporarily ignored by using this pair of APIs:"}]},{"syntax":"swift","code":["withUnsafeCurrentTask { unsafeTask in","  if unsafeTask.hasActiveCancellationShield {","    false","  } else {","    unsafeTask.isCancelled","  }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Which is equivalent to the contextually aware static "},{"code":"Task.isCancelled","type":"codeVoice"},{"type":"text","text":" property:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Contextually aware, and equivalent to the snippet using UnsafeCurrentTask:","Task.isCancelled"],"type":"codeListing"},{"inlineContent":[{"text":"Prefer using ","type":"text"},{"code":"Task.isCancelled","type":"codeVoice"},{"text":" (the static property) in most situations when checking","type":"text"},{"text":" ","type":"text"},{"text":"the cancellation status from inside the task.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"Task\/isCancelled","type":"codeVoice"}]}],"name":"See Also","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","type":"reference","isActive":true}]}],"name":"See Also","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/hasActiveCancellationShield","type":"reference","isActive":true}]}],"name":"See Also","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"withTaskCancellationShield(operation:)"}]}],"name":"See Also","type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/unsafecurrenttask\/iscancelled"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask\/isCancelled"},"references":{"doc://com.apple.Swift/documentation/Swift/Task/hasActive