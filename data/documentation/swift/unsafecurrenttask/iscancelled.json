{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"]]},"sections":[],"metadata":{"externalID":"s:Sct11isCancelledSbvp","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isCancelled","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"modules":[{"name":"Swift","relatedModules":[]}],"platforms":[{"name":"iOS","introducedAt":"8.0","unavailable":false,"deprecated":false,"beta":false},{"name":"iPadOS","introducedAt":"8.0","unavailable":false,"deprecated":false,"beta":false},{"name":"Mac Catalyst","introducedAt":"13.0","unavailable":false,"deprecated":false,"beta":false},{"name":"macOS","introducedAt":"10.10","unavailable":false,"deprecated":false,"beta":false},{"name":"tvOS","introducedAt":"9.0","unavailable":false,"deprecated":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","unavailable":false,"deprecated":false,"beta":false},{"name":"watchOS","introducedAt":"2.0","unavailable":false,"deprecated":false,"beta":false}],"title":"isCancelled","roleHeading":"Instance Property","role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"A Boolean value that indicates whether the current task was canceled."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isCancelled","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","text":"Bool","preciseIdentifier":"s:Sb"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"After the value of this property becomes ","type":"text"},{"code":"true","type":"codeVoice"},{"type":"text","text":", it remains "},{"code":"true","type":"codeVoice"},{"text":" indefinitely.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"There is no way to uncancel a task."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This property returns the actual cancellation state of the task, regardless of whether"},{"text":" ","type":"text"},{"type":"text","text":"a cancellation shield is active. Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property"},{"text":" (the static property)","type":"text"},{"type":"text","text":" "},{"text":"if you need cancellation checking that respects active shields.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike the static "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","isActive":true},{"type":"text","text":" property, this property doesn’t reflect"},{"text":" ","type":"text"},{"type":"text","text":"a cancellation that only applies to a part of the task, such as an expired deadline of"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withDeadline(in:tolerance:clock:operation:)","isActive":true},{"text":".","type":"text"}]},{"type":"heading","anchor":"Instance-property-isCancelled-ignores-Task-Cancellation-Shields","level":3,"text":"Instance property isCancelled ignores Task Cancellation Shields"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The instance property "},{"type":"codeVoice","code":"task.isCancelled"},{"text":" ","type":"text"},{"type":"text","text":"is not contextual and therefore does not respect cancellation shields. If a task"},{"text":" ","type":"text"},{"type":"text","text":"was cancelled and is executing"},{"type":"text","text":" "},{"type":"text","text":"with an active cancellation shield, this property will return the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"actual"}]},{"text":" ","type":"text"},{"text":"cancellation status of the specific task.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It is possible to determine if a shield is active and then actively determine","type":"text"},{"text":" ","type":"text"},{"text":"that the cancelled status should be temporarily ignored by using this pair of APIs:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["withUnsafeCurrentTask { unsafeTask in","  if unsafeTask.hasActiveCancellationShield {","    false","  } else {","    unsafeTask.isCancelled","  }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Which is equivalent to the contextually aware static "},{"code":"Task.isCancelled","type":"codeVoice"},{"type":"text","text":" property:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Contextually aware, and equivalent to the snippet using UnsafeCurrentTask:","Task.isCancelled"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property"},{"type":"text","text":" (the static property) in most"},{"type":"text","text":" "},{"type":"text","text":"situations when checking the cancellation status from inside the task."}]},{"type":"aside","style":"note","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","isActive":true}]}]},{"type":"aside","style":"note","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation