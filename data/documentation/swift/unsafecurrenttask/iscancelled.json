{"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask\/isCancelled","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","title":"isCancelled","modules":[{"relatedModules":[],"name":"Swift"}],"fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"isCancelled"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"platforms":[{"unavailable":false,"name":"iOS","deprecated":false,"introducedAt":"8.0","beta":false},{"unavailable":false,"name":"iPadOS","deprecated":false,"introducedAt":"8.0","beta":false},{"unavailable":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"13.0","beta":false},{"name":"macOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"10.10"},{"name":"tvOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"9.0"},{"name":"visionOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"1.0"},{"name":"watchOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"2.0"}],"externalID":"s:Sct11isCancelledSbvp","symbolKind":"property","roleHeading":"Instance Property"},"abstract":[{"text":"A Boolean value that indicates whether the current task was canceled.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isCancelled","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"]}]},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"After the value of this property becomes "},{"type":"codeVoice","code":"true"},{"type":"text","text":", it remains "},{"type":"codeVoice","code":"true"},{"type":"text","text":" indefinitely."},{"type":"text","text":" "},{"type":"text","text":"There is no way to uncancel a task."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This property returns the actual cancellation state of the task, regardless of whether"},{"type":"text","text":" "},{"type":"text","text":"a cancellation shield is active. Use "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","isActive":true},{"type":"text","text":" (the static property)"},{"text":" ","type":"text"},{"text":"if you need cancellation checking that respects active shields.","type":"text"}]},{"inlineContent":[{"text":"Unlike the static ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","type":"reference","isActive":true},{"text":" property, this property doesn’t reflect","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a cancellation that only applies to a part of the task, such as an expired deadline of"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withDeadline(in:tolerance:clock:operation:)","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Instance property isCancelled ignores Task Cancellation Shields","anchor":"Instance-property-isCancelled-ignores-Task-Cancellation-Shields","level":3},{"inlineContent":[{"text":"The instance property ","type":"text"},{"code":"task.isCancelled","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is not contextual and therefore does not respect cancellation shields. If a task","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"was cancelled and is executing"},{"type":"text","text":" "},{"type":"text","text":"with an active cancellation shield, this property will return the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"actual"}]},{"type":"text","text":" "},{"type":"text","text":"cancellation status of the specific task."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is possible to determine if a shield is active and then actively determine"},{"type":"text","text":" "},{"type":"text","text":"that the cancelled status should be temporarily ignored by using this pair of APIs:"}],"type":"paragraph"},{"syntax":"swift","code":["withUnsafeCurrentTask { unsafeTask in","  if unsafeTask.hasActiveCancellationShield {","    false","  } else {","    unsafeTask.isCancelled","  }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Which is equivalent to the contextually aware static "},{"code":"Task.isCancelled","type":"codeVoice"},{"type":"text","text":" property:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Contextually aware, and equivalent to the snippet using UnsafeCurrentTask:","Task.isCancelled"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Prefer using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property"},{"type":"text","text":" (the static property) in most"},{"type":"text","text":" "},{"type":"text","text":"situations when checking the cancellation status from inside the task."}],"type":"paragraph"},{"name":"See Also","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","isActive":true}]}]},{"name":"See Also","type":"aside","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"name":"See Also","type":"aside"