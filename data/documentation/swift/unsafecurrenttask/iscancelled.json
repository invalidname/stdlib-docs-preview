{"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"]]},"abstract":[{"text":"A Boolean value that indicates whether the current task was canceled.","type":"text"}],"variants":[{"paths":["\/documentation\/swift\/unsafecurrenttask\/iscancelled"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask\/isCancelled"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isCancelled","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"After the value of this property becomes "},{"type":"codeVoice","code":"true"},{"type":"text","text":", it remains "},{"type":"codeVoice","code":"true"},{"type":"text","text":" indefinitely."},{"type":"text","text":" "},{"type":"text","text":"There is no way to uncancel a task."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This property returns the actual cancellation state of the task, regardless of whether"},{"type":"text","text":" "},{"type":"text","text":"a cancellation shield is active. Use "},{"type":"codeVoice","code":"Task\/isCancelled"},{"type":"text","text":" (the static property)"},{"type":"text","text":" "},{"type":"text","text":"if you need cancellation checking that respects active shields."}],"type":"paragraph"},{"text":"Instance property isCancelled ignores Task Cancellation Shields","type":"heading","anchor":"Instance-property-isCancelled-ignores-Task-Cancellation-Shields","level":3},{"inlineContent":[{"type":"text","text":"Instance properties "},{"type":"codeVoice","code":"task.isCancelled"},{"type":"text","text":" and "},{"type":"codeVoice","code":"unsafeCurrentTask.isCancelled"},{"type":"text","text":" "},{"type":"text","text":"are not contextual and therefore do not respect cancellation shields. If a task"},{"type":"text","text":" "},{"type":"text","text":"was cancelled and is executing"},{"type":"text","text":" "},{"type":"text","text":"with an active cancellation shield, these properties will return the "},{"type":"emphasis","inlineContent":[{"text":"actual","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"cancellation status of the task."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is possible to determine if a shield is active and then actively determine"},{"type":"text","text":" "},{"type":"text","text":"that the cancelled status should be temporarily ignored by using this pair of APIs:"}],"type":"paragraph"},{"code":["withUnsafeCurrentTask { unsafeTask in","  if unsafeTask.hasActiveCancellationShield {","    false","  } else {","    unsafeTask.isCancelled","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Which is equivalent to the contextually aware static "},{"type":"codeVoice","code":"Task.isCancelled"},{"type":"text","text":" property:"}],"type":"paragraph"},{"code":["\/\/ Contextually aware, and equivalent to the snippet using UnsafeCurrentTask:","Task.isCancelled"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Prefer using "},{"type":"codeVoice","code":"Task.isCancelled"},{"type":"text","text":" (the static property) in most situations when checking"},{"type":"text","text":" "},{"type":"text","text":"the cancellation status from inside the task."}],"type":"paragraph"},{"content":[{"type":"paragraph","inli