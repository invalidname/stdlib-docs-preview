{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask\/isCancelled"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isCancelled"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","text":"Bool"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"After the value of this property becomes ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", it remains ","type":"text"},{"code":"true","type":"codeVoice"},{"type":"text","text":" indefinitely."},{"type":"text","text":" "},{"type":"text","text":"There is no way to uncancel a task."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This property returns the actual cancellation state of the task, regardless of whether"},{"type":"text","text":" "},{"type":"text","text":"a cancellation shield is active. Use "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","type":"reference","isActive":true},{"type":"text","text":" (the static property)"},{"type":"text","text":" "},{"type":"text","text":"if you need cancellation checking that respects active shields."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike the static "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","type":"reference","isActive":true},{"type":"text","text":" property, this property doesn’t reflect"},{"type":"text","text":" "},{"type":"text","text":"a cancellation that only applies to a part of the task, such as an expired