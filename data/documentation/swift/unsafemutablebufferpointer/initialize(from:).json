kind":"parameters","parameters":[{"name":"source","content":[{"inlineContent":[{"type":"text","text":"A sequence of elements with which to initialize the"},{"type":"text","text":" "},{"type":"text","text":"buffer."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An iterator to any elements of "},{"type":"codeVoice","code":"source"},{"type":"text","text":" that didn’t fit in the"},{"type":"text","text":" "},{"type":"text","text":"buffer, and an index to the next uninitialized element in the buffer."}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prior to calling the "},{"type":"codeVoice","code":"initialize(from:)"},{"type":"text","text":" method on a buffer, the memory it"},{"type":"text","text":" "},{"type":"text","text":"references must be uninitialized, or its "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type must be a trivial"},{"type":"text","text":" "},{"type":"text","text":"type. After the call, the memory referenced by the buffer up to, but not"},{"type":"text","text":" "},{"type":"text","text":"including, the returned index is initialized. The buffer must contain"},{"type":"text","text":" "},{"type":"text","text":"sufficient memory to accommodate "},{"type":"codeVoice","code":"source.underestimatedCount"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned index is the position of the next uninitialized element in"},{"type":"text","text":" "},{"type":"text","text":"the buffer, which is one past the last element written. If "},{"type":"codeVoice","code":"source"},{"type":"text","text":" "},{"type":"text","text":"contains no elements, the returned index is equal to the buffer’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"startIndex"},{"type":"text","text":". If "},{"type":"codeVoice","code":"source"},{"type":"text","text":" contains an equal or greater number of elements"},{"type":"text","text":" "},{"type":"text","text":"than the buffer can hold, the returned index is equal to the buffer’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"endIndex"},{"type":"text","text":"."}]}]}],"metadata":{"role":"symbol","platforms":[{"name":"iOS","unavailable":false,"introducedAt":"8.0","beta":false,"deprecated":false},{"name":"iPadOS","unavailable":false,"introducedAt":"8.0","beta":false,"deprecated":false},{"name":"Mac Catalyst","unavailable":false,"introducedAt":"13.0","beta":false,"deprecated":false},{"name":"macOS","unavailable":false,"introducedAt":"10.10","beta":false,"deprecated":false},{"name":"tvOS","unavailable":false,"introducedAt":"9.0","beta":false,"deprecated":false},{"name":"visionOS","unavailable":false,"introducedAt":"1.0","beta":false,"deprecated":false},{"name":"watchOS","unavailable":false,"introducedAt":"2.0","beta":false,"deprecated":false}],"symbolKind":"method","extendedModule":"Swift","roleHeading":"Instance Method","externalID":"s:Sr10initialize4from8IteratorQyd__9unwritten_Si5indextqd___t7ElementQyd__RszSTRd__lF","modules":[{"name":"Swift"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"initialize"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"S","preciseIdentifier":"s:Sr10initialize4from8IteratorQyd__9unwritten_Si5indextqd___t7ElementQyd__RszSTRd__lF1SL_qd__mfp"},{"kind":"text","text":") -> (unwritten"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"S","preciseIdentifier":"s:Sr10initialize4from8IteratorQyd__9unwritten_Si5indextqd___t7ElementQyd__RszSTRd__lF1SL_qd__mfp"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Iterator","prec