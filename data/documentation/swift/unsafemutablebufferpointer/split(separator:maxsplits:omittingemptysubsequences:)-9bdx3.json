" "},{"type":"text","text":"original string is split just once, into two new strings."}],"type":"paragraph"},{"syntax":"swift","code":["print(line.split(separator: \" \", maxSplits: 1)","          .map(String.init))","\/\/ Prints \"[\"BLANCHE:\", \"  I don\\'t want realism. I want magic!\"]\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The final example passes "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for the "},{"type":"codeVoice","code":"omittingEmptySubsequences"},{"type":"text","text":" "},{"type":"text","text":"parameter, so the returned array contains empty strings where spaces"},{"type":"text","text":" "},{"type":"text","text":"were repeated."}],"type":"paragraph"},{"syntax":"swift","code":["print(line.split(separator: \" \", omittingEmptySubsequences: false)","          .map(String.init))","\/\/ Prints \"[\"BLANCHE:\", \"\", \"\", \"I\", \"don\\'t\", \"want\", \"realism.\", \"I\", \"want\", \"magic!\"]\""],"type":"codeListing"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" is the length of the sequence."}]}],"name":"Complexity","type":"aside"}]}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/UnsafeMutableBufferPointer/split(separator:maxSplits:omittingEmptySubsequences:)-9bdx3":{"role":"symbol","title":"split(separator:maxSplits:omittingEmptySubsequences:)","url":"\/documentation\/swift\/unsafemutablebufferpointer\/split(separator:maxsplits:omittingemptysubsequences:)-9bdx3","abstract":[{"type":"text","text":"Returns the longest possible subsequences of the sequence, in order,"},{"type":"text","text":" "},{"type":"text","text":"around elements equal to the given element."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableBufferPointer