lE17withMemoryRebound2to_qd_1_qd__m_qd_1_Sryqd__Gqd_0_YKXEtqd_0_YKs5ErrorRd_0_Ri_d__Ri_d_1_r1_lF6ResultL_qd_1_mfp","text":"Result","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"text":" : ","kind":"text"},{"text":"Error","preciseIdentifier":"s:s5ErrorP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ~Copyable, ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":" : ~Copyable","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The type to temporarily bind the memory referenced by this"},{"type":"text","text":" "},{"type":"text","text":"buffer. The type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" must be layout compatible"},{"type":"text","text":" "},{"type":"text","text":"with the pointer’s "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type."}]}],"name":"type"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that takes a mutable typed buffer to the"},{"type":"text","text":" "},{"type":"text","text":"same memory as this buffer, only bound to type "},{"type":"codeVoice","code":"T"},{"type":"text","text":". The buffer"},{"type":"text","text":" "},{"type":"text","text":"parameter contains a number of complete instances of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" based"},{"type":"text","text":" "},{"type":"text","text":"on the capacity of the original buffer and the stride of "},{"type":"codeVoice","code":"Element"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The closure’s buffer argument is valid only for the duration of the"},{"type":"text","text":" "},{"type":"text","text":"closure’s execution. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" has a return value, that value"},{"type":"text","text":" "},{"type":"text","text":"is also used as the return value for the "},{"type":"codeVoice","code":"withMemoryRebound(to:_:)"},{"type":"text","text":" "},{"type":"text","text":"method."}]},{"type":"termList","items":[{"term":{"inlineContent":[{"type":"text","text":"buffer"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The buffer temporarily bound to "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}]}]}}]}],"name":"body"}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure parameter."}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Use this method when you have a buffer of memory bound to one type and"},{"type":"text","text":" "},{"text":"you need to access that memory as a buffer of another type. Accessing","type":"text"},{"type":"text","text":" "},{"type":"text","text":"memory as type "},{"type":"codeVoice","code":"T"},{"text":" requires that the memory be bound to that type. A","type":"text"},{"text":" ","type":"text"},{"text":"memory location may only be bound to one type at a time, so accessing","type":"text"},{"type":"text","text":" "},{"text":"the same memory as an unrelated type without first rebinding the memory","type":"text"},{"type":"text","text":" "},{"text":"is undefined.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The number of instances of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" referenced by the rebound buffer may be","type":"text"},{"type":"text","text":" "},{"text":"different than the number of instances of ","type":"text"},{"type":"codeVoice","code":"Element"},{"text":" referenced by the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"original buffer. The number of instances of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" will be calculated"},{"type":"text","text":" "},{"type":"text","text":"at runtime."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any instance of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" within the re-bound region may be initialized or"},{"type":"text","text":" "},{"type":"text","text":"uninitialized. Every instance of "},{"type":"codeVoice","code":"Pointee"},{"type":"text","text":" overlapping with a given"},{"type":"text","text":" "},{"text":"instance of ","type":"text"},{"type":"codeVoice","code":"T"},{"type":"text","text":" should have the same initialization state (i.e."},{"type":"text","text":" "},{"type":"text","text":"initialized or uninitialized.) Accessing a "},{"type":"codeVoice","code":"T"},{"type":"text","text":" whose underlying"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Pointee"},{"text":" storage is in a mixed initialization state shall be","type":"text"},{"type":"text","text":" "},{"text":"undefined behaviour.","type":"text"}]},{"inlineContent":[{"text":"Because this buffer’s memory is no longer bound to its ","type":"text"},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type"},{"type":"text","text":" "},{"type":"text","text":"while the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure executes, do not access memory using the"},{"type":"text","text":" "},{"type":"text","text":"original buffer from within "},{"type":"codeVoice","code":"body"},{"type":"text","text":". Instead, use the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure’s"},{"type":"text","text":" "},{"text":"buffer argument to access the values in memory as instances of type","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"After executing ","type":"text"},{"type":"codeVoice","code":"body"},{"text":", this method rebinds memory back to the original","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"Element"},{"text":" type.","type":"text"}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Only use this method to rebind the buffer’s memory to a type","type":"text"},{"type":"text","text":" "},{"text":"that is layout compatible with the currently bound ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" type.","type":"text"},{"text":" ","type":"text"},{"text":"The stride of the temporary type (","type":"text"},{"code":"T","type":"codeVoice"},{"text":") may be an integer multiple","type":"text"},{"text":" ","type":"text"},{"text":"or a whole fraction of ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":"‘s stride.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"To bind a region of memory to a type that does not match these"},{"text":" ","type":"text"},{"text":"requirements, convert the buffer to a raw buffer and use the","type":"text"},{"text":" ","type":"text"},{"text":"raw buffer’s ","type":"text"},{"code":"withMemoryRebound(to:)","type":"codeVoice"},{"type":"text","text":" method."},{"text":" ","type":"text"},{"text":"If ","type":"text"},{"type":"codeVoice","code":"T"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"text":" have different alignments, this buffer’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"baseAddress"},{"text":" must be aligned with the larger of the two alignments.","type":"text"}]}]}]}],"references":{"doc://com.apple.Swift/documentation/Swift/UnsafeMutableBufferPointer/withMemoryRebound(to:_:)":{"type":"topic","role":"symbol","abstract":[{"text":"Executes the given closure while te