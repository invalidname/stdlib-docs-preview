entation\/Swift\/Error"},{"text":", ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ~Copyable, ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":" : ~Copyable","kind":"text"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The type to temporarily bind the memory referenced by this"},{"type":"text","text":" "},{"type":"text","text":"buffer. The type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" must be layout compatible"},{"type":"text","text":" "},{"type":"text","text":"with the pointer’s "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type."}]}],"name":"type"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that takes a mutable typed buffer to the"},{"type":"text","text":" "},{"type":"text","text":"same memory as this buffer, only bound to type "},{"type":"codeVoice","code":"T"},{"text":". The buffer","type":"text"},{"text":" ","type":"text"},{"text":"parameter contains a number of complete instances of ","type":"text"},{"type":"codeVoice","code":"T"},{"type":"text","text":" based"},{"type":"text","text":" "},{"type":"text","text":"on the capacity of the original buffer and the stride of "},{"type":"codeVoice","code":"Element"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The closure’s buffer argument is valid only for the duration of the"},{"type":"text","text":" "},{"text":"closure’s execution. If ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" has a return value, that value","type":"text"},{"text":" ","type":"text"},{"text":"is also used as the return value for the ","type":"text"},{"type":"codeVoice","code":"withMemoryRebound(to:_:)"},{"text":" ","type":"text"},{"text":"method.","type":"text"}]},{"items":[{"term":{"inlineContent":[{"type":"text","text":"buffer"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The buffer temporarily bound to "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}]}]}}],"type":"termList"}],"name":"body"}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"type":"codeVoice","code":"body"},{"text":" closure parameter.","type":"text"}]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method when you have a buffer of memory bound to one type and"},{"text":" ","type":"text"},{"text":"you need to access that memory as a buffer of another type. Accessing","type":"text"},{"type":"text","text":" "},{"type":"text","text":"memory as type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" requires that the memory be bound to that type. A"},{"text":" ","type":"text"},{"text":"memory location may only be bound to one type at a time, so accessing","type":"text"},{"text":" ","type":"text"},{"text":"the same memory as an unrelated type without first rebinding the memory","type":"text"},{"text":" ","type":"text"},{"text":"is undefined.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The number of instances of ","type":"text"},{"type":"codeVoice","code":"T"},{"type":"text","text":" referenced by the rebound buffer may be"},{"text":" ","type":"text"},{"text":"different than the number of instances of ","type":"text"},{"type":"codeVoice","code":"Element"},{"text":" referenced by the","type":"text"},{"text":" ","type":"text"},{"text":"original buffer. The number of instances of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" will be calculated","type":"text"},{"text":" ","type":"text"},{"text":"at runtime.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Any instance of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" within the re-bound region may be initialized or","type":"text"},{"text":" ","type":"text"},{"text":"uninitialized. Every instance of ","type":"text"},{"type":"codeVoice","code":"Pointee"},{"text":" overlapping with a given","type":"text"},{"text":" ","type":"text"},{"text":"instance of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" should have the same initialization state (i.e.","type":"text"},{"text":" ","type":"text"},{"text":"initialized or uninitialized.) Accessing a ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" whose underlying","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Pointee"},{"text":" storage is in a mixed initialization state shall be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"undefined behaviour."}]},{"type":"paragraph","inlineContent":[{"text":"Because this buffer’s memory is no longer bound to its ","type":"text"},{"type":"codeVoice","code":"Element"},{"text":" type","type":"text"},{"text":" ","type":"text"},{"text":"while the ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" closure executes, do not access memory using the","type":"text"},{"text":" ","type":"text"},{"text":"original buffer from within ","type":"text"},{"type":"codeVoice","code":"body"},{"text":". Instead, use the ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" closure’s","type":"text"},{"text":" ","type":"text"},{"text":"buffer argument to access the values in memory as instances of type","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"T"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"After executing ","type":"text"},{"type":"codeVoice","code":"body"},{"text":", this method rebinds memory back to the original","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Element"},{"text":" type.","type":"text"}]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only use this method to rebind the buffer’s memory to a type"},{"type":"text","text":" "},{"type":"text","text":"that is layout compatible with the currently bound "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type."},{"type":"text","text":" "},{"type":"text","text":"The stride of the temporary type ("},{"type":"codeVoice","code":"T"},{"type":"text","text":") may be an integer multiple"},{"type":"text","text":" "},{"type":"text","text":"or a whole fraction of "},{"type":"codeVoice","code":"Element"},{"type":"text","text":"‘s stride."},{"type":"text","text":" "},{"type":"text","text":"To bind a region of memory to a type that does not match these"},{"type":"text","text":" "},{"type":"text","text":"requirements, convert the buffer to a raw buffer and use the"},{"type":"text","text":" "},{"type":"text","text":"raw buffer’s "},{"type":"codeVoice","code":"withMemoryRebound(to:)"},{"type":"text","text":" method."},{"type":"text","text":" "},{"type":"text","text":"If "},{"type":"codeVoice","code":"T"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" have different alignments, this buffer’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"baseAddress"},{"type":"text","text":" must be aligned with the larger of the two alignments."}]}],"type":"aside","style":"note"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableBufferPointer\/withMemoryRebound(to:_:)"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableBufferPointer"]]},"references":{"doc://com.apple.Swift/documentation/Swift/UnsafeMutableBufferPointer/withMemoryRebound(to:_:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableBufferPointer\/withMemoryRebound(to:_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind"