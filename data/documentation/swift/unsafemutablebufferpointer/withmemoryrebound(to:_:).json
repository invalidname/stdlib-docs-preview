"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":" : ~Copyable"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The type to temporarily bind the memory referenced by this"},{"type":"text","text":" "},{"type":"text","text":"buffer. The type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" must be layout compatible"},{"type":"text","text":" "},{"type":"text","text":"with the pointer’s "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" type."}],"type":"paragraph"}],"name":"type"},{"content":[{"inlineContent":[{"type":"text","text":"A closure that takes a mutable typed buffer to the"},{"type":"text","text":" "},{"type":"text","text":"same memory as this buffer, only bound to type "},{"type":"codeVoice","code":"T"},{"type":"text","text":". The buffer"},{"type":"text","text":" "},{"type":"text","text":"parameter contains a number of complete instances of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" based"},{"type":"text","text":" "},{"type":"text","text":"on the capacity of the original buffer and the stride of "},{"type":"codeVoice","code":"Element"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The closure’s buffer argument is valid only for the duration of the"},{"type":"text","text":" "},{"type":"text","text":"closure’s execution. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" has a return value, that value"},{"type":"text","text":" "},{"type":"text","text":"is also used as the return value for the "},{"type":"codeVoice","code":"withMemoryRebound(to:_:)"},{"type":"text","text":" "},{"type":"text","text":"method."}],"type":"paragraph"}],"name":"body"}]},{"content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure parameter."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use this method when you have a buffer of memory bound to one type and","type":"text"},{"text":" ","type":"text"},{"text":"you need to access that memory as a buffer of another type. Accessing","type":"text"},{"text":" ","type":"text"},{"text":"memory as type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" requires that the memory be bound to that type. A","type":"text"},{"text":" ","type":"text"},{"text":"memory location may only be bound to one type at a time, so accessing","type":"text"},{"text":" ","type":"text"},{"text":"the same memory as an unrelated type without first rebinding the memory","type":"text"},{"text":" ","type":"text"},{"text":"is undefined.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The number of instances of "},{"code":"T","type":"codeVoice"},{"text":" referenced by the rebound buffer may be","type":"text"},{"text":" ","type":"text"},{"text":"different than the number of instances of ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" referenced by the","type":"text"},{"text":" ","type":"text"},{"text":"original buffer. The number of instances of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" will be calculated","type":"text"},{"text":" ","type":"text"},{"text":"at runtime.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Any instance of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" within the re-bound region may be initialized or"},{"type":"text","text":" "},{"type":"text","text":"uninitialized. Every instance of "},{"code":"Pointee","type":"codeVoice"},{"type":"text","text":" overlapping with a given"},{"type":"text","text":" "},{"type":"text","text":"instance of "},{"code":"T","type":"codeVoice"},{"type":"text","text":" should have the same initialization state (i.e."},{"type":"text","text":" "},{"type":"text","text":"initialized or uninitialized.) Accessing a "},{"code":"T","type":"codeVoice"},{"type":"text","text":" whose underlying"},{"type":"text","text":" "},{"type":"codeVoice","code":"Pointee"},{"type":"text","text":" storage is in a mixed initialization state shall be"},{"type":"text","text":" "},{"type":"text","text":"undefined behaviour."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because this buffer’s memory is no longer bound to its "},{"code":"Element","type":"codeVoice"},{"type":"text","text":" type"},{"text":" ","type":"text"},{"type":"text","text":"while the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure executes, do not access memory using the"},{"type":"text","text":" "},{"type":"text","text":"original buffer from within "},{"type":"codeVoice","code":"body"},{"type":"text","text":". Instead, use the "},{"code":"body","type":"codeVoice"},{"type":"text","text":" closure’s"},{"type":"text","text":" "},{"type":"text","text":"buffer argument to access the values in memory as instances of type"},{"type":"text","text":" "},{"code":"T","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After executing "},{"type":"codeVoice","code":"body"},{"type":"text","text":", this method rebinds memory back to the original"},{"type":"text","text":" "},{"code":"Element","type":"codeVoice"},{"type":"text","text":" type."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only use this method to rebind the buffer’s memory to a type"},{"type":"text","text":" "},{"type":"text","text":"that is layout compatible with the currently bound "},{"type":"codeVoice","code":"Element"},{"text":" type.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The stride of the temporary type ("},{"type":"codeVoice","code":"T"},{"text":") may be an integer multiple","type":"text"},{"type":"text","text":" "},{"text":"or a whole fraction of ","type":"text"},{"code":"Element","type":"codeVoice"},{"type":"text","text":"‘s stride."},{"type":"text","text":" "},{"type":"text","text":"To bind a region of memory to a type that does not match these"},{"type":"text","text":" "},{"type":"text","text":"requirements, convert the buffer to a raw buffer and use the"},{"type":"text","text":" "},{"type":"text","text":"raw buffer’s "},{"type":"codeVoice","code":"withMemoryRebound(to:)"},{"type":"text","text":" method."},{"type":"text","text":" "},{"type":"text","text":"If "},{"code":"T","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Element","type":"codeVoice"},{"text":" have different alignments, this buffer’s","type":"text"},{"text":" ","type":"text"},{"code":"baseAddress","type":"codeVoice"},{"type":"text","text":" must be aligned with the larger of the two alignments."}]}],"name":"Note","type":"aside"}],"kind":"content"}],"abstract":[{"text":"Executes the given closure while temporarily binding the memory referenced","type":"text"},{"text":" ","type":"text"},{"text":"by this buffer to the given type.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableBufferPointer"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/swift\/unsafemutablebufferpointer\/withmemoryrebound(to:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/UnsafeMutableBufferPointer":{"kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableBufferPointer","navigatorTitle":[{"kind":"identifier","text":"UnsafeMutableBufferPointer"}],"url":"\/documentation\/swift\/unsafemutablebufferpointer","title":"UnsafeMutableBufferPointer","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnsafeMutableBufferPointer"}],"type":"topic","abstract":[{"text":"A nonowning collection interfa