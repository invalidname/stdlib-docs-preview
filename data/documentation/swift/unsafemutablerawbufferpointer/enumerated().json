erface to the bytes in a"},{"type":"text","text":" "},{"type":"text","text":"region of memory."}],"role":"symbol","title":"UnsafeMutableRawBufferPointer","navigatorTitle":[{"kind":"identifier","text":"UnsafeMutableRawBufferPointer"}],"kind":"symbol","url":"\/documentation\/swift\/unsafemutablerawbufferpointer","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnsafeMutableRawBufferPointer","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/EnumeratedSequence":{"role":"symbol","type":"topic","title":"EnumeratedSequence","url":"\/documentation\/swift\/enumeratedsequence","kind":"symbol","navigatorTitle":[{"text":"EnumeratedSequence","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/EnumeratedSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnumeratedSequence","kind":"identifier"}],"abstract":[{"type":"text","text":"An enumeration of the elements of a sequence or collection."}]}}}