{"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawBufferPointer"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"partition"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"belongsInSecondPartition","kind":"internalParam"},{"text":": (","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection\/Element","preciseIdentifier":"s:SK7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection\/Index","preciseIdentifier":"s:SK5IndexQa","text":"Index","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"belongsInSecondPartition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A predicate used to partition"},{"type":"text","text":" "},{"type":"text","text":"the collection. All elements satisfying this predicate are ordered"},{"type":"text","text":" "},{"type":"text","text":"after all elements not satisfying it."}]}]}]},{"content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The index of the first element in the reordered collection"},{"type":"text","text":" "},{"type":"text","text":"that matches "},{"type":"codeVoice","code":"belongsInSecondPartition"},{"type":"text","text":". If no elements in the"},{"type":"text","text":" "},{"type":"text","text":"collection match "},{"code":"belongsInSecondPartition","type":"codeVoice"},{"text":", the returned index is","type":"text"},{"text":" ","type":"text"},{"text":"equal to the collection’s ","type":"text"},{"code":"endIndex","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"After partitioning a collection, there is a pivot index ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" where","type":"text"},{"text":" ","type":"text"},{"text":"no element before ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" satisfies the ","type":"text"},{"code":"belongsInSecondPartition","type":"codeVoice"},{"text":" ","type":"text"},{"text":"predicate and every element at or after ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" satisfies","type":"text"},{"text":" ","type":"text"},{"code":"belongsInSecondPartition","type":"codeVoice"},{"text":". This operation isn’t guaranteed to be","type":"text"},{"text":" ","type":"text"},{"text":"stable, so the relative ordering of elements within the partitions might","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"In the following example, an array of numbers is partitioned by a","type":"text"},{"text":" ","type":"text"},{"text":"predicate that matches elements greater than 30.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var numbers = [30, 40, 20, 30, 30, 60, 10]","let p = numbers.partition(by: { $0 > 30 })","\/\/ p == 5","\/\/ numbers == [30, 10, 20, 30, 30, 60, 40]"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"numbers"},{"text":" array is now arranged in two partitions. The first","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"partition, "},{"type":"codeVoice","code":"numbers[..<p]"},{"type":"text","text":", is made up of the elements that"},{"type":"text","text":" "},{"type":"text","text":"are not greater than 30. The second partition, "},{"type":"codeVoice","code":"numbers[p...]"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"is made up of the elements that "},{"type":"emphasis","inlineContent":[{"type":"text","text":"are"}]},{"type":"text","text":" greater than 30."}]},{"type":"codeListing","syntax":"swift","code":["let first = numbers[..<p]","\/\/ first == [30, 10, 20, 30, 30]","let second = numbers[p...]","\/\/ second == [60, 40]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that the order of elements in both partitions changed."},{"type":"text","text":" "},{"type":"text","text":"That is, "},{"type":"codeVoice","code":"40"},{"type":"text","text":" appears before "},{"type":"codeVoice","code":"60"},{"type":"text","text":" in the original collection,"},{"type":"text","text":" "},{"type":"text","text":"but, after calling "},{"type":"codeVoice","code":"partition(by:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"60"},{"type":"text","text":" appears before "},{"type":"codeVoice","code":"40"},{"type":"text","text":"."}]},{"content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is the length of the collection.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Complexity"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/unsafemutablerawbufferpointer\/partition(by:)-33su4"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawBufferPo