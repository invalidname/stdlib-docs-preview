{"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawBufferPointer"]]},"abstract":[{"type":"text","text":"Returns a subsequence from the start of the collection up to, but not"},{"type":"text","text":" "},{"type":"text","text":"including, the specified position."}],"variants":[{"paths":["\/documentation\/swift\/unsafemutablerawbufferpointer\/prefix(upto:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawBufferPointer\/prefix(upTo:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"prefix"},{"kind":"text","text":"("},{"kind":"externalParam","text":"upTo"},{"kind":"text","text":" "},{"kind":"internalParam","text":"end"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection\/Index","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl11SubSequenceQa","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection\/SubSequence","text":"SubSequence"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"end","content":[{"inlineContent":[{"type":"text","text":"The “past the end” index of the resulting subsequence."},{"type":"text","text":" "},{"type":"codeVoice","code":"end"},{"type":"text","text":" must be a valid index of the collection."}],"type":"paragraph"}]}]},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"A subsequence up to, but not including, the "},{"type":"codeVoice","code":"end"},{"type":"text","text":" position."}],"type":"p