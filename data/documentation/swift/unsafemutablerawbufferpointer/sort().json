bena\"]\""]},{"inlineContent":[{"type":"text","text":"The sorting algorithm is guaranteed to be stable. A stable sort"},{"type":"text","text":" "},{"type":"text","text":"preserves the relative order of elements that compare as equal."}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" log ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is the length of the collection.","type":"text"}]}],"type":"aside"}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/UnsafeMutableRawBufferPointer/sort()":{"conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"RandomAccessCollection"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Element"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Comparable"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sort"},{"kind":"text","text":"()"}],"type":"topic","abstract":[{"text":"Sorts the collection in place.","type":"text"}],"title":"sort()","url":"\/documentation\/swift\/unsafemutablerawbufferpointer\/sort()","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawBufferPointer\/sort()","role":"symbol"},"doc://com.apple.Swift/documentation/Swift":{"role":"collection","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","type":"topic","kind"