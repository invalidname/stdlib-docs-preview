{"kind":"symbol","abstract":[{"text":"Stores a value’s bytes into the buffer pointer’s raw memory at the","type":"text"},{"text":" ","type":"text"},{"text":"specified byte offset.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@export(implementation)","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"storeBytes","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"text":" ","kind":"text"},{"text":"value","kind":"internalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sw10storeBytes2of12toByteOffset2asyx_SixmtlF1TL_xmfp","text":"T"},{"kind":"text","text":", "},{"text":"toByteOffset","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"offset","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","preciseIdentifier":"s:Si"},{"text":" = 0, ","kind":"text"},{"text":"as","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"type","kind":"internalParam"},{"kind":"text","text":": "},{"text":"T","kind":"typeIdentifier","preciseIdentifier":"s:Sw10storeBytes2of12toByteOffset2asyx_SixmtlF1TL_xmfp"},{"text":".Type)","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"name":"value","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value to store as raw bytes."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The offset in bytes into the buffer pointer’s memory to begin"},{"type":"text","text":" "},{"text":"writing bytes from the value. The default is zero.","type":"text"}],"type":"paragraph"}],"name":"offset"},{"name":"type","content":[{"type":"paragraph","inlineContent":[{"text":"The type to use for the newly constructed instance. The memory","type":"text"},{"text":" ","type":"text"},{"text":"must be initialized to a value of a type that is layout compatible","type":"text"},{"type":"text","text":" "},{"text":"with ","type":"text"},{"type":"codeVoice","code":"type"},{"type":"text","text":"."}]}]}],"kind":"parameters"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The type "},{"code":"T","type":"codeVoice"},{"text":" to be stored must be a trivial type. The memory must also be","type":"text"},{"text":" ","type":"text"},{"text":"uninitialized, initialized to ","type":"text"},{"type":"codeVoice","code":"T"},{"type":"text","text":", or initialized to another trivial"},{"type":"text","text":" "},{"type":"text","text":"type that is layout compatible with "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"The memory written to must not extend beyond the buffer pointer’s memory"},{"text":" ","type":"text"},{"text":"region—that is, ","type":"text"},{"type":"codeVoice","code":"offset + MemoryLayout<T>.size"},{"type":"text","text":" must be less than or"},{"text":" ","type":"text"},{"type":"text","text":"equal to the buffer pointer’s "},{"type":"codeVoice","code":"count"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"After calling ","type":"text"},{"type":"codeVoice","code":"storeBytes(of:toByteOffset:as:)"},{"type":"text","text":", the memory is"},{"type":"text","text":" "},{"type":"text","text":"initialized to the raw bytes of "},{"type":"codeVoice","code":"value"},{"type":"text","text":". If the memory is bound to a"},{"text":" ","type":"text"},{"text":"type ","type":"text"},{"type":"codeVoice","code":"U"},{"type":"text","text":" that is layout compatible with "},{"type":"codeVoice","code":"T"},{"type":"text","text":", then it contains a value of"},{"type":"text","text":" "},{"type":"text","text":"type "},{"code":"U","type":"codeVoice"},{"type":"text","text":". Calling "},{"type":"codeVoice","code":"storeBytes(of:toByteOffset:as:)"},{"type":"text","text":" does not change the"},{"type":"text","text":" "},{"type":"text","text":"bound type of the memory."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A trivial type can be copied with just a bit-for-bit copy without","type":"text"},{"text":" ","type":"text"},{"text":"any indirection or reference-counting operations. Generally, native","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Swift types that do not contain strong or weak references or other"},{"type":"text","text":" "},{"type":"text","text":"forms of indirection are trivial, as are imported C structs and enums."}]}],"style":"note","type":"aside","name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need to store into memory a copy of a value of a type that isn’t"},{"type":"text","text":" "},{"type":"text","text":"trivial, you cannot use the "},{"type":"codeVoice","code":"storeBytes(of:toByteOffset:as:)"},{"type":"text","text":" method."},{"type":"text","text":" "},{"type":"text","text":"Instead, you must know either initialize the memory or,"},{"type":"text","text":" "},{"type":"text","text":"if you know the memory was already bound to "},{"type":"codeVoice","code":"type"},{"type":"text","text":", assign to the memory."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/unsafemutablerawbufferpointer\/storebytes(of:tobyteoffset:as:)"]}],"metadata":{"extendedModule":"Swift","symbolKind":"method","title":"storeBytes(of:toByteOffset:as:)","platforms":[{"beta":false,"deprecated":false,"name":"iOS","unavailable":false,"introducedAt":"8.0"},{"beta":false,"deprecated":false,"name":"iPadOS","unavailable":false,"introducedAt":"8.0"},{"beta":false,"deprecated":false,"name":"Mac Catalyst","unavailable":false,"introducedAt":"13.0"