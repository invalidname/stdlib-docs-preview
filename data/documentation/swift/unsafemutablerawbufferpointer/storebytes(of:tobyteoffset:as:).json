{"abstract":[{"type":"text","text":"Stores a value’s bytes into the buffer pointer’s raw memory at the"},{"type":"text","text":" "},{"type":"text","text":"specified byte offset."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/unsafemutablerawbufferpointer\/storebytes(of:tobyteoffset:as:)"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawBufferPointer\/storeBytes(of:toByteOffset:as:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawBufferPointer"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@export(implementation)"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"storeBytes"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"value"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sw10storeBytes2of12toByteOffset2asyx_SixmtlF1TL_xmfp","kind":"typeIdentifier","text":"T"},{"kind":"text","text":", "},{"kind":"externalParam","text":"toByteOffset"},{"kind":"text","text":" "},{"kind":"internalParam","text":"offset"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","preciseIdentifier":"s:Si"},{"text":" = 0, ","kind":"text"},{"kind":"externalParam","text":"as"},{"text":" ","kind":"text"},{"text":"type","kind":"internalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"T","preciseIdentifier":"s:Sw10storeBytes2of12toByteOffset2asyx_SixmtlF1TL_xmfp"},{"kind":"text","text":".Type)"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The value to store as raw bytes.","type":"text"}],"type":"paragraph"}],"name":"value"},{"content":[{"inlineContent":[{"text":"The offset in bytes into the buffer pointer’s memory to begin","type":"text"},{"type":"text","text":" "},{"type":"text","text":"writing bytes from the value. The default is zero."}],"type":"paragraph"}],"name":"offset"},{"content":[{"inlineContent":[{"type":"text","text":"The type to use for the newly constructed instance. The memory"},{"text":" ","type":"text"},{"type":"text","text":"must be initialized to a value of a type that is layout compatible"},{"text":" ","type":"text"},{"type":"text","text":"with "},{"type":"codeVoice","code":"type"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"type"}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"The type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" to be stored must be a trivial type. The memory must also be"},{"type":"text","text":" "},{"type":"text","text":"uninitialized, initialized to "},{"type":"codeVoice","code":"T"},{"type":"text","text":", or initialized to another trivial"},{"type":"text","text":" "},{"text":"type that is layout compatible with ","type":"text"},{"type":"codeVoice","code":"T"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The memory written to must not extend beyond the buffer pointer’s memory","type":"text"},{"type":"text","text":" "},{"type":"text","text":"region—that is, "},{"type":"codeVoice","code":"offset + MemoryLayout<T>.size"},{"type":"text","text":" must be less than or"},{"type":"text","text":" "},{"type":"text","text":"equal to the buffer pointer’s "},{"type":"codeVoice","code":"count"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"After calling "},{"type":"codeVoice","code":"storeBytes(of:toByteOffset:as:)"},{"type":"text","text":", the memory is"},{"type":"text","text":" "},{"type":"text","text":"initialized to the raw bytes of "},{"code":"value","type":"codeVoice"},{"text":". If the memory is bound to a","type":"text"},{"text":" ","type":"text"},{"text":"type ","type":"text"},{"type":"codeVoice","code":"U"},{"type":"text","text":" that is layout compatible with "},{"code":"T","type":"codeVoice"},{"text":", then it contains a value of","type":"text"},{"text":" ","type":"text"},{"text":"type ","type":"text"},{"code":"U","type":"codeVoice"},{"text":". Calling ","type":"text"},{"code":"storeBytes(of:toByteOffset:as:)","type":"codeVoice"},{"type":"text","text":" does not change the"},{"type":"text","text":" "},{"type":"text","text":"bound type of the memory."}],"type":"paragraph"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A trivial type can be copied with just a bit-for-bit copy without"},{"type":"text","text":" "},{"type":"text","text":"any indirection or reference-counting operations. Generally, native"},{"type":"text","text":" "},{"type":"text","text":"Swift types that do not contain strong or weak references or other"},{"type":"text","text":" "},{"type":"text","text":"forms of indirection are trivial, as are imported C structs and enums."}]}],"style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"text":"If you need to store into memory a copy of a value of a type that isn’t","type":"text"},{"type":"text","text":" "},{"text":"trivial, you cannot use the ","type":"text"},{"code":"storeBytes(of:toByteOffset:as:)","type":"codeVoice"},{"text":" method.","type":"text"},{"type":"text","text":" "},{"text":"Instead, you must know either initialize the memory or,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"if you know the memory was already bound to "},{"code":"type","type":"codeVoice"},{"type":"text","text":", assign to the memory."}]}],"kind":"content"}],"metadata":{"externalID":"s:Sw10storeBytes2of12toByteOffset2asyx_SixmtlF","