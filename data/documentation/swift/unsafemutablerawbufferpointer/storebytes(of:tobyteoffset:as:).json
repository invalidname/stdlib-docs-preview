d":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" to be stored must be a trivial type. The memory must also be"},{"type":"text","text":" "},{"type":"text","text":"uninitialized, initialized to "},{"type":"codeVoice","code":"T"},{"type":"text","text":", or initialized to another trivial"},{"type":"text","text":" "},{"type":"text","text":"type that is layout compatible with "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The memory written to must not extend beyond the buffer pointer’s memory"},{"type":"text","text":" "},{"type":"text","text":"region—that is, "},{"type":"codeVoice","code":"offset + MemoryLayout<T>.size"},{"type":"text","text":" must be less than or"},{"type":"text","text":" "},{"type":"text","text":"equal to the buffer pointer’s "},{"type":"codeVoice","code":"count"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After calling "},{"type":"codeVoice","code":"storeBytes(of:toByteOffset:as:)"},{"type":"text","text":", the memory is"},{"type":"text","text":" "},{"type":"text","text":"initialized to the raw bytes of "},{"type":"codeVoice","code":"value"},{"type":"text","text":". If the memory is bound to a"},{"type":"text","text":" "},{"type":"text","text":"type "},{"type":"codeVoice","code":"U"},{"type":"text","text":" that is layout compatible with "},{"type":"codeVoice","code":"T"},{"type":"text","text":", then it contains a value of"},{"type":"text","text":" "},{"type":"text","text":"type "},{"type":"codeVoice","code":"U"},{"type":"text","text":". Calling "},{"type":"codeVoice","code":"storeBytes(of:toByteOffset:as:)"},{"type":"text","text":" does not change the"},{"type":"text","text":" "},{"type":"text","text":"bound type of the memory."}]},{"name":"Note","type":"a