ind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"externalParam","text":"_"},{"text":" ","kind":"text"},{"text":"buffer","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableBufferPointer","kind":"typeIdentifier","preciseIdentifier":"s:Sr","text":"UnsafeMutableBufferPointer"},{"text":"<","kind":"text"},{"text":"T","kind":"typeIdentifier","preciseIdentifier":"s:Sw17withMemoryRebound2to_q0_xm_q0_SryxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1TL_xmfp"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"E","kind":"typeIdentifier","preciseIdentifier":"s:Sw17withMemoryRebound2to_q0_xm_q0_SryxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1EL_q_mfp"},{"text":") -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier","preciseIdentifier":"s:Sw17withMemoryRebound2to_q0_xm_q0_SryxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF6ResultL_q0_mfp"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"E","kind":"typeIdentifier","preciseIdentifier":"s:Sw17withMemoryRebound2to_q0_xm_q0_SryxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1EL_q_mfp"},{"kind":"text","text":") -> "},{"text":"Result","kind":"typeIdentifier","preciseIdentifier":"s:Sw17withMemoryRebound2to_q0_xm_q0_SryxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF6ResultL_q0_mfp"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP","text":"Error"},{"text":", ","kind":"text"},{"kind":"typeIdentifier","text":"T"},{"text":" : ~Copyable, ","kind":"text"},{"kind":"typeIdentifier","text":"Result"},{"text":" : ~Copyable","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"type","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The type to temporarily bind the memory referenced by this"},{"type":"text","text":" "},{"type":"text","text":"buffer."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that takes a typed pointer to the"},{"type":"text","text":" "},{"type":"text","text":"same memory as this pointer, only bound to type "},{"type":"codeVoice","code":"T"},{"type":"text","text":". The closure’s"},{"type":"text","text":" "},{"type":"text","text":"pointer argument is valid only for the duration of the closure’s"},{"type":"text","text":" "},{"type":"text","text":"execution. If "},{"code":"body","type":"codeVoice"},{"type":"text","text":" has a return value, that value is also used as"},{"type":"text","text":" "},{"type":"text","text":"the return value for the "},{"type":"codeVoice","code":"withMemoryRebound(to:capacity:_:)"},{"type":"text","text":" method."}]},{"type":"termList","items":[{"term":{"inlineContent":[{"type":"text","text":"buffer"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The buffer temporarily bound to instances of "},{"code":"T","type":"codeVoice"},{"text":".","type":"text"}]}]}}]}],"name":"body"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"code":"body","type":"codeVoice"},{"text":" closure parameter.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Use this method when you have a buffer to raw memory and you need","type":"text"},{"text":" ","type":"text"},{"text":"to access that memory as instances of a given type ","type":"text"},{"code":"T","type":"codeVoice"},{"type":"text","text":". Accessing"},{"type":"text","text":" "},{"type":"text","text":"memory as a type "},{"type":"codeVoice","code":"T"},{"text":" requires that the memory be bound to that type.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"A memory location may only be bound to one type at a time, so accessing"},{"text":" ","type":"text"},{"text":"the same memory as an unrelated type without first rebinding the memory","type":"text"},{"text":" ","type":"text"},{"text":"is undefined.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Any instance of "},{"code":"T","type":"codeVoice"},{"type":"text","text":" within the re-bound region may be initialized or"},{"type":"text","text":" "},{"type":"text","text":"uninitialized. The memory underlying any individual instance of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" "},{"text":"must have the same initialization state (i.e.  initialized or","type":"text"},{"text":" ","type":"text"},{"text":"uninitialized.) Accessing a ","type":"text"},{"code":"T","type":"codeVoice"},{"type":"text","text":" whose underlying memory"},{"text":" ","type":"text"},{"type":"text","text":"is in a mixed initialization state shall be undefined behaviour."}],"type":"paragraph"},{"inlineContent":[{"text":"If the byte count of the original buffer is not a multiple of","type":"text"},{"text":" ","type":"text"},{"text":"the stride of ","type":"text"},{"type":"codeVoice","code":"T"},{"type":"text","text":", then the re-bound buffer is shorter"},{"type":"text","text":" "},{"text":"than the original buffer.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"After executing "},{"code":"body","type":"codeVoice"},{"type":"text","text":", this method rebinds memory back to its original"},{"type":"text","text":" "},{"type":"text","text":"binding state. This can be unbound memory, or bound to a different type."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The buffer’s base address must match the"},{"type":"text","text":" "},{"type":"text","text":"alignment of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" (as reported by "},{"type":"codeVoice","code":"MemoryLayout<T>.alignment"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"That is, ","type":"text"},{"code":"Int(bitPattern: self.baseAddress) % MemoryLayout<T>.alignment","type":"codeVoice"},{"text":" ","type":"text"},{"text":"must equal zero.","type":"text"}]}]},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A raw buffer may represent memory that has been bound to a type."},{"type":"text","text":" "},{"text":"If that is the case, then ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" must be layout compatible with the","type":"text"},{"text":" ","type":"text"},{"text":"type to which the memory has been bound. This requirement does not","type":"text"},{"text":" ","type":"text"},{"text":"apply if the raw buffer represents memory that has not been bound","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to any type."}]}],"style":"note"}],"kind":"content"}],"abstract":[{"type":"text","text":"Executes the given closure while temporarily binding the buffer to"},{"text":" ","type":"text"},{"text":"instances of type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawBufferPointer"]]},"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/Error":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","title":"Error","role":"symbol","abstract":[{"type":"text","text":"A type representing an error value that can be thrown."}],"type":"topic","url":"\/documentation\/swift\/error","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Error","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Error","kind":"identifier"}]},"doc:/