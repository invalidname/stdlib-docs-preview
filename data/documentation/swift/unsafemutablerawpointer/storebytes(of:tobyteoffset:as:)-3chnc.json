ext":"The type of ","type":"text"},{"code":"value","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" to be stored must be a trivial type. The memory","type":"text"},{"text":" ","type":"text"},{"text":"must also be uninitialized, initialized to ","type":"text"},{"code":"T","type":"codeVoice"},{"text":", or initialized to","type":"text"},{"text":" ","type":"text"},{"text":"another trivial type that is layout compatible with ","type":"text"},{"code":"T","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"After calling ","type":"text"},{"code":"storeBytes(of:toByteOffset:as:)","type":"codeVoice"},{"text":", the memory is","type":"text"},{"text":" ","type":"text"},{"text":"initialized to the raw bytes of ","type":"text"},{"code":"value","type":"codeVoice"},{"text":". If the memory is bound to a","type":"text"},{"text":" ","type":"text"},{"text":"type ","type":"text"},{"code":"U","type":"codeVoice"},{"text":" that is layout compatible with ","type":"text"},{"code":"T","type":"codeVoice"},{"text":", then it contains a value of","type":"text"},{"text":" ","type":"text"},{"text":"type ","type":"text"},{"code":"U","type":"codeVoice"},{"text":". Calling ","type":"text"},{"code":"storeBytes(of:toByteOffset:as:)","type":"codeVoice"},{"type":"text","text":" does not change the"},{"type":"text","text":" "},{"type":"text","text":"bound type of the memory."}]},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A trivial type can be copied with just a bit-for-bit copy without"},{"type":"text","text":" "},{"type":"text","text":"any indirection or reference-counting operations. Generally, native"},{"type":"text","text":" "},{"type":"text","text":"Swift types that do not contain strong or weak references or other"},{"type":"text","text":" "},{"type":"text","text":"forms of indirection are trivial, as are imported C structs and enums."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need to store into memory a copy of a value of a type that isn’t"},{"type":"text","text":" "},{"type":"text","text":"trivial, you cannot use the "},{"code":"storeBytes(of:toByteOffset:as:)","type":"codeVoice"},{"type":"text","text":" method."},{"type":"text","text":" "},{"type":"text","text":"Instead, you must know either initialize the memory or,"},{"type":"text","text":" "},{"text":"if you know the memory was already bound to ","type":"text"},{"code":"type","type":"codeVoice"},{"text":", assign to the memory.","type":"text"},{"type":"text","text":" "},{"text":"For example, to replace a value stored in a raw pointer ","type":"text"},{"code":"p","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"text":"where ","type":"text"},{"code":"U","type":"codeVoice"},{"text":" is the current type and ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" is the new type, use a typed","type":"text"},{"text":" ","type":"text"},{"text":"pointer to access and deinitialize the current value before initializing","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the memory with a new value:"}]},{"type":"codeListing","code":["let typedPointer = p.bindMemory(to: U.self, capacity: 1)","typedPointer.deinitialize(count: 1)","p.initializeMemory(as: T.self, repeating: newValue, count: 1)"],"syntax":"swift"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/unsafemutablerawpointer\/storebytes(of:tobyteoffset:as:)-3chnc"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawPointer\/storeBytes(of