"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The type "},{"code":"T","type":"codeVoice"},{"type":"text","text":" to be stored must be a trivial type. The memory"},{"type":"text","text":" "},{"type":"text","text":"must also be uninitialized, initialized to "},{"code":"T","type":"codeVoice"},{"type":"text","text":", or initialized to"},{"type":"text","text":" "},{"type":"text","text":"another trivial type that is layout compatible with "},{"code":"T","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After calling "},{"code":"storeBytes(of:toByteOffset:as:)","type":"codeVoice"},{"type":"text","text":", the memory is"},{"type":"text","text":" "},{"type":"text","text":"initialized to the raw bytes of "},{"code":"value","type":"codeVoice"},{"type":"text","text":". If the memory is bound to a"},{"type":"text","text":" "},{"type":"text","text":"type "},{"code":"U","type":"codeVoice"},{"type":"text","text":" that is layout compatible with "},{"code":"T","type":"codeVoice"},{"type":"text","text":", then it contains a value of"},{"type":"text","text":" "},{"type":"text","text":"type "},{"code":"U","type":"codeVoice"},{"type":"text","text":". Calling "},{"code":"storeBytes(of:toByteOffset:as:)","type":"codeVoice"},{"type":"text","text":" does not change the"},{"type":"text","text":" "},{"type":"text","text":"bound type of the memory."}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"A trivial type can be copied with just a bit-for-bit copy without"},{"type":"text","text":" "},{"type":"text","text":"any indirection or reference-counting operations. Generally, native"},{"type":"text","text":" "},{"type":"text","text":"Swift types that do not contain strong or weak references or other"},{"type":"text","text":" "},{"type":"text","text":"forms of indirection are trivial, as are imported C structs and enums."}],"type":"paragraph"}],"name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need to store into memory a copy of a value of a type that isn’t"},{"type":"text","text":" "},{"type":"text","text":"trivial, you cannot use the "},{"code":"storeBytes(of:toByteOffset:as:)","type":"codeVoice"},{"type":"text","text":" method."},{"type":"text","text":" "},{"type":"text","text":"Instead, you must know either initialize the memory or,"},{"type":"text","text":" "},{"type":"text","text":"if you know the memory was already bound to "},{"code":"type","type":"codeVoice"},{"type":"text","text":", assign to the memory."},{"type":"text","text":" "},{"type":"text","text":"For example, to replace a value stored in a raw pointer "},{"code":"p","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"where "},{"code":"U","type":"codeVoice"},{"type":"text","text":" is the current type and "},{"code":"T","type":"codeVoice"},{"type":"text","text":" is the new type, use a typed"},{"type":"text","text":" "},{"type":"text","text":"pointer to access and deinitialize the current value before initializing"},{"type":"text","text":" "},{"type":"text","text":"the memory with a new value:"}]},{"type":"codeListing","code":["let typedPointer = p.bindMemory(to: U.self, capacity: 1)","typedPointer.deinitialize(count: 1)","p.initializeMemory(as: T.self, repeating: newValue, count: 1)"],"syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawPointer"]]},"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/Int":{"title":"Int","url":"\/documentation\/swift\/int","navigatorTitle":[{"kind":"identifier","text":"Int"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Int","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/com.apple.Swift