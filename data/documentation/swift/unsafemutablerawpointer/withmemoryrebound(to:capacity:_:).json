},{"text":"uninitialized.) Accessing a ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" whose underlying memory","type":"text"},{"text":" ","type":"text"},{"text":"is in a mixed initialization state shall be undefined behaviour.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example temporarily rebinds a raw memory pointer"},{"type":"text","text":" "},{"type":"text","text":"to "},{"code":"Int64","type":"codeVoice"},{"type":"text","text":", then modifies the signed integer."}]},{"syntax":"swift","type":"codeListing","code":["let pointer: UnsafeMutableRawPointer = fetchValue()","pointer.withMemoryRebound(to: Int64.self, capacity: 1) {","    $0.pointee.negate()","}"]},{"inlineContent":[{"type":"text","text":"After executing "},{"type":"codeVoice","code":"body"},{"type":"text","text":", this method rebinds memory back to its original"},{"type":"text","text":" "},{"type":"text","text":"binding state. This can be unbound memory, or bound to a different type."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The region of memory starting at this pointer must match the"},{"type":"text","text":" "},{"type":"text","text":"alignment of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" (as reported by "},{"type":"codeVoice","code":"MemoryLayout<T>.alignment"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"That is, "},{"type":"codeVoice","code":"Int(bitPattern: self) % MemoryLayout<T>.alignment"},{"type":"text","text":" "},{"type":"text","text":"must equal zero."}]}],"name":"Note","type":"aside"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The region of memory starting at this pointer may have been"},{"type":"text","text":" "},{"type":"text","text":"bound to a type. If that is the case, then "},{"code":"T","type":"codeVoice"},{"type":"text","text":" must be"},{"text":" 