"text":"execution. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" has a return value, that value is also used as"},{"type":"text","text":" "},{"type":"text","text":"the return value for the "},{"type":"codeVoice","code":"withMemoryRebound(to:capacity:_:)"},{"type":"text","text":" method."}],"type":"paragraph"}],"name":"body"}]},{"kind":"content","content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"code":"body","type":"codeVoice"},{"type":"text","text":" closure parameter."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Use this method when you have a pointer to raw memory and you need"},{"type":"text","text":" "},{"type":"text","text":"to access that memory as instances of a given type "},{"code":"T","type":"codeVoice"},{"type":"text","text":". Accessing"},{"type":"text","text":" "},{"type":"text","text":"memory as a type "},{"code":"T","type":"codeVoice"},{"type":"text","text":" requires that the memory be bound to that type. A"},{"type":"text","text":" "},{"type":"text","text":"memory location may only be bound to one type at a time, so accessing"},{"type":"text","text":" "},{"type":"text","text":"the same memory as an unrelated type without first rebinding the memory"},{"type":"text","text":" "},{"type":"text","text":"is undefined."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Any instance of "},{"code":"T","type":"codeVoice"},{"type":"text","text":" within the re-bound region may be initialized or"},{"type":"text","text":" "},{"type":"text","text":"uninitialized. The memory underlying any individual instance of "},{"code":"T","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"must have the same initialization state (i.e.  initialized or"},{"type":"text","text":" "},{"type":"text","text":"uninitialized.) Accessing a "},{"code":"T","type":"codeVoice"},{"type":"text","text":" whose underlying memory"},{"type":"text","text":" "},{"type":"text","text":"is in a mixed initialization state shall be undefined behaviour."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example temporarily rebinds a raw memory pointer"},{"type":"text","text":" "},{"type":"text","text":"to "},{"code":"Int64","type":"codeVoice"},{"type":"text","text":", then modifies the signed integer."}],"type":"paragraph"},{"code":["let pointer: UnsafeMutableRawPointer = fetchValue()","pointer.withMemoryRebound(to: Int64.self, capacity: 1) {","    $0.pointee.negate()","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"After executing "},{"code":"body","type":"codeVoice"},{"type":"text","text":", this method rebinds memory back to its original"},{"type":"text","text":" "},{"type":"text","text":"binding state. This can be unbound memory, or bound to a different type."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"The region of memory starting at this pointer must match the"},{"type":"text","text":" "},{"type":"text","text":"alignment of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" (as reported by "},{"type":"codeVoice","code":"MemoryLayout<T>.alignment"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"That is, "},{"type":"codeVoice","code":"Int(bitPattern: self) % MemoryLayout<T>.alignment"},{"type":"text","text":" "},{"type":"text","text":"must equal zero."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"content":[{"inlineContent":[{"type":"text","text":"The region of memory starting at this pointer may have been"},{"type":"text","text":" "},{"type":"text","text":"bound to a type. If that is the case, then "},{"type":"codeVoice","code":"T"},{"type":"text","text":" must be"},{"type":"text","text":" "},{"type":"text","text":"layout compatible with the type to which the memory has been bound."},{"type":"text","text":" "},{"type":"text","text":"This requirement does not apply if the region of memory"},{"type":"text","text":" "},{"type":"text","text":"has not been bound to any type."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawPointer\/withMemoryRebound(to:capacity:_:)"},"metadata":{"title":"withMemoryRebound(to:capacity:_:)","externalID":"s:Sv17withMemoryRebound2to8capacity_q0_xm_Siq0_SpyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF","symbolKind":"method","platforms":[{"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"8.0","name":"iPadOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"13.0","name":"Mac Catalyst","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"10.10","name":"macOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"9.0","name":"tvOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"1.0","name":"visionOS","deprecated":false},{"beta":false,"unavailable":false,"introducedAt":"2.0","name":"watchOS","deprecated":false}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withMemoryRebound","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Result","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sv17withMemoryRebound2to8capacity_q0_xm_Siq0_SpyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1TL_xmfp","text":"T","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"capac