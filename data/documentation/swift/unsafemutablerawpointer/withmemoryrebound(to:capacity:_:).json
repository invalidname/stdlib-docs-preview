ext":" closure parameter.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Use this method when you have a pointer to raw memory and you need","type":"text"},{"text":" ","type":"text"},{"text":"to access that memory as instances of a given type ","type":"text"},{"type":"codeVoice","code":"T"},{"text":". Accessing","type":"text"},{"text":" ","type":"text"},{"text":"memory as a type ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" requires that the memory be bound to that type. A","type":"text"},{"text":" ","type":"text"},{"text":"memory location may only be bound to one type at a time, so accessing","type":"text"},{"text":" ","type":"text"},{"text":"the same memory as an unrelated type without first rebinding the memory","type":"text"},{"text":" ","type":"text"},{"text":"is undefined.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Any instance of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" within the re-bound region may be initialized or","type":"text"},{"text":" ","type":"text"},{"text":"uninitialized. The memory underlying any individual instance of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" ","type":"text"},{"text":"must have the same initialization state (i.e.  initialized or","type":"text"},{"text":" ","type":"text"},{"text":"uninitialized.) Accessing a ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" whose underlying memory","type":"text"},{"text":" ","type":"text"},{"text":"is in a mixed initialization state shall be undefined behaviour.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example temporarily rebinds a raw memory pointer","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":"Int64"},{"text":", then modifies the signed integer.","type":"text"}],"type":"paragraph"},{"code":["let pointer: UnsafeMutableRawPointer = fetchValue()","pointer.withMemoryRebound(to: Int64.self, capacity: 1) {","    $0.pointee.negate()","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"After executing ","type":"text"},{"type":"codeVoice","code":"body"},{"text":", this method rebinds memory back to its original","type":"text"},{"text":" ","type":"text"},{"text":"binding state. This can be unbound memory, or bound to a different type.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The region of memory starting at this pointer must match the","type":"text"},{"text":" ","type":"text"},{"text":"alignment of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" (as reported by ","type":"text"},{"code":"MemoryLayout<T>.alignment","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"That is, ","type":"text"},{"code":"Int(bitPattern: self) % MemoryLayout<T>.alignment","type":"codeVoice"},{"text":" ","type":"text"},{"text":"must equal zero.","type":"text"}]}],"style":"note","type":"aside","name":"Note"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The region of memory starting at this pointer may have been","type":"text"},{"text":" ","type":"text"},{"text":"bound to a type. If that is the case, then ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" must be","type":"text"},{"text":" ","type":"text"},{"text":"layout compatible with the type to which the memory has been bound.","type":"text"},{"text":" ","type":"text"},{"text":"This requirement does not apply if the region of memory","type":"text"},{"text":" ","type":"text"},{"text":"has not been bound to any type.","type":"text"}]}],"style":"note","type":"aside","name":"Note"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawPointer"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.app