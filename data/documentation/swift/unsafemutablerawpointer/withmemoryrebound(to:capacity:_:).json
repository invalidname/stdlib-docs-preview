xt"},{"text":"is in a mixed initialization state shall be undefined behaviour.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example temporarily rebinds a raw memory pointer","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":"Int64"},{"type":"text","text":", then modifies the signed integer."}],"type":"paragraph"},{"code":["let pointer: UnsafeMutableRawPointer = fetchValue()","pointer.withMemoryRebound(to: Int64.self, capacity: 1) {","    $0.pointee.negate()","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"After executing ","type":"text"},{"type":"codeVoice","code":"body"},{"text":", this method rebinds memory back to its original","type":"text"},{"text":" ","type":"text"},{"text":"binding state. This can be unbound memory, or bound to a different type.","type":"text"}],"type":"paragraph"},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The region of memory starting at this pointer must match the"},{"type":"text","text":" "},{"type":"text","text":"alignment of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" (as reported by "},{"type":"codeVoice","code":"MemoryLayout<T>.alignment"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"That is, "},{"type":"codeVoice","code":"Int(bitPattern: self) % MemoryLayout<T>.alignment"},{"type":"text","text":" "},{"type":"text","text":"must equal zero."}]}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The region of memory starting at this pointer may have been"},{"type":"text","text":" "},{"type":"text","text":"bound to a type. If that is the case, then "},{"type":"codeVoice","code":"T"},{"type":"text","text":" must be"},{"type":"text","text":" "},{"type":"text","text":"layout compatible with the type to which the memory has been bound."},{"type":"text","t