{"seeAlsoSections":[{"title":"Typed Pointers","generated":true,"anchor":"Typed-Pointers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutablePointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeBufferPointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableBufferPointer"]}],"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnsafePointer","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Pointee","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Pointee","kind":"typeIdentifier"},{"text":" : ~Copyable","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/com.apple.Swift\/documentation\/Swift\/using-imported-c-functions-in-swift"],"kind":"mentions"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"You use instances of the ","type":"text"},{"code":"UnsafePointer","type":"codeVoice"},{"text":" type to access data of a","type":"text"},{"text":" ","type":"text"},{"text":"specific type in memory. The type of data that a pointer can access is the","type":"text"},{"text":" ","type":"text"},{"text":"pointer’s ","type":"text"},{"code":"Pointee","type":"codeVoice"},{"text":" type. ","type":"text"},{"code":"UnsafePointer","type":"codeVoice"},{"text":" provides no automated","type":"text"},{"text":" ","type":"text"},{"text":"memory management or alignment guarantees. You are responsible for","type":"text"},{"text":" ","type":"text"},{"text":"handling the life cycle of any memory you work with through unsafe","type":"text"},{"text":" ","type":"text"},{"text":"pointers to avoid leaks or undefined behavior.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Memory that you manually manage can be either ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"untyped"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"text":"bound","type":"text"}]},{"text":" to a","type":"text"},{"text":" ","type":"text"},{"text":"specific type. You use the ","type":"text"},{"code":"UnsafePointer","type":"codeVoice"},{"text":" type to access and","type":"text"},{"text":" ","type":"text"},{"text":"manage memory that has been bound to a specific type.","type":"text"}]},{"level":1,"type":"heading","text":"Understanding a Pointer’s Memory State","anchor":"Understanding-a-Pointers-Memory-State"},{"type":"paragraph","inlineContent":[{"text":"The memory referenced by an ","type":"text"},{"code":"UnsafePointer","type":"codeVoice"},{"text":" instance can be in","type":"text"},{"text":" ","type":"text"},{"text":"one of several states. Many pointer operations must only be applied to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"pointers with memory in a specific state—you must keep track of the"},{"text":" ","type":"text"},{"text":"state of the memory you are working with and understand the changes to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"that state that different operations perform. Memory can be untyped and"},{"type":"text","text":" "},{"text":"uninitialized, bound to a type and uninitialized, or bound to a type and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"initialized to a value. Finally, memory that was allocated previously may"},{"type":"text","text":" "},{"type":"text","text":"have been deallocated, leaving existing pointers referencing unallocated"},{"type":"text","text":" "},{"text":"memory.","type":"text"}]},{"text":"Uninitialized Memory","type":"heading","anchor":"Uninitialized-Memory","level":2},{"type":"paragraph","inlineContent":[{"text":"Memory that has just been allocated through a typed pointer or has been","type":"text"},{"text":" ","type":"text"},{"text":"deinitialized is in an ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"uninitialized","type":"text"}]},{"text":" state. Uninitialized memory must be","type":"text"},{"text":" ","type":"text"},{"text":"initialized before it can be accessed for reading.","type":"text"}]},{"level":2,"type":"heading","text":"Initialized Memory","anchor":"Initialized-Memory"},{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"text":"Initialized","type":"text"}]},{"type":"text","text":" memory has a value that can be read using a pointer’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"pointee"},{"text":" property or through subscript notation. In the following","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"example, "},{"code":"ptr","type":"codeVoice"},{"text":" is a pointer to memory initialized with a value of ","type":"text"},{"type":"codeVoice","code":"23"},{"type":"text","text":":"}]},{"code":["let ptr: UnsafePointer<Int> = ...","\/\/ ptr.pointee == 23","\/\/ ptr[0] == 23"],"type":"codeListing","syntax":"swift"},{"anchor":"Accessing-a-Pointers-Memory-as-a-Different-Type","text":"Accessing a Pointer’s Memory as a Different Type","type":"heading","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you access memory through an "},{"type":"codeVoice","code":"UnsafePointer"},{"text":" instance, the","type":"text"},{"text":" ","type":"text"},{"code":"Pointee","type":"codeVoice"},{"type":"text","text":" type must be consistent with the bound type of the memory. If"},{"type":"text","text":" "},{"type":"text","text":"you do need to access memory that is bound to one type as a different"},{"type":"text","text":" "},{"type":"text","text":"type, Swift’s pointer types provide type-safe ways to temporarily or"},{"type":"text","text":" "},{"type":"text","text":"permanently change the bound type of the memory, or to load typed"},{"type":"text","text":" "},{"type":"text","text":"instances directly from raw memory."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"code":"UnsafePointer<UInt8>","type":"codeVoice"},{"type":"text","text":" instance allocated with eight bytes of"},{"type":"text","text":" "},{"type":"text","text":"memory, "},{"code":"uint8Pointer","type":"codeVoice"},{"type":"text","text":", will be used for the examples below."}]},{"code":["let uint8Pointer: UnsafePointer<UInt8> = fetchEightBytes()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you only need to temporarily access a pointer’s memory as a different"},{"type":"text","text":" "},{"type":"text","text":"type, use the "},{"code":"withMemoryRebound(to:capacity:)","type":"codeVoice"},{"type":"text","text":" method. For example, you"},{"type":"text","text":" "},{"type":"text","text":"can use this method to call an API that expects a pointer to a different"},{"type":"text","text":" "},{"type":"text","text":"type that is layout compatible with your pointer’s "},{"code":"Pointee","type":"codeVoice"},{"type":"text","text":". The following"},{"type":"text","text":" "},{"type":"text","text":"code temporarily rebinds the memory that "},{"code":"uint8Pointer","type":"codeVoice"},{"type":"text","text":" references from"},{"type":"text","text":" "},{"code":"UInt8","type":"codeVoice"},{"type":"text","text":" to "},{"code":"Int8","type":"codeVoice"},{"type":"text","text":" to call the imported C "},{"code":"strlen","type":"codeVoice"},{"type":"text","text":" function."}]},{"code":["\/\/ Imported from C","func strlen(_ __s: UnsafePointer<Int8>!) -> UInt","","let length = uint8Pointer.withMemoryRebound(to: Int8.self, capacity: 8) {","    return strlen($0)","}","\/\/ length == 7"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you need to permanently rebind memory to a different type, first"},{"type":"text","text":" "},{"type":"text","text":"obtain a raw pointer to the memory and then call the"},{"type":"text","text":" "},{"code":"bindMemory(to:capacity:)","type":"codeVoice"},{"type":"text","text":" method on the raw pointer. The following"},{"type":"text","text":" "},{"type":"text","text":"example binds the memory referenced by "},{"code":"uint8Pointer","type":"codeVoice"},{"type":"text","text":" to one instance of"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"UInt64","type":"codeVoice"},{"type":"text","text":" type:"}]},{"code":["let uint64Pointer = UnsafeRawPointer(uint8Pointer)","                          .bindMemory(to: UInt64.self, capacity: 1)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After rebinding the memory referenced by "},{"code":"uint8Pointer","type":"codeVoice"},{"type":"text","text":" to "},{"code":"UInt64","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"accessing that pointer’s referenced memory as a "},{"code":"UInt8","type":"codeVoice"},{"type":"text","text":" instance is"},{"type":"text","text":" "},{"type":"text","text":"undefined."}]},{"code":["var fullInteger = uint64Pointer.pointee          \/\/ OK","var firstByte = uint8Pointer.pointee             \/\/ undefined"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alternatively, you can access the same memory as a different type without"},{"type":"text","text":" "},{"type":"text","text":"rebinding through untyped memory access, so long as the bound type and the"},{"type":"text","text":" "},{"type":"text","text":"destination type are trivial types. Convert your pointer to an"},{"type":"text","text":" "},{"code":"UnsafeRawPointer","type":"codeVoice"},{"type":"text","text":" instance and then use the raw pointer’s"},{"type":"text","text":" "},{"code":"load(fromByteOffset:as:)","type":"codeVoice"},{"type":"text","text":" method to read values."}]},{"code":["let rawPointer = UnsafeRawPointer(uint64Pointer)","let fullInteger = rawPointer.load(as: UInt64.self)   \/\/ OK","let firstByte = rawPointer.load(as: UInt8.self)      \/\/ OK"],"type":"codeListing","syntax":"swift"},{"anchor":"Performing-Typed-Pointer-Arithmetic","text":"Performing Typed Pointer Arithmetic","type":"heading","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pointer arithmetic with a typed pointer is counted in strides of the"},{"type":"text","text":" "},{"type":"text","text":"pointer’s "},{"code":"Pointee","type":"codeVoice"},{"type":"text","text":" type. When you add to or subtract from an "},{"code":"UnsafePointer","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"instance, the result is a new pointer of the same type, offset by that"},{"type":"text","text":" "},{"type":"text","text":"number of instances of the "},{"code":"Pointee","type":"codeVoice"},{"type":"text","text":" type."}]},{"code":["\/\/ 'intPointer' points to memory initialized with [10, 20, 30, 40]","let intPointer: UnsafePointer<Int> = ...","","\/\/ Load the first value in memory","let x = intPointer.pointee","\/\/ x == 10","","\/\/ Load the third value in memory","let offsetPointer = intPointer + 2","let y = offsetPointer.pointee","\/\/ y == 30"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also use subscript notation to access the value in memory at a"},{"type":"text","text":" "},{"type":"text","text":"specific offset."}]},{"code":["let z = intPointer[2]","\/\/ z == 30"],"type":"codeListing","syntax":"swift"},{"anchor":"Implicit-Casting-and-Bridging","text":"Implicit Casting and Bridging","type":"heading","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"When calling a function or method with an "},{"code":"UnsafePointer","type":"codeVoice"},{"type":"text","text":" parameter, you can pass"},{"type":"text","text":" "},{"type":"text","text":"an instance of that specific pointer type, pass an instance of a"},{"type":"text","text":" "},{"type":"text","text":"compatible pointer type, or use Swift’s implicit bridging to pass a"},{"type":"text","text":" "},{"type":"text","text":"compatible pointer."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, the "},{"code":"printInt(atAddress:)","type":"codeVoice"},{"type":"text","text":" function in the following code"},{"type":"text","text":" "},{"type":"text","text":"sample expects an "},{"code":"UnsafePointer<Int>","type":"codeVoice"},{"type":"text","text":" instance as its first parameter:"}]},{"code":["func printInt(atAddress p: UnsafePointer<Int>) {","    print(p.pointee)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As is typical in Swift, you can call the "},{"code":"printInt(atAddress:)","type":"codeVoice"},{"type":"text","text":" function"},{"type":"text","text":" "},{"type":"text","text":"with an "},{"code":"UnsafePointer","type":"codeVoice"},{"type":"text","text":" instance. This example passes "},{"code":"intPointer","type":"codeVoice"},{"type":"text","text":", a pointer to"},{"type":"text","text":" "},{"type":"text","text":"an "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" value, to "},{"code":"print(address:)","type":"codeVoice"},{"type":"text","text":"."}]},{"code":["printInt(atAddress: intPointer)","\/\/ Prints \"42\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because a mutable typed pointer can be implicitly cast to an immutable"},{"type":"text","text":" "},{"type":"text","text":"pointer with the same "},{"code":"Pointee","type":"codeVoice"},{"type":"text","text":" type when passed as a parameter, you can"},{"type":"text","text":" "},{"type":"text","text":"also call "},{"code":"printInt(atAddress:)","type":"codeVoice"},{"type":"text","text":" with an "},{"code":"UnsafeMutablePointer","type":"codeVoice"},{"type":"text","text":" instance."}]},{"code":["let mutableIntPointer = UnsafeMutablePointer(mutating: intPointer)","printInt(atAddress: mutableIntPointer)","\/\/ Prints \"42\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alternatively, you can use Swift’s "},{"type":"emphasis","inlineContent":[{"type":"text","text":"implicit bridging"}]},{"type":"text","text":" to pass a pointer to"},{"type":"text","text":" "},{"type":"text","text":"an instance or to the elements of an array. The following example passes a"},{"type":"text","text":" "},{"type":"text","text":"pointer to the "},{"type":"codeVoice","code":"value"},{"type":"text","text":" variable by using inout syntax:"}]},{"type":"codeListing","code":["var value: Int = 23","printInt(atAddress: &value)","\/\/ Prints \"23\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"An immutable pointer to the elements of an array is implicitly created when","type":"text"},{"text":" ","type":"text"},{"text":"you pass the array as an argument. This example uses implicit bridging to","type":"text"},{"text":" ","type":"text"},{"text":"pass a pointer to the elements of ","type":"text"},{"code":"numbers","type":"codeVoice"},{"text":" when calling","type":"text"},{"text":" ","type":"text"},{"code":"printInt(atAddress:)","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["let numbers = [5, 10, 15, 20]","printInt(atAddress: numbers)","\/\/ Prints \"5\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also use inout syntax to pass a mutable pointer to the elements of"},{"type":"text","text":" "},{"type":"text","text":"an array. Because "},{"code":"printInt(atAddress:)","type":"codeVoice"},{"type":"text","text":" requires an immutable pointer,"},{"type":"text","text":" "},{"type":"text","text":"although this is syntactically valid, it isn’t necessary."}]},{"code":["var mutableNumbers = numbers","printInt(atAddress: &mutableNumbers)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No matter which way you call "},{"code":"printInt(atAddress:)","type":"codeVoice"},{"type":"text","text":", Swift’s type safety"},{"type":"text","text":" "},{"type":"text","text":"guarantees that you can only pass a pointer to the type required by the"},{"type":"text","text":" "},{"type":"text","text":"function—in this case, a pointer to an "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The pointer created through implicit bridging of an instance"},{"type":"text","text":" "},{"type":"text","text":"or of an array’s elements is only valid during the execution of the"},{"type":"text","text":" "},{"type":"text","text":"called function. Escaping the pointer to use after the execution of the"},{"type":"text","text":" "},{"type":"text","text":"function is undefined behavior. In particular, do not use implicit"},{"type":"text","text":" "},{"type":"text","text":"bridging when calling an "},{"type":"codeVoice","code":"UnsafePointer"},{"type":"text","text":" initializer."}]},{"type":"codeListing","code":["var number = 5","let numberPointer = UnsafePointer<Int>(&number)","\/\/ Accessing 'numberPointer' is undefined behavior."],"syntax":"swift"}],"type":"aside","style":"important","name":"Important"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnsafePointer"}],"navigatorTitle":[{"kind":"identifier","text":"UnsafePointer"}],"roleHeading":"Structure","platforms":[{"introducedAt":"8.0","name":"iOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"8.0","name":"iPadOS","deprecated":false,"unavailable":false,"beta":false},{"intro