qd_1_mfp","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"E","preciseIdentifier":"s:SPsRi_zrlE17withMemoryRebound2to8capacity_qd_1_qd__m_Siqd_1_SPyqd__Gqd_0_YKXEtqd_0_YKs5ErrorRd_0_Ri_d__Ri_d_1_r1_lF1EL_qd_0_mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Result","preciseIdentifier":"s:SPsRi_zrlE17withMemoryRebound2to8capacity_qd_1_qd__m_Siqd_1_SPyqd__Gqd_0_YKXEtqd_0_YKs5ErrorRd_0_Ri_d__Ri_d_1_r1_lF6ResultL_qd_1_mfp","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:s5ErrorP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"T"},{"text":" : ~Copyable, ","kind":"text"},{"kind":"typeIdentifier","text":"Result"},{"text":" : ~Copyable","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The type to temporarily bind the memory referenced by this","type":"text"},{"text":" ","type":"text"},{"text":"pointer. The type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" must be layout compatible","type":"text"},{"text":" ","type":"text"},{"text":"with the pointer’s ","type":"text"},{"code":"Pointee","type":"codeVoice"},{"text":" type.","type":"text"}]}],"name":"type"},{"content":[{"inlineContent":[{"type":"text","text":"The number of instances of "},{"code":"T","type":"codeVoice"},{"type":"text","text":" in the re-bound region."}],"type":"paragraph"}],"name":"count"},{"content":[{"inlineContent":[{"text":"A closure that takes a typed pointer to the","type":"text"},{"text":" ","type":"text"},{"text":"same memory as this pointer, only bound to type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":". The closure’s","type":"text"},{"text":" ","type":"text"},{"text":"pointer argument is valid only for the duration of the closure’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"execution. If "},{"code":"body","type":"codeVoice"},{"type":"text","text":" has a return value, that value is also used as"},{"type":"text","text":" "},{"type":"text","text":"the return value for the "},{"type":"codeVoice","code":"withMemoryRebound(to:capacity:_:)"},{"type":"text","text":" method."}],"type":"paragraph"}],"name":"body"}]},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The return value, if any, of the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" closure parameter.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method when you have a pointer to memory bound to one type and"},{"type":"text","text":" "},{"text":"you need to access that memory as instances of another type. Accessing","type":"text"},{"text":" ","type":"text"},{"text":"memory as a type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" requires that the memory be bound to that type. A","type":"text"},{"text":" ","type":"text"},{"text":"memory location may only be bound to one type at a time, so accessing","type":"text"},{"text":" ","type":"text"},{"text":"the same memory as an unrelated type without first rebinding the memory","type":"text"},{"text":" ","type":"text"},{"text":"is undefined.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The region of memory that starts at this pointer and covers "},{"type":"codeVoice","code":"count"},{"text":" ","type":"text"},{"text":"strides of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" instances must be bound to ","type":"text"},{"type":"codeVoice","code":"Pointee"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Any instance of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" within the re-bound region may be initialized or","type":"text"},{"type":"text","text":" "},{"text":"uninitialized. Every instance of ","type":"text"},{"code":"Pointee","type":"codeVoice"},{"type":"text","text":" overlapping with a given"},{"type":"text","text":" "},{"type":"text","text":"instance of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" should have the same initialization state (i.e."},{"type":"text","text":" "},{"type":"text","text":"initialized or uninitialized.) Accessing a "},{"type":"codeVoice","code":"T"},{"type":"text","text":" whose underlying"},{"type":"text","text":" "},{"code":"Pointee","type":"codeVoice"},{"type":"text","text":" storage is in a mixed initialization state shall be"},{"type":"text","text":" "},{"type":"text","text":"undefined behaviour."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example temporarily rebinds the memory of a "},{"type":"codeVoice","code":"UInt64"},{"type":"text","text":" "},{"type":"text","text":"pointer to "},{"type":"codeVoice","code":"Int64"},{"type":"text","text":", then accesses a property on the signed integer."}],"type":"paragraph"},{"code":["let uint64Pointer: UnsafePointer<UInt64> = fetchValue()","let isNegative = uint64Pointer.withMemoryRebound(","    to: Int64.self, capacity: 1",") {","    return $0.pointee < 0","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Because this pointer’s memory is no longer bound to its "},{"type":"codeVoice","code":"Pointee"},{"type":"text","text":" type"},{"type":"text","text":" "},{"type":"text","text":"while the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure executes, do not access memory using the"},{"type":"text","text":" "},{"type":"text","text":"original pointer from within "},{"type":"codeVoice","code":"body"},{"type":"text","text":". Instead, use the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure’s"},{"type":"text","text":" "},{"type":"text","text":"pointer argument to access the values in memory as instances of type"},{"type":"text","text":" "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"After executing "},{"code":"body","type":"codeVoice"},{"text":", this method rebinds memory back to the original","type":"text"},{"type":"text","text":" "},{"code":"Pointee","type":"codeVoice"},{"type":"text","text":" type."}],"type":"paragraph"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Only use this method to rebind the pointer’s memory to a type","type":"text"},{"text":" ","type":"text"},{"text":"that is layout compatible with the ","type":"text"},{"code":"Pointee","type":"codeVoice"},{"text":" type. The stride of the","type":"text"},{"text":" ","type":"text"},{"text":"temporary type (","type":"text"},{"code":"T","type":"codeVoice"},{"text":") may be an integer multiple or a whole fraction","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"Pointee","type":"codeVoice"},{"text":"’s stride, for example to point to one element of","type":"text"},{"text":" ","type":"text"},{"text":"an aggregate.","type":"text"},{"text":" ","type":"text"},{"text":"To bind a region of memory to a type that does not match these","type":"text"},{"text":" ","type":"text"},{"text":"requirements, convert the pointer to a raw pointer and use the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"bindMemory(to:)"},{"text":" method.","type":"text"},{"text":" ","type":"text"},{"text":"If ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Pointee"},{"text":" have different alignments, this pointer","type":"text"},{"text":" ","type":"text"},{"text":"must be aligned with the larger of the two alignments.","type":"text"}]}],"name":"Note","style":"note"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafePointer\/withMemoryRebound(to:capacity:_:)"},"kind":"symbol","sections":[],"references":{"doc://com.apple.Swift/documentation/Swift":{"role":"collection","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","type":"topic","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/Int":{"role":"symbol","abstract":[{"type":"text","text":"A signed integer value type."}],"url":"\/documentation\/swift\/int","title":"Int","navigatorTitle":[{"text":"Int","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Int","kind":"identifier"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/UnsafePointer/withMemoryRebound(to:capacity:_:)":{"type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Executes the given closure while temporarily binding memory to"},{"type":"text","text":" "},{"type":"text","text":"the specified number of instances of type "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withMemoryRebound","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Result","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"T","preciseIdentifier":"s:SPsRi_zrlE17withMemoryRebound2to8capacity_qd_1_qd__m_Siqd_1_SPyqd__Gqd_0_YKXEtqd_0_YKs5ErrorRd_0_Ri_d__Ri_d_1_r1_lF1TL_qd__mfp","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"c