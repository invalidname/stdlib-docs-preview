pe":"text","text":"with the pointer’s "},{"code":"Pointee","type":"codeVoice"},{"text":" type.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The number of instances of ","type":"text"},{"type":"codeVoice","code":"T"},{"type":"text","text":" in the re-bound region."}],"type":"paragraph"}],"name":"count"},{"content":[{"inlineContent":[{"text":"A closure that takes a typed pointer to the","type":"text"},{"text":" ","type":"text"},{"text":"same memory as this pointer, only bound to type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":". The closure’s","type":"text"},{"text":" ","type":"text"},{"text":"pointer argument is valid only for the duration of the closure’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"execution. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" has a return value, that value is also used as"},{"type":"text","text":" "},{"type":"text","text":"the return value for the "},{"code":"withMemoryRebound(to:capacity:_:)","type":"codeVoice"},{"text":" method.","type":"text"}],"type":"paragraph"}],"name":"body"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure parameter."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"text":"Use this method when you have a pointer to memory bound to one type and","type":"text"},{"type":"text","text":" "},{"text":"you need to access that memory as instances of another type. Accessing","type":"text"},{"type":"text","text":" "},{"type":"text","text":"memory as a type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" requires that the memory be bound to that type. A"},{"text":" ","type":"text"},{"type":"text","text":"memory location may only be bound to one type at a time, so accessing"},{"text":" ","type":"text"},{"type":"text","text":"the same memory as an unrelated type without first rebinding the memory"},{"text":" ","type":"text"},{"text":"is undefined.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The region of memory that starts at this pointer and covers ","type":"text"},{"code":"count","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"strides of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" instances must be bound to "},{"code":"Pointee","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Any instance of "},{"type":"codeVoice","code":"T"},{"text":" within the re-bound region may be initialized or","type":"text"},{"text":" ","type":"text"},{"text":"uninitialized. Every instance of ","type":"text"},{"code":"Pointee","type":"codeVoice"},{"type":"text","text":" overlapping with a given"},{"type":"text","text":" "},{"text":"instance of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" should have the same initialization state (i.e.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"initialized or uninitialized.) Accessing a "},{"type":"codeVoice","code":"T"},{"text":" whose underlying","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Pointee"},{"text":" storage is in a mixed initialization state shall be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"undefined behaviour."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example temporarily rebinds the memory of a "},{"code":"UInt64","type":"codeVoice"},{"type":"text","text":" "},{"text":"pointer to ","type":"text"},{"type":"codeVoice","code":"Int64"},{"text":", then accesses a property on the signed integer.","type":"text"}],"type":"paragraph"},{"code":["let uint64Pointer: UnsafePointer<UInt64> = fetchValue()","let isNegative = uint64Pointer.withMemoryRebound(","    to: Int64.self, capacity: 1",") {","    return $0.pointee < 0","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Because this pointer’s memory is no longer bound to its "},{"code":"Pointee","type":"codeVoice"},{"type":"text","text":" type"},{"type":"text","text":" "},{"type":"text","text":"while the "},{"code":"body","type":"codeVoice"},{"text":" closure executes, do not access memory using the","type":"text"},{"text":" ","type":"text"},{"text":"original pointer from within ","type":"text"},{"code":"body","type":"codeVoice"},{"text":". Instead, use the ","type":"text"},{"code":"body","type":"codeVoice"},{"type":"text","text":" closure’s"},{"type":"text","text":" "},{"type":"text","text":"pointer argument to access the values in memory as instances of type"},{"type":"text","text":" "},{"code":"T","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"After executing "},{"code":"body","type":"codeVoice"},{"text":", this method rebinds memory back to the original","type":"text"},{"type":"text","text":" "},{"code":"Pointee","type":"codeVoice"},{"type":"text","text":" type."}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"inlineContent":[{"text":"Only use this method to rebind the pointer’s memory to a type","type":"text"},{"text":" ","type":"text"},{"text":"that is layout compatible with the ","type":"text"},{"code":"Pointee","type":"codeVoice"},{"text":" type. The stride of the","type":"text"},{"type":"text","text":" "},{"text":"temporary type (","type":"text"},{"code":"T","type":"codeVoice"},{"text":") may be an integer multiple or a whole fraction","type":"text"},{"type":"text","text":" "},{"type":"text","text":"of "},{"code":"Pointee","type":"codeVoice"},{"text":"’s stride, for example to point to one element of","type":"text"},{"text":" ","type":"text"},{"text":"an aggregate.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"To bind a region of memory to a type that does not match these"},{"type":"text","text":" "},{"type":"text","text":"requirements, convert the pointer to a raw pointer and use the"},{"type":"text","text":" "},{"type":"codeVoice","code":"bindMemory(to:)"},{"type":"text","text":" method."},{"type":"text","text":" "},{"text":"If ","type":"text"},{"type":"codeVoice","code":"T"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Pointee"},{"type":"text","text":" have different alignments, this pointer"},{"text":" ","type":"text"},{"type":"text","text":"must be aligned with the larger of the two alignments."}],"type":"paragraph"}],"name":"Note"}]}],"abstract":[{"type":"text","text":"Executes the given closure while temporarily binding memory to"},{"type":"text","text":" "},{"text":"the specified number of instances of type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":".","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafePointer\/withMemoryRebound(to:capacity:_:)","interfaceLanguage":"swift"},"metadata":{"role":"symbol","extendedModule":"Swift","title":"withMemoryRebound(to:capacity:_:)","modules":[{"name":"Standard Library"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withMemoryRebound"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"E"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":">("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"T","preciseIdentifier":"s:SPsRi_zrlE17withMemoryRebound2to8capacity_qd_1_qd__m_Siqd_1_SPyqd__Gqd_0_YKXEtqd_0_YKs5ErrorRd_0_Ri_d__Ri_d_1_r1_lF1TL_qd__mfp"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","t