:" ","type":"text"},{"text":"same memory as this pointer, only bound to type ","type":"text"},{"type":"codeVoice","code":"T"},{"text":". The closure’s","type":"text"},{"text":" ","type":"text"},{"text":"pointer argument is valid only for the duration of the closure’s","type":"text"},{"text":" ","type":"text"},{"text":"execution. If ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" has a return value, that value is also used as","type":"text"},{"text":" ","type":"text"},{"text":"the return value for the ","type":"text"},{"type":"codeVoice","code":"withMemoryRebound(to:capacity:_:)"},{"text":" method.","type":"text"}],"type":"paragraph"}],"name":"body"}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"inlineContent":[{"text":"The return value, if any, of the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" closure parameter.","type":"text"}],"type":"paragraph"}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method when you have a pointer to memory bound to one type and"},{"type":"text","text":" "},{"type":"text","text":"you need to access that memory as instances of another type. Accessing"},{"type":"text","text":" "},{"type":"text","text":"memory as a type "},{"code":"T","type":"codeVoice"},{"type":"text","text":" requires that the memory be bound to that type. A"},{"type":"text","text":" "},{"type":"text","text":"memory location may only be bound to one type at a time, so accessing"},{"type":"text","text":" "},{"type":"text","text":"the same memory as an unrelated type without first rebinding the memory"},{"type":"text","text":" "},{"type":"text","text":"is undefined."}]},{"type":"paragraph","inlineContent":[{"text":"The region of memory that starts at this pointer and covers ","type":"text"},{"code":"count","type":"codeVoice"},{"text":" ","type":"text"},{"text":"strides of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" instances must be bound to ","type":"text"},{"code":"Pointee","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Any instance of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" within the re-bound region may be initialized or","type":"text"},{"text":" ","type":"text"},{"text":"uninitialized. Every instance of ","type":"text"},{"code":"Pointee","type":"codeVoice"},{"text":" overlapping with a given","type":"text"},{"type":"text","text":" "},{"type":"text","text":"instance of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" should have the same initialization state (i.e."},{"type":"text","text":" "},{"type":"text","text":"initialized or uninitialized.) Accessing a "},{"type":"codeVoice","code":"T"},{"type":"text","text":" whose underlying"},{"type":"text","text":" "},{"type":"codeVoice","code":"Pointee"},{"type":"text","text":" storage is in a mixed initialization state shall be"},{"type":"text","text":" "},{"type":"text","text":"undefined behaviour."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example temporarily rebinds the memory of a "},{"code":"UInt64","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"pointer to "},{"code":"Int64","type":"codeVoice"},{"type":"text","text":", then accesses a property on the signed integer."}]},{"syntax":"swift","code":["let uint64Pointer: UnsafePointer<UInt64> = fetchValue()","let isNegative = uint64Pointer.withMemoryRebound(","    to: Int64.self, capacity: 1",") {","    return $0.pointee < 0","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Because this pointer’s memory is no longer bound to its ","type":"text"},{"type":"codeVoice","code":"Pointee"},{"text":" type","type":"text"},{"text":" ","type":"text"},{"text":"while the ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" closure executes, do not access memory using the","type":"text"},{"text":" ","type":"text"},{"text":"original pointer from within ","type":"text"},{"type":"codeVoice","code":"body"},{"text":". Instead, use the ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" closure’s","type":"text"},{"text":" ","type":"text"},{"text":"pointer argument to access the values in memory as instances of type","type":"text"},{"text":" ","type":"text"},{"code":"T","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After executing "},{"type":"codeVoice","code":"body"},{"type":"text","text":", this method rebinds memory back to the original"},{"type":"text","text":" "},{"type":"codeVoice","code":"Pointee"},{"type":"text","text":" type."}]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"text":"Only use this method to rebind the pointer’s memory to a type","type":"text"},{"text":" ","type":"text"},{"text":"that is layout compatible with the ","type":"text"},{"type":"codeVoice","code":"Pointee"},{"text":" type. The stride of the","type":"text"},{"text":" ","type":"text"},{"text":"temporary type (","type":"text"},{"type":"codeVoice","code":"T"},{"text":") may be an integer multiple or a whole fraction","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"type":"codeVoice","code":"Pointee"},{"text":"’s stride, for example to point to one element of","type":"text"},{"text":" ","type":"text"},{"text":"an aggregate.","type":"text"},{"text":" ","type":"text"},{"text":"To bind a region of memory to a type that does not match these","type":"text"},{"text":" ","type":"text"},{"text":"requirements, convert the pointer to a raw pointer and use the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"bindMemory(to:)"},{"text":" method.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If "},{"code":"T","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Pointee","type":"codeVoice"},{"type":"text","text":" have different alignments, this pointer"},{"type":"text","text":" "},{"type":"text","text":"must be aligned with the larger of the two alignments."}],"type":"paragraph"}]}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/UnsafePointer":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafePointer","title":"UnsafePointer","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"A pointer for accessing data of a specific type.","type":"text"}],"url":"\/documentation\/swift\/unsafepointer","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnsafePointer","kind":"identifier"}],"navigatorTitle":[{"text":"UnsafePointer","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/Error":{"kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","role":"symbol","abstract":[{"text":"A type representing an error value that can be thrown.","type":"text"}],"url":"\/documentation\/swift\/error","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Error"}],"navigatorTitle":[{"text":"Error","kind":"identifier"}],"title":"Error","type":"topic"},"doc://com.apple.Swift/documentation/Swift/Int":{"url":"\/documentation\/swift\/int","title":"Int","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Int","kind":"identifier"}],"abstract":[{"type":"text","text":"A signed integer value type."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Int","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Int"},"doc://com.apple.Swift/documentation/Swift":{"kind":"symbol","type":"topic","role":"collection","title":"Swift","images":[{"type":"card","identifier":"Swift-PageImage-card.png"}],"abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","identifier":"doc:\/\/com.apple