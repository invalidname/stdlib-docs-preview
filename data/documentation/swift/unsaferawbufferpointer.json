AtomicRepresentable","doc:\/\/com.apple.Swift\/documentation\/Swift\/BidirectionalCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/BitwiseCopyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/Collection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Copyable","doc:\/\/com.apple.Swift\/documentation\/Swift\/CustomDebugStringConvertible","doc:\/\/com.apple.Swift\/documentation\/Swift\/Escapable","doc:\/\/com.apple.Swift\/documentation\/Swift\/RandomAccessCollection","doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence"],"kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnsafeRawBufferPointer","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"You can use an "},{"type":"codeVoice","code":"UnsafeRawBufferPointer"},{"type":"text","text":" instance in low-level operations to eliminate"},{"type":"text","text":" "},{"type":"text","text":"uniqueness checks and release mode bounds checks. Bounds checks are always"},{"type":"text","text":" "},{"type":"text","text":"performed in debug mode."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An "},{"code":"UnsafeRawBufferPointer","type":"codeVoice"},{"type":"text","text":" instance is a view of the raw bytes in a region of memory."},{"type":"text","text":" "},{"type":"text","text":"Each byte in memory is viewed as a "},{"code":"UInt8","type":"codeVoice"},{"type":"text","text":" value independent of the type"},{"type":"text","text":" "},{"type":"text","text":"of values held in that memory. Reading from memory through a raw buffer is"},{"type":"text","text":" "},{"type":"text","text":"an untyped operation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In addition to its collection interface, an "},{"type":"codeVoice","code":"UnsafeRawBufferPointer"},{"type":"text","text":" "},{"type":"text","text":"instance also supports the "},{"type":"codeVoice","code":"load(fromByteOffset:as:)"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"loadUnaligned(fromByteOffset:as:)"},{"type":"text","text":" methods provided by"},{"type":"text","text":" "},{"type":"codeVoice","code":"UnsafeRawPointer"},{"type":"text","text":", including bounds checks in debug mode."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To access the underlying memory through typed operations, the memory must"},{"type":"text","text":" "},{"type":"text","text":"be bound to a trivial type."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"trivial type"}]},{"text":" can be copied bit for bit with no indirection","type":"text"},{"text":" ","type":"text"},{"text":"or reference-counting operations. Generally, native Swift types that do","type":"text"},{"text":" ","type":"text"},{"text":"not contain strong or weak references or other forms of indirection are","type":"text"},{"text":" ","type":"text"},{"text":"trivial, as are imported C structs and enums. Copying memory that","type":"text"},{"text":" ","type":"text"},{"text":"contains values of nontrivial types can only be done safely with a typed","type":"text"},{"text":" ","type":"text"},{"text":"pointer. Copying bytes directly from nontrivial, in-memory values does","type":"text"},{"text":" ","type":"text"},{"text":"not produce valid copies and can only be done by calling a C API, such as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"memmove()"},{"text":".","type":"text"}]}],"type":"aside","style":"note","name":"Note"},{"anchor":"UnsafeRawBufferPointer-Semantics","type":"heading","text":"UnsafeRawBufferPointer Semantics","level":1},{"inlineContent":[{"text":"An ","type":"text"},{"code":"UnsafeRawBufferPointer","type":"codeVoice"},{"text":" instance is a view into memory and does not own the memory","type":"text"},{"text":" ","type":"text"},{"text":"that it references. Copying a variable or constant of type ","type":"text"},{"code":"UnsafeRawBufferPointer","type":"codeVoice"},{"text":" does","type":"text"},{"text":" ","type":"text"},{"text":"not copy the underlying memory. However, initializing another collection","type":"text"},{"type":"text","text":" "},{"type":"text","text":"with an "},{"code":"UnsafeRawBufferPointer","type":"codeVoice"},{"type":"text","text":" instance copies bytes out of the referenced memory and"},{"type":"text","text":" "},{"type":"text","text":"into the new collection."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example uses "},{"type":"codeVoice","code":"someBytes"},{"type":"text","text":", an "},{"type":"codeVoice","code":"UnsafeRawBufferPointer"},{"type":"text","text":" instance, to"},{"type":"text","text":" "},{"type":"text","text":"demonstrate the difference between assigning a buffer pointer and using a"},{"type":"text","text":" "},{"type":"text","text":"buffer pointer as the source for another collection’s elements. Here, the"},{"type":"text","text":" "},{"type":"text","text":"assignment to "},{"type":"codeVoice","code":"destBytes"},{"type":"text","text":" creates a new, nonowning buffer pointer"},{"type":"text","text":" "},{"type":"text","text":"covering the first "},{"type":"codeVoice","code":"n"},{"type":"text","text":" bytes of the memory that "},{"type":"codeVoice","code":"someBytes"},{"type":"text","text":" "},{"type":"text","text":"references—nothing is copied:"}]},{"type":"codeListing","syntax":"swift","code":["var destBytes = someBytes[0..<n]"]},{"type":"paragraph","inlineContent":[{"text":"Next, the bytes referenced by ","type":"text"},{"type":"codeVoice","code":"destBytes"},{"text":" are copied into ","type":"text"},{"type":"codeVoice","code":"byteArray"},{"text":", a","type":"text"},{"text":" ","type":"text"},{"text":"new ","type":"text"},{"code":"[UInt8]","type":"codeVoice"},{"text":" array, and then the remainder of ","type":"text"},{"code":"someBytes","type":"codeVoice"},{"text":" is appended to","type":"text"},{"text":" ","type":"text"},{"code":"byteArray","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var byteArray: [UInt8] = Array(destBytes)","byteArray += someBytes[n..<someBytes.count]"]}],"kind":"content"}],"abstract":[{"text":"A  nonowning collection interface to the bytes in a","type":"text"},{"text":" ","type":"text"},{"text":"region of memory.","type":"text"}],"kind":"symbol","seeAlsoSections":[{"title":"Raw Pointers","anchor":"Raw-Pointers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawPointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawPointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawBufferPointer"],"generated":true}],"variants":[{"paths":["\/documentation\/swift\/unsaferawbufferpointer"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.apple.Swift/documentation/Swift/UnsafeRawBufferPointer/init(_:)-5ko6n":{"url":"\/documentation\/swift\/unsaferawbufferpointer\/init(_:)-5ko6n","title":"init(_:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawBufferPointer\/init(_:)-5ko6n","abstract":[{"type":"text","text":"Creates a new buffer over the same memory as the given buffer."}],"kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","text":"UnsafeMutableRawBufferPointer","preciseIdentifier":"s:Sw"},{"text":")","kind":"text"}],"type":"topic","role":"symbol"},"doc://com.apple.Swift/documentation/Swift":{"kind":"symbol","type":"topic","role":"collection","title":"Swift","images":[{"type":"card",