":"text"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" is the length of the sequence."}],"type":"paragraph"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawBufferPointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawBufferPointer\/Iterator"]]},"abstract":[{"type":"text","text":"Returns the elements of the sequence, sorted."}],"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawBufferPointer\/Iterator\/sorted()","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/swift\/unsaferawbufferpointer\/iterator\/sorted()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/Sequence/Element":{"abstract":[{"text":"A type representing the sequence’s elements.","type":"text"}],"type":"topic","title":"Element","kind":"symbol","required":true,"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sequence\/Element","url":"\/documentation\/swift\/sequence\/element","role":"symbol"},"Swift-PageImage-card.png":{"alt":"An orange Swift logo on a gradient background.","identifier":"Swift-PageImage-card.png","variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png","traits":["2x","dark"]}],"type":"image"},"doc://com.apple.Swift/do