ypeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"E","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1EL_q_mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Result","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF6ResultL_q0_mfp","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:s5ErrorP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error"},{"text":", ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ~Copyable, ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":" : ~Copyable","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"type","content":[{"inlineContent":[{"text":"The type to temporarily bind the memory referenced by this","type":"text"},{"text":" ","type":"text"},{"text":"buffer.","type":"text"}],"type":"paragraph"}]},{"name":"body","content":[{"inlineContent":[{"text":"A closure that takes a typed pointer to the","type":"text"},{"text":" ","type":"text"},{"text":"same memory as this pointer, only bound to type ","type":"text"},{"type":"codeVoice","code":"T"},{"text":". The closure’s","type":"text"},{"text":" ","type":"text"},{"text":"pointer argument is valid only for the duration of the closure’s","type":"text"},{"text":" ","type":"text"},{"text":"execution. If ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" has a return value, that value is also used as","type":"text"},{"text":" ","type":"text"},{"text":"the return value for the ","type":"text"},{"type":"codeVoice","code":"withMemoryRebound(to:capacity:_:)"},{"text":" method.","type":"text"}],"type":"paragraph"},{"items":[{"definition":{"content":[{"inlineContent":[{"text":"The buffer temporarily bound to instances of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":".","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"buffer","type":"text"}]}}],"type":"termList"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"inlineContent":[{"text":"The return value, if any, of the ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" closure parameter.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"Use this method when you have a buffer to raw memory and you need","type":"text"},{"text":" ","type":"text"},{"text":"to access that memory as instances of a given type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":". Accessing","type":"text"},{"text":" ","type":"text"},{"text":"memory as a type ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" requires that the memory be bound to that type.","type":"text"},{"text":" ","type":"text"},{"text":"A memory location may only be bound to one type at a time, so accessing","type":"text"},{"text":" ","type":"text"},{"text":"the same memory as an unrelated type without first rebinding the memory","type":"text"},{"text":" ","type":"text"},{"text":"is undefined.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Any instance of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" within the re-bound region may be initialized or","type":"text"},{"text":" ","type":"text"},{"text":"uninitialized. The memory underlying any individual instance of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" ","type":"text"},{"text":"must have the same initialization state (i.e.  initialized or","type":"text"},{"text":" ","type":"text"},{"text":"uninitialized.) Accessing a ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" whose underlying memory","type":"text"},{"text":" ","type":"text"},{"text":"is in a mixed initialization state shall be undefined behaviour.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the byte count of the original buffer is not a multiple of","type":"text"},{"text":" ","type":"text"},{"text":"the stride of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":", then the re-bound buffer is shorter","type":"text"},{"text":" ","type":"text"},{"text":"than the original buffer.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"After executing ","type":"text"},{"code":"body","type":"codeVoice"},{"text":", this method rebinds memory back to its original","type":"text"},{"text":" ","type":"text"},{"text":"binding state. This can be unbound memory, or bound to a different type.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"The buffer’s base address must match the","type":"text"},{"text":" ","type":"text"},{"text":"alignment of ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" (as reported by ","type":"text"},{"type":"codeVoice","code":"MemoryLayout<T>.alignment"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"That is, ","type":"text"},{"type":"codeVoice","code":"Int(bitPattern: self.baseAddress) % MemoryLayout<T>.alignment"},{"text":" ","type":"text"},{"text":"must equal zero.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"type":"aside","content":[{"inlineContent":[{"text":"A raw buffer may represent memory that has been bound to a type.","type":"text"},{"text":" ","type":"text"},{"text":"If that is the case, then ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" must be layout compatible with the","type":"text"},{"text":" ","type":"text"},{"text":"type to which the memory has been bound. This requirement does not","type":"text"},{"text":" ","type":"text"},{"text":"apply if the raw buffer represents memory that has not been bound","type":"text"},{"text":" ","type":"text"},{"text":"to any type.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/unsaferawbufferpointer\/withmemoryrebound(to:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawBufferPointer"]]},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Executes the given closure while temporarily binding the buffer to","type":"text"},{"text":" ","type":"text"},{"text":"instances of type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","metadata":{"extendedModule":"Swift","title":"withMemoryRebound(to:_:)","role":"symbol","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"withMemoryRebound"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"E"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":">("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"T","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1TL_xmfp"},{"kind":"text","text":".Type, ("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"buffer"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafeBufferPointer","preciseIdentifier":"s:SR"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"T","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1TL_xmfp"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"E","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YK