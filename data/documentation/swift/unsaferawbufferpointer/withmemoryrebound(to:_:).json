"kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1EL_q_mfp","text":"E","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF6ResultL_q0_mfp","text":"Result","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"E","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1EL_q_mfp"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Result","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF6ResultL_q0_mfp"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"text":" : ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","preciseIdentifier":"s:s5ErrorP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : ~Copyable, "},{"kind":"typeIdentifier","text":"Result"},{"text":" : ~Copyable","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"type","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The type to temporarily bind the memory referenced by this"},{"type":"text","text":" "},{"type":"text","text":"buffer."}]}]},{"name":"body","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that takes a typed pointer to the"},{"type":"text","text":" "},{"type":"text","text":"same memory as this pointer, only bound to type "},{"type":"codeVoice","code":"T"},{"type":"text","text":". The closure’s"},{"type":"text","text":" "},{"type":"text","text":"pointer argument is valid only for the duration of the closure’s"},{"type":"text","text":" "},{"type":"text","text":"execution. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" has a return value, that value is also used as"},{"type":"text","text":" "},{"text":"the return value for the ","type":"text"},{"type":"codeVoice","code":"withMemoryRebound(to:capacity:_:)"},{"type":"text","text":" method."}]},{"type":"termList","items":[{"definition":{"content":[{"inlineContent":[{"type":"text","text":"The buffer temporarily bound to instances of "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}],"type":"paragraph"}]},"term":{"inlineContent":[{"type":"text","text":"buffer"}]}}]}]}]},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"inlineContent":[{"text":"The return value, if any, of the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" closure parameter.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Use this method when you have a buffer to raw memory and you need","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to access that memory as instances of a given type "},{"type":"codeVoice","code":"T"},{"type":"text","text":". Accessing"},{"type":"text","text":" "},{"type":"text","text":"memory as a type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" requires that the memory be bound to that type."},{"type":"text","text":" "},{"type":"text","text":"A memory location may only be bound to one type at a time, so accessing"},{"type":"text","text":" "},{"type":"text","text":"the same memory as an unrelated type without first rebinding the memory"},{"type":"text","text":" "},{"type":"text","text":"is undefined."}],"type":"paragraph"},{"inlineContent":[{"text":"Any instance of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" within the re-bound region may be initialized or","type":"text"},{"text":" ","type":"text"},{"text":"uninitialized. The memory underlying any individual instance of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" ","type":"text"},{"text":"must have the same initialization state (i.e.  initialized or","type":"text"},{"text":" ","type":"text"},{"text":"uninitialized.) Accessing a ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" whose underlying memory","type":"text"},{"text":" ","type":"text"},{"text":"is in a mixed initialization state shall be undefined behaviour.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the byte count of the original buffer is not a multiple of","type":"text"},{"text":" ","type":"text"},{"text":"the stride of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":", then the re-bound buffer is shorter","type":"text"},{"text":" ","type":"text"},{"text":"than the original buffer.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"After executing "},{"type":"codeVoice","code":"body"},{"type":"text","text":", this method rebinds memory back to its original"},{"type":"text","text":" "},{"text":"binding state. This can be unbound memory, or bound to a different type.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"The buffer’s base address must match the","type":"text"},{"text":" ","type":"text"},{"text":"alignment of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" (as reported by ","type":"text"},{"code":"MemoryLayout<T>.alignment","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"That is, ","type":"text"},{"code":"Int(bitPattern: self.baseAddress) % MemoryLayout<T>.alignment","type":"codeVoice"},{"text":" ","type":"text"},{"text":"must equal zero.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A raw buffer may represent memory that has been bound to a type."},{"type":"text","text":" "},{"type":"text","text":"If that is the case, then "},{"type":"codeVoice","code":"T"},{"type":"text","text":" must be layout compatible with the"},{"type":"text","text":" "},{"type":"text","text":"type to which the memory has been bound. This requirement does not"},{"text":" ","type":"text"},{"text":"apply if the raw buffer represents memory that has not been bound","type":"text"},{"type":"text","text":" "},{"text":"to any type.","type":"text"}]}]}]}],"metadata":{"platforms":[{"introducedAt":"8.0","unavailable":false,"beta":false,"name":"iOS","deprecated":false},{"introducedAt":"8.0","unavailable":false,"beta":false,"name":"iPadOS","deprecated":false},{"introducedAt":"13.0","unavailable":false,"beta":false,"name":"Mac Catalyst","deprecated":false},{"unavailable":false,"name":"macOS","beta":false,"introducedAt":"10.10","deprecated":false},{"introducedAt":"9.0","deprecated":false,"beta":false,"name":"tvOS","unavailable":false},{"introducedAt":"1.0","unavailable":false,"beta":false,"name":"visionOS","deprecated":false},{"unavailable":false,"name":"watchOS","deprecated":false,"introducedAt":"2.0","beta":false}],"roleHeading":"Instance Method","externalID":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF","symbolKind":"method","modules":[{"name":"Swift"}],"extendedModule":"Swift","title":"withMemoryRebound(to:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withMemoryRebound"},{"kind":"text","text":"<"},{"text":"T","kind":"genericParameter"},{"kind":"text","text":", "},{"text":"E","kind":"genericParameter"},{"kind":"text","text":", "},{"text":"Result","kind":"genericParameter"},{"kind":"text","text":">("},{"text":"to","kind":"externalParam"},{"kind":"text","text":": "},{"text":"T","kind":"typeIdentifier","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1TL_xmfp"},{"kind":"text","text":".Type, ("},{"kind":"externalParam","text":"_"},{"kind