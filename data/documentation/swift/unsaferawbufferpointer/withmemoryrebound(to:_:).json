{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawBufferPointer\/withMemoryRebound(to:_:)"},"abstract":[{"type":"text","text":"Executes the given closure while temporarily binding the buffer to"},{"type":"text","text":" "},{"type":"text","text":"instances of type "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@export(implementation)","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withMemoryRebound","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":", ","kind":"text"},{"kind":"genericParameter","text":"Result"},{"text":">(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"type","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"T","kind":"typeIdentifier","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1TL_xmfp"},{"text":".Type, ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"buffer","kind":"internalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeBufferPointer","text":"UnsafeBufferPointer","preciseIdentifier":"s:SR"},{"text":"<","kind":"text"},{"text":"T","kind":"typeIdentifier","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1TL_xmfp"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"E","kind":"typeIdentifier","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1EL_q_mfp"},{"text":") -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF6ResultL_q0_mfp"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"E","kind":"typeIdentifier","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1EL_q_mfp"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF6ResultL_q0_mfp","kind":"typeIdentifier","text":"Result"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","preciseIdentifier":"s:s5ErrorP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : ~Copyable, "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":" : ~Copyable"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"name":"type","content":[{"type":"paragraph","inlineContent":[{"text":"The type to temporarily bind the memory referenced by this","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"buffer."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that takes a typed pointer to the"},{"text":" ","type":"text"},{"text":"same memory as this pointer, only bound to type ","type":"text"},{"type":"codeVoice","code":"T"},{"type":"text","text":". The closure’s"},{"type":"text","text":" "},{"text":"pointer argument is valid only for the duration of the closure’s","type":"text"},{"text":" ","type":"text"},{"text":"execution. If ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" has a return value, that value is also used as","type":"text"},{"text":" ","type":"text"},{"text":"the return value for the ","type":"text"},{"code":"withMemoryRebound(to:capacity:_:)","type":"codeVoice"},{"type":"text","text":" method."}]},{"type":"termList","items":[{"term":{"inlineContent":[{"type":"text","text":"buffer"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The buffer temporarily bound to instances of "},{"type":"codeVoice","code":"T"},{"type":"text","text":"."}]}]}}]}],"name":"body"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"inlineContent":[{"text":"The return value, if any, of the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" closure parameter.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Use this method when you have a buffer to raw memory and you need","type":"text"},{"text":" ","type":"text"},{"text":"to access that memory as instances of a given type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":". Accessing","type":"text"},{"text":" ","type":"text"},{"text":"memory as a type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" requires that the memory be bound to that type.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"A memory location may only be bound to one type at a time, so accessing"},{"type":"text","text":" "},{"type":"text","text":"the same memory as an unrelated type without first rebinding the memory"},{"text":" ","type":"text"},{"text":"is undefined.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Any instance of ","type":"text"},{"type":"codeVoice","code":"T"},{"type":"text","text":" within the re-bound region may be initialized or"},{"type":"text","text":" "},{"type":"text","text":"uninitialized. The memory underlying any individual instance of "},{"code":"T","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"must have the same initialization state (i.e.  initialized or"},{"type":"text","text":" "},{"type":"text","text":"uninitialized.) Accessing a "},{"type":"codeVoice","code":"T"},{"type":"text","text":" whose underlying memory"},{"type":"text","text":" "},{"type":"text","text":"is in a mixed initialization state shall be undefined behaviour."}]},{"inlineContent":[{"text":"If the byte count of the original buffer is not a multiple of","type":"text"},{"text":" ","type":"text"},{"text":"the stride of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":", then the re-bound buffer is shorter","type":"text"},{"text":" ","type":"text"},{"text":"than the original buffer.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"After executing ","type":"text"},{"type":"codeVoice","code":"body"},{"text":", this method rebinds memory back to its original","type":"text"},{"type":"text","text":" "},{"type":"text","text":"binding state. This can be unbound memory, or bound to a different type."}]},{"content":[{"inlineContent":[{"type":"text","text":"The buffer’s base address must match the"},{"text":" ","type":"text"},{"type":"text","text":"alignment of "},{"code":"T","type":"codeVoice"},{"type":"text","text":" (as reported by "},{"code":"MemoryLayout<T>.alignment","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"That is, "},{"type":"codeVoice","code":"Int(bitPattern: self.baseAddress) % MemoryLayout<T>.alignment"},{"text":" ","type":"text"},{"text":"must equal zero.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A raw buffer may represent memory that has been bound to a type."},{"text":" ","type":"text"},{"text":"If that is the case, then ","type":"text"},{"type":"codeVoice","code":"T"},{"type":"text","text":" must be layout compatible with the"},{"text":" ","type":"text"},{"type":"text","text":"type to which the memory has been bound. This requirement does not"},{"type":"text","text":" "},{"type":"text","text":"apply if the raw buffer represents memory that has not been bound"},{"text":" ","type":"text"},{"type":"text","text":"to any type."}]}],"style":"note","type":"aside","name":"Note"}]}],"metadata":{"roleHeading":"Instance Method","platforms":[{"name":"iOS","deprecated":false,"introducedAt":"8.0","beta":false,"unavailable":false},{"name":"iPadOS","deprecated":false,"introducedAt":"8.0","beta":false,"unavailable":false},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"13.0","name":"Mac Catalyst"},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"10.10","name":"macOS"},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"9.0","name":"tvOS"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"1.0","name":"visionOS"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"2.0","name":"watchOS"}],"modules":[{"name":"Standard Library"}],"symbolKind":"method","externalID":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"withMemoryRebound","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Result","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"externalParam","text":"to"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1TL_xmfp","kind":"typeIdentifier","text":"T"},{"kind":"text","text":".Type, ("},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"kind":"internalParam","text":"buffer"},{"kind":"text","text":": "},{"kind":"typeIdentifi