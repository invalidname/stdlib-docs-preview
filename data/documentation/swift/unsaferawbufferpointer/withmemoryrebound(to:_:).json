xt":".Type, "},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"buffer"},{"kind":"text","text":": "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeBufferPointer","text":"UnsafeBufferPointer","kind":"typeIdentifier","preciseIdentifier":"s:SR"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1TL_xmfp","kind":"typeIdentifier","text":"T"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1EL_q_mfp","kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF6ResultL_q0_mfp","kind":"typeIdentifier","text":"Result"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF1EL_q_mfp","text":"E"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SW17withMemoryRebound2to_q0_xm_q0_SRyxGq_YKXEtq_YKs5ErrorR_Ri_zRi_0_r1_lF6ResultL_q0_mfp","text":"Result"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : ~Copyable, "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":" : ~Copyable"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"type","content":[{"type":"paragraph","inlineContent":[{"text":"The type to temporarily bind the memory referenced by this","type":"text"},{"type":"text","text":" "},{"text":"buffer.","type":"text"}]}]},{"name":"body","content":[{"inlineContent":[{"text":"A closure that takes a typed pointer to the","type":"text"},{"text":" ","type":"text"},{"text":"same memory as this pointer, only bound to type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":". The closure’s","type":"text"},{"text":" ","type":"text"},{"text":"pointer argument is valid only for the duration of the closure’s","type":"text"},{"text":" ","type":"text"},{"text":"execution. If ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" has a return value, that value is also used as","type":"text"},{"text":" ","type":"text"},{"text":"the return value for the ","type":"text"},{"code":"withMemoryRebound(to:capacity:_:)","type":"codeVoice"},{"text":" method.","type":"text"}],"type":"paragraph"},{"items":[{"definition":{"content":[{"inlineContent":[{"text":"The buffer temporarily bound to instances of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"buffer","type":"text"}]}}],"type":"termList"}]}]},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"text":"The return value, if any, of the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" closure parameter.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Use this method when you have a buffer to raw memory and you need","type":"text"},{"text":" ","type":"text"},{"text":"to access that memory as instances of a given type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":". Accessing","type":"text"},{"text":" ","type":"text"},{"text":"memory as a type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" requires that the memory be bound to that type.","type":"text"},{"text":" ","type":"text"},{"text":"A memory location may only be bound to one type at a time, so accessing","type":"text"},{"text":" ","type":"text"},{"text":"the same memory as an unrelated type without first rebinding the memory","type":"text"},{"text":" ","type":"text"},{"text":"is undefined.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Any instance of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" within the re-bound region may be initialized or","type":"text"},{"text":" ","type":"text"},{"text":"uninitialized. The memory underlying any individual instance of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" ","type":"text"},{"text":"must have the same initialization state (i.e.  initialized or","type":"text"},{"text":" ","type":"text"},{"text":"uninitialized.) Accessing a ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" whose underlying memory","type":"text"},{"text":" ","type":"text"},{"text":"is in a mixed initialization state shall be undefined behaviour.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the byte count of the original buffer is not a multiple of","type":"text"},{"text":" ","type":"text"},{"text":"the stride of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":", then the re-bound buffer is shorter","type":"text"},{"text":" ","type":"text"},{"text":"than the original buffer.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"After executing ","type":"text"},{"code":"body","type":"codeVoice"},{"text":", this method rebinds memory back to its original","type":"text"},{"text":" ","type":"text"},{"text":"binding state. This can be unbound memory, or bound to a different type.","type":"text"}],"type":"paragraph"},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"text":"The buffer’s base address must match the","type":"text"},{"text":" ","type":"text"},{"text":"alignment of ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" (as reported by ","type":"text"},{"code":"MemoryLayout<T>.alignment","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"That is, ","type":"text"},{"code":"Int(bitPattern: self.baseAddress) % MemoryLayout<T>.alignment","type":"codeVoice"},{"text":" ","type":"text"},{"text":"must equal zero.","type":"text"}],"type":"paragraph"}]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"text":"A raw buffer may represent memory that has been bound to a type.","type":"text"},{"text":" ","type":"text"},{"text":"If that is the case, then ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" must be layout compatible with the","type":"text"},{"text":" ","type":"text"},{"text":"type to which the memory has been bound. This requirement does not","type":"text"},{"text":" ","type":"text"},{"text":"apply if the raw buffer represents memory that has not been bound","type":"text"},{"text":" ","type":"text"},{"text":"to any type.","type":"text"}],"type":"paragraph"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawBufferPointer\/withMemoryRebound(to:_:)"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawBufferPointer"]]},"references":{"doc://com.apple.Swift/documentation/Swift/Error":{"abstract":[{"type":"text","text":"A type representing an error value that can be thrown."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","type":"topic","role":"symbol","title":"Error","navigatorTitle":[{"text":"Error","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/swift\/error","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Error","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/Unsaf