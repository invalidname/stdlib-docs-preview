ext","text":" "},{"type":"text","text":"memory as a type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" requires that the memory be bound to that type. A"},{"type":"text","text":" "},{"type":"text","text":"memory location may only be bound to one type at a time, so accessing"},{"type":"text","text":" "},{"type":"text","text":"the same memory as an unrelated type without first rebinding the memory"},{"type":"text","text":" "},{"type":"text","text":"is undefined."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Any instance of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" within the re-bound region may be initialized or"},{"type":"text","text":" "},{"type":"text","text":"uninitialized. The memory underlying any individual instance of "},{"type":"codeVoice","code":"T"},{"type":"text","text":" "},{"type":"text","text":"must have the same initialization state (i.e.  initialized or"},{"type":"text","text":" "},{"type":"text","text":"uninitialized.) Accessing a "},{"type":"codeVoice","code":"T"},{"type":"text","text":" whose underlying memory"},{"type":"text","text":" "},{"type":"text","text":"is in a mixed initialization state shall be undefined behaviour."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example temporarily rebinds a raw memory pointer"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"Int64"},{"type":"text","text":", then accesses a property on the signed integer."}],"type":"paragraph"},{"code":["let pointer: UnsafeRawPointer = fetchValue()","let isNegative = pointer.withMemoryRebound(","    to: Int64.self, capacity: 1",") {","    return $0.pointee < 0","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"After executing "},{"type":"codeVoice","code":"body"},{"type":"text","text":", this method rebinds memory back to its original"},{"type":"text","text":" "},{"type":"text","text":"binding state. This can be unbound memory, or bound to a different type."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The region of memory starting at this pointer must match the"},{"type":"text","text":" "},{"type":"text","text":"alignment of "},{"code":"T","type":"codeVoice"},{"type":"text","text":" (as reported by "},{"code":"MemoryLayout<T>.alignment","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"That is, "},{"code":"Int(bitPattern: self) % MemoryLayout<T>.alignment","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"must equal zero."}]}],"name":"Note","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The region of memory starting at this pointer may have been"},{"type":"text","text":" "},{"type":"text","text":"bound to a type. If that is the case, then "},{"code":"T","type":"codeVoice"},{"type":"text","text":" must be"},{"type":"text","text":" "},{"type":"text","text":"layout compatible with the type to which the memory has been bound."},{"type":"text","text":" "},{"type":"text","text":"This requirement does not apply if the region of memory"},{"type":"text","text":" "},{"type":"text","text":"has not been bound to any type."}]}],"name":"Note","type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawPointer"]]},"abstract":[{"text":"Executes the given closure while temporarily binding memory to","type":"text"},{"text":" ","type":"text"},{"text":"the specified number of instances of type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":".","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawPointer\/withMemoryRebound(to:capacity:_:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"path