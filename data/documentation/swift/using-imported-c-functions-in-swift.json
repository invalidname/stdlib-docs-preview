{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/using-imported-c-functions-in-swift"]}],"kind":"article","sections":[],"metadata":{"title":"Using Imported C Functions in Swift","modules":[{"name":"Standard Library"}],"role":"article","roleHeading":"Article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"title":"Language interoperability","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/c-interoperability","doc:\/\/com.apple.Swift\/documentation\/Swift\/cxx-interoperability","doc:\/\/com.apple.Swift\/documentation\/Swift\/customizing-your-c-code-for-swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/using-imported-c-structs-and-unions-in-swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/using-imported-c-macros-in-swift"],"generated":true,"anchor":"Language-interoperability"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/using-imported-c-functions-in-swift","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift imports any function declared in a C header as a Swift global function."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, consider the following C function declarations:"}]},{"type":"codeListing","code":["int product(int multiplier, int multiplicand);","int quotient(int dividend, int divisor, int *remainder);","","struct Point2D createPoint2D(float x, float y);","float distance(struct Point2D from, struct Point2D to);"],"syntax":"occ"},{"inlineContent":[{"type":"text","text":"Here’s how Swift imports them:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func product(_ multiplier: Int32, _ multiplicand: Int32) -> Int32","func quotient(_ dividend: Int32, _ divisor: Int32, _ remainder: Unsafe