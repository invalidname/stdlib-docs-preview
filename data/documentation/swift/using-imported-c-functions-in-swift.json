pe":"codeListing","code":["func swiftprintf(format: String, arguments: CVarArg...) -> String? {","    return withVaList(arguments) { va_list in","        var buffer: UnsafeMutablePointer<Int8>? = nil","        return format.withCString { cString in","            guard vasprintf(&buffer, cString, va_list) != 0 else {","                return nil","            }","","            return String(validatingUTF8: buffer!)","        }","    }","}","print(swiftprintf(format: \"√2 ≅ %g\", arguments: sqrt(2.0))!)","\/\/ Prints \"√2 ≅ 1.41421\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift only imports C variadic functions that use a "},{"type":"codeVoice","code":"va_list"},{"type":"text","text":" for their arguments."},{"type":"text","text":" "},{"type":"text","text":"C functions that use the "},{"type":"codeVoice","code":"..."},{"type":"text","text":" syntax for variadic arguments are not imported, and"},{"type":"text","text":" "},{"type":"text","text":"therefore can’t be called using "},{"type":"codeVoice","code":"CVarArg"},{"type":"text","text":" arguments."}]},{"level":3,"text":"Call Functions with Pointer Parameters","type":"heading","anchor":"Call-Functions-with-Pointer-Parameters"},{"inlineContent":[{"type":"text","text":"Whenever possible, Swift avoids giving you direct access to pointers. When importing"},{"type":"text","text":" "},{"type":"text","text":"C function parameters, however, Swift maps pointer parameters to standard library"},{"type":"text","text":" "},{"type":"text","text":"pointer types. The following tables use "},{"type":"codeVoice","code":"Type"},{"type":"text","text":" as a placeholder type name to indicate"},{"type":"text","text":" "},{"type":"text","text":"syntax for the mappings."}],"type":"paragraph"},{"inlineContent":[{"text":"For return types, variables, and arguments, the following mappings apply:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"C Syntax"}]}],[{"t