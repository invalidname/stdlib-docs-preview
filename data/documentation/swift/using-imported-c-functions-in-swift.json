{"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Swift imports any function declared in a C header as a Swift global function.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, consider the following C function declarations:","type":"text"}]},{"type":"codeListing","syntax":"occ","code":["int product(int multiplier, int multiplicand);","int quotient(int dividend, int divisor, int *remainder);","","struct Point2D createPoint2D(float x, float y);","float distance(struct Point2D from, struct Point2D to);"]},{"type":"paragraph","inlineContent":[{"text":"Here’s how Swift imports them:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func product(_ multiplier: Int32, _ multiplicand: Int32) -> Int32","func quotient(_ dividend: Int32, _ divisor: Int32, _ remainder: UnsafeMutablePointer<Int32>) -> Int32","","func createPoint2D(_ x: Float, _ y: Float) -> Point2D","func distance(_ from: Point2D, _ to: Point2D) -> Float"]},{"text":"Use a CVaListPointer to Call Variadic Functions","type":"heading","level":3,"anchor":"Use-a-CVaListPointer-to-Call-Variadic-Functions"},{"type":"paragraph","inlineContent":[{"text":"In Swift, you can call C variadic functions, such as ","type":"text"},{"type":"codeVoice","code":"vasprintf(_:_:_:)"},{"text":", using the","type":"text"},{"text":" ","type":"text"},{"text":"Swift ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/getVaList(_:)","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withVaList(_:_:)","isActive":true,"type":"reference"},{"text":" functions. The ","type":"text"},{"type":"codeVoice","code":"withVaList(_:_:)"},{"text":" ","type":"text"},{"text":"function takes an array of ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CVarArg","isActive":true,"type":"reference"},{"text":" values and provides a ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CVaListPointer","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"value within the body of a closure parameter, whereas the ","type":"text"},{"type":"codeVoice","code":"getVaList(_:)"},{"text":" function","type":"text"},{"text":" ","type":"text"},{"text":"returns this value directly. With either function, you pass the resulting ","type":"text"},{"type":"codeVoice","code":"CVaListPointer"},{"text":" ","type":"text"},{"text":"value as the ","type":"text"},{"type":"codeVoice","code":"va_list"},{"text":" argument of the C variadic function.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, here’s how to call the ","type":"text"},{"type":"codeVoice","code":"vasprintf(_:_:_:)"},{"text":" function in Swift:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func swiftprintf(format: String, arguments: CVarArg...) -> String? {","    return withVaList(arguments) { va_list in","        var buffer: UnsafeMutablePointer<Int8>? = nil","        return format.withCString { cString in","            guard vasprintf(&buffer, cString, va_list) != 0 else {","                return nil","            }","","            return String(validatingUTF8: buffer!)","        }","    }","}","print(swiftprintf(format: \"√2 ≅ %g\", arguments: sqrt(2.0))!)","\/\/ Prints \"√2 ≅ 1.41421\""]},{"type":"paragraph","inlineContent":[{"text":"Swift only imports C variadic functions that use a ","type":"text"},{"type":"codeVoice","code":"va_list"},{"text":" for their arguments.","type":"text"},{"text":" ","type":"text"},{"text":"C functions that use the ","type":"text"},{"type":"codeVoice","code":"..."},{"text":" syntax for variadic arguments are not imported, and","type":"text"},{"text":" ","type":"text"},{"text":"therefore can’t be called using ","type":"text"},{"type":"codeVoice","code":"CVarArg"},{"text":" arguments.","type":"text"}]},{"text":"Call Functions with Pointer Parameters","type":"heading","level":3,"anchor":"Call-Functions-with-Pointer-Parameters"},{"type":"paragraph","inlineContent":[{"text":"Whenever possible, Swift avoids giving you direct access to pointers. When importing","type":"text"},{"text":" ","type":"text"},{"text":"C function parameters, however, Swift maps pointer parameters to standard library","type":"text"},{"text":" ","type":"text"},{"text":"pointer types. The following tables use ","type":"text"},{"type":"codeVoice","code":"Type"},{"text":" as a placeholder type name to indicate","type":"text"},{"text":" ","type":"text"},{"text":"syntax for the mappings.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For return types, variables, and arguments, the following mappings apply:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"C Syntax"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Swift Syntax"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"const Type *"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafePointer"},{"type":"text","text":"<Type>"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Type *"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutablePointer"},{"type":"text","text":"<Type>"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"For class types, the following mappings apply:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"C Syntax"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Swift Syntax"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Type * const *"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafePointer"},{"type":"text","text":"<"},{"type":"text","text":"Type>"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Type * __strong *"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutablePointer"},{"type":"text","text":"<"},{"type":"text","text":"Type>"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Type **"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/AutoreleasingUnsafeMutablePointer"},{"type":"text","text":"<"},{"type":"text","text":"Type>"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"For pointers to untyped, raw memory, the following mappings apply:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"C Syntax"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Swift Syntax"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"const void *"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawPointer"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"void *"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawPointer"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"C function pointers are imported into Swift as closures with the C function pointer","type":"text"},{"text":" ","type":"text"},{"text":"calling convention, denoted by the ","type":"text"},{"type":"codeVoice","code":"@convention(c)"},{"text":" attribute. For example, a function","type":"text"},{"text":" ","type":"text"},{"text":"pointer that has the type ","type":"text"},{"type":"codeVoice","code":"int (*)(void)"},{"text":" in C is imported into Swift as ","type":"text"},{"type":"codeVoice","code":"@convention(c) () -> Int32"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the type of the value pointed to by a C pointer cannot be represented by Swift,","type":"text"},{"text":" ","type":"text"},{"text":"as is the case with an incomplete struct type, the pointer is imported as an ","type":"text"},{"type":"codeVoice","code":"OpaquePointer"},{"text":".","type":"text"}]}],"kind":"content"}],"sections":[],"seeAlsoSections":[{"title":"Language Interoperability with C and C++","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/customizing-your-c-code-for-swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/using-imported-c-structs-and-unions-in-swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/using-imported-c-macros-in-swift"],"generated":true,"anchor":"Language-Interoperability-with-C-and-C++"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/using-imported-c-functions-in-swift","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","modules":[{"name":"Swift"}],"title":"Using Imported C Functions in Swift","role":"article"},"abstract":[{"type":"text","text":"Learn how to call imported functions that are declared in a C header."}],"kind":"article","references":{"doc://com.apple.Swift/documentation/Swift/customizing-your-c-code-for-swift":{"type":"topic","title":"Customizing Your C Code for Swift","url":"\/documentation\/swift\/customizing-your-c-code-for-swift","abstract":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"CF_SWIFT_NAME"},{"text":" macro to group functions that have related behavior.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/customizing-your