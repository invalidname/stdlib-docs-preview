[{"content":[{"type":"paragraph","inlineContent":[{"text":"A string identifying the declaration that is the notional","type":"text"},{"text":" ","type":"text"},{"text":"source for the continuation, used to identify the continuation in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"runtime diagnostics related to misuse of this continuation."}]}],"name":"function"},{"name":"body","content":[{"inlineContent":[{"type":"text","text":"A closure that takes a "},{"code":"CheckedContinuation","type":"codeVoice"},{"text":" parameter.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"inlineContent":[{"text":"The value continuation is resumed with.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"text":"The body of the closure executes synchronously on the calling task, and once it returns","type":"text"},{"text":" ","type":"text"},{"text":"the calling task is suspended. It is possible to immediately resume the task, or escape the","type":"text"},{"text":" ","type":"text"},{"text":"continuation in order to complete it afterwards, which will then resume the suspended task.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You must invoke the continuation’s ","type":"text"},{"type":"codeVoice","code":"resume"},{"type":"text","text":" method exactly once."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Missing to invoke it (eventually) will cause the calling task to remain suspended","type":"text"},{"text":" ","type":"text"},{"text":"indefinitely which will result in the task “hanging” as well as being leaked with","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"no possibility to destroy it."}]},{"type":"paragraph","inlineContent":[{"text":"The checked continuation offers detection of misuse, and dropping th