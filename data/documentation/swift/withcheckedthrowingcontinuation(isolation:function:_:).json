on"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that takes a "},{"type":"codeVoice","code":"CheckedContinuation"},{"type":"text","text":" parameter."}]}],"name":"body"}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The value continuation is resumed with."}]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"The body of the closure executes synchronously on the calling task, and once it returns","type":"text"},{"text":" ","type":"text"},{"text":"the calling task is suspended. It is possible to immediately resume the task, or escape the","type":"text"},{"text":" ","type":"text"},{"text":"continuation in order to complete it afterwards, which will then resume the suspended task.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"resume(throwing:)"},{"text":" is called on the continuation, this function throws that error.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You must invoke the continuation’s ","type":"text"},{"type":"codeVoice","code":"resume"},{"text":" method exactly once.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Missing to invoke it (eventually) will cause the calling task to remain suspended"},{"type":"text","text":" "},{"type":"text","text":"indefinitely which will result in the task “hanging” as well as being leaked with"},{"type":"text","text":" "},{"type":"text","text":"no possibility to destroy it."}],"type":"paragraph"},{"inlineContent":[{"text":"The checked continuation offers detection of misuse, and dropping the last reference","type":"text"},{"text":" ","type":"text"},{"text":"to it, without having resumed it will trigger a warning. Resuming a continuation twice","type":"text"},{"text":" ","type":"text"},{"text":"is also diagnosed and will cause a crash.","type":"text"}],"type":"paragraph"},{"name":"See Also","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"withCheckedContinuation(function:_:)"}]}],"type":"aside"},{"name":"See Also","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"withUnsafeContinuation(function:_:)"}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"See Also","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"withUnsafeThrowingContinuation(function:_:)"}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/withcheckedthrowingcontinuation(isolation:function:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Invokes the passed in closure with a checked continuation for the current task."}],"references":{"doc://com.apple.Swift/documentation/Swift/UnsafeContinuation":{"navigatorTitle":[{"kind":"identifier","text":"UnsafeContinuation"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeContinuation","url":"\/documentation\/swift\/unsafecontinuation","abstract":[{"text":"A mechanism to interface","type":"text"},{"text":" ","type":"text"},{"text":"between synchronous and asynchronous code,","type":"text"},{"text":" ","type":"text"},{"text":"without correctness checking.","type":"text"}],"role":"symbol","title":"UnsafeContinuation","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UnsafeContinuation"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/withUnsafeContinuation(isolation:_:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withUnsafeContinuation(isolation:_:)","type":"topic","role":"symbol","url":"\/documentation\/swift\/withunsafecontinuation(isolation:_:)","kind":"symbol","