],"seeAlsoSections":[{"anchor":"Task-Deadlines","generated":true,"title":"Task Deadlines","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/withDeadline(in:tolerance:clock:operation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/hasActiveDeadline","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/activeDeadline(for:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"nonisolated","kind":"attribute"},{"text":"(nonsending) ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withDeadline","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Return","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"expiration","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"C","preciseIdentifier":"s:12_Concurrency12withDeadline_9tolerance5clock9operationx7InstantAA5ClockPQy0__8DurationAHQy0_Sgq0_xyYaq_YKYCXEtYaq_YKs5ErrorR_s12IdentifiableR0_AaGR0_Ri_zr1_lF1CL_q0_mfp","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Instant","preciseIdentifier":"s:12_Concurrency5ClockP7InstantQa","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Clock\/Instant","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","preciseIdentifier":"s:12_Concurrency12withDeadline_9tolerance5clock9operationx7InstantAA5ClockPQy0__8DurationAHQy0_Sgq0_xyYaq_YKYCXEtYaq_YKs5ErrorR_s12IdentifiableR0_AaGR0_Ri_zr1_lF1CL_q0_mfp","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Instant","preciseIdentifier":"s:12_Concurrency5ClockP7InstantQa","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Clock\/Instant","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s15InstantProtocolP8DurationQa","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/InstantProtocol\/Duration","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","preciseIdentifier":"s:12_Concurrency12withDeadline_9tolerance5clock9operationx7InstantAA5ClockPQy0__8DurationAHQy0_Sgq0_xyYaq_YKYCXEtYaq_YKs5ErrorR_s12IdentifiableR0_AaGR0_Ri_zr1_lF1CL_q0_mfp","kind":"typeIdentifier"},{"text":" = ContinuousClock(), ","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"nonisolated(nonsending)","kind":"keyword"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Failure","preciseIdentifier":"s:12_Concurrency12withDeadline_9tolerance5clock9operationx7InstantAA5ClockPQy0__8DurationAHQy0_Sgq0_xyYaq_YKYCXEtYaq_YKs5ErrorR_s12IdentifiableR0_AaGR0_Ri_zr1_lF7FailureL_q_mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Return","preciseIdentifier":"s:12_Concurrency12withDeadline_9tolerance5clock9operationx7InstantAA5ClockPQy0__8DurationAHQy0_Sgq0_xyYaq_YKYCXEtYaq_YKs5ErrorR_s12IdentifiableR0_AaGR0_Ri_zr1_lF6ReturnL_xmfp","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:s5ErrorP"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable","kind":"typeIdentifier","text":"Identifiable","preciseIdentifier":"s:s12IdentifiableP"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Clock","kind":"typeIdentifier","text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":", ","kind":"text"},{"text":"Return","kind":"typeIdentifier"},{"text":" : ~Copyable","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The instant by which the operation must complete."}]}],"name":"expiration"},{"content":[{"inlineContent":[{"type":"text","text":"The tolerance used for the sleep. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"tolerance"},{"name":"clock","content":[{"inlineContent":[{"type":"text","text":"The clock to use for measuring time. Defaults to "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContinuousClock","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"operation","content":[{"inlineContent":[{"type":"text","text":"The asynchronous operation to complete before the deadline."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The result of the operation if it completes successfully before or after the deadline expires."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this function to limit the execution time of an asynchronous operation to a specific instant."},{"type":"text","text":" "},{"type":"text","text":"If the operation completes before the deadline expires, this function returns the result. If the"},{"type":"text","text":" "},{"type":"text","text":"deadline expires first, this function cancels the operation. The "},{"code":"withDeadline","type":"codeVoice"},{"type":"text","text":" function will"},{"type":"text","text":" "},{"type":"text","text":"return or throw according to how the operation returns or throws as a response to the cancellation."}]},{"inlineContent":[{"type":"text","text":"The following example demonstrates using a deadline to limit a network request:"}],"type":"paragraph"},{"code":["let clock = ContinuousClock()","let deadline = clock.now.advanced(by: .seconds(5))","do {","    let result = try await withDeadline(deadline, clock: clock) {","        try await fetchDataFromServer()","    }","    print(\"Data received: \\(result)\")","} catch {","    print(\"Operation failed\")","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Behavior","type":"heading","text":"Behavior"},{"inlineContent":[{"type":"text","text":"The function exhibits the following behavior based on deadline and operation completion:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the operation completes successfully before deadline: Returns the operation result."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If the operation throws an error before deadline: Throws the operation error."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If deadline expires and operation completes successfully: Returns the operation result."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If deadline expires and operation throws an error: Throws the operation error,"},{"type":"text","text":" "},{"type":"text","text":"potentially a "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","isActive":true},{"type":"text","text":" if the operation throws it as a result of the"},{"type":"text","text":" "},{"type":"text","text":"deadline-triggered cancellation."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"When the deadline expires "},{"code":"Task.isCancelled","type":"codeVoice"},{"type":"text","text":" returns true for the duration of "},{"code":"operation","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This cancellation does not affect the “outer” task in which the deadline operation was started:"}],"type":"paragraph"},{"code":["try await withDeadline(in: .seconds(2)) {","  while !Task.isCancelled {","    try? await Task.sleep(for: .seconds(1))","  }","  assert(Task.isCancelled == true)","}","assert(Task.isCancelled == false) \/\/ the outer task is unaffected"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This means:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"Task.isCancelled","type":"codeVoice"},{"type":"text","text":" observed inside "},{"code":"operation","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":" after the deadline is exceeded."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Child tasks, created using "},{"type":"codeVoice","code":"async let"},{"type":"text","text":", or task groups, inside "},{"code":"operation","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"are cancelled automatically when the deadline is exceeded. This is not"},{"type":"text","text":" "},{"type":"text","text":"optional: such children can never escape "},{"code":"operation","type":"codeVoice"},{"type":"text","text":"‘s scope (it cannot"},{"type":"text","text":" "},{"type":"text","text":"return until they’ve completed), so they are cancelled along with it -"},{"type":"text","text":" "},{"type":"text","text":"whether they were already running when the deadline expired or are"},{"type":"text","text":" "},{"type":"text","text":"spawned afterwards."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"withTaskCancellationHandler","type":"codeVoice"},{"type":"text","text":" handlers created within "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" are triggered as expected."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The enclosing task’s "},{"type":"codeVoice","code":"Task.isCancelled"},{"type":"text","text":" is unaffected."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a deadline expires, semantically the scope of the task which is running the "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" "},{"type":"text","text":"becomes cancelled. This is observable using "},{"type":"codeVoice","code":"Task.isCancelled"},{"type":"text","text":" and similar APIs, and has"},{"type":"text","text":" "},{"type":"text","text":"the usual effect on child tasks and task cancellation handlers created inside "},{"type":"codeVoice","code":"operation"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Task deadlines are a structured concurrency mechanism, and even though a deadline’s expiry cancels"},{"type":"text","text":" "},{"type":"text","text":"the operation scope, the "},{"type":"codeVoice","code":"withDeadline"},{"type":"text","text":" closure will await for the operation to complete."},{"type":"text","text":" "},{"type":"text","text":"The operation code must cooperatively be checking for cancellation, or make use of cancellation handlers,"},{"type":"text","text":" "},{"type":"text","text":"if it wants to react and return “early”."}]},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"withDeadline"},{"type":"text","text":" function may return after the deadline has expired."},{"type":"text","text":" "},{"type":"text","text":"Similarily, even if the deadline is set in the past, the operation will still always execute -"},{"type":"text","text":" "},{"type":"text","text":"and it is up to the operation (or any of its parts, or child tasks) to determine if it should"},{"type":"text","text":" "},{"type":"text","text":"proceed with its computation or not."}],"type":"paragraph"},{"text":"Coordinating multiple operations","level":2,"type":"heading","anchor":"Coordinating-multiple-operations"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"withDeadline","type":"codeVoice"},{"type":"text","text":" when coordinating multiple operations to complete by the same instant:"}],"type":"paragraph"},{"code":["let clock = ContinuousClock()","let deadline = clock.now.advanced(by: .seconds(10))","","async let result1 = withDeadline(deadline, clock: clock) {","    try await fetchUserData()","}","async let result2 = withDeadline(deadline) {","    try await fetchPreferences()","}","","let (user, prefs) = try await (result1, result2)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This ensures both operations share the same absolute deadline, avoiding duration drift that can occur"},{"type":"text","text":" "},{"type":"text","text":"when timeouts are passed through multiple call layers."}],"type":"paragraph"},{"name":"Throws","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The error thrown by the operation."}]}]},{"name":"See Also","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withDeadline(in:tolerance:clock:operation:)"}]}]}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/CancellationError":{"type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CancellationError"}],"abstract":[{"type":"text","text":"An error that indicates a task was canceled."}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","title":"CancellationError","url":"\/documentation\/swift\/cancellationerror","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CancellationError"}]},"doc://com.apple.Swift/documentation/Swift/Task/activeDeadline(for:)":{"role":"symbol","url":"\/documentation\/swift\/task\/activedeadline(for:)","title":"activeDeadline(for:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/activeDeadline(for:)","conformance":{"constraints":[{"code":"Success","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Never","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Failure","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Never","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"activeDeadline"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"preciseIdentifier":"s:ScT12_Concurrencys5NeverORszACRs_rlE14activeDeadline3for7InstantAA5ClockPQyd__Sgqd___ts12IdentifiableRd__AaGRd__lFZ1CL_qd__mfp","kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:ScT12_Concurrencys5NeverORszACRs_rlE14activeDeadline3for7InstantAA5ClockPQyd__Sgqd___ts12IdentifiableRd__AaGRd__lFZ1CL_qd__mfp","kind":"typeIdentifier","text":"C"},{"kind":"text","text":"."},{"preciseIdentifier":"s:12_Concurrency5ClockP7InstantQa","kind":"typeIdentifier","text":"Instant"},{"kind":"text","text":"?"}],"abstract":[{"text":"Find the nearest active deadline installed on the current task for the","type":"text"},{"text":" ","type":"text"},{"text":"specified clock.","type":"text"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/withDeadline(in:tolerance:clock:operation:)":{"url":"\/documentation\/swift\/withdeadline(in:tolerance:clock:operat