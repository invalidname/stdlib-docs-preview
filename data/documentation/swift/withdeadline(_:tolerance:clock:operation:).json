:12_Concurrency12withDeadline_9tolerance5clock9operationx7InstantAA5ClockPQy0__8DurationAHQy0_Sgq0_xyYaq_YKYCXEtYaq_YKs5ErrorR_s12IdentifiableR0_AaGR0_Ri_zr1_lF1CL_q0_mfp","text":"C","kind":"typeIdentifier"},{"text":" = ContinuousClock(), ","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"nonisolated(nonsending)","kind":"keyword"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:12_Concurrency12withDeadline_9tolerance5clock9operationx7InstantAA5ClockPQy0__8DurationAHQy0_Sgq0_xyYaq_YKYCXEtYaq_YKs5ErrorR_s12IdentifiableR0_AaGR0_Ri_zr1_lF7FailureL_q_mfp","text":"Failure","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency12withDeadline_9tolerance5clock9operationx7InstantAA5ClockPQy0__8DurationAHQy0_Sgq0_xyYaq_YKYCXEtYaq_YKs5ErrorR_s12IdentifiableR0_AaGR0_Ri_zr1_lF6ReturnL_xmfp","text":"Return","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Identifiable","preciseIdentifier":"s:s12IdentifiableP","text":"Identifiable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Clock","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":", ","kind":"text"},{"text":"Return","kind":"typeIdentifier"},{"text":" : ~Copyable","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"expiration","content":[{"inlineContent":[{"text":"The instant by which the operation must complete.","type":"text"}],"type":"paragraph"}]},{"name":"tolerance","content":[{"inlineContent":[{"text":"The tolerance used for the sleep. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"clock","content":[{"inlineContent":[{"text":"The clock to use for measuring time. Defaults to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ContinuousClock","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"operation","content":[{"inlineContent":[{"type":"text","text":"The asynchronous operation to complete before the deadline."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The result of the operation if it completes successfully before or after the deadline expires."}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"Use this function to limit the execution time of an asynchronous operation to a specific instant."},{"type":"text","text":" "},{"type":"text","text":"If the operation completes before the deadline expires, this function returns the result. If the"},{"type":"text","text":" "},{"type":"text","text":"deadline expires first, this function cancels the operation. The "},{"code":"withDeadline","type":"codeVoice"},{"type":"text","text":" function will"},{"type":"text","text":" "},{"type":"text","text":"return or throw according to how the operation returns or throws as a response to the cancellation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example demonstrates using a deadline to limit a network request:"}],"type":"paragraph"},{"type":"codeListing","code":["let clock = ContinuousClock()","let deadline = clock.now.advanced(by: .seconds(5))","do {","    let result = try await withDeadline(deadline, clock: clock) {","        try await fetchDataFromServer()","    }","    print(\"Data received: \\(result)\")","} catch {","    print(\"Operation failed\")","}"],"syntax":"swift"},{"type":"heading","anchor":"Behavior","level":2,"text":"Behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The function exhibits the following behavior based on deadline and operation completion:"}]},{"items":[{"content":[{"inlineContent":[{"text":"If the operation completes successfully before deadline: Returns the operation result.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If the operation throws an error before deadline: Throws the operation error.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If deadline expires and operation completes successfully: Returns the operation result.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If deadline expires and operation throws an error: Throws the operation error,","type":"text"},{"text":" ","type":"text"},{"text":"potentially a ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","isActive":true,"type":"reference"},{"text":" if the operation throws it as a result of the","type":"text"},{"text":" ","type":"text"},{"text":"deadline-triggered cancellation.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"When the deadline expires ","type":"text"},{"code":"Task.isCancelled","type":"codeVoice"},{"text":" returns true for the duration of ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This cancellation does not affect the “outer” task in which the deadline operation was started:","type":"text"}],"type":"paragraph"},{"code":["try await withDeadline(in: .seconds(2)) {","  while !Task.isCancelled {","    try? await Task.sleep(for: .seconds(1))","  }","  assert(Task.isCancelled == true)","}","assert(Task.isCancelled == false) \/\/ the outer task is unaffected"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This means:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"Task.isCancelled","type":"codeVoice"},{"text":" observed inside ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" after the deadline is exceeded.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Child tasks, created using ","type":"text"},{"code":"async let","type":"codeVoice"},{"text":", or task groups, inside ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are cancelled automatically when the deadline is exceeded. This is not","type":"text"},{"text":" ","type":"text"},{"text":"optional: such children can never escape ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":"‘s scope (it cannot","type":"text"},{"text":" ","type":"text"},{"text":"return until they’ve completed), so they are cancelled along with it -","type":"text"},{"text":" ","type":"text"},{"text":"whether they were already running when the deadline expired or are","type":"text"},{"text":" ","type":"text"},{"text":"spawned afterwards.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"withTaskCancellationHandler","type":"codeVoice"},{"text":" handlers created within ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":" are triggered as expected.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The enclosing task’s ","type":"text"},{"code":"Task.isCancelled","type":"codeVoice"},{"text":" is unaffected.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"When a deadline expires, semantically the scope of the task which is running the ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":" ","type":"text"},{"text":"becomes cancelled. This is observable using ","type":"text"},{"code":"Task.isCancelled","type":"codeVoice"},{"text":" and similar APIs, and has","type":"text"},{"text":" ","type":"text"},{"text":"the usual effect on child tasks and task cancellation handlers created inside ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Task deadlines are a structured concurrency mechanism, and even though a deadline’s expiry cancels","type":"text"},{"text":" ","type":"text"},{"text":"the operation scope, the ","type":"text"},{"code":"withDeadline","type":"codeVoice"},{"text":" closure will await for the operation to complete.","type":"text"},{"text":" ","type":"text"},{"text":"The operation code must cooperatively be checking for cancellation, or make use of cancellation handlers,","type":"text"},{"text":" ","type":"text"},{"text":"if it wants to react and return “early”.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"withDeadline","type":"codeVoice"},{"text":" function may return after the deadline has expired.","type":"text"},{"text":" ","type":"text"},{"text":"Similarily, even if the deadline is set in the past, the operation will still always execute -","type":"text"},{"text":" ","type":"text"},{"text":"and it is up to the operation (or any of its parts, or child tasks) to determine if it should","type":"text"},{"text":" ","type":"text"},{"text":"proceed with its computation or not.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Coordinating-multiple-operations","level":2,"text":"Coordinating multiple operations"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"withDeadline","type":"codeVoice"},{"text":" when coordinating multiple operations to complete by the same instant:","type":"text"}],"type":"paragraph"},{"code":["let clock = ContinuousClock()","let deadline = clock.now.advanced(by: .seconds(10))","","async let result1 = withDeadline(deadline, clock: clock) {","    try await fetchUserData()","}","async let result2 = withDeadline(deadline) {","    try await fetchPreferences()","}","","let (user, prefs) = try await (result1, result2)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This ensures both operations share the same absolute deadline, avoiding duration drift that can occur","type":"text"},{"text":" ","type":"text"},{"text":"when timeouts are passed through multiple call layers.","type":"text"}],"type":"paragraph"},{"type":"aside","name":"Throws","content":[{"inlineContent":[{"text":"The error thrown by the operation.","type":"text"}],"type":"paragraph"}],"style":"note"},{"type":"aside","name":"See Also","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withDeadline(in:tolerance:clock:operation:)","type":"reference"}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"sections":[],"abstract":[{"text":"Executes an operation with the expectation it completes within a specified deadline.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/withdeadline(_:tolerance:clock:operation:)"]}],"references":{"doc://com.apple.Swift/documentation/Swift/CancellationError":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","role":"symbol","title":"CancellationError","navigatorTitle":[{"text":"CancellationError","kind":"identifier"}],"url":"\/documentation\/swift\/cancellationerror","abstract":[{"type":"text","text":"An error that indicates a task was canceled."}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"