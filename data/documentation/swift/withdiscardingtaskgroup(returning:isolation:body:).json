eading":"Function","title":"withDiscardingTaskGroup(returning:isolation:body:)","platforms":[{"unavailable":false,"deprecated":false,"beta":false,"name":"iOS","introducedAt":"8.0"},{"unavailable":false,"deprecated":false,"beta":false,"name":"iPadOS","introducedAt":"8.0"},{"unavailable":false,"deprecated":false,"beta":false,"name":"Mac Catalyst","introducedAt":"13.0"},{"unavailable":false,"deprecated":false,"beta":false,"name":"macOS","introducedAt":"10.10"},{"unavailable":false,"deprecated":false,"beta":false,"name":"tvOS","introducedAt":"9.0"},{"unavailable":false,"deprecated":false,"beta":false,"name":"visionOS","introducedAt":"1.0"},{"unavailable":false,"deprecated":false,"beta":false,"name":"watchOS","introducedAt":"2.0"}],"symbolKind":"func","role":"symbol"},"seeAlsoSections":[{"title":"Tasks","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority","doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"],"anchor":"Tasks"}],"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"abstract":[{"text":"Starts a new scope that can contain a dynamic number of child tasks.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@backDeployed(before: macOS 15.0, iOS 18.0, watchOS 11.0, tvOS 18.0, visionOS 2.0)\n","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withDiscardingTaskGroup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"GroupResult","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"returning","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"returnType","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"GroupResult","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency23withDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdE0VzYaXEtYalF0E6ResultL_xmfp"},{"text":".Type = GroupResult.self, ","kind":"text"},{"text":"isolation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"isolated","kind":"keyword"},{"text":" (","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor","text":"Actor","kind":"typeIdentifier","preciseIdentifier":"s:ScA"},{"text":")? = #isolation, ","kind":"text"},{"text":"body","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","text":"DiscardingTaskGroup","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency19DiscardingTaskGroupV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"GroupResult","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency23withDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdE0VzYaXEtYalF0E6ResultL_xmfp"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"GroupResult","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency23withDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdE0VzYaXEtYalF0E6ResultL_xmfp"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Unlike a "},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference"},{"type":"text","text":", the child tasks as well as their results are"},{"type":"text","text":" "},{"type":"text","text":"discarded as soon as the tasks complete. This prevents the discarding"},{"type":"text","text":" "},{"type":"text","text":"task group from accumulating many results waiting to be consumed, and is"},{"type":"text","text":" "},{"type":"text","text":"best applied in situations where the result of a child task is some form"},{"type":"text","text":" "},{"type":"text","text":"of side-effect."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A group "},{"type":"emphasis","inlineContent":[{"type":"text","text":"always"}]},{"type":"text","text":" waits for all of its child tasks"},{"type":"text","text":" "},{"type":"text","text":"to complete before it returns. Even canceled tasks must run until"},{"type":"text","text":" "},{"type":"text","text":"completion before this function returns."},{"type":"text","text":" "},{"type":"text","text":"Canceled child tasks cooperatively react to cancellation and attempt"},{"type":"text","text":" "},{"type":"text","text":"to return as early as possible."},{"type":"text","text":" "},{"type":"text","text":"After this function returns, the task group is always empty."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is not possible to explicitly await completion of child-tasks,"},{"type":"text","text":" "},{"type":"text","text":"however the group will automatically await "},{"type":"emphasis","inlineContent":[{"type":"text","text":"all"}]},{"type":"text","text":" child task completions"},{"type":"text","text":" "},{"type":"text","text":"before returning from this function:"}],"type":"paragraph"},{"syntax":"swift","code":["await withDiscardingTaskGroup(...) { group in","  group.addTask { \/* slow-task *\/ }","  \/\/ slow-task executes...","}","\/\/ guaranteed that slow-task has completed and the group is empty & destroyed"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Refer to "},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference"},{"type":"text","text":" documentation for detailed discussion of semantics shared between all task groups."}],"type":"paragraph"},{"level":1,"anchor":"Task-Group-Cancellation","text":"Task Group Cancellation","type":"heading"},{"inlineContent":[{"type":"text","text":"You can cancel a task group and all of its child tasks"},{"type":"text","text":" "},{"type":"text","text":"by calling the "},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup\/cancelAll()","type":"reference"},{"type":"text","text":" method on the task group,"},{"type":"text","text":" "},{"type":"text","text":"or by canceling the task in which the group is running."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you call "},{"type":"codeVoice","code":"addTask(priority:operation:)"},{"type":"text","text":" to create a new task in a canceled group,"},{"type":"text","text":" "},{"type":"text","text":"that task is immediately canceled after creation."},{"type":"text","text":" "},{"type":"text","text":"Alternatively, you can call "},{"type":"codeVoice","code":"asyncUnlessCancelled(priority:operation:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which doesn’t create the task if the group has already been canceled."},{"type":"text","text":" "},{"type":"text","text":"Choosing between these two functions"},{"type":"text","text":" "},{"type":"text","text":"lets you control how to react to cancellation within a group:"},{"type":"text","text":" "},{"type":"text","text":"some child tasks need to run regardless of cancellation,"},{"type":"text","text":" "},{"type":"text","text":"but other tasks are better not even being created"},{"type":"text","text":" "},{"type":"text","text":"when you know they can’t produce useful results."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because the tasks you add to a group with this method are nonthrowing,"},{"type":"text","text":" "},{"type":"text","text":"those tasks can’t respond to cancellation by throwing "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The tasks must handle cancellation in some other way,"},{"type":"text","text":" "},{"type":"text","text":"such as returning the work completed so far, returning an empty result, or returning "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"For tasks that need to handle cancellation by throwing an error,"},{"type":"text","text":" "},{"type":"text","text":"use the "},{"type":"codeVoice","code":"withThrowingDiscardingTaskGroup(returning:body:)"},{"type":"text","text":" method instead."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup"}]}],"name":"See Also","style":"note","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"withThrowingDiscardingTaskGroup(returning:body:)"}]}],"name":"See Also","style":"note","type":"aside"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Task":{"role":"symbol","title":"Task","abstract":[{"type":"text","text":"A unit of asynchronous work."}],"url":"\/documentation\/swift\/task","navigatorTitle":[{"text":"Task","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"