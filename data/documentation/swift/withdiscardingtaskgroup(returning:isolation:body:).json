{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/withdiscardingtaskgroup(returning:isolation:body:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)"},"abstract":[{"text":"Starts a new scope that can contain a dynamic number of child tasks.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@backDeployed(before: macOS 15.0, iOS 18.0, watchOS 11.0, tvOS 18.0, visionOS 2.0)\n","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withDiscardingTaskGroup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"GroupResult","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"returning","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"returnType","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"GroupResult","preciseIdentifier":"s:12_Concurrency23withDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdE0VzYaXEtYalF0E6ResultL_xmfp","kind":"typeIdentifier"},{"text":".Type = GroupResult.self, ","kind":"text"},{"text":"isolation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"isolated","kind":"keyword"},{"text":" (","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Actor","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor","kind":"typeIdentifier","preciseIdentifier":"s:ScA"},{"text":")? = #isolation, ","kind":"text"},{"text":"body","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DiscardingTaskGroup","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency19DiscardingTaskGroupV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"GroupResult","preciseIdentifier":"s:12_Concurrency23withDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdE0VzYaXEtYalF0E6ResultL_xmfp","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"GroupResult","preciseIdentifier":"s:12_Concurrency23withDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdE0VzYaXEtYalF0E6ResultL_xmfp","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Unlike a ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference","isActive":true},{"text":", the child tasks as well as their results are","type":"text"},{"text":" ","type":"text"},{"text":"discarded as soon as the tasks complete. This prevents the discarding","type":"text"},{"text":" ","type":"text"},{"text":"task group from accumulating many results waiting to be consumed, and is","type":"text"},{"text":" ","type":"text"},{"text":"best applied in situations where the result of a child task is some form","type":"text"},{"text":" ","type":"text"},{"text":"of side-effect.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A group ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"always","type":"text"}]},{"text":" waits for all of its child tasks","type":"text"},{"text":" ","type":"text"},{"text":"to complete before it returns. Even canceled tasks must run until","type":"text"},{"text":" ","type":"text"},{"text":"completion before this function returns.","type":"text"},{"text":" ","type":"text"},{"text":"Canceled child tasks cooperatively react to cancellation and attempt","type":"text"},{"text":" ","type":"text"},{"text":"to return as early as possible.","type":"text"},{"text":" ","type":"text"},{"text":"After this function returns, the task group is always empty.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It is not possible to explicitly await completion of child-tasks,","type":"text"},{"text":" ","type":"text"},{"text":"however the group will automatically await ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"all","type":"text"}]},{"text":" child task completions","type":"text"},{"text":" ","type":"text"},{"text":"before returning from this function:","type":"text"}]},{"code":["await withDiscardingTaskGroup(...) { group in","  group.addTask { \/* slow-task *\/ }","  \/\/ slow-task executes...","}","\/\/ guaranteed that slow-task has completed and the group is empty & destroyed"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Refer to ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference","isActive":true},{"text":" documentation for detailed discussion of semantics shared between all task groups.","type":"text"}]},{"level":1,"anchor":"Task-Group-Cancellation","text":"Task Group Cancellation","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"You can cancel a task group and all of its child tasks","type":"text"},{"text":" ","type":"text"},{"text":"by calling the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup\/cancelAll()","type":"reference","isActive":true},{"text":" method on the task group,","type":"text"},{"text":" ","type":"text"},{"text":"or by canceling the task in which the group is running.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you call ","type":"text"},{"code":"addTask(priority:operation:)","type":"codeVoice"},{"text":" to create a new task in a canceled group,","type":"text"},{"text":" ","type":"text"},{"text":"that task is immediately canceled after creation.","type":"text"},{"text":" ","type":"text"},{"text":"Alternatively, you can call ","type":"text"},{"code":"asyncUnlessCancelled(priority:operation:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which doesn’t create the task if the group has already been canceled.","type":"text"},{"text":" ","type":"text"},{"text":"Choosing between these two functions","type":"text"},{"text":" ","type":"text"},{"text":"lets you control how to react to cancellation within a group:","type":"text"},{"text":" ","type":"text"},{"text":"some child tasks need to run regardless of cancellation,","type":"text"},{"text":" ","type":"text"},{"text":"but other tasks are better not even being created","type":"text"},{"text":" ","type":"text"},{"text":"when you know they can’t produce useful results.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because the tasks you add to a group with this method are nonthrowing,","type":"text"},{"text":" ","type":"text"},{"text":"those tasks can’t respond to cancellation by throwing ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The tasks must handle cancellation in some other way,","type":"text"},{"text":" ","type":"text"},{"text":"such as returning the work completed so far, returning an empty result, or returning ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"For tasks that need to handle cancellation by throwing an error,","type":"text"},{"text":" ","type":"text"},{"text":"use the ","type":"text"},{"code":"withThrowingDiscardingTaskGroup(returning:isolation:body:)","type":"codeVoice"},{"text":" method instead.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference","isActive":true}],"type":"paragraph"}],"style":"note","name":"See Also"},{"type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingDiscardingTaskGroup(returning:isolation:body:)","type":"reference","isActive":true}],"type":"paragraph"}],"style":"note","name":"See Also"}]}],"seeAlsoSections":[{"title":"Tasks","generated":true,"anchor":"Tasks","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority","doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"]}],"metadata":{"symbolKind":"func","externalID":"s:12_Concurrency23withDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdE0VzYaXEtYalF","roleHeading":"Function","role":"symbol","platforms":[{"introducedAt":"8.0","beta":false,"unavailable":false,"name":"iOS","deprecated":false},{"introducedAt":"8.0","beta":false,"unavailable":false,"name":"iPadOS","deprecated":false},{"introducedAt":"13.0","beta":false,"unavailable":false,"name":"Mac Catalyst","deprecated":false},{"introducedAt":"10.10","beta":false,"unavailable":false,"name":"macOS","deprecated":false},{"introducedAt":"9.0","beta":false,"unavailable":false,"name":"tvOS","deprecated":false},{"introducedAt":"1.0","beta":false,"unavailable":false,"name":"visionOS","deprecated":false},{"introducedAt":"2.0","beta":false,"unavailable":false,"name":"watchOS","deprecated":false}],"modules":[{"relatedModules