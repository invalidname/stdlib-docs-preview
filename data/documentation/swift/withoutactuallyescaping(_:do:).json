{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withoutActuallyEscaping(_:do:)"},"abstract":[{"text":"Allows a nonescaping closure to temporarily be used as if it were allowed","type":"text"},{"text":" ","type":"text"},{"text":"to escape.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@export(implementation)"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withoutActuallyEscaping"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"ClosureType"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"ResultType"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"closure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ClosureType","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF11ClosureTypeL_xmfp"},{"kind":"text","text":", "},{"kind":"externalParam","text":"do"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"escapingClosure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ClosureType","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF11ClosureTypeL_xmfp"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Failure","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF7FailureL_q0_mfp"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ResultType","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF10ResultTypeL_q_mfp"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Failure","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF7FailureL_q0_mfp"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ResultType","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF10ResultTypeL_q_mfp"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"closure","content":[{"inlineContent":[{"text":"A nonescaping closure value that is made escapable for the","type":"text"},{"text":" ","type":"text"},{"text":"duration of the execution of the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" closure. If ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" has a","type":"text"},{"text":" ","type":"text"},{"text":"return value, that value is also used as the return value for the","type":"text"},{"text":" ","type":"text"},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":" function.","type":"text"}],"type":"paragraph"}]},{"name":"body","content":[{"inlineContent":[{"text":"A closure that is executed immediately with an escapable copy of","type":"text"},{"text":" ","type":"text"},{"code":"closure","type":"codeVoice"},{"text":" as its argument.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"inlineContent":[{"text":"The return value, if any, of the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" closure.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"text":"You can use this function to call an API that takes an escaping closure in","type":"text"},{"text":" ","type":"text"},{"text":"a way that doesn’t allow the closure to escape in practice. The examples","type":"text"},{"text":" ","type":"text"},{"text":"below demonstrate how to use ","type":"text"},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"text":"conjunction with two common APIs that use escaping closures: lazy","type":"text"},{"text":" ","type":"text"},{"text":"collection views and asynchronous operations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following code declares an ","type":"text"},{"code":"allValues(in:match:)","type":"codeVoice"},{"text":" function that checks","type":"text"},{"text":" ","type":"text"},{"text":"whether all the elements in an array match a predicate. The function won’t","type":"text"},{"text":" ","type":"text"},{"text":"compile as written, because a lazy collection’s ","type":"text"},{"code":"filter(_:)","type":"codeVoice"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"requires an escaping closure. The lazy collection isn’t persisted, so the","type":"text"},{"text":" ","type":"text"},{"code":"predicate","type":"codeVoice"},{"text":" closure won’t actually escape the body of the function;","type":"text"},{"text":" ","type":"text"},{"text":"nevertheless, it can’t be used in this way.","type":"text"}],"type":"paragraph"},{"code":["func allValues(in array: [Int], match predicate: (Int) -> Bool) -> Bool {","    return array.lazy.filter { !predicate($0) }.isEmpty","}","\/\/ error: closure use of non-escaping parameter 'predicate'..."],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":" provides a temporarily escapable copy of","type":"text"},{"text":" ","type":"text"},{"code":"predicate","type":"codeVoice"},{"text":" that ","type":"text"},{"inlineContent":[{"text":"can","type":"text"}],"type":"emphasis"},{"text":" be used in a call to the lazy view’s ","type":"text"},{"code":"filter(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"method. The second version of ","type":"text"},{"code":"allValues(in:match:)","type":"codeVoice"},{"text":" compiles without","type":"text"},{"text":" ","type":"text"},{"text":"error, with the compiler guaranteeing that the ","type":"text"},{"code":"escapablePredicate","type":"codeVoice"},{"text":" ","type":"text"},{"text":"closure doesn’t last beyond the call to ","type":"text"},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["func allValues(in array: [Int], match predicate: (Int) -> Bool) -> Bool {","    return withoutActuallyEscaping(predicate) { escapablePredicate in","        array.lazy.filter { !escapablePredicate($0) }.isEmpty","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Asynchronous calls are another type of API that typically escape their","type":"text"},{"text":" ","type":"text"},{"text":"closure arguments. The following code declares a","type":"text"},{"text":" ","type":"text"},{"code":"perform(_:simultaneouslyWith:)","type":"codeVoice"},{"text":" function that uses a dispatch queue to","type":"text"},{"text":" ","type":"text"},{"text":"execute two closures concurrently.","type":"text"}],"type":"paragraph"},{"code":["func perform(_ f: () -> Void, simultaneouslyWith g: () -> Void) {","    let queue = DispatchQueue(label: \"perform\", attributes: .concurrent)","    queue.async(execute: f)","    queue.async(execute: g)","    queue.sync(flags: .barrier) {}","}","\/\/ error: passing non-escaping parameter 'f'...","\/\/ error: passing non-escaping parameter 'g'..."],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"perform(_:simultaneouslyWith:)","type":"codeVoice"},{"text":" function ends with a call to the","type":"text"},{"text":" ","type":"text"},{"code":"sync(flags:execute:)","type":"codeVoice"},{"text":" method using the ","type":"text"},{"code":".barrier","type":"codeVoice"},{"text":" flag, which forces the","type":"text"},{"text":" ","type":"text"},{"text":"function to wait until both closures have completed running before","type":"text"},{"text":" ","type":"text"},{"text":"returning. Even though the barrier guarantees that neither closure will","type":"text"},{"text":" ","type":"text"},{"text":"escape the function, the ","type":"text"},{"code":"async(execute:)","type":"codeVoice"},{"text":" method still requires that the","type":"text"},{"text":" ","type":"text"},{"text":"closures passed be marked as ","type":"text"},{"code":"@escaping","type":"codeVoice"},{"text":", so the first version of the","type":"text"},{"text":" ","type":"text"},{"text":"function does not compile. To resolve these errors, you can use","type":"text"},{"text":" ","type":"text"},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":" to get copies of ","type":"text"},{"code":"f","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"g","type":"codeVoice"},{"text":" that can be","type":"text"},{"text":" ","type":"text"},{"text":"passed to ","type":"text"},{"code":"async(execute:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["func perform(_ f: () -> Void, simultaneouslyWith g: () -> Void) {","    withoutActuallyEscaping(f) { escapableF in","        withoutActuallyEscaping(g) { escapableG in","            let queue = DispatchQueue(label: \"perform\", attributes: .concurrent)","            queue.async(execute: escapableF)","            queue.async(execute: escapableG)","            queue.sync(flags: .barrier) {}","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The escapable copy of "},{"type":"codeVoice","code":"closure"},{"type":"text","text":" passed to "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is only valid"},{"type":"text","text":" "},{"type":"text","text":"during the call to "},{"type":"codeVoice","code":"withoutActuallyEscaping(_:do:)"},{"type":"text","text":". It is undefined"},{"type":"text","text":" "},{"type":"text","text":"behavior for the escapable closure to be stored, referenced, or executed"},{"type":"text","text":" "},{"type":"text","text":"after the function returns."}]}],"name":"Important"}]}],"variants":[{"paths":["\/documentation\/swift\/withoutactuallyescaping(_:do:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"metadata":{"externalID":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF","roleHeading":"Function","platforms":[{"unavailable":false,"beta":false,"name":"iOS","introducedAt":"8.0","deprecated":false},{"unavailable":false,"beta":false,"name":"iPadOS","introducedAt":"8.0","deprecated":false},{"unavailable":false,"beta":false,"name":"Mac Catalyst","introducedAt":"13.0","deprecated":false},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"10.10","name":"macOS"},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"9.0","name":"tvOS"},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"1.0","name":"visionOS"},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"2.0","name":"watchOS"}],"symbolKind":"func","title":"withoutActuallyEscaping(_:do:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withoutActuallyEscaping","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"ClosureType"},{"text":", ","kind":"text"},{"text":"ResultType","kind":"genericParameter"},{"kind":"