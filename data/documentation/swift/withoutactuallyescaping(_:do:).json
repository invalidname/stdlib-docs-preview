{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/swift\/withoutactuallyescaping(_:do:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@export(implementation)"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"withoutActuallyEscaping","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"ClosureType"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"ResultType"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"kind":"text","text":">("},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"closure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ClosureType","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF11ClosureTypeL_xmfp"},{"text":", ","kind":"text"},{"text":"do","kind":"externalParam"},{"kind":"text","text":" "},{"text":"body","kind":"internalParam"},{"kind":"text","text":": ("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"escapingClosure"},{"text":": ","kind":"text"},{"text":"ClosureType","kind":"typeIdentifier","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF11ClosureTypeL_xmfp"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","text":"Failure","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF7FailureL_q0_mfp"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ResultType","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF10ResultTypeL_q_mfp"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Failure","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF7FailureL_q0_mfp"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ResultType","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF10ResultTypeL_q_mfp"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","preciseIdentifier":"s:s5ErrorP"}]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"A nonescaping closure value that is made escapable for the"},{"type":"text","text":" "},{"type":"text","text":"duration of the execution of the "},{"code":"body","type":"codeVoice"},{"text":" closure. If ","type":"text"},{"code":"body","type":"codeVoice"},{"type":"text","text":" has a"},{"type":"text","text":" "},{"text":"return value, that value is also used as the return value for the","type":"text"},{"text":" ","type":"text"},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":" function.","type":"text"}],"type":"paragraph"}],"name":"closure"},{"content":[{"inlineContent":[{"type":"text","text":"A closure that is executed immediately with an escapable copy of"},{"text":" ","type":"text"},{"code":"closure","type":"codeVoice"},{"type":"text","text":" as its argument."}],"type":"paragraph"}],"name":"body"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"code":"body","type":"codeVoice"},{"text":" closure.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"text":"You can use this function to call an API that takes an escaping closure in","type":"text"},{"text":" ","type":"text"},{"text":"a way that doesn’t allow the closure to escape in practice. The examples","type":"text"},{"type":"text","text":" "},{"text":"below demonstrate how to use ","type":"text"},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"text","text":"conjunction with two common APIs that use escaping closures: lazy"},{"type":"text","text":" "},{"type":"text","text":"collection views and asynchronous operations."}],"type":"paragraph"},{"inlineContent":[{"text":"The following code declares an ","type":"text"},{"code":"allValues(in:match:)","type":"codeVoice"},{"text":" function that checks","type":"text"},{"text":" ","type":"text"},{"text":"whether all the elements in an array match a predicate. The function won’t","type":"text"},{"text":" ","type":"text"},{"text":"compile as written, because a lazy collection’s ","type":"text"},{"code":"filter(_:)","type":"codeVoice"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"requires an escaping closure. The lazy collection isn’t persisted, so the","type":"text"},{"text":" ","type":"text"},{"code":"predicate","type":"codeVoice"},{"text":" closure won’t actually escape the body of the function;","type":"text"},{"text":" ","type":"text"},{"text":"nevertheless, it can’t be used in this way.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func allValues(in array: [Int], match predicate: (Int) -> Bool) -> Bool {","    return array.lazy.filter { !predicate($0) }.isEmpty","}","\/\/ error: closure use of non-escaping parameter 'predicate'..."],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":" provides a temporarily escapable copy of","type":"text"},{"text":" ","type":"text"},{"code":"predicate","type":"codeVoice"},{"text":" that ","type":"text"},{"inlineContent":[{"text":"can","type":"text"}],"type":"emphasis"},{"text":" be used in a call to the lazy view’s ","type":"text"},{"code":"filter(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"method. The second version of "},{"code":"allValues(in:match:)","type":"codeVoice"},{"type":"text","text":" compiles without"},{"type":"text","text":" "},{"type":"text","text":"error, with the compiler guaranteeing that the "},{"code":"escapablePredicate","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"closure doesn’t last beyond the call to "},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"type":"text","text":"."}]},{"code":["func allValues(in array: [Int], match predicate: (Int) -> Bool) -> Bool {","    return withoutActuallyEscaping(predicate) { escapablePredicate in","        array.lazy.filter { !escapablePredicate($0) }.isEmpty","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Asynchronous calls are another type of API that typically escape their"},{"type":"text","text":" "},{"type":"text","text":"closure arguments. The following code declares a"},{"type":"text","text":" "},{"code":"perform(_:simultaneouslyWith:)","type":"codeVoice"},{"type":"text","text":" function that uses a dispatch queue to"},{"type":"text","text":" "},{"type":"text","text":"execute two closures concurrently."}],"type":"paragraph"},{"code":["func perform(_ f: () -> Void, simultaneouslyWith g: () -> Void) {","    let queue = DispatchQueue(label: \"perform\", attributes: .concurrent)","    queue.async(execute: f)","    queue.async(execute: g)","    queue.sync(flags: .barrier) {}","}","\/\/ error: passing non-escaping parameter 'f'...","\/\/ error: passing non-escaping parameter 'g'..."],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"perform(_:simultaneouslyWith:)"},{"type":"text","text":" function ends with a call to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"sync(flags:execute:)"},{"type":"text","text":" method using the "},{"type":"codeVoice","code":".barrier"},{"type":"text","text":" flag, which forces the"},{"type":"text","text":" "},{"type":"text","text":"function to wait until both closures have completed running before"},{"type":"text","text":" "},{"type":"text","text":"returning. Even though the barrier guarantees that neither closure will"},{"type":"text","text":" "},{"type":"text","text":"escape the function, the "},{"type":"codeVoice","code":"async(execute:)"},{"type":"text","text":" method still requires that the"},{"type":"text","text":" "},{"type":"text","text":"closures passed be marked as "},{"type":"codeVoice","code":"@escaping"},{"type":"text","text":", so the first version of the"},{"type":"text","text":" "},{"type":"text","text":"function does not compile. To resolve these errors, you can use"},{"type":"text","text":" "},{"type":"codeVoice","code":"withoutActuallyEscaping(_:do:)"},{"type":"text","text":" to get copies of "},{"type":"codeVoice","code":"f"},{"type":"text","text":" and "},{"type":"codeVoice","code":"g"},{"type":"text","text":" that can be"},{"type":"text","text":" "},{"type":"text","text":"passed to "},{"code":"async(execute:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["func perform(_ f: () -> Void, simultaneouslyWith g: () -> Void) {","    withoutActuallyEscaping(f) { escapableF in","        withoutActuallyEscaping(g) { escapableG in","            let queue = DispatchQueue(label: \"perform\", attributes: .concurrent)","            queue.async(execute: escapableF)","            queue.async(execute: escapableG)","            queue.sync(flags: .barrier) {}","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The escapable copy of "},{"type":"codeVoice","code":"closure"},{"type":"text","text":" passed to "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is only valid"},{"type":"text","text":" "},{"type":"text","text":"during the call to "},{"type":"codeVoice","code":"withoutActuallyEscaping(_:do:)"},{"type":"text","text":". It is undefined"},{"type":"text","text":" "},{"type":"text","text":"behavior for the escapable closure to be stored, referenced, or executed"},{"type":"text","text":" "},{"type":"text","text":"after the function returns."}]}],"style":"important","name":"Important"}]}],"abstract":[{"type":"text","text":"Allows a nonescaping closure to temporarily be used as if it were allowed"},{"type":"text","text":" "},{"type":"text","text":"to escape."}],"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withoutActuallyEscaping(_:do:)","interfaceLanguage":"swift"},"metadata":{"externalID":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF","platforms":[{"deprecated":false,"name":"iOS","unavailable":false,"beta":false,"introducedAt":"8.0"},{"deprecated":false,"name":"iPadOS","unavailable":false,"beta":false,"introducedAt":"8.0"},{"deprecated":false,"name":"Mac Catalyst","unavailable":false,"beta":false,"introducedAt":"13.0"},{"introducedAt":"10.10","beta":false,"unavailable":false,"name":"macOS","deprecated":false},{"introducedAt":"9.0","beta":false,"unavailable":false,"name":"tvOS","deprecated":false},{"introducedAt":"1.0","beta":false,"unavailable":false,"name":"visionOS","deprecated":false},{"introducedAt":"2.0","beta":false,"unavailable":false,"name":"watchOS","deprecated":false}],"modules":[{"name":"Standard Library"}],"role":"symbol","symbolKind":"func","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withoutActuallyEscaping","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"ClosureType"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"ResultType"},{"k