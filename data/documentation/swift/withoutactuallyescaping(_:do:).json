{"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"abstract":[{"text":"Allows a nonescaping closure to temporarily be used as if it were allowed","type":"text"},{"type":"text","text":" "},{"text":"to escape.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/withoutactuallyescaping(_:do:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withoutActuallyEscaping(_:do:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withoutActuallyEscaping","kind":"identifier"},{"text":"<","kind":"text"},{"text":"ClosureType","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"ResultType","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"closure","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF11ClosureTypeL_xmfp","text":"ClosureType","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"do","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"body","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"escapingClosure","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF11ClosureTypeL_xmfp","text":"ClosureType","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF7FailureL_q0_mfp","text":"Failure","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF10ResultTypeL_q_mfp","text":"ResultType","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF7FailureL_q0_mfp","text":"Failure","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF10ResultTypeL_q_mfp","text":"ResultType","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"}]}]},{"parameters":[{"name":"closure","content":[{"type":"paragraph","inlineContent":[{"text":"A nonescaping closure value that is made escapable for the","type":"text"},{"text":" ","type":"text"},{"text":"duration of the execution of the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" closure. If ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" has a","type":"text"},{"text":" ","type":"text"},{"text":"return value, that value is also used as the return value for the","type":"text"},{"text":" ","type":"text"},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":" function.","type":"text"}]}]},{"name":"body","content":[{"type":"paragraph","inlineContent":[{"text":"A closure that is executed immediately with an escapable copy of","type":"text"},{"text":" ","type":"text"},{"code":"closure","type":"codeVoice"},{"type":"text","text":" as its argument."}]}]}],"kind":"parameters"},{"content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"You can use this function to call an API that takes an escaping closure in"},{"type":"text","text":" "},{"type":"text","text":"a way that doesn’t allow the closure to escape in practice. The examples"},{"type":"text","text":" "},{"type":"text","text":"below demonstrate how to use "},{"type":"codeVoice","code":"withoutActuallyEscaping(_:do:)"},{"text":" in","type":"text"},{"type":"text","text":" "},{"text":"conjunction with two common APIs that use escaping closures: lazy","type":"text"},{"type":"text","text":" "},{"type":"text","text":"collection views and asynchronous operations."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following code declares an "},{"type":"codeVoice","code":"allValues(in:match:)"},{"type":"text","text":" function that checks"},{"type":"text","text":" "},{"type":"text","text":"whether all the elements in an array match a predicate. The function won’t"},{"type":"text","text":" "},{"type":"text","text":"compile as written, because a lazy collection’s "},{"type":"codeVoice","code":"filter(_:)"},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"requires an escaping closure. The lazy collection isn’t persisted, so the"},{"type":"text","text":" "},{"type":"codeVoice","code":"predicate"},{"type":"text","text":" closure won’t actually escape the body of the function;"},{"type":"text","text":" "},{"type":"text","text":"nevertheless, it can’t be used in this way."}],"type":"paragraph"},{"syntax":"swift","code":["func allValues(in array: [Int], match predicate: (Int) -> Bool) -> Bool {","    return array.lazy.filter { !predicate($0) }.isEmpty","}","\/\/ error: closure use of non-escaping parameter 'predicate'..."],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"withoutActuallyEscaping(_:do:)"},{"type":"text","text":" provides a temporarily escapable copy of"},{"text":" ","type":"text"},{"code":"predicate","type":"codeVoice"},{"text":" that ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"can","type":"text"}]},{"type":"text","text":" be used in a call to the lazy view’s "},{"type":"codeVoice","code":"filter(_:)"},{"text":" ","type":"text"},{"text":"method. The second version of ","type":"text"},{"code":"allValues(in:match:)","type":"codeVoice"},{"text":" compiles without","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"error, with the compiler guaranteeing that the "},{"type":"codeVoice","code":"escapablePredicate"},{"type":"text","text":" "},{"type":"text","text":"closure doesn’t last beyond the call to "},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func allValues(in array: [Int], match predicate: (Int) -> Bool) -> Bool {","    return withoutActuallyEscaping(predicate) { escapablePredicate in","        array.lazy.filter { !escapablePredicate($0) }.isEmpty","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Asynchronous calls are another type of API that typically escape their","type":"text"},{"text":" ","type":"text"},{"text":"closure arguments. The following code declares a","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"perform(_:simultaneouslyWith:)"},{"text":" function that uses a dispatch queue to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"execute two closures concurrently."}],"type":"paragraph"},{"syntax":"swift","code":["func perform(_ f: () -> Void, simultaneouslyWith g: () -> Void) {","    let queue = DispatchQueue(label: \"perform\", attributes: .concurrent)","    queue.async(execute: f)","    queue.async(execute: g)","    queue.sync(flags: .barrier) {}","}","\/\/ error: passing non-escaping parameter 'f'...","\/\/ error: passing non-escaping parameter 'g'..."],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"perform(_:simultaneouslyWith:)","type":"codeVoice"},{"text":" function ends with a call to the","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"sync(flags:execute:)"},{"type":"text","text":" method using the "},{"code":".barrier","type":"codeVoice"},{"text":" flag, which forces the","type":"text"},{"text":" ","type":"text"},{"text":"function to wait until both closures have completed running before","type":"text"},{"text":" ","type":"text"},{"text":"returning. Even though the barrier guarantees that neither closure will","type":"text"},{"text":" ","type":"text"},{"text":"escape the function, the ","type":"text"},{"code":"async(execute:)","type":"codeVoice"},{"type":"text","text":" method still requires that the"},{"type":"text","text":" "},{"text":"closures passed be marked as ","type":"text"},{"code":"@escaping","type":"codeVoice"},{"text":", so the first version of the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"function does not compile. To resolve these errors, you can use"},{"text":" ","type":"text"},{"type":"codeVoice","code":"withoutActuallyEscaping(_:do:)"},{"text":" to get copies of ","type":"text"},{"type":"codeVoice","code":"f"},{"type":"text","text":" and "},{"code":"g","type":"codeVoice"},{"text":" that can be","type":"text"},{"text":" ","type":"text"},{"text":"passed to ","type":"text"},{"type":"codeVoice","code":"async(execute:)"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func perform(_ f: () -> Void, simultaneouslyWith g: () -> Void) {","    withoutActuallyEscaping(f) { escapableF in","        withoutActuallyEscaping(g) { escapableG in","            let queue = DispatchQueue(label: \"perform\", attributes: .concurrent)","            queue.async(execute: escapableF)","            queue.async(execute: escapableG)","            queue.sync(flags: .barrier) {}","        }","    }","}"]},{"name":"Important","content":[{"inlineContent":[{"text":"The escapable copy of ","type":"text"},{"code":"closure","type":"codeVoice"},{"text":" passed to ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" is only valid","type":"text"},{"text":" ","type":"text"},{"text":"during the call to ","type":"text"},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":". It is undefined","type":"text"},{"text":" ","type":"text"},{"text":"behavior for the escapable closure to be stored, referenced, or executed","type":"text"},{"text":" ","type":"text"},{"text":"after the function returns.","type":"text"}],"type":"paragraph"}],"style":"important","type":"aside"}],"kind":"content"}],"metadata":{"role":"symbol","roleHeading":"Function","title":"withoutActuallyEscaping(_:do:)","platforms":[{"name":"iOS","introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false},{"name":"iPadOS","introducedAt":"8.0","deprecated":false,"unavailable":false,"beta":false},{"name":"Mac Catalyst","introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false},{"name":"macOS","introducedAt":"10.10","deprecated":false,"unavailable":false,"beta":false},{"name":"tvOS","introducedAt":"9.0","deprecated":false,"unavailable":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false},{"name":"watchOS","introducedAt":"2.0","deprecated":false,"unavailable":false,"beta":false}],"symbolKind":"func","modules":[{"name":"Swift"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withoutActuallyEscaping"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"ClosureType"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"ResultType"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">("},{"preciseIdentifier":"s:s23