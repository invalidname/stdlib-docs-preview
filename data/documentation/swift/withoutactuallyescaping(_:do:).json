outActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF11ClosureTypeL_xmfp","text":"ClosureType","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF7FailureL_q0_mfp","text":"Failure","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF10ResultTypeL_q_mfp","text":"ResultType","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF7FailureL_q0_mfp","text":"Failure","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF10ResultTypeL_q_mfp","text":"ResultType","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"closure","content":[{"inlineContent":[{"text":"A nonescaping closure value that is made escapable for the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"duration of the execution of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" has a"},{"type":"text","text":" "},{"type":"text","text":"return value, that value is also used as the return value for the"},{"type":"text","text":" "},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":" function.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A closure that is executed immediately with an escapable copy of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"closure"},{"type":"text","text":" as its argument."}]}],"name":"body"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"inlineContent":[{"text":"The return value, if any, of the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" closure.","type":"text"}],"type":"paragraph"}]},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"You can use this function to call an API that takes an escaping closure in","type":"text"},{"text":" ","type":"text"},{"text":"a way that doesn’t allow the closure to escape in practice. The examples","type":"text"},{"text":" ","type":"text"},{"text":"below demonstrate how to use ","type":"text"},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"text":"conjunction with two common APIs that use escaping closures: lazy","type":"text"},{"text":" ","type":"text"},{"text":"collection views and asynchronous operations.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following code declares an "},{"type":"codeVoice","code":"allValues(in:match:)"},{"type":"text","text":" function that checks"},{"type":"text","text":" "},{"type":"text","text":"whether all the elements in an array match a predicate. The function won’t"},{"text":" ","type":"text"},{"text":"compile as written, because a lazy collection’s ","type":"text"},{"code":"filter(_:)","type":"codeVoice"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"requires an escaping closure. The lazy collection isn’t persisted, so the","type":"text"},{"text":" ","type":"text"},{"code":"predicate","type":"codeVoice"},{"text":" closure won’t actually escape the body of the function;","type":"text"},{"text":" ","type":"text"},{"text":"nevertheless, it can’t be used in this way.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func allValues(in array: [Int], match predicate: (Int) -> Bool) -> Bool {","    return array.lazy.filter { !predicate($0) }.isEmpty","}","\/\/ error: closure use of non-escaping parameter 'predicate'..."]},{"inlineContent":[{"type":"codeVoice","code":"withoutActuallyEscaping(_:do:)"},{"text":" provides a temporarily escapable copy of","type":"text"},{"text":" ","type":"text"},{"code":"predicate","type":"codeVoice"},{"text":" that ","type":"text"},{"inlineContent":[{"type":"text","text":"can"}],"type":"emphasis"},{"type":"text","text":" be used in a call to the lazy view’s "},{"type":"codeVoice","code":"filter(_:)"},{"type":"text","text":" "},{"type":"text","text":"method. The second version of "},{"type":"codeVoice","code":"allValues(in:match:)"},{"type":"text","text":" compiles without"},{"type":"text","text":" "},{"type":"text","text":"error, with the compiler guaranteeing that the "},{"type":"codeVoice","code":"escapablePredicate"},{"type":"text","text":" "},{"type":"text","text":"closure doesn’t last beyond the call to "},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func allValues(in array: [Int], match predicate: (Int) -> Bool) -> Bool {","    return withoutActuallyEscaping(predicate) { escapablePredicate in","        array.lazy.filter { !escapablePredicate($0) }.isEmpty","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Asynchronous calls are another type of API that typically escape their","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"closure arguments. The following code declares a"},{"text":" ","type":"text"},{"code":"perform(_:simultaneouslyWith:)","type":"codeVoice"},{"type":"text","text":" function that uses a dispatch queue to"},{"text":" ","type":"text"},{"type":"text","text":"execute two closures concurrently."}]},{"syntax":"swift","type":"codeListing","code":["func perform(_ f: () -> Void, simultaneouslyWith g: () -> Void) {","    let queue = DispatchQueue(label: \"perform\", attributes: .concurrent)","    queue.async(execute: f)","    queue.async(execute: g)","    queue.sync(flags: .barrier) {}","}","\/\/ error: passing non-escaping parameter 'f'...","\/\/ error: passing non-escaping parameter 'g'..."]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"perform(_:simultaneouslyWith:)"},{"type":"text","text":" function ends with a call to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"sync(flags:execute:)"},{"type":"text","text":" method using the "},{"code":".barrier","type":"codeVoice"},{"text":" flag, which forces the","type":"text"},{"text":" ","type":"text"},{"text":"function to wait until both closures have completed running before","type":"text"},{"type":"text","text":" "},{"type":"text","text":"returning. Even though the barrier guarantees that neither closure will"},{"type":"text","text":" "},{"type":"text","text":"escape the function, the "},{"type":"codeVoice","code":"async(execute:)"},{"type":"text","text":" method still requires that the"},{"type":"text","text":" "},{"type":"text","text":"closures passed be marked as "},{"type":"codeVoice","code":"@escaping"},{"type":"text","text":", so the first version of the"},{"type":"text","text":" "},{"text":"function does not compile. To resolve these errors, you can use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"withoutActuallyEscaping(_:do:)"},{"type":"text","text":" to get copies of "},{"type":"codeVoice","code":"f"},{"type":"text","text":" and "},{"type":"codeVoice","code":"g"},{"type":"text","text":" that can be"},{"type":"text","text":" "},{"type":"text","text":"passed to "},{"code":"async(execute:)","type":"codeVoice"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["func perform(_ f: () -> Void, simultaneouslyWith g: () -> Void) {","    withoutActuallyEscaping(f) { escapableF in","        withoutActuallyEscaping(g) { escapableG in","            let queue = DispatchQueue(label: \"perform\", attributes: .concurrent)","            queue.async(execute: escapableF)","            queue.async(execute: escapableG)","            queue.sync(flags: .barrier) {}","        }","    }","}"]},{"type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The escapable copy of "},{"type":"codeVoice","code":"closure"},{"type":"text","text":" passed to "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is only valid"},{"type":"text","text":" "},{"type":"text","text":"during the call to "},{"type":"codeVoice","code":"withoutActuallyEscaping(_:do:)"},{"type":"text","text":". It is undefined"},{"type":"text","text":" "},{"type":"text","text":"behavior for the escapable closure to be stored, referenced, or executed"},{"type":"text","text":" "},{"type":"text","text":"after the function returns."}]}],"name":"Important"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withoutActuallyEscaping(_:do:)"},"abstract":[{"type":"text","text":"Allows a nonescaping closure to temporarily be used as if it were allowed"},{"type":"text","text":" "},{"type":"text","text":"to escape."}],"references":{"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/