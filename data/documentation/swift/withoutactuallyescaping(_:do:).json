d":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"escapingClosure"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF11ClosureTypeL_xmfp","kind":"typeIdentifier","text":"ClosureType"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF7FailureL_q0_mfp","kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF10ResultTypeL_q_mfp","kind":"typeIdentifier","text":"ResultType"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF7FailureL_q0_mfp","kind":"typeIdentifier","text":"Failure"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF10ResultTypeL_q_mfp","kind":"typeIdentifier","text":"ResultType"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"}]}]},{"kind":"parameters","parameters":[{"name":"closure","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A nonescaping closure value that is made escapable for the"},{"type":"text","text":" "},{"type":"text","text":"duration of the execution of the "},{"code":"body","type":"codeVoice"},{"type":"text","text":" closure. If "},{"code":"body","type":"codeVoice"},{"type":"text","text":" has a"},{"type":"text","text":" "},{"type":"text","text":"return value, that value is also used as the return value for the"},{"type":"text","text":" "},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"type":"text","text":" function."}]}]},{"name":"body","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that is executed immediately with an escapable copy of"},{"type":"text","text":" "},{"code":"closure","type":"codeVoice"},{"type":"text","text":" as its argument."}]}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure."}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use this function to call an API that takes an escaping closure in"},{"type":"text","text":" "},{"type":"text","text":"a way that doesn’t allow the closure to escape in practice. The examples"},{"type":"text","text":" "},{"type":"text","text":"below demonstrate how to use "},{"type":"codeVoice","code":"withoutActuallyEscaping(_:do:)"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"text","text":"conjunction with two common APIs that use escaping closures: lazy"},{"type":"text","text":" "},{"type":"text","text":"collection views and asynchronous operations."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following code declares an "},{"type":"codeVoice","code":"allValues(in:match:)"},{"type":"text","text":" function that checks"},{"type":"text","text":" "},{"type":"text","text":"whether all the elements in an array match a predicate. The function won’t"},{"type":"text","text":" "},{"type":"text","text":"compile as written, because a lazy collection’s "},{"type":"codeVoice","code":"filter(_:)"},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"requires an escaping closure. The lazy collection isn’t persisted, so the"},{"type":"text","text":" "},{"type":"codeVoice","code":"predicate"},{"type":"text","text":" closure won’t actually escape the body of the function;"},{"type":"text","text":" "},{"type":"text","text":"nevertheless, it can’t be used in this way."}]},{"type":"codeListing","code":["func allValues(in array: [Int], match predicate: (Int) -> Bool) -> Bool {","    return array.lazy.filter { !predicate($0) }.isEmpty","}","\/\/ error: closure use of non-escaping parameter 'predicate'..."],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"type":"text","text":" provides a temporarily escapable copy of"},{"type":"text","text":" "},{"code":"predicate","type":"codeVoice"},{"text":" that ","type":"text"},{"inlineContent":[{"text":"can","type":"text"}],"type":"emphasis"},{"text":" be used in a call to the lazy view’s ","type":"text"},{"code":"filter(_:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"method. The second version of "},{"code":"allValues(in:match:)","type":"codeVoice"},{"text":" compiles without","type":"text"},{"text":" ","type":"text"},{"text":"error, with the compiler guaranteeing that the ","type":"text"},{"type":"codeVoice","code":"escapablePredicate"},{"text":" ","type":"text"},{"text":"closure doesn’t last beyond the call to ","type":"text"},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["func allValues(in array: [Int], match predicate: (Int) -> Bool) -> Bool {","    return withoutActuallyEscaping(predicate) { escapablePredicate in","        array.lazy.filter { !escapablePredicate($0) }.isEmpty","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Asynchronous calls are another type of API that typically escape their"},{"type":"text","text":" "},{"type":"text","text":"closure arguments. The following code declares a"},{"type":"text","text":" "},{"type":"codeVoice","code":"perform(_:simultaneouslyWith:)"},{"type":"text","text":" function that uses a dispatch queue to"},{"type":"text","text":" "},{"type":"text","text":"execute two closures concurrently."}],"type":"paragraph"},{"type":"codeListing","code":["func perform(_ f: () -> Void, simultaneouslyWith g: () -> Void) {","    let queue = DispatchQueue(label: \"perform\", attributes: .concurrent)","    queue.async(execute: f)","    queue.async(execute: g)","    queue.sync(flags: .barrier) {}","}","\/\/ error: passing non-escaping parameter 'f'...","\/\/ error: passing non-escaping parameter 'g'..."],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"perform(_:simultaneouslyWith:)","type":"codeVoice"},{"text":" function ends with a call to the","type":"text"},{"text":" ","type":"text"},{"code":"sync(flags:execute:)","type":"codeVoice"},{"text":" method using the ","type":"text"},{"code":".barrier","type":"codeVoice"},{"text":" flag, which forces the","type":"text"},{"text":" ","type":"text"},{"text":"function to wait until both closures have completed running before","type":"text"},{"text":" ","type":"text"},{"text":"returning. Even though the barrier guarantees that neither closure will","type":"text"},{"text":" ","type":"text"},{"text":"escape the function, the ","type":"text"},{"code":"async(execute:)","type":"codeVoice"},{"text":" method still requires that the","type":"text"},{"text":" ","type":"text"},{"text":"closures passed be marked as ","type":"text"},{"code":"@escaping","type":"codeVoice"},{"text":", so the first version of the","type":"text"},{"text":" ","type":"text"},{"text":"function does not compile. To resolve these errors, you can use","type":"text"},{"text":" ","type":"text"},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"text":" to get copies of ","type":"text"},{"code":"f","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"g","type":"codeVoice"},{"text":" that can be","type":"text"},{"text":" ","type":"text"},{"text":"passed to ","type":"text"},{"code":"async(execute:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","code":["func perform(_ f: () -> Void, simultaneouslyWith g: () -> Void) {","    withoutActuallyEscaping(f) { escapableF in","        withoutActuallyEscaping(g) { escapableG in","            let queue = DispatchQueue(label: \"perform\", attributes: .concurrent)","            queue.async(execute: escapableF)","            queue.async(execute: escapableG)","            queue.sync(flags: .barrier) {}","        }","    }","}"],"syntax":"swift"},{"type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"The escapable copy of "},{"type":"codeVoice","code":"closure"},{"type":"text","text":" passed to "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is only valid"},{"type":"text","text":" "},{"type":"text","text":"during the call to "},{"type":"codeVoice","code":"withoutActuallyEscaping(_:do:)"},{"type":"text","text":". It is undefined"},{"type":"text","text":" "},{"type":"text","text":"behavior for the escapable closure to be stored, referenced, or executed"},{"type":"text","text":" "},{"type":"text","text":"after the function returns."}],"type":"paragraph"}],"name":"Important"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/withoutactuallyescaping(_:do:)"]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","type":"topic","role":"collection","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","title":"Swift","kind":"symbol","images":[{"identifier":"Swift-PageImage-card.png","type":"card"}]},"doc://com.apple.Swift/documentation/Swift/withoutActuallyEscaping(_:do:)":{"title":"withoutActuallyEscaping(_:do:)","abstract":[{"type":"text","text":"Allows a n