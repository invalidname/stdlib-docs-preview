{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withoutActuallyEscaping(_:do:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"withoutActuallyEscaping","kind":"identifier"},{"text":"<","kind":"text"},{"text":"ClosureType","kind":"genericParameter"},{"text":", ","kind":"text"},{"kind":"genericParameter","text":"ResultType"},{"text":", ","kind":"text"},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">("},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"kind":"internalParam","text":"closure"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF11ClosureTypeL_xmfp","text":"ClosureType"},{"kind":"text","text":", "},{"text":"do","kind":"externalParam"},{"kind":"text","text":" "},{"kind":"internalParam","text":"body"},{"text":": (","kind":"text"},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"text":"escapingClosure","kind":"internalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF11ClosureTypeL_xmfp","text":"ClosureType"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"text":"Failure","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF7FailureL_q0_mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF10ResultTypeL_q_mfp","text":"ResultType"},{"text":") ","kind":"text"},{"kind":"keyword","text":"throws"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF7FailureL_q0_mfp","text":"Failure","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF10ResultTypeL_q_mfp","text":"ResultType"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"kind":"text","text":" "},{"text":"Failure","kind":"typeIdentifier"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s5ErrorP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","kind":"typeIdentifier"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"A nonescaping closure value that is made escapable for the"},{"type":"text","text":" "},{"type":"text","text":"duration of the execution of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" closure. If "},{"type":"codeVoice","code":"body"},{"type":"text","text":" has a"},{"type":"text","text":" "},{"type":"text","text":"return value, that value is also used as the return value for the"},{"type":"text","text":" "},{"type":"codeVoice","code":"withoutActuallyEscaping(_:do:)"},{"type":"text","text":" function."}],"type":"paragraph"}],"name":"closure"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that is executed immediately with an escapable copy of"},{"type":"text","text":" "},{"type":"codeVoice","code":"closure"},{"text":" as its argument.","type":"text"}]}],"name":"body"}]},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"The return value, if any, of the "},{"code":"body","type":"codeVoice"},{"text":" closure.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"You can use this function to call an API that takes an escaping closure in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a way that doesn’t allow the closure to escape in practice. The examples"},{"type":"text","text":" "},{"type":"text","text":"below demonstrate how to use "},{"type":"codeVoice","code":"withoutActuallyEscaping(_:do:)"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"text","text":"conjunction with two common APIs that use escaping closures: lazy"},{"type":"text","text":" "},{"type":"text","text":"collection views and asynchronous operations."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The following code declares an ","type":"text"},{"type":"codeVoice","code":"allValues(in:match:)"},{"text":" function that checks","type":"text"},{"type":"text","text":" "},{"text":"whether all the elements in an array match a predicate. The function won’t","type":"text"},{"type":"text","text":" "},{"type":"text","text":"compile as written, because a lazy collection’s "},{"type":"codeVoice","code":"filter(_:)"},{"text":" method","type":"text"},{"text":" ","type":"text"},{"text":"requires an escaping closure. The lazy collection isn’t persisted, so the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"predicate"},{"text":" closure won’t actually escape the body of the function;","type":"text"},{"text":" ","type":"text"},{"text":"nevertheless, it can’t be used in this way.","type":"text"}]},{"code":["func allValues(in array: [Int], match predicate: (Int) -> Bool) -> Bool {","    return array.lazy.filter { !predicate($0) }.isEmpty","}","\/\/ error: closure use of non-escaping parameter 'predicate'..."],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"type":"text","text":" provides a temporarily escapable copy of"},{"type":"text","text":" "},{"code":"predicate","type":"codeVoice"},{"type":"text","text":" that "},{"inlineContent":[{"text":"can","type":"text"}],"type":"emphasis"},{"type":"text","text":" be used in a call to the lazy view’s "},{"code":"filter(_:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"method. The second version of "},{"code":"allValues(in:match:)","type":"codeVoice"},{"type":"text","text":" compiles without"},{"type":"text","text":" "},{"type":"text","text":"error, with the compiler guaranteeing that the "},{"code":"escapablePredicate","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"closure doesn’t last beyond the call to "},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["func allValues(in array: [Int], match predicate: (Int) -> Bool) -> Bool {","    return withoutActuallyEscaping(predicate) { escapablePredicate in","        array.lazy.filter { !escapablePredicate($0) }.isEmpty","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Asynchronous calls are another type of API that typically escape their"},{"type":"text","text":" "},{"type":"text","text":"closure arguments. The following code declares a"},{"type":"text","text":" "},{"code":"perform(_:simultaneouslyWith:)","type":"codeVoice"},{"type":"text","text":" function that uses a dispatch queue to"},{"type":"text","text":" "},{"type":"text","text":"execute two closures concurrently."}],"type":"paragraph"},{"code":["func perform(_ f: () -> Void, simultaneouslyWith g: () -> Void) {","    let queue = DispatchQueue(label: \"perform\", attributes: .concurrent)","    queue.async(execute: f)","    queue.async(execute: g)","    queue.sync(flags: .barrier) {}","}","\/\/ error: passing non-escaping parameter 'f'...","\/\/ error: passing non-escaping parameter 'g'..."],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"code":"perform(_:simultaneouslyWith:)","type":"codeVoice"},{"type":"text","text":" function ends with a call to the"},{"type":"text","text":" "},{"code":"sync(flags:execute:)","type":"codeVoice"},{"type":"text","text":" method using the "},{"code":".barrier","type":"codeVoice"},{"type":"text","text":" flag, which forces the"},{"type":"text","text":" "},{"type":"text","text":"function to wait until both closures have completed running before"},{"type":"text","text":" "},{"type":"text","text":"returning. Even though the barrier guarantees that neither closure will"},{"type":"text","text":" "},{"type":"text","text":"escape the function, the "},{"code":"async(execute:)","type":"codeVoice"},{"type":"text","text":" method still requires that the"},{"type":"text","text":" "},{"type":"text","text":"closures passed be marked as "},{"code":"@escaping","type":"codeVoice"},{"type":"text","text":", so the first version of the"},{"type":"text","text":" "},{"type":"text","text":"function does not compile. To resolve these errors, you can use"},{"type":"text","text":" "},{"code":"withoutActuallyEscaping(_:do:)","type":"codeVoice"},{"type":"text","text":" to get copies of "},{"code":"f","type":"codeVoice"},{"type":"text","text":" and "},{"code":"g","type":"codeVoice"},{"type":"text","text":" that can be"},{"type":"text","text":" "},{"type":"text","text":"passed to "},{"code":"async(execute:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["func perform(_ f: () -> Void, simultaneouslyWith g: () -> Void) {","    withoutActuallyEscaping(f) { escapableF in","        withoutActuallyEscaping(g) { escapableG in","            let queue = DispatchQueue(label: \"perform\", attributes: .concurrent)","            queue.async(execute: escapableF)","            queue.async(execute: escapableG)","            queue.sync(flags: .barrier) {}","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"name":"Important","content":[{"inlineContent":[{"type":"text","text":"The escapable copy of "},{"type":"codeVoice","code":"closure"},{"type":"text","text":" passed to "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is only valid"},{"type":"text","text":" "},{"type":"text","text":"during the call to "},{"type":"codeVoice","code":"withoutActuallyEscaping(_:do:)"},{"type":"text","text":". It is undefined"},{"type":"text","text":" "},{"type":"text","text":"behavior for the escapable closure to be stored, referenced, or executed"},{"type":"text","text":" "},{"type":"text","text":"after the function returns."}],"type":"paragraph"}],"type":"aside","style":"important"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"symbol","metadata":{"roleHeading":"Function","externalID":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF","platforms":[{"name":"iOS","introducedAt":"8.0","deprecated":false,"beta":false,"unavailable":false},{"name":"iPadOS","introducedAt":"8.0","deprecated":false,"beta":false,"unavailable":false},{"name":"Mac Catalyst","introducedAt":"13.0","deprecated":false,"beta":false,"unavailable":false},{"name":"macOS","introducedAt":"10.10","deprecated":false,"beta":false,"unavailable":false},{"beta":false,"deprecated":false,"unavailable":false,"name":"tvOS","introducedAt":"9.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0"},{"name":"watchOS","deprecated":false,"unavailable":false,"introducedAt":"2.0","beta":false}],"symbolKind":"func","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withoutActuallyEscaping","kind":"identifier"},{"text":"<","kind":"text"},{"text":"ClosureType","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"ResultType","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"kind":"text","text":">("},{"kind":"typeIdentifier","preciseIdentifier":"s:s23withoutActuallyEscaping_2doq_x_q_xq0_YKXEtq0_YKs5ErrorR0_r1_lF11ClosureTypeL_xmfp","text":"ClosureType"},{"text":", ","kind":"text"},{"text":"do","kind":"externalParam"},{"kind":"text","text":": ("},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"escapingClosure","kind":"internalParam"},{"text"