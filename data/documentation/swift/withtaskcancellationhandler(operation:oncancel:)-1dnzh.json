}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@export(implementation)","kind":"attribute"},{"text":" ","kind":"text"},{"text":"nonisolated","kind":"attribute"},{"text":"(nonsending) ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTaskCancellationHandler","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Return"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">("},{"kind":"externalParam","text":"operation"},{"kind":"text","text":": "},{"kind":"keyword","text":"nonisolated(nonsending)"},{"kind":"text","text":", "},{"kind":"externalParam","text":"onCancel"},{"kind":"text","text":" "},{"kind":"internalParam","text":"handler"},{"kind":"text","text":": "},{"kind":"keyword","text":"sending"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","text":"CancellationError","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","preciseIdentifier":"s:ScE"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Reason","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError\/Reason-swift.enum","preciseIdentifier":"s:ScE6ReasonO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yScE6ReasonOXEtYaq_YKs5ErrorR_Ri_zr0_lF7FailureL_q_mfp","text":"Failure"},{"kind":"text","text":") -> "},{"text":"Return","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yScE6ReasonOXEtYaq_YKs5ErrorR_Ri_zr0_lF6ReturnL_xmfp"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Return"},{"kind":"text","text":" : ~Copyable"}],"languages":["swift"]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"The operation to perform.","type":"text"}],"type":"paragraph"}],"name":"operation"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A closure to execute on cancellation, passed the reason the","type":"text"},{"text":" ","type":"text"},{"text":"task was cancelled.","type":"text"},{"text":" ","type":"text"},{"text":"If the task is canceled, this closure is called at most once;","type":"text"},{"type":"text","text":" "},{"type":"text","text":"otherwise, it isn’t called."}]}],"name":"handler"}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This differs from the operation cooperatively checking for cancellation"},{"type":"text","text":" "},{"type":"text","text":"and reacting to it in that the cancellation handler is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"always"}]},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"immediately"}]},{"type":"text","text":" invoked when the task is canceled. For example, even if the"},{"type":"text","text":" "},{"type":"text","text":"operation is running code that never checks for cancellation, a cancellation"},{"type":"text","text":" "},{"type":"text","text":"handler still runs and provides a chance to run some cleanup code:"}]},{"syntax":"swift","type":"codeListing","code":["await withTaskCancellationHandler {","  var sum = 0","  while condition {","    sum += 1","  }","  return sum","} onCancel: { reason in","  \/\/ This onCancel closure might execute concurrently with the operation.","  condition.cancel()","}"]},{"text":"Execution order and semantics","type":"heading","level":3,"anchor":"Execution-order-and-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" closure is always invoked, even when the"},{"type":"text","text":" "},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" method is called from a task"},{"type":"text","text":" "},{"type":"text","text":"that was already canceled."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" is used in a task that has already been"},{"type":"text","text":" "},{"type":"text","text":"canceled, the cancellation handler will be executed"},{"type":"text","text":" "},{"type":"text","text":"immediately before the "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" closure gets to execute."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This allows the cancellation handler to set some external “canceled” flag"},{"type":"text","text":" "},{"type":"text","text":"that the operation may be "},{"type":"emphasis","inlineContent":[{"type":"text","text":"atomically"}]},{"type":"text","text":" checking for in order to avoid"},{"type":"text","text":" "},{"type":"text","text":"performing any actual work once the operation gets to run."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" closure executes on the calling execution context, and doesn’t"},{"type":"text","text":" "},{"type":"text","text":"suspend or change execution context unless code contained within the closure"},{"type":"text","text":" "},{"type":"text","text":"does so. In other words, the potential suspension point of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" never suspends by itself before"},{"type":"text","text":" "},{"type":"text","text":"executing the operation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If cancellation occurs while the operation is running, the cancellation"},{"type":"text","text":" "},{"type":"text","text":"handler executes "},{"type":"emphasis","inlineContent":[{"type":"text","text":"concurrently"}]},{"type":"text","text":" with the operation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The reason passed to "},{"type":"codeVoice","code":"handler"},{"type":"text","text":" is the same value that "},{"type":"codeVoice","code":"Task.cancellationReason"},{"type":"text","text":" "},{"type":"text","text":"would report on the task being cancelled. However, the handler is invoked"},{"type":"text","text":" "},{"type":"text","text":"from the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"cancelling"}]},{"type":"text","text":" context, not from the cancelled task’s own context,"},{"type":"text","text":" "},{"type":"text","text":"so checking "},{"type":"codeVoice","code":"Task.cancellationReason"},{"type":"text","text":" from inside the "},{"type":"codeVoice","code":"onCancel"},{"type":"text","text":" closure"},{"type":"text","text":" "},{"type":"text","text":"would report the cancellation status of the cancelling context rather than"},{"type":"text","text":" "},{"type":"text","text":"that of the task being cancelled; use the passed-in "},{"type":"codeVoice","code":"reason"},{"type":"text","text":" parameter,"},{"type":"text","text":" "},{"type":"text","text":"which does represent the cancelled task’s status."}]},{"level":3,"type":"heading","anchor":"Cancellation-handlers-and-locks","text":"Cancellation handlers and locks"},{"inlineContent":[{"type":"text","text":"Cancellation handlers which acquire locks must take care to avoid deadlock."},{"type":"text","text":" "},{"type":"text","text":"The cancellation handler may be invoked while holding internal locks"},{"type":"text","text":" "},{"type":"text","text":"associated with the task or other tasks.  Other operations on the task, such"},{"type":"text","text":" "},{"type":"text","text":"as resuming a continuation, may acquire these same internal locks."},{"type":"text","text":" "},{"type":"text","text":"Therefore, if a cancellation handler must acquire a lock, other code should"},{"type":"text","text":" "},{"type":"text","text":"not cancel tasks or resume continuations while holding that lock."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)-1dnzh","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift/withTaskCancellationShield(operation:)-2lzl8":{"abstract":[{"type":"text","text":"Enters a scope in which a task cancellation shield is active."}],"title":"withTaskCancellationShield(operation:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"withTaskCancellationShield","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">("},{"kind":"externalParam","text":"operation"},{"kind":"text","text":": () "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF7FailureL_q_mfp","kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency26withTaskCancellatio