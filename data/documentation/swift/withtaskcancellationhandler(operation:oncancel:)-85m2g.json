rations":[{"tokens":[{"text":"@export(implementation)","kind":"attribute"},{"text":" ","kind":"text"},{"text":"nonisolated","kind":"attribute"},{"text":"(nonsending) ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTaskCancellationHandler","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"Return"},{"text":", ","kind":"text"},{"kind":"genericParameter","text":"Failure"},{"text":">(","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"nonisolated(nonsending)","kind":"keyword"},{"text":", ","kind":"text"},{"text":"onCancel","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"handler","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"sending","kind":"keyword"},{"text":" () -> ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Void","kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"kind":"text","text":"("},{"text":"Failure","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF7FailureL_q_mfp"},{"text":") -> ","kind":"text"},{"kind":"typeIdentifier","text":"Return","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF6ReturnL_xmfp"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The operation to perform.","type":"text"}]}],"name":"operation"},{"content":[{"inlineContent":[{"text":"A closure to execute on cancellation.","type":"text"},{"text":" ","type":"text"},{"text":"If the task is canceled, this closure is called at most once;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise, it isn’t called.","type":"text"}],"type":"paragraph"}],"name":"handler"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"This differs from the operation cooperatively checking for cancellation","type":"text"},{"text":" ","type":"text"},{"text":"and reacting to it in that the cancellation handler is ","type":"text"},{"inlineContent":[{"text":"always","type":"text"}],"type":"emphasis"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"immediately","type":"text"}],"type":"emphasis"},{"text":" invoked when the task is canceled. For example, even if the","type":"text"},{"text":" ","type":"text"},{"text":"operation is running code that never checks for cancellation, a cancellation","type":"text"},{"text":" ","type":"text"},{"text":"handler still runs and provides a chance to run some cleanup code:","type":"text"}]},{"code":["await withTaskCancellationHandler {","  var sum = 0","  while condition {","    sum += 1","  }","  return sum","} onCancel: {","  \/\/ This onCancel closure might execute concurrently with the operation.","  condition.cancel()","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Execution order and semantics","anchor":"Execution-order-and-semantics","level":3},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":" closure is always invoked, even when the","type":"text"},{"text":" ","type":"text"},{"code":"withTaskCancellationHandler(operation:onCancel:)","type":"codeVoice"},{"text":" method is called from a task","type":"text"},{"text":" ","type":"text"},{"text":"that was already canceled.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" is used in a task that has already been"},{"type":"text","text":" "},{"type":"text","text":"canceled, the cancellation handler will be executed"},{"type":"text","text":" "},{"type":"text","text":"immediately before the "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" closure gets to execute."}]},{"inlineContent":[{"type":"text","text":"This allows the cancellation handler to set some external “canceled” flag"},{"type":"text","text":" "},{"type":"text","text":"that the operation may be "},{"type":"emphasis","inlineContent":[{"type":"text","text":"atomically"}]},{"type":"text","text":" checking for in order to avoid"},{"type":"text","text":" "},{"type":"text","text":"performing any actual work once the operation gets to run."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"operation"},{"text":" closure executes on the calling execution context, and doesn’t","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"suspend or change execution context unless code contained within the closure"},{"text":" ","type":"text"},{"type":"text","text":"does so. In other words, the potential suspension point of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" never suspends by itself before"},{"type":"text","text":" "},{"type":"text","text":"executing the operation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If cancellation occurs while the operation is running, the cancellation"},{"type":"text","text":" "},{"type":"text","text":"handler executes "},{"type":"emphasis","inlineContent":[{"type":"text","text":"concurrently"}]},{"type":"text","text":" with the operation."}]},{"text":"Cancellation handlers and locks","type":"heading","anchor":"Cancellation-handlers-and-locks","level":3},{"inlineContent":[{"type":"text","text":"Cancellation handlers which acquire locks must take care to avoid deadlock."},{"type":"text","text":" "},{"text":"The cancellation handler may be invoked while holding internal locks","type":"text"},{"text":" ","type":"text"},{"text":"associated with the task or other tasks.  Other operations on the task, such","type":"text"},{"type":"text","text":" "},{"type":"text","text":"as resuming a continuation, may acquire these same internal locks."},{"text":" ","type":"text"},{"text":"Therefore, if a cancellation handler must acquire a lock, other code should","type":"text"},{"text":" ","type":"text"},{"text":"not cancel tasks or resume continuations while holding that lock.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/withTaskCancellationHandler(operation:onCancel:)-85m2g":{"url":"\/documentation\/swift\/withtaskcancellationhandler(operation:oncancel:)-85m2g","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"withTaskCancellationHandler","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Return","kind":"genericParameter"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"text":">(","kind":"text"},{"text":"operation","kind":"externalParam"},{"kind":"text","text":": "},{"text":"nonisolated(nonsending)","kind":"keyword"},{"text":", ","kind":"text"},{"text":"onCancel","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"sending","kind":"keyword"},{"text":" () -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operatio