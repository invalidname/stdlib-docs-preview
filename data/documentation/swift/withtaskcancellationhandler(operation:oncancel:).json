CancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF6ReturnL_xmfp","text":"Return"}],"modules":[{"relatedModules":[],"name":"Swift"}],"symbolKind":"func","role":"symbol","roleHeading":"Function"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"nonisolated"},{"kind":"text","text":"(nonsending) "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"withTaskCancellationHandler","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Return","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"kind":"text","text":">("},{"kind":"externalParam","text":"operation"},{"kind":"text","text":": "},{"kind":"keyword","text":"nonisolated(nonsending)"},{"kind":"text","text":", "},{"kind":"externalParam","text":"onCancel"},{"kind":"text","text":" "},{"kind":"internalParam","text":"handler"},{"kind":"text","text":": "},{"kind":"keyword","text":"sending"},{"kind":"text","text":" () -> "},{"preciseIdentifier":"s:s4Voida","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Void","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF7FailureL_q_mfp","kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF6ReturnL_xmfp","kind":"typeIdentifier","text":"Return"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s5ErrorP","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","kind":"typeIdentifier","text":"Error"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The operation to perform."}],"type":"paragraph"}],"name":"operation"},{"content":[{"inlineContent":[{"type":"text","text":"A closure to execute on cancellation."},{"type":"text","text":" "},{"type":"text","text":"If the task is canceled, this closure is called at most once;"},{"type":"text","text":" "},{"type":"text","text":"otherwise, it isn’t called."}],"type":"paragraph"}],"name":"handler"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This differs from the operation cooperatively checking for cancellation"},{"type":"text","text":" "},{"type":"text","text":"and reacting to it in that the cancellation handler is "},{"inlineContent":[{"type":"text","text":"always"}],"type":"emphasis"},{"type":"text","text":" and"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"immediately"}],"type":"emphasis"},{"type":"text","text":" invoked when the task is canceled. For example, even if the"},{"type":"text","text":" "},{"type":"text","text":"operation is running code that never checks for cancellation, a cancellation"},{"type":"text","text":" "},{"type":"text","text":"handler still runs and provides a chance to run some cleanup code:"}],"type":"paragraph"},{"syntax":"swift","code":["await withTaskCancellationHandler {","  var sum = 0","  while condition {","    sum += 1","  }","  return sum","} onCancel: {","  \/\/ This onCancel closure might execute concurrently with the operation.","  condition.cancel()","}"],"type":"codeListing"},{"level":3,"text":"Execution order and semantics","anchor":"Execution-order-and-semantics","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" closure is always invoked, even when the"},{"type":"text","text":" "},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" method is called from a task"},{"type":"text","text":" "},{"type":"text","text":"that was already canceled."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" is used in a task that has already been"},{"type":"text","text":" "},{"type":"text","text":"canceled, the cancellation handler will be executed"},{"type":"text","text":" "},{"type":"text","text":"immediately before the "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" closure gets to execute."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This allows the cancellation handler to set some external “canceled” flag"},{"type":"text","text":" "},{"type":"text","text":"that the operation may be "},{"inlineContent":[{"type":"text","text":"atomically"}],"type":"emphasis"},{"type":"text","text":" checking for in order to avoid"},{"type":"text","text":" "},{"type":"text","text":"performing any actual work once the operation gets to run."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" closure executes on the calling execution context, and doesn’t"},{"type":"text","text":" "},{"type":"text","text":"suspend or change execution context unless code contained within the closure"},{"type":"text","text":" "},{"type":"text","text":"does so. In other words, the potential suspension point of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" never suspends by itself before"},{"type":"text","text":" "},{"type":"text","text":"executing the operation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If cancellation occurs while the operation is running, the cancellation"},{"type":"text","text":" "},{"type":"text","text":"handler executes "},{"inlineContent":[{"type":"text","text":"concurrently"}],"type":"emphasis"},{"type":"text","text":" with the operation."}],"type":"paragraph"},{"level":3,"text":"Cancellation handlers and locks","anchor":"Cancellation-handlers-and-locks","type":"heading"},{"inlineContent":[{"type":"text","text":"Cancellation handlers which acquire locks must take care to avoid deadlock."},{"type":"text","text":" "},{"type":"text","text":"The cancellation handler may be invoked while holding internal locks"},{"type":"text","text":" "},{"type":"text","text":"associated with the task or other tasks.  Other operations on the task, such"},{"type":"text","text":" "},{"type":"text","text":"as resuming a continuation, may acquire these same internal locks."},{"type":"text","text":" "},{"type":"text","text":"Therefore, if a cancellation handler must acquire a lock, other code should"},{"type":"text","text":" "},{"type":"text","text":"not cancel tasks or resume continuations while holding that lock."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/withtaskcancellationhandler(operation:oncancel:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Execute an operation with a cancellation handler that’s immediately","type":"text"},{"text":" ","type":"text"},{"text":"invoked if the current task is canceled.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)"},"seeAlsoSections":[{"anchor":"Canceling-Tasks","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled