{"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/swift\/withtaskcancellationhandler(operation:oncancel:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Execute an operation with a cancellation handler that’s immediately","type":"text"},{"text":" ","type":"text"},{"text":"invoked if the current task is canceled.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"nonisolated","kind":"attribute"},{"text":"(nonsending) ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTaskCancellationHandler","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Return","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"nonisolated(nonsending)","kind":"keyword"},{"text":", ","kind":"text"},{"text":"onCancel","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"handler","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"sending","kind":"keyword"},{"text":" () -> ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Void","text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Failure","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF7FailureL_q_mfp"},{"text":") -> ","kind":"text"},{"text":"Return","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF6ReturnL_xmfp"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Error","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"}]}]},{"kind":"parameters","parameters":[{"name":"operation","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The operation to perform."}]}]},{"name":"handler","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure to execute on cancellation."},{"type":"text","text":" "},{"text":"If the task is canceled, this closure is called at most once;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise, it isn’t called.","type":"text"}]}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"This differs from the operation cooperatively checking for cancellation","type":"text"},{"text":" ","type":"text"},{"text":"and reacting to it in that the cancellation handler is ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"always"}]},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"immediately"}]},{"text":" invoked when the task is canceled. For example, even if the","type":"text"},{"text":" ","type":"text"},{"text":"operation is running code that never checks for cancellation, a cancellation","type":"text"},{"text":" ","type":"text"},{"text":"handler still runs and provides a chance to run some cleanup code:","type":"text"}],"type":"paragraph"},{"code":["await withTaskCancellationHandler {","  var sum = 0","  while condition {","    sum += 1","  }","  return sum","} onCancel: {","  \/\/ This onCancel closure might execute concurrently with the operation.","  condition.cancel()","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Execution-order-and-semantics","text":"Execution order and semantics","level":3,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":" closure is always invoked, even when the","type":"text"},{"text":" ","type":"text"},{"code":"withTaskCancellationHandler(operation:onCancel:)","type":"codeVoice"},{"text":" method is called from a task","type":"text"},{"text":" ","type":"text"},{"text":"that was already canceled.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"withTaskCancellationHandler(operation:onCancel:)","type":"codeVoice"},{"text":" is used in a task that has already been","type":"text"},{"text":" ","type":"text"},{"text":"canceled, the cancellation handler will be executed","type":"text"},{"text":" ","type":"text"},{"text":"immediately before the ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":" closure gets to execute.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This allows the cancellation handler to set some external “canceled” flag","type":"text"},{"text":" ","type":"text"},{"text":"that the operation may be ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"atomically"}]},{"text":" checking for in order to avoid","type":"text"},{"text":" ","type":"text"},{"text":"performing any actual work once the operation gets to run.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" closure executes on the calling execution context, and doesn’t"},{"type":"text","text":" "},{"type":"text","text":"suspend or change execution context unless code contained within the closure"},{"type":"text","text":" "},{"type":"text","text":"does so. In other words, the potential suspension point of the"},{"type":"text","text":" "},{"code":"withTaskCancellationHandler(operation:onCancel:)","type":"codeVoice"},{"text":" never suspends by itself before","type":"text"},{"type":"text","text":" "},{"type":"text","text":"executing the operation."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If cancellation occurs while the operation is running, the cancellation","type":"text"},{"text":" ","type":"text"},{"text":"handler executes ","type":"text"},{"inlineContent":[{"text":"concurrently","type":"text"}],"type":"emphasis"},{"text":" with the operation.","type":"text"}]},{"type":"heading","text":"Cancellation handlers and locks","anchor":"Cancellation-handlers-and-locks","level":3},{"inlineContent":[{"text":"Cancellation handlers which acquire locks must take care to avoid deadlock.","type":"text"},{"text":" ","type":"text"},{"text":"The cancellation handler may be invoked while holding internal locks","type":"text"},{"text":" ","type":"text"},{"text":"associated with the task or other tasks.  Other operations on the task, such","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"as resuming a continuation, may acquire these same internal locks."},{"text":" ","type":"text"},{"text":"Therefore, if a cancellation handler must acquire a lock, other code should","type":"text"},{"text":" ","type":"text"},{"text":"not cancel tasks or resume continuations while holding that lock.","type":"text"}],"type":"paragraph"}]}],"metadata":{"roleHeading":"Function","title":"withTaskCancellationHandler(operation:onCancel:)","externalID":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTaskCancellationHandler","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Return","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"no