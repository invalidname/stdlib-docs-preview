d":"func","externalID":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withTaskCancellationHandler"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Return"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">("},{"kind":"externalParam","text":"operation"},{"kind":"text","text":": "},{"kind":"keyword","text":"nonisolated(nonsending)"},{"kind":"text","text":", "},{"kind":"externalParam","text":"onCancel"},{"kind":"text","text":": "},{"kind":"keyword","text":"sending"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Failure","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF7FailureL_q_mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Return","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF6ReturnL_xmfp","kind":"typeIdentifier"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Execute an operation with a cancellation handler that’s immediately"},{"type":"text","text":" "},{"type":"text","text":"invoked if the current task is canceled."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"nonisolated"},{"kind":"text","text":"(nonsending) "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withTaskCancellationHandler"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Return"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">("},{"kind":"externalParam","text":"operation"},{"kind":"text","text":": "},{"kind":"keyword","text":"nonisolated(nonsending)"},{"kind":"text","text":", "},{"kind":"externalParam","text":"onCancel"},{"kind":"text","text":" "},{"kind":"internalParam","text":"handler"},{"kind":"text","text":": "},{"kind":"keyword","text":"sending"},{"kind":"text","text":" () -> "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Void","kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Failure","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF7FailureL_q_mfp"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Return","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF6ReturnL_xmfp"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:s5ErrorP"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"operation","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The operation to perform."}]}]},{"name":"handler","content":[{"inlineContent":[{"text":"A closure to execute on cancellation.","type":"text"},{"text":" ","type":"text"},{"text":"If the task is canceled, this closure is called at most once;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise, it isn’t called.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"This differs from the operation cooperatively checking for cancellation","type":"text"},{"text":" ","type":"text"},{"text":"and reacting to it in that the cancellation handler is ","type":"text"},{"inlineContent":[{"text":"always","type":"text"}],"type":"emphasis"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"immediately"}]},{"type":"text","text":" invoked when the task is canceled. For example, even if the"},{"type":"text","text":" "},{"type":"text","text":"operation is running code that never checks for cancellation, a cancellation"},{"type":"text","text":" "},{"type":"text","text":"handler still runs and provides a chance to run some cleanup code:"}]},{"type":"codeListing","syntax":"swift","code":["await withTaskCancellationHandler {","  var sum = 0","  while condition {","    sum += 1","  }","  return sum","} onCancel: {","  \/\/ This onCancel closure might execute concurrently with the operation.","  condition.cancel()","}"]},{"type":"heading","level":3,"text":"Execution order and semantics","anchor":"Execution-order-and-semantics"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":" closure is always invoked, even when the","type":"text"},{"text":" ","type":"text"},{"code":"withTaskCancellationHandler(operation:onCancel:)","type":"codeVoice"},{"text":" method is called from a task","type":"text"},{"text":" ","type":"text"},{"text":"that was already canceled.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"text":" is used in a task that has already been","type":"text"},{"text":" ","type":"text"},{"text":"canceled, the cancellation handler will be executed","type":"text"},{"text":" ","type":"text"},{"text":"immediately before the ","type":"text"},{"type":"codeVoice","code":"operation"},{"text":" closure gets to execute.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This allows the cancellation handler to set some external “canceled” flag","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that the operation may be "},{"type":"emphasis","inlineContent":[{"text":"atomically","type":"text"}]},{"type":"text","text":" checking for in order to avoid"},{"type":"text","text":" "},{"type":"text","text":"performing any actual work once the operation gets to run."}]},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" closure executes on the calling execution context, and doesn’t"},{"type":"text","text":" "},{"type":"text","text":"suspend or change execution context unless code contained within the closure"},{"type":"text","text":" "},{"type":"text","text":"does so. In other words, the potential suspension point of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" never suspends by itself before"},{"type":"text","text":" "},{"type":"text","text":"executing the operation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If cancellation occurs while the operation is running, the cancellation"},{"type":"text","text":" "},{"type":"text","text":"handler executes "},{"inlineContent":[{"type":"text","text":"concurrently"}],"type":"emphasis"},{"type":"text","text":" with the operation."}],"type":"paragraph"},{"anchor":"Cancellation-handlers-and-locks","text":"Cancellation handlers and locks","type":"heading","level":3},{"inlineContent":[{"text":"Cancellation handlers which acquire locks must take care to avoid deadlock.","type":"text"},{"text":" ","type":"text"},{"text":"The cancellation handler may be invoked while holding internal locks","type":"text"},{"text":" ","type":"text"},{"text":"associated with the task or other tasks.  Other operations on the task, such","type":"text"},{"text":" ","type":"text"},{"text":"as resuming a continuation, may acquire these same internal locks.","type":"text"},{"text":" ","type":"text"},{"text":"Therefore, if a cancellation handler must acquire a lock, other code should","type":"text"},{"text":" ","type":"text"},{"text":"not cancel tasks or resume continuations while holding that lock.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift":{"kind":"symbol","type":"topic","role":"collection","title":"Swift","images":[{"type":"card","identifier":"Swift-PageImage-card.png"}],"abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/CancellationError":{"type":"topic","navigatorTitle":[{"text":"CancellationError","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swift\/cancellationerror","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","title":"CancellationError","abstract":[{"type":"text","text":"An error that indicates a task was canceled."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CancellationError","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Swift/Task/isCancelled-swift.type.property":{"type":"topic","title":"isCancelled","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isCancelled","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A Boolean value that indicates whether the task should stop executing."}],"conformance":{"constraints":[{"code":"Success","type":"codeVoice"},{"type":"text","text":" is "},{"code":"Never","t