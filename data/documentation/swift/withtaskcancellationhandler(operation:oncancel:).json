,"introducedAt":"8.0","deprecated":false,"beta":false,"name":"iPadOS"},{"unavailable":false,"introducedAt":"13.0","deprecated":false,"beta":false,"name":"Mac Catalyst"},{"unavailable":false,"introducedAt":"10.10","deprecated":false,"beta":false,"name":"macOS"},{"unavailable":false,"introducedAt":"9.0","deprecated":false,"beta":false,"name":"tvOS"},{"unavailable":false,"introducedAt":"1.0","deprecated":false,"beta":false,"name":"visionOS"},{"unavailable":false,"introducedAt":"2.0","deprecated":false,"beta":false,"name":"watchOS"}]},"kind":"symbol","abstract":[{"type":"text","text":"Execute an operation with a cancellation handler that’s immediately"},{"type":"text","text":" "},{"type":"text","text":"invoked if the current task is canceled."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Task-Cancellation","title":"Task Cancellation","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:isolation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-8zlgh","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-2lzl8","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/hasActiveCancellationShield"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"nonisolated"},{"kind":"text","text":"(nonsending) "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withTaskCancellationHandler"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Return"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">("},{"kind":"externalParam","text":"operation"},{"kind":"text","text":": "},{"kind":"keyword","text":"nonisolated(nonsending)"},{"kind":"text","text":", "},{"kind":"externalParam","text":"onCancel"},{"kind":"text","text":" "},{"kind":"internalParam","text":"handler"},{"kind":"text","text":": "},{"kind":"keyword","text":"sending"},{"kind":"text","text":" () -> "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Void","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF7FailureL_q_mfp","kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq_YKYCXE_yyXEtYaq_YKs5ErrorR_r0_lF6ReturnL_xmfp","kind":"typeIdentifier","text":"Return"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error"}]}]},{"kind":"parameters","parameters":[{"name":"operation","content":[{"inlineContent":[{"text":"The operation to perform.","type":"text"}],"type":"paragraph"}]},{"name":"handler","content":[{"inlineContent":[{"text":"A closure to execute on cancellation.","type":"text"},{"text":" ","type":"text"},{"text":"If the task is canceled, this closure is called at most once;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise, it isn’t called.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This differs from the operation cooperatively checking for cancellation"},{"type":"text","text":" "},{"type":"text","text":"and reacting to it in that the cancellation handler is "},{"inlineContent":[{"text":"always","type":"text"}],"type":"emphasis"},{"type":"text","text":" and"},{"type":"text","text":" "},{"inlineContent":[{"text":"immediately","type":"text"}],"type":"emphasis"},{"type":"text","text":" invoked when the task is canceled. For example, even if the"},{"type":"text","text":" "},{"type":"text","text":"operation is running code that never checks for cancellation, a cancellation"},{"type":"text","text":" "},{"type":"text","text":"handler still runs and provides a chance to run some cleanup code:"}]},{"type":"codeListing","code":["await withTaskCancellationHandler {","  var sum = 0","  while condition {","    sum += 1","  }","  return sum","} onCancel: {","  \/\/ This onCancel closure might execute concurrently with the operation.","  condition.cancel()","}"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"Execution-order-and-semantics","text":"Execution order and semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"operation","type":"codeVoice"},{"type":"text","text":" closure is always invoked, even when the"},{"type":"text","text":" "},{"code":"withTaskCancellationHandler(operation:onCancel:)","type":"codeVoice"},{"type":"text","text":" method is called from a task"},{"type":"text","text":" "},{"type":"text","text":"that was already canceled."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"withTaskCancellationHandler(operation:onCancel:)","type":"codeVoice"},{"type":"text","text":" is used in a task that has already been"},{"type":"text","text":" "},{"type":"text","text":"canceled, the cancellation handler will be executed"},{"type":"text","text":" "},{"type":"text","text":"immediately before the "},{"code":"operation","type":"codeVoice"},{"type":"text","text":" closure gets to execute."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This allows the cancellation handler to set some external “canceled” flag"},{"type":"text","text":" "},{"type":"text","text":"that the operation may be "},{"inlineContent":[{"text":"atomically","type":"text"}],"type":"emphasis"},{"type":"text","text":" checking for in order to avoid"},{"type":"text","text":" "},{"type":"text","text":"performing any actual work once the operation gets to run."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"operation","type":"codeVoice"},{"type":"text","text":" closure executes on the calling execution context, and doesn’t"},{"type":"text","text":" "},{"type":"text","text":"suspend or change execution context unless code contained within the closure"},{"type":"text","text":" "},{"type":"text","text":"does so. In other words, the potential suspension point of the"},{"type":"text","text":" "},{"code":"withTaskCancellationHandler(operation:onCancel:)","type":"codeVoice"},{"type":"text","text":" never suspends by itself before"},{"type":"text","text":" "},{"type":"text","text":"executing the operation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If cancellation occurs while the operation is running, the cancellation"},{"type":"text","text":" "},{"type":"text","text":"handler executes "},{"inlineContent":[{"text":"concurrently","type":"text"}],"type":"emphasis"},{"type":"text","text":" with the operation."}]},{"type":"heading","level":3,"anchor":"Cancellation-handlers-and-locks","text":"Cancellation handlers and locks"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancellation handlers which acquire locks must take care to avoid deadlock."},{"type":"text","text":" "},{"type":"text","text":"The cancellation handler may be invoked while holding internal locks"},{"type":"text","text":" "},{"type":"text","text":"associated with the task or other tasks.  Other operations on the task, such"},{"type":"text","text":" "},{"type":"text","text":"as resuming a continuation, may acquire these same internal locks."},{"type":"text","text":" "},{"type":"text","text":"Therefore, if a cancellation handler must acquire a lock, other code should"},{"type":"text","text":" "},{"type":"text","text":"not cancel tasks or resume continuations while holding that lock."}]}]}],"references":{"doc://com.apple.Swift/documentation/Swift/Task/hasActiveCancellationShield":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/hasActiveCancellationShield","kind":"symbol","url":"\/documentation\/swift\/task\/hasactivecancellationshield","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasActiveCancellationShield","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Checks if the current task is executing in a scope with a task cancellation shield activated by the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-2lzl8","type":"reference"},{"text":" function.","type":"text"}],"title":"hasActiveCancellationShield","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Success"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Never"},{"text":" and ","type":"text"},{"code":"Failure","type":"codeVoice"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Never"},{"text":".","type":"text"}]}},"doc://com.apple.Swift/documentation/Swift":{"title":"Swift","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"kind":"symbol","t