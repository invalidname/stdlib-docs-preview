{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:isolation:)"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Execute an operation with a cancellation handler that’s immediately"},{"type":"text","text":" "},{"type":"text","text":"invoked if the current task is canceled."}],"variants":[{"paths":["\/documentation\/swift\/withtaskcancellationhandler(operation:oncancel:isolation:)"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"anchor":"Canceling-Tasks","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-2lzl8","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-8zlgh"],"title":"Canceling Tasks"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"text","text":"@backDeployed(before: macOS 15.0, iOS 18.0, watchOS 11.0, tvOS 18.0, visionOS 2.0)\n"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"withTaskCancellationHandler"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"text":"operation","kind":"externalParam"},{"text":": () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancel9isolationxxyYaKXE_yyYbXEScA_pSgYitYaKlF1TL_xmfp"},{"text":", ","kind":"text"},{"text":"onCancel","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"handler","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Void","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"isolation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"isolated","kind":"keyword"},{"text":" (","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Actor","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor","preciseIdentifier":"s:ScA"},{"text":")?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"rethrows"},{"text":" -> ","kind":"text"},{"kind":"typeIdentifier","text":"T","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancel9isolationxxyYaKXE_yyYbXEScA_pSgYitYaKlF1TL_xmfp"}]}]},{"kind":"parameters","parameters":[{"name":"operation","content":[{"inlineContent":[{"type":"text","text":"The operation to perform."}],"type":"paragraph"}]},{"name":"handler","content":[{"inlineContent":[{"type":"text","text":"A closure to execute on cancellation."},{"text":" ","type":"text"},{"text":"If the task is canceled, this closure is called at most once;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise, it isn’t called.","type":"text"}],"type":"paragraph"}]},{"name":"isolation","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The actor that the operation and cancellation handler are isolated to."}]}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"This differs from the operation cooperatively checking for cancellation"},{"type":"text","text":" "},{"type":"text","text":"and reacting to it in that the cancellation handler is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"always"}]},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"immediately"}]},{"type":"text","text":" invoked when the task is canceled. For example, even if the"},{"type":"text","text":" "},{"type":"text","text":"operation is running code that never checks for cancellation, a cancellation"},{"type":"text","text":" "},{"type":"text","text":"handler still runs and provides a chance to run some cleanup code:"}],"type":"paragraph"},{"type":"codeListing","code":["await withTaskCancellationHandler {","  var sum = 0","  while condition {","    sum += 1","  }","  return sum","} onCancel: {","  \/\/ This onCancel closure might execute concurrently with the operation.","  condition.cancel()","}"],"syntax":"swift"},{"text":"Execution order and semantics","type":"heading","level":3,"anchor":"Execution-order-and-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" closure is always invoked, even when the"},{"type":"text","text":" "},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" method is called from a task"},{"type":"text","text":" "},{"type":"text","text":"that was already canceled."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" is used in a task that has already been"},{"type":"text","text":" "},{"type":"text","text":"canceled, the cancellation handler will be executed"},{"type":"text","text":" "},{"type":"text","text":"immediately before the "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" closure gets to execute."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This allows the cancellation handler to set some external “canceled” flag"},{"type":"text","text":" "},{"type":"text","text":"that the operation may be "},{"type":"emphasis","inlineContent":[{"text":"atomically","type":"text"}]},{"type":"text","text":" checking for in order to avoid"},{"type":"text","text":" "},{"type":"text","text":"performing any actual work once the operation gets to run."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" closure executes on the calling execution context, and doesn’t"},{"type":"text","text":" "},{"type":"text","text":"suspend or change execution context unless code contained within the closure"},{"type":"text","text":" "},{"type":"text","text":"does so. In other words, the potential suspension point of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" never suspends by itself before"},{"type":"text","text":" "},{"type":"text","text":"executing the operation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If cancellation occurs while the operation is running, the cancellation"},{"type":"text","text":" "},{"type":"text","text":"handler executes "},{"type":"emphasis","inlineContent":[{"text":"concurrently","type":"text"}]},{"type":"text","text":" with the operation."}]},{"type":"heading","text":"Cancellation handlers and locks","anchor":"Cancellation-handlers-and-locks","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancellation handlers which acquire locks must take care to avoid deadlock."},{"type":"text","text":" "},{"type":"text","text":"The cancellation handler may be invoked while holding internal locks"},{"type":"text","text":" "},{"type":"text","text":"associated with the task or other tasks.  Other operations on the task, such"},{"type":"text","text":" "},{"type":"text","text":"as resuming a continuation, may acquire these same internal locks."},{"type":"text","text":" "},{"type":"text","text":"Therefore, if a cancellation handler must acquire a lock, other code should"},{"type":"text","text":" "},{"type":"text","text":"not cancel tasks or resume continuations while holding that lock."}]}]}],"sections":[],"metadata":{"role":"symbol","platforms":[{"name":"iOS","introducedAt":"8.0","beta":false,"unavailable":false,"deprecated":false},{"beta":false,"name":"iPadOS","unavailable":false,"deprecated":false,"introducedAt":"8.0"},{"name":"Mac Catalyst","introducedAt":"13.0","beta":false,"unavailable":false,"deprecated":false},{"name":"macOS","introducedAt":"10.10","beta":false,"unavailable":false,"deprecated":false},{"beta":false,"name":"tvOS","unavailable":false,"deprecated":false,"introducedAt":"9.0"},{"beta":false,"unavailable":false,"name":"visionOS","deprecated":false,"introducedAt":"1.0"},{"beta":false,"unavailable":false,"name":"watchOS","deprecated":false,"introducedAt":"2.0"}],"symbolKind":"func","externalID":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancel9isolationxxyYaKXE_yyYbXEScA_pSgYitYaKlF","roleHeading":"Function","modules":[{"name":"Swift","relatedModules":[]}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTaskCancellationHandler","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": () ","kind":"text"},{"text":"async","kind":"keyword"},{"kind":"text","text":" "},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancel9isolationxxyYaKXE_yyYbXEScA_pSgYitYaKlF1TL_xmfp","kind":"typeIdentifier"},{"text":", ",