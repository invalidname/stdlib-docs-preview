maryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@backDeployed(before: macOS 15.0, iOS 18.0, watchOS 11.0, tvOS 18.0, visionOS 2.0)\n","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTaskCancellationHandler","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancel9isolationxxyYaKXE_yyYbXEScA_pSgYitYaKlF1TL_xmfp"},{"text":", ","kind":"text"},{"text":"onCancel","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"handler","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Void","preciseIdentifier":"s:s4Voida"},{"text":", ","kind":"text"},{"text":"isolation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"isolated","kind":"keyword"},{"text":" (","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Actor","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor","preciseIdentifier":"s:ScA"},{"text":")?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancel9isolationxxyYaKXE_yyYbXEScA_pSgYitYaKlF1TL_xmfp"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"operation","content":[{"inlineContent":[{"text":"The operation to perform.","type":"text"}],"type":"paragraph"}]},{"name":"handler","content":[{"inlineContent":[{"text":"A closure to execute on cancellation.","type":"text"},{"text":" ","type":"text"},{"text":"If the task is canceled, this closure is called at most once;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise, it isn’t called.","type":"text"}],"type":"paragraph"}]},{"name":"isolation","content":[{"inlineContent":[{"text":"The actor that the operation is isolated to.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"This differs from the operation cooperatively checking for cancellation","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and reacting to it in that the cancellation handler is "},{"inlineContent":[{"type":"text","text":"always"}],"type":"emphasis"},{"type":"text","text":" and"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"immediately"}],"type":"emphasis"},{"type":"text","text":" invoked when the task is canceled. For example, even if the"},{"type":"text","text":" "},{"type":"text","text":"operation is running code that never checks for cancellation, a cancellation"},{"type":"text","text":" "},{"type":"text","text":"handler still runs and provides a chance to run some cleanup code:"}],"type":"paragraph"},{"syntax":"swift","code":["await withTaskCancellationHandler {","  var sum = 0","  while condition {","    sum += 1","  }","  return sum","} onCancel: {","  \/\/ This onCancel closure might execute concurrently with the operation.","  condition.cancel()","}"],"type":"codeListing"},{"text":"Execution order and semantics","level":3,"anchor":"Execution-order-and-semantics","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"code":"operation","type":"codeVoice"},{"type":"text","text":" closure is always invoked, even when the"},{"type":"text","text":" "},{"code":"withTaskCancellationHandler(operation:onCancel:)","type":"codeVoice"},{"type":"text","text":" method is called from a task"},{"type":"text","text":" "},{"type":"text","text":"that was already canceled."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"withTaskCancellationHandler(operation:onCancel:)","type":"codeVoice"},{"text":" is used in a task that has already been","type":"text"},{"text":" ","type":"text"},{"text":"canceled, the cancellation handler will be executed","type":"text"},{"text":" ","type":"text"},{"text":"immediately before the ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":" closure gets to execute.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This allows the cancellation handler to set some external “canceled” flag"},{"type":"text","text":" "},{"type":"text","text":"that the operation may be "},{"type":"emphasis","inlineContent":[{"type":"text","text":"atomically"}]},{"type":"text","text":" checking for in order to avoid"},{"type":"text","text":" "},{"type":"text","text":"performing any actual work once the operation gets to run."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" closure executes on the calling execution context, and doesn’t"},{"type":"text","text":" "},{"type":"text","text":"suspend or change execution context unless code contained within the closure"},{"type":"text","text":" "},{"type":"text","text":"does so. In other words, the potential suspension point of the"},{"type":"text","text":" "},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" never suspends by itself before"},{"type":"text","text":" "},{"type":"text","text":"executing the operation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If cancellation occurs while the operation is running, the cancellation"},{"type":"text","text":" "},{"type":"text","text":"handler executes "},{"type":"emphasis","inlineContent":[{"type":"text","text":"concurrently"}]},{"type":"text","text":" with the operation."}]},{"level":3,"anchor":"Cancellation-handlers-and-locks","type":"heading","text":"Cancellation handlers and locks"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancellation handlers which acquire locks must take care to avoid deadlock."},{"type":"text","text":" "},{"type":"text","text":"The cancellation handler may be invoked while holding internal locks"},{"type":"text","text":" "},{"type":"text","text":"associated with the task or other tasks.  Other operations on the task, such"},{"type":"text","text":" "},{"type":"text","text":"as resuming a continuation, may acquire these same internal locks."},{"type":"text","text":" "},{"type":"text","text":"Therefore, if a cancellation handler must acquire a lock, other code should"},{"type":"text","text":" "},{"type":"text","text":"not cancel tasks or resume continuations while holding that lock."}]}]}],"kind":"symbol","abstract":[{"text":"Execute an operation with a cancellation handler that’s immediately","type":"text"},{"text":" ","type":"text"},{"text":"invoked if the current task is canceled.","type":"text"}],"references":{"doc://com.apple.Swift/documentation/Swift/Task/isCancelled-swift.type.property":{"url":"\/documentation\/swift\/task\/iscancelled-swift.type.property","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isCancelled"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"abstract":[{"type":"text","text":"A Boolean value that indicates whether the task should stop executing."}],"type":"topic","title":"isCancelled","conformance":{"constraints":[{"code":"Success","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Never","type":"codeVoice"},{"ty