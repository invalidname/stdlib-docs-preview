d","text":"rethrows"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancel9isolationxxyYaKXE_yyYbXEScA_pSgYitYaKlF1TL_xmfp","kind":"typeIdentifier","text":"T"}],"platforms":[{"name":"iOS","deprecated":false,"unavailable":false,"introducedAt":"8.0","beta":false},{"name":"iPadOS","deprecated":false,"unavailable":false,"introducedAt":"8.0","beta":false},{"name":"Mac Catalyst","deprecated":false,"unavailable":false,"introducedAt":"13.0","beta":false},{"name":"macOS","introducedAt":"10.10","deprecated":false,"unavailable":false,"beta":false},{"name":"tvOS","beta":false,"unavailable":false,"deprecated":false,"introducedAt":"9.0"},{"introducedAt":"1.0","name":"visionOS","unavailable":false,"beta":false,"deprecated":false},{"deprecated":false,"name":"watchOS","unavailable":false,"beta":false,"introducedAt":"2.0"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/withtaskcancellationhandler(operation:oncancel:isolation:)"]}],"seeAlsoSections":[{"generated":true,"title":"Canceling Tasks","anchor":"Canceling-Tasks","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-2lzl8","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-8zlgh"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@backDeployed(before: macOS 15.0, iOS 18.0, watchOS 11.0, tvOS 18.0, visionOS 2.0)\n","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"withTaskCancellationHandler"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"operation"},{"kind":"text","text":": () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancel9isolationxxyYaKXE_yyYbXEScA_pSgYitYaKlF1TL_xmfp","text":"T"},{"kind":"text","text":", "},{"kind":"externalParam","text":"onCancel"},{"kind":"text","text":" "},{"kind":"internalParam","text":"handler"},{"kind":"text","text":": "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Void","preciseIdentifier":"s:s4Voida","text":"Void"},{"text":", ","kind":"text"},{"text":"isolation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"isolated","kind":"keyword"},{"text":" (","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ScA","text":"Actor","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor"},{"text":")?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancel9isolationxxyYaKXE_yyYbXEScA_pSgYitYaKlF1TL_xmfp","text":"T","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"operation","content":[{"inlineContent":[{"type":"text","text":"The operation to perform."}],"type":"paragraph"}]},{"name":"handler","content":[{"inlineContent":[{"text":"A closure to execute on cancellation.","type":"text"},{"text":" ","type":"text"},{"text":"If the task is canceled, this closure is called at most once;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise, it isn’t called.","type":"text"}],"type":"paragraph"}]},{"name":"isolation","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The actor that the operation and cancellation handler are isolated to."}]}]}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This differs from the operation cooperatively checking for cancellation","type":"text"},{"text":" ","type":"text"},{"text":"and reacting to it in that the cancellation handler is ","type":"text"},{"inlineContent":[{"text":"always","type":"text"}],"type":"emphasis"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"immediately"}],"type":"emphasis"},{"text":" invoked when the task is canceled. For example, even if the","type":"text"},{"text":" ","type":"text"},{"text":"operation is running code that never checks for cancellation, a cancellation","type":"text"},{"text":" ","type":"text"},{"text":"handler still runs and provides a chance to run some cleanup code:","type":"text"}]},{"type":"codeListing","code":["await withTaskCancellationHandler {","  var sum = 0","  while condition {","    sum += 1","  }","  return sum","} onCancel: {","  \/\/ This onCancel closure might execute concurrently with the operation.","  condition.cancel()","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"Execution order and semantics","anchor":"Execution-order-and-semantics"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"operation"},{"text":" closure is always invoked, even when the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"text":" method is called from a task","type":"text"},{"text":" ","type":"text"},{"text":"that was already canceled.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"type":"text","text":" is used in a task that has already been"},{"type":"text","text":" "},{"type":"text","text":"canceled, the cancellation handler will be executed"},{"type":"text","text":" "},{"type":"text","text":"immediately before the "},{"type":"codeVoice","code":"operation"},{"type":"text","text":" closure gets to execute."}]},{"inlineContent":[{"type":"text","text":"This allows the cancellation handler to set some external “canceled” flag"},{"type":"text","text":" "},{"type":"text","text":"that the operation may be "},{"type":"emphasis","inlineContent":[{"type":"text","text":"atomically"}]},{"type":"text","text":" checking for in order to avoid"},{"type":"text","text":" "},{"type":"text","text":"performing any actual work once the operation gets to run."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"operation"},{"text":" closure executes on the calling execution context, and doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"suspend or change execution context unless code contained within the closure","type":"text"},{"text":" ","type":"text"},{"text":"does so. In other words, the potential suspension point of the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"withTaskCancellationHandler(operation:onCancel:)"},{"text":" never suspends by itself before","type":"text"},{"text":" ","type":"text"},{"text":"executing the operation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If cancellation occurs while the operation is running, the cancellation","type":"text"},{"text":" ","type":"text"},{"text":"handler executes ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"concurrently","type":"text"}]},{"text":" with the operation.","type":"text"}]},{"type":"heading","level":3,"text":"Cancellation handlers and locks","anchor":"Cancellation-handlers-and-locks"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancellation handlers which acquire locks must take care to avoid deadlock."},{"type":"text","text":" "},{"type":"text","text":"The cancellation handler may be invoked while holding internal locks"},{"type":"text","text":" "},{"type":"text","text":"associated with the task or other tasks.  Other operations on the task, such"},{"type":"text","text":" "},{"type":"text","text":"as resuming a continuation, may acquire these same internal locks."},{"type":"text","text":" "},{"type":"text","text":"Therefore, if a cancellation handler must acquire a lock, other code should"},{"type":"text","text":" "},{"type":"text","text":"not cancel tasks or resume continuations while holding that lock."}]}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/withTaskCancellationHandler(operation:onCancel:)":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTaskCancellationHandler","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Return","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"nonisolated(nonsending)","kind":"keyword"},{"text":", ","kind":"text"},{"text":"onCancel","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"sending","kind":"keyword"},{"text":" () -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Failure","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancelxxyYaq