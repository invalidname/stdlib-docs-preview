],"externalID":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF","title":"withTaskCancellationShield(operation:)","role":"symbol","modules":[{"name":"Swift","relatedModules":[]}],"roleHeading":"Function"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-2lzl8"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@export(implementation)","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTaskCancellationShield","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": () ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Failure","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF7FailureL_q_mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Value","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF5ValueL_xmfp","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Failure","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF7FailureL_q_mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Value","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF5ValueL_xmfp","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP","text":"Error"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Cancellation shields are primarily used to ensure some cleanup code will","type":"text"},{"text":" ","type":"text"},{"text":"definitely run, even if the context in which the cleanup functions are called from","type":"text"},{"text":" ","type":"text"},{"text":"is a cancelled task, and the functions may otherwise return early (due to observing","type":"text"},{"text":" ","type":"text"},{"text":"the cancellation of the current task).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, a resource cleanup function might internally check for cancellation,","type":"text"},{"text":" ","type":"text"},{"text":"which could cause it to skip important cleanup work:","type":"text"}],"type":"paragraph"},{"code":["let resource = await makeResource()","defer {","  await withTaskCancellationShield {","    await resource.finish() \/\/ runs to completion, even if task was cancelled earlier","  }","}","","struct Resource {","  func finish() {","    guard !Task.isCancelled() else { return } \/\/ returns early if task was cancelled!","    \/\/ real work happens here","  }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"While inside a cancellation shield, "},{"code":"Task.isCancelled","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"false","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Task.checkCancellation()"},{"type":"text","text":" does not throw, even if the surrounding task"},{"type":"text","text":" "},{"type":"text","text":"has been cancelled. Similarly task cancellation handlers do not trigger"},{"type":"text","text":" "},{"type":"text","text":"while executing in a shielded block of code."}],"type":"paragraph"},{"inlineContent":[{"text":"Once the shield scope exits, the task’s actual","type":"text"},{"text":" ","type":"text"},{"text":"cancellation status becomes observable again. Cancellation shields to not","type":"text"},{"text":" ","type":"text"},{"text":"prevent the task from becoming cancelled, but only prevent observing the","type":"text"},{"text":" ","type":"text"},{"text":"cancellation while executing inside a shielded scope.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Cancellation shields also prevent cancellation from propagating to child tasks","type":"text"},{"text":" ","type":"text"},{"text":"created within the shielded scope:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let task = Task {","  withUnsafeCurrentTask { $0?.cancel() } \/\/ cancel the task","","  await withTaskCancellationShield {","    \/\/ Child tasks created here do _not_ observe the parent's cancellation","    \/\/ and therefore start as not cancelled. They can be individually cancelled though.","    await withTaskGroup(of: Void.self) { group in","      group.addTask {","        print(Task.isCancelled) \/\/ false","      }","      for await _ in group {}","","      group.cancelAll() \/\/ explicitly cancelling the group does cancel child tasks of the group","      group.addTask {","        print(Task.isCancelled) \/\/ true","      }","    }","  }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Note that shielding the ","type":"text"},{"code":"addTask","type":"codeVoice"},{"text":" call itself does not shield the child task:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["await withTaskGroup(of: Void.self) { group in","  group.cancelAll()","  withTaskCancellationShield {","    group.addTask { print(Task.isCancelled) } \/\/ true - child is cancelled","  }","  group.addTask {","    withTaskCancellationShield { print(Task.isCancelled) } \/\/ false - shielded inside child","  }","}"],"type":"codeListing"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Enters a scope in which a task cancellation shield is active.","type":"text"}],"variants":[{"paths":["\/documentation\/swift\/withtaskcancellationshield(operation:)-2lzl8"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel(reason:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancellationReason","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError\/Reason-swift.enum","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)-85m2g","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)-1dnzh","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:isolation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-8zlgh","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/hasActiveCancellationShield"],"anchor":"Task-Cancellation","generated":true,"title":"Task Cancellation"}],"sections":[],"references":{"doc://com.apple.Swift/documentation/Swift/withTaskCancellationHandler(operation:onCancel:)-85m2g":{"role":"symbol","type":"topic","title":"withTaskCancellationHandler(operation:onCancel:)","url":"\/documentation\/swift\/withtaskcancellationhandler(operation:oncancel:)-85m2g","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)-85m2g","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTaskCancellationHandler","kind":"identifier"},{"text":"<","kind":"text"},{"text"