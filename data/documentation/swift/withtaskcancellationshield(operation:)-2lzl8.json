{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTaskCancellationShield","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": () ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF7FailureL_q_mfp","text":"Failure","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF5ValueL_xmfp","text":"Value","kind":"typeIdentifier"},{"kind":"text","text":") "},{"text":"throws","kind":"keyword"},{"kind":"text","text":"("},{"preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF7FailureL_q_mfp","text":"Failure","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF5ValueL_xmfp","text":"Value","kind":"typeIdentifier"},{"kind":"text","text":" "},{"text":"where","kind":"keyword"},{"kind":"text","text":" "},{"text":"Failure","kind":"typeIdentifier"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","preciseIdentifier":"s:s5ErrorP"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancellation shields are primarily used to ensure some cleanup code will"},{"type":"text","text":" "},{"type":"text","text":"definitely run, even if the context in which the cleanup functions are called from"},{"type":"text","text":" "},{"type":"text","text":"is a cancelled task, and the functions may otherwise return early (due to observing"},{"type":"text","text":" "},{"type":"text","text":"the cancellation of the current task)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, a resource cleanup function might internally check for cancellation,"},{"type":"text","text":" "},{"type":"text","text":"which could cause it to skip important cleanup work:"}]},{"code":["let resource = await makeResource()","defer {","  await withTaskCancellationShield {","    await resource.finish() \/\/ runs to completion, even if task was cancelled earlier","  }","}","","struct Resource {","  func finish() {","    guard !Task.isCancelled() else { return } \/\/ returns early if task was cancelled!","    \/\/ real work happens here","  }"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"While inside a cancellation shield, "},{"type":"codeVoice","code":"Task.isCancelled"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"false"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Task.checkCancellation()"},{"type":"text","text":" does not throw, even if the surrounding task"},{"type":"text","text":" "},{"type":"text","text":"has been cancelled. Similarly task cancellation handlers do not trigger"},{"type":"text","text":" "},{"type":"text","text":"while executing in a shielded block of code."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once the shield scope exits, the task’s actual"},{"type":"text","text":" "},{"type":"text","text":"cancellation status becomes observable again. Cancellation shields to not"},{"type":"text","text":" "},{"type":"text","text":"prevent the task from becoming cancelled, but only prevent observing the"},{"type":"text","text":" "},{"type":"text","text":"cancellation while executing inside a shielded scope."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancellation shields also prevent cancellation from propagating to child tasks"},{"type":"text","text":" "},{"type":"text","text":"created within the shielded scope:"}]},{"code":["let task = Task {","  withUnsafeCurrentTask { $0?.cancel() } \/\/ cancel the task","","  await withTaskCancellationShield {","    \/\/ Child tasks created here do NOT observe the parent's cancellation","    \/\/ and therefore start as not cancelled. They can be individually cancelled though.","    await withTaskGroup(of: Void.self) { group in","      group.addTask {","        print(Task.isCancelled) \/\/ false","      }","      for await _ in group {}","","      group.cancelAll() \/\/ explicitly cancelling the group does cancel child tasks of the group","      group.addTask {","        print(Task.isCancelled) \/\/ true","      }","    }","  }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that shielding the "},{"code":"addTask","type":"codeVoice"},{"type":"text","text":" call itself does not shield the child task:"}]},{"code":["await withTaskGroup(of: Void.self) { group in","  group.cancelAll()","  withTaskCancellationShield {","    group.addTask { print(Task.isCancelled) } \/\/ true - child IS cancelled","  }","  group.addTask {","    withTaskCancellationShield { print(Task.isCancelled) } \/\/ false - shielded inside child","  }","}"],"type":"codeListing","syntax":"swift"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-2lzl8","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"title":"Canceling Tasks","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:isolation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-8zlgh"],"anchor":"Canceling-Tasks"}],"abstract":[{"type":"text","text":"Enters a scope in which a task cancellation shield is active."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/withtaskcancellationshield(operation:)-2lzl8"]}],"kind":"symbol","metadata":{"roleHeading":"Function","role":"symbol","modules":[{"name":"Swift","relatedModules":[]}],"platforms":[{"beta":false,"deprecated":false,"unavailable":false,"name":"iOS","introducedAt":"8.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"iPadOS","introducedAt":"8.0"},{"unavailable":false,"introducedAt":"13.0","name":"Mac Catalyst","deprecated":false,"beta":false},{"beta":false,"deprecated":false,"unavailable":false,"name":"macOS","introducedAt":"10.10"},{"unavailable":false,"introducedAt":"9.0","name":"tvOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"1.0","name":"visionOS","deprecated":false,"beta":false},{"beta":false,"deprecated":false,"unavailable":false,"name":"watchOS","introducedAt":"2.0"}],"title":"withTaskCancellationShield(operation:)","externalID":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF","symbolKind":"func","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withTaskCancellationShield"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">("},{"text":"operation","kind":"externalParam"},