{"kind":"symbol","abstract":[{"type":"text","text":"Enters a scope in which a task cancellation shield is active."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@export(implementation)"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withTaskCancellationShield"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">("},{"kind":"externalParam","text":"operation"},{"kind":"text","text":": () "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Failure","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF7FailureL_q_mfp"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF5ValueL_xmfp"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Failure","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF7FailureL_q_mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Value","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF5ValueL_xmfp","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Error","preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"Cancellation shields are primarily used to ensure some cleanup code will","type":"text"},{"text":" ","type":"text"},{"text":"definitely run, even if the context in which the cleanup functions are called from","type":"text"},{"text":" ","type":"text"},{"text":"is a cancelled task, and the functions may otherwise return early (due to observing","type":"text"},{"text":" ","type":"text"},{"text":"the cancellation of the current task).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, a resource cleanup function might internally check for cancellation,","type":"text"},{"text":" ","type":"text"},{"text":"which could cause it to skip important cleanup work:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let resource = await makeResource()","defer {","  await withTaskCancellationShield {","    await resource.finish() \/\/ runs to completion, even if task was cancelled earlier","  }","}","","struct Resource {","  func finish() {","    guard !Task.isCancelled() else { return } \/\/ returns early if task was cancelled!","    \/\/ real work happens here","  }"],"syntax":"swift"},{"inlineContent":[{"text":"While inside a cancellation shield, ","type":"text"},{"type":"codeVoice","code":"Task.isCancelled"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Task.checkCancellation()"},{"text":" does not throw, even if the surrounding task","type":"text"},{"text":" ","type":"text"},{"text":"has been cancelled. Similarly task cancellation handlers do not trigger","type":"text"},{"text":" ","type":"text"},{"text":"while executing in a shielded block of code.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Once the shield scope exits, the task’s actual","type":"text"},{"text":" ","type":"text"},{"text":"cancellation status becomes observable again. Cancellation shields to not","type":"text"},{"text":" ","type":"text"},{"text":"prevent the task from becoming cancelled, but only prevent observing the","type":"text"},{"text":" ","type":"text"},{"text":"cancellation while executing inside a shielded scope.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Cancellation shields also prevent cancellation from propagating to child tasks"},{"type":"text","text":" "},{"type":"text","text":"created within the shielded scope:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let task = Task {","  withUnsafeCurrentTask { $0?.cancel() } \/\/ cancel the task","","  await withTaskCancellationShield {","    \/\/ Child tasks created here do _not_ observe the parent's cancellation","    \/\/ and therefore start as not cancelled. They can be individually cancelled though.","    await withTaskGroup(of: Void.self) { group in","      group.addTask {","        print(Task.isCancelled) \/\/ false","      }","      for await _ in group {}","","      group.cancelAll() \/\/ explicitly cancelling the group does cancel child tasks of the group","      group.addTask {","        print(Task.isCancelled) \/\/ true","      }","    }","  }","}"]},{"inlineContent":[{"type":"text","text":"Note that shielding the "},{"type":"codeVoice","code":"addTask"},{"type":"text","text":" call itself does not shield the child task:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["await withTaskGroup(of: Void.self) { group in","  group.cancelAll()","  withTaskCancellationShield {","    group.addTask { print(Task.isCancelled) } \/\/ true - child is cancelled","  }","  group.addTask {","    withTaskCancellationShield { print(Task.isCancelled) } \/\/ false - shielded inside child","  }","}"]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/withtaskcancellationshield(operation:)-2lzl8"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellation