{"abstract":[{"type":"text","text":"Enters a scope in which a task cancellation shield is active."}],"seeAlsoSections":[{"title":"Canceling Tasks","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:isolation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-8zlgh"],"anchor":"Canceling-Tasks"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"sections":[],"metadata":{"externalID":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF","title":"withTaskCancellationShield(operation:)","platforms":[{"unavailable":false,"introducedAt":"8.0","deprecated":false,"beta":false,"name":"iOS"},{"unavailable":false,"introducedAt":"8.0","deprecated":false,"beta":false,"name":"iPadOS"},{"unavailable":false,"introducedAt":"13.0","deprecated":false,"beta":false,"name":"Mac Catalyst"},{"unavailable":false,"introducedAt":"10.10","deprecated":false,"beta":false,"name":"macOS"},{"unavailable":false,"introducedAt":"9.0","deprecated":false,"beta":false,"name":"tvOS"},{"unavailable":false,"introducedAt":"1.0","deprecated":false,"beta":false,"name":"visionOS"},{"unavailable":false,"introducedAt":"2.0","deprecated":false,"beta":false,"name":"watchOS"}],"role":"symbol","modules":[{"relatedModules":[],"name":"Swift"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withTaskCancellationShield"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">("},{"kind":"externalParam","text":"operation"},{"kind":"text","text":": () "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF7FailureL_q_mfp","text":"Failure"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF5ValueL_xmfp","text":"Value"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF7FailureL_q_mfp","text":"Failure"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF5ValueL_xmfp","text":"Value"}],"symbolKind":"func","roleHeading":"Function"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTaskCancellationShield","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": () ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF7FailureL_q_mfp","text":"Failure","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF5ValueL_xmfp","text":"Value","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF7FailureL_q_mfp","text":"Failure","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyq_YKXE_tq_YKs5ErrorR_r0_lF5ValueL_xmfp","text":"Value","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancellation shields are primarily used to ensure some cleanup code will"},{"type":"text","text":" "},{"type":"text","text":"definitely run, even if the context in which the cleanup functions are called from"},{"type":"text","text":" "},{"type":"text","text":"is a cancelled task, and the functions may otherwise return early (due to observing"},{"type":"text","text":" "},{"type":"text","text":"the cancellation of the current task)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, a resource cleanup function might internally check for cancellation,"},{"type":"text","text":" "},{"type":"text","text":"which could cause it to skip important cleanup work:"}]},{"syntax":"swift","type":"codeListing","code":["let resource = await makeResource()","defer {","  await withTaskCancellationShield {","    await resource.finish() \/\/ runs to completion, even if task was cancelled earlier","  }","}","","struct Resource {","  func finish() {","    guard !Task.isCancelled() else { return } \/\/ returns early if task was cancelled!","    \/\/ real work happens here","  }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"While inside a cancellation shield, "},{"code":"Task.isCancelled","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"false","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"Task.checkCancellation()","type":"codeVoice"},{"type":"text","text":" does not throw, even if the surrounding task"},{"type":"text","text":" "},{"type":"text","text":"has been cancelled. Similarly task cancellation handlers do not trigger"},{"type":"text","text":" "},{"type":"text","text":"while executing in a shielded block of code."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once the shield scope exits, the task’s actual"},{"type":"text","text":" "},{"type":"text","text":"cancellation status becomes observable again. Cancellation shields to not"},{"type":"text","text":" "},{"type":"text","text":"prevent the task from becoming cancelled, but only prevent observing the"},{"type":"text","text":" "},{"type":"text","text":"cancellation while executing inside a shielded scope."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancellation shields also prevent cancellation from propagating to child tasks"},{"type":"text","text":" "},{"type":"text","text":"created within the shielded scope:"}]},{"syntax":"swift","type":"codeListing","code":["let task = Task {","  withUnsafeCurrentTask { $0?.cancel() } \/\/ cancel the task","","  await withTaskCancellationShield {","    \/\/ Child tasks created here do NOT observe the parent's cancellation","    \/\/ and therefore start as not cancelled. They can be individually cancelled though.","    await withTaskGroup(of: Void.self) { group in","      group.addTask {","        print(Task.isCancelled) \/\/ false","      }","      for await _ in group {}","","      group.cancelAll() \/\/ explicitly cancelling the group does cancel child tasks of the group","      group.addTask {","        print(Task.isCancelled) \/\/ true","      }","    }","  }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that shielding the "},{"code":"addTask","type":"codeVoice"},{"type":"text","text":" call itself does not shield the child task:"}]},{"syntax":"swift","type":"codeListing","code":["await withTaskGroup(of: Void.self) { group in","  group.cancelAll()","  withTaskCancellationShield {","    group.addTask { print(Task.isCancelled) } \/\/ true - child IS cancelled","  }","  group.addTask {","    withTaskCancellationShield { print(Task.isCancelled) } \/\/ false - shielded inside child","  }","}"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/withtaskcancellationshield(operation:)-2lzl8"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-2lzl8","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift/Task/cancel()":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"()","kind":"text"}],"conformance":{"constraints":[{"code":"Success","type":"codeVoice"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Failure"},{"type":"text","text":" conforms to "},{"code":"Error","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"url":"\/documentation\/swift\/task\/cancel()","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel()","type":"topic","title":"cancel()","abstract":[{"type":"text","text":"Cancels this task."}]},"doc://com.apple.Swift/documentation/Swift/Task/checkCancellation()":{"conformance":{"conformancePrefix":[{"text":"