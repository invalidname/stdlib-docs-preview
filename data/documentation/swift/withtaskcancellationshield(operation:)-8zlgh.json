{"kind":"symbol","sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"nonisolated","kind":"attribute"},{"text":"(nonsending) ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTaskCancellationShield","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"nonisolated(nonsending)","kind":"keyword"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Failure","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF7FailureL_q_mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Value","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF5ValueL_xmfp","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Error","preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Cancellation shields are primarily used to ensure some cleanup code will","type":"text"},{"text":" ","type":"text"},{"text":"definitely run, even if the context in which the cleanup functions are called from","type":"text"},{"text":" ","type":"text"},{"text":"is a cancelled task, and the functions may otherwise return early (due to observing","type":"text"},{"text":" ","type":"text"},{"text":"the cancellation of the current task).","type":"text"}]},{"inlineContent":[{"type":"text","text":"For example, a resource cleanup function might internally check for cancellation,"},{"type":"text","text":" "},{"type":"text","text":"which could cause it to skip important cleanup work:"}],"type":"paragraph"},{"code":["let resource = await makeResource()","defer {","  await withTaskCancellationShield {","    await resource.finish() \/\/ runs to completion, even if task was cancelled earlier","  }","}","","struct Resource {","  func finish() {","    guard !Task.isCancelled() else { return } \/\/ returns early if task was cancelled!","    \/\/ real work happens here","  }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"While inside a cancellation shield, ","type":"text"},{"code":"Task.isCancelled","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"Task.checkCancellation()","type":"codeVoice"},{"text":" does not throw, even if the surrounding task","type":"text"},{"text":" ","type":"text"},{"text":"has been cancelled. Similarly task cancellation handlers do not trigger","type":"text"},{"text":" ","type":"text"},{"text":"while executing in a shielded block of code.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Once the shield scope exits, the task’s actual"},{"type":"text","text":" "},{"type":"text","text":"cancellation status becomes observable again. Cancellation shields to not"},{"type":"text","text":" "},{"type":"text","text":"prevent the task from becoming cancelled, but only prevent observing the"},{"type":"text","text":" "},{"type":"text","text":"cancellation while executing inside a shielded scope."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Cancellation shields also prevent cancellation from propagating to child tasks"},{"type":"text","text":" "},{"type":"text","text":"created within the shielded scope:"}],"type":"paragraph"},{"code":["let task = Task {","  withUnsafeCurrentTask { $0?.cancel() } \/\/ cancel the task","","  await withTaskCancellationShield {","    \/\/ Child tasks created here do NOT observe the parent's cancellation","    \/\/ and therefore start as not cancelled. They can be individually cancelled though.","    await withTaskGroup(of: Void.self) { group in","      group.addTask {","        print(Task.isCancelled) \/\/ false","      }","      for await _ in group {}","","      group.cancelAll() \/\/ explicitly cancelling the group does cancel child tasks of the group","      group.addTask {","        print(Task.isCancelled) \/\/ true","      }","    }","  }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Note that shielding the "},{"type":"codeVoice","code":"addTask"},{"type":"text","text":" call itself does not shield the child task:"}],"type":"paragraph"},{"type":"codeListing","code":["await withTaskGroup(of: Void.self) { group in","  group.cancelAll()","  withTaskCancellationShield {","    group.addTask { print(Task.isCancelled) } \/\/ true - child IS cancelled","  }","  group.addTask {","    withTaskCancellationShield { print(Task.isCancelled) } \/\/ false - shielded inside child","  }","}"],"syntax":"swift"}],"kind":"content"}],"abstract":[{"type":"text","text":"Enters a scope in which a task cancellation shield is active."}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-8zlgh","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swift\/withtaskcancellationshield(operation:)-8zlgh"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF","title":"withTaskCancellationShield(operation:)","platforms":[{"introducedAt":"8.0","name":"iOS","unavailable":false,"beta":false,"depreca