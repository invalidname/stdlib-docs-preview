{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"nonisolated","kind":"attribute"},{"text":"(nonsending) ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTaskCancellationShield","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"nonisolated(nonsending)","kind":"keyword"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF7FailureL_q_mfp","text":"Failure","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF5ValueL_xmfp","text":"Value","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s5ErrorP","text":"Error","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancellation shields are primarily used to ensure some cleanup code will"},{"type":"text","text":" "},{"type":"text","text":"definitely run, even if the context in which the cleanup functions are called from"},{"type":"text","text":" "},{"type":"text","text":"is a cancelled task, and the functions may otherwise return early (due to observing"},{"type":"text","text":" "},{"type":"text","text":"the cancellation of the current task)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, a resource cleanup function might internally check for cancellation,"},{"type":"text","text":" "},{"type":"text","text":"which could cause it to skip important cleanup work:"}]},{"code":["let resource = await makeResource()","defer {","  await withTaskCancellationShield {","    await resource.finish() \/\/ runs to completion, even if task was cancelled earlier","  }","}","","struct Resource {","  func finish() {","    guard !Task.isCancelled() else { return } \/\/ returns early if task was cancelled!","    \/\/ real work happens here","  }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"While inside a cancellation shield, "},{"code":"Task.isCancelled","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"false","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"Task.checkCancellation()","type":"codeVoice"},{"type":"text","text":" does not throw, even if the surrounding task"},{"type":"text","text":" "},{"type":"text","text":"has been cancelled. Similarly task cancellation handlers do not trigger"},{"type":"text","text":" "},{"type":"text","text":"while executing in a shielded block of code."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Once the shield scope exits, the task’s actual"},{"type":"text","text":" "},{"type":"text","text":"cancellation status becomes observable again. Cancellation shields to not"},{"type":"text","text":" "},{"type":"text","text":"prevent the task from becoming cancelled, but only prevent observing the"},{"type":"text","text":" "},{"type":"text","text":"cancellation while executing inside a shielded scope."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Cancellation shields also prevent cancellation from propagating to child tasks","type":"text"},{"text":" ","type":"text"},{"text":"created within the shielded scope:","type":"text"}]},{"syntax":"swift","code":["let task = Task {","  withUnsafeCurrentTask { $0?.cancel() } \/\/ cancel the task","","  await withTaskCancellationShield {","    \/\/ Child tasks created here do NOT observe the parent's cancellation","    \/\/ and therefore start as not cancelled. They can be individually cancelled though.","    await withTaskGroup(of: Void.self) { group in","      group.addTask {","        print(Task.isCancelled) \/\/ false","      }","      for await _ in group {}","","      group.cancelAll() \/\/ explicitly cancelling the group does cancel child tasks of the group","      group.addTask {","        print(Task.isCancelled) \/\/ true","      }","    }","  }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Note that shielding the ","type":"text"},{"code":"addTask","type":"codeVoice"},{"text":" call itself does not shield the child task:","type":"text"}]},{"code":["await withTaskGroup(of: Void.self) { group in","  group.cancelAll()","  withTaskCancellationShield {","    group.addTask { print(Task.isCancelled) } \/\/ true - child IS cancelled","  }","  group.addTask {","    withTaskCancellationShield { print(Task.isCancelled) } \/\/ false - shielded inside child","  }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"metadata":{"roleHeading":"Function","symbolKind":"func","role":"symbol","modules":[{"name":"Swift","relatedModules":[]}],"platforms":[{"name":"iOS","introducedAt":"8.0","beta":false,"unavailable":false,"deprecated":false},{"beta":false,"name":"iPadOS","deprecated":false,"introducedAt":"8.0","unavailable":false},{"beta":false,"name":"Mac Catalyst","deprecated":false,"introducedAt":"13.0","unavailable":false},{"beta":false,"name":"macOS","deprecated":false,"introducedAt":"10.10","unavailable":false},{"beta":false,"name":"tvOS","deprecated":false,"introducedAt":"9.0","unavailable":false},{"beta":false,"name":"visionOS","deprecated":false,"introducedAt":"1.0","unavailable":false},{"beta":false,"name":"watchOS","deprecated":false,"introducedAt":"2.0","unavailable":false}],"fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"withTaskCancellationShield"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">("},{"kind":"externalParam","text":"operation"},{"kind":"text","text":": "},{"kind":"keyword","text":"nonisolated(nonsending)"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Failure","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF7FailureL_q_mfp"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF5ValueL_xmfp"}],"title":"withTaskCancellationShield(operation:)","externalID":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF"},"abstract":[{"type":"text","text":"Enters a scope in which a task cancellation shield is active."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-8zlgh"},"seeAlsoSections":[{"title":"Canceling Tasks","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","doc