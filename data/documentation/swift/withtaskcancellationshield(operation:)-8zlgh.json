{"variants":[{"paths":["\/documentation\/swift\/withtaskcancellationshield(operation:)-8zlgh"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-8zlgh"},"metadata":{"platforms":[{"introducedAt":"8.0","name":"iOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"8.0","unavailable":false,"beta":false,"deprecated":false,"name":"iPadOS"},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"13.0","name":"Mac Catalyst"},{"introducedAt":"10.10","name":"macOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"9.0","name":"tvOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"1.0","name":"visionOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"2.0","name":"watchOS","beta":false,"deprecated":false,"unavailable":false}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withTaskCancellationShield"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Failure"},{"kind":"text","text":">("},{"kind":"externalParam","text":"operation"},{"kind":"text","text":": "},{"kind":"keyword","text":"nonisolated(nonsending)"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF7FailureL_q_mfp","kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":") -> "},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF5ValueL_xmfp"}],"title":"withTaskCancellationShield(operation:)","modules":[{"name":"Swift","relatedModules":[]}],"symbolKind":"func","role":"symbol","externalID":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF","roleHeading":"Function"},"kind":"symbol","abstract":[{"type":"text","text":"Enters a scope in which a task cancellation shield is active."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"seeAlsoSections":[{"title":"Task Cancellation","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/isCancelled-swift.type.property","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/cancel()","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/checkCancellation()","doc:\/\/com.apple.Swift\/documentation\/Swift\/CancellationError","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:isolation:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationShield(operation:)-2lzl8","doc:\/\/com.apple.Swift\/documentation\/Swift\/Task\/hasActiveCancellationShield"],"anchor":"Task-Cancellation"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"nonisolated","kind":"attribute"},{"text":"(nonsending) ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withTaskCancellationShield","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"nonisolated(nonsending)","kind":"keyword"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Failure","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF7FailureL_q_mfp"},{"text":") -> ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF5ValueL_xmfp"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Error","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Cancellation shields are primarily used to ensure some cleanup code will","type":"text"},{"text":" ","type":"text"},{"text":"definitely run, even if the context in which the cleanup functions are called from","type":"text"},{"text":" ","type":"text"},{"text":"is a cancelled task, and the functions may otherwise return early (due to observing","type":"text"},{"text":" ","type":"text"},{"text":"the cancellation of the current task).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, a resource cleanup function might internally check for cancellation,","type":"text"},{"text":" ","type":"text"},{"text":"which could cause it to skip important cleanup work:","type":"text"}]},{"code":["let resource = await makeResource()","defer {","  await withTaskCancellationShield {","    await resource.finish() \/\/ runs to completion, even if task was cancelled earlier","  }","}","","struct Resource {","  func finish() {","    guard !Task.isCancelled() else { return } \/\/ returns early if task was cancelled!","    \/\/ real work happens here","  }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"While inside a cancellation shield, ","type":"text"},{"type":"codeVoice","code":"Task.isCancelled"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Task.checkCancellation()"},{"text":" does not throw, even if the surrounding task","type":"text"},{"text":" ","type":"text"},{"text":"has been cancelled. Similarly task cancellation handlers do not trigger","type":"text"},{"text":" ","type":"text"},{"text":"while executing in a shielded block of code.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Once the shield scope exits, the task’s actual","type":"text"},{"text":" ","type":"text"},{"text":"cancellation status becomes observable again. Cancellation shields to not","type":"text"},{"text":" ","type":"text"},{"text":"prevent the task from becoming cancelled, but only prevent observing the","type":"text"},{"text":" ","type":"text"},{"text":"cancellation while executing inside a shielded scope.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Cancellation shields also prevent cancellation from propagating to child tasks","type":"text"},{"text":" ","type":"text"},{"text":"created within the shielded scope:","type":"text"}]},{"code":["let task = Task {","  withUnsafeCurrentTask { $0?.cancel() } \/\/ cancel the task","","  await withTaskCancellationShield {","    \/\/ Child tasks created here do NOT observe the parent's cancellation","    \/\/ and therefore start as not cancelled. They can be individually cancelled though.","    await withTaskGroup(of: Void.self) { group in","      group.addTask {","        print(Task.isCancelled) \/\/ false","      }","      for await _ in group {}","","      group.cancelAll() \/\/ explicitly cancelling the group does cancel child tasks of the group","      group.addTask {","        print(Task.isCancelled) \/\/ true","      }","    }","  }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Note that shielding the ","type":"text"},{"type":"codeVoice","code":"addTask"},{"text":" call itself does not shield the child task:","type":"text"}]},{"code":["await withTaskGroup(of: Void.self) { group in","  group.cancelAll()","  withTaskCancellationShield {","    group.addTask { print(Task.isCancelled) } \/\/ true - child IS cancelled","  }","  group.addTask {","    withTaskCancellationShield { print(Task.isCancelled) } \/\/ false - shielded inside child","  }","}"],"type":"codeListing","syntax":"swift"}]}],"references":{"doc://com.apple.Swift/documentation/Swift/withTaskCancellationHandler(operation:onCancel:isolation:)":{"url":"\/documentation\/swift\/withtaskcancellationhandler(operation:oncancel:isolation:)","kind":"symbol","abstract":[{"type":"text","text":"Execute an operation with a cancellation handler that’s immediately"},{"text":" ","type":"text"},{"text":"invoked if the current task is canceled.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskCancellationHandler(operation:onCancel:isolation:)","title":"withTaskCancellationHandler(operation:onCancel:isolation:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withTaskCancellationHandler"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"operation"},{"text":": () ","kind":"text"},{"kind":"keyword","text":"async"},{"text":" ","kind":"text"},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"T","preciseIdentifier":"s:12_Concurrency27withTaskCancellationHandler9operation8onCancel9isolationxxyYaKXE_yyYbXEScA_pSgYitYaKlF1TL_xmfp"},{"kind":"text","text":", "},{"kind":"externalParam","text":"onCancel"},{"kind":"text","text":": "},{"kind":"attribute","text":"@Sendable"},{"text":" () -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"kind":"text","text":", "}