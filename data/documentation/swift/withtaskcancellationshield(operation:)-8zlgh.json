{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"nonisolated","kind":"attribute"},{"text":"(nonsending) ","kind":"text"},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"withTaskCancellationShield"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"text":", ","kind":"text"},{"kind":"genericParameter","text":"Failure"},{"text":">(","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"keyword","text":"nonisolated(nonsending)"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","text":"Failure","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF7FailureL_q_mfp"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:12_Concurrency26withTaskCancellationShield9operationxxyYaq_YKYCXE_tYaq_YKs5ErrorR_r0_lF5ValueL_xmfp"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"text":"Failure","kind":"typeIdentifier"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Cancellation shields are primarily used to ensure some cleanup code will","type":"text"},{"type":"text","text":" "},{"type":"text","text":"definitely run, even if the context in which the cleanup functions are called from"},{"text":" ","type":"text"},{"type":"text","text":"is a cancelled task, and the functions may otherwise return early (due to observing"},{"type":"text","text":" "},{"type":"text","text":"the cancellation of the current task)."}],"type":"paragraph"},{"inlineContent":[{"text":"For example, a resource cleanup function might internally check for cancellation,","type":"text"},{"text":" ","type":"text"},{"text":"which could cause it to skip important cleanup work:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let resource = await makeResource()","defer {","  await withTaskCancellationShield {","    await resource.finish() \/\/ runs to completion, even if task was cancelled earlier","  }","}","","struct Resource {","  func finish() {","    guard !Task.isCancelled() else { return } \/\/ returns early if task was cancelled!","    \/\/ real work happens here","  }"]},{"type":"paragraph","inlineContent":[{"text":"While inside a cancellation shield, ","type":"text"},{"type":"codeVoice","code":"Task.isCancelled"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"Task.checkCancellation()","type":"codeVoice"},{"text":" does not throw, even if the surrounding task","type":"text"},{"text":" ","type":"text"},{"text":"has been cancelled. Similarly task cancellation handlers do not trigger","type":"text"},{"text":" ","type":"text"},{"text":"while executing in a shielded block of code.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Once the shield scope exits, the task’s actual"},{"text":" ","type":"text"},{"text":"cancellation status becomes observable again. Cancellation shields to not","type":"text"},{"text":" ","type":"text"},{"text":"prevent the task from becoming cancelled, but only prevent observing the","type":"text"},{"type":"text","text":" "},{"text":"cancellation while executing inside a shielded scope.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Cancellation shields also prevent cancellation from propagating to child tasks","type":"text"},{"text":" ","type":"text"},{"text":"created within the shielded scope:","type":"text"}],"type":"paragraph"},{"code":["let task = Task {","  withUnsafeCurrentTask { $0?.cancel() } \/\/ cancel the task","","  await withTaskCancellationShield {","    \/\/ Child tasks created here do NOT observe the parent's cancellation","    \/\/ and therefore start as not cancelled. They can be individually cancelled though.","    await withTaskGroup(of: Void.self) { group in","      group.addTask {","        print(Task.isCancelled) \/\/ false","      }","      for await _ in group {}","","      group.cancelAll() \/\/ explicitly cancelling the group does cancel child tasks of the group","      group.addTask {","        print(Task.isCancelled) \/\/ true","      }","    }","  }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Note that shielding the ","type":"text"},{"code":"addTask","type":"codeVoice"},{"text":" call itself does not shield the child task:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["await withTaskGroup(of: Void.self) { group in","  group.cancelAll()","  withTaskCancellationShield {","    group.addTask { print(Task.isCancelled) } \/\/ true - child IS cancelled","  }","  group.addTask {","    withTaskCancellationShield { print(Task.isCancelled) } \/\/ false - shielded inside child","  }","}"]}]}],"abstract":[{"type":"text","text":"Enters a scope in which a task cancellation shield is active."}],"metadata":{"role":"symbol","platforms":[{"introducedAt":"8.0","beta":false,"name":"iOS","deprecated":false,"unavailable":false},{"introducedAt":"8.0","beta":false,"name":"iPadOS","deprecated":false,"unavailable":false},{"unavailable":false,"name":"Mac Catalyst","beta":false,"introducedAt":"13.0","deprecated":false},{"unavailable":false,"name":"macOS","beta":false,"introducedAt":"10.10","deprecated":false},{"name":"tvOS","beta":false,"introducedAt":"9.0","deprecated":false,"unavailable":false},{"introducedAt":"1.0","beta":false,"name":"visionOS","deprecated":false,"unavailable":false},{"unavailable":false,