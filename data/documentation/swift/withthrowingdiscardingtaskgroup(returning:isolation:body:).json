ext":".Type = GroupResult.self, ","kind":"text"},{"text":"isolation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"isolated","kind":"keyword"},{"text":" (","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Actor","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor","preciseIdentifier":"s:ScA"},{"text":")? = #isolation, ","kind":"text"},{"text":"body","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ThrowingDiscardingTaskGroup","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","preciseIdentifier":"s:12_Concurrency27ThrowingDiscardingTaskGroupV"},{"text":"<","kind":"text"},{"text":"Error","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP"},{"text":">) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"GroupResult","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency31withThrowingDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdeF0Vys5Error_pGzYaKXEtYaKlF0F6ResultL_xmfp"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"GroupResult","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency31withThrowingDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdeF0Vys5Error_pGzYaKXEtYaKlF0F6ResultL_xmfp"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Unlike a "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","isActive":true},{"type":"text","text":", the child tasks as well as their results are"},{"type":"text","text":" "},{"type":"text","text":"discarded as soon as the tasks complete. This prevents the discarding"},{"type":"text","text":" "},{"type":"text","text":"task group from accumulating many results waiting to be consumed, and is"},{"type":"text","text":" "},{"type":"text","text":"best applied in situations where the result of a child task is some form"},{"type":"text","text":" "},{"text":"of side-effect.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"A group ","type":"text"},{"inlineContent":[{"text":"always","type":"text"}],"type":"emphasis"},{"type":"text","text":" waits for all of its child tasks"},{"text":" ","type":"text"},{"text":"to complete before it returns. Even canceled tasks must run until","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"completion before this function returns."},{"text":" ","type":"text"},{"type":"text","text":"Canceled child tasks cooperatively react to cancellation and attempt"},{"text":" ","type":"text"},{"type":"text","text":"to return as early as possible."},{"type":"text","text":" "},{"text":"After this function returns, the task group is always empty.","type":"text"}]},{"inlineContent":[{"type":"text","text":"It is not possible to explicitly await completion of child-tasks,"},{"type":"text","text":" "},{"text":"however the group will automatically await ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"all"}]},{"text":" child task completions","type":"text"},{"type":"text","text":" "},{"type":"text","text":"before returning from this function:"}],"type":"paragraph"},{"code":["try await withThrowingDiscardingTaskGroup { group in","  group.addTask { \/* slow-task *\/ }","  \/\/ slow-task executes...","}","\/\/ guaranteed that slow-task has completed and the group is empty & destroyed"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Refer to ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","isActive":true},{"text":" documentation for detailed discussion of semantics shared between all task groups.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Task Group Cancellation","anchor":"Task-Group-Cancellation","level":1},{"inlineContent":[{"text":"You can cancel a task group and all of its child tasks","type":"text"},{"text":" ","type":"text"},{"text":"by calling the ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup\/cancelAll()","isActive":true},{"text":" method on the task group,","type":"text"},{"text":" ","type":"text"},{"text":"or by canceling the task in which the group is running.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you call ","type":"text"},{"code":"addTask(priority:operation:)","type":"codeVoice"},{"text":" to create a new task in a canceled group,","type":"text"},{"text":" ","type":"text"},{"text":"that task is immediately canceled after creation.","type":"text"},{"text":" ","type":"text"},{"text":"Alternatively, you can call ","type":"text"},{"code":"asyncUnlessCancelled(priority:operation:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which doesn’t create the task if the group has already been canceled.","type":"text"},{"text":" ","type":"text"},{"text":"Choosing between these two functions","type":"text"},{"text":" ","type":"text"},{"text":"lets you control how to react to cancellation within a group:","type":"text"},{"text":" ","type":"text"},{"text":"some child tasks need to run regardless of cancellation,","type":"text"},{"text":" ","type":"text"},{"text":"but other tasks are better not even being created","type":"text"},{"text":" ","type":"text"},{"text":"when you know they can’t produce useful results.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Error Handling and Implicit Cancellation","anchor":"Error-Handling-and-Implicit-Cancellation","level":1},{"inlineContent":[{"text":"Since it is not possible to explicitly await individual task completions,","type":"text"},{"text":" ","type":"text"},{"text":"it is also not possible to “re-throw” an error thrown by one of the child","type":"text"},{"text":" ","type":"text"},{"text":"tasks using the same pattern as one would in a ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ ThrowingTaskGroup, pattern not applicable to ThrowingDiscardingTaskGroup","try await withThrowingTaskGroup(of: Void.self) { group in","  group.addTask { try boom() }","  try await group.next() \/\/ re-throws \"boom\"","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Since discarding task groups don’t have access to ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":", this pattern","type":"text"},{"text":" ","type":"text"},{"text":"cannot be used.","type":"text"},{"text":" ","type":"text"},{"text":"Instead,","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"inlineContent":[{"text":"throwing discarding task group implicitly cancels itself whenever any","type":"text"},{"text":" ","type":"text"},{"text":"of its child tasks throws","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"first error"}]},{"text":" thrown inside such task group","type":"text"},{"type":"text","text":" "},{"type":"text","text":"is then retained and thrown"},{"type":"text","text":" "},{"type":"text","text":"out of the "},{"type":"codeVoice","code":"withThrowingDiscardingTaskGroup"},{"type":"text","text":" method when it returns."}],"type":"paragraph"},{"syntax":"swift","code":["try await withThrowingDiscardingTaskGroup { group in","  group.addTask { try boom(1) }","  group.addTask { try boom(2, after: .seconds(5)) }","  group.addTask { try boom(3, after: .seconds(5)) }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Generally, this suits the typical use cases of a","type":"text"},{"text":" ","type":"text"},{"text":"discarding task group well, however, if you want to prevent specific","type":"text"},{"text":" ","type":"text"},{"text":"errors from canceling the group you can catch them inside the child","type":"text"},{"text":" ","type":"text"},{"text":"task’s body like this:","type":"text"}],"type":"paragraph"},{"code":["try await withThrowingDiscardingTaskGroup { group in","  group.addTask {","    do {","      try boom(1)","    } catch is HarmlessError {","      return","    }","  }","  group.addTask {","    try boom(2, after: .seconds(5))","  }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingDiscardingTaskGroup(returning:isolation:body:)","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"anchor":"Tasks","title":"Tasks","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority","doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"]}],"sections":[],"references":{"doc://com.apple.Swift/documenta