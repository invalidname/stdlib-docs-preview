{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@backDeployed(before: macOS 15.0, iOS 18.0, watchOS 11.0, tvOS 18.0, visionOS 2.0)\n","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withThrowingDiscardingTaskGroup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"GroupResult","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"returning","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"returnType","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"GroupResult","preciseIdentifier":"s:12_Concurrency31withThrowingDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdeF0Vys5Error_pGzYaKXEtYaKlF0F6ResultL_xmfp","kind":"typeIdentifier"},{"text":".Type = GroupResult.self, ","kind":"text"},{"text":"isolation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"isolated","kind":"keyword"},{"text":" (","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Actor","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor","preciseIdentifier":"s:ScA","kind":"typeIdentifier"},{"text":")? = #isolation, ","kind":"text"},{"text":"body","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ThrowingDiscardingTaskGroup","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","preciseIdentifier":"s:12_Concurrency27ThrowingDiscardingTaskGroupV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Error","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"GroupResult","preciseIdentifier":"s:12_Concurrency31withThrowingDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdeF0Vys5Error_pGzYaKXEtYaKlF0F6ResultL_xmfp","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"GroupResult","preciseIdentifier":"s:12_Concurrency31withThrowingDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdeF0Vys5Error_pGzYaKXEtYaKlF0F6ResultL_xmfp","kind":"typeIdentifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Unlike a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup"},{"type":"text","text":", the child tasks as well as their results are"},{"type":"text","text":" "},{"type":"text","text":"discarded as soon as the tasks complete. This prevents the discarding"},{"type":"text","text":" "},{"type":"text","text":"task group from accumulating many results waiting to be consumed, and is"},{"type":"text","text":" "},{"type":"text","text":"best applied in situations where the result of a child task is some form"},{"type":"text","text":" "},{"type":"text","text":"of side-effect."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A group "},{"type":"emphasis","inlineContent":[{"text":"always","type":"text"}]},{"type":"text","text":" waits for all of its child tasks"},{"type":"text","text":" "},{"type":"text","text":"to complete before it returns. Even canceled tasks must run until"},{"type":"text","text":" "},{"type":"text","text":"completion before this function returns."},{"type":"text","text":" "},{"type":"text","text":"Canceled child tasks cooperatively react to cancellation and attempt"},{"type":"text","text":" "},{"type":"text","text":"to return as early as possible."},{"type":"text","text":" "},{"type":"text","text":"After this function returns, the task group is always empty."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is not possible to explicitly await completion of child-tasks,"},{"type":"text","text":" "},{"type":"text","text":"however the group will automatically await "},{"type":"emphasis","inlineContent":[{"text":"all","type":"text"}]},{"type":"text","text":" child task completions"},{"type":"text","text":" "},{"type":"text","text":"before returning from this function:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["try await withThrowingDiscardingTaskGroup(of: Void.self) { group in","  group.addTask { \/* slow-task *\/ }","  \/\/ slow-task executes...","}","\/\/ guaranteed that slow-task has completed and the group is empty & destroyed"]},{"inlineContent":[{"type":"text","text":"Refer to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup"},{"type":"text","text":" documentation for detailed discussion of semantics shared between all task groups."}],"type":"paragraph"},{"level":1,"text":"Task Group Cancellation","anchor":"Task-Group-Cancellation","type":"heading"},{"inlineContent":[{"type":"text","text":"You can cancel a task group and all of its child tasks"},{"type":"text","text":" "},{"type":"text","text":"by calling the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup\/cancelAll()"},{"type":"text","text":" method on the task group,"},{"type":"text","text":" "},{"type":"text","text":"or by canceling the task in which the group is running."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you call "},{"type":"codeVoice","code":"addTask(priority:operation:)"},{"type":"text","text":" to create a new task in a canceled group,"},{"type":"text","text":" "},{"type":"text","text":"that task is immediately canceled after creation."},{"type":"text","text":" "},{"type":"text","text":"Alternatively, you can call "},{"type":"codeVoice","code":"asyncUnlessCancelled(priority:operation:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which doesn’t create the task if the group has already been canceled."},{"type":"text","text":" "},{"type":"text","text":"Choosing between these two functions"},{"type":"text","text":" "},{"type":"text","text":"lets you control how to react to cancellation within a group:"},{"type":"text","text":" "},{"type":"text","text":"some child tasks need to run regardless of cancellation,"},{"type":"text","text":" "},{"type":"text","text":"but other tasks are better not even being created"},{"type":"text","text":" "},{"type":"text","text":"when you know they can’t produce useful results."}],"type":"paragraph"},{"level":1,"text":"Error Handling and Implicit Cancellation","anchor":"Error-Handling-and-Implicit-Cancellation","type":"heading"},{"inlineContent":[{"type":"text","text":"Since it is not possible to explicitly await individual task completions,"},{"type":"text","text":" "},{"type":"text","text":"it is also not possible to “re-throw” an error thrown by one of the child"},{"type":"text","text":" "},{"type":"text","text":"tasks using the same pattern as one would in a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ ThrowingTaskGroup, pattern not applicable to ThrowingDiscardingTaskGroup","try await withThrowingTaskGroup(of: Void.self) { group in","  group.addTask { try boom() }","  try await group.next() \/\/ re-throws \"boom\"","}"]},{"inlineContent":[{"type":"text","text":"Since discarding task groups don’t have access to "},{"type":"codeVoice","code":"next()"},{"type":"text","text":", this pattern"},{"type":"text","text":" "},{"type":"text","text":"cannot be used."},{"type":"text","text":" "},{"type":"text","text":"Instead,"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"emphasis","inlineContent":[{"text":"throwing discarding task group implicitly cancels itself whenever any","type":"text"},{"text":" ","type":"text"},{"text":"of its child tasks throws","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"emphasis","inlineContent":[{"text":"first error","type":"text"}]},{"type":"text","text":" thrown inside such task group"},{"type":"text","text":" "},{"type":"text","text":"is then retained and thrown"},{"type":"text","text":" "},{"type":"text","text":"out of the "},{"type":"codeVoice","code":"withThrowingDiscardingTaskGroup"},{"type":"text","text":" method when it returns."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["try await withThrowingDiscardingTaskGroup { group in","  group.addTask { try boom(1) }","  group.addTask { try boom(2, after: .seconds(5)) }","  group.addTask { try boom(3, after: .seconds(5)) }","}"]},{"inlineContent":[{"type":"text","text":"Generally, this suits the typical use cases of a"},{"type":"text","text":" "},{"type":"text","text":"discarding task group well, however, if you want to prevent specific"},{"type":"text","text":" "},{"type":"text","text":"errors from canceling the group you can catch them inside the child"},{"type":"text","text":" "},{"type":"text","text":"task’s body like this:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["try await withThrowingDiscardingTaskGroup { group in","  group.addTask {","    do {","      try boom(1)","    } catch is HarmlessError {","      return","    }","  }","  group.addTask {","    try boom(2, after: .seconds(5))","  }","}"]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingDiscardingTaskGroup(returning:isolation:body:)"},"metadata":{"title":"withThrowingDiscardingTaskGroup(returning:isolation:body:)","externalID":"s:12_Concurrency31withThrowingDis