{"kind":"symbol","seeAlsoSections":[{"title":"Tasks","generated":true,"anchor":"Tasks","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Task","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingTaskGroup(of:returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskPriority","doc:\/\/com.apple.Swift\/documentation\/Swift\/DiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeCurrentTask"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@backDeployed(before: macOS 15.0, iOS 18.0, watchOS 11.0, tvOS 18.0, visionOS 2.0)\n","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"withThrowingDiscardingTaskGroup"},{"kind":"text","text":"<"},{"text":"GroupResult","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"returning","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"returnType","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"GroupResult","preciseIdentifier":"s:12_Concurrency31withThrowingDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdeF0Vys5Error_pGzYaKXEtYaKlF0F6ResultL_xmfp","kind":"typeIdentifier"},{"text":".Type = GroupResult.self, ","kind":"text"},{"text":"isolation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"isolated","kind":"keyword"},{"text":" (","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor","text":"Actor","preciseIdentifier":"s:ScA","kind":"typeIdentifier"},{"text":")? = #isolation, ","kind":"text"},{"text":"body","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","text":"ThrowingDiscardingTaskGroup","preciseIdentifier":"s:12_Concurrency27ThrowingDiscardingTaskGroupV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"GroupResult","preciseIdentifier":"s:12_Concurrency31withThrowingDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdeF0Vys5Error_pGzYaKXEtYaKlF0F6ResultL_xmfp","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"GroupResult","preciseIdentifier":"s:12_Concurrency31withThrowingDiscardingTaskGroup9returning9isolation4bodyxxm_ScA_pSgYixAA0cdeF0Vys5Error_pGzYaKXEtYaKlF0F6ResultL_xmfp","kind":"typeIdentifier"}]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Unlike a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup"},{"type":"text","text":", the child tasks as well as their results are"},{"type":"text","text":" "},{"type":"text","text":"discarded as soon as the tasks complete. This prevents the discarding"},{"type":"text","text":" "},{"type":"text","text":"task group from accumulating many results waiting to be consumed, and is"},{"type":"text","text":" "},{"type":"text","text":"best applied in situations where the result of a child task is some form"},{"type":"text","text":" "},{"type":"text","text":"of side-effect."}],"type":"paragraph"},{"inlineContent":[{"text":"A group ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"always"}]},{"text":" waits for all of its child tasks","type":"text"},{"text":" ","type":"text"},{"text":"to complete before it returns. Even canceled tasks must run until","type":"text"},{"text":" ","type":"text"},{"text":"completion before this function returns.","type":"text"},{"text":" ","type":"text"},{"text":"Canceled child tasks cooperatively react to cancellation and attempt","type":"text"},{"text":" ","type":"text"},{"text":"to return as early as possible.","type":"text"},{"text":" ","type":"text"},{"text":"After this function returns, the task group is always empty.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It is not possible to explicitly await completion of child-tasks,","type":"text"},{"text":" ","type":"text"},{"text":"however the group will automatically await ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"all"}]},{"text":" child task completions","type":"text"},{"text":" ","type":"text"},{"text":"before returning from this function:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["try await withThrowingDiscardingTaskGroup { group in","  group.addTask { \/* slow-task *\/ }","  \/\/ slow-task executes...","}","\/\/ guaranteed that slow-task has completed and the group is empty & destroyed"]},{"inlineContent":[{"text":"Refer to ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference","isActive":true},{"text":" documentation for detailed discussion of semantics shared between all task groups.","type":"text"}],"type":"paragraph"},{"level":1,"type":"heading","text":"Task Group Cancellation","anchor":"Task-Group-Cancellation"},{"inlineContent":[{"text":"You can cancel a task group and all of its child tasks","type":"text"},{"text":" ","type":"text"},{"text":"by calling the ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup\/cancelAll()","type":"reference","isActive":true},{"text":" method on the task group,","type":"text"},{"text":" ","type":"text"},{"text":"or by canceling the task in which the group is running.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you call ","type":"text"},{"code":"addTask(priority:operation:)","type":"codeVoice"},{"text":" to create a new task in a canceled group,","type":"text"},{"text":" ","type":"text"},{"text":"that task is immediately canceled after creation.","type":"text"},{"text":" ","type":"text"},{"text":"Alternatively, you can call ","type":"text"},{"code":"asyncUnlessCancelled(priority:operation:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which doesn’t create the task if the group has already been canceled.","type":"text"},{"text":" ","type":"text"},{"text":"Choosing between these two functions","type":"text"},{"text":" ","type":"text"},{"text":"lets you control how to react to cancellation within a group:","type":"text"},{"text":" ","type":"text"},{"text":"some child tasks need to run regardless of cancellation,","type":"text"},{"text":" ","type":"text"},{"text":"but other tasks are better not even being created","type":"text"},{"text":" ","type":"text"},{"text":"when you know they can’t produce useful results.","type":"text"}],"type":"paragraph"},{"level":1,"text":"Error Handling and Implicit Cancellation","anchor":"Error-Handling-and-Implicit-Cancellation","type":"heading"},{"inlineContent":[{"text":"Since it is not possible to explicitly await individual task completions,","type":"text"},{"text":" ","type":"text"},{"text":"it is also not possible to “re-throw” an error thrown by one of the child","type":"text"},{"type":"text","text":" "},{"text":"tasks using the same pattern as one would in a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ ThrowingTaskGroup, pattern not applicable to ThrowingDiscardingTaskGroup","try await withThrowingTaskGroup(of: Void.self) { group in","  group.addTask { try boom() }","  try await group.next() \/\/ re-throws \"boom\"","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Since discarding task groups don’t have access to ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":", this pattern","type":"text"},{"text":" ","type":"text"},{"text":"cannot be used.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Instead,"},{"type":"text","text":" "},{"text":"a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"throwing discarding task group implicitly cancels itself whenever any","type":"text"},{"text":" ","type":"text"},{"text":"of its child tasks throws","type":"text"}]},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"inlineContent":[{"type":"text","text":"first error"}],"type":"emphasis"},{"type":"text","text":" thrown inside such task group"},{"type":"text","text":" "},{"type":"text","text":"is then retained and thrown"},{"type":"text","text":" "},{"type":"text","text":"out of the "},{"type":"codeVoice","code":"withThrowingDiscardingTaskGroup"},{"text":" method when it returns.","type":"text"}]},{"code":["try await withThrowingDiscardingTaskGroup { group in","  group.addTask { try boom(1) }","  group.addTask { try boom(2, after: .seconds(5)) }","  group.addTask { try boom(3, after: .seconds(5)) }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Generally, this suits the typical use cases of a"},{"type":"text","text":" "},{"text":"discarding task group well, however, if you want to prevent specific","type":"text"},{"text":" ","type":"text"},{"text":"errors from canceling the group you can catch them inside the child","type":"text"},{"text":" ","type":"text"},{"text":"task’s body like this:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["try await withThrowingDiscardingTaskGroup { group in","  group.addTask {","    do {","      try boom(1)","    } catch is HarmlessError {","      return","    }","  }","  group.addTask {","    try boom(2, after: .seconds(5))","  }","}"],"type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swift\/withthrowingdiscardingtaskgroup(returning:isolation:body:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingDiscardingTaskGroup(returning:isolation:body:)","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Function","modules":[{"relatedModules":[],"name":"Swift"}],"platforms":[{"introducedAt":"8.0","name":"iOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"8.0","name":"iPadOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"13.0","name":"Mac Catalyst","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"10.10","name":"macOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"9.0","name":"tvOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"1.0","name":"visionOS","beta":false,"deprecated":false,"unavailable":false},{"introducedAt":"2.0","name":"watchOS","beta":false,"deprecated":false,"unavailable":false}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"withThrowingDiscardingTaskGroup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"GroupResult","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"returning","kind":"externalParam"},{"text":": ","kind":"text"},{"precis