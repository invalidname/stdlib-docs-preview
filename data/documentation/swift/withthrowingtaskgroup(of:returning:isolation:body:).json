ntifier"},{"text":".Type = GroupResult.self, ","kind":"text"},{"text":"isolation","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"keyword","text":"isolated"},{"kind":"text","text":" ("},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Actor","preciseIdentifier":"s:ScA","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor"},{"kind":"text","text":")? = #isolation, "},{"kind":"externalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","text":"ThrowingTaskGroup","kind":"typeIdentifier","preciseIdentifier":"s:Scg"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency21withThrowingTaskGroup2of9returning9isolation4bodyq_xm_q_mScA_pSgYiq_Scgyxs5Error_pGzYaKXEtYaKs8SendableRzr0_lF05ChildD6ResultL_xmfp","text":"ChildTaskResult"},{"kind":"text","text":", "},{"text":"Error","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"},{"kind":"text","text":">) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency21withThrowingTaskGroup2of9returning9isolation4bodyq_xm_q_mScA_pSgYiq_Scgyxs5Error_pGzYaKXEtYaKs8SendableRzr0_lF0E6ResultL_q_mfp","text":"GroupResult"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"GroupResult","preciseIdentifier":"s:12_Concurrency21withThrowingTaskGroup2of9returning9isolation4bodyq_xm_q_mScA_pSgYiq_Scgyxs5Error_pGzYaKXEtYaKs8SendableRzr0_lF0E6ResultL_q_mfp"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"ChildTaskResult"},{"kind":"text","text":" : "},{"text":"Sendable","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"A group "},{"inlineContent":[{"type":"text","text":"always"}],"type":"emphasis"},{"type":"text","text":" waits for all of its child tasks"},{"type":"text","text":" "},{"type":"text","text":"to complete before it returns. Even canceled tasks must run until"},{"type":"text","text":" "},{"type":"text","text":"completion before this function returns."},{"type":"text","text":" "},{"type":"text","text":"Canceled child tasks cooperatively react to cancellation and attempt"},{"type":"text","text":" "},{"type":"text","text":"to return as early as possible."},{"type":"text","text":" "},{"type":"text","text":"After this function returns, the task group is always empty."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To collect the results of the group’s child tasks,"},{"type":"text","text":" "},{"type":"text","text":"you can use a "},{"type":"codeVoice","code":"for"},{"type":"text","text":"-"},{"code":"await","type":"codeVoice"},{"text":"-","type":"text"},{"type":"codeVoice","code":"in"},{"type":"text","text":" loop:"}],"type":"paragraph"},{"code":["var sum = 0","for try await result in group {","    sum += result","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need more control or only a few results,"},{"type":"text","text":" "},{"type":"text","text":"you can call "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" directly:"}]},{"type":"codeListing","syntax":"swift","code":["guard let first = try await group.next() else {","    group.cancelAll()","    return 0","}","let second = await group.next() ?? 0","group.cancelAll()","return first + second"]},{"anchor":"Error-Handling","text":"Error Handling","type":"heading","level":1},{"inlineContent":[{"text":"Throwing an error in one of the child tasks of a task group","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t immediately cancel the other tasks in that group.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"However,"},{"type":"text","text":" "},{"type":"text","text":"throwing out of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" of the "},{"code":"withThrowingTaskGroup","type":"codeVoice"},{"text":" method does cancel","type":"text"},{"text":" ","type":"text"},{"text":"the group, and all of its child tasks.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"if you call "},{"code":"next()","type":"codeVoice"},{"type":"text","text":" in the task group and propagate its error,"},{"type":"text","text":" "},{"type":"text","text":"all other tasks are canceled."},{"text":" ","type":"text"},{"text":"For example, in the code below,","type":"text"},{"text":" ","type":"text"},{"text":"nothing is canceled and the group doesn’t throw an error:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["try await withThrowingTaskGroup(of: Void.self) { group in","    group.addTask { throw SomeError() }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In contrast, this example throws "},{"code":"SomeError","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and cancels all of the tasks in the group:","type":"text"}]},{"type":"codeListing","code":["try await withThrowingTaskGroup(of: Void.self) { group in","    group.addTask { throw SomeError() }","    try await group.next()","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"An individual task throws its error"},{"type":"text","text":" "},{"text":"in the corresponding call to ","type":"text"},{"type":"codeVoice","code":"Group.next()"},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"text","text":"which gives you a chance to handle the individual error"},{"type":"text","text":" "},{"type":"text","text":"or to let the group rethrow the error."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Refer to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup"},{"type":"text","text":" documentation for detailed discussion of semantics shared between all task groups."}]},{"name":"See Also","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference"}]}],"type":"aside"},{"name":"See Also","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","type":"reference"}],"type":"paragraph"}],"style":"note"},{"name":"See Also","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","type":"reference"}]}],"style":"note"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingTaskGroup(of:returning:isolation:body:)"},"references":{"doc://com.apple.Swift/documentation/Swift/withDiscardingTaskGroup(returning:isolation:body:)":{"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swift\/withdiscardingtaskgroup(returning:isolation:body:)","title":"withDiscardingTaskGroup(returning:isolation:body:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardingTaskGroup(returning:isolation:body:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"t