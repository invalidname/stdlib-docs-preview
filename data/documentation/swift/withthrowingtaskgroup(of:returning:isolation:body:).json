d":"keyword"},{"text":" ","kind":"text"},{"text":"ChildTaskResult","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","preciseIdentifier":"s:s8SendableP"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A group "},{"type":"emphasis","inlineContent":[{"text":"always","type":"text"}]},{"type":"text","text":" waits for all of its child tasks"},{"type":"text","text":" "},{"type":"text","text":"to complete before it returns. Even canceled tasks must run until"},{"type":"text","text":" "},{"type":"text","text":"completion before this function returns."},{"type":"text","text":" "},{"text":"Canceled child tasks cooperatively react to cancellation and attempt","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to return as early as possible."},{"type":"text","text":" "},{"type":"text","text":"After this function returns, the task group is always empty."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To collect the results of the group’s child tasks,"},{"text":" ","type":"text"},{"text":"you can use a ","type":"text"},{"code":"for","type":"codeVoice"},{"text":"-","type":"text"},{"type":"codeVoice","code":"await"},{"type":"text","text":"-"},{"type":"codeVoice","code":"in"},{"text":" loop:","type":"text"}]},{"code":["var sum = 0","for try await result in group {","    sum += result","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need more control or only a few results,"},{"type":"text","text":" "},{"type":"text","text":"you can call "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" directly:"}]},{"code":["guard let first = try await group.next() else {","    group.cancelAll()","    return 0","}","let second = await group.next() ?? 0","group.cancelAll()","return first + second"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Error Handling","anchor":"Error-Handling","level":1},{"type":"paragraph","inlineContent":[{"type":"text","text":"Throwing an error in one of the child tasks of a task group"},{"type":"text","text":" "},{"type":"text","text":"doesn’t immediately cancel the other tasks in that group."},{"type":"text","text":" "},{"type":"text","text":"However,"},{"type":"text","text":" "},{"type":"text","text":"throwing out of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" of the "},{"type":"codeVoice","code":"withThrowingTaskGroup"},{"type":"text","text":" method does cancel"},{"type":"text","text":" "},{"type":"text","text":"the group, and all of its child tasks."},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"if you call "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" in the task group and propagate its error,"},{"type":"text","text":" "},{"type":"text","text":"all other tasks are canceled."},{"type":"text","text":" "},{"type":"text","text":"For example, in the code below,"},{"type":"text","text":" "},{"type":"text","text":"nothing is canceled and the group doesn’t throw an error:"}]},{"type":"codeListing","syntax":"swift","code":["try await withThrowingTaskGroup(of: Void.self) { group in","    group.addTask { throw SomeError() }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In contrast, this example throws "},{"type":"codeVoice","code":"SomeError"},{"type":"text","text":" "},{"type":"text","text":"and cancels all of the tasks in the group:"}]},{"type":"codeListing","syntax":"swift","code":["try await withThrowingTaskGroup(of: Void.self) { group in","    group.addTask { throw SomeError() }","    try await group.next()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An individual task throws its error"},{"type":"text","text":" "},{"type":"text","text":"in the corresponding call to "},{"type":"codeVoice","code":"Group.next()"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which gives you a chance to handle the individual error"},{"type":"text","text":" "},{"type":"text","text":"or to let the group rethrow the error."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Refer to "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","isActive":true},{"type":"text","text":" documentation for detailed discussion of semantics shared between all task groups."}]},{"content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","type":"reference","isActive":true}],"type":"paragraph"}],"type":"aside","style":"note","name":"See Also"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","type":"reference"}],"type":"paragraph"}],"type":"aside","style":"note","name":"See Also"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","type":"reference","isActive":true}],"type":"paragraph"}],"type":"aside","style":"note","name":"See Also"}]}],"abstract":[{"type":"text","text":"Starts a new scope that can contain a dynamic number of throwing child tasks."}],"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/withDiscardingTaskGroup(returning:isolation:body:)":{"abstract":[{"text":"Starts a new scope that can contain a dynamic number of child tasks.","type":"text"}],"role":"symbol","url":"\/documentation\/swift\/withdiscardingtaskgroup(returning:isolation:body:)","title":"withDiscardingTaskGroup(returning:isolation:body:)","type":"topic","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withDiscardi