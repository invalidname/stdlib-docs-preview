:"keyword","text":"any"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Actor","preciseIdentifier":"s:ScA","text":"Actor"},{"kind":"text","text":")? = #isolation, "},{"kind":"externalParam","text":"body"},{"kind":"text","text":": ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","preciseIdentifier":"s:Scg","text":"ThrowingTaskGroup"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency21withThrowingTaskGroup2of9returning9isolation4bodyq_xm_q_mScA_pSgYiq_Scgyxs5Error_pGzYaKXEtYaKs8SendableRzr0_lF05ChildD6ResultL_xmfp","text":"ChildTaskResult"},{"kind":"text","text":", "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","preciseIdentifier":"s:s5ErrorP","text":"Error"},{"kind":"text","text":">) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency21withThrowingTaskGroup2of9returning9isolation4bodyq_xm_q_mScA_pSgYiq_Scgyxs5Error_pGzYaKXEtYaKs8SendableRzr0_lF0E6ResultL_q_mfp","text":"GroupResult"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency21withThrowingTaskGroup2of9returning9isolation4bodyq_xm_q_mScA_pSgYiq_Scgyxs5Error_pGzYaKXEtYaKs8SendableRzr0_lF0E6ResultL_q_mfp","text":"GroupResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"ChildTaskResult"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"A group "},{"inlineContent":[{"type":"text","text":"always"}],"type":"emphasis"},{"type":"text","text":" waits for all of its child tasks"},{"type":"text","text":" "},{"type":"text","text":"to complete before it returns. Even canceled tasks must run until"},{"type":"text","text":" "},{"type":"text","text":"completion before this function returns."},{"type":"text","text":" "},{"type":"text","text":"Canceled child tasks cooperatively react to cancellation and attempt"},{"type":"text","text":" "},{"type":"text","text":"to return as early as possible."},{"type":"text","text":" "},{"type":"text","text":"After this function returns, the task group is always empty."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To collect the results of the group’s child tasks,"},{"type":"text","text":" "},{"type":"text","text":"you can use a "},{"type":"codeVoice","code":"for"},{"type":"text","text":"-"},{"type":"codeVoice","code":"await"},{"type":"text","text":"-"},{"type":"codeVoice","code":"in"},{"type":"text","text":" loop:"}],"type":"paragraph"},{"code":["var sum = 0","for try await result in group {","    sum += result","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"If you need more control or only a few results,"},{"type":"text","text":" "},{"type":"text","text":"you can call "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" directly:"}],"type":"paragraph"},{"code":["guard let first = try await group.next() else {","    group.cancelAll()","    return 0","}","let second = await group.next() ?? 0","group.cancelAll()","return first + second"],"syntax":"swift","type":"codeListing"},{"level":1,"text":"Error Handling","anchor":"Error-Handling","type":"heading"},{"inlineContent":[{"type":"text","text":"Throwing an error in one of the child tasks of a task group"},{"type":"text","text":" "},{"type":"text","text":"doesn’t immediately cancel the other tasks in that group."},{"type":"text","text":" "},{"type":"text","text":"However,"},{"type":"text","text":" "},{"type":"text","text":"throwing out of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" of the "},{"type":"codeVoice","code":"withThrowingTaskGroup"},{"type":"text","text":" method does cancel"},{"type":"text","text":" "},{"type":"text","text":"the group, and all of its child tasks."},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"if you call "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" in the task group and propagate its error,"},{"type":"text","text":" "},{"type":"text","text":"all other tasks are canceled."},{"type":"text","text":" "},{"type":"text","text":"For example, in the code below,"},{"type":"text","text":" "},{"type":"text","text":"nothing is canceled and the group doesn’t throw an error:"}],"type":"paragraph"},{"code":["try await withThrowingTaskGroup(of: Void.self) { group in","    group.addTask { throw SomeError() }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"In contrast, this example throws "},{"type":"codeVoice","code":"SomeError"},{"type":"text","text":" "},{"type":"text","text":"and cancels all of the tasks in the group:"}],"type":"paragraph"},{"code":["try await withThrowingTaskGroup(of: Void.self) { group in","    group.addTask { throw SomeError() }","    try await group.next()","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"An individual task throws its error"},{"type":"text","text":" "},{"type":"text","text":"in the corresponding call to "},{"type":"codeVoice","code":"Group.next()"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which gives you a chance to handle the individual error"},{"type":"text","text":" "},{"type":"text","text":"or to let the group rethrow the error."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Refer to "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","isActive":true,"type":"reference"},{"type":"text","text":" documentation for detailed discussion of semantics shared between all task groups."}],"type":"paragraph"},{"name":"See Also","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup"}],"type":"paragraph"}],"type":"aside"},{"name":"See Also","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup"}],"type":"paragraph"}],"type":"aside"},{"name":"See Also","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup"}],"type":"paragraph"}],"type":"aside"}]}],"abstract":[{"type":"text","text":"Starts a new scope that can contain a dynamic number of throwing child tasks."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/withthrowingtaskgroup(of:returning:isolation:body:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/withThrowingTaskGroup(of:returning:isolation:body:)"},"kind":"symbol","references":{"doc://com.apple.Swift/documentation/Swift/Sendable":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sendable"}],"navigatorTitle":[{"kind":"identifier","text":"Sendable"}],"type":"topic","abstract":[{"text":"A thread-safe type whose values can be shared across arbitrary concurrent","type":"text"},{"text":" ","type":"text"},{"text":"contexts without introducing a risk of data races.","type":"text"}],"title