) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"GroupResult","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency21withThrowingTaskGroup2of9returning9isolation4bodyq_xm_q_mScA_pSgYiq_Scgyxs5Error_pGzYaKXEtYaKs8SendableRzr0_lF0E6ResultL_q_mfp"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ChildTaskResult","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","preciseIdentifier":"s:s8SendableP"}]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"A group ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"always","type":"text"}]},{"text":" waits for all of its child tasks","type":"text"},{"text":" ","type":"text"},{"text":"to complete before it returns. Even canceled tasks must run until","type":"text"},{"text":" ","type":"text"},{"text":"completion before this function returns.","type":"text"},{"text":" ","type":"text"},{"text":"Canceled child tasks cooperatively react to cancellation and attempt","type":"text"},{"text":" ","type":"text"},{"text":"to return as early as possible.","type":"text"},{"text":" ","type":"text"},{"text":"After this function returns, the task group is always empty.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To collect the results of the group’s child tasks,","type":"text"},{"text":" ","type":"text"},{"text":"you can use a ","type":"text"},{"type":"codeVoice","code":"for"},{"text":"-","type":"text"},{"type":"codeVoice","code":"await"},{"text":"-","type":"text"},{"type":"codeVoice","code":"in"},{"text":" loop:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var sum = 0","for try await result in group {","    sum += result","}"]},{"type":"paragraph","inlineContent":[{"text":"If you need more control or only a few results,","type":"text"},{"text":" ","type":"text"},{"text":"you can call ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" directly:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["guard let first = try await group.next() else {","    group.cancelAll()","    return 0","}","let second = await group.next() ?? 0","group.cancelAll()","return first + second"]},{"level":1,"text":"Error Handling","type":"heading","anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"text":"Throwing an error in one of the child tasks of a task group","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t immediately cancel the other tasks in that group.","type":"text"},{"text":" ","type":"text"},{"text":"However,","type":"text"},{"text":" ","type":"text"},{"text":"throwing out of the ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" of the ","type":"text"},{"type":"codeVoice","code":"withThrowingTaskGroup"},{"text":" method does cancel","type":"text"},{"text":" ","type":"text"},{"text":"the group, and all of its child tasks.","type":"text"},{"text":" ","type":"text"},{"text":"For example,","type":"text"},{"text":" ","type":"text"},{"text":"if you call ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" in the task group and propagate its error,","type":"text"},{"text":" ","type":"text"},{"text":"all other tasks are canceled.","type":"text"},{"text":" ","type":"text"},{"text":"For example, in the code below,","type":"text"},{"text":" ","type":"text"},{"text":"nothing is canceled and the group doesn’t throw an error:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["try await withThrowingTaskGroup(of: Void.self) { group in","    group.addTask { throw SomeError() }","}"]},{"type":"paragraph","inlineContent":[{"text":"In contrast, this example throws ","type":"text"},{"type":"codeVoice","code":"SomeError"},{"text":" ","type":"text"},{"text":"and cancels all of the tasks in the group:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["try await withThrowingTaskGroup(of: Void.self) { group in","    group.addTask { throw SomeError() }","    try await group.next()","}"]},{"inlineContent":[{"text":"An individual task throws its error","type":"text"},{"text":" ","type":"text"},{"text":"in the corresponding call to ","type":"text"},{"type":"codeVoice","code":"Group.next()"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which gives you a chance to handle the individual error","type":"text"},{"text":" ","type":"text"},{"text":"or to let the group rethrow the error.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Refer to ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","isActive":true,"type":"reference"},{"text":" documentation for detailed discussion of semantics shared between all task groups.","type":"text"}],"type":"paragraph"},{"type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","isActive":true}]}],"style":"note"},{"type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","isActive":true}]}],"style":"note"},{"type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingDiscardingTaskGroup","isActive":true}]}],"style":"note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/withthrowingtaskgroup(of:returning:isolation:body:)"]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"metadata":{"externalID":"s:12_