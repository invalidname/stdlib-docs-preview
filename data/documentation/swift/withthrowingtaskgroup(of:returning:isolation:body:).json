ind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ThrowingTaskGroup","text":"ThrowingTaskGroup","preciseIdentifier":"s:Scg"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"ChildTaskResult","preciseIdentifier":"s:12_Concurrency21withThrowingTaskGroup2of9returning9isolation4bodyq_xm_q_mScA_pSgYiq_Scgyxs5Error_pGzYaKXEtYaKs8SendableRzr0_lF05ChildD6ResultL_xmfp"},{"kind":"text","text":", "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Error","text":"Error","preciseIdentifier":"s:s5ErrorP"},{"kind":"text","text":">) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"GroupResult","preciseIdentifier":"s:12_Concurrency21withThrowingTaskGroup2of9returning9isolation4bodyq_xm_q_mScA_pSgYiq_Scgyxs5Error_pGzYaKXEtYaKs8SendableRzr0_lF0E6ResultL_q_mfp"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"GroupResult","preciseIdentifier":"s:12_Concurrency21withThrowingTaskGroup2of9returning9isolation4bodyq_xm_q_mScA_pSgYiq_Scgyxs5Error_pGzYaKXEtYaKs8SendableRzr0_lF0E6ResultL_q_mfp"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"ChildTaskResult"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","text":"Sendable","preciseIdentifier":"s:s8SendableP"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A group "},{"type":"emphasis","inlineContent":[{"type":"text","text":"always"}]},{"type":"text","text":" waits for all of its child tasks"},{"type":"text","text":" "},{"type":"text","text":"to complete before it returns. Even canceled tasks must run until"},{"type":"text","text":" "},{"type":"text","text":"completion before this function returns."},{"type":"text","text":" "},{"type":"text","text":"Canceled child tasks cooperatively react to cancellation and attempt"},{"type":"text","text":" "},{"type":"text","text":"to return as early as possible."},{"type":"text","text":" "},{"type":"text","text":"After this function returns, the task group is always empty."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To collect the results of the group’s child tasks,"},{"type":"text","text":" "},{"type":"text","text":"you can use a "},{"type":"codeVoice","code":"for"},{"type":"text","text":"-"},{"type":"codeVoice","code":"await"},{"type":"text","text":"-"},{"type":"codeVoice","code":"in"},{"type":"text","text":" loop:"}]},{"syntax":"swift","type":"codeListing","code":["var sum = 0","for try await result in group {","    sum += result","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need more control or only a few results,"},{"type":"text","text":" "},{"type":"text","text":"you can call "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" directly:"}]},{"syntax":"swift","type":"codeListing","code":["guard let first = try await group.next() else {","    group.cancelAll()","    return 0","}","let second = await group.next() ?? 0","group.cancelAll()","return first + second"]},{"anchor":"Error-Handling","level":1,"type":"heading","text":"Error Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Throwing an error in one of the child tasks of a task group"},{"type":"text","text":" "},{"type":"text","text":"doesn’t immediately cancel the other tasks in that group."},{"type":"text","text":" "},{"type":"text","text":"However,"},{"type":"text","text":" "},{"type":"text","text":"throwing out of the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" of the "},{"type":"codeVoice","code":"withThrowingTaskGroup"},{"type":"text","text":" method does cancel"},{"type":"text","text":" "},{"type":"text","text":"the group, and all of its child tasks."},{"type":"text","text":" "},{"type":"text","text":"For example,"},{"type":"text","text":" "},{"type":"text","text":"if you call "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" in the task group and propagate its error,"},{"type":"text","text":" "},{"type":"text","text":"all other tasks are canceled."},{"type":"text","text":" "},{"type":"text","text":"For example, in the code below,"},{"type":"text","text":" "},{"type":"text","text":"nothing is canceled and the group doesn’t throw an error:"}]},{"syntax":"swift","type":"codeListing","code":["try await withThrowingTaskGroup(of: Void.self) { group in","    group.addTask { throw SomeError() }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In contrast, this example throws "},{"type":"codeVoice","code":"SomeError"},{"type":"text","text":" "},{"type":"text","text":"and cancels all of the tasks in the group:"}]},{"syntax":"swift","type":"codeListing","code":["try await withThrowingTaskGroup(of: Void.self) { group in","    group.addTask { throw SomeError() }","    try await group.next()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An individual task throws its error"},{"text":" ","type":"text"},{"text":"in the corresponding call to ","type":"text"},{"code":"Group.next()","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which gives you a chance to handle the individual error","type":"text"},{"text":" ","type":"text"},{"text":"or to let the group rethrow the error.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Refer to ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/TaskGroup","isActive":true,"type":"reference"},{"text":" documentation for detailed discussion of semantics shared between all task groups.","type":"text"}]},{"style"