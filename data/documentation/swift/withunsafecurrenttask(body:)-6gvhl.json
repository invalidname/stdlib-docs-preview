ext":" closure."}]}],"kind":"content"},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"If you call this function from the body of an asynchronous function,","type":"text"},{"text":" ","type":"text"},{"text":"the unsafe task handle passed to the closure is always non-","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" "},{"type":"text","text":"because an asynchronous function always runs in the context of a task."},{"type":"text","text":" "},{"type":"text","text":"However, if you call this function from the body of a synchronous function,"},{"text":" ","type":"text"},{"text":"and that function isn’t executing in the context of any task,","type":"text"},{"type":"text","text":" "},{"text":"the unsafe task handle is ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storing an unsafe reference to a task doesn’t affect the task’s actual life cycle,"},{"text":" ","type":"text"},{"text":"and the behavior of accessing an unsafe task reference","type":"text"},{"text":" ","type":"text"},{"text":"outside of the ","type":"text"},{"type":"codeVoice","code":"withUnsafeCurrentTask(body:)"},{"type":"text","text":" method’s closure is unsafe and undefined behavior."},{"type":"text","text":" "},{"type":"text","text":"There’s no safe way to retrieve a reference to the current task"},{"type":"text","text":" "},{"type":"text","text":"and save it for long-term use."},{"type":"text","text":" "},{"type":"text","text":"To query the current task without saving a reference to it,"},{"type":"text","text":" "},{"type":"text","text":"use properties like "},{"type":"codeVoice","code":"currentPriority"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If you need to store a reference to a task,"},{"type":"text","text":" "},{"type":"text","text":"create an unstruct