Content":[{"type":"text","text":"Missing to invoke it (eventually) will cause the calling task to remain suspended"},{"type":"text","text":" "},{"type":"text","text":"indefinitely which will result in the task “hanging” as well as being leaked with"},{"type":"text","text":" "},{"type":"text","text":"no possibility to destroy it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike the “checked” continuation variant, the "},{"code":"UnsafeContinuation","type":"codeVoice"},{"type":"text","text":" does not"},{"type":"text","text":" "},{"type":"text","text":"detect or diagnose any kind of misuse, so you need to be extra careful to avoid"},{"type":"text","text":" "},{"type":"text","text":"calling "},{"code":"resume","type":"codeVoice"},{"type":"text","text":" twice or forgetting to call resume before letting go of the"},{"type":"text","text":" "},{"type":"text","text":"continuation object."}]},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"withUnsafeContinuation(function:_:)"}],"type":"paragraph"}],"type":"aside","style":"note","name":"See Also"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"withCheckedContinuation(function:_:)"}]}],"type":"aside","style":"note","name":"See Also"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"withCheckedThrowingContinuation(function:_:)"}]}],"type":"aside","style":"note","name":"See Also"}]}],"variants":[{"paths":["\/documentation\/swift\/withunsafethrowingcontinuation(isolation:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift"]]},"metadata":{"externalID":"s:12_Concurrency30withUnsafeThrowingContinuation9isolation_xScA_pSgYi_ySccyxs5Error_pGXEtYaKlF","roleHeading":"Function","symbolKind":"func","platforms":[{"beta":false,"name":"iOS","deprecated":false,"introducedAt":"8.0","unavailable":