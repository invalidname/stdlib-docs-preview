{"seeAlsoSections":[{"title":"Representing a Result","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)"],"generated":true,"anchor":"Representing-a-Result"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","abstract":[{"text":"Vend results as part of an API when you can’t return errors synchronously.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/writing-failable-asynchronous-apis"]}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"When writing a function, method, or other API that might fail, you use the "},{"code":"throws","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"keyword on the declaration to indicate that the API call can throw an error. However,"},{"type":"text","text":" "},{"type":"text","text":"you can’t use the "},{"code":"throws","type":"codeVoice"},{"type":"text","text":" keyword to model APIs that return asynchronously. Instead,"},{"type":"text","text":" "},{"type":"text","text":"use the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result","type":"reference","isActive":true},{"type":"text","text":" enumeration to capture information about whether an asychronous"},{"type":"text","text":" "},{"type":"text","text":"call succeeds or fails, and use the associated values for the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)","type":"reference","isActive":true},{"type":"text","text":" cases to carry information about the result of the"},{"type":"text","text":" "},{"type":"text","text":"call."}],"type":"paragraph"},{"type":"heading","anchor":"Return-Result-Instances-Asynchronously","level":3,"text":"Return Result Instances Asynchronously"},{"inlineContent":[{"type":"text","text":"The following example models an asynchronous source of random numbers. The "},{"type":"codeVoice","code":"fetchRemoteRandomNumber(completion:)"},{"type":"text","text":" "},{"type":"text","text":"method returns "},{"type":"codeVoice","code":"Void"},{"type":"text","text":" synchronously, and asynchronously calls a completion handler"},{"type":"text","text":" "},{"type":"text","text":"with a "},{"code":"Result<Int, EntropyError>","type":"codeVoice"},{"type":"text","text":" instance that contains either a random result"},{"type":"text","text":" "},{"type":"text","text":"or information about the failure."}],"type":"paragraph"},{"type":"codeListing","code":["let queue = DispatchQueue(label: \"com.example.queue\")","","enum EntropyError: Error {","    case entropyDepleted","}","","struct AsyncRandomGenerator {","    static let entropyLimit = 5","    var count = 0","","    mutating func fetchRemoteRandomNumber(","        completion: @escaping (Result<Int, EntropyError>) -> Void","    ) {","        let result: Result<Int, EntropyError>","        if count < AsyncRandomGenerator.entropyLimit {","            \/\/ Produce numbers until reaching the entropy limit.","            result = .success(Int.random(in: 1...100))","        } else {","            \/\/ Supply a failure reason when the caller hits the limit.","            result = .failure(.entropyDepleted)","        }","","        count += 1","","        \/\/ Delay to simulate an asynchronous source of entropy.","        queue.asyncAfter(deadline: .now() + 2) {","            completion(result)","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Users of your remote random number generator can decide how to handle both the success"},{"type":"text","text":" "},{"type":"text","text":"and failure cases:"}],"type":"paragraph"},{"type":"codeListing","code":["var generator = AsyncRandomGenerator()","","\/\/ Request one more number than the limit to trigger a failure.","(0..<AsyncRandomGenerator.entropyLimit + 1).forEach { _ in","    generator.fetchRemoteRandomNumber { result in","        switch result {","        case .success(let number):","            print(number)","        case .failure(let error):","            print(\"Source of randomness failed: \\(error)\")","        }","    }","}","","print(\"Waiting on some numbers.\")","","dispatchMain()","\/* Prints:","success(29)","success(46)","success(85)","success(39)","success(84)","Source of randomness failed: entropyDepleted","*\/"],"syntax":"swift"}],"kind":"content"}],"sections":[],"metadata":{"role":"article","title":"Writing Failable Asynchronous APIs","modules":[{"name":"Swift"}],"roleHeading":"Article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/writing-failable-asynchronous-apis"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","doc:\/\/com.apple.Swift\/documentation\/Swift\/numbers-and-basic-values","doc:\/\/com.apple.Swift\/documentation\/Swift\/Result"]]},"references":{"doc://com.apple.Swift/documentation/Swift/swift-standard-library":{"title":"Swift Standard Library","type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","role":"collectionGroup","abstract":[{"text":"Solve complex problems and write high-performance, readable code.","type":"text"}],"kind":"article","url":"\/documentation\/swift\/swift-standard-library"},"doc://com.apple.Swift/documentation/Swift/Result/failure(_:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"failure","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Failure","kind":"typeIdentifier","preciseIdentifier":"s:s6ResultOsRi_zRi0_zrlE7Failureq_mfp"},{"text":")","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"A failure, storing a "},{"code":"Failure","type":"codeVoice"},{"type":"text","text":" value."}],"role":"symbol","url":"\/documentation\/swift\/result\/failure(_:)","type":"topic","title":"Result.failure(_:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)"},"doc://com.apple.Swift/documentation/Swift/numbers-and-basic-values":{"type":"topic","abstract":[{"text":"Model data with numbers, Boolean values, and other fundamental types.","type":"text"}],"title":"Numbers and Basic Values","role":"collectionGroup","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/numbers-and-basic-values","kind":"article","url":"\/documentation\/swift\/numbers-and-basic-values"},"doc://com.apple.Swift/documentation/Swift/Result":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Result","kind":"identifier"}],"navigatorTitle":[{"text":"Result","kind":"identifier"}],"type":"topic","abstract":[{"text":"A value that represents either a success or a failure, including an","type":"text"},{"text":" ","type":"text"},{"text":"associated value in each case.","type":"text"}],"title":"Result","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result","kind":"symbol","url":"\/documentation\/swift\/result"},"doc://com.apple.Swift/documentation/Swift/Result/success(_:)":{"role":"symbol","title":"Result.success(_:)","abstract":[{"type":"text","text":"A success, storing a "},{"code":"Success","type":"codeVoice"},{"type":"text","text":" value."}],"url":"\/documentation\/swift\/result\/success(_:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"success","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Success","kind":"typeIdentifier","preciseIdentifier":"s:s6ResultOsRi_zRi0_zrlE7Successxmfp"},{"text":")","kind":"text"}],"type":"topic","kind":"symbol"},"d