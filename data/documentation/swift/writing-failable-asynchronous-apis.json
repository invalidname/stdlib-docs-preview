{"abstract":[{"text":"Vend results as part of an API when you can’t return errors synchronously.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/writing-failable-asynchronous-apis"]}],"metadata":{"roleHeading":"Article","role":"article","title":"Writing Failable Asynchronous APIs","modules":[{"name":"Swift"}]},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","doc:\/\/com.apple.Swift\/documentation\/Swift\/numbers-and-basic-values","doc:\/\/com.apple.Swift\/documentation\/Swift\/Result"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"When writing a function, method, or other API that might fail, you use the "},{"type":"codeVoice","code":"throws"},{"type":"text","text":" "},{"type":"text","text":"keyword on the declaration to indicate that the API call can throw an error. However,"},{"type":"text","text":" "},{"type":"text","text":"you can’t use the "},{"type":"codeVoice","code":"throws"},{"type":"text","text":" keyword to model APIs that return asynchronously. Instead,"},{"type":"text","text":" "},{"type":"text","text":"use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result"},{"type":"text","text":" enumeration to capture information about whether an asychronous"},{"type":"text","text":" "},{"type":"text","text":"call succeeds or fails, and use the associated values for the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)"},{"type":"text","text":" cases to carry information about the result of the"},{"type":"text","text":" "},{"type":"text","text":"call."}],"type":"paragraph"},{"text":"Return Result Instances Asynchronously","level":3,"type":"heading","anchor":"Return-Result-Instances-Asynchronously"},{"inlineContent":[{"type":"text","text":"The following example models an asynchronous source of random numbers. The "},{"type":"codeVoice","code":"fetchRemoteRandomNumber(completion:)"},{"type":"text","text":" "},{"type":"text","text":"method returns "},{"type":"codeVoice","code":"Void"},{"type":"text","text":" synchronously, and asynchronously calls a completion handler"},{"type":"text","text":" "},{"type":"text","text":"with a "},{"type":"codeVoice","code":"Result<Int, EntropyError>"},{"type":"text","text":" instance that contains either a random result"},{"type":"text","text":" "},{"type":"text","text":"or information about the failure."}],"type":"paragraph"},{"code":["let queue = DispatchQueue(label: \"com.example.queue\")","","enum EntropyError: Error {","    case entropyDepleted","}","","struct AsyncRandomGenerator {","    static let entropyLimit = 5","    var count = 0","","    mutating func fetchRemoteRandomNumber(","        completion: @escaping (Result<Int, EntropyError>) -> Void","    ) {","        let result: Result<Int, EntropyError>","        if count < AsyncRandomGenerator.entropyLimit {","            \/\/ Produce numbers until reaching the entropy limit.","            result = .success(Int.random(in: 1...100))","        } else {","            \/\/ Supply a failure reason when the caller hits the limit.","            result = .failure(.entropyDepleted)","        }","","        count += 1","","        \/\/ Delay to simulate an asynchronous source of entropy.","        queue.asyncAfter(deadline: .now() + 2) {","            completion(result)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Users of your remote random number generator can decide how to handle both the success"},{"type":"text","text":" "},{"type":"text","text":"and failure cases:"}],"type":"paragraph"},{"code":["var generator = AsyncRandomGenerator()","","\/\/ Request one more number than the limit to trigger a failure.","(0..<AsyncRandomGenerator.entropyLimit + 1).forEach { _ in","    generator.fetchRemoteRandomNumber { result in","        switch result {","        case .success(let number):","            print(number)","        case .failure(let error):","            print(\"Source of randomness failed: \\(error)\")","        }","    }","}","","print(\"Waiting on some numbers.\")","","dispatchMain()","\/* Prints:","success(29)","success(46)","success(85)","success(39)","success(84)","Source of randomness failed: entropyDepleted","*\/"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"seeAlsoSections":[{"anchor":"Representing-a-Result","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)"],"generated":true,"title":"Representing a Result"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/writing-failable-asynchronous-apis"},"sections":[],"kind":"article","references":{"doc://com.apple.Swift/documentation/Swift/Result":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Result","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Result","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result","abstract":[{"type":"text","text":"A value that represents either a success or a failure, including an"},{"type":"text","text":" "},{"type":"text","text":"associated value in each case."}],"url":"\/documentation\/swift\/result","title":"Result","kind":"symbol","role":"symbol"},"doc://com.apple.Swift/documentation/Swift/Result/success(_:)":{"type":"topic","abstract":[{"text":"A success, storing a ","type":"text"},{"code":"Success","type":"codeVoice"},{"text":" value.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","title":"Result.success(_:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"text":"success","kind":"identifier"},{"kind":"text","text":"("},{"preciseIdentifier":"s:s6ResultOsRi_zRi0_zrlE7Successxmfp","text":"Success","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/swift\/result\/success(_:)"},"doc://com.apple.Swift/documentation/Swift/numbers-and-basic-values":{"kind":"article","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/numbers-and-basic-values","title":"Numbers and Basic Values","abstract":[{"type":"text","text":"Model data with numbers, Boolean values, and other fundamental types."}],"type":"topic","role":"collectionGroup","url":"\/documentation\/swift\/numbers-and-basic-values"},"doc://com.apple.Swift/documentation/Swift/Result/failure(_:)":{"type":"topic","abstract":[{"type":"text","text":"A failure, storing a "},{"code":"Failure","type":"codeVoice"},{"text":" value.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)","title":"Result.failure(_:)","kind":"symbol","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"failure"},{"kind":"text","text":"("},{"text":"Failure","preciseIdentifier":"s:s6ResultOsRi_zRi0_zrlE7Failureq_mfp","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/swift\/result\/failure(_:)"},"doc://com.apple.Swift/documentation/Swift":{"role":"collection","abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","title":"Swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","type":"topic","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/swift-standard-library":{"abstract":[{"type":"text","text":"Solve complex problems and write high-performance, readable code."}],"type":"topic","kind":"article","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","url":"\/documentation\/swift\/swift-standard-library","title":"Swift Standard Library","role":"collectionGroup"}}}