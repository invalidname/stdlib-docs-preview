{"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/writing-failable-asynchronous-apis","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swift\/writing-failable-asynchronous-apis"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/numbers-and-basic-values","doc:\/\/com.apple.Swift\/documentation\/Swift\/Result"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Vend results as part of an API when you can’t return errors synchronously."}],"metadata":{"title":"Writing Failable Asynchronous APIs","modules":[{"name":"Standard Library"}],"roleHeading":"Article","role":"article"},"seeAlsoSections":[{"generated":true,"title":"Representing a Result","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)"],"anchor":"Representing-a-Result"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When writing a function, method, or other API that might fail, you use the "},{"type":"codeVoice","code":"throws"},{"type":"text","text":" "},{"type":"text","text":"keyword on the declaration to indicate that the API call can throw an error. However,"},{"type":"text","text":" "},{"type":"text","text":"you can’t use the "},{"type":"codeVoice","code":"throws"},{"type":"text","text":" keyword to model APIs that return asynchronously. Instead,"},{"type":"text","text":" "},{"type":"text","text":"use the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result","type":"reference","isActive":true},{"type":"text","text":" enumeration to capture information about whether an asychronous"},{"type":"text","text":" "},{"type":"text","text":"call succeeds or fails, and use the associated values for the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)","type":"reference","isActive":true},{"type":"text","text":" cases to carry information about the result of the"},{"type":"text","text":" "},{"type":"text","text":"call."}]},{"type":"heading","text":"Return Result Instances Asynchronously","anchor":"Return-Result-Instances-Asynchronously","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example models an asynchronous source of random numbers. The "},{"code":"fetchRemoteRandomNumber(completion:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"method returns ","type":"text"},{"code":"Void","type":"codeVoice"},{"type":"text","text":" synchronously, and asynchronously calls a completion handler"},{"type":"text","text":" "},{"type":"text","text":"with a "},{"type":"codeVoice","code":"Result<Int, EntropyError>"},{"type":"text","text":" instance that contains either a random result"},{"type":"text","text":" "},{"type":"text","text":"or information about the failure."}]},{"type":"codeListing","syntax":"swift","code":["let queue = DispatchQueue(label: \"com.example.queue\")","","enum EntropyError: Error {","    case entropyDepleted","}","","struct AsyncRandomGenerator {","    static let entropyLimit = 5","    var count = 0","","    mutating func fetchRemoteRandomNumber(","        completion: @escaping (Result<Int, EntropyError>) -> Void","    ) {","        let result: Result<Int, EntropyError>","        if count < AsyncRandomGenerator.entropyLimit {","            \/\/ Produce numbers until reaching the entropy limit.","            result = .success(Int.random(in: 1...100))","        } else {","            \/\/ Supply a failure reason when the caller hits the limit.","            result = .failure(.entropyDepleted)","        }","","        count += 1","","        \/\/ Delay to simulate an asynchronous source of entropy.","        queue.asyncAfter(deadline: .now() + 2) {","            completion(result)","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"Users of your remote random number generator can decide how to handle both the success"},{"type":"text","text":" "},{"type":"text","text":"and failure cases:"}],"type":"paragraph"},{"syntax":"swift","code":["var generator = AsyncRandomGenerator()","","\/\/ Request one more number than the limit to trigger a failure.","(0..<AsyncRandomGenerator.entropyLimit + 1).forEach { _ in","    generator.fetchRemoteRandomNumber { result in","        switch result {","        case .success(let number):","            print(number)","        case .failure(let error):","            print(\"Source of randomness failed: \\(error)\")","        }","    }","}","","print(\"Waiting on some numbers.\")","","dispatchMain()","\/* Prints:","success(29)","success(46)","success(85)","success(39)","success(84)","Source of randomness failed: entropyDepleted","*\/"],"type":"codeListing"}]}],"kind":"article","references":{"doc://com.apple.Swift/documentation/Swift/Result":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Result","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result","url":"\/documentation\/swift\/result","abstract":[{"type":"text","text":"A value that represents either a success or a failure, including an"},{"type":"text","text":" "},{"type":"text","text":"associated value in each case."}],"title":"Result","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Result","kind":"identifier"}],"role":"symbol"},"doc://com.apple.Swift/documentation/Swift/numbers-and-basic-values":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/numbers-and-basic-values","kind":"article","abstract":[{"text":"Model data with numbers, Boolean values, and other fundamental types.","type":"text"}],"title":"Numbers and Basic Values","role":"collectionGroup","url":"\/documentation\/swift\/numbers-and-basic-values"},"doc://com.apple.Swift/documentation/Swift/Result/failure(_:)":{"title":"Result.failure(_:)","url":"\/documentation\/swift\/result\/failure(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"text":"failure","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Failure","kind":"typeIdentifier","preciseIdentifier":"s:s6ResultOsRi_zRi0_zrlE7Failureq_mfp"},{"kind":"text","text":")"}],"role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A failure, storing a "},{"type":"codeVoice","code":"Failure"},{"text":" value.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/Result/success(_:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","url":"\/documentation\/swift\/result\/success(_:)","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A success, storing a "},{"type":"codeVoice","code":"Success"},{"type":"text","text":" value."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"success","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Success","kind":"typeIdentifier","preciseIdentifier":"s:s6ResultOsRi_zRi0_zrlE7Successxmfp"},{"text":")","kind":"text"}],"title":"Result.success(_:)"},"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","url":"\/documentation\/swift","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"title":"Standard Library","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"role":"collection"}}}