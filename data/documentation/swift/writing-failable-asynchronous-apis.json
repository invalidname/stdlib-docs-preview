cumentation/Swift/Result":{"navigatorTitle":[{"kind":"identifier","text":"Result"}],"url":"\/documentation\/swift\/result","abstract":[{"type":"text","text":"A value that represents either a success or a failure, including an"},{"type":"text","text":" "},{"type":"text","text":"associated value in each case."}],"kind":"symbol","title":"Result","role":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Result"}]}}}