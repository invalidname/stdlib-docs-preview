{"abstract":[{"type":"text","text":"Vend results as part of an API when you can’t return errors synchronously."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/numbers-and-basic-values","doc:\/\/com.apple.Swift\/documentation\/Swift\/Result"]]},"sections":[],"metadata":{"title":"Writing Failable Asynchronous APIs","modules":[{"name":"Standard Library"}],"roleHeading":"Article","role":"article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/writing-failable-asynchronous-apis"]}],"kind":"article","seeAlsoSections":[{"title":"Representing a Result","anchor":"Representing-a-Result","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)"]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/writing-failable-asynchronous-apis","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"When writing a function, method, or other API that might fail, you use the "},{"type":"codeVoice","code":"throws"},{"type":"text","text":" "},{"type":"text","text":"keyword on the declaration to indicate that the API call can throw an error. However,"},{"type":"text","text":" "},{"type":"text","text":"you can’t use the "},{"type":"codeVoice","code":"throws"},{"type":"text","text":" keyword to model APIs that return asynchronously. Instead,"},{"type":"text","text":" "},{"type":"text","text":"use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result"},{"type":"text","text":" enumeration to capture information about whether an asychronous"},{"type":"text","text":" "},{"type":"text","text":"call succeeds or fails, and use the associated values for the "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)","isActive":true,"type":"reference"},{"text":" cases to carry information about the result of the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"call."}],"type":"paragraph"},{"text":"Return Result Instances Asynchronously","level":3,"anchor":"Return-Result-Instances-Asynchronously","type":"heading"},{"inlineContent":[{"text":"The following example models an asynchronous source of random numbers. The ","type":"text"},{"type":"codeVoice","code":"fetchRemoteRandomNumber(completion:)"},{"text":" ","type":"text"},{"text":"method returns ","type":"text"},{"type":"codeVoice","code":"Void"},{"type":"text","text":" synchronously, and asynchronously calls a completion handler"},{"type":"text","text":" "},{"text":"with a ","type":"text"},{"type":"codeVoice","code":"Result<Int, EntropyError>"},{"text":" instance that contains either a random result","type":"text"},{"text":" ","type":"text"},{"text":"or information about the failure.","type":"text"}],"type":"paragraph"},{"code":["let queue = DispatchQueue(label: \"com.example.queue\")","","enum EntropyError: Error {","    case entropyDepleted","}","","struct AsyncRandomGenerator {","    static let entropyLimit = 5","    var count = 0","","    mutating func fetchRemoteRandomNumber(","        completion: @escaping (Result<Int, EntropyError>) -> Void","    ) {","        let result: Result<Int, EntropyError>","        if count < AsyncRandomGenerator.entropyLimit {","            \/\/ Produce numbers until reaching the entropy limit.","            result = .success(Int.random(in: 1...100))","        } else {","            \/\/ Supply a failure reason when the caller hits the limit.","            result = .failure(.entropyDepleted)","        }","","        count += 1","","        \/\/ Delay to simulate an asynchronous source of entropy.","        queue.asyncAfter(deadline: .now() + 2) {","            completion(result)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Users of your remote random number generator can decide how to handle both the success"},{"text":" ","type":"text"},{"text":"and failure cases:","type":"text"}],"type":"paragraph"},{"code":["var generator = AsyncRandomGenerator()","","\/\/ Request one more number than the limit to trigger a failure.","(0..<AsyncRandomGenerator.entropyLimit + 1).forEach { _ in","    generator.fetchRemoteRandomNumber { result in","        switch result {","        case .success(let number):","            print(number)","        case .failure(let error):","            print(\"Source of randomness failed: \\(error)\")","        }","    }","}","","print(\"Waiting on some numbers.\")","","dispatchMain()","\/* Prints:","success(29)","success(46)","success(85)","success(39)","success(84)","Source of randomness failed: entropyDepleted","*\/"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"references":{"doc://com.apple.Swift/documentation/Swift/Result":{"url":"\/documentation\/swift\/result","title":"Result","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Result"}],"role":"symbol","abstract":[{"text":"A value that represents either a success or a failure, including an","type":"text"},{"text":" ","type":"text"},{"text":"associated value in each case.","type":"text"}],"navigatorTitle":[{"text":"Result","kind":"identifier"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift":{"url":"\/documentation\/swift","type":"topic","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Browse the essential types provided by Swift’s standard library."}],"role":"collection","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/numbers-and-basic-values":{"abstract":[{"text":"Model data with numbers, Boolean values, and other fundamental types.","type":"text"}],"role":"collectionGroup","url":"\/documentation\/swift\/numbers-and-basic-values","title":"Numbers and Basic Values","kind":"article","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/numbers-and-basic-values","type":"topic"},"doc://com.apple.Swift/documentation/Swift/Result/failure(_:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)","title":"Result.failure(_:)","role":"symbol","url":"\/documentation\/swift\/result\/failure(_:)","type":"topic","abstract":[{"type":"text","text":"A failure, storing a "},{"type":"codeVoice","code":"Failure"},{"text":" value.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"failure"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:s6ResultOsRi_zRi0_zrlE7Failureq_mfp","text":"Failure"},{"kind":"text","text":")"}],"kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/Result/success(_:)":{"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swift\/result\/success(_:)","title":"Result.success(_:)","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"success"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Success","preciseIdentifier":"s:s6ResultOsRi_zRi0_zrlE7Successxmfp"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"A success, storing a "},{"type":"codeVoice","code":"Success"},{"type":"text","text":" value."}]}}}