{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/numbers-and-basic-values","doc:\/\/com.apple.Swift\/documentation\/Swift\/Result"]]},"abstract":[{"text":"Vend results as part of an API when you can’t return errors synchronously.","type":"text"}],"metadata":{"role":"article","modules":[{"name":"Standard Library"}],"roleHeading":"Article","title":"Writing Failable Asynchronous APIs"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swift\/writing-failable-asynchronous-apis"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"When writing a function, method, or other API that might fail, you use the ","type":"text"},{"code":"throws","type":"codeVoice"},{"text":" ","type":"text"},{"text":"keyword on the declaration to indicate that the API call can throw an error. However,","type":"text"},{"text":" ","type":"text"},{"text":"you can’t use the ","type":"text"},{"type":"codeVoice","code":"throws"},{"text":" keyword to model APIs that return asynchronously. Instead,","type":"text"},{"text":" ","type":"text"},{"text":"use the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result"},{"text":" enumeration to capture information about whether an asychronous","type":"text"},{"text":" ","type":"text"},{"text":"call succeeds or fails, and use the associated values for the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)"},{"text":" cases to carry information about the result of the","type":"text"},{"text":" ","type":"text"},{"text":"call.","type":"text"}]},{"anchor":"Return-Result-Instances-Asynchronously","type":"heading","text":"Return Result Instances Asynchronously","level":3},{"type":"paragraph","inlineContent":[{"text":"The following example models an asynchronous source of random numbers. The ","type":"text"},{"type":"codeVoice","code":"fetchRemoteRandomNumber(completion:)"},{"text":" ","type":"text"},{"text":"method returns ","type":"text"},{"type":"codeVoice","code":"Void"},{"text":" synchronously, and asynchronously calls a completion handler","type":"text"},{"text":" ","type":"text"},{"text":"with a ","type":"text"},{"type":"codeVoice","code":"Result<Int, EntropyError>"},{"text":" instance that contains either a random result","type":"text"},{"text":" ","type":"text"},{"text":"or information about the failure.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let queue = DispatchQueue(label: \"com.example.queue\")","","enum EntropyError: Error {","    case entropyDepleted","}","","struct AsyncRandomGenerator {","    static let entropyLimit = 5","    var count = 0","","    mutating func fetchRemoteRandomNumber(","        completion: @escaping (Result<Int, EntropyError>) -> Void","    ) {","        let result: Result<Int, EntropyError>","        if count < AsyncRandomGenerator.entropyLimit {","            \/\/ Produce numbers until reaching the entropy limit.","            result = .success(Int.random(in: 1...100))","        } else {","            \/\/ Supply a failure reason when the caller hits the limit.","            result = .failure(.entropyDepleted)","        }","","        count += 1","","        \/\/ Delay to simulate an asynchronous source of entropy.","        queue.asyncAfter(deadline: .now() + 2) {","            completion(result)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Users of your remote random number generator can decide how to handle both the success","type":"text"},{"text":" ","type":"text"},{"text":"and failure cases:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var generator = AsyncRandomGenerator()","","\/\/ Request one more number than the limit to trigger a failure.","(0..<AsyncRandomGenerator.entropyLimit + 1).forEach { _ in","    generator.fetchRemoteRandomNumber { result in","        switch result {","        case .success(let number):","            print(number)","        case .failure(let error):","            print(\"Source of randomness failed: \\(error)\")","        }","    }","}","","print(\"Waiting on some numbers.\")","","dispatchMain()","\/* Prints:","success(29)","success(46)","success(85)","success(39)","success(84)","Source of randomness failed: entropyDepleted","*\/"]}],"kind":"content"}],"kind":"article","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/writing-failable-asynchronous-apis","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)"],"anchor":"Representing-a-Result","title":"Representing a Result","generated":true}],"references":{"doc://com.apple.Swift/documentation/Swift":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift","role":"collection","title":"Standard Library","navigatorTitle":[{"text":"Standard Library","kind":"text"}],"url":"\/documentation\/swift","abstract":[{"text":"Browse the essential types provided by Swift’s standard library.","type":"text"}],"type":"topic","kind":"symbol"},"doc://com.apple.Swift/documentation/Swift/numbers-and-basic-values":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/numbers-and-basic-values","role":"collectionGroup","url":"\/documentation\/swift\/numbers-and-basic-values","title":"Numbers and Basic Values","type":"topic","kind":"article","abstract":[{"type":"text","text":"Model data with numbers, Boolean values, and other fundamental types."}]},"doc://com.apple.Swift/documentation/Swift/Result/success(_:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","role":"symbol","url":"\/documentation\/swift\/result\/success(_:)","title":"Result.success(_:)","type":"topic","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"text":"success","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:s6ResultOsRi_zRi0_zrlE7Successxmfp","kind":"typeIdentifier","text":"Success"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"A success, storing a "},{"type":"codeVoice","code":"Success"},{"type":"text","text":" value."}]},"doc://com.apple.Swift/documentation/Swift/Result/failure(_:)":{"role":"symbol","type":"topic","title":"Result.failure(_:)","url":"\/documentation\/swift\/result\/failure(_:)","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"failure"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:s6ResultOsRi_zRi0_zrlE7Failureq_mfp","text":"Failure"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"A failure, storing a "},{"type":"codeVoice","code":"Failure"},{"type":"text","text":" value."}]},"doc://com.apple.Swift/documentation/Swift/Result":{"url":"\/documentation\/swift\/result","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"Result","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result","title":"Result","role":"symbol","navigatorTitle":[{"text":"Result","kind":"identifier"}],"abstract":[{"type":"text","text":"A value that represents either a success or a failure, including an"},{"type":"text","text":" "},{"type":"text","text":"associated value in each case."}],"type":"topic"}}}