{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Swift\/writing-failable-asynchronous-apis"},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Swift","doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","doc:\/\/com.apple.Swift\/documentation\/Swift\/numbers-and-basic-values","doc:\/\/com.apple.Swift\/documentation\/Swift\/Result"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Vend results as part of an API when you can’t return errors synchronously.","type":"text"}],"sections":[],"metadata":{"title":"Writing Failable Asynchronous APIs","modules":[{"name":"Swift"}],"role":"article","roleHeading":"Article"},"seeAlsoSections":[{"title":"Representing a Result","anchor":"Representing-a-Result","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When writing a function, method, or other API that might fail, you use the "},{"type":"codeVoice","code":"throws"},{"type":"text","text":" "},{"type":"text","text":"keyword on the declaration to indicate that the API call can throw an error. However,"},{"type":"text","text":" "},{"type":"text","text":"you can’t use the "},{"type":"codeVoice","code":"throws"},{"type":"text","text":" keyword to model APIs that return asynchronously. Instead,"},{"type":"text","text":" "},{"type":"text","text":"use the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result","type":"reference","isActive":true},{"type":"text","text":" enumeration to capture information about whether an asychronous"},{"type":"text","text":" "},{"type":"text","text":"call succeeds or fails, and use the associated values for the "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)","type":"reference","isActive":true},{"type":"text","text":" cases to carry information about the result of the"},{"type":"text","text":" "},{"type":"text","text":"call."}]},{"anchor":"Return-Result-Instances-Asynchronously","text":"Return Result Instances Asynchronously","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example models an asynchronous source of random numbers. The "},{"code":"fetchRemoteRandomNumber(completion:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"method returns "},{"code":"Void","type":"codeVoice"},{"type":"text","text":" synchronously, and asynchronously calls a completion handler"},{"type":"text","text":" "},{"type":"text","text":"with a "},{"type":"codeVoice","code":"Result<Int, EntropyError>"},{"type":"text","text":" instance that contains either a random result"},{"type":"text","text":" "},{"text":"or information about the failure.","type":"text"}]},{"code":["let queue = DispatchQueue(label: \"com.example.queue\")","","enum EntropyError: Error {","    case entropyDepleted","}","","struct AsyncRandomGenerator {","    static let entropyLimit = 5","    var count = 0","","    mutating func fetchRemoteRandomNumber(","        completion: @escaping (Result<Int, EntropyError>) -> Void","    ) {","        let result: Result<Int, EntropyError>","        if count < AsyncRandomGenerator.entropyLimit {","            \/\/ Produce numbers until reaching the entropy limit.","            result = .success(Int.random(in: 1...100))","        } else {","            \/\/ Supply a failure reason when the caller hits the limit.","            result = .failure(.entropyDepleted)","        }","","        count += 1","","        \/\/ Delay to simulate an asynchronous source of entropy.","        queue.asyncAfter(deadline: .now() + 2) {","            completion(result)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Users of your remote random number generator can decide how to handle both the success"},{"type":"text","text":" "},{"type":"text","text":"and failure cases:"}],"type":"paragraph"},{"code":["var generator = AsyncRandomGenerator()","","\/\/ Request one more number than the limit to trigger a failure.","(0..<AsyncRandomGenerator.entropyLimit + 1).forEach { _ in","    generator.fetchRemoteRandomNumber { result in","        switch result {","        case .success(let number):","            print(number)","        case .failure(let error):","            print(\"Source of randomness failed: \\(error)\")","        }","    }","}","","print(\"Waiting on some numbers.\")","","dispatchMain()","\/* Prints:","success(29)","success(46)","success(85)","success(39)","success(84)","Source of randomness failed: entropyDepleted","*\/"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"references":{"Swift-PageImage-card.png":{"identifier":"Swift-PageImage-card.png","variants":[{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card@2x.png","traits":["2x","light"]},{"url":"\/images\/com.apple.Swift\/Swift-PageImage-card~dark@2x.png","traits":["2x","dark"]}],"type":"image","alt":"An orange Swift logo on a gradient background."},"doc://com.apple.Swift/documentation/Swift/numbers-and-basic-values":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/numbers-and-basic-values","url":"\/documentation\/swift\/numbers-and-basic-values","kind":"article","role":"collectionGroup","type":"topic","title":"Numbers and Basic Values","abstract":[{"text":"Model data with numbers, Boolean values, and other fundamental types.","type":"text"}]},"doc://com.apple.Swift/documentation/Swift/swift-standard-library":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/swift-standard-library","url":"\/documentation\/swift\/swift-standard-library","kind":"article","role":"collectionGroup","type":"topic","title":"Swift Standard Library","abstract":[{"type":"text","text":"Solve complex problems and write high-performance, readable code."}]},"doc://com.apple.Swift/documentation/Swift/Result/success(_:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/success(_:)","kind":"symbol","role":"symbol","url":"\/documentation\/swift\/result\/success(_:)","abstract":[{"type":"text","text":"A success, storing a "},{"type":"codeVoice","code":"Success"},{"type":"text","text":" value."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"success","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:s6ResultOsRi_zRi0_zrlE7Successxmfp","text":"Success","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"Result.success(_:)","type":"topic"},"doc://com.apple.Swift/documentation/Swift":{"kind":"symbol","type":"topic","role":"collection","title":"Swift","images":[{"type":"card","identifier":"Swift-PageImage-card.png"}],"abstract":[{"text":"Build apps using a powerful open language.","type":"text"}],"url":"\/documentation\/swift","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift"},"doc://com.apple.Swift/documentation/Swift/Result/failure(_:)":{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result\/failure(_:)","kind":"symbol","role":"symbol","url":"\/documentation\/swift\/result\/failure(_:)","abstract":[{"type":"text","text":"A failure, storing a "},{"code":"Failure","type":"codeVoice"},{"type":"text","text":" value."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"failure"},{"kind":"text","text":"("},{"text":"Failure","kind":"typeIdentifier","preciseIdentifier":"s:s6ResultOsRi_zRi0_zrlE7Failureq_mfp"},{"kind":"text","text":")"}],"title":"Result.failure(_:)","type":"topic"},"doc://com.apple.Swift/documentation/Swift/Result":{"role":"symbol","navigatorTitle":[{"text":"Result","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Result"}],"abstract":[{"type":"text","text":"A value that represents either a success or a failure, including an"},{"text":" ","type":"text"},{"text":"associated value in each case.","type":"text"}],"url":"\/documentation\/swift\/result","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Result","title":"Result","type":"topic","kind":"symbol"}}}