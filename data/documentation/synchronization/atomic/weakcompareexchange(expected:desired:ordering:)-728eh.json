{"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Perform an atomic weak compare and exchange operation on the current"},{"type":"text","text":" "},{"type":"text","text":"value, applying the memory ordering. This compare-exchange variant is"},{"type":"text","text":" "},{"type":"text","text":"allowed to spuriously fail; it is designed to be called in a loop until"},{"type":"text","text":" "},{"type":"text","text":"it indicates a successful exchange has happened."}],"variants":[{"paths":["\/documentation\/synchronization\/atomic\/weakcompareexchange(expected:desired:ordering:)-728eh"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"weakCompareExchange","kind":"identifier"},{"text":"(","kind":"text"},{"text":"expected","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"consuming","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:15Synchronization6AtomicVA2A19_Atomic32BitStorageV0B14RepresentationRtzrlE5Valuexmfp","text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"desired","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"consuming","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:15Synchronization6AtomicVA2A19_Atomic32BitStorageV0B14RepresentationRtzrlE5Valuexmfp","text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"ordering","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/AtomicUpdateOrdering","text":"AtomicUpdateOrdering","preciseIdentifier":"s:15Synchronization20AtomicUpdateOrderingV","kind":"typeIdentifier"},{"text":") -> (exchanged","kind":"text"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","text":"Bool","preciseIdentifier":"s:Sb","kind":"typeI