ext":" ","type":"text"},{"text":"transaction:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["atomic(self) { currentValue in","  let original = currentValue","  guard original == expected else { return (false, original) }","  currentValue = desired","  return (true, original)","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"ordering","type":"codeVoice"},{"text":" argument specifies the memory ordering to use when the","type":"text"},{"text":" ","type":"text"},{"text":"operation manages to update the current value, while ","type":"text"},{"code":"failureOrdering","type":"codeVoice"},{"text":" ","type":"text"},{"text":"will be used when the operation leaves the value intact.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The weakCompareExchange form may sometimes return false even when"},{"type":"text","text":" "},{"type":"text","text":"the original and expected values are equal. (Such failures may happen"},{"type":"text","text":" "},{"type":"text","text":"when some transient condition prevents the underlying operation from"},{"type":"text","text":" "},{"type":"text","text":"succeeding – such as an incoming interrupt during a"},{"type":"text","text":" "},{"type":"text","text":"load-link\/store-conditional instruction sequence.) This variant is"},{"type":"text","text":" "},{"type":"text","text":"designed to be called in a loop that only exits when the exchange is"},{"type":"text","text":" "},{"type":"text","text":"successful; in such loops, using weakCompareExchange may lead to a"},{"type":"text","text":" "},{"type":"text","text":"performance improvement by eliminating a nested loop in the regular,"},{"type":"text","text":" "},{"type":"text","text":"“strong”, compareExchange variants."}]}],"type":"aside","name":"Note","style":"note"}]}],"abstract":[{"type":"text","text":"Perform an atomic weak compare and exchange operation on the current"},{"type":"text","