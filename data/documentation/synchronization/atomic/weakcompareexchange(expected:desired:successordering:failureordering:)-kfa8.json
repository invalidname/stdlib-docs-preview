value intact."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":"The weakCompareExchange form may sometimes return false even when"},{"type":"text","text":" "},{"type":"text","text":"the original and expected values are equal. (Such failures may happen"},{"type":"text","text":" "},{"type":"text","text":"when some transient condition prevents the underlying operation from"},{"type":"text","text":" "},{"type":"text","text":"succeeding – such as an incoming interrupt during a"},{"type":"text","text":" "},{"type":"text","text":"load-link\/store-conditional instruction sequence.) This variant is"},{"type":"text","text":" "},{"type":"text","text":"designed to be called in a loop that only exits when the exchange is"},{"type":"text","text":" "},{"type":"text","text":"successful; in such loops, using weakCompareExchange may lead to a"},{"type":"text","text":" "},{"type":"text","text":"performance improvement by eliminating a nested loop in the regular,"},{"type":"text","text":" "},{"type":"text","text":"“strong”, compareExchange variants."}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/synchronization\/atomic\/weakcompareexchange(expected:desired:successordering:failureordering:)-kfa8"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Atomic\/weakCompareExchange(expected:desired:successOrdering:failureOrdering:)-kfa8"},"references":{"doc://com.apple.Swift/documentation/Synchronization/AtomicUpdateOrdering":{"abstract":[{"text":"Specifies the memory ordering semantics of an atomic read-modify-write","type":"text"},{"text":" ","type":"text"},{"text":"operation.","type":"text"}],"navigatorTitle":[{"text":"AtomicUpdateOrdering","kind":"identifier"}],"type":"topic","url":"\/documentation\/synchronization\/atomicupdateordering","kind":"symbol","identifier":"doc:\/\/com.apple.Sw