{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Atomic\/weakCompareExchange(expected:desired:successOrdering:failureOrdering:)-kfa8","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Perform an atomic weak compare and exchange operation on the current"},{"type":"text","text":" "},{"type":"text","text":"value, applying the specified success\/failure memory orderings. This"},{"type":"text","text":" "},{"type":"text","text":"compare-exchange variant is allowed to spuriously fail; it is designed to"},{"type":"text","text":" "},{"type":"text","text":"be called in a loop until it indicates a successful exchange has happened."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@export(implementation)","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"weakCompareExchange","kind":"identifier"},{"text":"(","kind":"text"},{"text":"expected","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"consuming","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:15Synchronization6AtomicVA2A19_Atomic64BitStorageV0B14RepresentationRtzrlE5Valuexmfp"},{"text":", ","kind":"text"},{"text":"desired","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"consuming","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:15Synchronization6AtomicVA2A19_Atomic64BitStorageV0B14RepresentationRtzrlE5Valuexmfp"},{"text":", ","kind":"text"},{"text":"successOrdering","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15Synchronization20AtomicUpdateOrderingV","identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/AtomicUpdateOrdering","kind":"typeIdentifier","text":"AtomicUpdateOrdering"},{"text":", ","kind":"text"},{"text":"failureOrdering","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15Synchronization18AtomicLoadOrderingV","identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/AtomicLoadOrdering","kind":"typeIdentifier","text":"AtomicLoadOrdering"},{"text":") -> (exchanged","kind":"text"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/Bool","kind":"typeIdentifier","text":"Bool"},{"text":", original","kind":"text"},{"text":": ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:15Synchronization6AtomicVA2A19_Atomic64BitStorageV0B14RepresentationRtzrlE5Valuexmfp"},{"text":")","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"expected","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The expected current value."}]}]},{"name":"desired","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The desired new value."}]}]},{"name":"successOrdering","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The memory ordering to apply if this"},{"type":"text","text":" "},{"type":"text","text":"operation performs the exchange."}]}]},{"name":"failureOrdering","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The memory ordering to apply on this"},{"type":"text","text":" "},{"type":"text","text":"operation does not perform the exchange."}]}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tuple "},{"type":"codeVoice","code":"(exchanged, original)"},{"type":"text","text":", where "},{"type":"codeVoice","code":"exchanged"},{"type":"text","text":" is true if"},{"type":"text","text":" "},{"type":"text","text":"the exchange was successful, and "},{"type":"codeVoice","code":"original"},{"type":"text","text":" is the original value."}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This operation performs the following algorithm as a single atomic"},{"type":"text","text":" "},{"type":"text","text":"transaction:"}]},{"type":"codeListing","syntax":"swift","code":["atomic(self) { currentValue in","  let original = currentValue","  guard original == expected else { return (false, original) }","  currentValue = desired","  return (true, original)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ordering"},{"type":"text","text":" argument specifies the memory ordering to use when the"},{"type":"text","text":" "},{"type":"text","text":"operation manages to update the current value, while "},{"type":"codeVoice","code":"failureOrdering"},{"type":"text","text":" "},{"type":"text","text":"will be used when the operation leaves the value intact."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The weakCompareExchange form may sometimes return false even when"},{"type":"text","text":" "},{"type":"text","text":"the original and expected values are equal. (Such failures may happen"},{"type":"text","text":" "},{"type":"text","text":"when some transient condition prevents the underlying operation from"},{"type":"text","text":" "},{"type":"text","text":"succeeding – such as an incoming interrupt during a"},{"type":"text","text":" "},{"type":"text","text":"load-link\/store-conditional instruction sequence.) This variant is"},{"type":"text","text":" "},{"type":"text","text":"designed to be called in a loop that only exits when the exchange is"},{"type":"text","text":" "},{"type":"text","text":"successful; in such loops, using weakCompareExchange may lead to a"},{"type":"text","text":" "},{"type":"text","text":"performance improvement by eliminating a nested loop in the regular,"},{"type":"text","text":" "},{"type":"text","text":"“strong”, compareExchange variants."}]}],"name":"Note","style":"note","type":"aside"}]}],"variants":[{"paths":["\/documentation\/synchronization\/atomic\/weakcompareexchange(expected:desired:successordering:failureordering:)-kfa8"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Synchronization","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Atomic"]]},"metadata":{"extendedModule":"Synchronization","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"weakCompareExchange","kind":"identifier"},{"text":"(","kind":"text"},{"text":"expected","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"consuming","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:15Synchronization6AtomicVA2A19_Atomic64BitStorageV0B14RepresentationRtzrlE5Valuexmfp","text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"desired","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"consuming","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:15Synchronization6AtomicVA2A19_Atomic64BitStorageV0B14RepresentationRtzrlE5Valuexmfp","text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"successOrdering","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15Synchronization20AtomicUpdateOrderingV","text":"AtomicUpdateOrdering","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"failureOrdering","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15Synchronization18AtomicLoadOrderingV","text":"AtomicLoadOrdering","kind":"typeIdentifier"},{"text":") -> (exchanged","kind":"text"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", original","kind":"text"},{"text":": ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:15Synchronization6AtomicVA2A19_Atomic64BitStorageV0B1