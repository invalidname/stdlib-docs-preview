"doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafePointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawBufferPointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawPointer","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/WordPair"],"type":"conformingTypes"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/AtomicRepresentable"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AtomicRepresentable"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"Types that conform to the "},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":" protocol can be used as the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Value"},{"type":"text","text":" type parameter with the "},{"type":"codeVoice","code":"Atomic"},{"type":"text","text":" type. Conformances that utilize"},{"type":"text","text":" "},{"type":"text","text":"existing atomic storage representations as their own representation will get"},{"type":"text","text":" "},{"type":"text","text":"the primitive atomic operations available on "},{"type":"codeVoice","code":"Atomic"},{"type":"text","text":" for free. Such"},{"type":"text","text":" "},{"type":"text","text":"operations include "},{"type":"codeVoice","code":"load"},{"type":"text","text":", "},{"type":"codeVoice","code":"store"},{"type":"text","text":", "},{"type":"codeVoice","code":"exchange"},{"type":"text","text":", "},{"type":"codeVoice","code":"compareExchange"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"weakCompareExchange"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Conforming to the AtomicRepresentable protocol","type":"heading","anchor":"Conforming-to-the-AtomicRepresentable-protocol","level":2},{"inlineContent":[{"type":"text","text":"Conforming your own custom types allow them to be used in the "},{"type":"codeVoice","code":"Atomic"},{"type":"text","text":" type"},{"type":"text","text":" "},{"type":"text","text":"and get access to all of the primitive atomic operations explained above."},{"type":"text","text":" "},{"type":"text","text":"There are two main ways to conform your type to "},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Using a predefined ","type":"text"},{"code":"RawRepresentable","type":"codeVoice"},{"text":" conformance","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Manually conforming to ","type":"text"},{"code":"AtomicRepresentable","type":"codeVoice"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"If you custom type already conforms to ","type":"text"},{"code":"RawRepresentable","type":"codeVoice"},{"text":", then adding the","type":"text"},{"text":" ","type":"text"},{"code":"AtomicRepresentable","type":"codeVoice"},{"text":" conformance may be really simple! If the ","type":"text"},{"code":"RawValue","type":"codeVoice"},{"text":" ","type":"text"},{"text":"associated type of your type is already itself an ","type":"text"},{"code":"AtomicRepresentable","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"then all you need to do is add the conformance and you’re done!","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["enum TrafficLight: UInt8 {","  case red","  case yellow","  case green","}","","extension TrafficLight: AtomicRepresentable {}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"And that’s it! Here, we’re utilizing Swift’s automatic "},{"type":"codeVoice","code":"RawRepresentable"},{"type":"text","text":" "},{"type":"text","text":"conformance synthesis for enums by declaring our “raw value” to be a"},{"type":"text","text":" "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":". By adding the "},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":" conformance, we automatically"},{"type":"text","text":" "},{"type":"text","text":"figure out how to do the conformance from the "},{"type":"codeVoice","code":"RawRepresentable"},{"type":"text","text":" "},{"type":"text","text":"implementation and do all of the necessary work for you. However, it is still"},{"type":"text","text":" "},{"type":"text","text":"possible to customize this behavior using the manual method explained below."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Defining your own "},{"code":"AtomicRepresentable","type":"codeVoice"},{"text":" conformance is pretty simple. All","type":"text"},{"text":" ","type":"text"},{"text":"you have to do is decide what atomic storage representation fits best for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"your type, and create the bidirectional relationship between the two."}]},{"code":["\/\/ A point in an x-y coordinate system.","struct GridPoint {","  var x: Int","  var y: Int","}","","extension GridPoint: AtomicRepresentable {","  typealias AtomicRepresentation = WordPair.AtomicRepresentation","","  static func encodeAtomicRepresentation(","    _ value: consuming GridPoint","  ) -> AtomicRepresentation {","    let wordPair = WordPair(","      first: UInt(bitPattern: value.x),","      second: UInt(bitPattern: value.y)","    )","","    return WordPair.encodeAtomicRepresentation(wordPair)","  }","","  static func decodeAtomicRepresentation(","    _ representation: consuming AtomicRepresentation","  ) -> GridPoint {","    let wordPair = WordPair.decodeAtomicRepresentation(representation)","","    return GridPoint(","      x: Int(bitPattern: wordPair.first),","      y: Int(bitPattern: wordPair.second)","    )","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Here, we’re going to select "},{"code":"WordPair","type":"codeVoice"},{"text":"’s atomic storage representation as","type":"text"},{"type":"text","text":" "},{"type":"text","text":"our own. This is very important because we only get the atomic operations"},{"text":" ","type":"text"},{"type":"text","text":"like "},{"type":"codeVoice","code":"load"},{"type":"text","text":" and "},{"type":"codeVoice","code":"store"},{"type":"text","text":" if our representation is one of the "},{"inlineContent":[{"text":"fundamental","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"storage representations. Luckily for us, ","type":"text"},{"code":"WordPair","type":"codeVoice"},{"text":" does use one of these","type":"text"},{"text":" ","type":"text"},{"text":"types as its storage type.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In addition to selecting what storage representation our type will use, we","type":"text"},{"type":"text","text":" "},{"type":"text","text":"define two static functions that go from both our custom type to its"},{"text":" ","type":"text"},{"type":"text","text":"representation and the representation back to our own type. Because our"},{"text":" ","type":"text"},{"type":"text","text":"representation is the same as "},{"type":"codeVoice","code":"WordPair.AtomicRepresentation"},{"type":"text","text":", we will"},{"text":" ","type":"text"},{"type":"text","text":"actually go through "},{"code":"WordPair","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"AtomicRepresentable","type":"codeVoice"},{"text":" conformance to help","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"define our own."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is all you need to do to conform your custom type to the"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":" protocol. From here, you can use this type in all of"},{"type":"text","text":" "},{"type":"text","text":"the primitive atomic operations like shown below:"}]},{"code":["func atomicGridPoint(_ gridPoint: Atomic<GridPoint>) {","  let newGridPoint = GridPoint(x: 123, y: -456)","","  let oldGridPoint1 = gridPoint.load(ordering: .relaxed)","","  gridPoint.store(newGridPoint, ordering: .releasing)","","  let oldGridPoint2 = gridPoint.exchange(","    desired: oldGridPoint1,","    ordering: .acquiringAndReleasing","  )","","  let (exchanged1, oldGridPoint2) = gridPoint.compareExchange(","    expected: oldGridPoint1,","    desired: newGridPoint,","    ordering: .sequentiallyConsistent","  )","","  let (exchanged2, oldGridPoint3) = gridPoint.weakCompareExchange(","    expected: newGridPoint,","    desired: oldGridPoint2,","    ordering: .relaxed","  )","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"List-of-Fundamental-Atomic-Representations","type":"heading","text":"List of Fundamental Atomic Representations"},{"inlineContent":[{"type":"text","text":"When defining your own "},{"type":"codeVoice","code":"AtomicRepresentable"},{"text":" conformance, it is critical","type":"text"},{"type":"text","text":" "},{"type":"text","text":"that your custom type should choose from the following list of types as its"},{"text":" ","type":"text"},{"text":"own ","type":"text"},{"type":"codeVoice","code":"AtomicRepresentation"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"UInt8.AtomicRepresentation","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UInt16.AtomicRepresentation","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"UInt32.AtomicRepresentation","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"UInt64.AtomicRepresentation","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"UInt.AtomicRepresentation","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Int8.AtomicRepresentation","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Int16.AtomicRepresentation","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Int32.AtomicRepresentation","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Int64.AtomicRepresentation","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Int.AtomicRepresentation","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"WordPair.AtomicRepresentation","type":"codeVoice"}],"type":"paragraph"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"Int8.AtomicRepresentation"},{"type":"text","text":" is the same type as"},{"type":"text","text":" "},{"type":"codeVoice","code":"UInt8.AtomicRepresentation"},{"type":"text","text":" and the same is true for all of the same"},{"type":"text","text":" "},{"type":"text","text":"sized integer types. If your type wraps an unsigned integer, you should"},{"type":"text","text":" "},{"type":"text","text":"prefer to use an unsigned integer’s atomic representation instead of a"},{"type":"text","text":" "},{"type":"text","text":"signed ones and vice versa. "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UInt"},{"type":"text","text":"’s representation will be"},{"type":"text","text":" "},{"type":"text","text":"64 bits wide on 64 bit systems and 32 bit wide on 32 bit systems. "},{"type":"codeVoice","code":"Int64"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"UInt64"},{"type":"text","text":" always conform to "},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":" on 64 bit systems,"},{"type":"text","text":" "},{"type":"text","text":"but on 32 bit systems they will only conform if the platform supports"},{"type":"text","text":" "},{"type":"text","text":"double wide atomics. "},{"type":"codeVoice","code":"WordPair"},{"type":"text","text":" will only conform to "},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":" "},{"type":"text","text":"on platforms that support double wide atomics, but if they do it will be"},{"type":"text","text":" "},{"type":"text","text":"128 bits wide on 64 bit systems and 64 bits wide on 32 bit systems."}]}],"type":"aside","style":"note","name":"Note"}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/synchronization\/atomicrepresentable"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A type that supports atomic operations through a separate atomic storage"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"references":{"doc://com.apple.Swift/documentation/Synchronization/Atomic":{"role":"symbol","title":"Atomic","kind":"symbol","abstract":[{"text":"An atomic value.","type":"text"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Atomic","navigatorTitle":[{"text":"Atomic","kind":"identifier"}],"url":"\/documentation\/synchronization\/atomic","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Atomic","kind":"identifier"}]},"doc://com.apple.Swift/documentation/Synchronization/AtomicRepresentable":{"role":"symbol","title":"AtomicRepresentable","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/AtomicRepresentable","abstract":[{"type":"text","text":"A type that supports atomic operations through a separate atomic storage"},{"type":"text","text":" "},{"type":"text","text":"representation."}],"navigatorTitle":[{"kind":"identifier","text":"AtomicRepresentable"}],"url":"\/documentation\/synchronization\/atomicrepresentable","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind