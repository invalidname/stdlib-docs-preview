ocumentation\/Swift\/Int64","doc:\/\/com.apple.Swift\/documentation\/Swift\/Int8","doc:\/\/com.apple.Swift\/documentation\/Swift\/Never","doc:\/\/com.apple.Swift\/documentation\/Swift\/ObjectIdentifier","doc:\/\/com.apple.Swift\/documentation\/Swift\/OpaquePointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/Optional","doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt","doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt128","doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt16","doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt32","doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt64","doc:\/\/com.apple.Swift\/documentation\/Swift\/UInt8","doc:\/\/com.apple.Swift\/documentation\/Swift\/Unmanaged","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeBufferPointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableBufferPointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutablePointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawBufferPointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeMutableRawPointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafePointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawBufferPointer","doc:\/\/com.apple.Swift\/documentation\/Swift\/UnsafeRawPointer","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/WordPair"]}],"abstract":[{"text":"A type that supports atomic operations through a separate atomic storage","type":"text"},{"text":" ","type":"text"},{"text":"representation.","type":"text"}],"seeAlsoSections":[{"title":"Atomic Values","generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Atomic","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/AtomicLazyReference","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/WordPair","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/AtomicOptionalRepresentable"],"anchor":"Atomic-Values"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AtomicRepresentable"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Types that conform to the "},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":" protocol can be used as the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Value"},{"type":"text","text":" type parameter with the "},{"type":"codeVoice","code":"Atomic"},{"type":"text","text":" type. Conformances that utilize"},{"type":"text","text":" "},{"type":"text","text":"existing atomic storage representations as their own representation will get"},{"type":"text","text":" "},{"type":"text","text":"the primitive atomic operations available on "},{"type":"codeVoice","code":"Atomic"},{"type":"text","text":" for free. Such"},{"type":"text","text":" "},{"type":"text","text":"operations include "},{"type":"codeVoice","code":"load"},{"type":"text","text":", "},{"type":"codeVoice","code":"store"},{"type":"text","text":", "},{"type":"codeVoice","code":"exchange"},{"type":"text","text":", "},{"type":"codeVoice","code":"compareExchange"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"weakCompareExchange"},{"type":"text","text":"."}]},{"anchor":"Conforming-to-the-AtomicRepresentable-protocol","type":"heading","level":2,"text":"Conforming to the AtomicRepresentable protocol"},{"inlineContent":[{"type":"text","text":"Conforming your own custom types allow them to be used in the "},{"code":"Atomic","type":"codeVoice"},{"type":"text","text":" type"},{"text":" ","type":"text"},{"text":"and get access to all of the primitive atomic operations explained above.","type":"text"},{"text":" ","type":"text"},{"text":"There are two main ways to conform your type to ","type":"text"},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Using a predefined "},{"type":"codeVoice","code":"RawRepresentable"},{"type":"text","text":" conformance"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Manually conforming to "},{"type":"codeVoice","code":"AtomicRepresentable"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you custom type already conforms to "},{"type":"codeVoice","code":"RawRepresentable"},{"type":"text","text":", then adding the"},{"type":"text","text":" "},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":" conformance may be really simple! If the "},{"type":"codeVoice","code":"RawValue"},{"type":"text","text":" "},{"type":"text","text":"associated type of your type is already itself an "},{"code":"AtomicRepresentable","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"then all you need to do is add the conformance and you’re done!","type":"text"}]},{"code":["enum TrafficLight: UInt8 {","  case red","  case yellow","  case green","}","","extension TrafficLight: AtomicRepresentable {}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"And that’s it! Here, we’re utilizing Swift’s automatic "},{"type":"codeVoice","code":"RawRepresentable"},{"type":"text","text":" "},{"type":"text","text":"conformance synthesis for enums by declaring our “raw value” to be a"},{"type":"text","text":" "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":". By adding the "},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":" conformance, we automatically"},{"type":"text","text":" "},{"type":"text","text":"figure out how to do the conformance from the "},{"type":"codeVoice","code":"RawRepresentable"},{"type":"text","text":" "},{"type":"text","text":"implementation and do all of the necessary work for you. However, it is still"},{"type":"text","text":" "},{"type":"text","text":"possible to customize this behavior using the manual method explained below."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Defining your own "},{"code":"AtomicRepresentable","type":"codeVoice"},{"type":"text","text":" conformance is pretty simple. All"},{"type":"text","text":" "},{"type":"text","text":"you have to do is decide what atomic storage representation fits best for"},{"type":"text","text":" "},{"text":"your type, and create the bidirectional relationship between the two.","type":"text"}]},{"type":"codeListing","code":["\/\/ A point in an x-y coordinate system.","struct GridPoint {","  var x: Int","  var y: Int","}","","extension GridPoint: AtomicRepresentable {","  typealias AtomicRepresentation = WordPair.AtomicRepresentation","","  static func encodeAtomicRepresentation(","    _ value: consuming GridPoint","  ) -> AtomicRepresentation {","    let wordPair = WordPair(","      first: UInt(bitPattern: value.x),","      second: UInt(bitPattern: value.y)","    )","","    return WordPair.encodeAtomicRepresentation(wordPair)","  }","","  static func decodeAtomicRepresentation(","    _ representation: consuming AtomicRepresentation","  ) -> GridPoint {","    let wordPair = WordPair.decodeAtomicRepresentation(representation)","","    return GridPoint(","      x: Int(bitPattern: wordPair.first),","      y: Int(bitPattern: wordPair.second)","    )","  }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Here, we’re going to select ","type":"text"},{"code":"WordPair","type":"codeVoice"},{"text":"’s atomic storage representation as","type":"text"},{"text":" ","type":"text"},{"text":"our own. This is very important because we only get the atomic operations","type":"text"},{"text":" ","type":"text"},{"text":"like ","type":"text"},{"code":"load","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"store","type":"codeVoice"},{"text":" if our representation is one of the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"fundamental"}]},{"text":" ","type":"text"},{"text":"storage representations. Luckily for us, ","type":"text"},{"code":"WordPair","type":"codeVoice"},{"text":" does use one of these","type":"text"},{"text":" ","type":"text"},{"text":"types as its storage type.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In addition to selecting what storage representation our type will use, we","type":"text"},{"text":" ","type":"text"},{"text":"define two static functions that go from both our custom type to its","type":"text"},{"text":" ","type":"text"},{"text":"representation and the representation back to our own type. Because our","type":"text"},{"text":" ","type":"text"},{"text":"representation is the same as ","type":"text"},{"code":"WordPair.AtomicRepresentation","type":"codeVoice"},{"text":", we will","type":"text"},{"text":" ","type":"text"},{"text":"actually go through ","type":"text"},{"code":"WordPair","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"AtomicRepresentable","type":"codeVoice"},{"text":" conformance to help","type":"text"},{"text":" ","type":"text"},{"text":"define our own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This is all you need to do to conform your custom type to the","type":"text"},{"text":" ","type":"text"},{"code":"AtomicRepresentable","type":"codeVoice"},{"text":" protocol. From here, you can use this type in all of","type":"text"},{"text":" ","type":"text"},{"text":"the primitive atomic operations like shown below:","type":"text"}]},{"type":"codeListing","code":["func atomicGridPoint(_ gridPoint: Atomic<GridPoint>) {","  let newGridPoint = GridPoint(x: 123, y: -456)","","  let oldGridPoint1 = gridPoint.load(ordering: .relaxed)","","  gridPoint.store(newGridPoint, ordering: .releasing)","","  let oldGridPoint2 = gridPoint.exchange(","    desired: oldGridPoint1,","    ordering: .acquiringAndReleasing","  )","","  let (exchanged1, oldGridPoint2) = gridPoint.compareExchange(","    expected: oldGridPoint1,","    desired: newGridPoint,","    ordering: .sequentiallyConsistent","  )","","  let (exchanged2, oldGridPoint3) = gridPoint.weakCompareExchange(","    expected: newGridPoint,","    desired: oldGridPoint2,","    ordering: .relaxed","  )","}"],"syntax":"swift"},{"anchor":"List-of-Fundamental-Atomic-Representations","type":"heading","text":"List of Fundamental Atomic Representations","level":2},{"type":"paragraph","inlineContent":[{"text":"When defining your own ","type":"text"},{"code":"AtomicRepresentable","type":"codeVoice"},{"text":" conformance, it is critical","type":"text"},{"text":" ","type":"text"},{"text":"that your custom type should choose from the following list of types as its","type":"text"},{"text":" ","type":"text"},{"text":"own ","type":"text"},{"code":"AtomicRepresentation","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UInt8.AtomicRepresentation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UInt16.AtomicRepresentation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UInt32.AtomicRepresentation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UInt64.AtomicRepresentation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UInt.AtomicRepresentation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Int8.AtomicRepresentation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Int16.AtomicRepresentation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Int32.AtomicRepresentation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Int64.AtomicRepresentation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Int.AtomicRepresentation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WordPair.AtomicRepresentation"}]}]}]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"Int8.AtomicRepresentation","type":"codeVoice"},{"type":"text","text":" is the same type as"},{"type":"text","text":" "},{"code":"UInt8.AtomicRepresentation","type":"codeVoice"},{"type":"text","text":" and the same is true for all of the same"},{"type":"text","text":" "},{"type":"text","text":"sized integer types. If your type wraps an unsigned integer, you should"},{"type":"text","text":" "},{"type":"text","text":"prefer to use an unsigned integer’s atomic representation instead of a"},{"type":"text","text":" "},{"type":"text","text":"signed ones and vice versa. "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" and "},{"code":"UInt","type":"codeVoice"},{"type":"text","text":"’s representation will be"},{"type":"text","text":" "},{"type":"text","text":"64 bits wide on 64 bit systems and 32 bit wide on 32 bit systems. "},{"code":"Int64","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"UInt64","type":"codeVoice"},{"type":"text","text":" always conform to "},{"code":"AtomicRepresentable","type":"codeVoice"},{"type":"text","text":" on 64 bit systems,"},{"type":"text","text":" "},{"type":"text","text":"but on 32 bit systems they will only conform if the platform supports"},{"type":"text","text":" "},{"type":"text","text":"double wide atomics. "},{"code":"WordPair","type":"codeVoice"},{"type":"text","text":" will only conform to "},{"code":"AtomicRepresentable","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"on platforms that support double wide atomics, but if they do it will be"},{"type":"text","text":" "},{"type":"text","text":"128 bits wide on 64 bit systems and 64 bits wide on 32 bit systems."}]}],"style":"note"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/AtomicRepresentable","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Synchronization"]]},"topicSections":[{"title":"Associated Types","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Synchronization\/AtomicRepresentable\/AtomicRepresentation"],"anchor":"Associated-Types","generated":true},{"title":"Type Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Synchronization\/AtomicRepresentable\/decodeAtomicRepresentation(_:)","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/AtomicRepresentable\/encodeAtomicRepresentation(_:)"],"anchor":"Type-Methods","generated":true}],"references":{"doc://com.apple.Swift/documentation/Swift/ObjectIdentifier":{"type":"topic","identifier":"doc:\/\/com.apple.Swift\/documentation\/Swift\/ObjectIdentifier","kind":"symbol","url":"\/documentation\/swift\/objectidentifier","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"ObjectIdentifier","kind":"identifier"}],"navigatorTitle":[{"text":"ObjectIdentifier","kind":"identifier"}],"abstract":[{"text":"A unique identifier for a class instance, actor instance, or metatype.","type":"text"}],"title":"ObjectIdentifier"},"doc://com.apple.Swift/documentation/Swift/Unmanaged":{"url":"\/documentation\/swift\/unmanaged","navigatorTitle":[{"text":"Unmanaged","kind":"identifier"}],"kind":"symbol","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Instance"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Copyable"},{"type":"text","text":" and "},{"code":"Escapable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"abstract"