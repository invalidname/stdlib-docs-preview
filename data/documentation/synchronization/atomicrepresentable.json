role":"symbol","symbolKind":"protocol","title":"AtomicRepresentable"},"seeAlsoSections":[{"anchor":"Atomic-Values","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Atomic","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/AtomicLazyReference","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/WordPair","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/AtomicOptionalRepresentable"],"generated":true,"title":"Atomic Values"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AtomicRepresentable"}]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Types that conform to the "},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":" protocol can be used as the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Value"},{"text":" type parameter with the ","type":"text"},{"code":"Atomic","type":"codeVoice"},{"text":" type. Conformances that utilize","type":"text"},{"text":" ","type":"text"},{"text":"existing atomic storage representations as their own representation will get","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the primitive atomic operations available on "},{"type":"codeVoice","code":"Atomic"},{"type":"text","text":" for free. Such"},{"text":" ","type":"text"},{"text":"operations include ","type":"text"},{"code":"load","type":"codeVoice"},{"text":", ","type":"text"},{"code":"store","type":"codeVoice"},{"text":", ","type":"text"},{"code":"exchange","type":"codeVoice"},{"text":", ","type":"text"},{"code":"compareExchange","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"weakCompareExchange","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Conforming-to-the-AtomicRepresentable-protocol","text":"Conforming to the AtomicRepresentable protocol"},{"inlineContent":[{"text":"Conforming your own custom types allow them to be used in the ","type":"text"},{"code":"Atomic","type":"codeVoice"},{"text":" type","type":"text"},{"text":" ","type":"text"},{"text":"and get access to all of the primitive atomic operations explained above.","type":"text"},{"text":" ","type":"text"},{"text":"There are two main ways to conform your type to ","type":"text"},{"code":"AtomicRepresentable","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Using a predefined ","type":"text"},{"code":"RawRepresentable","type":"codeVoice"},{"text":" conformance","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Manually conforming to "},{"type":"codeVoice","code":"AtomicRepresentable"}]}]}]},{"inlineContent":[{"type":"text","text":"If you custom type already conforms to "},{"type":"codeVoice","code":"RawRepresentable"},{"type":"text","text":", then adding the"},{"text":" ","type":"text"},{"code":"AtomicRepresentable","type":"codeVoice"},{"text":" conformance may be really simple! If the ","type":"text"},{"type":"codeVoice","code":"RawValue"},{"type":"text","text":" "},{"text":"associated type of your type is already itself an ","type":"text"},{"code":"AtomicRepresentable","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"text":"then all you need to do is add the conformance and you’re done!","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["enum TrafficLight: UInt8 {","  case red","  case yellow","  case green","}","","extension TrafficLight: AtomicRepresentable {}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"And that’s it! Here, we’re utilizing Swift’s automatic "},{"type":"codeVoice","code":"RawRepresentable"},{"type":"text","text":" "},{"text":"conformance synthesis for enums by declaring our “raw value” to be a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":". By adding the "},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":" conformance, we automatically"},{"type":"text","text":" "},{"type":"text","text":"figure out how to do the conformance from the "},{"code":"RawRepresentable","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"implementation and do all of the necessary work for you. However, it is still"},{"type":"text","text":" "},{"type":"text","text":"possible to customize this behavior using the manual method explained below."}]},{"inlineContent":[{"type":"text","text":"Defining your own "},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":" conformance is pretty simple. All"},{"type":"text","text":" "},{"type":"text","text":"you have to do is decide what atomic storage representation fits best for"},{"type":"text","text":" "},{"text":"your type, and create the bidirectional relationship between the two.","type":"text"}],"type":"paragraph"},{"code":["\/\/ A point in an x-y coordinate system.","struct GridPoint {","  var x: Int","  var y: Int","}","","extension GridPoint: AtomicRepresentable {","  typealias AtomicRepresentation = WordPair.AtomicRepresentation","","  static func encodeAtomicRepresentation(","    _ value: consuming GridPoint","  ) -> AtomicRepresentation {","    let wordPair = WordPair(","      first: UInt(bitPattern: value.x),","      second: UInt(bitPattern: value.y)","    )","","    return WordPair.encodeAtomicRepresentation(wordPair)","  }","","  static func decodeAtomicRepresentation(","    _ representation: consuming AtomicRepresentation","  ) -> GridPoint {","    let wordPair = WordPair.decodeAtomicRepresentation(representation)","","    return GridPoint(","      x: Int(bitPattern: wordPair.first),","      y: Int(bitPattern: wordPair.second)","    )","  }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Here, we’re going to select ","type":"text"},{"code":"WordPair","type":"codeVoice"},{"type":"text","text":"’s atomic storage representation as"},{"type":"text","text":" "},{"type":"text","text":"our own. This is very important because we only get the atomic operations"},{"type":"text","text":" "},{"text":"like ","type":"text"},{"code":"load","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"store","type":"codeVoice"},{"text":" if our representation is one of the ","type":"text"},{"inlineContent":[{"text":"fundamental","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"storage representations. Luckily for us, "},{"type":"codeVoice","code":"WordPair"},{"type":"text","text":" does use one of these"},{"type":"text","text":" "},{"type":"text","text":"types as its storage type."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to selecting what storage representation our type will use, we"},{"type":"text","text":" "},{"text":"define two static functions that go from both our custom type to its","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"representation and the representation back to our own type. Because our"},{"type":"text","text":" "},{"type":"text","text":"representation is the same as "},{"type":"codeVoice","code":"WordPair.AtomicRepresentation"},{"type":"text","text":", we will"},{"text":" ","type":"text"},{"type":"text","text":"actually go through "},{"code":"WordPair","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"AtomicRepresentable","type":"codeVoice"},{"type":"text","text":" conformance to help"},{"text":" ","type":"text"},{"text":"define our own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is all you need to do to conform your custom type to the"},{"type":"text","text":" "},{"code":"AtomicRepresentable","type":"codeVoice"},{"text":" protocol. From here, you can use this type in all of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the primitive atomic operations like shown below:"}]},{"code":["func atomicGridPoint(_ gridPoint: Atomic<GridPoint>) {","  let newGridPoint = GridPoint(x: 123, y: -456)","","  let oldGridPoint1 = gridPoint.load(ordering: .relaxed)","","  gridPoint.store(newGridPoint, ordering: .releasing)","","  let oldGridPoint2 = gridPoint.exchange(","    desired: oldGridPoint1,","    ordering: .acquiringAndReleasing","  )","","  let (exchanged1, oldGridPoint2) = gridPoint.compareExchange(","    expected: oldGridPoint1,","    desired: newGridPoint,","    ordering: .sequentiallyConsistent","  )","","  let (exchanged2, oldGridPoint3) = gridPoint.weakCompareExchange(","    expected: newGridPoint,","    desired: oldGridPoint2,","    ordering: .relaxed","  )","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"List of Fundamental Atomic Representations","type":"heading","anchor":"List-of-Fundamental-Atomic-Representations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When defining your own "},{"type":"codeVoice","code":"AtomicRepresentable"},{"text":" conformance, it is critical","type":"text"},{"text":" ","type":"text"},{"text":"that your custom type should choose from the following list of types as its","type":"text"},{"type":"text","text":" "},{"type":"text","text":"own "},{"type":"codeVoice","code":"AtomicRepresentation"},{"type":"text","text":":"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"UInt8.AtomicRepresentation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"UInt16.AtomicRepresentation","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"UInt32.AtomicRepresentation","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"UInt64.AtomicRepresentation","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UInt.AtomicRepresentation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Int8.AtomicRepresentation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Int16.AtomicRepresentation"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Int32.AtomicRepresentation"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Int64.AtomicRepresentation","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"Int.AtomicRepresentation","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"WordPair.AtomicRepresentation"}],"type":"paragraph"}]}],"type":"unorderedList"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"Int8.AtomicRepresentation"},{"type":"text","text":" is the same type as"},{"text":" ","type":"text"},{"code":"UInt8.AtomicRepresentation","type":"codeVoice"},{"text":" and the same is true for all of the same","type":"text"},{"text":" ","type":"text"},{"text":"sized integer types. If your type wraps an unsigned integer, you should","type":"text"},{"text":" ","type":"text"},{"text":"prefer to use an unsigned integer’s atomic representation instead of a","type":"text"},{"text":" ","type":"text"},{"text":"signed ones and vice versa. ","type":"text"},{"code":"Int","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UInt"},{"type":"text","text":"’s representation will be"},{"type":"text","text":" "},{"type":"text","text":"64 bits wide on 64 bit systems and 32 bit wide on 32 bit systems. "},{"type":"codeVoice","code":"Int64"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"UInt64"},{"type":"text","text":" always conform to "},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":" on 64 bit systems,"},{"type":"text","text":" "},{"type":"text","text":"but on 32 bit systems they will only conform if the platform supports"},{"type":"text","text":" "},{"type":"text","text":"double wide atomics. "},{"type":"codeVoice","code":"WordPair"},{"type":"text","text":" will only conform to "},{"type":"codeVoice","code":"AtomicRepresentable"},{"type":"text","text":" "},{"type":"text","text":"on platforms that support double wide atomics, but if they do it will be"},{"type":"text","text":" "},{"type":"text","text":"128 bits wide on 64 bit systems and 64 bits wide on 32 bit systems."}]}],"style":"note","type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Synchronization"]]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/synchronization\/atomicrepresentable"]}],"references":{"doc://com.apple.Swift/documentation/Synchronization/Atomic":{"navigatorTitle":[{"kind":"identifier","text":"Atomic"}],"abstract":[{"text":"An atomic value.","type":"text"}],"title":"Atomic","type":"topic","url":"\/documentation\/synchronization\/atomic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Atomic"}],"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Atomic"},"doc://com.apple.Swift/documentation/Swift/UnsafeMutableRawBufferPointer":{"url":"\/documentation\/swift\/unsafemutablerawbufferpointer","role":"symbol","navigatorTitle":[{"text":"UnsafeMutableRawBufferPointer","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UnsafeMutableRawBufferPointer","kind":"identifier"}],"abstract":[{"type":"text","text":"A mutable nonowning collection interface to the bytes in a"},{"type":"text","text":" "},{"type":"text","text":"region of memory."}],"type":"topic","kind":"symbol","title":"UnsafeMutableRawBufferPointer","identifier":"doc:\/\/com.appl