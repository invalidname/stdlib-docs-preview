{"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Synchronization"]]},"metadata":{"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Disconnected"}],"platforms":[{"name":"iOS","deprecated":false,"introducedAt":"18.0","beta":false,"unavailable":false},{"name":"iPadOS","deprecated":false,"introducedAt":"18.0","beta":false,"unavailable":false},{"name":"Mac Catalyst","deprecated":false,"introducedAt":"18.0","beta":false,"unavailable":false},{"name":"macOS","deprecated":false,"introducedAt":"15.0","beta":false,"unavailable":false},{"name":"tvOS","deprecated":false,"introducedAt":"18.0","beta":false,"unavailable":false},{"name":"visionOS","deprecated":false,"introducedAt":"2.0","beta":false,"unavailable":false},{"name":"watchOS","deprecated":false,"introducedAt":"11.0","beta":false,"unavailable":false}],"externalID":"s:15Synchronization12DisconnectedV","title":"Disconnected","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Disconnected"}],"modules":[{"name":"Synchronization"}],"roleHeading":"Structure"},"kind":"symbol","identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/init(_:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/consume()","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/exchange(newValue:)","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/withValue(body:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"text","text":"@backDeployed(before: anyAppleOS 9999)\n"},{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"attribute","text":"@safe"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Disconnected"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":" : ~Copyable","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"inlineContent":[{"text":"The value stored in ","type":"text"},{"code":"Disconnected<Value>","type":"codeVoice"},{"text":" lives in a disconnected region:","type":"text"},{"text":" ","type":"text"},{"text":"it has no references to or from any other isolation region. That","type":"text"},{"text":" ","type":"text"},{"text":"guarantee lets you store such values in generic containers and later","type":"text"},{"text":" ","type":"text"},{"text":"transfer them across isolation boundaries without losing the information","type":"text"},{"text":" ","type":"text"},{"text":"that the value was in a disconnected region.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"What-is-a-disconnected-region","text":"What is a disconnected region?","level":2},{"inlineContent":[{"text":"Region-based isolation partitions the values in a program into","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"isolation regions","type":"text"}],"type":"emphasis"},{"text":" based on which references reach which storage. A","type":"text"},{"text":" ","type":"text"},{"text":"value is in a ","type":"text"},{"inlineContent":[{"text":"disconnected region","type":"text"}],"type":"emphasis"},{"text":" when no reference reaches into or","type":"text"},{"text":" ","type":"text"},{"text":"out of its storage from any other region. Such a value is safe to","type":"text"},{"text":" ","type":"text"},{"text":"transfer to a different isolation region, such as an actor, a ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"text":"another concurrent context, because the act of sending it cannot create","type":"text"},{"text":" ","type":"text"},{"text":"a data race.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In practice, a disconnected region typically arises from one of:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"A freshly constructed value whose initializer arguments were","type":"text"},{"text":" ","type":"text"},{"text":"themselves disconnected.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A value that was just removed from another disconnected container.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"code":"sending","type":"codeVoice"},{"text":" parameter at a function boundary.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"code":"sending","type":"codeVoice"},{"text":" return value from a function.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Usually, the disconnected property is only tracked at ","type":"text"},{"code":"sending","type":"codeVoice"},{"text":" ","type":"text"},{"text":"boundaries. ","type":"text"},{"code":"Disconnected<Value>","type":"codeVoice"},{"text":" lets you preserve it across storage","type":"text"},{"text":" ","type":"text"},{"text":"boundaries (generic containers, stored properties, queues) that would","type":"text"},{"text":" ","type":"text"},{"text":"otherwise lose region information once the value is no longer at a","type":"text"},{"text":" ","type":"text"},{"code":"sending","type":"codeVoice"},{"text":" boundary.","type":"text"}],"type":"paragraph"},{"anchor":"Operations","text":"Operations","level":2,"type":"heading"},{"inlineContent":[{"text":"Values enter the ","type":"text"},{"code":"Disconnected","type":"codeVoice"},{"text":" wrapper through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/init(_:)","type":"reference"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"requires a ","type":"text"},{"code":"sending","type":"codeVoice"},{"text":" argument. They leave through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/consume()","type":"reference"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/exchange(newValue:)","type":"reference"},{"text":", both of which return ","type":"text"},{"code":"sending Value","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/withValue(body:)","type":"reference"},{"text":" lends the wrapped value in place to a closure that","type":"text"},{"text":" ","type":"text"},{"text":"receives an ","type":"text"},{"code":"inout sending Value","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every operation either consumes the wrapper or replaces the wrapped value","type":"text"},{"text":" ","type":"text"},{"text":"through a ","type":"text"},{"code":"sending","type":"codeVoice"},{"text":" boundary, so no alias into the wrapper’s storage can","type":"text"},{"text":" ","type":"text"},{"text":"outlive a transfer. That property is what lets ","type":"text"},{"code":"Disconnected","type":"codeVoice"},{"text":" conform to","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" regardless of whether ","type":"text"},{"code":"Value","type":"codeVoice"},{"text":" itself conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Producing-values-that-can-cross-isolation-boundaries","text":"Producing values that can cross isolation boundaries","level":2,"type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/consume()","type":"reference"},{"text":" to remove the wrapped value. The call consumes the","type":"text"},{"text":" ","type":"text"},{"text":"wrapper, so no further operations on it are possible. The returned","type":"text"},{"text":" ","type":"text"},{"text":"value is in a disconnected region, so you can transfer it across an","type":"text"},{"text":" ","type":"text"},{"text":"isolation boundary in the same expression, or store it and transfer it","type":"text"},{"text":" ","type":"text"},{"text":"later:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["final class Resource: ~Sendable {}","","\/\/ `wrapper` was popped from a queue or other container holding","\/\/ `Disconnected<Resource>` values, so the resource it holds is","\/\/ already known to be disconnected from the surrounding context.","func process(wrapper: consuming Disconnected<Resource>) async {","    let resource = wrapper.consume()","    await Task.detached {","        use(resource) \/\/ OK: `resource` is in a disconnected region.","    }.value","}"],"type":"codeListing"},{"inlineContent":[{"text":"Without the disconnected guarantee on the result, the captured ","type":"text"},{"code":"resource","type":"codeVoice"},{"text":" ","type":"text"},{"text":"would be considered part of the caller’s region and the capture in the","type":"text"},{"text":" ","type":"text"},{"text":"detached task would not be allowed.","type":"text"}],"type":"paragraph"},{"anchor":"Replacing-the-wrapped-value-in-place","text":"Replacing the wrapped value in place","level":2,"type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/exchange(newValue:)","type":"reference"},{"text":" to exchange the held value for a new one in a","type":"text"},{"text":" ","type":"text"},{"text":"single step. The ","type":"text"},{"code":"newValue","type":"codeVoice"},{"text":" argument is required to be in a disconnected","type":"text"},{"text":" ","type":"text"},{"text":"region. ","type":"text"},{"code":"exchange","type":"codeVoice"},{"text":" returns the previously stored value, which is in a","type":"text"},{"text":" ","type":"text"},{"text":"disconnected region:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["final class Resource: ~Sendable {}","","func exchangeResources(in wrapper: inout Disconnected<Resource>) async {","    let old = wrapper.exchange(newValue: Resource())","    await Task.detached {","        dispose(old) \/\/ OK: `old` is in a disconnected region.","    }.value","}"],"type":"codeListing"},{"inlineContent":[{"text":"Both directions of the exchange cross a disconnected-region boundary: the","type":"text"},{"text":" ","type":"text"},{"text":"new value is required to be disconnected when it goes in, and the old","type":"text"},{"text":" ","type":"text"},{"text":"value is known to be disconnected when it comes out.","type":"text"}],"type":"paragraph"},{"anchor":"Mutating-the-wrapped-value-without-taking-it-out","text":"Mutating the wrapped value without taking it out","level":2,"type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/withValue(body:)","type":"reference"},{"text":" when you need temporary mutable access without","type":"text"},{"text":" ","type":"text"},{"text":"removing the value. The closure receives the value as ","type":"text"},{"code":"inout sending Value","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"withValue","type":"codeVoice"},{"text":" returns whatever ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" returns:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var wrapper = Disconnected([Int]())","wrapper.withValue { array in","    array.append(42)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"inout sending","type":"codeVoice"},{"text":" parameter form means more than ordinary ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"within the closure, the value can be transferred to another isolation","type":"text"},{"text":" ","type":"text"},{"text":"region, as long as the wrapper is left holding a disconnected value","type":"text"},{"text":" ","type":"text"},{"text":"when the closure returns. In typical use the closure performs an","type":"text"},{"text":" ","type":"text"},{"text":"in-place mutation; the more permissive shape is what makes ","type":"text"},{"code":"withValue","type":"codeVoice"},{"text":" ","type":"text"},{"text":"composable with code that itself wants to send the value to another","type":"text"},{"type":"text","text":" "},{"type":"text","text":"isolation region."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"A wrapper that holds a value in a disconnected isolation region.","type":"text"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"type":"conformsTo","title":"Conforms To"}],"variants":[{"paths":["\/documentation\/synchronization\/disconnected"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://com.apple.Swift/documentation/Synchronization":{"url":"\/documentation\/synchronization","kind":"symbol","identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization","title":"Synchronization","role":"collection","abstract":[],"type":"topic"},"doc://com.apple.Swift/docum