{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Synchronization"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/synchronization\/disconnected"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"text","text":"@backDeployed(before: anyAppleOS 9999)\n"},{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"attribute","text":"@safe"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Disconnected"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":" : ~Copyable"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"text":"The value stored in ","type":"text"},{"code":"Disconnected<Value>","type":"codeVoice"},{"text":" lives in a disconnected region:","type":"text"},{"text":" ","type":"text"},{"text":"it has no references to or from any other isolation region. That","type":"text"},{"text":" ","type":"text"},{"text":"guarantee lets you store such values in generic containers and later","type":"text"},{"text":" ","type":"text"},{"text":"transfer them across isolation boundaries without losing the information","type":"text"},{"text":" ","type":"text"},{"text":"that the value was in a disconnected region.","type":"text"}],"type":"paragraph"},{"text":"What is a disconnected region?","type":"heading","anchor":"What-is-a-disconnected-region","level":2},{"inlineContent":[{"text":"Region-based isolation partitions the values in a program into","type":"text"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"isolation regions"}]},{"text":" based on which references reach which storage. A","type":"text"},{"text":" ","type":"text"},{"text":"value is in a ","type":"text"},{"inlineContent":[{"text":"disconnected region","type":"text"}],"type":"emphasis"},{"text":" when no reference reaches into or","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"out of its storage from any other region. Such a value is safe to"},{"type":"text","text":" "},{"type":"text","text":"transfer to a different isolation region, such as an actor, a "},{"code":"Task","type":"codeVoice"},{"text":", or","type":"text"},{"type":"text","text":" "},{"type":"text","text":"another concurrent context, because the act of sending it cannot create"},{"text":" ","type":"text"},{"text":"a data race.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In practice, a disconnected region typically arises from one of:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"A freshly constructed value whose initializer arguments were","type":"text"},{"type":"text","text":" "},{"type":"text","text":"themselves disconnected."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A value that was just removed from another disconnected container.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"sending","type":"codeVoice"},{"type":"text","text":" parameter at a function boundary."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"code":"sending","type":"codeVoice"},{"text":" return value from a function.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Usually, the disconnected property is only tracked at "},{"code":"sending","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"boundaries. "},{"code":"Disconnected<Value>","type":"codeVoice"},{"text":" lets you preserve it across storage","type":"text"},{"type":"text","text":" "},{"text":"boundaries (generic containers, stored properties, queues) that would","type":"text"},{"type":"text","text":" "},{"text":"otherwise lose region information once the value is no longer at a","type":"text"},{"text":" ","type":"text"},{"code":"sending","type":"codeVoice"},{"text":" boundary.","type":"text"}],"type":"paragraph"},{"text":"Operations","level":2,"type":"heading","anchor":"Operations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Values enter the "},{"code":"Disconnected","type":"codeVoice"},{"text":" wrapper through ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/init(_:)","type":"reference","isActive":true},{"type":"text","text":", which"},{"text":" ","type":"text"},{"text":"requires a ","type":"text"},{"code":"sending","type":"codeVoice"},{"text":" argument. They leave through ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/consume()","isActive":true,"type":"reference"},{"type":"text","text":" or"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/exchange(newValue:)","isActive":true,"type":"reference"},{"type":"text","text":", both of which return "},{"code":"sending Value","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/withValue(body:)","isActive":true,"type":"reference"},{"type":"text","text":" lends the wrapped value in place to a closure that"},{"type":"text","text":" "},{"type":"text","text":"receives an "},{"code":"inout sending Value","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every operation either consumes the wrapper or replaces the wrapped value"},{"type":"text","text":" "},{"type":"text","text":"through a "},{"code":"sending","type":"codeVoice"},{"text":" boundary, so no alias into the wrapper’s storage can","type":"text"},{"type":"text","text":" "},{"type":"text","text":"outlive a transfer. That property is what lets "},{"code":"Disconnected","type":"codeVoice"},{"text":" conform to","type":"text"},{"type":"text","text":" "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" regardless of whether "},{"code":"Value","type":"codeVoice"},{"text":" itself conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}]},{"level":2,"anchor":"Producing-values-that-can-cross-isolation-boundaries","type":"heading","text":"Producing values that can cross isolation boundaries"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/consume()","isActive":true,"type":"reference"},{"text":" to remove the wrapped value. The call consumes the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"wrapper, so no further operations on it are possible. The returned"},{"type":"text","text":" "},{"type":"text","text":"value is in a disconnected region, so you can transfer it across an"},{"type":"text","text":" "},{"type":"text","text":"isolation boundary in the same expression, or store it and transfer it"},{"type":"text","text":" "},{"type":"text","text":"later:"}]},{"code":["final class Resource: ~Sendable {}","","\/\/ `wrapper` was popped from a queue or other container holding","\/\/ `Disconnected<Resource>` values, so the resource it holds is","\/\/ already known to be disconnected from the surrounding context.","func process(wrapper: consuming Disconnected<Resource>) async {","    let resource = wrapper.consume()","    await Task.detached {","        use(resource) \/\/ OK: `resource` is in a disconnected region.","    }.value","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without the disconnected guarantee on the result, the captured "},{"code":"resource","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"would be considered part of the caller’s region and the capture in the"},{"type":"text","text":" "},{"type":"text","text":"detached task would not be allowed."}]},{"type":"heading","text":"Replacing the wrapped value in place","anchor":"Replacing-the-wrapped-value-in-place","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/exchange(newValue:)","isActive":true,"type":"reference"},{"type":"text","text":" to exchange the held value for a new one in a"},{"type":"text","text":" "},{"type":"text","text":"single step. The "},{"code":"newValue","type":"codeVoice"},{"type":"text","text":" argument is required to be in a disconnected"},{"type":"text","text":" "},{"type":"text","text":"region. "},{"code":"exchange","type":"codeVoice"},{"type":"text","text":" returns the previously stored value, which is in a"},{"type":"text","text":" "},{"type":"text","text":"disconnected region:"}]},{"code":["final class Resource: ~Sendable {}","","func exchangeResources(in wrapper: inout Disconnected<Resource>) async {","    let old = wrapper.exchange(newValue: Resource())","    await Task.detached {","        dispose(old) \/\/ OK: `old` is in a disconnected region.","    }.value","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both directions of the exchange cross a disconnected-region boundary: the"},{"type":"text","text":" "},{"type":"text","text":"new value is required to be disconnected when it goes in, and the old"},{"type":"text","text":" "},{"type":"text","text":"value is known to be disconnected when it comes out."}]},{"type":"heading","text":"Mutating the wrapped value without taking it out","anchor":"Mutating-the-wrapped-value-without-taking-it-out","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/withValue(body:)","isActive":true,"type":"reference"},{"type":"text","text":" when you need temporary mutable access without"},{"type":"text","text":" "},{"type":"text","text":"removing the value. The closure receives the value as "},{"code":"inout sending Value","type":"codeVoice"},{"type":"text","text":", and "},{"code":"withValue","type":"codeVoice"},{"type":"text","text":" returns whatever "},{"code":"body","type":"codeVoice"},{"type":"text","text":" returns:"}]},{"code":["var wrapper = Disconnected([Int]())","wrapper.withValue { array in","    array.append(42)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"inout sending","type":"codeVoice"},{"type":"text","text":" parameter form means more than ordinary "},{"code":"inout","type":"codeVoice"},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"within the closure, the value can be transferred to another isolation"},{"type":"text","text":" "},{"type":"text","text":"region, as long as the wrapper is left holding a disconnected value"},{"type":"text","text":" "},{"type":"text","text":"when the closure returns. In typical use the closure performs an"},{"type":"text","text":" "},{"type":"text","text":"in-place mutation; the more permissive shape is what makes "},{"code":"withValue","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"composable with code that itself wants to send the value to another"},{"type":"text","text":" "},{"type":"text","text":"isolation region."}]}],"kind":"content"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"]}],"abstract":[{"type":"text","text":"A wrapper that holds a value in a disconnected isolation region."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected"},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/init(_:)"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/consume()","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/exchange(newValue:)","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/withValue(body:)"]}],"metadata":{"externalID":"s:15Synchronization12DisconnectedV","platforms":[{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"18.0","name":"iOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"18.0","name":"iPadOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"18.0","name":"Mac Catalyst"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"15.0","name":"macOS"},{"unavailable":false,"beta":false,"deprecated":false,"introducedAt":"18.0","name":"tvOS"},{"deprecated":false,"name":"visionOS","unavailable":false,"beta":false,"introducedAt":"2.0"},{"deprecated":false,"name":"watchOS","unavailable":false,"beta":false,"introducedAt":"11.0"}],"modules":[{"name":"Synchronization"}],"role":"symbol","symbolKind":"struct","navigatorTitle":[{"text":"Disconnected","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Disconnected"}],"title":"Disconnected","roleHeading":"Structure"},"references":{"doc://com.apple.Swift/documentation/Swift/Sendable":{"type":"topic","title":"Sendable","url":"\/documentation\/swift\/sendable","kind":"symbol","abstract":[{"type":"text","text":"A thread-safe type whose values can be shared across arbitrary isolation"},{"text":" ","type":"text"},{"typ