{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@backDeployed(before: anyAppleOS 9999)\n","kind":"text"},{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"@safe","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Disconnected","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":" : ~Copyable","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The value stored in "},{"type":"codeVoice","code":"Disconnected<Value>"},{"type":"text","text":" lives in a disconnected region:"},{"type":"text","text":" "},{"type":"text","text":"it has no references to or from any other isolation region. That"},{"type":"text","text":" "},{"type":"text","text":"guarantee lets you store such values in generic containers and later"},{"type":"text","text":" "},{"type":"text","text":"transfer them across isolation boundaries without losing the information"},{"type":"text","text":" "},{"type":"text","text":"that the value was in a disconnected region."}]},{"anchor":"What-is-a-disconnected-region","level":2,"type":"heading","text":"What is a disconnected region?"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Region-based isolation partitions the values in a program into"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"isolation regions"}]},{"type":"text","text":" based on which references reach which storage. A"},{"type":"text","text":" "},{"type":"text","text":"value is in a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"disconnected region"}]},{"type":"text","text":" when no reference reaches into or"},{"type":"text","text":" "},{"type":"text","text":"out of its storage from any other region. Such a value is safe to"},{"type":"text","text":" "},{"type":"text","text":"transfer to a different isolation region, such as an actor, a "},{"type":"codeVoice","code":"Task"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"text","text":"another concurrent context, because the act of sending it cannot create"},{"type":"text","text":" "},{"type":"text","text":"a data race."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In practice, a disconnected region typically arises from one of:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A freshly constructed value whose initializer arguments were"},{"type":"text","text":" "},{"type":"text","text":"themselves disconnected."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A value that was just removed from another disconnected container."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"sending"},{"type":"text","text":" parameter at a function boundary."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"sending"},{"type":"text","text":" return value from a function."}]}]}]},{"inlineContent":[{"type":"text","text":"Usually, the disconnected property is only tracked at "},{"type":"codeVoice","code":"sending"},{"type":"text","text":" "},{"type":"text","text":"boundaries. "},{"type":"codeVoice","code":"Disconnected<Value>"},{"text":" lets you preserve it across storage","type":"text"},{"text":" ","type":"text"},{"text":"boundaries (generic containers, stored properties, queues) that would","type":"text"},{"type":"text","text":" "},{"type":"text","text":"otherwise lose region information once the value is no longer at a"},{"text":" ","type":"text"},{"type":"codeVoice","code":"sending"},{"text":" boundary.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Operations","level":2,"anchor":"Operations"},{"inlineContent":[{"text":"Values enter the ","type":"text"},{"code":"Disconnected","type":"codeVoice"},{"text":" wrapper through ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/init(_:)","isActive":true,"type":"reference"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"requires a ","type":"text"},{"code":"sending","type":"codeVoice"},{"type":"text","text":" argument. They leave through "},{"isActive":true,"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/consume()","type":"reference"},{"type":"text","text":" or"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/exchange(newValue:)"},{"text":", both of which return ","type":"text"},{"type":"codeVoice","code":"sending Value"},{"text":".","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/withValue(body:)","type":"reference","isActive":true},{"text":" lends the wrapped value in place to a closure that","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"receives an "},{"type":"codeVoice","code":"inout sending Value"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every operation either consumes the wrapper or replaces the wrapped value"},{"text":" ","type":"text"},{"text":"through a ","type":"text"},{"code":"sending","type":"codeVoice"},{"type":"text","text":" boundary, so no alias into the wrapper’s storage can"},{"type":"text","text":" "},{"text":"outlive a transfer. That property is what lets ","type":"text"},{"code":"Disconnected","type":"codeVoice"},{"text":" conform to","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" regardless of whether "},{"code":"Value","type":"codeVoice"},{"text":" itself conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Producing values that can cross isolation boundaries","anchor":"Producing-values-that-can-cross-isolation-boundaries"},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/consume()","isActive":true,"type":"reference"},{"text":" to remove the wrapped value. The call consumes the","type":"text"},{"text":" ","type":"text"},{"text":"wrapper, so no further operations on it are possible. The returned","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"value is in a disconnected region, so you can transfer it across an"},{"text":" ","type":"text"},{"type":"text","text":"isolation boundary in the same expression, or store it and transfer it"},{"type":"text","text":" "},{"text":"later:","type":"text"}],"type":"paragraph"},{"code":["final class Resource: ~Sendable {}","","\/\/ `wrapper` was popped from a queue or other container holding","\/\/ `Disconnected<Resource>` values, so the resource it holds is","\/\/ already known to be disconnected from the surrounding context.","func process(wrapper: consuming Disconnected<Resource>) async {","    let resource = wrapper.consume()","    await Task.detached {","        use(resource) \/\/ OK: `resource` is in a disconnected region.","    }.value","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Without the disconnected guarantee on the result, the captured ","type":"text"},{"code":"resource","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"would be considered part of the caller’s region and the capture in the"},{"type":"text","text":" "},{"type":"text","text":"detached task would not be allowed."}]},{"level":2,"text":"Replacing the wrapped value in place","type":"heading","anchor":"Replacing-the-wrapped-value-in-place"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/exchange(newValue:)","isActive":true,"type":"reference"},{"text":" to exchange the held value for a new one in a","type":"text"},{"type":"text","text":" "},{"text":"single step. The ","type":"text"},{"code":"newValue","type":"codeVoice"},{"text":" argument is required to be in a disconnected","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"region. "},{"type":"codeVoice","code":"exchange"},{"type":"text","text":" returns the previously stored value, which is in a"},{"type":"text","text":" "},{"type":"text","text":"disconnected region:"}]},{"type":"codeListing","code":["final class Resource: ~Sendable {}","","func exchangeResources(in wrapper: inout Disconnected<Resource>) async {","    let old = wrapper.exchange(newValue: Resource())","    await Task.detached {","        dispose(old) \/\/ OK: `old` is in a disconnected region.","    }.value","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both directions of the exchange cross a disconnected-region boundary: the"},{"type":"text","text":" "},{"type":"text","text":"new value is required to be disconnected when it goes in, and the old"},{"type":"text","text":" "},{"type":"text","text":"value is known to be disconnected when it comes out."}]},{"level":2,"type":"heading","anchor":"Mutating-the-wrapped-value-without-taking-it-out","text":"Mutating the wrapped value without taking it out"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/withValue(body:)","isActive":true},{"type":"text","text":" when you need temporary mutable access without"},{"type":"text","text":" "},{"type":"text","text":"removing the value. The closure receives the value as "},{"type":"codeVoice","code":"inout sending Value"},{"type":"text","text":", and "},{"type":"codeVoice","code":"withValue"},{"type":"text","text":" returns whatever "},{"type":"codeVoice","code":"body"},{"type":"text","text":" returns:"}]},{"type":"codeListing","syntax":"swift","code":["var wrapper = Disconnected([Int]())","wrapper.withValue { array in","    array.append(42)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"inout sending"},{"text":" parameter form means more than ordinary ","type":"text"},{"code":"inout","type":"codeVoice"},{"type":"text","text":":"},{"text":" ","type":"text"},{"text":"within the closure, the value can be transferred to another isolation","type":"text"},{"text":" ","type":"text"},{"text":"region, as long as the wrapper is left holding a disconnected value","type":"text"},{"text":" ","type":"text"},{"text":"when the closure returns. In typical use the closure performs an","type":"text"},{"text":" ","type":"text"},{"text":"in-place mutation; the more permissive shape is what makes ","type":"text"},{"code":"withValue","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"composable with code that itself wants to send the value to another"},{"text":" ","type":"text"},{"text":"isolation region.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/com.apple.Swift\/documentation\/Synchronization"]]},"sections":[],"kind":"symbol","metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Disconnected"}],"title":"Disconnected","roleHeading":"Structure","externalID":"s:15Synchronization12DisconnectedV","platforms":[{"unavailable":false,"deprecated":false,"introducedAt":"18.0","name":"iOS","beta":false},{"unavailable":false,"deprecated":false,"introducedAt":"18.0","name":"iPadOS","beta":false},{"unavailable":false,"deprecated":false,"introducedAt":"18.0","name":"Mac Catalyst","beta":false},{"unavailable":false,"introducedAt":"15.0","deprecated":false,"name":"macOS","beta":false},{"unavailable":false,"introducedAt":"18.0","deprecated":false,"name":"tvOS","beta":false},{"unavailable":false,"introducedAt":"2.0","deprecated":false,"name":"visionOS","beta":false},{"unavailable":false,"introducedAt":"11.0","deprecated":false,"name":"watchOS","beta":false}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"Disconnected"}],"modules":[{"name":"Synchronization"}]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/init(_:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/consume()","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/exchange(newValue:)","doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected\/withValue(body:)"],"anchor":"Instance-Methods","title":"Instance Methods"}],"abstract":[{"type":"text","text":"A wrapper that holds a value in a disconnected isolation region."}],"relationshipsSections":[{"identifiers":["doc:\/\/com.apple.Swift\/documentation\/Swift\/Sendable","doc:\/\/com.apple.Swift\/documentation\/Swift\/SendableMetatype"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"variants":[{"paths":["\/documentation\/synchronization\/disconnected"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.apple.Swift\/documentation\/Synchronization\/Disconnected","interfaceLanguage":"swift"},"references":{"doc://com.apple.Swift/documentation/Swift/SendableMetatype":{"kind":"symbol","abstract":[{"text":"A type whose metatype can be shared across arbitrary isolation domains","type":"text"},{"type":"text","text":" "},{"type":"text","text":"without introducing a risk of data races."}],"fragm